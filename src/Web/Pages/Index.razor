@page "/"
@inject GameClient G
@inject IJSRuntime JS
@implements IDisposable

@if (!G.Ready)
{
    <div class="boot">
        <div class="boot-mark">✦</div>
        <div class="boot-title">PRAETORIA</div>
        @if (G.LoadError != null) { <div class="boot-sub error">Could not load the game's content: @G.LoadError</div> }
        else
        {
            <div class="boot-sub">reading the archives… @G.LoadedFiles / @(G.TotalFiles == 0 ? "?" : G.TotalFiles.ToString())</div>
            <div class="boot-bar"><div class="boot-fill" style="width:@(G.TotalFiles == 0 ? 5 : 5 + 95 * G.LoadedFiles / G.TotalFiles)%"></div></div>
        }
    </div>
}
else if (G.Turn == null)
{
    <CreationScreen HasAutosave="@_hasAutosave" OnContinue="ContinueAutosave" OnLoadJson="LoadFromJson" />
}
else
{
    var m = G.Court();
    <div class="gs-shell" style="--accent:@m.HouseAccent" @ref="_shell" data-nebula data-era="@m.Era">
        <TopBar OnSave="SaveLocal" OnExport="Download" OnQuit="Abandon" OnPrimer="() => _primer = true" SavedFlash="@_savedFlash" />
        <nav class="rail">
            @foreach (var (id, glyph, label) in Screens)
            {
                if (id == "academy" && !(G.World!.Protagonist!.Age <= 22)) continue;
                <button class="rail-btn @(_screen == id ? "active" : "")" title="@label" @onclick="() => Go(id)" disabled="@(id == "galaxy" && G.World!.Galaxy == null)">
                    <Icon Name="@(id == "character" ? "you" : id == "planets" ? "worlds" : id == "senate" ? "influence" : id == "academy" ? "military" : id)" Size="22" /><span class="rl">@label</span>
                </button>
            }
        </nav>
        <main class="screen">
            @switch (_screen)
            {
                case "character": <CharacterScreen Model="m" /> break;
                case "senate": <SenateScreen Model="m" /> break;
                case "academy": <AcademyScreen Model="m" /> break;
                case "galaxy": <GalaxyMap @ref="_map" /> break;
                case "planets": <PlanetsScreen OnFocus="FocusSystem" /> break;
                case "house": <HouseScreen Model="m" /> break;
                case "military": <MilitaryScreen Model="m" /> break;
                case "dynasty": <DynastyScreen Model="m" /> break;
                case "houses": <HousesScreen Model="m" /> break;
                case "chronicle": <ChronicleScreen /> break;
                default: <OfficeScreen Model="m" OnOpenReport="OpenReport" /> break;
            }
        </main>
        <Outliner Model="m" OnOpenReport="OpenReport" OnGo="Go" />
        <div class="endturn-dock">
            @if (G.LastNotice != null) { <span class="notice">@G.LastNotice</span> }
            @if (!m.DynastyDead)
            {
                var open = m.Briefing.Count(b => !b.Resolved);
                <button class="btn primary endturn" @onclick="EndTurn" title="@(open > 0 ? $"{open} report(s) still unanswered — ending the turn sets them aside" : "Resolve the turn")">End Turn ▸@if (open > 0) { <span class="badge">@open</span> }</button>
            }
        </div>

        @if (_openReport != null && m.Briefing.FirstOrDefault(b => ReferenceEquals(b.Item, _openReport.Item)) is { } card)
        {
            <EventWindow Card="card" OnClose="() => _openReport = null" OnChoose="Choose" />
        }
        @if (m.EpilogueText != null && !_epilogueDismissed)
        {
            <div class="overlay">
                <div class="epilogue">
                    <h2>@(m.DynastyDead ? "The line ends" : "A saga's turning")</h2>
                    <p class="epi-text">@m.EpilogueText</p>
                    <div class="row">
                        @if (!m.DynastyDead) { <button class="btn primary" @onclick="() => _epilogueDismissed = true">Play on</button> }
                        <button class="btn" @onclick="Abandon">Back to the title</button>
                    </div>
                </div>
            </div>
        }
        @if (_succession != null)
        {
            <SuccessionInterstitial Record="_succession" OnClose="() => _succession = null" />
        }
        @if (_primer)
        {
            <Primer OnClose="ClosePrimer" />
        }
    </div>
}

@code {
    private static readonly (string id, string glyph, string label)[] Screens =
    {
        ("office", "", "Office"), ("character", "", "You"), ("academy", "", "Academy"), ("galaxy", "", "Galaxy"), ("planets", "", "Worlds"), ("senate", "", "Senate"), ("house", "", "House"),
        ("military", "", "Military"), ("dynasty", "", "Dynasty"), ("houses", "", "Houses"), ("chronicle", "", "Chronicle")
    };
    private string _screen = "office";
    private bool _screenChosen;
    private bool _hasAutosave, _epilogueDismissed, _savedFlash;
    private BriefingCard? _openReport;
    private SuccessionRecord? _succession; private bool _primer, _primerChecked;
    private string? _lastProtagonist;
    private GalaxyMap? _map;
    private ElementReference _shell;
    private DotNetObjectReference<Index>? _self;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (G.Turn != null) await CheckPrimer();
        if (first) { _self = DotNetObjectReference.Create(this); try { await JS.InvokeVoidAsync("praetoria.keys", _self); } catch { } }
        try { await JS.InvokeVoidAsync("praetoriaFx.paint"); await JS.InvokeVoidAsync("praetoriaBust.paint"); } catch { }
    }

    /// <summary>Keyboard: 1–9 switch screens, Enter ends the turn (when no report is open), Escape closes a window.</summary>
    [JSInvokable]
    public async Task Key(string key)
    {
        if (G.Turn == null) return;
        if (key == "Escape") { _openReport = null; _succession = null; }
        else if (key == "Enter" && _openReport == null && _succession == null) await EndTurn();
        else if (key.Length == 1 && char.IsDigit(key[0])) { int i = key[0] - '1'; if (i >= 0 && i < Screens.Length) _screen = Screens[i].id; }
        else return;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        G.Changed += OnChanged;
        await G.LoadAsync();
        try { _hasAutosave = !string.IsNullOrEmpty(await JS.InvokeAsync<string?>("praetoria.load", GameClient.AutosaveKey)); } catch { }
    }

    private void OnChanged()
    {
        if (G.World != null)
        {
            if (_lastProtagonist != null && _lastProtagonist != G.World.ProtagonistId && !G.World.IsDynastyDead)
            {
                _succession = G.World.Successions.LastOrDefault(s => s.HeirId == G.World.ProtagonistId) ?? new SuccessionRecord { Turn = G.World.Turn, Generation = G.World.Counter("generation"), DeceasedId = _lastProtagonist, DeceasedName = G.World.Char(_lastProtagonist)?.Name ?? "", DeceasedAge = G.World.Char(_lastProtagonist)?.Age ?? 0, HeirId = G.World.ProtagonistId, HeirName = G.World.Protagonist?.Name ?? "", HeirAge = G.World.Protagonist?.Age ?? 0 };
            }
            _lastProtagonist = G.World.ProtagonistId;
        }
        InvokeAsync(StateHasChanged);
    }

    private void Go(string id) => _screen = id;

    /// <summary>The primer opens once, on the first turn of a new run, unless this browser has seen it (GAP §10 item 1).</summary>
    private async Task CheckPrimer()
    {
        if (_primerChecked || G.World == null) return; _primerChecked = true;
        if (G.World.Turn > 1) return;
        try { var seen = await JS.InvokeAsync<string?>("localStorage.getItem", "praetoria.primer.seen"); if (string.IsNullOrEmpty(seen)) { _primer = true; StateHasChanged(); } } catch { }
    }
    private async Task ClosePrimer() { _primer = false; try { await JS.InvokeVoidAsync("localStorage.setItem", "praetoria.primer.seen", "1"); } catch { } }
    private void FocusSystem(string systemId) { _screen = "galaxy"; }
    private void OpenReport(BriefingCard card) => _openReport = card;
    private void Choose((BriefingCard card, string choiceId) pick) { G.Resolve(pick.card.Item, pick.choiceId); _openReport = null; }

    private async Task EndTurn()
    {
        _openReport = null;
        G.EndTurn();
        _epilogueDismissed = false;
        var first = G.Court().Briefing.FirstOrDefault(b => !b.Resolved);
        if (first != null && _screen == "office") _openReport = first;    // the first visitor steps forward
        await Autosave();
    }

    private async Task Autosave() { try { await JS.InvokeVoidAsync("praetoria.save", GameClient.AutosaveKey, G.SaveJson()); _hasAutosave = true; } catch { } }
    private async Task SaveLocal() { await Autosave(); _savedFlash = true; StateHasChanged(); await Task.Delay(1500); _savedFlash = false; }
    private async Task Download() { try { await JS.InvokeVoidAsync("praetoria.download", $"praetoria-turn{G.World!.Turn}.json", G.SaveJson()); } catch { } }
    private async Task ContinueAutosave() { try { var json = await JS.InvokeAsync<string?>("praetoria.load", GameClient.AutosaveKey); if (!string.IsNullOrEmpty(json)) G.LoadJson(json); } catch { } }
    private void LoadFromJson(string json) { try { G.LoadJson(json); } catch { } }
    private void Abandon() { _epilogueDismissed = false; _screen = "office"; _openReport = null; _succession = null; _lastProtagonist = null; G.Abandon(); }
    public void Dispose() { G.Changed -= OnChanged; _self?.Dispose(); }
}
