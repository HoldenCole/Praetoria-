@page "/"
@using Praetoria.Core.Presentation
@using Praetoria.Core.Systems
@using Praetoria.Core.Commands
@inject NavigationManager Nav
@inject GameClient G
@inject IJSRuntime JS
@implements IDisposable

@if (!G.Ready)
{
    <div class="boot">
        <div class="boot-mark">✦</div>
        <div class="boot-title">PRAETORIA</div>
        @if (G.LoadError != null) { <div class="boot-sub error">Could not load the game's content: @G.LoadError</div> }
        else
        {
            <div class="boot-sub">reading the archives… @G.LoadedFiles / @(G.TotalFiles == 0 ? "?" : G.TotalFiles.ToString())</div>
            <div class="boot-bar"><div class="boot-fill" style="width:@(G.TotalFiles == 0 ? 5 : 5 + 95 * G.LoadedFiles / G.TotalFiles)%"></div></div>
        }
    </div>
}
else if (_parts)
{
    @* every shared window part on one sheet (docs/VISUAL_SYSTEM.md, the parts sheet): open the client with ?parts *@
    <PartsSheet />
}
else if (G.Turn == null)
{
    <CreationScreen HasAutosave="@_hasAutosave" SaveLabel="@_saveLabel" KeptSaves="@_keptSaves" OnContinue="ContinueAutosave" OnLoadJson="LoadFromJson" OnSaves="() => _saves = true" OnSettings="() => _settings = true" OnHandbook="() => _primer = true" />
    @if (_saves) { <SavesBox InGame="false" OnClose="() => _saves = false" OnLoad="LoadSave" OnChanged="ReadSaves" /> }
    @if (_settings) { <SettingsBox OnClose="() => _settings = false" OnChanged="ReadSettings" /> }
    @if (_primer) { <Primer OnClose="() => _primer = false" Start="glossary" /> }
    <ConfirmBox />
}
else if (G.World!.InAcademy && G.Academy() is { } am)
{
    @* The Academy year is apart from the world (docs/ACADEMY.md): one screen, no rail, no world to act on. *@
    var m = G.Court();
    <div class="gs-shell academy-shell" style="--accent:@m.HouseAccent" @ref="_shell" data-nebula data-era="@m.Era" data-register="@am.Register">
        <main class="screen">
            <AcademyScreen Academy="am" Court="m" OnOpenReport="OpenReport" OnEndTerm="EndTurn" OnSave="SaveLocal" OnQuit="Abandon" />
        </main>
        @if (_savedFlash) { <div class="endturn-dock"><span class="notice">@_flashText</span></div> }
        @if (_openReport != null && m.Briefing.FirstOrDefault(b => ReferenceEquals(b.Item, _openReport.Item)) is { } card)
        {
            <EventWindow Card="card" OnClose="() => _openReport = null" OnChoose="Choose" />
        }
        @if (am.Tutorial.Length == 0)
        {
            @* the first morning at the Academy (docs/ACADEMY.md): a box over the hall, how the lectures are to be given *@
            <Box BoxClass="epilogue-box ac-welcome" Glyph="@(am.Register == "imperium" ? "eagle-emblem" : "open-book")" Kicker="@((am.Register == "imperium" ? "Under the Imperium" : "In the Republic") + " · age sixteen")" Title="@am.SchoolName" Width="min(52rem, calc(100vw - 2rem))">
                <ChildContent>
                    <p class="epi-text">@am.Blurb</p>
                    <p class="epi-text">@(_beenBefore ? "You have passed out of here before. The lectures can be the short course: the state of the Reach, the houses that matter, and who is in your year." : "If this is your first time in the Reach, the lectures will teach you how all of it works, a little each term: the Senate, the houses, the law, coin, fleets, and what lies beyond.")</p>
                </ChildContent>
                <Foot>
                    <p class="box-note muted small">You can change this at any time in the lecture hall.</p>
                    <span class="box-acts">
                        @if (_beenBefore)
                        {
                            <button class="btn" @onclick='() => Teach("full")'>First time here: teach me everything</button>
                            <button class="btn primary" @onclick='() => Teach("brief")'>I know the Reach: just brief me</button>
                        }
                        else
                        {
                            <button class="btn" @onclick='() => Teach("brief")'>I know the Reach: just brief me</button>
                            <button class="btn primary" @onclick='() => Teach("full")'>First time here: teach me everything</button>
                        }
                    </span>
                </Foot>
            </Box>
        }
    </div>
}
else
{
    var m = G.Court(); var alerts = Alerts.For(G.World!, G.Content!, m, G.Turn!.Progression);
    var unanswered = m.Briefing.Count(b => !b.Resolved);
    bool front = _openReport != null || _succession != null || _primer || _saves || _settings || (_brief && G.World is { InAcademy: false, IsDynastyDead: false }) || G.ProfileId != null || _passingOut;
    front |= _cards.Count > 0;   // the year's moments stand in front too: the toasts' clock waits for them
    @* The game shell (docs/VISUAL_SYSTEM.md 3): the map is the screen. Everything else sits at its edges: the top bar, the rail of
       sockets down the left with the house's standard at its foot, one window docked beside it, the alerts row and the toasts over
       the free map, the outliner on the right and the console in the bottom-right corner with End Year on its rim. *@
    <div class="gs-shell game @(_screen == "galaxy" ? "on-map" : "in-window") @(_set.RailLabels ? "rail-labels" : "") @(_set.Text == "larger" ? "tb-fold" : "") @(_legend ? "legend-on" : "")" style="--accent:@m.HouseAccent" @ref="_shell" data-era="@m.Era" data-role="@RoleTheme.Of(G.World!)">
        @if (G.World!.Galaxy != null) { <div class="map-layer"><GalaxyMap @ref="_map" OnPicked="MapPicked" /></div> }
        <TopBar OnSave="SaveLocal" OnSaves="() => _saves = true" OnUndo="Undo" OnSettings="() => _settings = true" OnExport="Download" OnQuit="Abandon" OnPrimer="() => _primer = true" OnBrief="() => _brief = true" SavedFlash="@_savedFlash" MenuOpen="@_menu" OnMenu="() => _menu = !_menu" />
        @if (_menu) { <div class="menu-veil" @onclick="() => _menu = false"></div> }
        @* the rail (3.3): sockets in groups split by a brass diamond, a pip by shape (a round brass pip for a decision, a notched ember
           diamond for danger), the name beside a socket at once on hover (and under it with "Show rail labels"), the standard at the foot *@
        <nav class="rail" aria-label="The windows">
            <div class="rail-stack">
                @{ int railAt = 0; var groups = RailGroups().ToList(); }
                @for (int gi = 0; gi < groups.Count; gi++)
                {
                    if (gi > 0) { <i class="rail-div" aria-hidden="true"></i> }
                    <div class="rail-grp">
                        @foreach (var (id, icon, label) in groups[gi])
                        {
                            string railKey = railAt < RailKeys.Length ? RailKeys[railAt].ToString() : ""; railAt++;
                            var (waiting, danger) = Waiting(id, alerts, unanswered);
                            string says = label + (waiting > 0 ? " · " + waiting + " waiting" : "") + (railKey.Length > 0 && _set.NumberKeys ? " · key " + railKey : "");
                            <button class="rail-btn sock @(_screen == id ? "active on" : "")" data-label="@says" aria-label="@says" data-rail="@id" @onclick="() => Go(id)">
                                <Icon Name="@icon" Size="28" Tone="@(_screen == id ? "dark" : "ivory-hi")" /><span class="rl">@label</span>
                                <span class="rlab" aria-hidden="true"><b>@label</b>@if (waiting > 0) { <i class="@(danger ? "danger" : "")">@waiting waiting</i> }@if (railKey.Length > 0 && _set.NumberKeys) { <kbd>@railKey</kbd> }</span>
                                @if (waiting > 0) { <span class="pip @(danger ? "danger" : "")" data-n="@waiting" aria-hidden="true"></span> }
                            </button>
                        }
                    </div>
                }
            </div>
            <button class="rail-standard" data-standard title="@($"[flying-flag] {m.HouseName}\nThe standard of your house. Click to open the House window.")" @onclick='() => Go("house")'><Sigil HouseId="@G.World!.Protagonist!.HouseId" Accent="@m.HouseAccent" Size="64" Mode="standard" /></button>
        </nav>
        @if (_screen != "galaxy")
        {
            var label = Screens.FirstOrDefault(s => s.id == _screen).label ?? _screen; var glyph = Screens.FirstOrDefault(s => s.id == _screen).glyph ?? "desk";
            @* the docked window (4.1): the frame over a leather body, the close roundel, one scrolling page that fades over its foot. A
               window rebuilt on the shared parts draws its own WindowHeader inside it and the old title strip steps aside. *@
            <main class="screen window docked-win @(WideScreens.Contains(_screen) ? "wide" : "")" data-screen="@_screen">
                <div class="dw-body">
                    <header class="win-bar"><span class="ui-medal sm"><Icon Name="@glyph" Tone="brass" Size="18" /></span><h2>@label</h2></header>
                    <div class="win-body">
                    <CascadingValue Name="Window" Value="@_screen">@* the first years are told which window and tab are open (Tabs.razor) *@
                    @switch (_screen)
                    {
                        case "character": <CharacterScreen Model="m" OnGo="Go" Tab="@_tab" TabStamp="_tabStamp" /> break;
                        case "senate": <SenateScreen Model="m" Tab="@_tab" TabStamp="_tabStamp" /> break;
                        case "planets": <PlanetsScreen OnFocus="FocusSystem" Tab="@_tab" TabStamp="_tabStamp" /> break;
                        case "house": <HouseScreen Model="m" OnGo="Go" Tab="@_tab" TabStamp="_tabStamp" /> break;
                        case "exchange": <ExchangeScreen Model="m" OnGo="Go" Tab="@_tab" TabStamp="_tabStamp" /> break;
                        case "laws": <LawsScreen Model="m" Tab="@_tab" TabStamp="_tabStamp" /> break;
                        case "military": <MilitaryScreen Model="m" OnGo="Go" Tab="@_tab" TabStamp="_tabStamp" /> break;
                        case "dynasty": <DynastyScreen Model="m" OnGo="Go" Tab="@_tab" TabStamp="_tabStamp" /> break;
                        case "houses": <HousesScreen Model="m" Tab="@_tab" TabStamp="_tabStamp" /> break;
                        case "chronicle": <ChronicleScreen Tab="@_tab" TabStamp="_tabStamp" /> break;
                        default: <OfficeScreen Model="m" OnOpenReport="OpenReport" OnGo="Go" /> break;
                    }
                    </CascadingValue>
                    </div>
                </div>
                <i class="dw-frame" aria-hidden="true"></i>
                <button class="ui-round dw-close" data-close-window title="Close this window and return to the map (Esc)" aria-label="Close" @onclick='() => Go("galaxy")'><Icon Name="close" Tone="ivory" Size="13" /></button>
            </main>
        }
        <AlertsRow Items="alerts" OnGo="Go" Year="@G.World!.Turn" MaxBadges="@(_screen == "galaxy" ? 10 : WideScreens.Contains(_screen) ? 4 : 6)" />
        @* the goal under the top bar (docs/GOALS.md): on the map only, so it never sits under a docked window *@
        @if (_screen == "galaxy") { <GoalPlate Goal="@G.Goal()" Year="@G.World!.Turn" OnGo="Go" /> }
        <Toasts Notes="Notes()" Paused="front" Hidden="@(_brief && G.World is { InAcademy: false, IsDynastyDead: false })" OnGo="Go" />
        <Outliner Model="m" OnOpenReport="OpenReport" OnGo="Go" Folded="@(_screen != "galaxy" || _narrow)" />
        @* the console (3.8): the map tools, the map modes as joined sockets, the legend; the minimap and its caption (the mode, and the
           system nearest the middle of the view); End Year on its rim (3.9) with the count of unanswered reports *@
        <div class="console" data-console>
            <div class="cs-body"></div>
            <div class="cs-tools">
                <button class="tool" data-map="home" title="@("[position-marker] Your seat\nThe map goes back to your house's seat")" @onclick='() => MapDo("home")'><Icon Name="position-marker" Tone="ivory" Size="18" /></button>
                <button class="tool" data-map="fit" title="@("[expand] The whole Reach\nEvery system in the view; inside a system, the whole system")" @onclick='() => MapDo("fit")'><Icon Name="expand" Tone="ivory" Size="18" /></button>
                <span class="gap"></span>
                <span class="modes">
                    <button class="tool @(_mode == "realms" ? "on" : "")" data-mode="realms" title="@("[world] Realms\nThe map from far off: the Reach as one, each nation beyond it and each state that has left it in its own colour, and their names")" @onclick='() => MapDo("realms")'><Icon Name="world" Tone="ivory" Size="18" /></button>
                    <button class="tool @(_mode == "houses" || _mode == "systems" ? "on" : "")" data-mode="houses" title="@("[flying-flag] Houses\nThe middle distance: every world in its holder's colour, your own land in gold")" @onclick='() => MapDo("houses")'><Icon Name="flying-flag" Tone="ivory" Size="18" /></button>
                    <button class="tool @(_mode == "regions" ? "on" : "")" data-mode="regions" title="@("[region] Regions\nThe regions of the Reach, who rules each and what lies in it")" @onclick='() => MapDo("regions")'><Icon Name="region" Tone="ivory" Size="18" /></button>
                    <button class="tool @(_mode == "supply" ? "on" : "")" data-mode="supply" title="@("[fuel-tank] Supply\nWhere your fleets are fed: a world of yours within reach, a depot or your campaign's target. Beyond it the map is hatched in ember, and a fleet there loses supply each year.")" @onclick='() => MapDo("supply")'><Icon Name="fuel-tank" Tone="ivory" Size="18" /></button>
                </span>
                <span class="gap"></span>
                <button class="tool @(_legend ? "on" : "")" data-map="legend" aria-pressed="@_legend" title="@("[info] The legend\nWhat the marks on the map mean. The map zooms on the wheel, and on Page Up and Page Down.")" @onclick="() => _legend = !_legend"><Icon Name="info" Tone="ivory" Size="18" /></button>
            </div>
            <div class="mm"><canvas @ref="_mini" width="278" height="146" title="The whole Reach: click to travel there"></canvas></div>
            <div class="cap"><b>@ModeName</b><span data-near></span></div>
            <i class="cs-frame" aria-hidden="true"></i>
        </div>
        @if (!m.DynastyDead)
        {
            <div class="endturn-dock">
                <button class="endturn" title="@((unanswered > 0 ? $"[hourglass] End the year\n{Counted.Reports(unanswered)} still unanswered: ending the year sets them aside." : "[hourglass] End the year\nThe year ends and the next begins.") + (!_set.EnterEnds ? "" : unanswered > 0 ? "\nkey: [Enter] opens each of them in turn, then ends the year" : "\nkey: Press [Enter] to end the year"))" @onclick="EndTurn">
                    <i class="ring" aria-hidden="true"></i><span class="med"><Icon Name="hourglass" Tone="dark" Size="44" /></span><span class="rib">End Year</span>
                    @if (unanswered > 0) { <span class="cnt" data-n="@unanswered" aria-label="@Counted.Reports(unanswered) unanswered"></span> }
                </button>
            </div>
        }

        @if (_openReport != null && m.Briefing.FirstOrDefault(b => ReferenceEquals(b.Item, _openReport.Item)) is { } card)
        {
            <EventWindow Card="card" OnClose="() => _openReport = null" OnChoose="Choose" />
        }
        @if (m.EpilogueText != null && !_epilogueDismissed)
        {
            <Box BoxClass="epilogue-box" Glyph="@(m.DynastyDead ? "candle-light" : "laurels")" Kicker="@(m.DynastyDead ? "The end of the line" : "A turning point")" Title="@(m.DynastyDead ? "The line ends" : "A saga's turning")" Width="min(46rem, calc(100vw - 2rem))">
                <ChildContent><p class="epi-text">@m.EpilogueText</p></ChildContent>
                <Foot>
                    <button class="btn" @onclick="Abandon">Back to the title</button>
                    @if (!m.DynastyDead) { <button class="btn primary" @onclick="() => _epilogueDismissed = true">Play on</button> }
                </Foot>
            </Box>
        }
        @if (_succession != null)
        {
            <SuccessionInterstitial Record="_succession" OnClose="CloseSuccession" />
        }
        @if (_cards.Count > 0 && _succession == null && (m.EpilogueText == null || _epilogueDismissed) && G.World is { IsDynastyDead: false } mw)
        {
            @* the year's moments (docs/WEB_CLIENT.md, "After End Year"): one card at a time, after the seat passing and a saga's turning, before the year in brief *@
            <MomentCard Moment="_cards[0]" Year="@(mw.Turn - 1)" At="@(_cardsOf - _cards.Count + 1)" Of="_cardsOf" OnClose="NextCard" />
        }
        @if (_brief && !_primer && _succession == null && _openReport == null && G.World is { InAcademy: false, IsDynastyDead: false })
        {
            <YearBrief OnClose="() => _brief = false" OnGo="BriefGo" Every="_briefEvery" OnEvery="SetBriefEvery" />
        }
        @if (_primer)
        {
            <Primer OnClose="ClosePrimer" OnGo="Go" />
        }
        @if (_saves)
        {
            <SavesBox InGame="true" OnClose="() => _saves = false" OnLoad="LoadSave" OnChanged="ReadSaves" />
        }
        @if (_settings)
        {
            <SettingsBox OnClose="() => _settings = false" OnChanged="ReadSettings" />
        }
        <ProfileCard />
        @if (_passingOut && G.Academy() is { Graduated: true } grad)
        {
            <Box BoxClass="epilogue-box" Glyph="laurels" Kicker="Passing out · age seventeen" Title="@($"{AcademySystem.Ordinal(grad.Place)} of {grad.Of}")" Width="min(46rem, calc(100vw - 2rem))">
                <ChildContent>
                    <p class="epi-text">@G.World!.Protagonist!.Name passes out of @grad.SchoolName @(grad.Place == 1 ? "first of the year" : grad.Place <= Math.Max(1, grad.Of / 3) ? "with honours" : "in the body of the year") and is commissioned @grad.RankName in @grad.ServiceName.</p>
                    @if (grad.Friends.Count > 0) { <p class="epi-text">Friends made: @string.Join(", ", grad.Friends).</p> }
                    @if (grad.Rivals.Count > 0) { <p class="epi-text">And those who will remember you otherwise: @string.Join(", ", grad.Rivals).</p> }
                    @if (grad.Reports.LastOrDefault() is { } lastTerm) { <TermCard Card="lastTerm" Last="true" /> }
                    @if (G.FirstSteps() is { } firstSteps) { <p class="epi-text" data-first-years-told>The four terms go on with you: @Counted.Of(firstSteps.Steps.Count, "first step") @Counted.Are(firstSteps.Steps.Count) pinned at the top of the list on the right, two for each term, each ticked when it is done.</p> }
                    <p class="epi-text">The gates open. From here a turn is a year, the house is yours to run, and everything the lectures described is real.</p>
                </ChildContent>
                <Foot><button class="btn primary" @onclick="() => _passingOut = false">To the desk</button></Foot>
            </Box>
        }
    </div>
}
<ConfirmBox />

@code {
    private bool _parts;
    /// <summary>The windows: their id, their glyph (docs/VISUAL_SYSTEM.md 8.2) and their name. The Galaxy is the map itself, with no socket.</summary>
    private static readonly (string id, string glyph, string label)[] Screens =
    {
        ("office", "desk", "Office"), ("character", "roman-toga", "You"), ("galaxy", "galaxy", "Galaxy"), ("planets", "ringed-planet", "Worlds"), ("senate", "greek-temple", "Senate"), ("house", "castle", "House"), ("exchange", "trade", "Exchange"),
        ("laws", "scales", "Laws"), ("military", "eagle-emblem", "Military"), ("dynasty", "family-tree", "Dynasty"), ("houses", "flying-flag", "Houses"), ("chronicle", "scroll-unfurled", "Chronicle")
    };
    /// <summary>The rail's groups (docs/VISUAL_SYSTEM.md 3.3): You, Dynasty, House / Worlds, Military, Exchange / Senate, Laws, Houses / Chronicle, Office.</summary>
    private static readonly string[][] RailOrder = { new[] { "character", "dynasty", "house" }, new[] { "planets", "military", "exchange" }, new[] { "senate", "laws", "houses" }, new[] { "chronicle", "office" } };
    private string _screen = "galaxy";
    /// <summary>Screens whose window is the wide one: a chamber, a table of houses, a market.</summary>
    private static readonly HashSet<string> WideScreens = new() { "office" };   // the Houses dock at the shared width (docs/VISUAL_SYSTEM.md 2.4)
    private void MapPicked() { if (_screen != "galaxy") { _screen = "galaxy"; StateHasChanged(); } }
    /// <summary>The rail's groups in the role register's order: a register changes only the order (docs/VISUAL_SYSTEM.md 3.3), so the
    /// screens its RoleTheme.Priority names stand first as a group of their own and the groups keep the rest.</summary>
    private IEnumerable<List<(string id, string glyph, string label)>> RailGroups()
    {
        var pri = G.World == null ? Array.Empty<string>() : RoleTheme.Priority(RoleTheme.Of(G.World)).Where(id => Screens.Any(s => s.id == id && id != "galaxy")).ToArray();
        (string, string, string) Of(string id) => Screens.First(s => s.id == id);
        if (pri.Length > 0) yield return pri.Select(Of).ToList();
        foreach (var g in RailOrder) { var rest = g.Where(id => !pri.Contains(id)).Select(Of).ToList(); if (rest.Count > 0) yield return rest; }
    }
    /// <summary>The rail in its order, for the number keys.</summary>
    private IEnumerable<(string id, string glyph, string label)> Rail() => RailGroups().SelectMany(g => g);
    /// <summary>What waits in a window, for its pip and its label: the alerts that open there and ask for a decision or warn of a
    /// danger, and for the Office the reports unanswered. A danger among them makes the pip the notched ember diamond.</summary>
    private static (int waiting, bool danger) Waiting(string id, IReadOnlyList<Alert> alerts, int unanswered)
    {
        if (id == "office") return (unanswered, false);
        var mine = alerts.Where(a => a.Severity is Alerts.Danger or Alerts.Decision && WindowOf(a.Go) == id).ToList();
        return (mine.Count, mine.Any(a => a.Severity == Alerts.Danger));
    }
    /// <summary>The window a place opens in: "senate:duties" is the Senate; a system on the map is Worlds; a fleet is Military.</summary>
    private static string WindowOf(string go)
    {
        string s = go.Split(':')[0];
        return s switch { "you" or "character" => "character", "worlds" or "planets" or "galaxy" => "planets", "fleet" => "military", _ => s };
    }
    private bool _hasAutosave, _epilogueDismissed, _savedFlash; private string _saveLabel = "", _flashText = "Saved.", _exportNote = "";
    /// <summary>The Academy: this browser has graduated before (so the short course is offered first); the year just ended (so the passing-out card shows).</summary>
    private bool _beenBefore, _passingOut;
    private BriefingCard? _openReport;
    /// <summary>The reports Enter has already put in front this year: Enter opens each unanswered one once, then ends the year.</summary>
    private readonly HashSet<object> _enterShown = new(ReferenceEqualityComparer.Instance);
    private SuccessionRecord? _succession; private bool _primer, _primerChecked, _saves, _settings; private int _keptSaves; private ClientSettings _set = ClientSettings.Default;
    /* the year in brief: shown as each year opens unless the player has said not to (kept in this browser), and from the year in the top bar */
    private bool _brief, _briefEvery = true, _briefAsked;
    private void BriefGo(string target) { _brief = false; Go(target); }
    private async Task SetBriefEvery(bool on) { _briefEvery = on; try { await JS.InvokeVoidAsync("localStorage.setItem", "praetoria.brief.every", on ? "1" : "0"); } catch { } }
    private string? _lastProtagonist;
    private GalaxyMap? _map;
    private ElementReference _shell;
    private DotNetObjectReference<Index>? _self;

    /* the shell's own state: the game menu, the legend, the map's mode (as the map reports it), a screen under 1500px wide */
    private bool _menu, _legend, _narrow; private string _mode = "houses", _miniId = ""; private ElementReference _mini;
    private string ModeName => _mode switch { "realms" => "Realms", "systems" => "Systems", "system" => "The system", "regions" => "Regions", "supply" => "Supply", _ => "Houses" };
    /// <summary>A tool of the console: the map is moved by js/shell.js through the map's own script, never drawn by it.</summary>
    private async Task MapDo(string what) { try { await JS.InvokeVoidAsync("praetoriaShell.map", what); } catch { } }
    /// <summary>The map's mode, as the camera's distance makes it (js/shell.js): "realms" from far off, "houses", "systems" close to, "system" inside one.</summary>
    [JSInvokable] public void MapMode(string mode) { if (mode != _mode) { _mode = mode; StateHasChanged(); } }
    /// <summary>The screen is under 1500px wide: the outliner folds to its heads (docs/VISUAL_SYSTEM.md 3.10).</summary>
    [JSInvokable] public void Narrow(bool narrow) { if (narrow != _narrow) { _narrow = narrow; StateHasChanged(); } }
    /// <summary>The client's own notes, as toasts that hold while they stand: what was taken back or could not be done, a save, an export.</summary>
    private List<Toasts.Note> Notes()
    {
        var n = new List<Toasts.Note>();
        if (G.LastNotice != null) n.Add(new("anticlockwise-rotation", "Notice", G.LastNotice));
        if (_savedFlash) n.Add(new("save", "Saved", _flashText));
        if (_exportNote.Length > 0) n.Add(new("export", "Export", _exportNote, true));
        return n;
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (_mini.Id != null && _mini.Id != _miniId) { _miniId = _mini.Id; try { await JS.InvokeVoidAsync("praetoriaShell.watch", _self, _mini); } catch { } }
        if (_perfRender != 0) { Console.WriteLine($"PERF render after the turn: {System.Diagnostics.Stopwatch.GetElapsedTime(_perfRender).TotalMilliseconds:F0} ms"); _perfRender = 0; }
        if (G.Turn != null) await CheckPrimer();
        await FirstYearsCheck();
        if (first) { _self = DotNetObjectReference.Create(this); try { await JS.InvokeVoidAsync("praetoria.keys", _self); } catch { } }
        try { await JS.InvokeVoidAsync("praetoriaFx.paint"); await JS.InvokeVoidAsync("praetoriaBust.paint"); } catch { }
    }

    /// <summary>The keys of the rail, in its order: the first nine windows by number, then 0, - and = for the rest.</summary>
    private const string RailKeys = "1234567890-=";
    /// <summary>Keyboard: the rail's keys switch windows (while a report is open, the digits pick its choices instead), Enter opens each
    /// unanswered report in turn and then ends the year (when no report is open), Escape closes a window, ? opens the primer. A box over
    /// everything takes every key first.</summary>
    [JSInvokable]
    public async Task Key(string key)
    {
        if (G.Turn == null) return;
        // a box over everything (ConfirmBox.razor) holds the keys, so none reaches the desk behind it and ends the year there: the question
        // takes Escape for its "no" (its "yes" wants a click, as it cannot be taken back), and what came of an answer takes Enter or Escape
        if (G.Asking != null) { if (key == "Escape") G.Answer(false); return; }
        if (G.Told != null) { if (key is "Enter" or "Escape") G.Dismiss(); return; }
        // so do the cards that stand in front of a year: the passing-out card takes Enter or Escape for "To the desk", and the saga's
        // turning takes them for "Play on" (the end of the line has no year after it, so no key acts behind it)
        if (_passingOut && G.Academy() is { Graduated: true }) { if (key is "Enter" or "Escape") { _passingOut = false; StateHasChanged(); } return; }
        if (G.Court() is { EpilogueText: not null } ep && !_epilogueDismissed) { if ((key is "Enter" or "Escape") && !ep.DynastyDead) { _epilogueDismissed = true; StateHasChanged(); } return; }
        // and so do the year's moments (MomentCard): the card in front takes Enter or Escape to close it, a profile opened from its faces
        // closing first; the seat passing, the first of them, takes Enter as well as Escape
        if (_cards.Count > 0 && _succession == null) { if (G.ProfileId != null) { if (key == "Escape") G.CloseProfile(); } else if (key is "Enter" or "Escape") NextCard(); StateHasChanged(); return; }
        if (_succession != null && G.ProfileId == null && key == "Enter") { CloseSuccession(); StateHasChanged(); return; }
        if (_settings) { if (key == "Escape") _settings = false; else return; }   // the settings are in front
        else if (_saves) { if (key == "Escape") _saves = false; else return; }   // the saves window is in front
        else if (_primer) { if (key is "Escape" or "?") await ClosePrimer(); else return; }   // the handbook is in front: it takes Escape, and no key reaches the desk behind it
        else if (key == "Escape" && _menu) _menu = false;   // the game menu is in front
        else if (key == "Escape" && _brief) _brief = false;
        // Escape closes what is in front, a step at a time; with nothing in front it opens the game menu (docs/VISUAL_SYSTEM.md 3.1)
        else if (key == "Escape") { if (G.ProfileId != null) G.CloseProfile(); else if (_openReport != null || _succession != null) { _openReport = null; _succession = null; } else if (_screen == "galaxy" && _map?.Up() == true) { } else if (_screen != "galaxy") _screen = "galaxy"; else _menu = true; }
        else if (key == "Enter" && _brief) _brief = false;
        else if (key == "Enter" && _openReport == null && _succession == null)
        {
            if (!_set.EnterEnds) return;
            // Enter goes on to what is waiting before it ends the year: each unanswered report that can be answered opens once, and with
            // none left the year ends (a click on End Year still sets them aside, and its count says how many)
            var next = G.Court().Briefing.FirstOrDefault(b => !b.Resolved && !_enterShown.Contains(b.Item) && b.Choices.Any(c => c.Available));
            if (next != null) { _enterShown.Add(next.Item); _openReport = next; } else await EndTurn();
        }
        else if (key == "?") _primer = !_primer;
        // a report is open: the digits 1 to 9 pick its choices (docs/VISUAL_SYSTEM.md 6), and no digit reaches the rail behind it
        else if ((_openReport != null || _succession != null) && key.Length == 1 && RailKeys.IndexOf(key[0]) >= 0)
        {
            if (_openReport == null || key[0] is < '1' or > '9') return;
            var card = G.Court().Briefing.FirstOrDefault(b => ReferenceEquals(b.Item, _openReport.Item));
            int n = key[0] - '0';
            if (card == null || card.Resolved || n > card.Choices.Count || !card.Choices[n - 1].Available) return;
            Choose((card, card.Choices[n - 1].Id));
        }
        else if (_set.NumberKeys && key.Length == 1 && RailKeys.IndexOf(key[0]) is >= 0 and var i && G.World?.InAcademy != true) { var rail = Rail().ToList(); if (i < rail.Count) _screen = rail[i].id; }
        else return;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        G.Changed += OnChanged;
        Praetoria.Core.Diagnostics.Perf.Enabled = Nav.Uri.Contains("perf");
        _parts = new Uri(Nav.Uri).Query.Contains("parts");
        await G.LoadAsync();
        await ReadSaves(); await ReadSettings();
        try { _beenBefore = !string.IsNullOrEmpty(await JS.InvokeAsync<string?>("localStorage.getItem", "praetoria.academy.graduated")); } catch { }
    }

    private void OnChanged()
    {
        if (G.World != null)
        {
            if (_lastProtagonist != null && _lastProtagonist != G.World.ProtagonistId && !G.World.IsDynastyDead)
            {
                _succession = G.World.Successions.LastOrDefault(s => s.HeirId == G.World.ProtagonistId) ?? new SuccessionRecord { Turn = G.World.Turn, Generation = G.World.Counter("generation"), DeceasedId = _lastProtagonist, DeceasedName = G.World.Char(_lastProtagonist)?.Name ?? "", DeceasedAge = G.World.Char(_lastProtagonist)?.Age ?? 0, HeirId = G.World.ProtagonistId, HeirName = G.World.Protagonist?.Name ?? "", HeirAge = G.World.Protagonist?.Age ?? 0 };
            }
            _lastProtagonist = G.World.ProtagonistId;
        }
        InvokeAsync(StateHasChanged);
    }

    // "senate:duties" opens the Senate on its duties tab: an alert goes to the thing it is about, not to the screen it is somewhere on
    private string _tab = ""; private int _tabStamp;
    private void Go(string id)
    {
        int i = id.IndexOf(':'); string screen = i < 0 ? id : id[..i], tab = i < 0 ? "" : id[(i + 1)..];
        if (screen == "you") screen = "character"; if (screen == "worlds") screen = "planets";
        // a place on the map is its subject: the map comes forward on that system, with its panel open (docs/PLAYTHROUGH.md 15)
        if (screen == "fleet") { _screen = "galaxy"; if (tab.Length > 0) _ = _map?.PickFleet(tab); return; }
        if (screen == "galaxy") { _screen = "galaxy"; if (tab.Length > 0) _ = _map?.Select(tab); return; }
        _screen = screen; _tab = tab; _tabStamp++;
    }
    private void Teach(string mode) => G.Execute(new SetTutorialCommand(G.World!.ProtagonistId, mode));
    /// <summary>The seat has passed: the heir lands on their register's home screen, so the change of life is seen at once.</summary>
    private void CloseSuccession() { _succession = null; if (G.World != null) _screen = RoleTheme.Home(RoleTheme.Of(G.World)); }

    /// <summary>The primer opens once, on the first turn of a new run, unless this browser has seen it (GAP §10 item 1).</summary>
    private async Task CheckPrimer()
    {
        if (_primerChecked || G.World == null || G.World.InAcademy) return; _primerChecked = true;
        if (G.World.Academy is { Graduated: true }) return;   // the Academy was the tutorial
        if (G.World.Turn > 1) return;
        try { var seen = await JS.InvokeAsync<string?>("localStorage.getItem", "praetoria.primer.seen"); if (string.IsNullOrEmpty(seen)) { _primer = true; StateHasChanged(); } } catch { }
    }
    private async Task ClosePrimer() { _primer = false; try { await JS.InvokeVoidAsync("localStorage.setItem", "praetoria.primer.seen", "1"); } catch { } }
    private void FocusSystem(string systemId) { _screen = "galaxy"; if (!string.IsNullOrEmpty(systemId)) _ = _map?.Select(systemId); }
    private void OpenReport(BriefingCard card) => _openReport = card;
    private void Choose((BriefingCard card, string choiceId) pick) { G.Resolve(pick.card.Item, pick.choiceId, pick.card.Title, pick.card.Choices.FirstOrDefault(c => c.Id == pick.choiceId)?.Label ?? ""); _openReport = null; }

    /// <summary>End Turn asks first when the year would end with the treasury below nought (docs/PLAYTHROUGH.md 6).</summary>
    private async Task EndTurn()
    {
        if (G.World is { InAcademy: false } w && G.Turn?.Economy is { } eco && w.Protagonist is { } head && w.House(head.HouseId) is { } house)
        {
            int end = HouseAccounts.YearEnd(w, G.Content!.Holdings, house, eco.Forecast(w, house.Id, G.Turn.Fleets), Resource.Credits, eco);
            if (end < 0 && house.Treasury.Credits >= 0)
            {
                G.Ask("The year will end " + Money.Credits(-end) + " short", "With what the house takes in and what it has promised to pay this year, the treasury will stand at " + Money.Show(end) + ". A house below nought is insolvent: unrest climbs on its worlds, unpaid crews desert, and building stops." + (head.Purse > 0 ? " Your own purse holds " + Money.Credits(head.Purse) + ": it can be put into the treasury in House, under Purses and the will." : ""), "End the year anyway", () => _ = InvokeAsync(EndTurnNow), "Go back");
                return;
            }
        }
        await EndTurnNow();
    }
    private async Task EndTurnNow()
    {
        long perfStart = System.Diagnostics.Stopwatch.GetTimestamp();
        _openReport = null; _enterShown.Clear();
        bool cadet = G.World?.InAcademy == true; string tutorial = G.World?.Academy?.Tutorial ?? "";
        G.EndTurn();
        if (cadet && G.World?.InAcademy == false)
        {
            // the year is over: the passing-out card, the Office, and this browser remembers it has been through the Academy
            _passingOut = true; _beenBefore = true; _screen = "office"; _primerChecked = true;
            try { await JS.InvokeVoidAsync("localStorage.setItem", "praetoria.academy.graduated", "1"); if (tutorial == "full") await JS.InvokeVoidAsync("localStorage.setItem", "praetoria.primer.seen", "1"); } catch { }
        }
        _epilogueDismissed = false;
        if (!_briefAsked) { _briefAsked = true; try { _briefEvery = await JS.InvokeAsync<string?>("localStorage.getItem", "praetoria.brief.every") != "0"; } catch { } }
        _brief = _briefEvery && !cadet && G.World is { InAcademy: false, IsDynastyDead: false } bw && YearInBrief.For(bw, G.Content!).Count > 0;
        var first = G.Court().Briefing.FirstOrDefault(b => !b.Resolved);
        if (first != null && _screen == "office" && G.World?.InAcademy != true && !_passingOut && !_brief) _openReport = first;    // the first visitor steps forward (not at the Academy: the term's page comes first)
        QueueCards(cadet);   // the year's moments open first, one at a time: the year in brief and the first visitor wait for them
        using (Praetoria.Core.Diagnostics.Perf.Time("client:autosave to the browser")) await Autosave();
        if (Praetoria.Core.Diagnostics.Perf.Enabled)
        {
            // ?perf in the address: where the year's seconds went, in the console (rendering is whatever is left after this line)
            Console.WriteLine($"PERF turn {G.World?.Turn}: handler {System.Diagnostics.Stopwatch.GetElapsedTime(perfStart).TotalMilliseconds:F0} ms · " + string.Join(" · ", Praetoria.Core.Diagnostics.Perf.Report().Take(14).Select(x => $"{x.name} {x.ms:F0}")));
            Praetoria.Core.Diagnostics.Perf.Reset(); _perfRender = System.Diagnostics.Stopwatch.GetTimestamp();
        }
    }
    private long _perfRender;

    /* The year's moments (docs/WEB_CLIENT.md, "After End Year"; Core's YearMoments): the heaviest three of the year just ended, a death in
       the main line first, open one at a time before the year in brief. The seat passing is among them and the succession screen stages
       it. While they stand, the year in brief and the first visitor are held, and given back when the last card closes. */
    private List<Moment> _cards = new(); private int _cardsOf; private bool _briefAfter; private BriefingCard? _visitorAfter;
    private void QueueCards(bool cadet)
    {
        _cards = !cadet && !_passingOut && G.World is { InAcademy: false, IsDynastyDead: false } w ? YearMoments.Cards(w, G.Content!).Where(m => !(m.Staged && _succession != null)).ToList() : new();
        _cardsOf = _cards.Count; if (_cards.Count == 0) return;
        _briefAfter = _brief; _brief = false; _visitorAfter = _openReport; _openReport = null;
    }
    private void NextCard()
    {
        if (_cards.Count > 0) _cards.RemoveAt(0);
        if (_cards.Count > 0) return;
        _cardsOf = 0; _brief = _briefAfter; _briefAfter = false; _openReport = _visitorAfter; _visitorAfter = null;
    }

    /// <summary>The settings this browser keeps (docs/WEB_CLIENT.md, "Settings"): read at the start and whenever one is changed.</summary>
    private async Task ReadSettings()
    {
        try { _set = ClientSettings.Parse(await JS.InvokeAsync<string>("praetoriaSettings.get")); _briefEvery = await JS.InvokeAsync<string?>("localStorage.getItem", "praetoria.brief.every") != "0"; _briefAsked = true; } catch { }
        StateHasChanged();
    }
    /// <summary>What is saved in this browser: whether there is a running saga and what it is called, and how many kept saves there are.</summary>
    private async Task ReadSaves()
    {
        try
        {
            _hasAutosave = !string.IsNullOrEmpty(await JS.InvokeAsync<string?>("praetoria.has", GameClient.AutosaveKey));
            _saveLabel = _hasAutosave ? await JS.InvokeAsync<string?>("praetoria.load", GameClient.AutosaveKey + ":label") ?? "" : "";
            int kept = 0; for (int i = 1; i <= GameClient.Slots; i++) if (!string.IsNullOrEmpty(await JS.InvokeAsync<string?>("praetoria.has", GameClient.SlotKey(i)))) kept++;
            _keptSaves = kept;
        }
        catch { }
        StateHasChanged();
    }
    /// <summary>A save chosen from the list is loaded: whatever was open belongs to the game that is being left.</summary>
    private void LoadSave(string json)
    {
        _saves = false; _openReport = null; _enterShown.Clear(); _succession = null; _brief = false; _passingOut = false; _epilogueDismissed = false; _primerChecked = true;
        try { G.LoadJson(json); if (G.World is { InAcademy: false }) _screen = "galaxy"; } catch { G.Ask("That save could not be loaded", "It may have been made by a newer version of the game, or the browser may have cut it short.", "Close", () => { }, "Close"); }
        StateHasChanged();
    }
    /// <summary>Take back the last thing done this year (docs/PLAYTHROUGH.md, a first game).</summary>
    private void Undo() { _openReport = null; G.Undo(); StateHasChanged(); }
    private async Task Autosave()
    {
        try
        {
            string json = G.SaveJson(); long t = System.Diagnostics.Stopwatch.GetTimestamp();
            await JS.InvokeVoidAsync("praetoria.save", GameClient.AutosaveKey, json); _hasAutosave = true;
            // what the saved saga is, for the Continue button on the title (docs/PLAYTHROUGH.md: "Continue names the saga and the year")
            if (G.World?.Protagonist != null) { _saveLabel = G.SaveLabel(); await JS.InvokeVoidAsync("praetoria.save", GameClient.AutosaveKey + ":label", _saveLabel); }
            if (Praetoria.Core.Diagnostics.Perf.Enabled) Console.WriteLine($"PERF save call returned after {System.Diagnostics.Stopwatch.GetElapsedTime(t).TotalMilliseconds:F0} ms ({json.Length} chars)");
        }
        catch { }
    }
    private async Task SaveLocal() { await Autosave(); _flashText = "Saved."; _savedFlash = true; StateHasChanged(); await Task.Delay(1500); _savedFlash = false; StateHasChanged(); }
    private async Task Download()
    {
        string file = $"praetoria-year{G.World!.Turn}.json";
        try { await JS.InvokeVoidAsync("praetoria.download", file, G.SaveJson()); _exportNote = "Exported as " + file + ": look in your downloads. It can be loaded again from the title screen."; }
        catch { _exportNote = "The export could not be written."; }
        StateHasChanged(); await Task.Delay(5000); _exportNote = ""; StateHasChanged();
    }
    private async Task ContinueAutosave() { try { var json = await JS.InvokeAsync<string?>("praetoria.load", GameClient.AutosaveKey); if (!string.IsNullOrEmpty(json)) G.LoadJson(json); } catch { } }
    private void LoadFromJson(string json) { try { G.LoadJson(json); } catch { } }
    /// <summary>Quit asks first, and says what is kept (docs/PLAYTHROUGH.md 2).</summary>
    private void Abandon()
    {
        if (G.World == null || G.World.IsDynastyDead) { Leave(); return; }
        G.Ask("Leave this saga?", "It is saved first, as it stands now in year " + G.World.Turn + ", and \"Continue\" on the title brings it back here.", "Save and leave", () => _ = SaveAndLeave(), "Stay");
    }
    private async Task SaveAndLeave() { await Autosave(); Leave(); await ReadSaves(); }
    private void Leave() { _epilogueDismissed = false; _screen = "office"; _openReport = null; _succession = null; _lastProtagonist = null; _passingOut = false; _primerChecked = false; G.Abandon(); }
    public void Dispose() { G.Changed -= OnChanged; _self?.Dispose(); }
}

@code {
    // ---- the first years (docs/ACADEMY.md, "The first years"; docs/WEB_CLIENT.md, "The first years") ----
    // Whether this browser's first game is still to come or under way is kept as praetoria.firstyears: "on" while a first game's list
    // stands, "done" once one has ended (every step done, put away, or its third year over). A browser that has neither, and has not seen
    // the primer, is a newcomer's. The rail's labels show by themselves in a first game's first years, unless chosen in Options.
    private bool _firstRead; private string _firstYears = "";
    private async Task FirstYearsCheck()
    {
        if (!_firstRead)
        {
            _firstRead = true;
            try
            {
                _firstYears = await JS.InvokeAsync<string?>("localStorage.getItem", "praetoria.firstyears") ?? "";
                bool primerSeen = !string.IsNullOrEmpty(await JS.InvokeAsync<string?>("localStorage.getItem", "praetoria.primer.seen"));
                G.FirstGame = _firstYears == "on" || (_firstYears.Length == 0 && !primerSeen);
            }
            catch { }
        }
        if (G.World is { InAcademy: false, FirstSteps: not null } w && G.Content is { } c)
        {
            var cat = c.Academy.FirstYears; string now = _firstYears;
            if (!FirstStepsSystem.Active(w)) now = "done";   // a cadet who asked only to be briefed knows the Reach
            else if (now.Length == 0) now = "on";
            if (now == "on" && (w.FirstSteps.Dismissed || w.Turn > cat.Years || FirstStepsSystem.AllDone(w, cat))) now = "done";
            if (now != _firstYears) { _firstYears = now; G.FirstGame = now == "on"; try { await JS.InvokeVoidAsync("localStorage.setItem", "praetoria.firstyears", now); } catch { } }
        }
        var shown = _set.WithLabels(G.Turn != null && G.LabelsByThemselves);
        if (shown != _set) { _set = shown; StateHasChanged(); }
    }
}
