@using Praetoria.Core.Systems
@inject GameClient G
@implements IDisposable
@* The house's own court (docs/COURT.md; the owner, 2026-11-22: "families (house) should have a small court, but not the same thing
   as the title court"), on the House window's Court tab. Seven small positions that go with the house whatever rank or office it
   holds, each held by one of the commons sworn to the house or by one of the family. Each position is a row (docs/VISUAL_SYSTEM.md
   4.7): who holds it and what it is worth this year; an empty one lists who of the commons offers, and who of the family could. *@
@{
    var w = G.World!; var c = G.Content!; var p = w.Protagonist!; var pid = p.Id; var house = w.House(p.HouseId)!; var names = c.Names;
    int wages = CourtSystem.Wages(w, house); var wageLaw = c.Policies.Laws.FirstOrDefault(l => l.Id == "household_wages"); var wageNow = wageLaw != null ? PolicySystem.Option(w, c.Policies, house.Id, wageLaw.Id) : null;
    int lawWage = PolicySystem.Modifier(w, c.Policies, house.Id, "court_wage"); int paid = house.Court.Where(r => r.KinId.Length == 0).Sum(r => Math.Max(0, r.Wage + lawWage));
    var kin = w.LivingCharacters().Where(k => k.HouseId == house.Id && k.Id != pid && k.Age >= DynastySystem.AgeOfMajority).OrderBy(k => k.Id, StringComparer.Ordinal).ToList();
}
<section class="panel household council court hs-court" data-court-panel>
    <p class="ui-lede hs-lede" data-court>@HouseScreen.Bold($"Seven small positions that belong to the house, {house.Court.Count} of them filled. They go with you whatever you rise to, and stay if you fall.")</p>
    <Section Title="The house's court" Count="@($"{house.Court.Count} of {CourtSystem.Positions.Length}")" Info="Seven small positions that belong to the house and not to any rank or office it holds: they go with you whatever you rise to, and stay if you fall. Each is held by one of the commons sworn to the house, who is paid, or by one of the family, who is not. Nothing has to be filled.">
        <Right><span class="court-sum" data-court-sum="@house.Court.Count" title="@($"{house.Court.Count} of {CourtSystem.Positions.Length} filled.{(wageLaw != null ? $" {wageLaw.Name}: {wageNow?.Name ?? "unset"}, set in the Laws window." : "")}")">Wages <b>@Money.Coin(paid)</b> a year</span></Right>
        <ChildContent>
    @foreach (var role in CourtSystem.Positions)
    {
        var r = house.Position(role); string rl = role; int skill = CourtSystem.Skill(w, house.Id, role);
        <div class="duty hs-post @(r == null ? "empty" : "")" data-position="@role" data-held="@(r != null ? "1" : "0")">
            <Row Name="@CourtSystem.Name(role)" Tip="@CourtSystem.Does(role)">
                <Picture>
                    @if (r != null) { <Portrait Id="@(r.KinId.Length > 0 ? r.KinId : r.Id)" Name="@r.Name" Sex="@r.Sex" Age="@r.Age" Accent="@house.AccentColor" Size="46" Height="56" Opens="@(r.KinId.Length > 0)" /> }
                    else { <Portrait Size="46" Height="56" EmptyGlyph="@Glyph(role)" Name="@($"{CourtSystem.Name(role)}: empty")" /> }
                </Picture>
                <Sub>@if (r != null) { <span><b>@r.Name</b>, @r.Age · @(r.KinId.Length > 0 ? "of the family" : "of the commons") · @Years(w.Turn - r.Since) in the place</span> } else { <span class="ui-mute">Empty. @Without(role)</span> }</Sub>
                <Cells>
                    @if (r != null)
                    {
                        <span class="ui-cell" title="How good they are at it, of five. It is what the position is worth where it acts. One of the commons grows a point better every six years in the place.">@skill<small>&nbsp;of @CourtSystem.MaxSkill</small></span>
                        @if (r.KinId.Length == 0)
                        {
                            <Cell Icon="credits" Value="@Math.Max(0, r.Wage + lawWage).ToString()" Tip="Their wage a year, in single credits" />
                            <span class="ui-cell @(r.Loyalty < 30 ? "ui-down" : "")" title="How far they are the house's own. It grows each year they are paid and falls hard each year they are not. At 60 they stay through unpaid years; under it, two unpaid years and they go.">@r.Loyalty<small>&nbsp;loyal</small></span>
                        }
                    }
                </Cells>
                <Action>@if (r != null) { <Plate Label="@(r.KinId.Length > 0 ? "Take it back" : "Let them go")" Small="true" data-dismiss="@role" Tip="@(r.KinId.Length > 0 ? "Take the place back from them." : "Let them go. Somebody who has served eight years or more is not turned out without the rest of the household seeing it.")" OnClick="() => G.Execute(new RetainerCommand(pid, RetainerCommand.Dismiss, rl, string.Empty, names))" /> }
                    else
                    {
                        @* one Appoint select (docs/VISUAL_SYSTEM.md 4.12): the commons who offer this year, with their skill of five and their wage, and the
                           family who could, for nothing; one who may not is kept with the reason as its note, the whole line of each in the tooltip *@
                        var offers = CourtSystem.Offers(w, names, house, role).ToList();
                        var could = kin.Where(k => CourtSystem.AppointRefusal(w, p, role, k) == null).OrderByDescending(k => CourtSystem.KinFit(k, role)).ThenBy(k => k.Id, StringComparer.Ordinal).Take(4).ToList();
                        var opts = offers.Select(o => { var no = CourtSystem.HireRefusal(w, names, p, role, o.Id); return new Select.Option(no == null ? "hire:" + o.Id : "x:" + o.Id, $"{o.Name}, {o.Age} · skill {o.Skill} of {CourtSystem.MaxSkill}", no != null ? "cannot: " + LawsScreen.Say(no) : $"a wage of {Math.Max(0, o.Wage + lawWage)} a year · {Sentence(o.From)}", o.Id, o.Sex, o.Age, house.AccentColor); })
                            .Concat(could.Select(k => new Select.Option("kin:" + k.Id, $"{k.Name} · skill {CourtSystem.KinFit(k, role)} of {CourtSystem.MaxSkill}", "of the family, for nothing", k.Id, k.Sex, k.Age, house.AccentColor))).ToList();
                        if (opts.Count > 0) { <span data-offers="@role" data-kin-for="@role"><Select Value="" Placeholder="Appoint" Class="hs-appoint" Tip="Swear one of the commons to the house for a wage, or give the place to one of the family for nothing" Options="@opts" OnChange="v => Fill(rl, v)" /></span> }
                        else { <span class="hs-mute-s" data-offers="@role">Nobody offers this year</span> }
                    }
                </Action>
            </Row>
            <div class="hs-post-body">
            @if (r != null)
            {
                @if (r.UnpaidYears > 0) { <WarnStrip Icon="credits" Lead="Unpaid." Bad="true">They have gone unpaid for @Counted.Years(r.UnpaidYears).</WarnStrip> }
                <p class="hs-says"><Icon Name="sprout" Tone="good" Size="15" />@Worth(role, skill)</p>
                @if (r.From.Length > 0) { <p class="hs-note">@Sentence(r.From)</p> }
            }
            </div>
        </div>
    }
        </ChildContent>
    </Section>
</section>

@code {
    // A panel with no parameters is not redrawn when its parent is, so it listens for the world changing itself.
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;
    private static string First(string name) => name.Split(' ')[0];
    private void Fill(string role, string v)
    {
        var w = G.World!; var pid = w.ProtagonistId; var names = G.Content!.Names; int at = v.IndexOf(':'); if (at < 0) return; string kind = v[..at], id = v[(at + 1)..];
        if (kind == "hire") G.Execute(new RetainerCommand(pid, RetainerCommand.Hire, role, id, names));
        else if (kind == "kin") G.Execute(new RetainerCommand(pid, RetainerCommand.Appoint, role, id, names));
    }
    private static string Sentence(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..] + ".";
    private static string Years(int n) => n <= 0 ? "this year" : n == 1 ? "a year" : $"{n} years";
    /// <summary>Skill as five drawn pips, the held ones lit (the Unicode dots are gone: docs/VISUAL_SYSTEM.md 8.1).</summary>
    private static RenderFragment Pips(int n) => b =>
    {
        int k = Math.Clamp(n, 0, CourtSystem.MaxSkill);
        b.OpenElement(0, "span"); b.AddAttribute(1, "class", "hs-pips"); b.AddAttribute(2, "title", $"Skill {k} of {CourtSystem.MaxSkill}"); b.AddAttribute(3, "aria-label", $"skill {k} of {CourtSystem.MaxSkill}");
        for (int i = 0; i < CourtSystem.MaxSkill; i++) { b.OpenElement(4, "i"); if (i < k) b.AddAttribute(5, "class", "on"); b.CloseElement(); }
        b.CloseElement();
    };
    private static string Glyph(string role) => role switch
    {
        CourtSystem.Tutor => "open-book", CourtSystem.Nurse => "family-house", CourtSystem.Physician => "caduceus", CourtSystem.Guard => "checked-shield",
        CourtSystem.DuelMaster => "crossed-sabres", CourtSystem.Shipwright => "ship", CourtSystem.Ceremonies => "laurels", _ => "throne-king"
    };
    /// <summary>What the place is worth this year, in the figure the rule uses.</summary>
    private static string Worth(string role, int s) => role switch
    {
        CourtSystem.Tutor => s >= 4 ? "Every child of the house learns as from the best tutor money buys." : "Every child of the house learns as from a paid tutor.",
        CourtSystem.Nurse => $"Children come to the house {(int)Math.Round(100 * CourtSystem.NursePerSkill * s)}% more readily.",
        CourtSystem.Physician => $"Somebody ill is well again within the year {Math.Min(100, 10 * (4 + s))} times in a hundred, and is less hurt by it meanwhile.",
        CourtSystem.Guard => $"A knife meant for one of the house is {(int)Math.Round(100 * CourtSystem.GuardPerSkill * s)} points in a hundred less likely to find them.",
        CourtSystem.DuelMaster => "Each year the least practised of the young is drilled, and may be the better with a pistol or a line of battle for it.",
        CourtSystem.Shipwright => $"{CourtSystem.ShipwrightPctPerSkill * s}% of the materials of every hull laid down come back, and fleets in port gain {s} readiness a year.",
        CourtSystem.Ceremonies => $"The old blood think {(s >= 4 ? 2 : 1)} the better of the house each year, and a wedding of the house adds to its legitimacy.",
        _ => ""
    };
    private static string Without(string role) => role switch
    {
        CourtSystem.Tutor => "Each child is taught only by a tutor paid for one at a time.",
        CourtSystem.Nurse => "The mothers of the house nurse their own.",
        CourtSystem.Physician => "The sick of the house pay a physician from their own purse, if they have one.",
        CourtSystem.Guard => "Nobody stands between the house and a knife.",
        CourtSystem.DuelMaster => "The young learn arms where they can.",
        CourtSystem.Shipwright => "The yards run themselves.",
        CourtSystem.Ceremonies => "Weddings and feasts are ordered by whoever is to hand.",
        _ => ""
    };
}
