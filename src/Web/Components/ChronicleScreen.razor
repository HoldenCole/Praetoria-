@inject GameClient G
@implements IDisposable
@{
    var w = G.World!; var house = w.House(w.Protagonist!.HouseId)!;
    var volumes = Volumes(w);
    if (_volume == null || !volumes.Any(v => v.key == _volume)) _volume = volumes.LastOrDefault().key;
    var vol = volumes.FirstOrDefault(v => v.key == _volume);
    var turns = w.History.Where(h => vol.key != null && h.Turn >= vol.from && h.Turn <= vol.to).GroupBy(h => h.Turn).OrderByDescending(g => g.Key).ToList();
    var ticks = w.History.GroupBy(h => h.Turn).ToDictionary(g => g.Key, g => (notable: g.Any(h => h.EventId != null || Notable(h.Text)), war: g.Any(h => Martial(h.Text)), gen: g.Any(h => h.Text.Contains("succeeds")), n: g.Count()));
    int last = Math.Max(1, w.Turn); int maxN = Math.Max(1, ticks.Values.Select(t => t.n).DefaultIfEmpty(1).Max());
    string F(double v) => v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
    double TX(int t) => 20 + (t - 1) * 960.0 / Math.Max(1, last);

    // The picture (docs/DASHBOARDS.md): what the last year said of your house and of the Reach, and what the record adds up to.
    string surname = house.Name.StartsWith("House ") ? house.Name[6..] : house.Name;
    bool Own(HistoryEntry h) => h.Text.Contains(surname, StringComparison.Ordinal);
    int lastYear = w.History.Count > 0 ? w.History.Max(h => h.Turn) : 0;
    var thisYear = w.History.Where(h => h.Turn == lastYear).ToList(); var ownThis = thisYear.Where(Own).ToList();
    int ownAll = w.History.Count(Own), standing = w.Houses.Values.Count(h => h.Id != PirateSystem.HouseId && Economy.HeadOf(w, h) != null);
    int battles = w.Counter(FleetSystem.BattlesCounter), won = w.Counter(FleetSystem.BattlesWonCounter), gen = Math.Max(1, w.Counter("generation"));
    string story = w.History.Count == 0 ? "Nothing is written yet. The chronicle fills as the years pass: what your house did, and what the Reach did around it."
        : ownThis.Count > 0 ? $"Year {lastYear}, of your house: {ownThis[^1].Text}{(ownThis.Count > 1 ? $" And {ownThis.Count - 1} more." : "")} Of the rest of the Reach, {Counted.Things(thisYear.Count - ownThis.Count)} {Counted.Were(thisYear.Count - ownThis.Count)} written."
        : $"Year {lastYear}: nothing was written of your house. Of the Reach, {Counted.Things(thisYear.Count)}; the latest: {thisYear[^1].Text}";
    var shown = turns.Select(g => (year: g.Key, all: g.Count(), lines: g.Where(h => (!_onlyNotable || h.EventId != null || Notable(h.Text)) && Kind(h.Text) && (_whose == "all" || (_whose == "house") == Own(h))).ToList())).Where(x => x.lines.Count > 0).ToList();
    int every = last <= 20 ? 1 : last <= 60 ? 5 : 10;
}
<div class="dash archive" style="--accent:@house.AccentColor">
    <header class="dash-head picture">
        <div class="dh-title"><Icon Name="chronicle" Size="18" /> <b>The Chronicle of @house.Name</b> <span class="muted">@w.History.Count entries over @w.Turn years</span></div>
        <p class="headline">@story</p>
        <div class="tiles">
            <Tile Label="Written" Value="@($"{w.History.Count} entries")" Share="@(w.History.Count > 0 ? 100 * ownAll / w.History.Count : 0)" Note="@($"{ownAll} of your house · about {w.History.Count / Math.Max(1, w.Turn)} a year")" Title="The bar is the share of the record that is about your own house." />
            <Tile Label="Wars declared" Value="@w.Counter(FleetSystem.WarsDeclaredCounter).ToString()" Tone="@(w.Wars.Count > 0 ? "warn" : "")" Note="@(w.Wars.Count == 0 ? "none being fought now" : $"{w.Wars.Count} being fought now")" />
            <Tile Label="Battles" Value="@battles.ToString()" Share="@(battles > 0 ? 100 * won / battles : -1)" Note="@(battles == 0 ? "none fought yet" : $"your house won {won}")" />
            <Tile Label="The Senate carried" Value="@($"{w.Counter("motions_passed")} motions")" Note="@($"{w.Counter("acts_passed")} of them Acts · {Counted.Laws(w.Counter("laws_enacted"))} changed by houses")" />
            <Tile Label="Houses fallen" Value="@w.Counter("houses_fallen").ToString()" Note="@($"{standing} still stand")" />
            <Tile Label="Seats passed" Value="@w.Successions.Count.ToString()" Note="@($"you are the {Ordinal(gen)} of your line to hold it")" />
        </div>
    </header>
    <div class="cw-tabs">
        <button class="rung @(_whose == "all" ? "here" : "")" @onclick='() => _whose = "all"'>All that was written</button>
        <button class="rung @(_whose == "house" ? "here" : "")" @onclick='() => _whose = "house"'>Of your house@(ownAll > 0 ? $" · {ownAll}" : "")</button>
        <button class="rung @(_whose == "reach" ? "here" : "")" @onclick='() => _whose = "reach"'>Of the Reach</button>
    </div>
    <div class="dash-grid archive-grid">
        <section class="panel">
            <svg class="timeline" viewBox="0 0 1000 118" role="img" aria-label="the years">
                <line x1="20" y1="80" x2="980" y2="80" class="base" />
                @foreach (var v in volumes.Where(v => v.key != "recent")) { <rect x="@F(TX(v.from) - 2)" y="8" width="@F(Math.Max(4, TX(Math.Min(last, v.to) + 1) - TX(v.from)))" height="96" class="vol @(v.key == _volume ? "here" : "")" @onclick="() => _volume = v.key"><title>@v.label</title></rect> }
                @for (int t = 1; t <= last; t++)
                {
                    if (t == 1 || t == last || t % every == 0) { @((MarkupString)$"<text x=\"{F(TX(t))}\" y=\"96\" class=\"tl mid\">{t}</text>") }
                    if (!ticks.TryGetValue(t, out var tk)) { continue; }
                    double h = 8 + 60.0 * tk.n / maxN;
                    <rect x="@F(TX(t) - 3)" y="@F(80 - h)" width="6" height="@F(h)" class="tick @(tk.war ? "war" : tk.notable ? "notable" : "")"><title>Year @t · @tk.n entr@(tk.n == 1 ? "y" : "ies")</title></rect>
                    @if (tk.gen) { @((MarkupString)$"<text x=\"{F(TX(t))}\" y=\"14\" class=\"gen\">★</text>") }
                }
                @((MarkupString)$"<text x=\"20\" y=\"112\" class=\"tl\">year</text><text x=\"980\" y=\"112\" class=\"tl end\">the fullest year: {maxN} entries</text>")
            </svg>
            <div class="plot-legend tl-key"><span><i class="tk war"></i> war or battle</span><span><i class="tk notable"></i> a notable year</span><span><i class="tk"></i> a quiet one</span><span><b class="gen">★</b> the seat passed</span><span class="muted">click a span of years to read it</span></div>
            <div class="row small chron-controls">
                <select class="sel" value="@_volume" @onchange="e => _volume = e.Value?.ToString()">@foreach (var v in volumes) { <option value="@v.key" selected="@(v.key == _volume)">@v.label</option> }</select>
                <span class="vols">@foreach (var k in new[] { "all", "war", "dynasty", "coin", "realm", "politics" }) { <button class="rung @(_kind == k ? "here" : "")" @onclick="() => _kind = k">@if (k != "all") { <i class="kd @k"></i> }@k</button> }</span>
                <label class="inline"><input type="checkbox" @bind="_onlyNotable" /> only the notable</label>
            </div>
            @if (shown.Count == 0) { <div class="muted">@(turns.Count == 0 ? "Nothing is written in these years yet." : _whose == "house" ? "Nothing of your house was written in these years." : "Nothing of that kind was written in these years. Choose another kind, or all.")</div> }
            @foreach (var y in shown)
            {
                <div class="year-block">
                    <h4>Year @y.year <span class="muted">@y.all written@(y.lines.Count != y.all ? $" · {y.lines.Count} shown" : "")</span></h4>
                    @foreach (var h in y.lines.OrderByDescending(Own)) { <div class="yline @(Own(h) ? "own" : "") @(h.EventId != null ? "event" : "")"><i class="kd @KindOf(h.Text)" title="@KindOf(h.Text)"></i>@h.Text</div> }
                </div>
            }
        </section>
    </div>
</div>

@code {
    // it takes no parameters, so nothing redrew it when a year passed while it was open
    private void Redraw() => InvokeAsync(StateHasChanged);
    protected override void OnInitialized() => G.Changed += Redraw;
    public void Dispose() => G.Changed -= Redraw;
    private string? _volume; private bool _onlyNotable; private string _kind = "all", _whose = "all";
    private static bool Notable(string t) =>
        t.Contains("war", StringComparison.OrdinalIgnoreCase) || t.Contains("dies") || t.Contains("born") || t.Contains("wed") || t.Contains("takes ") ||
        t.Contains("destroyed") || t.Contains("Crisis") || t.Contains("throne", StringComparison.OrdinalIgnoreCase) || t.Contains("succeeds") || t.Contains("desert");
    private bool Kind(string t) => _kind switch
    {
        "war" => Martial(t) || t.Contains("declares") || t.Contains("peace") || t.Contains("Raiders") || t.Contains("raiders") || t.Contains("campaign"),
        "dynasty" => t.Contains("born") || t.Contains("dies") || t.Contains("wed") || t.Contains("comes of age") || t.Contains("succeeds") || t.Contains("banner"),
        "coin" => t.Contains("credits") || t.Contains("founds") || t.Contains("stakes") || t.Contains("borrows") || t.Contains("sells") || t.Contains("buys") || t.Contains("tithe"),
        "realm" => t.Contains("rises") || t.Contains("breaks from") || t.Contains("Free March") || t.Contains("capital") || t.Contains("Crisis") || t.Contains("throne", StringComparison.OrdinalIgnoreCase) || t.Contains("governor") || t.Contains("rolls") || t.Contains("enters the service") || t.Contains("in fief") || t.Contains("Senate") || t.Contains("bench") || t.Contains("Bloc") || t.Contains("Benches") || t.Contains("Party") || t.Contains(" sets "),
        "politics" => t.Contains("Senate") || t.Contains("Act of the Senate") || t.Contains("petition") || t.Contains("bench") || t.Contains("Benches") || t.Contains(" sets ") || t.Contains("commission") || t.Contains("office") || t.Contains("estate") || t.Contains("Speaker") || t.Contains("whip"),
        _ => true
    };
    private static string Ordinal(int n) => n % 100 is 11 or 12 or 13 ? $"{n}th" : (n % 10) switch { 1 => $"{n}st", 2 => $"{n}nd", 3 => $"{n}rd", _ => $"{n}th" };
    /// <summary>What kind of thing a line is, for the mark beside it: the first of the kinds it answers to.</summary>
    private string KindOf(string t) { var keep = _kind; try { foreach (var k in new[] { "war", "dynasty", "politics", "coin", "realm" }) { _kind = k; if (Kind(t)) return k; } return "other"; } finally { _kind = keep; } }
    private static bool Martial(string t) => t.Contains("war", StringComparison.OrdinalIgnoreCase) || t.Contains("battle", StringComparison.OrdinalIgnoreCase) || t.Contains("destroyed") || t.Contains("siege", StringComparison.OrdinalIgnoreCase);
    private static List<(string key, string label, int from, int to)> Volumes(World w)
    {
        var list = new List<(string, string, int, int)>(); int last = Math.Max(1, w.Turn);
        for (int from = 1; from <= last; from += 10) { int to = from + 9; list.Add(($"v{from}", $"Years {from}–{to}", from, to)); }
        if (last > 1) list.Add(("recent", "The last five years", Math.Max(1, last - 4), last));
        return list;
    }
}
