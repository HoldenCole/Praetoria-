@inject GameClient G
@implements IDisposable
@* A person's profile (docs/ART_DIRECTION.md, "Portraits and profiles"): the card any portrait opens. Who they are, what they are,
   what they think of you and why, what they are like, what they are good at, whose they are, and what they have done. The same card
   for you, a relative, the head of a rival house or a khan beyond the rim. Their kin are portraits too, and open in their turn. *@
@{
    var w = G.World; var c = G.Content; var p = w != null && c != null && G.ProfileId != null ? ProfileProjection.Build(w, c, G.ProfileId) : null;
}
@if (p != null)
{
    <div class="overlay profile-veil" @onclick="G.CloseProfile">
        <article class="profile @(p.Alive ? "" : "dead")" style="--accent:@p.Accent" @onclick:stopPropagation="true" role="dialog" aria-label="@p.Name">
            <button class="profile-x" @onclick="G.CloseProfile" title="Close" aria-label="Close">×</button>
            <header class="profile-head">
                <div class="profile-frame"><Portrait Id="@p.Id" Name="@p.Name" Sex="@p.Sex" Age="@p.Age" Alive="@p.Alive" Accent="@p.Accent" Size="232" Opens="false" /><i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i></div>
                <div class="profile-who">
                    <div class="profile-house"><i></i>@p.HouseName@(p.Ancestry.Length > 0 ? $" · {p.Ancestry}" : "")@(p.IsYou ? " · you" : "")@(p.Alive ? "" : " · dead")</div>
                    <h2>@p.Name</h2>
                    @if (G.World?.Protagonist is { } pme && G.World.Char(p.Id) is { } pch && !p.IsYou)
                    {
                        string kinWord = Kinship.Of(G.World, pme, pch), born = Kinship.ChildOfSays(G.World, pch);
                        @if (kinWord.Length + born.Length > 0) { <div class="profile-kin muted small" data-kin="@kinWord">@(kinWord.Length > 0 ? char.ToUpperInvariant(kinWord[0]) + kinWord[1..] : "")@(kinWord.Length > 0 && born.Length > 0 ? " · " : "")@born</div> }
                    }
                    @if (p.Epithet.Length > 0) { <div class="profile-epithet">@p.Epithet</div> }
                    <div class="profile-station">@p.Station@(p.Alive ? $" · {p.Age} years" : $" · died at {p.Age}")</div>
                    @if (p.Offices.Count > 0) { <div class="profile-offices">@foreach (var o in p.Offices) { <span>@o</span> }</div> }
                    <p class="profile-story">@(p.IsYou ? p.Story.Replace("their own", "your own").Replace(" Wants to ", " You want to ") : p.Story)</p>
                    @if (p.TheirsOfYou is { } t && p.YoursOfThem is { } y)
                    {
                        <div class="regards">
                            <div class="regard">
                                <div class="rg-top"><span>What they think of you</span><b class="@Tone(t.Disposition)">@Cap(t.Word)@(t.Bond.Length > 0 ? $" · {t.Bond}" : "") <em>@Signed(t.Disposition)</em></b></div>
                                <div class="rg-bar"><i class="@Tone(t.Disposition)" style="@Fill(t.Disposition)"></i></div>
                                @if (t.Reasons.Count > 0) { <div class="rg-why">@string.Join(" · ", t.Reasons)</div> }
                            </div>
                            <div class="regard">
                                <div class="rg-top"><span>What you think of them</span><b class="@Tone(y.Disposition)">@Cap(y.Word)@(y.Bond.Length > 0 ? $" · {y.Bond}" : "") <em>@Signed(y.Disposition)</em></b></div>
                                <div class="rg-bar"><i class="@Tone(y.Disposition)" style="@Fill(y.Disposition)"></i></div>
                            </div>
                        </div>
                    }
                    <div class="profile-gauges">
                        <div class="pg" title="Age lowers what it can be; wounds, illness and strain lower it."><span>Health</span><div class="rg-meter"><i style="width:@(p.Health)%"></i></div><b>@p.HealthName</b></div>
                        <div class="pg" title="What they are apart from their house: how far they rose and what they did."><span>Renown</span><div class="rg-meter brass"><i style="width:@(Math.Min(100, p.Renown))%"></i></div><b>@p.Renown</b></div>
                        @if (p.Sway > 0) { <div class="pg" title="How far their fleets would follow them against the Senate."><span>Sway</span><div class="rg-meter brass"><i style="width:@(Math.Min(100, p.Sway))%"></i></div><b>@p.Sway</b></div> }
                    </div>
                </div>
            </header>
            <div class="profile-body">
                <section>
                    <h3>What they are like</h3>
                    @if (p.Nature.Count + p.Aptitude.Count == 0) { <p class="muted small">Nothing is known of their nature yet.</p> }
                    @foreach (var tr in p.Nature) { <div class="pt nature"><b>@Cap(tr.Name)</b><span>@tr.Description</span></div> }
                    @foreach (var tr in p.Aptitude) { <div class="pt apt"><b>@Cap(tr.Name)</b><span>@tr.Description</span></div> }
                    @if (p.Ambition.Length > 0) { <div class="pt amb"><b>Wants</b><span>To @(p.Ambition.ToLowerInvariant()).</span></div> }
                    @if (p.Marks.Count > 0) { <div class="profile-marks">@foreach (var mk in p.Marks) { <span>@mk</span> }</div> }
                </section>
                <section>
                    <h3>What they are good at</h3>
                    @if (p.Skills.Count == 0) { <p class="muted small">Untrained.</p> }
                    @foreach (var s in p.Skills) { <div class="ps"><span>@Cap(s.Name)</span><div class="sk-pips">@for (int i = 1; i <= 10; i++) { <i class="@(i <= s.Value ? "on" : "")"></i> }</div><b>@s.Value</b></div> }
                </section>
                <section>
                    <h3>Whose they are</h3>
                    @if (p.Kin.Count == 0) { <p class="muted small">No kin the record knows.</p> }
                    <div class="profile-kin">
                        @foreach (var k in p.Kin.Take(8))
                        {
                            var kc = w!.Char(k.Id); var kh = kc != null ? w.House(kc.HouseId) : null;
                            <button class="pk" @onclick="() => G.ShowProfile(k.Id)" title="Open @k.Name">
                                <Portrait Id="@k.Id" Name="@k.Name" Sex="@(kc?.Sex ?? "")" Age="@k.Age" Alive="@k.Alive" Accent="@(kh?.AccentColor ?? p.Accent)" Size="44" Opens="false" />
                                <span><b>@k.Name</b><em>@k.Relation · @(k.Alive ? k.Age.ToString() : "dead at " + k.Age)</em></span>
                            </button>
                        }
                    </div>
                    @if (p.Kin.Count > 8) { <p class="muted small">and @(p.Kin.Count - 8) more.</p> }
                </section>
                <section class="wide">
                    <h3>What they have done</h3>
                    @if (p.Deeds.Count == 0) { <p class="muted small">Nothing the record remembers yet.</p> }
                    <ol class="profile-deeds">@foreach (var d in p.Deeds) { <li><time>Year @d.Turn<em>aged @d.Age</em></time><span>@d.Text</span></li> }</ol>
                </section>
            </div>
        </article>
    </div>
}

@code {
    // It takes no parameters, so it listens for itself: a page's re-render would pass it by.
    protected override void OnInitialized() => G.Changed += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Refresh;
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    private static string Signed(int v) => v > 0 ? "+" + v : v.ToString();
    private static string Tone(int v) => v >= 10 ? "good" : v <= -10 ? "bad" : "";
    /// <summary>A bar from the middle: rightward for regard, leftward for dislike.</summary>
    private static string Fill(int v) { int half = Math.Min(50, Math.Abs(v) / 2); return v >= 0 ? $"left:50%;width:{half}%" : $"left:{50 - half}%;width:{half}%"; }
}
