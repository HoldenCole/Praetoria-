@inject GameClient G
@implements IDisposable
@* A person's profile (docs/ART_DIRECTION.md, "Portraits and profiles"): the card any portrait opens. Who they are, what they are,
   what they think of you and why, what they are like, what they are good at, whose they are, and what they have done. The same card
   for you, a relative, the head of a rival house or a khan beyond the rim. Their kin are portraits too, and open in their turn. *@
@{
    var w = G.World; var c = G.Content; var p = w != null && c != null && G.ProfileId != null ? ProfileProjection.Build(w, c, G.ProfileId) : null;
}
@if (p != null)
{
    var ph = w!.House(p.HouseId);
    @* The card (docs/VISUAL_SYSTEM.md 4.15, 5.2): a window in the frame over the dimmed map. Its head is the person's painting by
       career under the shade, their portrait plate (150 by 188, the dead in greyscale with the ribbon) with their house's wax seal on
       its corner, the kicker, the name in Cinzel, what they are and the story; then what they think of you and you of them as two
       diverging meters, health and renown, and four sections: what they are like, what they are good at, whose they are (kin as
       portrait plates) and what they have done. *@
    <div class="overlay pc-veil" @onclick="G.CloseProfile">
        <article class="profile pc ui-win @(p.Alive ? "" : "dead")" style="--accent:@p.Accent" @onclick:stopPropagation="true" role="dialog" aria-label="@p.Name">
            <div class="ui-win-body pc-body">
                <header class="pc-head">
                    <div class="ui-head-art" style="background-image:url('img/scenes/@(Scene(p)).webp')"></div><div class="ui-head-shade"></div>
                    <div class="pc-portrait">
                        <Portrait Id="@p.Id" Name="@p.Name" Sex="@p.Sex" Age="@p.Age" Alive="@p.Alive" Accent="@p.Accent" Size="150" Height="188" Opens="false" />
                        @if (ph != null) { <i class="pc-seal"><Sigil HouseId="@ph.Id" Accent="@ph.AccentColor" Size="40" Mode="seal" /></i> }
                    </div>
                    <div class="pc-who">
                        <div class="ui-kick pc-house">@p.HouseName@(p.Ancestry.Length > 0 ? $" · {p.Ancestry}" : "")@(p.IsYou ? " · you" : "")@(p.Alive ? "" : " · dead")</div>
                        <h2 class="ui-title">@p.Name</h2>
                        @if (G.World?.Protagonist is { } pme && G.World.Char(p.Id) is { } pch && !p.IsYou)
                        {
                            string kinWord = Kinship.Of(G.World, pme, pch), born = Kinship.ChildOfSays(G.World, pch);
                            @if (kinWord.Length + born.Length > 0) { <div class="pc-kinword" data-kin="@kinWord">@(kinWord.Length > 0 ? char.ToUpperInvariant(kinWord[0]) + kinWord[1..] : "")@(kinWord.Length > 0 && born.Length > 0 ? " · " : "")@born</div> }
                        }
                        @if (p.Epithet.Length > 0) { <div class="pc-epithet">@p.Epithet</div> }
                        <div class="ui-facts pc-station"><span><Icon Name="@(p.Alive ? "heart-beats" : "candle-light")" Tone="ivory" Size="16" /><b>@p.Station</b></span><span>@(p.Alive ? $"{p.Age} years" : $"died at {p.Age}")</span></div>
                        @if (p.Offices.Count > 0) { <div class="pc-offices">@foreach (var o in p.Offices) { <span><Icon Name="podium" Tone="brass" Size="13" />@o</span> }</div> }
                        <p class="pc-story">@(p.IsYou ? p.Story.Replace("their own", "your own").Replace(" Wants to ", " You want to ") : p.Story)</p>
                    </div>
                </header>
                <div class="pc-scroll">
                    @if (p.TheirsOfYou is { } t && p.YoursOfThem is { } y)
                    {
                        <div class="pc-regards">
                            <div class="pc-regard">
                                <Meter Label="Of you" Kind="diverging" Value="@t.Disposition" Text="@Signed(t.Disposition)" ValueClass="@Tone(t.Disposition)" Tip="What they think of you" />
                                <div class="pc-rg-top"><span>What they think of you</span><b class="@Tone(t.Disposition)">@Cap(t.Word)@(t.Bond.Length > 0 ? $" · {t.Bond}" : "")</b></div>
                                @if (t.Reasons.Count > 0) { <div class="pc-rg-why">@string.Join(" · ", t.Reasons)</div> }
                                @if (G.World?.Protagonist is { } heirNow) { foreach (var line in InheritedRegard.Why(G.World, p.Id, heirNow.Id)) { <div class="pc-rg-why" data-inherited-regard="@line.Kind">@line.Text</div> } }
                            </div>
                            <div class="pc-regard">
                                <Meter Label="Of them" Kind="diverging" Value="@y.Disposition" Text="@Signed(y.Disposition)" ValueClass="@Tone(y.Disposition)" Tip="What you think of them" />
                                <div class="pc-rg-top"><span>What you think of them</span><b class="@Tone(y.Disposition)">@Cap(y.Word)@(y.Bond.Length > 0 ? $" · {y.Bond}" : "")</b></div>
                            </div>
                        </div>
                    }
                    @if (!p.IsYou && p.Alive && G.World?.Protagonist is { Alive: true } actor && G.World.Char(p.Id) is { } them && G.Turn != null && !Praetoria.Core.State.Nation.IsHouse(them.HouseId))
                    {
                        /* act on a person from their profile (docs/PLAYTHROUGH.md, Family): a visit or amends, and a slight */
                        var visit = new SeekAllyCommand(actor.Id, them.Id); var slight = new NeedleRivalCommand(actor.Id, them.Id); bool canVisit = visit.CanExecute(G.Ctx), canSlight = slight.CanExecute(G.Ctx);
                        int theirs = G.World.GetRelationship(them.Id, actor.Id)?.Disposition ?? 0; string visitWord = theirs < 0 ? "Make amends" : "Pay a visit";
                        <div class="pc-acts" data-profile-acts="@p.Id">
                            <button class="opt inline" data-visit="1" disabled="@(!canVisit)" title="@(canVisit ? $"1 influence. {them.Name} thinks 10 the better of you, and you of them. It can be done again while you have influence to spend." : "needs 1 influence")" @onclick="() => G.Execute(visit)">@visitWord · 1 influence</button>
                            <button class="opt inline" data-slight="1" disabled="@(!canSlight)" title="@(canSlight ? $"1 influence. {them.Name} thinks 10 the worse of you, and you 5 the worse of them." : "needs 1 influence")" @onclick='() => G.Ask("Slight " + them.Name + "?", them.Name + " thinks 10 the worse of you, and you 5 the worse of them. It costs 1 influence.", "Slight them", () => G.Execute(slight))'>Slight them · 1 influence</button>
                            <span class="pc-note">A gift or a loan is made under House, in your purse; a post is given where the post is: a fleet under Military, a world or a duty of the household under House.</span>
                        </div>
                    }
                    <div class="pc-gauges">
                        <Meter Label="Health" Value="@p.Health" Text="@p.HealthName" Color="#8cc47e" Tip="Age lowers what it can be; wounds, illness and strain lower it." />
                        <Meter Label="Renown" Value="@(Math.Min(100, p.Renown))" Text="@p.Renown.ToString()" Tip="What they are apart from their house: how far they rose and what they did." />
                        @if (p.Sway > 0) { <Meter Label="Sway" Value="@(Math.Min(100, p.Sway))" Text="@p.Sway.ToString()" Tip="How far their fleets would follow them against the Senate." /> }
                    </div>
                    <div class="pc-sections">
                        <section>
                            <Section Title="What they are like" />
                            @if (p.Nature.Count + p.Aptitude.Count == 0) { <p class="pc-empty">Nothing is known of their nature yet.</p> }
                            @foreach (var tr in p.Nature) { <div class="pc-trait nature"><b>@Cap(tr.Name)</b><span>@tr.Description</span></div> }
                            @foreach (var tr in p.Aptitude) { <div class="pc-trait apt"><b>@Cap(tr.Name)</b><span>@tr.Description</span></div> }
                            @if (p.Ambition.Length > 0) { <div class="pc-trait amb"><b>Wants</b><span>To @(p.Ambition.ToLowerInvariant()).</span></div> }
                            @if (p.Marks.Count > 0) { <div class="pc-marks">@foreach (var mk in p.Marks) { <span>@mk</span> }</div> }
                        </section>
                        <section>
                            <Section Title="What they are good at" />
                            @if (p.Skills.Count == 0) { <p class="pc-empty">Untrained.</p> }
                            @foreach (var s in p.Skills) { <div class="pc-skill"><Meter Label="@Cap(s.Name)" Value="@s.Value" Max="10" Tip="@SkillWords.For(s.Name.ToLowerInvariant())" /></div> }
                        </section>
                        <section>
                            <Section Title="Whose they are" Count="@(p.Kin.Count > 0 ? p.Kin.Count.ToString() : "")" />
                            @if (p.Kin.Count == 0) { <p class="pc-empty">No kin the record knows.</p> }
                            <div class="pc-kin">
                                @foreach (var k in p.Kin.Take(8))
                                {
                                    var kc = w!.Char(k.Id); var kh = kc != null ? w.House(kc.HouseId) : null;
                                    <button class="pk" @onclick="() => G.ShowProfile(k.Id)" title="Open @k.Name">
                                        <Portrait Id="@k.Id" Name="@k.Name" Sex="@(kc?.Sex ?? "")" Age="@k.Age" Alive="@k.Alive" Accent="@(kh?.AccentColor ?? p.Accent)" Size="46" Height="56" Opens="false" />
                                        <span><b>@k.Name</b><em>@k.Relation · @(k.Alive ? k.Age.ToString() : "dead at " + k.Age)</em></span>
                                    </button>
                                }
                            </div>
                            @if (p.Kin.Count > 8) { <p class="pc-empty">and @(p.Kin.Count - 8) more.</p> }
                        </section>
                        <section class="wide">
                            <Section Title="What they have done" Count="@(p.Deeds.Count > 0 ? p.Deeds.Count.ToString() : "")" />
                            @if (p.Deeds.Count == 0) { <p class="pc-empty">Nothing the record remembers yet.</p> }
                            <ol class="pc-deeds">@foreach (var d in p.Deeds) { <li><time>Year @d.Turn<em>aged @d.Age</em></time><span>@d.Text</span></li> }</ol>
                        </section>
                    </div>
                </div>
            </div>
            <i class="ui-win-frame" aria-hidden="true"></i>
            <button class="ui-round ui-close profile-x" @onclick="G.CloseProfile" title="Close (Esc)" aria-label="Close"><Icon Name="close" Tone="ivory" Size="13" /></button>
        </article>
    </div>
}

@code {
    // It takes no parameters, so it listens for itself: a page's re-render would pass it by.
    protected override void OnInitialized() => G.Changed += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Refresh;
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    private static string Signed(int v) => v > 0 ? "+" + v : Counted.Figure(v);
    /// <summary>The painting at the head of the card, by what the person is (docs/VISUAL_SYSTEM.md 4.2: a person by career).</summary>
    private static string Scene(PersonProfile p) => !p.Alive ? "funeral" : SceneArt.For(p.Station, p.Station + " " + string.Join(" ", p.Offices)) is var s && s != "audience" ? s : p.Age < 16 ? "family" : "court";
    private static string Tone(int v) => v >= 10 ? "good" : v <= -10 ? "bad" : "";
    /// <summary>A bar from the middle: rightward for regard, leftward for dislike.</summary>
    private static string Fill(int v) { int half = Math.Min(50, Math.Abs(v) / 2); return v >= 0 ? $"left:50%;width:{half}%" : $"left:{50 - half}%;width:{half}%"; }
}
