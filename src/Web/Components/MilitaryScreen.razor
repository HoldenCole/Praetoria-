                                    <span class="ui-cell"><Icon Name="credits" Tone="brass" Size="15" />@Money.Show(MercenarySystem.PayOf(fleet))<small> a year</small></span>
                                    <Plate Label="Hire out" Small="true" Locked="@(hireNo != null)" Disabled="@(hireNo != null)" ShowNeed="false" Need="@Cap(hireNo ?? "")" data-hire-to="@em.Id" Tip="@("[swap-bag] Hire it out to " + em.Name + "\n" + (hireNo != null ? Cap(hireNo) : MercenarySystem.Says(w, fleet, em)))" OnClick="() => AskHire(fid, emId)" />
                                    @if (hireNo != null) { <small class="ui-mute">@Cap(hireNo)</small> }
