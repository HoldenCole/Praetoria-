@inject GameClient G
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var house = w.House(w.Protagonist!.HouseId)!; var fs = G.Turn!.Fleets;
    int ours = FleetSystem.StrengthOf(w, house.Id);
    int upkeep = w.Fleets.Values.Where(f => f.OwnerId == house.Id).Sum(f => fs.Upkeep(f).Credits);
    var mapFleets = GalaxyProjection.Fleets(w);
    var rivals = mapFleets.Where(f => !f.IsPlayer && f.OwnerHouseId != PirateSystem.HouseId).GroupBy(f => f.OwnerHouseId).Select(g => (house: w.House(g.Key)!, hulls: g.Sum(f => f.Strength), conf: (int)g.Average(f => f.Confidence))).Where(x => x.house != null).OrderByDescending(x => x.hulls).ToList();
    var battles = w.History.Where(h => h.Text.Contains("battle", StringComparison.OrdinalIgnoreCase) || h.Text.Contains("destroyed") || h.Text.Contains("desert") || h.Text.Contains("Prize crews")).Reverse().Take(8).ToList();
    int fuelBurn = FleetSystem.FuelBillFor(w, house.Id, c.Fleets.FuelHullsPerUnit); var officeHulls = w.Fleets.Values.Where(f => f.Office && f.OwnerId == house.Id).Sum(f => f.Strength);
    var mil = m.Military; var nations = mil?.Nations ?? new List<NationCard>(); var warAbroad = nations.FirstOrDefault(n => n.AtWar); var away = m.Fleets.Where(f => f.Away.Length > 0).ToList();
    var abroadLines = w.History.Where(h => h.Text.Contains("Raiders of ") || h.Text.Contains("beyond the Reach") || h.Text.Contains("in the space of") || h.Text.Contains("in their own space") || h.Text.Contains("comes home from") || h.Text.Contains("sues for peace") || h.Text.Contains("is at war with") || h.Text.Contains("gutters out") || h.Text.Contains("is lost:") || h.Text.Contains("last tribute")).Reverse().Take(8).ToList();
    int maxStr = Math.Max(1, nations.Count == 0 ? 1 : nations.Max(n => Math.Max(n.Strength, n.FullStrength)));
    // the plot: every system on a flat chart, lanes, fronts, our supply, our fleets and the enemy's as reported
    var nodes = GalaxyProjection.Nodes(w); var lanes = GalaxyProjection.Lanes(w);
    double minX = nodes.Count == 0 ? 0 : nodes.Min(n => n.X), maxX = nodes.Count == 0 ? 1 : nodes.Max(n => n.X), minY = nodes.Count == 0 ? 0 : nodes.Min(n => n.Y), maxY = nodes.Count == 0 ? 1 : nodes.Max(n => n.Y);
    double PX(double x) => 30 + (maxX > minX ? (x - minX) / (maxX - minX) : .5) * 940; double PY(double y) => 30 + (maxY > minY ? (y - minY) / (maxY - minY) : .5) * 520;
    var byId = nodes.ToDictionary(n => n.SystemId); var enemies = w.EnemiesOf(house.Id).ToHashSet();
    bool Enemy(MapNode n) => n.OwnerHouseId != null && enemies.Contains(n.OwnerHouseId);
    string? campaign = FleetSystem.CampaignTarget(w, house.Id);
    var inSupply = w.Galaxy == null ? new HashSet<string>() : nodes.Where(n => fs.InSupply(w, house.Id, n.SystemId)).Select(n => n.SystemId).ToHashSet();
    int maxHulls = Math.Max(1, Math.Max(ours, rivals.Count == 0 ? 0 : rivals.Max(r => r.hulls)));
    string F(double v) => v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="dash deck" style="--accent:@m.HouseAccent">
    <header class="dash-head">
        <div class="dh-title"><Icon Name="military" Size="18" /> <b>The Command Deck</b> <span class="muted">@ours hull(s) in @m.Fleets.Count fleet(s) · @(m.Wars.Count == 0 ? "at peace" : $"{m.Wars.Count} war(s)")@(campaign != null ? $" · campaign on {w.Galaxy?.System(campaign)?.Name ?? campaign}" : "")</span></div>
        <div class="dh-stats">
            <div class="stat"><span>Hulls</span><b>@ours @if (officeHulls > 0) { <i class="muted">+@officeHulls office</i> }</b></div>
            <div class="stat"><span>Upkeep</span><b>@upkeep <i class="muted">/turn</i></b></div>
            <div class="stat @(w.HasFlag("fuel_short") ? "warn" : "")"><span>Helium-3</span><b>@house.Treasury.Helium3 @if (fuelBurn > 0) { <i class="muted">−@fuelBurn/turn</i> }</b></div>
            <div class="stat"><span>Manpower</span><b>@m.Treasury.Manpower</b></div>
            <div class="stat"><span>Isotopes</span><b>@m.Treasury.Isotopes</b></div>
            <div class="stat @(warAbroad != null ? "warn" : "")"><span>Beyond the Reach</span><b>@(warAbroad != null ? $"war with {warAbroad.Name}" : nations.Any(n => n.SubduedUntil > 0) ? $"{nations.Count(n => n.SubduedUntil > 0)} tributar{(nations.Count(n => n.SubduedUntil > 0) == 1 ? "y" : "ies")}" : "peace")@(away.Count > 0 ? $" · {away.Count} fleet{(away.Count == 1 ? "" : "s")} abroad" : "")</b></div>
            @if (mil != null) { <div class="stat"><span>You command from</span><b>@(mil.MyStyle == "front" ? "the front" : mil.MyStyle == "flag" ? "the flag" : "the staff")@(mil.MyAchilles ? " · ACHILLES" : "")</b></div> }
        </div>
    </header>

    <div class="dash-grid deck-grid">
        <section class="panel">
            <h3><Icon Name="galaxy" Size="13" /> The plot <span class="muted">our worlds and supply in gold · fronts in red · enemy fleets as reported</span></h3>
            <svg class="plot" viewBox="0 0 1000 580" role="img" aria-label="the war plot">
                @foreach (var l in lanes)
                {
                    if (!byId.TryGetValue(l.A, out var a) || !byId.TryGetValue(l.B, out var b)) { continue; }
                    bool front = (a.IsPlayerTerritory && Enemy(b)) || (b.IsPlayerTerritory && Enemy(a));
                    <line x1="@F(PX(a.X))" y1="@F(PY(a.Y))" x2="@F(PX(b.X))" y2="@F(PY(b.Y))" class="lane @(front ? "front" : "")" />
                }
                @foreach (var n in nodes)
                {
                    bool mine = n.IsPlayerTerritory; bool enemy = Enemy(n);
                    @if (inSupply.Contains(n.SystemId)) { <circle cx="@F(PX(n.X))" cy="@F(PY(n.Y))" r="22" class="supply" /> }
                    @if (campaign == n.SystemId) { <circle cx="@F(PX(n.X))" cy="@F(PY(n.Y))" r="18" class="campaign" /> }
                    <circle cx="@F(PX(n.X))" cy="@F(PY(n.Y))" r="@(n.Capital ? 8 : n.PlanetHoldingId != null ? 6 : 3.5)" class="node @(mine ? "mine" : "") @(enemy ? "enemy" : "") @(n.Chokepoint ? "choke" : "")" style="fill:@(n.OwnerHouseId != null ? n.AccentColor : "#3a3f47")"><title>@n.Name@(n.OwnerHouseName != null ? $" · {n.OwnerHouseName}" : " · unclaimed")@(n.Chokepoint ? " · chokepoint" : "")@(inSupply.Contains(n.SystemId) ? " · in your supply" : "")</title></circle>
                    @if (mine || enemy || n.Capital) { @((MarkupString)$"<text x=\"{F(PX(n.X))}\" y=\"{F(PY(n.Y) - 11)}\" class=\"nlabel {(enemy ? "enemy" : "")}\">{System.Net.WebUtility.HtmlEncode(n.Name)}</text>") }
                }
                @foreach (var f in mapFleets.Where(f => byId.ContainsKey(f.SystemId)))
                {
                    var n = byId[f.SystemId]; double x = PX(n.X) + (f.IsPlayer ? -12 : 12), y = PY(n.Y) + 12;
                    <g class="fleet @(f.IsPlayer ? "mine" : f.OwnerHouseId == PirateSystem.HouseId ? "raider" : enemies.Contains(f.OwnerHouseId) ? "enemy" : "other")" transform="translate(@F(x),@F(y))">
                        <path d="M0 -9 L8 0 L0 9 L-8 0 Z" style="fill:@f.AccentColor" /><text y="4" class="fl">@f.Strength</text>
                        <title>@f.Name · @f.OwnerHouseName · @f.Strength hull(s)@(f.IsPlayer ? "" : $" · confidence {f.Confidence}%")@(f.Moving ? $" · under way, {f.Eta} jump(s)" : "")</title>
                    </g>
                }
            </svg>
            <h4>The navies <span class="muted">as reported</span></h4>
            <div class="navy-row mine"><Sigil HouseId="@house.Id" Accent="@house.AccentColor" Size="14" /> <span>@house.Name</span><span class="bar"><i style="width:@(100 * ours / maxHulls)%; background:@house.AccentColor"></i></span><b>@ours</b></div>
            @{ var raiderHulls = w.Fleets.Values.Where(f => f.OwnerId == PirateSystem.HouseId).Sum(f => f.Strength); }
            @if (raiderHulls > 0) { <div class="navy-row warn"><span>☠</span> <span>Raiders on the lanes</span><span class="bar"><i style="width:@(100 * raiderHulls / maxHulls)%; background:#c0392b"></i></span><b>@raiderHulls</b></div> }
            @foreach (var r in rivals.Take(8))
            {
                <div class="navy-row @(w.AtWar(house.Id, r.house.Id) ? "warn" : "")" title="confidence @(r.conf)%"><Sigil HouseId="@r.house.Id" Accent="@r.house.AccentColor" Size="14" /> <span>@r.house.Name@(w.AtWar(house.Id, r.house.Id) ? " · at war" : "")</span><span class="bar"><i style="width:@(100 * r.hulls / maxHulls)%; background:@r.house.AccentColor"></i></span><b>~@r.hulls</b></div>
            }
            @if (rivals.Count == 0) { <div class="muted small">No rival hull has been sighted.</div> }
        </section>

        <section class="panel">
            <h3><Icon Name="fleet" Size="13" /> The fleets <span class="muted">movement is ordered on the Galaxy map</span></h3>
            @if (mil != null)
            {
                <div class="brief">
                    @if (mil.Brief.Count == 0) { <div class="muted small">No enemy shares a sky with your fleets this turn.</div> }
                    @foreach (var b in mil.Brief)
                    {
                        <div class="line battle @(b.OurPower >= b.TheirPower ? "" : "warn")"><b>Battle at @b.SystemName at the turn's end</b> — @b.EnemyName, @b.EnemyHulls hull(s) as reported (@b.Confidence%) against our @b.OurHulls.
                            Our @b.OurStance against their @b.TheirStance: @(b.Edge > 0 ? "the edge is ours" : b.Edge < 0 ? "the edge is theirs — change the stance" : "no edge either way").
                            <span class="odds">Odds @((int)Math.Round(100 * b.OurPower / Math.Max(0.01, b.OurPower + b.TheirPower)))%</span></div>
                    }
                    <div class="row small"><span class="muted">You command from</span>@foreach (var o in mil.MyStyleOptions) { <button class="opt inline tiny @(mil.MyStyle == o.Id ? "here" : "")" disabled="@(o.Refusal != null && o.Refusal != "already so")" title="@(o.Refusal ?? StyleHelp(o.Id))" @onclick="() => G.Execute(new SetCommandStyleCommand(pid, pid, o.Id))">@(o.Id == "none" ? "the staff" : "the " + o.Label)</button> }
                        <span class="muted">· @mil.MyCap hull(s) without strain@(mil.MyValour > 0 ? $" · valour {mil.MyValour}" : "")</span></div>
                </div>
            }
            @if (officeHulls > 0) { <div class="kv good"><span>The Admiralty</span><b>@officeHulls office hull(s) sail under your colours · the chair pays their upkeep and the state fuels them · war on the chair is treason</b></div> }
            @if (w.HasFlag("fuel_short")) { <div class="flag">The tanks are dry: readiness slides fifteen a turn and no fleet may sail until helium-3 is found.</div> }
            @foreach (var f in m.Fleets)
            {
                var fleet = w.Fleets[f.Id];
                <div class="fcard @(f.Loyalty < 30 || f.Supply < 40 ? "warn" : "")">
                    <div class="hc-head"><Icon Name="fleet" Size="18" /><div><b>@f.Name</b> <span class="muted small">@f.Composition · @(f.Away.Length > 0 ? $"beyond the Reach · against {f.AwayName} · {AwayWord(f.AwayPhase)} ({f.AwayTurns})" : f.Moving ? $"→ {f.Destination} ({f.Eta})" : f.Where)@(f.Office ? " · held by office" : "")</span></div><span class="pill @(f.Readiness < 50 ? "warn" : "")">rdy @f.Readiness</span></div>
                    @if (f.Away.Length > 0) { <div class="kv good"><span>Expedition</span><b>@f.ExpeditionWins victor@(f.ExpeditionWins == 1 ? "y" : "ies")@(f.Plunder > 0 ? $" · {f.Plunder} credits of plunder aboard" : "") · @(f.AwayPhase == "fighting" ? "fighting in their space" : f.AwayPhase == "home" ? "sailing home" : "outward bound")</b></div> }
                    <div class="gauges">
                        <div class="gauge" title="readiness"><span>Readiness</span><i><b style="width:@f.Readiness%" class="@(f.Readiness < 50 ? "low" : "")"></b></i><em>@f.Readiness</em></div>
                        <div class="gauge" title="the crews' loyalty: under 30 they will not sail, under 15 they desert"><span>Loyalty</span><i><b style="width:@f.Loyalty%" class="@(f.Loyalty < 30 ? "low" : "")"></b></i><em>@f.Loyalty</em></div>
                        <div class="gauge" title="supply: under 40 the fleet fights at four-fifths; at nought hulls desert"><span>Supply</span><i><b style="width:@f.Supply%" class="@(f.Supply < 40 ? "low" : "")"></b></i><em>@f.Supply</em></div>
                    </div>
                    <div class="ships">@foreach (var (cls, n) in fs.Composition(fleet)) { <span class="pill" title="atk @cls.Attack / def @cls.Defense"><Icon Name="@(Icons.Paths.ContainsKey(cls.Id) ? cls.Id : "fleet")" Size="12" /> @n × @cls.Name</span> }@if (f.Veterancy > 0) { <span class="pill">veterancy @f.Veterancy</span> }</div>
                    <div class="kv"><span>Admiral</span><b>@(f.AdmiralName ?? "no admiral")@(f.AdmiralName != null ? $" · {(f.AdmiralStyle == "front" ? "leads from the front" : f.AdmiralStyle == "flag" ? "commands from the flag" : "leaves the line to the captains")} · cap {f.Cap}" : "")@(f.Valour > 0 ? $" · valour {f.Valour}" : "")@(f.Achilles ? " · ACHILLES" : "")</b></div>
                    <div class="row small"><span class="muted">Stance</span>@if (f.StanceOptions != null) { foreach (var o in f.StanceOptions) { <button class="opt inline tiny @(f.Stance == o.Id ? "here" : "")" disabled="@(o.Refusal != null && o.Refusal != "already so")" title="@(o.Refusal ?? StanceHelp(o.Id))" @onclick="() => G.Execute(new SetStanceCommand(pid, f.Id, o.Id))">@o.Label</button> } }</div>
                    <div class="row small"><span class="muted">Loadout</span>@if (f.LoadoutOptions != null) { foreach (var o in f.LoadoutOptions) { <button class="opt inline tiny @(f.Loadout == o.Id ? "here" : "")" disabled="@(o.Refusal != null && o.Refusal != "already so")" title="@(o.Refusal ?? (o.Id == "torpedoes" ? "a quarter more power; burns an isotope a battle" : "the guns"))" @onclick="() => G.Execute(new SetLoadoutCommand(pid, f.Id, o.Id))">@o.Label</button> } }</div>
                    @if (f.StyleOptions != null && f.AdmiralId != null) { <div class="row small"><span class="muted">Commands from</span>@foreach (var o in f.StyleOptions) { <button class="opt inline tiny @(f.AdmiralStyle == o.Id ? "here" : "")" disabled="@(o.Refusal != null && o.Refusal != "already so")" title="@(o.Refusal ?? StyleHelp(o.Id))" @onclick="() => G.Execute(new SetCommandStyleCommand(pid, f.AdmiralId, o.Id))">@(o.Id == "none" ? "the staff" : "the " + o.Label)</button> }</div> }
                    <div class="row small">
                        @if (f.Expedition != null) { <button class="opt inline tiny" disabled="@(f.Expedition.Refusal != null)" title="@(f.Expedition.Refusal ?? "1 treasury action: the fleet leaves the map, sails the nation's distance, fights a season of four battles and comes home with plunder, valour and fewer hulls")" @onclick="() => G.Execute(new SendExpeditionCommand(pid, f.Id, f.Expedition.Id, c.Fleets, c.Nations))">@f.Expedition.Label</button> }
                        @if (f.Recall != null) { <button class="opt inline tiny" disabled="@(f.Recall.Refusal != null)" title="@(f.Recall.Refusal ?? "turn for home before the season is done")" @onclick="() => G.Execute(new RecallExpeditionCommand(pid, f.Id, c.Nations))">@f.Recall.Label</button> }
                        <button class="opt inline tiny" disabled="@(f.Refit.Refusal != null)" title="@f.Refit.Refusal" @onclick="() => G.Execute(new RefitFleetCommand(pid, f.Id))">@f.Refit.Label</button>
                        <details class="inline"><summary>Command</summary>@foreach (var o in f.AdmiralOptions) { <button class="opt" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new AssignAdmiralCommand(pid, f.Id, o.Id))">@o.Label</button> }</details>
                        @if (f.MergeOptions.Count > 0) { <details class="inline"><summary>Merge</summary>@foreach (var o in f.MergeOptions) { <button class="opt" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new MergeFleetsCommand(pid, f.Id, o.Id))">@o.Label</button> }</details> }
                    </div>
                </div>
            }
            @if (m.Fleets.Count == 0) { <div class="muted">No hull flies your colours. Lay one down at a holding with a shipyard (House → the domain).</div> }
        </section>

        <aside class="dash-side">
            @if (mil != null)
            {
                <section class="panel">
                    <h3><Icon Name="galaxy" Size="13" /> The campaign</h3>
                    @if (mil.Campaign.TargetName != null) { <div class="kv good"><span>Object</span><b>@mil.Campaign.TargetName · @mil.Campaign.TurnsLeft turn(s) more</b></div><div class="muted small">Fleets within two lanes of it fight at +10% and count as supplied.</div> }
                    else if (mil.Campaign.Targets.Count == 0) { <div class="muted small">No war, no campaign. A campaign names an enemy's world as the war's object for eight turns (@mil.Campaign.Cost influence).</div> }
                    else
                    {
                        <select class="sel" @onchange="SetCampaign">
                            <option value="">— name the war's object —</option>
                            @foreach (var t in mil.Campaign.Targets) { <option value="@t.Id">@t.Label</option> }
                        </select>
                        var pick = mil.Campaign.Targets.FirstOrDefault(t => t.Id == _campaign);
                        <button class="opt inline" disabled="@(pick == null || pick.Refusal != null)" title="@(pick?.Refusal ?? $"{mil.Campaign.Cost} influence")" @onclick="() => G.Execute(new DeclareCampaignCommand(pid, _campaign, c.Fleets))">Declare the campaign</button>
                    }
                </section>
            }
            @if (nations.Count > 0)
            {
                <section class="panel abroad">
                    <h3><Icon Name="galaxy" Size="13" /> Beyond the Reach <span class="muted">the nations off the map · the Senate makes war; houses send fleets</span></h3>
                    @if (warAbroad != null)
                    {
                        int tot = Math.Max(1, warAbroad.ScoreReach + warAbroad.ScoreNation);
                        <div class="war abroad-war"><div><b>War with @warAbroad.Name</b> <span class="muted">since turn @warAbroad.WarSince · @warAbroad.Expeditions fleet(s) of the Reach in their space · they hold @warAbroad.Strength hull(s)</span></div>
                            <div class="tally"><span class="for" style="width:@(100 * warAbroad.ScoreReach / tot)%"></span><span class="against" style="width:@(100 * warAbroad.ScoreNation / tot)%"></span></div>
                            <div class="kv"><span>The tally</span><b>@warAbroad.ScoreReach : @warAbroad.ScoreNation <i class="muted">· @warAbroad.Threshold clear subdues them; @warAbroad.Threshold the other way and the chair buys peace</i></b></div>
                            <div class="muted small">Each victory abroad brings @warAbroad.Wealth credits of plunder home and a point of valour to a commander at the front; the house whose fleets win most takes the triumph.</div></div>
                    }
                    @foreach (var n in nations)
                    {
                        <div class="nation @(n.AtWar ? "war" : n.SubduedUntil > 0 ? "tributary" : "")" title="@n.Description">
                            <div class="nrow"><b>@n.Name</b> <span class="muted small">@n.Temper · @n.Distance year(s) out · holds @n.Holds</span></div>
                            <div class="nrow"><span class="muted small">strength</span><span class="mbar"><i style="width:@(100 * n.Strength / maxStr)%; background:@(n.AtWar ? "#E63946" : n.SubduedUntil > 0 ? "#2EC27E" : "#C9D1DC")"></i></span><b>@n.Strength</b>
                                <span class="pill small @(n.Disposition <= -30 ? "warn" : n.Disposition >= 20 ? "good" : "")" title="their regard for the Reach">@(n.Disposition >= 0 ? "+" : "")@n.Disposition</span>
                                @if (n.AtWar) { <span class="pill small warn">at war</span> } else if (n.SubduedUntil > 0) { <span class="pill small good">pays @n.Tribute/turn until T@(n.SubduedUntil)</span> } @if (n.RaidedLately) { <span class="pill small warn">raiding the rim</span> }@if (n.Wars > 0 && !n.AtWar) { <span class="pill small">@n.Wars war(s) fought</span> }
                                @if (!n.AtWar && n.SubduedUntil == 0) { <button class="opt inline tiny" disabled="@(n.War.Refusal != null)" title="@(n.War.Refusal ?? "move in the Senate that the Reach make war upon them (3 influence)")" @onclick="() => MoveWar(n.Id)">@n.War.Label</button> }</div>
                        </div>
                    }
                    @if (abroadLines.Count > 0) { <h4>Word from beyond</h4> @foreach (var h in abroadLines) { <div class="line small"><span class="muted">T@(h.Turn)</span> @h.Text</div> } }
                </section>
            }
            <section class="panel">
                <h3><Icon Name="war" Size="13" /> Wars</h3>
                @foreach (var war in m.Wars)
                {
                    var wr = w.Wars.First(x => x.Between(house.Id, war.EnemyHouseId)); var eh = w.House(war.EnemyHouseId); int a = wr.Score(house.Id), b = wr.Score(war.EnemyHouseId); int tot = Math.Max(1, a + b);
                    <div class="war"><div><Sigil HouseId="@war.EnemyHouseId" Accent="@(eh?.AccentColor ?? "#888")" Size="16" /> <b>@war.EnemyName</b> <span class="muted">since turn @war.Since · their hulls ~@war.EnemyHulls@(war.TheyAreSuing ? " · they sue for peace" : "")</span></div>
                        <div class="tally"><span class="for" style="width:@(100 * a / tot)%"></span><span class="against" style="width:@(100 * b / tot)%"></span></div>
                        <div class="kv"><span>War score</span><b>@a : @b</b></div>
                        <button class="opt" disabled="@(!war.PeaceAvailable)" title="@war.PeaceTooltip" @onclick="() => G.Execute(new SueForPeaceCommand(pid, war.EnemyHouseId, c.Fleets))">Sue for peace (1 influence)</button></div>
                }
                @if (m.Wars.Count == 0) { <div class="muted">At peace. The lanes are quiet.</div> }
                @foreach (var sg in m.Sieges) { <div class="line @(sg.Ours ? "warn" : "")"><Icon Name="siege" Size="12" /> @sg.HoldingName under siege by @sg.BesiegerName · @sg.Turns/@sg.Required@(sg.Ours ? " — ours" : "")</div> }
            </section>
            <section class="panel">
                <h3><Icon Name="report" Size="13" /> Dispatches</h3>
                @if (battles.Count == 0) { <div class="muted">No battle has been fought in living memory.</div> }
                @foreach (var h in battles) { <div class="line small"><span class="muted">T@(h.Turn)</span> @h.Text</div> }
            </section>
        </aside>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    private string _campaign = "";
    private void SetCampaign(ChangeEventArgs e) => _campaign = e.Value?.ToString() ?? "";
    private void MoveWar(string nationId) => G.Execute(new ProposeMotionCommand(G.World!.ProtagonistId, "foreign_war", nationId, G.Turn!.Senate));
    private static string AwayWord(string phase) => phase switch { "fighting" => "fighting", "home" => "homeward", _ => "outward" };
    private static string StanceHelp(string s) => s switch { "press" => "the charge: +15% power, more losses; beats the skirmish, beaten by the line", "skirmish" => "harass and evade: −10% power, far fewer losses; beats the line, beaten by the press", "boarding" => "the press with prize crews: on victory, 2 manpower take a hull per four the enemy lost", _ => "the line: steady; beats the press, beaten by the skirmish" };
    private static string StyleHelp(string s) => s switch { "front" => "+10% to this fleet, the crews' love, a point of valour a victory — and twice the risk of dying with the line", "flag" => "every fleet of the house +3% per point of tactics; never lost with the line; needs the rank of Commander", _ => "the captains fight the ships" };
}
