@using Praetoria.Core.Systems
@inject GameClient G
@* The Military window (docs/VISUAL_SYSTEM.md 4 and 5.3: "fleets as rows with the fleet token and the admiral's face"). The bridge painting
   (a battle at war) with the eagle in its medallion, the navy's state in three facts and five figures on the plinth. Six tabs: Fleets (each
   fleet a row of its token, name, state, the admiral's face and its hulls, which opens for its meters, its ships, its captain, its orders as
   joined plates, its actions as plates, and the rarer orders in a drawer opened one at a time), Near (the plot, what sails near, the navies,
   the dispatches), Wars (every year of every war, and every battle), General (CaesarPanel), Service (ServicePanel) and Beyond (the nations
   past the rim, each a row of its arms, name, temper, strength, regard and one order, which opens for the rest).
   What a figure means is in its tooltip; the rules are in each section's "i". Styles in css/win/military.css. *@
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var p = w.Protagonist!; var house = w.House(p.HouseId)!; var fs = G.Turn!.Fleets;
    int ours = FleetSystem.StrengthOf(w, house.Id);
    /* hulls laid up are kept and not counted as strength: every line that speaks of the navy says so (docs/MILITARY.md, "Laid up") */
    int laidHulls = w.Fleets.Values.Where(x => x.OwnerId == house.Id && x.LaidUp).Sum(x => x.Strength); string laidSays = laidHulls > 0 ? $" ({laidHulls} more laid up)" : "";
    int upkeep = w.Fleets.Values.Where(f => f.OwnerId == house.Id).Sum(f => fs.Upkeep(f).Credits);
    var mapFleets = GalaxyProjection.Fleets(w);
    var battles = w.History.Where(h => h.Text.Contains("battle", StringComparison.OrdinalIgnoreCase) || h.Text.Contains("destroyed") || h.Text.Contains("desert") || h.Text.Contains("Prize crews")).Reverse().Take(8).ToList();
    int fuelBurn = FleetSystem.FuelBillFor(w, house.Id, c.Fleets.FuelHullsPerUnit); var officeHulls = w.Fleets.Values.Where(f => f.Office && f.OwnerId == house.Id).Sum(f => f.Strength);
    var mil = m.Military; var nations = mil?.Nations ?? new List<NationCard>(); var warAbroad = nations.FirstOrDefault(n => n.AtWar);
    var abroadLines = w.History.Where(h => h.Text.Contains("Raiders of ") || h.Text.Contains("beyond the Reach") || h.Text.Contains("in the space of") || h.Text.Contains("in their own space") || h.Text.Contains("comes home from") || h.Text.Contains("sues for peace") || h.Text.Contains("is at war with") || h.Text.Contains("gutters out") || h.Text.Contains("is lost:") || h.Text.Contains("last tribute")).Reverse().Take(8).ToList();
    int maxStr = Math.Max(1, nations.Count == 0 ? 1 : nations.Max(n => Math.Max(n.Strength, n.FullStrength)));
    // the plot: every system on a flat chart, lanes, fronts, our supply, our fleets and the enemy's as reported
    var nodes = GalaxyProjection.Nodes(w); var lanes = GalaxyProjection.Lanes(w);
    /* the plot's scale and its height: it is fitted to the systems it draws (below), so no band of it is empty */
    double pk = 1, pox = 40, poy = 40, px0 = 0, py0 = 0, vbH = 360; const double vbW = 640;
    double PX(double x) => pox + (x - px0) * pk; double PY(double y) => poy + (y - py0) * pk;
    var byId = nodes.ToDictionary(n => n.SystemId); var enemies = w.EnemiesOf(house.Id).ToHashSet();
    bool Enemy(MapNode n) => n.OwnerHouseId != null && enemies.Contains(n.OwnerHouseId);
    string? campaign = FleetSystem.CampaignTarget(w, house.Id);
    var inSupply = w.Galaxy == null ? new HashSet<string>() : nodes.Where(n => fs.InSupply(w, house.Id, n.SystemId)).Select(n => n.SystemId).ToHashSet();
    string F(double v) => v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
    int raidersAtLarge = w.Fleets.Values.Where(f => f.OwnerId == PirateSystem.HouseId).Sum(f => f.Strength);
    // ---- the picture (docs/DASHBOARDS.md): how far everything is from what is ours, the nearest danger, the navies ranked,
    //      the fleets' condition, and one sentence that says how things stand
    var adj = new Dictionary<string, List<string>>();
    foreach (var l in lanes) { if (!adj.TryGetValue(l.A, out var la)) adj[l.A] = la = new(); la.Add(l.B); if (!adj.TryGetValue(l.B, out var lb)) adj[l.B] = lb = new(); lb.Add(l.A); }
    var jumps = new Dictionary<string, (int d, string from)>(); var queue = new Queue<string>();
    foreach (var n in nodes.Where(n => n.IsPlayerTerritory).OrderBy(n => n.SystemId, StringComparer.Ordinal)) { jumps[n.SystemId] = (0, n.Name); queue.Enqueue(n.SystemId); }
    while (queue.Count > 0) { var cur = queue.Dequeue(); var (d0, from0) = jumps[cur]; if (!adj.TryGetValue(cur, out var nb)) { continue; } foreach (var x in nb) { if (!jumps.ContainsKey(x)) { jumps[x] = (d0 + 1, from0); queue.Enqueue(x); } } }
    var focus = nodes.Where(n => jumps.TryGetValue(n.SystemId, out var jf) && jf.d <= 3).ToList(); if (focus.Count < 4) { focus = nodes.ToList(); }
    var inFocus = focus.Select(n => n.SystemId).ToHashSet();
    // the plot fits what it shows (the systems within three jumps), keeping the map's proportions: it is as wide as the window and
    // as tall as the systems need, so no band of it is empty (a margin is kept for the names and the fleets' marks)
    if (focus.Count > 0)
    {
        double x0 = focus.Min(n => n.X), x1 = focus.Max(n => n.X), y0 = focus.Min(n => n.Y), y1 = focus.Max(n => n.Y); double dx = Math.Max(1e-6, x1 - x0), dy = Math.Max(1e-6, y1 - y0);
        pk = Math.Min((vbW - 120) / dx, 300 / dy); double cw = dx * pk, ch = dy * pk;
        vbH = Math.Clamp(ch + 104, 220, 400); px0 = x0; py0 = y0; pox = (vbW - cw) / 2; poy = (vbH - ch) / 2 + 4;
    }
    string Who(MapFleet f) => f.IsPlayer ? f.Name : f.OwnerHouseId == PirateSystem.HouseId ? "Raiders" : f.OwnerHouseName;
    bool Hostile(MapFleet f) => f.OwnerHouseId == PirateSystem.HouseId || enemies.Contains(f.OwnerHouseId);
    int RegardOf(string houseId) => w.House(houseId) is { } oh && Economy.HeadOf(w, oh) is { } ohead ? w.GetRelationship(ohead.Id, pid)?.Disposition ?? 0 : 0;
    var near = mapFleets.Where(f => !f.IsPlayer && jumps.TryGetValue(f.SystemId, out var j) && j.d <= 3)
        .Select(f => (f, j: jumps[f.SystemId], hostile: Hostile(f))).OrderByDescending(x => x.hostile).ThenBy(x => x.j.d).ThenByDescending(x => x.f.Strength).ThenBy(x => x.f.FleetId, StringComparer.Ordinal).ToList();
    var danger = near.FirstOrDefault(x => x.hostile); bool anyDanger = danger.f != null;
    var fleetsOf = w.Houses.Values.Where(h => h.Id != PirateSystem.HouseId).Select(h => (id: h.Id, name: h.Name, accent: h.AccentColor, hulls: FleetSystem.StrengthOf(w, h.Id), mine: h.Id == house.Id)).Where(x => x.hulls > 0 || x.mine)
        .OrderByDescending(x => x.hulls).ThenByDescending(x => x.mine).ThenBy(x => x.id, StringComparer.Ordinal).ToList();
    int navyRank = 1 + fleetsOf.Count(r => r.hulls > ours), navies = fleetsOf.Count; int strongest = fleetsOf.Count == 0 ? ours : Math.Max(ours, fleetsOf[0].hulls);
    int avgReady = m.Fleets.Count == 0 ? 0 : (int)m.Fleets.Average(f => f.Readiness), avgLoyal = m.Fleets.Count == 0 ? 0 : (int)m.Fleets.Average(f => f.Loyalty), avgSupply = m.Fleets.Count == 0 ? 0 : (int)m.Fleets.Average(f => f.Supply);
    bool dry = w.HasFlag("fuel_short") && house.Treasury.Helium3 == 0; /* helium bought this year lets the fleet sail at once, and the screen says so */ int he3 = house.Treasury.Helium3;
    /* the forecast counts what the house brings up, not only what it burns (docs/PLAYTHROUGH.md, Medium, War and peace: S72, S42, S68) */
    var fuel = FleetSystem.Outlook(he3, fuelBurn, G.Turn!.Economy?.Forecast(w, house.Id, G.Turn.Fleets)?.Helium3 ?? -fuelBurn); int fuelYears = fuel.Years < 0 ? 99 : fuel.Years;
    int net = m.Ledger?.Net.Credits ?? 0; int gross = Math.Max(1, net + upkeep); int upkeepPct = Math.Clamp(100 * upkeep / gross, 0, 100);
    var firstBattle = mil?.Brief.FirstOrDefault(); int odds = firstBattle == null ? 0 : (int)Math.Round(100 * firstBattle.OurPower / Math.Max(0.01, firstBattle.OurPower + firstBattle.TheirPower));
    var coldest = w.Houses.Values.Where(h => h.Id != house.Id && h.Id != PirateSystem.HouseId && Economy.HeadOf(w, h) != null).OrderBy(h => RegardOf(h.Id)).ThenBy(h => h.Id, StringComparer.Ordinal).FirstOrDefault();
    string abroadTip = m.Wars.Count == 0 && warAbroad != null ? "\nAt war with " + warAbroad.Name + ", beyond the Reach, since year " + warAbroad.WarSince + "." : "";
    string story, storyTone;
    if (m.Fleets.Count == 0) { story = "No hull flies your colours. Lay one down at a world with a shipyard, on the House screen."; storyTone = "warn"; }
    else if (firstBattle != null)
    {
        story = $"Battle at {firstBattle.SystemName} at the year's end against {firstBattle.EnemyName}: your {Counted.Hulls(firstBattle.OurHulls)} against {firstBattle.EnemyHulls} as reported, odds {odds} in a hundred." + (firstBattle.Edge < 0 ? " Their stance has the edge of yours: change it below." : "");
        storyTone = odds >= 50 ? "warn" : "bad";
    }
    else if (dry) { story = "Your fleets cannot sail. The tanks are dry, and readiness falls fifteen a year until helium-3 is found: buy it on the Exchange, or hold a world that skims it."; storyTone = "bad"; }
    else if (m.Wars.Count > 0)
    {
        var war0 = m.Wars[0]; var wr0 = w.Wars.First(x => x.Between(house.Id, war0.EnemyHouseId)); int sa = wr0.Score(house.Id), sb = wr0.Score(war0.EnemyHouseId);
        story = $"At war with {war0.EnemyName} since year {war0.Since}. The score stands {sa} to {sb}; they have about {Counted.Hulls(war0.EnemyHulls)} to your {ours}." + (war0.TheyAreSuing ? " They are suing for peace." : war0.TheyOfferTerms ? " They have sent their terms." : "") + (m.Wars.Count > 1 ? $" And {Counted.OtherWars(m.Wars.Count - 1)}." : "");
        storyTone = sa >= sb ? "warn" : "bad";
    }
    else if (warAbroad != null)
    {
        int abroad = nations.Count(n => n.AtWar);
        story = $"At war beyond the Reach with {warAbroad.Name} since year {warAbroad.WarSince}. The war score stands {warAbroad.ScoreReach} to {warAbroad.ScoreNation}; your {Counted.Hulls(ours)} are in commission{laidSays}." + (abroad > 1 ? $" And {Counted.OtherWars(abroad - 1)} beyond the Reach." : "");
        storyTone = warAbroad.ScoreReach >= warAbroad.ScoreNation ? "warn" : "bad";
    }
    else if (anyDanger && danger.j.d <= 2) { story = $"{Who(danger.f!)}: {Counted.Hulls(danger.f!.Strength)} {JumpWord(danger.j.d)} {danger.j.from}. You have {ours}."; storyTone = "warn"; }
    else { story = $"At peace. Your {Counted.Hulls(ours)} in commission{laidSays} make the {Ordinal(navyRank)} navy of {navies}" + (anyDanger ? $"; the nearest hostile sail is {danger.j.d} jumps off." : "; nothing hostile sails within three jumps of your worlds."); storyTone = "good"; }
    if (!dry && m.Fleets.Count > 0 && firstBattle == null && ours > 0 && (avgLoyal < 40 || avgSupply < 50 || avgReady < 50)) { story += avgLoyal < 40 ? " The crews are wavering." : avgSupply < 50 ? " The fleets are short of supply." : " The fleets are not ready to fight."; }
    string condition = m.Fleets.Count == 0 ? "No fleet" : avgLoyal < 30 ? "Will not sail" : avgSupply < 40 ? "Short of supply" : avgReady < 50 ? "Not ready" : avgLoyal < 50 ? "Wavering" : "Ready";
    string conditionTone = condition == "Ready" ? "good" : condition is "Wavering" or "Not ready" ? "warn" : "bad";
    string StatusOf(FleetLine f) => w.Fleets.TryGetValue(f.Id, out var lf) && lf.LaidUp ? "laid up" : f.Away.Length > 0 ? "beyond the Reach" : f.Loyalty < 30 ? "will not sail" : dry ? "cannot sail" : f.Moving ? $"under way · {Counted.Jumps(f.Eta)}" : f.Supply < 40 ? "short of supply" : f.Readiness < 50 ? "not ready" : "ready";
    string StatusTone(FleetLine f) => f.Away.Length > 0 || f.Moving ? "" : f.Loyalty < 30 || dry ? "bad" : f.Supply < 40 || f.Readiness < 50 ? "warn" : "good";
    bool atWar = m.Wars.Count > 0 || nations.Any(n => n.AtWar) || firstBattle != null || w.CivilWar != null;
    int hostileNear = near.Count(x => x.hostile), freshBattles = w.Battles.Count(b => b.Involves(house.Id) && b.Turn >= w.Turn - 1), asks = w.ServiceAsks.Count(a => a.Turn >= w.Turn - 1);
    var hiredOut = MercenarySystem.HiredOutBy(w, house.Id).ToList();
    string F0(string tone) => tone == "good" ? "good" : tone == "warn" ? "brass" : tone == "bad" ? "ember" : "ivory";

    var figures = new List<WindowHeader.Figure>
    {
        new("fleet", ours.ToString(), ours == 1 ? "Hull" : "Hulls", "brass",
            Tip: $"[fleet] Hulls in commission\nYour {Counted.Hulls(ours)} are counted in your strength" + (laidHulls > 0 ? $"; {laidHulls} of yours are laid up and not counted" : "") + "." + (officeHulls > 0 ? $" {officeHulls} of them are office hulls the chair pays for." : "") + $"\nThe {Ordinal(navyRank)} navy of {navies}; the strongest has {strongest}."),
        new("trophy", Ordinal(navyRank), $"Navy of {navies}", navyRank == 1 ? "brass" : navies > 1 && navyRank * 2 > navies ? "ember" : "ivory",
            Tip: $"[trophy] Your navy among the houses\nThe {Ordinal(navyRank)} of {navies} navies by hulls in commission. The strongest has {strongest}. The Near tab ranks them all."),
        new("heart-beats", avgReady.ToString(), condition == "Ready" ? "Readiness" : condition, F0(conditionTone), Of: m.Fleets.Count == 0 ? "" : "100",
            Tip: $"[heart-beats] Condition: {condition}\n" + (m.Fleets.Count == 0 ? "You have no fleet." : $"On average across {Counted.Fleets(m.Fleets.Count)}: readiness {avgReady}, loyalty {avgLoyal}, supply {avgSupply}.") + "\nReadiness under 50 fights badly. Loyalty under 30 will not sail, under 15 deserts. Supply under 40 fights at four-fifths."),
        new("helium3", dry ? "0" : fuelBurn == 0 || fuel.Years < 0 ? he3.ToString() : fuelYears.ToString(), dry ? "Fuel, dry" : fuelBurn == 0 ? "Helium-3" : fuel.Years < 0 ? "Helium-3, holds" : fuelYears == 1 ? "Year of fuel" : "Years of fuel",
            dry || (fuelBurn > 0 && fuelYears < 3) ? "ember" : "steel",
            Tip: $"[helium3] Helium-3: {he3} in the tanks\n{(dry ? "No fleet may sail." : fuel.Says)}\nFleets burn helium-3 every year: one for every {c.Fleets.FuelHullsPerUnit} hulls. The figure is how long the tanks last when what the house brings up in a year is set against what its fleets burn. With none, readiness falls and nothing sails."),
        new("credits", Money.Show(upkeep), "Upkeep", net < 0 ? "ember" : "brass",
            Tip: $"[credits] Upkeep: {Money.Show(upkeep)} a year\nWhat the fleets cost in credits each year: " + (upkeep > gross ? $"more than the {Money.Show(gross)} the house takes in before it" : $"{upkeepPct}% of the {Money.Show(gross)} the house takes in before it") + (net < 0 ? ". The house is losing money." : "."))
    };
    /* a tab with nothing in it is hidden (VISUAL_SYSTEM.md 4.4): Wars while no war has been fought and no battle, Service while no command
       by service is held, asked or open to be sought */
    var warHist = WarLedger.History(w, house.Id); bool warsEmpty = warHist.own.Count == 0 && warHist.others.Count == 0 && w.Battles.Count == 0;
    bool serviceEmpty = asks == 0 && ServiceSystem.OfHouse(w, house.Id).Count == 0 && !w.Service.Any(s => s.OwnerId == house.Id || s.NamedById == p.Id)
        && !w.PastService.Any(s => s.CommanderHouseId == house.Id || s.OwnerId == house.Id) && !ServiceSystem.Seekers(w, p).Any(k => ServiceSystem.TakersFor(w, c.Offices, k).Count > 0)
        && ServiceSystem.EnemyOf(w, house.Id) == null;
    var tabs = new List<Tabs.Tab>
    {
        new("deck", "Fleets", "fleet", m.Fleets.Count.ToString(), Tip: "Your fleets: their condition and their orders, the wars you are in and the campaign"),
        new("near", "Near", "spyglass", hostileNear > 0 ? hostileNear.ToString() : "", hostileNear > 0, Tip: "What sails near your worlds, the plot of the lanes, and every house's navy"),
        new("wars", "Wars", "crossed-sabres", m.Wars.Count > 0 ? m.Wars.Count.ToString() : freshBattles > 0 ? freshBattles.ToString() : "", m.Wars.Count > 0 || freshBattles > 0, Hidden: warsEmpty && _view != "wars", Tip: "Every year of every war, standing and ended, and every battle fought"),
        new("general", "General", "laurels", Tip: "The general and the Senate: the general's sway, whose the crews are, a triumph, and the line"),
        new("service", "Service", "rally-the-troops", asks > 0 ? asks.ToString() : "", asks > 0, Hidden: serviceEmpty && _view != "service", Tip: "A command by service: a fleet your house does not own, or one of yours under another's commander"),
        new("abroad", "Beyond", "world", warAbroad != null ? "1" : nations.Count.ToString(), warAbroad != null, Hidden: nations.Count == 0, Tip: "Beyond the Reach: " + (warAbroad != null ? "war with " + warAbroad.Name : Counted.Of(nations.Count, "nation")) + ", each come through its march on the rim")
    };
}
<div class="mil-win" data-view="@_view" style="--accent:@m.HouseAccent">
    <WindowHeader Scene="@(atWar ? "battle" : "shipyard")" Kicker="@("Military · navy of " + house.Name)" Title="The Command Deck" Glyph="eagle-emblem" Figures="figures" Class="mil-head">
        <Facts>
            <span class="@conditionTone" title="@($"[heart-beats] {condition}\nReadiness {avgReady}, loyalty {avgLoyal}, supply {avgSupply} on average.")"><Icon Name="checked-shield" Tone="ivory" Size="16" />@condition</span>
            <span class="@(m.Wars.Count > 0 || warAbroad != null ? "bad" : "")" title="The wars your house is in and how each stands. At peace, the house whose head thinks worst of yours.@(abroadTip + (coldest != null && m.Wars.Count == 0 ? $"\n{coldest.Name} thinks worst of you ({Signed(RegardOf(coldest.Id))})" : ""))"><Icon Name="@(m.Wars.Count > 0 ? "crossed-sabres" : "dove")" Tone="ivory" Size="16" />@(m.Wars.Count == 0 ? (warAbroad != null ? "War beyond the Reach" : "At peace") : m.Wars.Count == 1 ? "At war with " + m.Wars[0].EnemyName : Counted.Wars(m.Wars.Count))</span>
            <span class="@(!anyDanger ? "" : danger.j.d <= 1 ? "bad" : "warn")" title="The nearest fleet of raiders or of a house you are at war with, counted in jumps from the nearest world of yours."><Icon Name="@(anyDanger ? "threat" : "checked-shield")" Tone="@(anyDanger ? "ember" : "good")" Size="16" />@(anyDanger ? $"{Who(danger.f!)}, {JumpWord(danger.j.d)} {danger.j.from}" : "Nothing hostile near")</span>
        </Facts>
    </WindowHeader>
    <Tabs Items="tabs" Active="@_view" OnPick="Pick" Class="mil-tabs" />
    <div class="ui-wbody fades mil-body">
    @if (_view == "general") { <CaesarPanel /> }
    else if (_view == "service") { <ServicePanel /> }
    else if (_view == "wars")
    {
        /* every year of every war, standing and ended (docs/MILITARY.md, "Commanding a navy"), and every battle */
        var hist = WarLedger.History(w, house.Id);
        var mineB = w.Battles.Where(b => b.Involves(house.Id)).Reverse().Take(12).ToList(); var othersB = w.Battles.Where(b => !b.Involves(house.Id)).Reverse().Take(10).ToList();
        string Nm(string id) => w.House(id)?.Name ?? id;
        int standing = hist.own.Count(x => x.Ended == 0), won = mineB.Count(b => b.WinnerId == house.Id);
        <p class="ui-lede mil-lede @(standing > 0 ? "bad" : "")">@Bold(hist.own.Count == 0 && mineB.Count == 0 ? "Your house has fought no war and no battle. A battle is fought when two fleets at war stand in the same system at the year's end."
            : $"Your house has fought {Counted.Wars(hist.own.Count)}, {standing} of them standing, and {Counted.Of(mineB.Count, "battle")}: {won} won and {mineB.Count - won} lost.")</p>
        <div data-wars="mine">
            @if (hist.own.Count == 0) { <div data-wars-none="1"><EmptyState Icon="dove" Text="Your house has fought no war with another house. A house declares a war on the Houses window." LinkLabel="Open Houses" OnLink='() => OnGo.InvokeAsync("houses")' /></div> }
            <Section Title="Your wars" Count="@hist.own.Count.ToString()" IsEmpty="@(hist.own.Count == 0)" Info="A war's year is written down when the year turns, after the battles are fought and the sieges resolved: the battles, the hulls lost and sunk and taken, the worlds that changed hands, the score, and what your fleets in commission cost. A war with a nation beyond the Reach is kept under Beyond.">
                @foreach (var wr in hist.own)
                {
                    var years = WarLedger.ClosedYears(wr).ToList(); string other = wr.HouseA == house.Id ? wr.HouseB : wr.HouseA; var oh = w.House(other);
                    <div class="mil-war @(wr.Ended > 0 ? "ended" : "standing")" data-war="@WarKey(wr)" data-war-ended="@wr.Ended">
                        <div class="mw-top">
                            <span class="mw-arms">@if (oh != null) { <Sigil HouseId="@oh.Id" Accent="@oh.AccentColor" Size="26" /> } else { <Icon Name="crossed-sabres" Tone="ivory" Size="22" /> }</span>
                            <b class="mw-say">@(wr.Ended > 0 ? WarLedger.Over(w, wr, house.Id) : WarLedger.Standing(w, wr, house.Id))</b>
                            @if (wr.Ended == 0) { <span class="mil-st bad">standing</span> }
                        </div>
                        @if (years.Count == 0) { <div class="mw-year ui-mute">No year of it has turned yet: its first account is written when this year ends.</div> }
                        @foreach (var y in years) { <div class="mw-year" data-war-year="@y.Turn"><span class="yr">Year @y.Turn</span><span>@WarLedger.Say(w, wr, y, house.Id, false)</span></div> }
                    </div>
                }
            </Section>
        </div>
        <div data-battles="mine">
            <Section Title="Your battles" Count="@mineB.Count.ToString()" IsEmpty="@(mineB.Count == 0)" EmptyLine="Your house has fought no battle yet." EmptyIcon="crossed-sabres" Info="A battle is fought when two fleets at war stand in the same system at the year's end. The chance before a shot was fired is each side's weight against the other's: hulls, readiness, stance, the commander, the captain's gunnery and the ground.">
                @foreach (var b in mineB)
                {
                    bool bwon = b.WinnerId == house.Id; bool att = b.AttackerId == house.Id; int ch = att ? b.AttackerChance() : 100 - b.AttackerChance();
                    <div class="mil-battle @(bwon ? "won" : "lost")">
                        <span class="mb-med"><Icon Name="crossed-sabres" Tone="@(bwon ? "brass" : "ember")" Size="22" /></span>
                        <div class="mb-text">
                            <div class="mb-nm"><b>@(bwon ? "Won" : "Lost"): the battle of @b.Place</b></div>
                            <div class="mb-sub">Year @b.Turn · against @Nm(att ? b.DefenderId : b.AttackerId) · you were @(att ? "attacking" : "holding") · your chance was @ch in 100</div>
                            <div class="mb-sides">
                                <span><b>@Nm(b.AttackerId)</b> attacking: @Counted.Hulls(b.AttackerHulls), lost @b.AttackerLost, weight @b.AttackerPower.ToString("0.#")</span>
                                <span><b>@Nm(b.DefenderId)</b> holding: @Counted.Hulls(b.DefenderHulls), lost @b.DefenderLost, weight @b.DefenderPower.ToString("0.#")</span>
                            </div>
                            @foreach (var n in b.Notes) { <div class="mb-note">@Cap(n).</div> }
                        </div>
                        <span class="mb-loss" title="Hulls lost: yours, then theirs"><b class="ui-down">@Counted.Figure(-(att ? b.AttackerLost : b.DefenderLost))</b><small>@Counted.Figure(-(att ? b.DefenderLost : b.AttackerLost)) theirs</small></span>
                    </div>
                }
            </Section>
        </div>
        @if (hist.others.Count > 0)
        {
            <div data-wars="others">
                <Section Title="Wars between others" Count="@hist.others.Count.ToString()" Info="@($"Wars between other houses: those standing, and the last {WarLedger.KeptOthers} that ended. Open one for its years.")">
                    @foreach (var wr in hist.others.Take(24))
                    {
                        var years = WarLedger.ClosedYears(wr).ToList();
                        <details class="mil-fold" data-war="@WarKey(wr)"><summary><Icon Name="chev" Size="11" Class="flat" />@(wr.Ended > 0 ? WarLedger.Over(w, wr, house.Id) : WarLedger.Standing(w, wr, house.Id))</summary>
                            @if (years.Count == 0) { <div class="mw-year ui-mute">No year of it has turned yet.</div> }
                            @foreach (var y in years) { <div class="mw-year" data-war-year="@y.Turn"><span class="yr">Year @y.Turn</span><span>@WarLedger.Say(w, wr, y, house.Id, false)</span></div> }
                        </details>
                    }
                </Section>
            </div>
        }
        @if (othersB.Count > 0)
        {
            <div data-battles="others">
                <Section Title="Battles between others" Count="@othersB.Count.ToString()">
                    @foreach (var b in othersB) { <div class="mil-line"><span class="yr">Year @b.Turn</span><span><b>@b.Place</b>: @Nm(b.WinnerId) beat @Nm(b.WinnerId == b.AttackerId ? b.DefenderId : b.AttackerId), @b.AttackerHulls against @Counted.Hulls(b.DefenderHulls), lost @b.AttackerLost and @b.DefenderLost</span></div> }
                </Section>
            </div>
        }
    }
    else if (_view == "abroad")
    {
        string abroadStory = nations.Count == 0 ? "No nation lies beyond the rim." : warAbroad != null ? $"The Reach is at war with {warAbroad.Name}: the tally stands {warAbroad.ScoreReach} to {warAbroad.ScoreNation}, and {warAbroad.Threshold} clear ends it."
            : $"{Counted.Of(nations.Count, "nation")} lie beyond the rim, and the Reach is at war with none. Each comes through its march; the Senate makes war, and houses send fleets.";
        <p class="ui-lede mil-lede @(warAbroad != null ? "bad" : "")">@Bold(abroadStory)</p>
        <div class="panel abroad mil-abroad">
            @if (warAbroad != null)
            {
                int tot = Math.Max(1, warAbroad.ScoreReach + warAbroad.ScoreNation); int lead = warAbroad.ScoreReach - warAbroad.ScoreNation;
                <Section Title="@("War with " + warAbroad.Name)" Info="@(warAbroad.OnMap ? $"Sail to their worlds by the lanes. A fleet that raids sacks a world in a season and leaves it; one that takes and holds besieges it. Their host beaten counts two; a world of the Reach freed, or one of theirs taken, three; their capital, {warAbroad.Capital}, ends it. A squadron of the Reach beaten counts one for them and a world occupied three. The house that does most takes the triumph." : $"Each victory abroad brings {Money.Show(warAbroad.Wealth)} credits of plunder home and a point of valour to a commander at the front; the house whose fleets win most takes the triumph.")">
                    <Right><span>since turn <b>@warAbroad.WarSince</b></span></Right>
                    <ChildContent>
                    <div class="mil-tally war abroad-war">
                        <div class="mt-line"><span>@(warAbroad.OnMap ? "Fought on the map" : Counted.Fleets(warAbroad.Expeditions) + " of the Reach in their space") · they hold @Counted.Hulls(warAbroad.Strength)</span><b>@warAbroad.ScoreReach : @warAbroad.ScoreNation</b></div>
                        <Meter Kind="diverging" Value="@lead" Max="@Math.Max(1, warAbroad.Threshold)" Text="@Signed(lead)" Label="The tally" Tip="@($"{warAbroad.Threshold} clear subdues them; {warAbroad.Threshold} the other way and the chair buys peace")" />
                        @if (warAbroad.OnMap) { <div class="mt-note">@(G.World!.Nation(warAbroad.Id) is { WarOf.Length: > 0 } own ? $"Only {G.World!.House(own.WarOf)?.Name ?? own.WarOf} is at war with them: no other house's fleets will fight theirs, and theirs come only for that house." : "Every house of the Reach is at war with them.")</div> }
                    </div>
                    </ChildContent>
                </Section>
            }
            <Section Title="The nations" Count="@nations.Count.ToString()" Info="Each nation comes through its march on the rim. The Senate makes war and peace with them; houses send fleets. A nation's regard for the Reach runs from −100 to +100: an aggressive or decaying nation raids the rim once its regard is at −20 or lower. Its strength is the hulls it can put in the field, against the strongest nation at its full strength.">
            @foreach (var n in nations)
            {
                string nid = n.Id;
                var nState = G.World!.Nation(n.Id); var nHouse = nState != null && nState.HouseId.Length > 0 ? G.World!.House(nState.HouseId) : null; var nHead = nHouse != null ? Economy.HeadOf(G.World!, nHouse) : null;
                /* its orders: the one that matters most stands on the row (move for war; at war, move for peace), the rest in the open row */
                var shown = n.Orders != null && n.OnMap && !n.Fallen ? n.Orders.Where(o => o.Refusal == null || o.Id is "own_war" && !n.AtWar && n.SubduedUntil == 0 || o.Id.StartsWith("terms_") && o.Refusal != "not your war" && o.Refusal != "not offered").ToList() : new List<Option>();
                var terms = shown.Where(o => o.Id.StartsWith("terms_")).ToList(); var rest = shown.Where(o => !o.Id.StartsWith("terms_")).ToList();
                bool warPlate = !n.AtWar && n.SubduedUntil == 0 && !n.Fallen; var lead = warPlate ? null : rest.FirstOrDefault(o => o.Id == "peace"); if (lead != null) { rest.Remove(lead); }
                var (status, statusTone, statusTip) = n.Fallen ? ("No more", "", "It has fallen: it holds nothing and makes no war.") : n.AtWar ? ("At war", "bad", $"At war with the Reach since year {n.WarSince}.")
                    : n.SubduedUntil > 0 ? ("Tributary", "good", $"It pays {Money.Show(n.Tribute)} a year until year {n.SubduedUntil}.") : n.RaidedLately ? ("Raiding", "warn", "Raiding the rim: it has fallen on worlds of the Reach lately.") : ("", "", "");
                <div class="nation mil-nation @(n.AtWar ? "war" : n.SubduedUntil > 0 ? "tributary" : "") @(n.Fallen ? "fallen" : "")" data-nation="@n.Id">
                    <details class="mn-more">
                    @* the row (docs/VISUAL_SYSTEM.md 4.7): its arms, its name and temper (and its state in one word), its strength, its regard for
                       the Reach and one order; a click opens its ruler, march, seat and fleets, and its other orders *@
                    <summary class="mn-row" title="@($"{n.Name}: its ruler, march{(n.OnMap && !n.Fallen ? ", seat and fleets" : "")}, and your other orders. Click to open.")">
                        @if (nHouse != null) { <span class="mn-arms" title="@($"The arms of {n.Name}")"><Sigil HouseId="@nHouse.Id" Accent="@nHouse.AccentColor" Size="34" /></span> }
                        else { <span class="mn-med"><Icon Name="@(n.AtWar ? "crossed-sabres" : n.SubduedUntil > 0 ? "laurels" : "flying-flag")" Tone="@(n.AtWar ? "ember" : n.SubduedUntil > 0 ? "good" : "ivory")" Size="22" /></span> }
                        <div class="mn-id">
                            <div class="mn-nm"><b title="@n.Description">@n.Name</b></div>
                            <div class="mn-sub">@Cap(n.Temper)@if (status.Length > 0) { <text> · </text><span class="mn-status @statusTone" title="@statusTip">@status</span> }</div>
                        </div>
                        <span class="mn-str" title="@($"[fleet] {n.Name}: {Counted.Hulls(n.Strength)}\nThe hulls it can put in the field{(n.FullStrength > n.Strength ? $", of {n.FullStrength} at full strength" : "")}. The strongest nation has {maxStr} at its full strength.")"><Icon Name="fleet" Tone="@(n.AtWar ? "ember" : "steel")" Size="16" /><b>@n.Strength</b><small>hulls</small></span>
                        <Meter Kind="diverging" Value="@n.Disposition" Max="100" Text="@Signed(n.Disposition)" Class="mn-reg" ValueClass="@(n.Disposition <= -30 ? "ui-down" : n.Disposition >= 20 ? "ui-up" : "")" Tip="Their regard for the Reach, from −100 to +100. An aggressive or decaying nation raids the rim once its regard is at −20 or lower." />
                        <span class="mn-act">
                        @if (warPlate)
                        {
                            <Plate Label="@n.War.Label" Small="true" Icon="vote" Stop="true" Locked="@(n.War.Refusal != null)" Disabled="@(n.War.Refusal != null)" ShowNeed="false" Need="@Cap(n.War.Refusal ?? "")" CostIcon="public-speaker" CostText="3"
                                   Tip="@(n.War.Refusal == null ? "[vote] Move for war\nMove in the Senate that the Reach make war upon them. 3 influence." : "[vote] Move for war")" OnClick="() => MoveWar(nid)" />
                        }
                        else if (lead != null)
                        {
                            var lo = lead; var (lstate, lverb) = SplitOrder(lo.Label);
                            <span class="mn-order" title="@(lstate.Length > 0 ? lstate : null)"><Plate Label="@ShortVerb(lo.Id, lverb)" Small="true" Stop="true" Icon="@OrderIcon(lo.Id)" Locked="@(lo.Refusal != null)" Disabled="@(lo.Refusal != null)" ShowNeed="false" Need="@Cap(lo.Refusal ?? "")" Tip="@($"[{OrderIcon(lo.Id)}] {lo.Label}\n{Cap(OrderHint(lo.Id))}")" OnClick="() => Order(nid, lo.Id)" /></span>
                        }
                        </span>
                        <Icon Name="chev" Size="12" Class="flat mn-chev" />
                    </summary>
                    <div class="mn-open">
                    @if (n.Ruler.Length > 0)
                    {
                        <div class="mn-ruled" title="The one who rules it leans on its regard for the Reach: the warlike sour it, the wary raid only in a real quarrel, the grasping raid for twice the cargo, the mild sweeten it. Rulers die and are followed, sometimes by the commander of the fleets. Every point of the commander's skill over four makes its fleets fight six in a hundred harder, and every point under, as much less; a commander who beats you learns from it, and one who is routed may be killed.">
                            @if (nHead != null) { <span class="mn-ruler" title="@($"{n.Ruler}, who rules it: {n.RulerNature} by nature")"><Portrait Id="@nHead.Id" Name="@nHead.Name" Sex="@nHead.Sex" Age="@nHead.Age" Accent="@nHouse!.AccentColor" Size="40" Height="48" /></span> }
                            <span class="mn-rt"><span class="k">Ruled by</span><span><b>@n.Ruler</b>, @n.RulerNature by nature · the fleets under <b>@n.Commander</b>, skill @n.CommanderSkill of 9</span></span>
                        </div>
                    }
                    <div class="mn-facts">
                        @if (n.OnMap && !n.Fallen) { <span class="k">Its space</span><span class="v" title="This nation holds worlds on the map, beyond its march. Its fleets move by the lanes and fight by the ordinary rules; a war with it is every house's war.">on the map, beyond its march</span> }
                        @if (n.Holds.Length > 0) { <span class="k">Holds</span><span class="v">@n.Holds</span> }
                        @if (n.SubduedUntil > 0) { <span class="k">Tribute</span><span class="v ui-up">pays @Money.Show(n.Tribute) a year until year @n.SubduedUntil</span> }
                        @if (n.RaidedLately) { <span class="k warn">Of late</span><span class="v ui-warn-t">raiding the rim</span> }
                        @if (n.Wars > 0 && !n.AtWar) { <span class="k">Its wars</span><span class="v">@Counted.Wars(n.Wars) fought</span> }
                        @if (n.Marches.Length > 0) { <span class="k">Its march</span><span class="v" title="Its raids come through these systems and fall on worlds within two lanes of them. A fleet of three hulls or more standing at the march turns a raid back before it lands. An expedition's voyage is the nation's depth beyond the march, and a year for every three lanes between the fleet and the march."><b>@n.Marches</b>@if (!n.OnMap) { <span class="ui-dim"> · @Counted.Years(n.Nearest) out from your nearest fleet</span> } · @if (n.Guard.Length > 0) { <span class="ui-up">held by @n.Guard</span> } else { <span class="ui-dim">unguarded</span> }</span> }
                        @if (n.OnMap && !n.Fallen)
                        {
                            <span class="k">Sits at</span><span class="v" title="Taking the world its ruler sits at ends a war with it. @(n.HoldYears > 0 ? $"A world of its own held by a house of the Reach rises again after {n.HoldYears} years without a fleet of three hulls over it, unless the nation is paying tribute." : "A world of its own held by a house of the Reach does not rise: the nation makes war to take it back.")"><b>@n.Capital</b> · holds @n.Worlds</span>
                            @if (n.WhoseWar.Length > 0) { <span class="k warn">Whose war</span><span class="v ui-warn-t" title="The Senate votes a war and a peace and directs no fleet. A house may make war on its own account, and may fight on after a peace is voted, at a cost to its name.">@n.WhoseWar</span> }
                            @if (n.Fleets.Length > 0) { <span class="k">Its fleets</span><span class="v" title="The guard stays with the ruler. The host comes through the march when there is war, takes one world, and goes home with it; it stays home when it is short of supply or not rested.">@n.Fleets</span> }
                            @if (n.Occupied.Length > 0) { <span class="k warn">Holds of ours</span><span class="v ui-warn-t" title="Held until a house of the Reach frees it or the peace is made. If the Reach wins the war it goes home; if not, it is ceded."><b>@n.Occupied</b></span> }
                            @if (n.Ransom.Length > 0) { <span class="k">It offers</span><span class="v ui-up" title="A report asks you each year the offer stands: take the money and the world goes home, or keep it."><b>@n.Ransom</b></span> }
                            @if (n.Watch.Length > 0) { <span class="k">Tribute</span><span class="v @(n.Watch.StartsWith("not") ? "ui-warn-t" : "")" title="It pays while a fleet of the Reach of three hulls or more stands at its march or over one of its worlds.">@n.Watch</span> }
                            @if (n.Lost.Length > 0) { <span class="k">Lost to us</span><span class="v" title="Of its own, in the Reach's hands. Easy to take, hard to hold: without a fleet over it, it rises.">@n.Lost</span> }
                        }
                    </div>
                    @if (n.OnMap && !n.Fallen && n.Manner.Length > 0) { <p class="mn-manner">@n.Manner</p> }
                    @if (rest.Count > 0)
                    {
                        <div class="mn-orders"><span class="mn-state">Your orders:</span>
                            @foreach (var o in rest)
                            {
                                var oo = o; var (state, verb) = SplitOrder(o.Label);
                                <span class="mn-order" title="@(state.Length > 0 ? state : null)">
                                    <Plate Label="@ShortVerb(oo.Id, verb)" Small="true" Icon="@OrderIcon(o.Id)" Locked="@(oo.Refusal != null)" Disabled="@(oo.Refusal != null)" ShowNeed="false" Need="@Cap(oo.Refusal ?? "")" Tip="@($"[{OrderIcon(o.Id)}] {o.Label}\n{Cap(OrderHint(oo.Id))}")" OnClick="() => Order(nid, oo.Id)" /></span>
                            }
                        </div>
                    }
                    @if (terms.Count > 0)
                    {
                        <div class="mn-orders terms"><span class="mn-state">Make your own peace:</span>
                            @foreach (var o in terms)
                            {
                                var oo = o; var (_, verb) = SplitOrder(o.Label);
                                <Plate Label="@verb" Small="true" Icon="dove" Locked="@(oo.Refusal != null)" Disabled="@(oo.Refusal != null)" ShowNeed="false" Need="@Cap(oo.Refusal ?? "")" Tip="@($"[dove] {o.Label}\n{Cap(OrderHint(oo.Id))}")" OnClick="() => Order(nid, oo.Id)" />
                            }
                        </div>
                    }
                    </div>
                    </details>
                </div>
            }
            </Section>
            @if (abroadLines.Count > 0)
            {
                <Section Title="Word from beyond" Count="@abroadLines.Count.ToString()">
                    @foreach (var h in abroadLines) { <div class="mil-line"><span class="yr">Year @h.Turn</span><span>@h.Text</span></div> }
                </Section>
            }
        </div>
    }
    else if (_view == "near")
    {
        string nearStory = near.Count == 0 ? "Nothing sails within three jumps of your worlds. Your captains report other houses' fleets here as they come near."
            : anyDanger ? $"{Who(danger.f!)}: {Counted.Hulls(danger.f!.Strength)} {JumpWord(danger.j.d)} {danger.j.from}, the nearest hostile sail of {Counted.Fleets(near.Count)} within three jumps. You have {ours}."
            : $"{Counted.Fleets(near.Count)} within three jumps of your worlds, and none of them hostile. Yours is the {Ordinal(navyRank)} navy of {navies}.";
        <p class="ui-lede mil-lede @(anyDanger && danger.j.d <= 1 ? "bad" : anyDanger ? "warn" : "")">@Bold(nearStory)</p>
        <Section Title="The plot" Info="Where yours are, and what is near them: every system within three jumps of your worlds, its lanes and who holds it, your supply, your fleets with their hulls, and every other fleet as your captains report it. A front is a lane between your world and an enemy's.">
            <Right><span>@(focus.Count) systems</span></Right>
            <ChildContent>
            <div class="mil-plot">
                @{ var plotFleets = mapFleets.Where(f => byId.ContainsKey(f.SystemId) && inFocus.Contains(f.SystemId)).OrderByDescending(f => f.IsPlayer).ThenByDescending(Hostile).ThenBy(f => f.FleetId, StringComparer.Ordinal).ToList();
                   var plotNodes = nodes.Where(n => inFocus.Contains(n.SystemId)).ToList(); var (spots, plotLabels) = PlotLayout(plotNodes, plotFleets, byId, PX, PY, Enemy, vbW, vbH); }
                <svg class="plot" viewBox="0 0 @F(vbW) @F(vbH)" role="img" aria-label="the war plot">
                    @foreach (var l in lanes)
                    {
                        if (!byId.TryGetValue(l.A, out var a) || !byId.TryGetValue(l.B, out var b)) { continue; }
                        if (!inFocus.Contains(l.A) && !inFocus.Contains(l.B)) { continue; }
                        bool front = (a.IsPlayerTerritory && Enemy(b)) || (b.IsPlayerTerritory && Enemy(a));
                        bool ourLane = a.IsPlayerTerritory || b.IsPlayerTerritory;
                        <line x1="@F(PX(a.X))" y1="@F(PY(a.Y))" x2="@F(PX(b.X))" y2="@F(PY(b.Y))" class="lane @(front ? "front" : ourLane ? "ours" : "")" />
                    }
                    @* a fleet stands beside its system, never on it or on another: a hairline ties its mark to the system it is at *@
                    @foreach (var f in plotFleets) { var n = byId[f.SystemId]; var (fx, fy) = spots[f.FleetId]; <line x1="@F(PX(n.X))" y1="@F(PY(n.Y))" x2="@F(fx)" y2="@F(fy)" class="flead" /> }
                    @foreach (var n in plotNodes)
                    {
                        bool mine = n.IsPlayerTerritory; bool enemy = Enemy(n);
                        @if (inSupply.Contains(n.SystemId)) { <circle cx="@F(PX(n.X))" cy="@F(PY(n.Y))" r="24" class="supply" /> }
                        @if (campaign == n.SystemId) { <circle cx="@F(PX(n.X))" cy="@F(PY(n.Y))" r="18" class="campaign" /> }
                        <circle cx="@F(PX(n.X))" cy="@F(PY(n.Y))" r="@(mine ? 9 : enemy || n.Capital ? 7 : n.OwnerHouseId != null ? 5 : 3.5)" class="node @(mine ? "mine" : "") @(enemy ? "enemy" : "") @(!mine && !enemy && !n.Capital ? "far" : "")" style="fill:@(n.OwnerHouseId != null ? n.AccentColor : "#3a4152")"><title>@n.Name@(n.OwnerHouseName != null ? $" · {n.OwnerHouseName}" : " · unclaimed")@(jumps.TryGetValue(n.SystemId, out var jn) && jn.d > 0 ? $" · {Counted.Jumps(jn.d)} from {jn.from}" : "")</title></circle>
                    }
                    @foreach (var f in plotFleets)
                    {
                        bool hostile = Hostile(f); var (x, y) = spots[f.FleetId];   /* beside its system, clear of every system and every other fleet */
                        <g class="fleet @(f.IsPlayer ? "mine" : hostile ? "enemy" : "other")" transform="translate(@F(x),@F(y))" style="--fc:@(hostile ? "#e0553f" : f.AccentColor)">
                            <path d="M-9 6 L0 -13 L9 6 L0 1 Z" style="fill:@(hostile ? "#c4472f" : f.AccentColor)" /><rect x="-13" y="9" width="26" height="21" rx="1.5" class="flp" />@((MarkupString)$"<text y=\"25.5\" class=\"fl\">{f.Strength}</text>")
                            <title>@f.Name · @f.OwnerHouseName · @Counted.Hulls(f.Strength)@(f.IsPlayer ? "" : $" · confidence {f.Confidence}%")@(f.Moving ? $" · under way, {Counted.Jumps(f.Eta)}" : "")</title>
                        </g>
                    }
                    @* the names, most wanted first, each where it overlaps no other name and no fleet's mark; a name with no clear place is
                       left to its tooltip (docs/VISUAL_SYSTEM.md, rule 5: nothing is written over anything) *@
                    @foreach (var (lx, ly, text, cls) in plotLabels)
                    {
                        @((MarkupString)$"<text x=\"{F(lx)}\" y=\"{F(ly)}\" class=\"{cls}\">{System.Net.WebUtility.HtmlEncode(text)}</text>")
                    }
                </svg>
                <div class="plot-legend">
                    <span><i class="lg node mine"></i>your worlds</span><span><i class="lg supply"></i>in supply</span><span><i class="lg fleet mine"></i>your fleets, with hulls</span>
                    <span><i class="lg fleet enemy"></i>hostile</span><span><i class="lg fleet other"></i>other houses' fleets</span>@if (enemies.Count > 0) { <span><i class="lg front"></i>a front</span> }<span class="ui-mute">drawn to three jumps from your worlds</span>
                </div>
            </div>
            </ChildContent>
        </Section>
        <Section Title="What is near" Count="@near.Count.ToString()" Info="Every fleet within three jumps of your worlds, hostile first, as your captains report it: a figure with ~ is a guess. To you is what its house's head thinks of you, from −100 to +100."
                 IsEmpty="@(near.Count == 0)" EmptyLine="Nothing sails within three jumps of your worlds. Your captains report other houses' fleets here as they come near." EmptyIcon="spyglass">
            <DataTable Class="mil-table near">
                <Head><th>Whose</th><th>Hulls</th><th title="Where it lies: a world of yours, or how many jumps it is from the nearest of them (the whole of it in the tooltip)">At</th><th>To you</th></Head>
                <ChildContent>
                @foreach (var x in near.Take(8))
                {
                    bool raider = x.f.OwnerHouseId == PirateSystem.HouseId; int regard = raider ? 0 : RegardOf(x.f.OwnerHouseId);
                    string toYou = raider ? "raiders" : x.hostile ? "at war" : regard <= -30 ? $"ill disposed, {Signed(regard)}" : regard >= 30 ? $"well disposed, {Signed(regard)}" : $"neutral, {Signed(regard)}";
                    <tr class="@(x.hostile ? "hostile" : "")" title="@x.f.Name · confidence @(x.f.Confidence)%">
                        <td><span class="mt-nm">@if (!raider) { <Sigil HouseId="@x.f.OwnerHouseId" Accent="@x.f.AccentColor" Size="18" /> } else { <Icon Name="plain-dagger" Tone="ember" Size="17" /> }@(raider ? "Raiders" : x.f.OwnerHouseName)</span></td>
                        <td class="@(x.hostile && x.f.Strength > ours ? "ui-down" : "")" title="@(x.f.Strength > ours ? "more than yours" : x.f.Strength == ours ? "as many as yours" : "fewer than yours")">@(x.f.Confidence < 100 ? "~" : "")@x.f.Strength</td>
                        <td title="@($"{Cap(JumpWord(x.j.d))} {x.j.from}{(x.f.Moving ? ", under way" : "")}")">@(byId.TryGetValue(x.f.SystemId, out var at) ? at.Name : x.f.SystemId)@(x.f.Moving ? ", under way" : "")<span class="mt-far">@(x.j.d == 0 ? "yours" : Counted.Jumps(x.j.d))</span></td>
                        <td class="@(x.hostile || regard <= -30 ? "ui-down" : regard >= 30 ? "ui-up" : "ui-dim")">@toYou</td>
                    </tr>
                }
                </ChildContent>
            </DataTable>
            @if (near.Count > 8) { <div class="mil-more">And @(near.Count - 8) more.</div> }
        </Section>
        <Section Title="The navies" Count="@navies.ToString()" Info="Every house with a hull, strongest first, by hulls in commission. To you is what its head thinks of you, from −100 to +100.">
            <Right>@if (raidersAtLarge > 0) { <span class="ui-down">Raiders on the lanes: <b class="ui-down">@raidersAtLarge</b> @(raidersAtLarge == 1 ? "hull" : "hulls")</span> }</Right>
            <ChildContent>
            @{ var board = fleetsOf; int myPlace = board.FindIndex(x => x.mine); var shownBoard = _allNavies ? board : board.Take(6).ToList(); if (!_allNavies && myPlace >= 6) { shownBoard = board.Take(5).Append(board[myPlace]).ToList(); } }
            <DataTable Class="mil-table navies">
                <Head><th>#</th><th>House</th><th></th><th>Hulls</th><th>To you</th></Head>
                <ChildContent>
                @foreach (var r in shownBoard)
                {
                    int place = board.IndexOf(r) + 1; bool war = !r.mine && w.AtWar(house.Id, r.id); int regard = r.mine ? 0 : RegardOf(r.id);
                    <tr class="@(r.mine ? "mine" : war ? "hostile" : "")">
                        <td class="ui-dim">@place</td>
                        <td class="hn"><span class="mt-nm"><Sigil HouseId="@r.id" Accent="@r.accent" Size="18" />@r.name</span></td>
                        <td class="bar" title="@($"{r.hulls} of the {strongest} the strongest navy has")"><span class="ui-trk"><i class="ui-fill" style="width:@(100 * r.hulls / Math.Max(1, strongest))%;--mc:color-mix(in srgb, @r.accent 80%, #1c1c1c)"></i></span></td>
                        <td>@r.hulls</td>
                        <td class="@(war || regard <= -30 ? "ui-down" : regard >= 30 ? "ui-up" : "ui-dim")">@(r.mine ? "yours" : war ? "at war" : Signed(regard))</td>
                    </tr>
                }
                </ChildContent>
            </DataTable>
            @if (board.Count > 6) { <div class="mil-more"><button class="ui-link" @onclick="() => _allNavies = !_allNavies">@(_allNavies ? "Show fewer" : $"Show all {board.Count}")<Icon Name="chev" Size="11" Class="flat" /></button></div> }
            </ChildContent>
        </Section>
        @if (battles.Count > 0)
        {
            <Section Title="Dispatches" Count="@Math.Min(5, battles.Count).ToString()" Info="The last battles, desertions and prizes the chronicle records.">
                @foreach (var h in battles.Take(5)) { <div class="mil-line"><span class="yr">Year @h.Turn</span><span>@h.Text</span></div> }
            </Section>
        }
    }
    else
    {
        <p class="ui-lede mil-lede @storyTone">@Bold(story)</p>
        @if (mil != null)
        {
            @foreach (var b in mil.Brief)
            {
                int bo = (int)Math.Round(100 * b.OurPower / Math.Max(0.01, b.OurPower + b.TheirPower));
                <WarnStrip Icon="crossed-sabres" Bad="@(b.OurPower < b.TheirPower)" Lead="@($"Battle at {b.SystemName} at the year's end.")" Class="mil-strip">
                    @($"{b.EnemyName}, {Counted.Hulls(b.EnemyHulls)} as reported ({b.Confidence}% sure), against your {b.OurHulls}. Your {b.OurStance} against their {b.TheirStance}: {(b.Edge > 0 ? "the edge is yours" : b.Edge < 0 ? "the edge is theirs, so change the stance" : "no edge either way")}. Odds {bo} in a hundred.")
                </WarnStrip>
            }
        }
        <Section Title="Your fleets" Count="@m.Fleets.Count.ToString()" Info="Movement is ordered on the map: pick a fleet in the outliner or on the map, then a world. Here you set how each fights (its stance and its loadout), who commands it and from where, and what is done with its hulls.">
            <Right><Link data-to-shipyard="1" Tip="Hulls are laid down at a world of yours: the House window lists your worlds, and each has its shipyard's buttons" OnClick='() => OnGo.InvokeAsync("house:estate")' Label="Lay down hulls" /></Right>
            <ChildContent>
            @if (mil != null)
            {
                <div class="mil-me">
                    <Portrait Id="@p.Id" Name="@p.Name" Sex="@p.Sex" Age="@p.Age" Accent="@m.HouseAccent" Size="46" Height="56" />
                    <div class="mm-t">
                        <b>You command from</b>
                        <span class="mm-sub"><span title="A commander can lead this many hulls well: it comes of rank and tactics. A fleet larger than its commander's number fights worse.">up to @Counted.Hulls(mil.MyCap) without loss</span>@(mil.MyValour > 0 ? $" · valour {mil.MyValour}" : "")@(mil.MyAchilles ? " · the Achilles of the Reach" : "")</span>
                    </div>
                    @Seg(mil.MyStyleOptions, mil.MyStyle, StyleLabel, StyleHelp, id => G.Execute(new SetCommandStyleCommand(pid, pid, id)))
                </div>
            }
            @if (officeHulls > 0)
            {
                <div class="mil-office"><Icon Name="podium" Tone="good" Size="18" /><span><b>The Admiralty.</b> @Counted.OfficeHulls(officeHulls) @Counted.Sail(officeHulls) under your colours: the chair pays their upkeep and the state fuels them. War on the chair is treason.</span></div>
            }
            @foreach (var hired in hiredOut)
            {
                /* a company out on hire: whose pay it is in, where, for how long, and a way to call it back */
                var recall = new RecallHiredFleetCommand(pid, hired.Id); string? recallNo = recall.Refusal(G.Ctx); string hiredId = hired.Id, hiredName = hired.Name, employerName = w.House(hired.OwnerId)?.Name ?? hired.OwnerId;
                <div class="mil-fleet hired" data-hired-out="@hired.Id">
                    <div class="mf-top">
                        @Token(m.HouseAccent, true)
                        <div class="mf-id">
                            <div class="mf-nm"><b>@hired.Name</b><span class="mil-st">out on hire</span></div>
                            <div class="mf-sub">@fs.Describe(hired) · in the pay of @employerName · @(hired.IsAway ? "beyond the Reach" : hired.Moving ? "under way" : "at " + (w.Galaxy?.System(hired.SystemId)?.Name ?? hired.SystemId))</div>
                        </div>
                        <Plate Label="Call it back" Small="true" Icon="anticlockwise-rotation" Locked="@(recallNo != null)" Disabled="@(recallNo != null)" ShowNeed="false" Need="@Cap(recallNo ?? "")" data-recall-hired="@hired.Id"
                               Tip="@($"[anticlockwise-rotation] Call it back\nThe contract is broken: {employerName}'s head thinks {MercenarySystem.BreakRegard} the worse of you, and your house is thought the less of (legitimacy −{MercenarySystem.BreakLegitimacy}). The company is yours again at once and sails for home.")" OnClick="() => AskRecallHired(hiredId, hiredName, employerName)" />
                    </div>
                    <div class="mf-standing">@employerName pays @Money.Show(MercenarySystem.PayOf(hired)) credits a year for it (@Money.Show(MercenarySystem.CreditsPerHull) a hull) and keeps and fuels it. It sails and fights at @employerName's orders; hulls it loses are lost. @Counted.Years(MercenarySystem.YearsLeft(w, hired)) of its term are left, and it comes home sooner if that house's wars end or the pay is not found.</div>
                </div>
            }
            @if (m.Fleets.Count == 0) { <EmptyState Icon="fleet" Text="No hull flies your colours. A world with a shipyard can lay one down." LinkLabel="Open your worlds" OnLink='() => OnGo.InvokeAsync("house:estate")' /> }
            @foreach (var f in m.Fleets)
            {
                var fleet = w.Fleets[f.Id]; var adm = f.AdmiralId != null ? w.Char(f.AdmiralId) : null; var capt = f.CaptainId != null ? w.Char(f.CaptainId) : null; string fid = f.Id;
                string drawer = _drawer.GetValueOrDefault(f.Id, "");
                bool fOpen = FleetOpen(f, m.Fleets.Count);
                string admSays = f.AdmiralName == null ? "" : (f.AdmiralStyle == "front" ? "leads from the front" : f.AdmiralStyle == "flag" ? "commands from the flag" : "leaves the line to the captains") + $" · cap {f.Cap}" + (f.Valour > 0 ? $" · valour {f.Valour}" : "");
                <div class="mil-fleet @(f.Loyalty < 30 || f.Supply < 40 ? "warn" : "") @(fleet.LaidUp ? "laid" : "") @(fOpen ? "open" : "shut")" data-fleet="@f.Id">
                    @* the row (docs/VISUAL_SYSTEM.md 4.7, 5.3): the fleet's token, its name and state, where it lies, the admiral's face and the
                       hulls. A click opens it for its condition, its ships, its captain, how it fights, and its orders. *@
                    <div class="mf-top" role="button" aria-expanded="@(fOpen ? "true" : "false")" title="@(fOpen ? "Fold it away" : "Open it: its condition, its ships, its captain, how it fights and its orders")" @onclick="() => ToggleFleet(f, m.Fleets.Count)">
                        @Token(m.HouseAccent, fleet.LaidUp)
                        <div class="mf-id">
                            <div class="mf-nm"><b>@f.Name</b><span class="mil-st @StatusTone(f)">@StatusOf(f)</span></div>
                            <div class="mf-sub">@f.Composition · @(f.Away.Length > 0 ? $"beyond the Reach, against {f.AwayName}, {AwayWord(f.AwayPhase)} ({f.AwayTurns})" : f.Moving ? $"bound for {f.Destination}, {Counted.Years(f.Eta)}" : "at " + f.Where)@(f.Office ? " · held by office" : "")</div>
                        </div>
                        <span class="mf-adm" title="@(f.AdmiralName == null ? NoAdmiralSays(f) : $"Admiral {f.AdmiralName}: {admSays}")">
                            @if (adm != null) { <Portrait Id="@adm.Id" Name="@adm.Name" Sex="@adm.Sex" Age="@adm.Age" Alive="@adm.Alive" Accent="@(w.House(adm.HouseId)?.AccentColor ?? m.HouseAccent)" Size="40" Height="48" Titled="false" /> } else { <Portrait Size="40" Height="48" EmptyGlyph="office-chair" Name="No admiral" /> }
                            <span class="mw-t"><b>@(f.AdmiralName ?? "no admiral")</b><span class="k">Admiral</span></span>
                        </span>
                        <span class="mf-fig" title="@($"[fleet] {Counted.Hulls(f.Strength)}\n{string.Join(", ", fs.Composition(fleet).Select(x => x.count + " " + x.cls.Name.ToLowerInvariant() + (x.count == 1 ? "" : "s")))}{(f.Veterancy > 0 ? $"\nVeterancy {f.Veterancy}" : "")}")"><b>@f.Strength</b><small>@(f.Strength == 1 ? "hull" : "hulls")</small></span>
                        <Icon Name="chev" Size="12" Class="flat mf-chev" />
                    </div>
                    <div class="mf-open">
                    <div class="mf-standing" data-standing="@f.Id">@f.Standing</div>
                    @if (f.Away.Length > 0) { <div class="mil-office"><Icon Name="world" Tone="good" Size="18" /><span><b>Expedition.</b> @(f.ExpeditionWins == 1 ? "1 victory" : f.ExpeditionWins + " victories")@(f.Plunder > 0 ? $", {Money.Show(f.Plunder)} credits of plunder aboard" : ""); @(f.AwayPhase == "fighting" ? "fighting in their space" : f.AwayPhase == "home" ? "sailing home" : "outward bound").</span></div> }
                    <div class="mf-body">
                        <div class="mf-meters">
                            <Meter Label="Readiness" Value="@f.Readiness" Text="@f.Readiness.ToString()" Color="@(f.Readiness < 50 ? "#c4472f" : "#8cc47e")" ValueClass="@(f.Readiness < 50 ? "ui-down" : "")"
                                   Tip="@($"[heart-beats] Readiness, 0 to 100\nA fleet at 100 fights at full weight, one at 0 at half. Each year at anchor it recovers {c.Fleets.ReadinessRecovery}; each year under way it falls {c.Fleets.ReadinessDecayMoving}. A battle won costs {c.Fleets.WinnerReadinessCost} and one lost {c.Fleets.LoserReadinessCost}. Dry tanks cost {FleetSystem.FuelReadinessLoss} a year, unpaid upkeep {FleetSystem.UnpaidReadinessLoss}, and short supply 5. A refit at a world of yours puts it back to 100 at once.")" />
                            <Meter Label="Loyalty" Value="@f.Loyalty" Text="@f.Loyalty.ToString()" Target="30" Color="@(f.Loyalty < 30 ? "#c4472f" : "#8cc47e")" ValueClass="@(f.Loyalty < 30 ? "ui-down" : "")" Tip="[shaking-hands] The crews' loyalty\nUnder 30 they will not sail (the tick), under 15 they desert." />
                            <Meter Label="Supply" Value="@f.Supply" Text="@f.Supply.ToString()" Target="40" Color="@(f.Supply < 40 ? "#c4472f" : "#7fa8d6")" ValueClass="@(f.Supply < 40 ? "ui-down" : "")" Tip="@("[cargo-crate] Supply\n" + (fleet.IsAway ? "Supply beyond the Reach falls each season of the expedition." : fs.SupplySays(w, fleet, fleet.Moving ? fleet.DestinationId : fleet.SystemId)) + " Under 40 (the tick) it fights at four-fifths.")" />
                        </div>
                        <div class="mf-ships">
                            @foreach (var (cls, n) in fs.Composition(fleet)) { <span class="mil-chip" title="@($"[{(Icons.Paths.ContainsKey(cls.Id) ? cls.Id : "fleet")}] {cls.Name}\nAttack {cls.Attack}, defence {cls.Defense}")"><Icon Name="@(Icons.Paths.ContainsKey(cls.Id) ? cls.Id : "fleet")" Tone="steel" Size="16" /><b>@n</b> @(cls.Name + (n == 1 ? "" : "s"))</span> }
                            @if (f.Veterancy > 0) { <span class="mil-chip" title="Each step of veterancy is worth a share more in a fight"><Icon Name="medal" Tone="brass" Size="16" />Veterancy <b>@f.Veterancy</b></span> }
                        </div>
                    </div>
                    <div class="mf-people">
                        <div class="mf-who mf-admline">
                            <span class="k">Admiral</span>
                            <span class="mw-sub">@if (f.AdmiralName != null) { <b>@f.AdmiralName</b> <text>@admSays</text>@if (f.Achilles) { <span class="ui-warn-t"> · the Achilles</span> } } else { <text>@NoAdmiralSays(f)</text> }</span>
                        </div>
                        <div class="mf-who" title="@CaptainHelp">
                            @if (capt != null) { <Portrait Id="@capt.Id" Name="@capt.Name" Sex="@capt.Sex" Age="@capt.Age" Alive="@capt.Alive" Accent="@(w.House(capt.HouseId)?.AccentColor ?? m.HouseAccent)" Size="40" Height="48" /> } else { <Portrait Size="40" Height="48" EmptyGlyph="checked-shield" Name="No captain" /> }
                            <div class="mw-t"><span class="k">Captain</span><b data-captain="@f.Id">@(f.CaptainName ?? "no captain")</b>@if (f.CaptainName != null) { <span class="mw-sub">@f.CaptainSays</span> }</div>
                        </div>
                    </div>
                    @if (fleet.Office) { <div class="mf-standing ui-dim" data-office-terms="@f.Id">@OfficeSystem.FleetTerms(w, c.Offices, fleet)</div> }
                    <div class="mf-orders">
                        <span class="mo"><span class="mo-l">Stance</span>@Seg(f.StanceOptions, f.Stance, Cap, StanceHelp, id => G.Execute(new SetStanceCommand(pid, fid, id)))</span>
                        <span class="mo"><span class="mo-l">Loadout</span>@Seg(f.LoadoutOptions, f.Loadout, Cap, id => id == "torpedoes" ? "A quarter more power; burns an isotope a battle" : "The guns", id => G.Execute(new SetLoadoutCommand(pid, fid, id)))</span>
                        @if (f.StyleOptions != null && f.AdmiralId != null && f.AdmiralId != pid) { var aid = f.AdmiralId; <span class="mo"><span class="mo-l">The admiral, from</span>@Seg(f.StyleOptions, f.AdmiralStyle, StyleLabel, StyleHelp, id => G.Execute(new SetCommandStyleCommand(pid, aid, id)))</span> }
                    </div>
                    <div class="mf-acts">
                        @if (f.Expedition != null) { <Plate Label="@f.Expedition.Label" Small="true" Icon="world" Locked="@(f.Expedition.Refusal != null)" Disabled="@(f.Expedition.Refusal != null)" ShowNeed="false" Need="@Cap(f.Expedition.Refusal ?? "")" CostIcon="scroll-quill" CostText="1" Tip="[world] Send an expedition\n1 treasury action: the fleet leaves the map, sails the nation's distance, fights a season of four battles and comes home with plunder, valour and fewer hulls" OnClick="() => G.Execute(new SendExpeditionCommand(pid, fid, f.Expedition.Id, c.Fleets, c.Nations))" /> }
                        @if (f.Recall != null) { <Plate Label="@f.Recall.Label" Small="true" Icon="anticlockwise-rotation" Locked="@(f.Recall.Refusal != null)" Disabled="@(f.Recall.Refusal != null)" ShowNeed="false" Need="@Cap(f.Recall.Refusal ?? "")" Tip="[anticlockwise-rotation] Recall\nTurn for home before the season is done" OnClick="() => G.Execute(new RecallExpeditionCommand(pid, fid, c.Nations))" /> }
                        @if (fleet.Moving && !fleet.IsAway)
                        {
                            var rc = new RecallFleetCommand(pid, f.Id); var why = rc.Refusal(G.Ctx); int back = RecallFleetCommand.YearsBack(fleet);
                            <Plate Label="@(back == 0 ? "Strike out the order" : "Call it back")" Small="true" Icon="anticlockwise-rotation" CostIcon="@(back == 0 ? "" : "hourglass")" CostText="@(back == 0 ? "" : back + " yr")" Locked="@(why != null)" Disabled="@(why != null)" ShowNeed="false" Need="@Cap(why ?? "")" data-recall="@f.Id"
                                   Tip="@(back == 0 ? "[anticlockwise-rotation] Strike out the order\nThe order was given this year: it is struck out and the fleet stays" : $"[anticlockwise-rotation] Call it back\nIt has sailed {Counted.Years(back)}: it takes as long to come back")" OnClick="() => G.Execute(rc)" />
                        }
                        @{ bool fullReady = f.Refit.Refusal == "already at full readiness"; }
                        <Plate Label="Refit" Small="true" Icon="gears" CostIcon="materials" CostText="@((RefitFleetCommand.MaterialsPerHull * f.Strength).ToString())" Locked="@(f.Refit.Refusal != null)" Disabled="@(f.Refit.Refusal != null)" ShowNeed="@(!fullReady)" Need="@Cap(f.Refit.Refusal ?? "")"
                               Tip="@($"[gears] Refit {f.Name}\n{RefitFleetCommand.MaterialsPerHull * f.Strength} materials, and readiness is back to 100 at once.")" OnClick="() => G.Execute(new RefitFleetCommand(pid, fid))" />
                        @if (fullReady) { <span class="mf-note" title="Refit brings readiness back to 100 at once: there is nothing to bring back">at full readiness</span> }
                        @* the one plate for the rest of the fleet's orders (4.7): drill, lay up, and the drawers (rename, admiral, captain,
                           hulls, hire out, merge) in a menu in the medium frame *@
                        <span class="mf-menu-wrap">
                        <button class="ui-btn sm mf-menu-btn @(_ordersFor == fid ? "on" : "")" aria-expanded="@(_ordersFor == fid ? "true" : "false")" title="The fleet's other orders: drill, lay up, rename, its admiral and captain, its hulls, hire it out" @onclick="() => _ordersFor = _ordersFor == fid ? null : fid"><Icon Name="scroll-quill" Tone="ivory" Size="16" />Orders<Icon Name="chev" Tone="brass" Size="13" Class="mf-menu-chev" /></button>
                        @if (_ordersFor == fid)
                        {
                        <span class="mf-menu" role="menu">
                        @if (!fleet.Office && fleet.LevyOf.Length == 0)
                        {
                            /* drill: a smaller force made worth more, for manpower each year */
                            bool drilling = fleet.Drilling; var dc = new DrillFleetCommand(pid, f.Id, !drilling, fs); string? dno = dc.Refusal(G.Ctx); string? stops = drilling ? fs.DrillStops(w, fleet) : null; int dcost = fs.DrillCost(fleet);
                            <Plate Label="@(drilling ? "End the drill" : "Drill")" Small="true" Icon="target-arrows" Class="@(drilling ? "lit" : "")" CostIcon="@(drilling ? "" : "manpower")" CostText="@(drilling ? "" : dcost + " a year")" Locked="@(dno != null)" Disabled="@(dno != null)" ShowNeed="false" Need="@Cap(dno ?? "")" data-drill="@f.Id"
                                   Tip="@(drilling ? $"[target-arrows] At drill\n{dcost} manpower a year while it lies at a world of yours, and a step of veterancy each year, up to {c.Fleets.DrillCap}. It stands at {fleet.Veterancy}.{(stops != null ? " As things stand it would not drill this year: " + stops + "." : "")}" : $"[target-arrows] Keep it at drill\nEach year it lies at a world or station of your own it takes {dcost} manpower (one for every {c.Fleets.DrillHullsPerManpower} hulls) and gains a step of veterancy, up to {c.Fleets.DrillCap} of {c.Fleets.VeterancyMax}. Each step is worth {c.Fleets.VeterancyBonus * 100:0}% in a fight; the last steps are learnt only in battle. It stands at {fleet.Veterancy}.")" OnClick="() => G.Execute(dc)" />
                        }
                        @if (!fleet.Office && fleet.LevyOf.Length == 0)
                        {
                            /* lay up: the hulls kept and the crews paid off, for a part of the keep (docs/MILITARY.md, "Laid up") */
                            bool laidUp = fleet.LaidUp; var lay = new LayUpFleetCommand(pid, f.Id, !laidUp, fs); string? layNo = lay.Refusal(G.Ctx); var (keepNow, keepLaid) = lay.Keep(w); string layTitle = fleet.Name + (laidUp ? " is back in commission" : " is laid up"), layChose = laidUp ? "Put it back in commission" : "Lay it up";
                            <Plate Label="@(laidUp ? "Recommission" : "Lay up")" Small="true" Icon="wooden-chair" Class="@(laidUp ? "lit" : "")" Locked="@(layNo != null)" Disabled="@(layNo != null)" ShowNeed="false" Need="@Cap(layNo ?? "")" data-layup="@f.Id"
                                   Tip="@(laidUp ? $"[wooden-chair] Laid up: recommission\nPut it back in commission: it may sail again and is counted in your strength, costs {SavedSays(keepNow)} a year and burns fuel again. Its crews are new to it: it starts with no readiness and gains {c.Fleets.ReadinessRecovery} a year at anchor. One treasury action." : $"[wooden-chair] Lay it up here\nThe {Counted.Hulls(fleet.Strength)} {Counted.Are(fleet.Strength)} kept and the crews paid off. It costs {SavedSays(keepLaid)} a year in place of {SavedSays(keepNow)}, and burns no fuel. While it lies there it has no readiness, takes no order to sail, drill or detach, and is not counted in your strength; if it is attacked it fights at half weight. It can be put back in commission in any year. One treasury action. Nothing is broken up.")"
                                   OnClick="() => G.ExecuteTold(lay, layTitle, layChose)" />
                        }
                        <span class="mf-more">
                            @if (!fleet.Office && fleet.LevyOf.Length == 0) { <button class="mf-tg @(drawer == "rename" ? "on" : "")" data-rename="@f.Id" title="Give the fleet a new name" @onclick='() => Toggle(fid, "rename")'>Rename</button> }
                            <button class="mf-tg @(drawer == "admiral" ? "on" : "")" title="Give the fleet to another of your house" @onclick='() => Toggle(fid, "admiral")'>Admiral</button>
                            @if (fleet.LevyOf.Length == 0) { <button class="mf-tg @(drawer == "captain" ? "on" : "")" data-captain-of="@f.Id" title="Name the captain who serves under the admiral" @onclick='() => Toggle(fid, "captain")'>Captain</button> }
                            @if (!fleet.IsAway && fleet.LevyOf.Length == 0) { <button class="mf-tg @(drawer == "hulls" ? "on" : "")" data-hulls="@f.Id" title="Detach hulls as a guard, or pay them off" @onclick='() => Toggle(fid, "hulls")'>Hulls</button> }
                            @if (!fleet.IsAway && !fleet.Office && fleet.LevyOf.Length == 0) { <button class="mf-tg @(drawer == "hire" ? "on" : "")" data-hire="@f.Id" title="Hire the fleet out in another house's war" @onclick='() => Toggle(fid, "hire")'>Hire out</button> }
                            @if (f.MergeOptions.Count > 0) { <button class="mf-tg @(drawer == "merge" ? "on" : "")" title="Fold another of your fleets into this one" @onclick='() => Toggle(fid, "merge")'>Merge</button> }
                        </span>
                        </span>
                        }
                        </span>
                    </div>
                    @if (drawer == "rename" && !fleet.Office && fleet.LevyOf.Length == 0)
                    {
                        var newName = _names.GetValueOrDefault(f.Id, f.Name); var noName = new RenameFleetCommand(pid, f.Id, newName).Refusal(G.Ctx);
                        <div class="mf-drawer" data-rename="@f.Id">
                            <span class="mo-l">Call it</span>
                            <input class="mil-input" maxlength="40" value="@newName" @oninput="e => _names[fid] = e.Value?.ToString() ?? string.Empty" />
                            <Plate Label="Call it that" Small="true" Locked="@(noName != null)" Disabled="@(noName != null)" ShowNeed="false" Need="@Cap(noName ?? "")" Tip="[fleet] Rename the fleet\nIt costs nothing." OnClick="() => G.Execute(new RenameFleetCommand(pid, fid, _names.GetValueOrDefault(fid, f.Name)))" />
                        </div>
                    }
                    else if (drawer == "admiral")
                    {
                        <div class="mf-drawer list">
                            <div class="mf-dh">Give the fleet to</div>
                            @foreach (var o in f.AdmiralOptions)
                            {
                                var oid = o.Id; var who = w.Char(o.Id);
                                <button class="mil-pick" disabled="@(o.Refusal != null)" title="@(o.Refusal != null ? Cap(o.Refusal) : o.Label)" @onclick="() => G.Execute(new AssignAdmiralCommand(pid, fid, oid))">
                                    @if (who != null) { <Portrait Id="@who.Id" Name="@who.Name" Sex="@who.Sex" Age="@who.Age" Accent="@m.HouseAccent" Size="24" Height="28" Opens="false" /> }
                                    <span>@o.Label</span>@if (o.Refusal != null) { <small class="ui-warn-t">@Cap(o.Refusal)</small> }
                                </button>
                            }
                        </div>
                    }
                    else if (drawer == "captain" && fleet.LevyOf.Length == 0)
                    {
                        <div class="mf-drawer list" data-captain-of="@f.Id">
                            <div class="mf-dh">The captain <span class="ui-info" title="@CaptainHelp">i</span></div>
                            @if (Opts(f.CaptainOptions).Count == 0) { <div class="mf-none" data-no-officers="@f.Id">Nobody of your house is in the naval service.</div> }
                            @foreach (var o in Opts(f.CaptainOptions))
                            {
                                var oid = o.Id; var who = w.Char(o.Id);
                                <button class="mil-pick" data-make-captain="@o.Id" disabled="@(o.Refusal != null)" title="@(o.Refusal != null ? Cap(o.Refusal) : o.Label)" @onclick="() => G.Execute(new AppointCaptainCommand(pid, fid, oid))">
                                    @if (who != null) { <Portrait Id="@who.Id" Name="@who.Name" Sex="@who.Sex" Age="@who.Age" Accent="@m.HouseAccent" Size="24" Height="28" Opens="false" /> }
                                    <span>@o.Label</span>@if (o.Refusal != null) { <small class="ui-warn-t">@Cap(o.Refusal)</small> }
                                </button>
                            }
                            @if (f.RelieveCaptain != null && f.CaptainId != null) { <div class="mf-row"><Plate Label="@($"Relieve {f.CaptainName}")" Small="true" Locked="@(f.RelieveCaptain.Refusal != null)" Disabled="@(f.RelieveCaptain.Refusal != null)" ShowNeed="false" Need="@Cap(f.RelieveCaptain.Refusal ?? "")" data-relieve-captain="@f.Id" Tip="@("[checked-shield] Relieve the captain\n" + RelieveHelp)" OnClick="() => G.Execute(new RelieveCaptainCommand(pid, fid))" /></div> }
                        </div>
                    }
                    else if (drawer == "hulls" && !fleet.IsAway && fleet.LevyOf.Length == 0)
                    {
                        int hn = Math.Clamp(_hulls.GetValueOrDefault(f.Id, 1), 1, Math.Max(1, fleet.Strength));
                        string pickCls = _classOf.GetValueOrDefault(f.Id, string.Empty); if (pickCls.Length > 0 && fleet.Of(pickCls, c.Fleets.DefaultClass) <= 0) { pickCls = string.Empty; }
                        bool withCap = _withCap.Contains(f.Id) && f.CaptainId != null;
                        var det = new DetachHullsCommand(pid, f.Id, hn, c.Fleets, c.ShipClasses, pickCls, withCap); var detNo = det.Refusal(G.Ctx);
                        string detTitle = detNo ?? DetachSays(FleetHulls.Say(det.Which(w)), hn, f.Name, withCap ? f.CaptainName : null, pickCls.Length == 0);
                        var pay = new PayOffHullsCommand(pid, f.Id, hn, c.Fleets, c.ShipClasses); var payNo = pay.Refusal(G.Ctx);
                        <div class="mf-drawer" data-hulls="@f.Id">
                            <div class="mf-row"><Stepper Label="How many" Value="hn" Min="1" Max="@Math.Max(1, fleet.Strength)" OnChange="v => _hulls[fid] = v" Tip="The hulls to detach or pay off" />
                                <span class="mo" data-detach-class="@f.Id" title="The hulls a detachment takes: the lightest, or a class you name. Hulls paid off are always the lightest."><span class="mo-l">Detach which</span>
                                    @{ var comp = fs.Composition(fleet).ToList(); }
                                    <Segmented Class="mil-seg" Value="@pickCls" Options="@(new[] { (string.Empty, "The lightest", "The lightest hulls go") }.Concat(comp.Select(x => (x.cls.Id, x.cls.Name, $"{x.count} {x.cls.Name.ToLowerInvariant()} in the fleet"))).ToList())"
                                               Note="@(id => comp.Where(x => x.cls.Id == id).Select(x => x.count.ToString()).FirstOrDefault() ?? "")" OnChange="id => _classOf[fid] = id" /></span>
                            </div>
                            <div class="mf-row">
                                @if (f.CaptainId == null) { <span class="mf-none" data-detach-captain="@f.Id" title="@NoCaptainToSend">No captain to send with it</span> }
