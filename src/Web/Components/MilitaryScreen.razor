@inject GameClient G
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var house = w.House(w.Protagonist!.HouseId)!;
    var fc = G.Turn!.Economy?.Forecast(w, house.Id, G.Turn.Fleets);
    int ours = FleetSystem.StrengthOf(w, house.Id);
}
<div class="military" style="--accent:@m.HouseAccent">
    <div class="col">
        <section class="panel">
            <h2>The @house.Name navy</h2>
            <div class="muted">@ours hull(s) in @m.Fleets.Count fleet(s) · upkeep @(m.Fleets.Count == 0 ? 0 : w.Fleets.Values.Where(f => f.OwnerId == house.Id).Sum(f => G.Turn.Fleets.Upkeep(f).Credits)) credits a turn · manpower @m.Treasury.Manpower</div>
        </section>
        @foreach (var f in m.Fleets)
        {
            var fleet = w.Fleets[f.Id];
            <section class="panel fleet-card">
                <div class="fleet-head"><h3>@f.Name</h3><span class="muted">@f.Composition · @(f.Moving ? $"en route to {f.Destination} ({f.Eta})" : f.Where)</span></div>
                <div class="kv"><span>Readiness</span><b><span class="bar"><i style="width:@f.Readiness%" class="@(f.Readiness < 50 ? "low" : "")"></i></span> @f.Readiness</b></div>
                <div class="kv"><span>Admiral</span><b>@(f.AdmiralName ?? "unled")</b></div>
                @if (f.Veterancy > 0) { <div class="kv"><span>Veterancy</span><b>@f.Veterancy</b></div> }
                <div class="ships">@foreach (var (cls, n) in G.Turn.Fleets.Composition(fleet)) { <span class="pill" title="atk @cls.Attack / def @cls.Defense">@n × @cls.Name</span> }</div>
                <button class="opt" disabled="@(f.Refit.Refusal != null)" title="@f.Refit.Refusal" @onclick="() => G.Execute(new RefitFleetCommand(pid, f.Id))">@f.Refit.Label</button>
                <details><summary>Command</summary>@foreach (var o in f.AdmiralOptions) { <button class="opt" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new AssignAdmiralCommand(pid, f.Id, o.Id))">@o.Label</button> }</details>
                @if (f.MergeOptions.Count > 0) { <details><summary>Merge</summary>@foreach (var o in f.MergeOptions) { <button class="opt" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new MergeFleetsCommand(pid, o.Id, f.Id))">@o.Label</button> }</details> }
                <div class="muted small">Orders of movement are given on the Galaxy map.</div>
            </section>
        }
        @if (m.Fleets.Count == 0) { <section class="panel"><div class="muted">No hull flies your colours. Lay one down at a holding (House → Holdings → Shipyard).</div></section> }
    </div>
    <div class="col">
        <section class="panel">
            <h3>Wars</h3>
            @foreach (var war in m.Wars)
            {
                var wr = w.Wars.First(x => x.Between(house.Id, war.EnemyHouseId));
                <div class="war"><div><b>@war.EnemyName</b> <span class="muted">since turn @war.Since · their hulls @war.EnemyHulls · score @wr.Score(house.Id) : @wr.Score(war.EnemyHouseId)@(war.TheyAreSuing ? " · they sue for peace" : "")</span></div>
                    <button class="opt" disabled="@(!war.PeaceAvailable)" title="@war.PeaceTooltip" @onclick="() => G.Execute(new SueForPeaceCommand(pid, war.EnemyHouseId, c.Fleets))">Sue for peace with @war.EnemyName (1 influence)</button></div>
            }
            @if (m.Wars.Count == 0) { <div class="muted">At peace.</div> }
            @foreach (var sg in m.Sieges) { <div class="line @(sg.Ours ? "warn" : "")">@sg.HoldingName under siege by @sg.BesiegerName · @sg.Turns/@sg.Required turns@(sg.Ours ? " — ours" : "")</div> }
        </section>
        <section class="panel">
            <h3>Recent battles</h3>
            @{ var battles = w.History.Where(h => h.Text.Contains("battle", StringComparison.OrdinalIgnoreCase) || h.Text.Contains("destroyed") || h.Text.Contains("desert")).Reverse().Take(8).ToList(); }
            @if (battles.Count == 0) { <div class="muted">The lanes have been quiet.</div> }
            @foreach (var h in battles) { <div class="line"><span class="muted">T@(h.Turn)</span> @h.Text</div> }
        </section>
        <section class="panel">
            <h3>Rival navies <span class="muted">(as reported)</span></h3>
            @foreach (var grp in GalaxyProjection.Fleets(w).Where(f => !f.IsPlayer).GroupBy(f => f.OwnerHouseId).OrderByDescending(g => g.Sum(f => f.Strength)))
            {
                var h = w.House(grp.Key)!;
                <div class="line"><Sigil HouseId="@h.Id" Accent="@h.AccentColor" Size="16" /> <b>@h.Name</b> <span class="muted">~@grp.Sum(f => f.Strength) hulls · confidence @((int)grp.Average(f => f.Confidence))%@(w.AtWar(house.Id, h.Id) ? " · AT WAR" : "")</span></div>
            }
        </section>
    </div>
</div>
@code { [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!; }
