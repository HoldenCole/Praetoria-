@inject GameClient G
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var house = w.House(w.Protagonist!.HouseId)!; var fs = G.Turn!.Fleets;
    int ours = FleetSystem.StrengthOf(w, house.Id);
    int upkeep = w.Fleets.Values.Where(f => f.OwnerId == house.Id).Sum(f => fs.Upkeep(f).Credits);
    var mapFleets = GalaxyProjection.Fleets(w);
    var rivals = mapFleets.Where(f => !f.IsPlayer && f.OwnerHouseId != PirateSystem.HouseId).GroupBy(f => f.OwnerHouseId).Select(g => (house: w.House(g.Key)!, hulls: g.Sum(f => f.Strength), conf: (int)g.Average(f => f.Confidence))).Where(x => x.house != null).OrderByDescending(x => x.hulls).ToList();
    var battles = w.History.Where(h => h.Text.Contains("battle", StringComparison.OrdinalIgnoreCase) || h.Text.Contains("destroyed") || h.Text.Contains("desert") || h.Text.Contains("Prize crews")).Reverse().Take(8).ToList();
    int fuelBurn = FleetSystem.FuelBillFor(w, house.Id, c.Fleets.FuelHullsPerUnit); var officeHulls = w.Fleets.Values.Where(f => f.Office && f.OwnerId == house.Id).Sum(f => f.Strength);
    var mil = m.Military; var nations = mil?.Nations ?? new List<NationCard>(); var warAbroad = nations.FirstOrDefault(n => n.AtWar); var away = m.Fleets.Where(f => f.Away.Length > 0).ToList();
    var abroadLines = w.History.Where(h => h.Text.Contains("Raiders of ") || h.Text.Contains("beyond the Reach") || h.Text.Contains("in the space of") || h.Text.Contains("in their own space") || h.Text.Contains("comes home from") || h.Text.Contains("sues for peace") || h.Text.Contains("is at war with") || h.Text.Contains("gutters out") || h.Text.Contains("is lost:") || h.Text.Contains("last tribute")).Reverse().Take(8).ToList();
    int maxStr = Math.Max(1, nations.Count == 0 ? 1 : nations.Max(n => Math.Max(n.Strength, n.FullStrength)));
    // the plot: every system on a flat chart, lanes, fronts, our supply, our fleets and the enemy's as reported
    var nodes = GalaxyProjection.Nodes(w); var lanes = GalaxyProjection.Lanes(w);
    double minX = nodes.Count == 0 ? 0 : nodes.Min(n => n.X), maxX = nodes.Count == 0 ? 1 : nodes.Max(n => n.X), minY = nodes.Count == 0 ? 0 : nodes.Min(n => n.Y), maxY = nodes.Count == 0 ? 1 : nodes.Max(n => n.Y);
    double PX(double x) => 24 + (maxX > minX ? (x - minX) / (maxX - minX) : .5) * 592; double PY(double y) => 24 + (maxY > minY ? (y - minY) / (maxY - minY) : .5) * 312;
    var byId = nodes.ToDictionary(n => n.SystemId); var enemies = w.EnemiesOf(house.Id).ToHashSet();
    bool Enemy(MapNode n) => n.OwnerHouseId != null && enemies.Contains(n.OwnerHouseId);
    string? campaign = FleetSystem.CampaignTarget(w, house.Id);
    var inSupply = w.Galaxy == null ? new HashSet<string>() : nodes.Where(n => fs.InSupply(w, house.Id, n.SystemId)).Select(n => n.SystemId).ToHashSet();
    int maxHulls = Math.Max(1, Math.Max(ours, rivals.Count == 0 ? 0 : rivals.Max(r => r.hulls)));
    string F(double v) => v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
    int raidersAtLarge = w.Fleets.Values.Where(f => f.OwnerId == PirateSystem.HouseId).Sum(f => f.Strength);
    // ---- the picture (docs/DASHBOARDS.md): how far everything is from what is ours, the nearest danger, the navies ranked,
    //      the fleets' condition, and one sentence that says how things stand
    var adj = new Dictionary<string, List<string>>();
    foreach (var l in lanes) { if (!adj.TryGetValue(l.A, out var la)) adj[l.A] = la = new(); la.Add(l.B); if (!adj.TryGetValue(l.B, out var lb)) adj[l.B] = lb = new(); lb.Add(l.A); }
    var jumps = new Dictionary<string, (int d, string from)>(); var queue = new Queue<string>();
    foreach (var n in nodes.Where(n => n.IsPlayerTerritory).OrderBy(n => n.SystemId, StringComparer.Ordinal)) { jumps[n.SystemId] = (0, n.Name); queue.Enqueue(n.SystemId); }
    while (queue.Count > 0) { var cur = queue.Dequeue(); var (d0, from0) = jumps[cur]; if (!adj.TryGetValue(cur, out var nb)) { continue; } foreach (var x in nb) { if (!jumps.ContainsKey(x)) { jumps[x] = (d0 + 1, from0); queue.Enqueue(x); } } }
    var focus = nodes.Where(n => jumps.TryGetValue(n.SystemId, out var jf) && jf.d <= 3).ToList(); if (focus.Count < 4) { focus = nodes.ToList(); }
    var inFocus = focus.Select(n => n.SystemId).ToHashSet();
    if (focus.Count > 0)
    {
        double x0 = focus.Min(n => n.X), x1 = focus.Max(n => n.X), y0 = focus.Min(n => n.Y), y1 = focus.Max(n => n.Y); double dx = Math.Max(1e-6, x1 - x0), dy = Math.Max(1e-6, y1 - y0);
        if (dx / dy > 592.0 / 312.0) { double want = dx * 312.0 / 592.0; y0 -= (want - dy) / 2; y1 += (want - dy) / 2; } else { double want = dy * 592.0 / 312.0; x0 -= (want - dx) / 2; x1 += (want - dx) / 2; }   // keep the map's shape
        double padX = (x1 - x0) * 0.10, padY = (y1 - y0) * 0.12; minX = x0 - padX; maxX = x1 + padX; minY = y0 - padY; maxY = y1 + padY;
    }
    string Who(MapFleet f) => f.IsPlayer ? f.Name : f.OwnerHouseId == PirateSystem.HouseId ? "Raiders" : f.OwnerHouseName;
    bool Hostile(MapFleet f) => f.OwnerHouseId == PirateSystem.HouseId || enemies.Contains(f.OwnerHouseId);
    int RegardOf(string houseId) => w.House(houseId) is { } oh && Economy.HeadOf(w, oh) is { } ohead ? w.GetRelationship(ohead.Id, pid)?.Disposition ?? 0 : 0;
    var near = mapFleets.Where(f => !f.IsPlayer && jumps.TryGetValue(f.SystemId, out var j) && j.d <= 3)
        .Select(f => (f, j: jumps[f.SystemId], hostile: Hostile(f))).OrderByDescending(x => x.hostile).ThenBy(x => x.j.d).ThenByDescending(x => x.f.Strength).ThenBy(x => x.f.FleetId, StringComparer.Ordinal).ToList();
    var danger = near.FirstOrDefault(x => x.hostile); bool anyDanger = danger.f != null;
    var nearIds = near.Select(x => x.f.FleetId).ToHashSet();
    var fleetsOf = w.Houses.Values.Where(h => h.Id != PirateSystem.HouseId).Select(h => (id: h.Id, name: h.Name, accent: h.AccentColor, hulls: FleetSystem.StrengthOf(w, h.Id), mine: h.Id == house.Id)).Where(x => x.hulls > 0 || x.mine)
        .OrderByDescending(x => x.hulls).ThenByDescending(x => x.mine).ThenBy(x => x.id, StringComparer.Ordinal).ToList();
    int navyRank = 1 + fleetsOf.Count(r => r.hulls > ours), navies = fleetsOf.Count; int strongest = fleetsOf.Count == 0 ? ours : Math.Max(ours, fleetsOf[0].hulls);
    int avgReady = m.Fleets.Count == 0 ? 0 : (int)m.Fleets.Average(f => f.Readiness), avgLoyal = m.Fleets.Count == 0 ? 0 : (int)m.Fleets.Average(f => f.Loyalty), avgSupply = m.Fleets.Count == 0 ? 0 : (int)m.Fleets.Average(f => f.Supply);
    bool dry = w.HasFlag("fuel_short"); int he3 = house.Treasury.Helium3; int fuelYears = fuelBurn > 0 ? he3 / fuelBurn : 99;
    int net = m.Ledger?.Net.Credits ?? 0; int gross = Math.Max(1, net + upkeep); int upkeepPct = Math.Clamp(100 * upkeep / gross, 0, 100);
    var firstBattle = mil?.Brief.FirstOrDefault(); int odds = firstBattle == null ? 0 : (int)Math.Round(100 * firstBattle.OurPower / Math.Max(0.01, firstBattle.OurPower + firstBattle.TheirPower));
    var coldest = w.Houses.Values.Where(h => h.Id != house.Id && h.Id != PirateSystem.HouseId && Economy.HeadOf(w, h) != null).OrderBy(h => RegardOf(h.Id)).ThenBy(h => h.Id, StringComparer.Ordinal).FirstOrDefault();
    string story, storyTone;
    if (m.Fleets.Count == 0) { story = "No hull flies your colours. Lay one down at a world with a shipyard, on the House screen."; storyTone = "warn"; }
    else if (firstBattle != null)
    {
        story = $"Battle at {firstBattle.SystemName} at the year's end against {firstBattle.EnemyName}: your {firstBattle.OurHulls} hull(s) against {firstBattle.EnemyHulls} as reported, odds {odds} in a hundred." + (firstBattle.Edge < 0 ? " Their stance has the edge of yours: change it below." : "");
        storyTone = odds >= 50 ? "warn" : "bad";
    }
    else if (dry) { story = "Your fleets cannot sail. The tanks are dry, and readiness falls fifteen a year until helium-3 is found: buy it on the Exchange, or hold a world that skims it."; storyTone = "bad"; }
    else if (m.Wars.Count > 0)
    {
        var war0 = m.Wars[0]; var wr0 = w.Wars.First(x => x.Between(house.Id, war0.EnemyHouseId)); int sa = wr0.Score(house.Id), sb = wr0.Score(war0.EnemyHouseId);
        story = $"At war with {war0.EnemyName} since year {war0.Since}. The score stands {sa} to {sb}; they have about {war0.EnemyHulls} hull(s) to your {ours}." + (war0.TheyAreSuing ? " They are suing for peace." : "") + (m.Wars.Count > 1 ? $" And {m.Wars.Count - 1} other war(s)." : "");
        storyTone = sa >= sb ? "warn" : "bad";
    }
    else if (anyDanger && danger.j.d <= 2) { story = $"{Who(danger.f!)}: {danger.f!.Strength} hull(s) {JumpWord(danger.j.d)} {danger.j.from}. You have {ours}."; storyTone = "warn"; }
    else { story = $"At peace. Your {ours} hull(s) make the {Ordinal(navyRank)} navy of {navies}" + (anyDanger ? $"; the nearest hostile sail is {danger.j.d} jumps off." : "; nothing hostile sails within three jumps of your worlds."); storyTone = "good"; }
    if (!dry && m.Fleets.Count > 0 && firstBattle == null && (avgLoyal < 40 || avgSupply < 50 || avgReady < 50)) { story += avgLoyal < 40 ? " The crews are wavering." : avgSupply < 50 ? " The fleets are short of supply." : " The fleets are not ready to fight."; }
    string condition = m.Fleets.Count == 0 ? "No fleet" : avgLoyal < 30 ? "Will not sail" : avgSupply < 40 ? "Short of supply" : avgReady < 50 ? "Not ready" : avgLoyal < 50 ? "Wavering" : "Ready";
    string conditionTone = condition == "Ready" ? "good" : condition is "Wavering" or "Not ready" ? "warn" : "bad";
    var conditionBars = new List<(string name, int pct, bool low)> { ("ready", avgReady, avgReady < 50), ("loyal", avgLoyal, avgLoyal < 30), ("supply", avgSupply, avgSupply < 40) };
    string StatusOf(FleetLine f) => f.Away.Length > 0 ? "beyond the Reach" : f.Loyalty < 30 ? "will not sail" : dry ? "cannot sail" : f.Moving ? $"under way · {f.Eta} jump(s)" : f.Supply < 40 ? "short of supply" : f.Readiness < 50 ? "not ready" : "ready";
    string StatusTone(FleetLine f) => f.Away.Length > 0 || f.Moving ? "" : f.Loyalty < 30 || dry ? "bad" : f.Supply < 40 || f.Readiness < 50 ? "warn" : "good";
}
<div class="dash deck" style="--accent:@m.HouseAccent">
    <header class="dash-head picture">
        <div class="dh-title"><Icon Name="military" Size="18" /> <b>The Command Deck</b></div>
        <div class="headline @storyTone">@story</div>
        <div class="tiles">
            <Tile Label="Strength" Value="@(ours + (ours == 1 ? " hull" : " hulls"))" Share="@(100 * ours / Math.Max(1, strongest))" Tone="@(navies > 1 && navyRank * 2 > navies ? "warn" : "")"
                  Note="@($"{Ordinal(navyRank)} of {navies} navies · the strongest has {strongest}")" Title="@("Hulls in every house's navy. " + (officeHulls > 0 ? officeHulls + " of yours are office hulls the chair pays for." : ""))" />
            <Tile Label="Condition" Value="@condition" Tone="@conditionTone" Bars="@(m.Fleets.Count == 0 ? null : conditionBars)" Note="@(m.Fleets.Count == 1 ? "one fleet" : m.Fleets.Count + " fleets")"
                  Title="Readiness under 50 fights badly. Loyalty under 30 will not sail, under 15 deserts. Supply under 40 fights at four-fifths." />
            <Tile Label="Helium-3" Value="@(dry ? "Dry" : fuelBurn == 0 ? he3.ToString() : fuelYears + (fuelYears == 1 ? " year" : " years"))" Tone="@(dry ? "bad" : fuelBurn > 0 && fuelYears < 3 ? "warn" : "good")"
                  Note="@(dry ? "no fleet may sail" : fuelBurn == 0 ? "nothing is burning it" : $"{he3} in the tanks · {fuelBurn} burned a year")" Title="Fleets burn helium-3 every year. With none, readiness falls and nothing sails." />
            <Tile Label="Upkeep" Value="@(upkeep + " a year")" Share="@upkeepPct" Tone="@(net < 0 ? "bad" : upkeepPct > 50 ? "warn" : "")"
                  Note="@((upkeep > gross ? $"more than the {gross} the house takes in before it" : $"{upkeepPct}% of the {gross} the house takes in before it") + (net < 0 ? " · the house is losing money" : ""))" Title="What the fleets cost in credits each year, against the house's income before they are paid." />
            <Tile Label="Nearest danger" Value="@(anyDanger ? danger.f!.Strength + (danger.f!.Strength == 1 ? " hull" : " hulls") : "None near")" Tone="@(!anyDanger ? "good" : danger.j.d <= 1 ? "bad" : "warn")"
                  Note="@(anyDanger ? $"{Who(danger.f!)} · {JumpWord(danger.j.d)} {danger.j.from}" : "nothing hostile within three jumps")" Title="The nearest fleet of raiders or of a house you are at war with, counted in jumps from the nearest world of yours." />
            <Tile Label="Wars" Value="@(m.Wars.Count == 0 ? "Peace" : m.Wars.Count == 1 ? m.Wars[0].EnemyName : m.Wars.Count + " wars")" Tone="@(m.Wars.Count == 0 ? "good" : "bad")"
                  Note="@(m.Wars.Count > 0 ? string.Join(" · ", m.Wars.Take(2).Select(x => { var wr = w.Wars.First(q => q.Between(house.Id, x.EnemyHouseId)); return $"{wr.Score(house.Id)} to {wr.Score(x.EnemyHouseId)}"; })) : coldest != null ? $"{coldest.Name} thinks worst of you ({RegardOf(coldest.Id):+0;-0;0})" : "nobody to fight")"
                  Title="The wars your house is in and how each stands. At peace, the house whose head thinks worst of yours." />
        </div>
    </header>

    <div class="ex-tabs">
        <button class="rung @(_view == "deck" ? "here" : "")" @onclick='() => _view = "deck"'>The deck</button>
        <button class="rung @(_view == "general" ? "here" : "")" @onclick='() => _view = "general"'>The general and the Senate</button>
        @if (nations.Count > 0) { <button class="rung @(_view == "abroad" ? "here" : "") @(warAbroad != null ? "warn" : "")" @onclick='() => _view = "abroad"'>Beyond the Reach · @(warAbroad != null ? "war with " + warAbroad.Name : nations.Count + " nations")</button> }
    </div>

    @if (_view == "general") { <div class="dash-grid deck-one"><div class="deck-col"><CaesarPanel /></div></div> }
    else if (_view == "abroad")
    {
        <div class="dash-grid deck-one"><div class="deck-col">
            @if (nations.Count > 0)
            {
                <section class="panel abroad">
                    <h3><Icon Name="galaxy" Size="13" /> Beyond the Reach <span class="muted">each nation comes through its march on the rim · the Senate makes war; houses send fleets</span></h3>
                    @if (warAbroad != null)
                    {
                        int tot = Math.Max(1, warAbroad.ScoreReach + warAbroad.ScoreNation);
                        <div class="war abroad-war"><div><b>War with @warAbroad.Name</b> <span class="muted">since turn @warAbroad.WarSince · @(warAbroad.OnMap ? "fought on the map" : warAbroad.Expeditions + " fleet(s) of the Reach in their space") · they hold @warAbroad.Strength hull(s)</span></div>
                            <div class="tally"><span class="for" style="width:@(100 * warAbroad.ScoreReach / tot)%"></span><span class="against" style="width:@(100 * warAbroad.ScoreNation / tot)%"></span></div>
                            <div class="kv"><span>The tally</span><b>@warAbroad.ScoreReach : @warAbroad.ScoreNation <i class="muted">· @warAbroad.Threshold clear subdues them; @warAbroad.Threshold the other way and the chair buys peace</i></b></div>
                            @if (warAbroad.OnMap) { <div class="muted small">Every house of the Reach is at war with them. Sail to their worlds by the lanes. Their host beaten counts two; a world of the Reach freed, or one of theirs taken, three; their capital, @warAbroad.Capital, ends it. A squadron of the Reach beaten counts one for them and a world occupied three. The house that does most takes the triumph.</div> }
                            else { <div class="muted small">Each victory abroad brings @warAbroad.Wealth credits of plunder home and a point of valour to a commander at the front; the house whose fleets win most takes the triumph.</div> }</div>
                    }
                    @foreach (var n in nations)
                    {
                        <div class="nation @(n.AtWar ? "war" : n.SubduedUntil > 0 ? "tributary" : "")" title="@n.Description">
                            <div class="nrow"><b>@n.Name</b> <span class="muted small">@n.Temper · holds @n.Holds</span> @if (n.Fallen) { <span class="pill small">no more</span> } else if (n.OnMap) { <span class="pill small good" title="This nation holds worlds on the map, beyond its march. Its fleets move by the lanes and fight by the ordinary rules; a war with it is every house's war.">on the map</span> }</div>
                            @if (n.Ruler.Length > 0) { <div class="nrow small" title="The one who rules it leans on its regard for the Reach: the warlike sour it, the wary raid only in a real quarrel, the grasping raid for twice the cargo, the mild sweeten it. Rulers die and are followed, sometimes by the commander of the fleets. Every point of the commander's skill over four makes its fleets fight six in a hundred harder, and every point under, as much less; a commander who beats you learns from it, and one who is routed may be killed."><span><b>@n.Ruler</b>, @n.RulerNature by nature</span><span class="muted"> · the fleets under <b>@n.Commander</b>, skill @n.CommanderSkill of 9</span></div> }
                            @if (n.Marches.Length > 0) { <div class="nrow small" title="Its raids come through these systems and fall on worlds within two lanes of them. A fleet of three hulls or more standing at the march turns a raid back before it lands. An expedition's voyage is the nation's depth beyond the march, and a year for every three lanes between the fleet and the march."><span class="muted">Its march:</span> <b>@n.Marches</b>@if (!n.OnMap) { <span class="muted"> · @(n.Nearest) year(s) out from your nearest fleet</span> }@if (n.Guard.Length > 0) { <span class="pill small good">held by @n.Guard</span> } else { <span class="pill small">unguarded</span> }</div> }
                            @if (n.OnMap && !n.Fallen)
                            {
                                <div class="nrow small" title="Taking the world its ruler sits at ends a war with it. A world of its own held by a house of the Reach rises again after @n.HoldYears years without a fleet of three hulls over it, unless the nation is paying tribute."><span class="muted">Sits at</span> <b>@n.Capital</b><span class="muted"> · holds</span> @n.Worlds</div>
                                @if (n.Manner.Length > 0) { <div class="nrow small muted">@n.Manner</div> }
                                @if (n.Fleets.Length > 0) { <div class="nrow small" title="The guard stays with the ruler. The host comes through the march when there is war, takes one world, and goes home with it; it stays home when it is short of supply or not rested."><span class="muted">Its fleets:</span> @n.Fleets</div> }
                                @if (n.Occupied.Length > 0) { <div class="nrow small warn" title="Held until a house of the Reach frees it or the peace is made. If the Reach wins the war it goes home; if not, it is ceded."><span class="muted">Holds of the Reach's:</span> <b>@n.Occupied</b></div> }
                                @if (n.Ransom.Length > 0) { <div class="nrow small good" title="A report asks you each year the offer stands: take the money and the world goes home, or keep it."><span class="muted">It offers</span> <b>@n.Ransom</b></div> }
                                @if (n.Watch.Length > 0) { <div class="nrow small @(n.Watch.StartsWith("not") ? "warn" : "")" title="It pays while a fleet of the Reach of three hulls or more stands at its march or over one of its worlds."><span class="muted">Tribute:</span> @n.Watch</div> }
                                @if (n.Lost.Length > 0) { <div class="nrow small" title="Easy to take, hard to hold: without a fleet over it, it rises."><span class="muted">Of its own, in the Reach's hands:</span> @n.Lost</div> }
                            }
                            <div class="nrow"><span class="muted small">strength</span><span class="mbar"><i style="width:@(100 * n.Strength / maxStr)%; background:@(n.AtWar ? "#E63946" : n.SubduedUntil > 0 ? "#2EC27E" : "#C9D1DC")"></i></span><b>@n.Strength</b>
                                <span class="pill small @(n.Disposition <= -30 ? "warn" : n.Disposition >= 20 ? "good" : "")" title="their regard for the Reach">@(n.Disposition >= 0 ? "+" : "")@n.Disposition</span>
                                @if (n.AtWar) { <span class="pill small warn">at war</span> } else if (n.SubduedUntil > 0) { <span class="pill small good">pays @n.Tribute/turn until T@(n.SubduedUntil)</span> } @if (n.RaidedLately) { <span class="pill small warn">raiding the rim</span> }@if (n.Wars > 0 && !n.AtWar) { <span class="pill small">@n.Wars war(s) fought</span> }
                                @if (!n.AtWar && n.SubduedUntil == 0 && !n.Fallen) { <button class="opt inline tiny" disabled="@(n.War.Refusal != null)" title="@(n.War.Refusal ?? "move in the Senate that the Reach make war upon them (3 influence)")" @onclick="() => MoveWar(n.Id)">@n.War.Label</button> }</div>
                        </div>
                    }
                    @if (abroadLines.Count > 0) { <h4>Word from beyond</h4> @foreach (var h in abroadLines) { <div class="line small"><span class="muted">T@(h.Turn)</span> @h.Text</div> } }
                </section>
            }
        </div></div>
    }
    else
    {
    <div class="dash-grid deck2-grid">
        <div class="deck-col">
        <section class="panel">
            <h3><Icon Name="galaxy" Size="13" /> The plot <span class="muted">where yours are, and what is near them</span></h3>
            <svg class="plot" viewBox="0 0 640 360" role="img" aria-label="the war plot">
                @foreach (var l in lanes)
                {
                    if (!byId.TryGetValue(l.A, out var a) || !byId.TryGetValue(l.B, out var b)) { continue; }
                    if (!inFocus.Contains(l.A) && !inFocus.Contains(l.B)) { continue; }
                    bool front = (a.IsPlayerTerritory && Enemy(b)) || (b.IsPlayerTerritory && Enemy(a));
                    bool ourLane = a.IsPlayerTerritory || b.IsPlayerTerritory;
                    <line x1="@F(PX(a.X))" y1="@F(PY(a.Y))" x2="@F(PX(b.X))" y2="@F(PY(b.Y))" class="lane @(front ? "front" : ourLane ? "ours" : "")" />
                }
                @foreach (var n in nodes.Where(n => inFocus.Contains(n.SystemId)))
                {
                    bool mine = n.IsPlayerTerritory; bool enemy = Enemy(n);
                    @if (inSupply.Contains(n.SystemId)) { <circle cx="@F(PX(n.X))" cy="@F(PY(n.Y))" r="24" class="supply" /> }
                    @if (campaign == n.SystemId) { <circle cx="@F(PX(n.X))" cy="@F(PY(n.Y))" r="18" class="campaign" /> }
                    <circle cx="@F(PX(n.X))" cy="@F(PY(n.Y))" r="@(mine ? 10 : enemy || n.Capital ? 8 : n.OwnerHouseId != null ? 5.5 : 3.5)" class="node @(mine ? "mine" : "") @(enemy ? "enemy" : "") @(!mine && !enemy && !n.Capital ? "far" : "")" style="fill:@(n.OwnerHouseId != null ? n.AccentColor : "#3a4152")"><title>@n.Name@(n.OwnerHouseName != null ? $" · {n.OwnerHouseName}" : " · unclaimed")@(jumps.TryGetValue(n.SystemId, out var jn) && jn.d > 0 ? $" · {jn.d} jump(s) from {jn.from}" : "")</title></circle>
                    @((MarkupString)$"<text x=\"{F(PX(n.X))}\" y=\"{F(PY(n.Y) - (mine ? 17 : 12))}\" class=\"nlabel {(mine ? "mine" : enemy ? "enemy" : n.Capital ? "" : "far")}\">{System.Net.WebUtility.HtmlEncode(n.Name)}{(n.Capital && !mine ? " · the capital" : "")}</text>")
                }
                @foreach (var f in mapFleets.Where(f => byId.ContainsKey(f.SystemId) && inFocus.Contains(f.SystemId)))
                {
                    var n = byId[f.SystemId]; bool hostile = Hostile(f); bool shown = true;
                    double x = PX(n.X) + (f.IsPlayer ? -17 : 17), y = PY(n.Y) + 15; string who = Who(f).Replace("House ", "");
                    <g class="fleet @(f.IsPlayer ? "mine" : hostile ? "enemy" : shown ? "other" : "faint")" transform="translate(@F(x),@F(y))">
                        <path d="M0 -11 L10 0 L0 11 L-10 0 Z" style="fill:@(hostile ? "#c0392b" : f.AccentColor)" />@if (shown) { @((MarkupString)$"<text y=\"5\" class=\"fl\">{f.Strength}</text>") }
                        @if (shown) { @((MarkupString)$"<text y=\"23\" class=\"flabel {(f.IsPlayer ? "mine" : hostile ? "enemy" : "")}\">{System.Net.WebUtility.HtmlEncode(who)}</text>") }
                        <title>@f.Name · @f.OwnerHouseName · @f.Strength hull(s)@(f.IsPlayer ? "" : $" · confidence {f.Confidence}%")@(f.Moving ? $" · under way, {f.Eta} jump(s)" : "")</title>
                    </g>
                }
            </svg>
            <div class="plot-legend">
                <span><i class="lg node mine"></i> your worlds</span><span><i class="lg supply"></i> in supply</span><span><i class="lg fleet mine"></i> your fleets, with hulls</span>
                <span><i class="lg fleet enemy"></i> hostile</span><span><i class="lg fleet other"></i> other houses' fleets</span><span class="muted">drawn to three jumps from your worlds</span>@if (enemies.Count > 0) { <span><i class="lg front"></i> a front</span> }
            </div>
        </section>
        <section class="panel">
            <h3><Icon Name="fleet" Size="13" /> What is near your worlds <span class="muted">every fleet within three jumps, hostile first</span></h3>
            @if (near.Count == 0) { <div class="muted small">Nothing sails within three jumps of your worlds. Your captains report other houses' fleets here as they come near.</div> }
            else
            {
                <table class="near">
                    <thead><tr><th>Whose</th><th class="num">Hulls</th><th>At</th><th>From yours</th><th>To you</th></tr></thead>
                    <tbody>
                        @foreach (var x in near.Take(8))
                        {
                            bool raider = x.f.OwnerHouseId == PirateSystem.HouseId; int regard = raider ? 0 : RegardOf(x.f.OwnerHouseId);
                            string toYou = raider ? "raiders" : x.hostile ? "at war" : regard <= -30 ? $"ill disposed ({regard})" : regard >= 30 ? $"well disposed (+{regard})" : $"neutral ({regard:+0;-0;0})";
                            <tr class="@(x.hostile ? "hostile" : "")" title="@x.f.Name · confidence @(x.f.Confidence)%">
                                <td>@if (!raider) { <Sigil HouseId="@x.f.OwnerHouseId" Accent="@x.f.AccentColor" Size="13" /> } @(raider ? "Raiders" : x.f.OwnerHouseName)</td>
                                <td class="num">@(x.f.Confidence < 100 ? "~" : "")@x.f.Strength <i class="vs @(x.f.Strength > ours ? "bad" : "")">@(x.f.Strength > ours ? "more than yours" : x.f.Strength == ours ? "as many as yours" : "")</i></td>
                                <td>@(byId.TryGetValue(x.f.SystemId, out var at) ? at.Name : x.f.SystemId)@(x.f.Moving ? " · under way" : "")</td>
                                <td>@JumpWord(x.j.d) @x.j.from</td>
                                <td class="@(x.hostile || regard <= -30 ? "bad" : regard >= 30 ? "good" : "muted")">@toYou</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (near.Count > 8) { <div class="muted small">And @(near.Count - 8) more.</div> }
            }
        </section>
        @if (battles.Count > 0)
        {
            <section class="panel">
                <h3><Icon Name="report" Size="13" /> Dispatches <span class="muted">the last battles</span></h3>
                @foreach (var h in battles.Take(5)) { <div class="line small"><span class="muted">Year @(h.Turn)</span> @h.Text</div> }
            </section>
        }
        </div>

        <div class="deck-col">
        <section class="panel">
            <h3><Icon Name="fleet" Size="13" /> Your fleets <span class="muted">movement is ordered on the Galaxy map</span></h3>
            @if (mil != null)
            {
                <div class="brief">
                    @foreach (var b in mil.Brief)
                    {
                        <div class="line battle @(b.OurPower >= b.TheirPower ? "" : "warn")"><b>Battle at @b.SystemName at the turn's end</b> — @b.EnemyName, @b.EnemyHulls hull(s) as reported (@b.Confidence%) against our @b.OurHulls.
                            Our @b.OurStance against their @b.TheirStance: @(b.Edge > 0 ? "the edge is ours" : b.Edge < 0 ? "the edge is theirs — change the stance" : "no edge either way").
                            <span class="odds">Odds @((int)Math.Round(100 * b.OurPower / Math.Max(0.01, b.OurPower + b.TheirPower)))%</span></div>
                    }
                    <div class="row small"><span class="muted">You command from</span>@foreach (var o in mil.MyStyleOptions) { <button class="opt inline tiny @(mil.MyStyle == o.Id ? "here" : "")" disabled="@(o.Refusal != null && o.Refusal != "already so")" title="@(o.Refusal ?? StyleHelp(o.Id))" @onclick="() => G.Execute(new SetCommandStyleCommand(pid, pid, o.Id))">@(o.Id == "none" ? "the staff" : "the " + o.Label)</button> }
                        <span class="muted">· @mil.MyCap hull(s) without strain@(mil.MyValour > 0 ? $" · valour {mil.MyValour}" : "")</span></div>
                </div>
            }
            @if (officeHulls > 0) { <div class="kv good"><span>The Admiralty</span><b>@officeHulls office hull(s) sail under your colours · the chair pays their upkeep and the state fuels them · war on the chair is treason</b></div> }
            @foreach (var f in m.Fleets)
            {
                var fleet = w.Fleets[f.Id];
                <div class="fcard @(f.Loyalty < 30 || f.Supply < 40 ? "warn" : "")">
                    <div class="hc-head"><Icon Name="fleet" Size="18" /><div><b>@f.Name</b> <span class="pill small status @StatusTone(f)">@StatusOf(f)</span> <span class="muted small">@f.Composition · @(f.Away.Length > 0 ? $"beyond the Reach · against {f.AwayName} · {AwayWord(f.AwayPhase)} ({f.AwayTurns})" : f.Moving ? $"→ {f.Destination} ({f.Eta})" : f.Where)@(f.Office ? " · held by office" : "")</span></div></div>
                    @if (f.Away.Length > 0) { <div class="kv good"><span>Expedition</span><b>@f.ExpeditionWins victor@(f.ExpeditionWins == 1 ? "y" : "ies")@(f.Plunder > 0 ? $" · {f.Plunder} credits of plunder aboard" : "") · @(f.AwayPhase == "fighting" ? "fighting in their space" : f.AwayPhase == "home" ? "sailing home" : "outward bound")</b></div> }
                    <div class="gauges">
                        <div class="gauge" title="readiness"><span>Readiness</span><i><b style="width:@f.Readiness%" class="@(f.Readiness < 50 ? "low" : "")"></b></i><em>@f.Readiness</em></div>
                        <div class="gauge" title="the crews' loyalty: under 30 they will not sail, under 15 they desert"><span>Loyalty</span><i><b style="width:@f.Loyalty%" class="@(f.Loyalty < 30 ? "low" : "")"></b></i><em>@f.Loyalty</em></div>
                        <div class="gauge" title="supply: under 40 the fleet fights at four-fifths; at nought hulls desert"><span>Supply</span><i><b style="width:@f.Supply%" class="@(f.Supply < 40 ? "low" : "")"></b></i><em>@f.Supply</em></div>
                    </div>
                    <div class="ships">@foreach (var (cls, n) in fs.Composition(fleet)) { <span class="pill" title="atk @cls.Attack / def @cls.Defense"><Icon Name="@(Icons.Paths.ContainsKey(cls.Id) ? cls.Id : "fleet")" Size="12" /> @n × @cls.Name</span> }@if (f.Veterancy > 0) { <span class="pill">veterancy @f.Veterancy</span> }</div>
                    <div class="kv"><span>Admiral</span><b>@(f.AdmiralName ?? "no admiral")@(f.AdmiralName != null ? $" · {(f.AdmiralStyle == "front" ? "leads from the front" : f.AdmiralStyle == "flag" ? "commands from the flag" : "leaves the line to the captains")} · cap {f.Cap}" : "")@(f.Valour > 0 ? $" · valour {f.Valour}" : "")@(f.Achilles ? " · ACHILLES" : "")</b></div>
                    <details class="orders" open="@(m.Fleets.Count <= 2)"><summary>Orders</summary>
                    <div class="row small"><span class="muted">Stance</span>@if (f.StanceOptions != null) { foreach (var o in f.StanceOptions) { <button class="opt inline tiny @(f.Stance == o.Id ? "here" : "")" disabled="@(o.Refusal != null && o.Refusal != "already so")" title="@(o.Refusal ?? StanceHelp(o.Id))" @onclick="() => G.Execute(new SetStanceCommand(pid, f.Id, o.Id))">@o.Label</button> } }</div>
                    <div class="row small"><span class="muted">Loadout</span>@if (f.LoadoutOptions != null) { foreach (var o in f.LoadoutOptions) { <button class="opt inline tiny @(f.Loadout == o.Id ? "here" : "")" disabled="@(o.Refusal != null && o.Refusal != "already so")" title="@(o.Refusal ?? (o.Id == "torpedoes" ? "a quarter more power; burns an isotope a battle" : "the guns"))" @onclick="() => G.Execute(new SetLoadoutCommand(pid, f.Id, o.Id))">@o.Label</button> } }</div>
                    @if (f.StyleOptions != null && f.AdmiralId != null) { <div class="row small"><span class="muted">Commands from</span>@foreach (var o in f.StyleOptions) { <button class="opt inline tiny @(f.AdmiralStyle == o.Id ? "here" : "")" disabled="@(o.Refusal != null && o.Refusal != "already so")" title="@(o.Refusal ?? StyleHelp(o.Id))" @onclick="() => G.Execute(new SetCommandStyleCommand(pid, f.AdmiralId, o.Id))">@(o.Id == "none" ? "the staff" : "the " + o.Label)</button> }</div> }
                    <div class="row small">
                        @if (f.Expedition != null) { <button class="opt inline tiny" disabled="@(f.Expedition.Refusal != null)" title="@(f.Expedition.Refusal ?? "1 treasury action: the fleet leaves the map, sails the nation's distance, fights a season of four battles and comes home with plunder, valour and fewer hulls")" @onclick="() => G.Execute(new SendExpeditionCommand(pid, f.Id, f.Expedition.Id, c.Fleets, c.Nations))">@f.Expedition.Label</button> }
                        @if (f.Recall != null) { <button class="opt inline tiny" disabled="@(f.Recall.Refusal != null)" title="@(f.Recall.Refusal ?? "turn for home before the season is done")" @onclick="() => G.Execute(new RecallExpeditionCommand(pid, f.Id, c.Nations))">@f.Recall.Label</button> }
                        <button class="opt inline tiny" disabled="@(f.Refit.Refusal != null)" title="@f.Refit.Refusal" @onclick="() => G.Execute(new RefitFleetCommand(pid, f.Id))">@f.Refit.Label</button>
                        <details class="inline"><summary>Command</summary>@foreach (var o in f.AdmiralOptions) { <button class="opt" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new AssignAdmiralCommand(pid, f.Id, o.Id))">@o.Label</button> }</details>
                        @if (f.MergeOptions.Count > 0) { <details class="inline"><summary>Merge</summary>@foreach (var o in f.MergeOptions) { <button class="opt" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new MergeFleetsCommand(pid, f.Id, o.Id))">@o.Label</button> }</details> }
                    </div>
                    </details>
                </div>
            }
            @if (m.Fleets.Count == 0) { <div class="muted small">No hull flies your colours. A world with a shipyard can lay one down: House, then the world.</div> }
        </section>
        <section class="panel">
            <h3><Icon Name="houses" Size="13" /> The navies <span class="muted">every house with a hull, strongest first</span></h3>
            <table class="near navies">
                <thead><tr><th></th><th>House</th><th>Hulls</th><th class="num"></th><th>To you</th></tr></thead>
                <tbody>
                    @{ var board = fleetsOf; int place = 0; int myPlace = board.FindIndex(x => x.mine); var shownBoard = _allNavies ? board : board.Take(6).ToList(); if (!_allNavies && myPlace >= 6) { shownBoard = board.Take(5).Append(board[myPlace]).ToList(); } }
                    @foreach (var r in shownBoard)
                    {
                        place = board.IndexOf(r) + 1; bool war = !r.mine && w.AtWar(house.Id, r.id); int regard = r.mine ? 0 : RegardOf(r.id);
                        <tr class="@(r.mine ? "mine" : war ? "hostile" : "")">
                            <td class="muted">@place</td>
                            <td><Sigil HouseId="@r.id" Accent="@r.accent" Size="13" /> @r.name</td>
                            <td><span class="hbar"><i style="width:@(100 * r.hulls / Math.Max(1, strongest))%; background:@r.accent"></i></span></td>
                            <td class="num">@r.hulls</td>
                            <td class="@(war || regard <= -30 ? "bad" : regard >= 30 ? "good" : "muted")">@(r.mine ? "yours" : war ? "at war" : $"{regard:+0;-0;0}")</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (board.Count > 6) { <button class="opt inline tiny" @onclick="() => _allNavies = !_allNavies">@(_allNavies ? "Show fewer" : $"Show all {board.Count}")</button> }
            @if (raidersAtLarge > 0) { <div class="small bad">Raiders on the lanes: @raidersAtLarge hull(s) in all.</div> }
        </section>
            <section class="panel">
                <h3><Icon Name="war" Size="13" /> Wars</h3>
                @foreach (var war in m.Wars)
                {
                    var wr = w.Wars.First(x => x.Between(house.Id, war.EnemyHouseId)); var eh = w.House(war.EnemyHouseId); int a = wr.Score(house.Id), b = wr.Score(war.EnemyHouseId); int tot = Math.Max(1, a + b);
                    <div class="war"><div><Sigil HouseId="@war.EnemyHouseId" Accent="@(eh?.AccentColor ?? "#888")" Size="16" /> <b>@war.EnemyName</b> <span class="muted">since turn @war.Since · their hulls ~@war.EnemyHulls@(war.TheyAreSuing ? " · they sue for peace" : "")</span></div>
                        <div class="tally"><span class="for" style="width:@(100 * a / tot)%"></span><span class="against" style="width:@(100 * b / tot)%"></span></div>
                        <div class="kv"><span>War score</span><b>@a : @b</b></div>
                        <button class="opt" disabled="@(!war.PeaceAvailable)" title="@war.PeaceTooltip" @onclick="() => G.Execute(new SueForPeaceCommand(pid, war.EnemyHouseId, c.Fleets))">Sue for peace (1 influence)</button></div>
                }
                @if (m.Wars.Count == 0) { <div class="muted small">No war. A house declares one on the Houses screen; the Senate makes war beyond the Reach.</div> }
                @foreach (var sg in m.Sieges) { <div class="line @(sg.Ours ? "warn" : "")"><Icon Name="siege" Size="12" /> @sg.HoldingName under siege by @sg.BesiegerName · @sg.Turns/@sg.Required@(sg.Ours ? " — ours" : "")</div> }
            </section>
            @if (mil != null)
            {
                <section class="panel">
                    <h3><Icon Name="galaxy" Size="13" /> The campaign</h3>
                    @if (mil.Campaign.TargetName != null) { <div class="kv good"><span>Object</span><b>@mil.Campaign.TargetName · @mil.Campaign.TurnsLeft turn(s) more</b></div><div class="muted small">Fleets within two lanes of it fight at +10% and count as supplied.</div> }
                    else if (mil.Campaign.Targets.Count == 0) { <div class="muted small">No war, no campaign. A campaign names an enemy's world as the war's object for eight turns (@mil.Campaign.Cost influence).</div> }
                    else
                    {
                        <select class="sel" @onchange="SetCampaign">
                            <option value="">— name the war's object —</option>
                            @foreach (var t in mil.Campaign.Targets) { <option value="@t.Id">@t.Label</option> }
                        </select>
                        var pick = mil.Campaign.Targets.FirstOrDefault(t => t.Id == _campaign);
                        <button class="opt inline" disabled="@(pick == null || pick.Refusal != null)" title="@(pick?.Refusal ?? $"{mil.Campaign.Cost} influence")" @onclick="() => G.Execute(new DeclareCampaignCommand(pid, _campaign, c.Fleets))">Declare the campaign</button>
                    }
                </section>
            }
        </div>
    </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    private string _campaign = "", _view = "deck"; private bool _allNavies;
    private static string Ordinal(int n) => n % 100 is 11 or 12 or 13 ? n + "th" : (n % 10) switch { 1 => n + "st", 2 => n + "nd", 3 => n + "rd", _ => n + "th" };
    private static string JumpWord(int d) => d == 0 ? "at" : d == 1 ? "one jump from" : d + " jumps from";
    private void SetCampaign(ChangeEventArgs e) => _campaign = e.Value?.ToString() ?? "";
    private void MoveWar(string nationId) => G.Execute(new ProposeMotionCommand(G.World!.ProtagonistId, "foreign_war", nationId, G.Turn!.Senate));
    private static string AwayWord(string phase) => phase switch { "fighting" => "fighting", "home" => "homeward", _ => "outward" };
    private static string StanceHelp(string s) => s switch { "press" => "the charge: +15% power, more losses; beats the skirmish, beaten by the line", "skirmish" => "harass and evade: −10% power, far fewer losses; beats the line, beaten by the press", "boarding" => "the press with prize crews: on victory, 2 manpower take a hull per four the enemy lost", _ => "the line: steady; beats the press, beaten by the skirmish" };
    private static string StyleHelp(string s) => s switch { "front" => "+10% to this fleet, the crews' love, a point of valour a victory — and twice the risk of dying with the line", "flag" => "every fleet of the house +3% per point of tactics; never lost with the line; needs the rank of Commander", _ => "the captains fight the ships" };
}
