                    {
                        <div class="mf-drawer list">
                            <div class="mf-dh">Merge <span class="ui-info" title="@MergeHelp">i</span></div>
                            @foreach (var o in f.MergeOptions)
                            {
                                @* the fold keeps this fleet: the other is folded into it *@
                                <button class="mil-pick" data-merge-from="@o.Id" data-merge-into="@f.Id" disabled="@(o.Refusal != null)" title="@(o.Refusal != null ? Cap(o.Refusal) : MergeHelp)" @onclick="() => G.Execute(new MergeFleetsCommand(pid, o.Id, f.Id))">@Token(m.HouseAccent, false)<span>@o.Label</span></button>
                            }
                        </div>
                    }
                    </div>
                </div>
            }
            </ChildContent>
        </Section>
        @if (m.Wars.Count > 0 || m.Sieges.Count > 0 || nations.Any(n => n.AtWar))
        {
            <Section Title="At war" Count="@((m.Wars.Count + nations.Count(n => n.AtWar)).ToString())" Info="A war's score: a battle won is 2 and a world taken 3. A peace may be offered at any time; what the other side will take depends on how the war stands. An envoy costs 1 influence.">
                @foreach (var war in m.Wars)
                {
                    var wr = w.Wars.First(x => x.Between(house.Id, war.EnemyHouseId)); var eh = w.House(war.EnemyHouseId); int a = wr.Score(house.Id), b = wr.Score(war.EnemyHouseId);
                    <div class="mil-warrow war">
                        <div class="mw-top">
                            <span class="mw-arms"><Sigil HouseId="@war.EnemyHouseId" Accent="@(eh?.AccentColor ?? "#888")" Size="26" /></span>
                            <div class="mw-id"><b>@war.EnemyName</b><span class="mw-sub">since year @war.Since · their hulls about @war.EnemyHulls@(war.TheyAreSuing ? " · they sue for peace" : war.TheyOfferTerms ? " · they have sent their terms" : "")</span></div>
                            <span class="mw-score" title="War score: yours, then theirs"><b>@a : @b</b><small>war score</small></span>
                        </div>
                        <Meter Kind="diverging" Value="@(a - b)" Max="@Math.Max(6, Math.Max(a, b))" Text="@Signed(a - b)" Label="The score" Tip="Your score against theirs: a battle won is 2, a world taken 3" />
                        <PeaceTerms War="war" />
                    </div>
                }
                @foreach (var nw in nations.Where(n => n.AtWar))
                {
                    int na = nw.ScoreReach, nb = nw.ScoreNation;
                    <div class="mil-warrow war" data-nation-war="@nw.Id">
                        <div class="mw-top">
                            <span class="mw-arms"><Icon Name="world" Tone="ember" Size="22" /></span>
                            <div class="mw-id"><b>@nw.Name</b><span class="mw-sub">a war beyond the Reach, since year @nw.WarSince@(nw.WhoseWar.Length > 0 ? " · " + nw.WhoseWar : "")</span></div>
                            <span class="mw-score"><b>@na : @nb</b><small>war score</small></span>
                        </div>
                        <div class="mf-row"><button class="ui-link" @onclick='() => _view = "abroad"'>Its orders and its peace, on Beyond<Icon Name="chev" Size="11" Class="flat" /></button></div>
                    </div>
                }
                @foreach (var sg in m.Sieges) { <div class="mil-line @(sg.Ours ? "warn" : "")"><Icon Name="siege" Tone="@(sg.Ours ? "ember" : "ivory")" Size="16" /><span><b>@sg.HoldingName</b> under siege by @sg.BesiegerName · @sg.Turns of @sg.Required years@(sg.Ours ? ", and it is ours" : "")</span></div> }
            </Section>
        }
        else
        {
            <EmptyState Icon="dove" Text="At peace: no war, no siege, no campaign. A house declares a war on the Houses window; the Senate makes war beyond the Reach." LinkLabel="Open Houses" OnLink='() => OnGo.InvokeAsync("houses")' Class="mil-peace" />
        }
        @if (mil != null && (mil.Campaign.TargetName != null || mil.Campaign.Targets.Count > 0))
        {
            <Section Title="The campaign" Info="An enemy's world named as the war's object for eight years. Fleets within two lanes of it fight at +10% and count as supplied.">
                @if (mil.Campaign.TargetName != null)
                {
                    <div class="mil-line good"><Icon Name="flag-objective" Tone="good" Size="18" /><span>The object: <b>@mil.Campaign.TargetName</b>, @Counted.Years(mil.Campaign.TurnsLeft) more. Fleets within two lanes of it fight at +10% and count as supplied.</span></div>
                }
                else
                {
                    var pick = mil.Campaign.Targets.FirstOrDefault(t => t.Id == _campaign);
                    <div class="mf-row mil-campaign">
                        <Select Options="@(mil.Campaign.Targets.Select(t => new Select.Option(t.Id, t.Label, t.Refusal != null ? Cap(t.Refusal) : "")).ToList())" Value="@_campaign" Placeholder="Name the war's object" OnChange="v => _campaign = v" Tip="The enemy's world the campaign is for" />
                        <Plate Label="Declare the campaign" Small="true" Icon="flag-objective" CostIcon="public-speaker" CostText="@mil.Campaign.Cost.ToString()" Locked="@(pick == null || pick.Refusal != null)" Disabled="@(pick == null || pick.Refusal != null)" ShowNeed="false"
                               Need="@(pick == null ? "Choose the system the campaign is for first" : Cap(pick.Refusal ?? ""))" Tip="@($"[flag-objective] Declare the campaign\n{mil.Campaign.Cost} influence of this year's")" OnClick="() => G.Execute(new DeclareCampaignCommand(pid, _campaign, c.Fleets))" />
                    </div>
                }
            </Section>
        }
    }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    private string _campaign = "", _view = "deck"; private bool _allNavies; private readonly Dictionary<string, string> _names = new();
    private readonly Dictionary<string, int> _hulls = new();
    /* a detachment: the class of hull chosen for each fleet (none is the lightest), and the fleets whose captain is to go with it */
    private readonly Dictionary<string, string> _classOf = new(); private readonly HashSet<string> _withCap = new();
    /* the one drawer open under each fleet: rename, admiral, captain, hulls, hire or merge */
    private readonly Dictionary<string, string> _drawer = new();
    private void Toggle(string fleetId, string what) { if (_drawer.GetValueOrDefault(fleetId) == what) _drawer.Remove(fleetId); else _drawer[fleetId] = what; _ordersFor = null; }   // the menu closes on what it opened, so it does not stand over the drawer
    private void Pick(string key) => _view = key;
    /* a fleet's row opens for its condition, people and orders: one that is in trouble (loyalty under 30, supply under 40) stands
       open until it is folded, the rest are folded until opened */
    private readonly Dictionary<string, bool> _fleetOpen = new();
    private bool FleetOpen(FleetLine f, int count) => _fleetOpen.TryGetValue(f.Id, out var o) ? o : f.Loyalty < 30 || f.Supply < 40;
    private void ToggleFleet(FleetLine f, int count) { _fleetOpen[f.Id] = !FleetOpen(f, count); if (!_fleetOpen[f.Id] && _ordersFor == f.Id) _ordersFor = null; }
    /// <summary>The fleet whose Orders menu is open.</summary>
    private string? _ordersFor;
    private void SendCaptain(string fleetId, bool on) { if (on) { _withCap.Add(fleetId); } else { _withCap.Remove(fleetId); } }
    private void Detach(DetachHullsCommand det, string fleetId) { G.Execute(det); _withCap.Remove(fleetId); }
    private static IReadOnlyList<Option> Opts(IReadOnlyList<Option>? o) => o ?? Array.Empty<Option>();
    private static string WarKey(Praetoria.Core.State.War wr) => wr.HouseA + "|" + wr.HouseB + "|" + wr.Since;
    private static readonly string CaptainHelp = $"A captain serves under the admiral: an officer of your house in the naval service, a Lieutenant or above. The captain's discipline adds a point of readiness a year at anchor (to {FleetSystem.CaptainDrillsMax}) and keeps back a point lost under way for every two (to {FleetSystem.CaptainHoldsMax}); their gunnery adds {FleetSystem.CaptainGunnery * 100:0}% a point in a fight (to {FleetSystem.CaptainGunneryMax * 100:0}%). With no admiral, or the admiral dead or wounded, the captain commands, and the fleet does not fight at 85 in a hundred. Nobody is admiral and captain at once, nor captain of two fleets. 1 agent.";
    private const string RelieveHelp = "The post is empty until you name another. It costs nothing.";
    private const string MergeHelp = "The other fleet's hulls join this one, which keeps its name, its admiral and its captain. If this one has no admiral or no captain it takes the other's.";
    private const string NoCaptainToSend = "This fleet has no captain to send with a detachment.";
    private const string SendCaptainHelp = "The captain goes with the detachment and commands it as its admiral. This fleet is then without a captain until you name one.";
    private static string DetachSays(string hulls, int n, string fleetName, string? captain, bool lightest) =>
        $"{hulls} {(n == 1 ? "stays" : "stay")} here as a squadron of {(n == 1 ? "its" : "their")} own, " + (captain != null ? $"under {captain}, who leaves the captaincy to command it" : "without an admiral until you name one") + $"; {fleetName} keeps the rest." + (lightest ? " The lightest hulls go." : "") + " It costs nothing.";
    /* hiring a fleet out costs the house its name: say all of it before it is done */
    private void AskHire(string fleetId, string employerId)
    {
        var w = G.World!; if (!w.Fleets.TryGetValue(fleetId, out var f) || w.House(employerId) is not { } em) return; string pid = w.ProtagonistId;
        G.Ask($"Hire {f.Name} out to {em.Name}?", MercenarySystem.Says(w, f, em), "Hire it out", () => G.Execute(new HireOutFleetCommand(pid, fleetId, employerId)));
    }
    private void AskRecallHired(string fleetId, string fleetName, string employerName)
    {
        string pid = G.World!.ProtagonistId;
        G.Ask($"Call {fleetName} back from {employerName}?", $"The contract is broken: {employerName}'s head thinks {MercenarySystem.BreakRegard} the worse of you, and your house is thought the less of (legitimacy −{MercenarySystem.BreakLegitimacy}). The company is yours again at once and sails for home.", "Call it back", () => G.Execute(new RecallHiredFleetCommand(pid, fleetId)));
    }
    private static string SavedSays(Praetoria.Core.State.Resources r)
    { var parts = Praetoria.Core.State.Resource.All.Where(k => r.Get(k) != 0).Select(k => Money.Of(k, r.Get(k)) + " " + Praetoria.Core.State.Resource.Label(k)).ToList(); return parts.Count == 0 ? "nothing" : string.Join(" and ", parts); }
    [Parameter] public EventCallback<string> OnGo { get; set; }
    [Parameter] public string Tab { get; set; } = "";
    [Parameter] public int TabStamp { get; set; }
    private static int _seenStamp;
    // an alert opens this window on its subject (docs/PLAYTHROUGH.md 15): "military:service", "military:abroad", and the old names still land
    protected override void OnParametersSet() { if (TabStamp != _seenStamp) { _seenStamp = TabStamp; if (Tab.Length > 0) _view = Tab switch { "battles" => "wars", "navies" => "near", "deck" or "near" or "wars" or "general" or "service" or "abroad" => Tab, _ => "deck" }; } }
    private static string Ordinal(int n) => n % 100 is 11 or 12 or 13 ? n + "th" : (n % 10) switch { 1 => n + "st", 2 => n + "nd", 3 => n + "rd", _ => n + "th" };
    private static string JumpWord(int d) => d == 0 ? "at" : d == 1 ? "one jump from" : d + " jumps from";
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    private static string Signed(int n) => (n > 0 ? "+" : n < 0 ? "−" : "") + Math.Abs(n);
    public static string Minus(string s) => System.Text.RegularExpressions.Regex.Replace(s, @"(?<![\w−-])-(?=\d)", "−");
    /// <summary>The plot's layout, in one pass so nothing is written over anything (docs/VISUAL_SYSTEM.md, rule 5): the names of your
    /// worlds, of enemies' and of the capital first, each above its mark, below it or beside it; then each fleet's mark beside its system
    /// (left for yours, right for others, then above, below and further out), clear of every system, every name placed and every other
    /// fleet; then the other names where there is room. A name with no clear place is left to its system's tooltip.</summary>
    private static (Dictionary<string, (double x, double y)> spots, List<(double x, double y, string text, string cls)> labels) PlotLayout(List<MapNode> ns, List<MapFleet> fl,
        Dictionary<string, MapNode> byId, Func<double, double> px, Func<double, double> py, Func<MapNode, bool> enemy, double vbW, double vbH)
    {
        var taken = new List<(double x0, double y0, double x1, double y1)>(); var labels = new List<(double, double, string, string)>(); var spots = new Dictionary<string, (double x, double y)>();
        foreach (var n in ns) { double cx = px(n.X), cy = py(n.Y), r = (n.IsPlayerTerritory ? 9 : 7) + 3; taken.Add((cx - r, cy - r, cx + r, cy + r)); }   // no name over a star
        bool Free((double x0, double y0, double x1, double y1) r) => r.x0 >= 2 && r.x1 <= vbW - 2 && r.y0 >= 2 && r.y1 <= vbH - 2 && !taken.Any(t => r.x0 < t.x1 && r.x1 > t.x0 && r.y0 < t.y1 && r.y1 > t.y0);
        void Place(double cx, double cy, double r, string text, string cls, double size)
        {
            double w = text.Length * size * .56 + 4, mid = cy + size / 3;
            foreach (var (x, by) in new[] { (cx, cy - r - 5), (cx, cy + r + size + 1), (cx + r + 6 + w / 2, mid), (cx - r - 6 - w / 2, mid),
                                            (cx + r + 2 + w / 2, cy - r - 3), (cx - r - 2 - w / 2, cy - r - 3), (cx + r + 2 + w / 2, cy + r + size - 1), (cx - r - 2 - w / 2, cy + r + size - 1) })
            {
                var box = (x - w / 2, by - size + 1, x + w / 2, by + 3);
                if (Free(box)) { taken.Add(box); labels.Add((x, by, text, cls)); return; }
            }
        }
        int Rank(MapNode n) => n.IsPlayerTerritory ? 0 : enemy(n) ? 1 : n.Capital ? 2 : n.OwnerHouseId != null ? 3 : 4;
        foreach (var n in ns.OrderBy(Rank).ThenBy(n => n.SystemId, StringComparer.Ordinal).Where(n => Rank(n) <= 2))
        {
            bool mine = n.IsPlayerTerritory;
            Place(px(n.X), py(n.Y), mine ? 9 : 7, n.Name + (n.Capital && !mine ? " · the capital" : ""), "nlabel " + (mine ? "mine" : enemy(n) ? "enemy" : ""), mine ? 16 : 14.5);
        }
        // a fleet's name is in its chevron's tooltip: on the plot it is its mark and number plate alone (docs/VISUAL_SYSTEM.md 7.3)
        foreach (var f in fl)
        {
            var n = byId[f.SystemId]; double cx = px(n.X), cy = py(n.Y); double side = f.IsPlayer ? -1 : 1;
            (double x, double y) pick = (cx + 32 * side, cy - 12); bool found = false;
            foreach (double rad in new[] { 1.0, 1.5, 2.1, 2.8 })
            {
                foreach (var (dx, dy) in new[] { (32 * side, -12.0), (-32 * side, -12.0), (32 * side, -40.0), (-32 * side, -40.0), (0.0, -58.0), (0.0, 22.0), (32 * side, 18.0), (-32 * side, 18.0) })
                {
                    double tx = cx + dx * rad, ty = cy + dy * (rad == 1.0 ? 1 : .6 + rad * .4);
                    if (Free(FleetBox(tx, ty))) { pick = (tx, ty); found = true; break; }
                }
                if (found) break;
            }
            spots[f.FleetId] = pick; taken.Add(FleetBox(pick.x, pick.y));
        }
        foreach (var n in ns.Where(n => Rank(n) > 2).OrderBy(Rank).ThenBy(n => n.SystemId, StringComparer.Ordinal))
            Place(px(n.X), py(n.Y), n.OwnerHouseId != null ? 5 : 3.5, n.Name, "nlabel far", 14);
        return (spots, labels);
    }
    /// <summary>A fleet's mark on the plot (its chevron and number plate) around its anchor point.</summary>
    private static (double x0, double y0, double x1, double y1) FleetBox(double x, double y) => (x - 14, y - 14, x + 14, y + 31);
    /// <summary>A lede with its figures in bold roman lining numerals (docs/VISUAL_SYSTEM.md 4.5).</summary>
    public static MarkupString Bold(string s) => new(System.Text.RegularExpressions.Regex.Replace(System.Net.WebUtility.HtmlEncode(Minus(s)), @"(?<![\w&#])([+−-]?\d[\d,.]*)(?![\w;])", "<b>$1</b>"));
    private void MoveWar(string nationId) => G.Execute(new ProposeMotionCommand(G.World!.ProtagonistId, "foreign_war", nationId, G.Turn!.Senate));
    /// <summary>An order's label split at its colon: what holds now ("Your fleets take and hold"), and the order that changes it.</summary>
    private static (string state, string verb) SplitOrder(string label)
    {
        int i = label.IndexOf(": ", StringComparison.Ordinal);
        if (i >= 0) return (label[..i], Cap(label[(i + 2)..]));
        int o = label.IndexOf(" (", StringComparison.Ordinal);   // "Order your fleets to raid (now they take and hold)"
        return o > 0 && label.EndsWith(')') ? (Cap(label[(o + 2)..^1]), label[..o]) : ("", label);
    }
    /// <summary>A nation order's plate in a verb of one to three words; the whole label is its tooltip (VISUAL_SYSTEM.md 4.11).</summary>
    private static string ShortVerb(string id, string verb) => id switch { "own_war" => "Private war", "client" => "Make a client", "raid" => verb.Contains("hold", StringComparison.OrdinalIgnoreCase) ? "Take and hold" : "Raid", "peace" => "Move for peace", "obey" => "Obey", "defy" => "Fight on", _ => verb };
    private static string OrderIcon(string id) => id switch { "peace" => "dove", "own_war" => "crossed-sabres", "obey" => "anticlockwise-rotation", "defy" => "flag-objective", "raid" => "plain-dagger", "client" => "crown", _ => "dove" };
    private static string OrderHint(string id) => id switch
    {
        "peace" => "move in the Senate that the Reach make peace with them (2 influence)",
        "own_war" => "make war on them without a vote: only your house is at war with them, and the Senate may vote that you stop",
        "obey" => "your fleets come home, and the peace the Senate voted is kept",
        "defy" => "the war becomes your house's own: it costs your name at once and every year, and the Senate may recall your general",
        "raid" => "raiding fleets sack a world of a nation's in a season and leave it; fleets that take and hold besiege it and keep it",
        "terms_tribute" or "terms_territory" or "terms_white" or "terms_ceded" or "terms_paid" => "your own war, so your own peace: no vote. They agree to terms the war score allows",
        "client" => "when yours is the house that wins the war, and the nation is beaten decisively: a client keeps its ruler and its worlds and pays the Reach and your house every year; otherwise it pays tribute for twenty years and you keep what you took",
        _ => ""
    };
    private void Order(string nationId, string id)
    {
        var me = G.World!.ProtagonistId;
        switch (id)
        {
            case "peace": G.Execute(new ProposeMotionCommand(me, "foreign_peace", nationId, G.Turn!.Senate)); break;
            case "own_war": G.Execute(new RaidNationCommand(me, nationId, G.Content!.Nations)); break;
            case "obey": G.Execute(new AnswerPeaceCommand(me, true)); break;
            case "defy": G.Execute(new AnswerPeaceCommand(me, false)); break;
            case "raid": G.Execute(new RaidPostureCommand(me, !G.World!.HasFlag(NationSystem.PlayerRaidsFlag))); break;
            case "terms_tribute": case "terms_territory": case "terms_white": case "terms_ceded": case "terms_paid": G.Execute(new NegotiateCommand(me, nationId, id["terms_".Length..], G.Content!.Nations)); break;
            case "client": G.Execute(new PeacePostureCommand(me, !G.World!.HasFlag(NationSystem.PlayerClientsFlag))); break;
        }
    }
    /// <summary>Who fights a fleet that has no admiral: its captain, or nobody, and then it fights at 85 in a hundred (FleetSystem.AdmiralFactor).</summary>
    private static string NoAdmiralSays(FleetLine f) => f.CaptainName != null ? $"No admiral: its captain, {f.CaptainName}, commands." : "No admiral and no captain: it fights at 85 in a hundred.";
    private static string AwayWord(string phase) => phase switch { "fighting" => "fighting", "home" => "homeward", _ => "outward" };
    private static string StanceHelp(string s) => s switch { "press" => "The charge: +15% power, more losses; beats the skirmish, beaten by the line", "skirmish" => "Harass and evade: −10% power, far fewer losses; beats the line, beaten by the press", "boarding" => "The press with prize crews: on victory, 2 manpower take a hull per four the enemy lost", _ => "The line: steady; beats the press, beaten by the skirmish" };
    private static string StyleHelp(string s) => s switch { "front" => "+10% to this fleet, the crews' love, a point of valour a victory, and twice the risk of dying with the line", "flag" => "Every fleet of the house +3% per point of tactics; never lost with the line; needs the rank of Commander", _ => "The captains fight the ships" };
    private static string StyleLabel(string s) => s switch { "front" => "The front", "flag" => "The flag", _ => "The staff" };
    /// <summary>Joined plates for one choice (docs/VISUAL_SYSTEM.md 4.11, segmented): the one in force recessed in brass; one refused is dark, with why in its tooltip.</summary>
    private RenderFragment Seg(IReadOnlyList<Option>? opts, string current, Func<string, string> label, Func<string, string> help, Action<string> pick) => __builder =>
    {
        if (opts == null) return;
        <Segmented Class="mil-seg" Value="@current" Options="@opts.Select(o => (o.Id, label(o.Id), help(o.Id))).ToList()"
                   Refusal="@(id => opts.FirstOrDefault(o => o.Id == id)?.Refusal is { } r && r != "already so" ? Cap(r) : null)" OnChange="id => pick(id)" />
    };
    /// <summary>The fleet's token (docs/VISUAL_SYSTEM.md 3.7, 7.3): a chevron in the house colour with a light facet, in a recessed well; hollow when laid up.</summary>
    private static RenderFragment Token(string accent, bool faint) => __builder =>
    {
        <span class="mil-tok @(faint ? "faint" : "")" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 20 L12 3 L21 20 L12 15 Z" fill="@accent" stroke="#000" stroke-width="1.4" stroke-linejoin="round" /><path d="M12 3 L12 15 L3 20 Z" fill="#fff" opacity=".22" /></svg></span>
    };
}
