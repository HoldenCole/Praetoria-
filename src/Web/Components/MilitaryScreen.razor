                                <Plate Label="@($"Detach {hn} as a guard")" Small="true" Icon="flag-objective" Locked="@(detNo != null)" Disabled="@(detNo != null)" ShowNeed="false" Need="@Cap(detNo ?? "")" data-detach="@f.Id" Tip="@("[flag-objective] Detach a guard\n" + Cap(detTitle))" OnClick="() => Detach(det, fid)" />
                                <Plate Label="@($"Pay off {hn}")" Small="true" Icon="receive-money" Locked="@(payNo != null)" Disabled="@(payNo != null)" ShowNeed="false" Need="@Cap(payNo ?? "")" data-payoff="@f.Id"
                                       Tip="@("[receive-money] Pay them off\n" + (payNo != null ? Cap(payNo) : $"{FleetHulls.Say(pay.Which(w))} {(hn == 1 ? "is" : "are")} broken up. It saves {SavedSays(pay.Saved(w))} a year, and the breakers give back {pay.Scrap(w)} materials ({PayOffHullsCommand.ScrapPct}% of what they cost). It cannot be undone."))"
                                       OnClick='() => G.Ask("Pay off " + Counted.Hulls(hn) + " of " + f.Name + "?", FleetHulls.Say(pay.Which(w)) + (hn == 1 ? " is" : " are") + " broken up for " + pay.Scrap(w) + " materials. That saves " + SavedSays(pay.Saved(w)) + " a year. It cannot be undone.", "Pay them off", () => G.Execute(pay))' />
                            </div>
