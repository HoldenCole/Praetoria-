                        @if (el.AmConsul) { <Plate Label="Ask for them" Small="true" Locked="@(askNo != null)" Disabled="@(askNo != null)" Tip="@(askNo ?? "Put it to the Senate. The graver the danger the readier it is; a consul it fears is refused.")" OnClick='() => MoveSelf("emergency")' /> }
