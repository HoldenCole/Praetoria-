                                    <Plate Label="Levy on the houses" Small="true" Locked="@(levyNo != null)" Disabled="@(levyNo != null)" Tip="@(levyNo ?? $"Every other house pays up to {Money.Credits(EmergencySystem.LevyCredits)} to yours, without a vote. Each head thinks the worse of you, and the Reach a little less of its magistrates. Once a year.")" OnClick="() => G.Execute(new EmergencyCommand(pid, EmergencyCommand.Levy))" />
                                    <Plate Label="Ask for more time" Small="true" Locked="@(askNo != null)" Disabled="@(askNo != null)" Tip="@(askNo ?? "Put it to the Senate that the powers run three years more. Each time you ask, the houses are slower to agree.")" OnClick='() => MoveSelf("emergency")' />
                                    <Plate Label="Ask for them for life" Small="true" Class="sn-veto" Locked="@(lifeNo != null)" Disabled="@(lifeNo != null)" Tip="@(lifeNo ?? "Put it to the Senate that you hold them for life. If it carries, the Republic ends by its own vote and you rule. If it fails, the Senate ends the powers in the same breath and your house is disgraced.")" OnClick='() => MoveSelf("for_life")' />
                                </div>
                            }
                        </div>
                        <div></div><div></div>
                    </div>
                }
                else if (danger != null)
                {
                    <div class="ui-wstrip bad sn-strip"><Icon Name="crisis" Tone="ember" Size="18" />
