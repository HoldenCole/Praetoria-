                                var pl = new PledgeVotesCommand(pid, chosen.HouseId, c.Offices, G.Turn!.Senate); string? plNo = pl.Refusal(G.Ctx); string nname = chosen.HouseName;
                                <Select Value="@chosen.HouseId" Options="@pick.Select(x => new Select.Option(x.HouseId, x.HouseName, $"{x.Tally} votes")).ToList()" OnChange="v => _pledgeTo = v" Class="sn-pledge-sel" />
                                <Plate Label="Pledge" Small="true" Icon="vote" Locked="@(plNo != null)" Disabled="@(plNo != null)" Need="@(plNo ?? "")" Tip="@(plNo ?? pl.Says(w))" OnClick='() => G.Ask("Pledge your seats to " + nname + "?", pl.Says(w), "Pledge them", () => G.Execute(pl))' data-pledge-to="@chosen.HouseId" />
                            }
                        }
                    </div>
                }
                @if (!el.AmConsul && FactionSystem.Of(w, house.Id) is { } ownBench && ElectionSystem.BenchContest(w, c.Offices, id => G.Turn!.Senate.Weight(w, id), ownBench) is { rivalId.Length: > 0 } bc)
                {
                    /* whom the bench would put forward, you or another of it (docs/PLAYTHROUGH.md, Medium, The Senate, P87) */
                    string rivalName = w.House(bc.rivalId)?.Name ?? bc.rivalId; string Names(List<string> ids) => ids.Count == 0 ? "its own seats only" : "with " + string.Join(", ", ids.Select(x => w.House(x)?.Name ?? x));
                    <div class="sn-note sn-pad" data-bench-nomination="@(bc.won ? "yours" : "theirs")"><Icon Name="flying-flag" Tone="@(bc.won ? "good" : "brass")" Size="15" />
                        <span><b>Inside @ownBench.Name.</b>@(" ")
