                        </div>
                    </div>
                }
            }
        </div>
    }
    else if (_view == "offices")
    {
        var consuls = sen?.Offices?.Where(o => o.Elected).ToList() ?? new List<OfficeCard>();
        var others = sen?.Offices?.Where(o => !o.Elected).ToList() ?? new List<OfficeCard>();
        int heldByUs = sen?.Offices?.Count(o => o.Mine) ?? 0, vacant = others.Count(o => o.HolderHouse == null);
        <p class="ui-lede sn-lede">@Bold((elect != null ? (elect.AmConsul ? "You hold the consulship. " : elect.NextIn == 0 ? "The consuls are elected at the end of this year. " : $"The consuls are elected in {elect.NextIn} years. ") : "") + $"{(others.Count == 1 ? "One office" : others.Count + " offices")} of the Reach {(others.Count == 1 ? "is" : "are")} filled by the Senate's commission{(vacant > 0 ? $", {vacant} of them vacant" : "")}; your house holds {heldByUs}.")</p>
