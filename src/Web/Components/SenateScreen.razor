                            else if (!fa.Mine) { <Plate Label="Take a seat" Small="true" Locked="@(fa.JoinRefusal != null)" Disabled="@(fa.JoinRefusal != null)" Tip="@(fa.JoinRefusal ?? $"{FactionSystem.JoinInfluence} influence: take a seat with them")" CostIcon="public-speaker" CostText="@FactionSystem.JoinInfluence.ToString()" OnClick="() => G.Execute(new JoinFactionCommand(pid, faId))" /> }
                            else if (sen.LeaveRefusal == null) { <Plate Label="Leave" Small="true" Tip="@($"Leave the bench and sit with none. It costs no influence. {(seated != null ? FactionSystem.WalkSays(w, seated) : "")}.")" OnClick="() => G.Execute(new LeaveFactionCommand(pid))" /> }
