                {
                    string faId = fa.Id, faName = fa.Name;
                    <div class="ui-row sn-row sn-party bench @(fa.Mine ? "mine" : "")" style="--party:@fa.LeaderAccent" title="@(fa.Description.Length > 0 ? fa.Description : fa.Platform.Length > 0 ? fa.Platform : "no record yet")">
                        <div class="sn-party-pic"><Sigil HouseId="@fa.LeaderHouseId" Accent="@fa.LeaderAccent" Size="26" /><i class="sn-party-sw"></i></div>
