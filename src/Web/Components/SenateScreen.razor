                        <div class="sn-rmain"><div class="ui-row-nm">@o.Name <span class="sn-req">@o.Track rank @o.MinRank+@(o.Hulls > 0 ? $" · {Counted.OfficeHulls(o.Hulls)}" : "")</span></div>
                            <div class="ui-row-sub">@if (o.HolderHouse != null) { <Sigil HouseId="@o.HolderHouseId" Accent="@o.HolderAccent" Size="14" /> <b>@o.HolderName</b>@($" of {o.HolderHouse} · since year {o.Since}") } else { <i>vacant</i> }
                                @if (o.MyCandidate != null && !o.Mine) { <span class="sn-candq"> · @o.MyCandidate qualifies@(sen!.MayPropose ? ": move a Commission" : ", but your house may not move a motion yet")</span> }</div></div>
                        <div class="ui-cols">@if (o.Mine) { <span class="sn-tag mine">yours</span> }</div>
                        <div></div>
