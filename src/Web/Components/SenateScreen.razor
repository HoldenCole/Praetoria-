                        @if (pledged != null)
                        {
                            var back = new PledgeVotesCommand(pid, string.Empty, c.Offices, G.Turn!.Senate);
                            <Plate Label="Take the pledge back" Small="true" Tip="@($"Its head thinks {ElectionSystem.UnpledgeRegard} the worse of you for it.")" OnClick="() => G.Execute(back)" />
                        }
