                    <div class="sn-note sn-pad" data-consul-year><Icon Name="tied-scroll" Tone="brass" Size="15" /><span>A consul has a charge every year (render the Reach's account, sweep its most lawless region, or see to your bench's business), may speak from the chair on one motion, and decides a tied Senate. <Link Label="Your duties" OnClick='() => Pick("duties")' /></span></div>
                }
            </div>
        }
        @if (others.Count > 0)
