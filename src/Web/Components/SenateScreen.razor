@using Praetoria.Core.Commands
@using Praetoria.Core.Systems
@inject GameClient G
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var p = w.Protagonist!; var house = w.House(p.HouseId)!;
    var spheres = c.Spheres.IsEmpty ? new List<string>() : c.Spheres.Defs.Select(s => s.Id).ToList();
    if (spheres.Count == 0) spheres = w.Houses.Values.SelectMany(h => h.SphereInfluence.Keys).Distinct().OrderBy(x => x, StringComparer.Ordinal).ToList();
    var s = m.Standing; var sen = m.Senate; var ladder = c.Titles.ByRank.ToList();
    int threat = w.Counter("threat"), pressure = w.Counter("coalition_pressure");
    var senate = G.Turn!.Senate;
    // the chamber: every house's seats (its Senate weight), grouped by bench, the unaffiliated in the middle
    var seatHouses = w.Houses.Values.Where(h => h.Id != PirateSystem.HouseId).Select(h => (h, weight: senate.Weight(w, h.Id), bench: FactionSystem.Of(w, h.Id))).ToList();
    var benches = w.Factions.OrderByDescending(f => f.Members.Sum(x => senate.Weight(w, x))).ThenBy(f => f.Id, StringComparer.Ordinal).ToList();
    var ordered = new List<(House h, int weight, Faction? bench)>();
    int half = (benches.Count + 1) / 2;
    foreach (var f in benches.Take(half)) ordered.AddRange(seatHouses.Where(x => x.bench?.Id == f.Id).OrderByDescending(x => x.weight).ThenBy(x => x.h.Id, StringComparer.Ordinal));
    ordered.AddRange(seatHouses.Where(x => x.bench == null).OrderByDescending(x => x.weight).ThenBy(x => x.h.Id, StringComparer.Ordinal));
    foreach (var f in benches.Skip(half)) ordered.AddRange(seatHouses.Where(x => x.bench?.Id == f.Id).OrderByDescending(x => x.weight).ThenBy(x => x.h.Id, StringComparer.Ordinal));
    int totalSeats = Math.Max(1, ordered.Sum(x => x.weight));
    var seats = Seats(ordered);
    var watched = sen != null && sen.Docket.Count > 0 ? (sen.Docket.FirstOrDefault(d => d.Id == _watch) ?? sen.Docket[0]) : null;
    var stanceOf = watched?.Stances.ToDictionary(x => x.HouseId, x => x.Stance) ?? new Dictionary<string, int>();
    if (watched != null) stanceOf[house.Id] = watched.MyStance;
    var focusHouse = _focus != null ? w.House(_focus) : null;
    var focusHead = focusHouse != null ? Economy.HeadOf(w, focusHouse) : null;
    var focusStance = watched?.Stances.FirstOrDefault(x => x.HouseId == _focus);
    int myWeight = senate.Weight(w, house.Id);
    // a seat is drawn in its bench's colour, so that the legend under the chamber reads against it
    var seatFill = ordered.GroupBy(x => x.h.Id).ToDictionary(g => g.Key, g => g.First().bench is { } sb ? (sb.Accent.Length > 0 ? sb.Accent : w.House(sb.LeaderHouseId)?.AccentColor ?? "#888") : "#7d8598");
    // The picture (docs/DASHBOARDS.md): what is before the chamber and how it will go, whose the seats are, and when the next count is.
    int seatRank = 1 + seatHouses.Count(x => x.weight > myWeight); var topSeat = seatHouses.OrderByDescending(x => x.weight).ThenBy(x => x.h.Id, StringComparer.Ordinal).FirstOrDefault();
    var myBench = FactionSystem.Of(w, house.Id); int benchSeats = myBench?.Members.Sum(x => senate.Weight(w, x)) ?? 0; int majority = totalSeats / 2 + 1;
    bool largest = myBench != null && benches.Count > 0 && benches[0].Id == myBench.Id;
    int motions = sen?.Docket.Count ?? 0, carry = sen?.Docket.Count(d => d.ForWeight > d.AgainstWeight) ?? 0; var againstMe = sen?.Docket.FirstOrDefault(d => d.AgainstMe);
    var elect = sen?.Election; var lead = elect?.Nominees.OrderByDescending(n => n.Tally).Select(n => (n.HouseName, n.Tally)).FirstOrDefault();
    bool yearUnspent = LadderSystem.DutyOf(w, p.Id, LadderSystem.SeatKind) != null, workWaits = w.OfficeWork.Any(b => b.HolderId == p.Id && b.Choice.Length == 0);
    int trust = LadderSystem.Trust(w);
    string countLine = elect == null ? "" : elect.AmConsul ? " You hold the consulship." : elect.NextIn == 0 ? $" The consuls are elected at the year's end{(lead is { HouseName: not null } l1 ? $"; {l1.HouseName} leads the count" : "")}." : $" The consuls are elected in {elect.NextIn} years.";
    string story, storyTone;
    if (sen == null) { story = "The Senate does not sit in this age."; storyTone = ""; }
    else if (againstMe != null) { bool passes = againstMe.ForWeight > againstMe.AgainstWeight; story = $"A motion against you is before the chamber: {againstMe.KindName}, moved by {againstMe.ProposerName}. As the benches lean it {(passes ? "carries" : "fails")}, {againstMe.ForWeight} to {againstMe.AgainstWeight}."; storyTone = passes ? "bad" : "warn"; }
    else if (motions > 0) { var first = sen.Docket[0]; story = motions == 1 ? $"One motion is before the chamber: {first.KindName}, moved by {first.ProposerName}. As the benches lean it {(first.ForWeight > first.AgainstWeight ? "carries" : "fails")}, {first.ForWeight} to {first.AgainstWeight}.{countLine}" : $"{motions} motions are before the chamber. As the benches lean, {carry} carry and {motions - carry} fail.{countLine}"; storyTone = ""; }
    else { story = $"Nothing is before the Senate this year. You hold {myWeight} of its {totalSeats} seats{(myBench != null ? $"; {myBench.Name}, your bench, hold {benchSeats}, {(benchSeats >= majority ? "a majority" : $"{majority - benchSeats} short of a majority")}" : " and sit on no bench")}.{countLine}"; storyTone = ""; }
    if (yearUnspent) story += " Your own year in the Senate is not yet spent.";
}
<div class="dash senate" style="--accent:@house.AccentColor">
    <header class="dash-head picture">
        <div class="dh-title"><Icon Name="houses" Size="18" /> <b>@(w.Era == "imperium" ? "The Imperial Senate" : "The Senate of the Reach")</b>
            <span class="muted">@seatHouses.Count houses · @totalSeats seats · @benches.Count bench@(benches.Count == 1 ? "" : "es") · @(s?.Throne.HoldsThrone == true ? "the throne is yours" : s?.Throne.EmperorName != null ? $"the throne is {s.Throne.EmperorName}'s" : w.IsImperium ? "the throne stands empty" : "a republic: no throne stands")</span></div>
        <p class="headline @storyTone">@story</p>
        <div class="tiles">
            <Tile Label="Your seats" Value="@($"{myWeight} of {totalSeats}")" Share="@(topSeat.h != null && topSeat.weight > 0 ? 100 * myWeight / topSeat.weight : 0)" Tone="@(myWeight == 0 ? "warn" : "")"
                  Note="@(myWeight == 0 ? "the house has no seat" : topSeat.h == null || topSeat.h.Id == house.Id ? $"the most of any house, of {seatHouses.Count}" : $"{Ordinal(seatRank)} of {seatHouses.Count} houses · {topSeat.h.Name} has {topSeat.weight}")"
                  Title="A house votes with the weight of its seats. The bar is your seats against the house that has most." />
            <Tile Label="Your bench" Value="@(myBench?.Name ?? "none")" Share="@(myBench != null ? 100 * benchSeats / totalSeats : -1)" Tone="@(myBench != null && benchSeats >= majority ? "good" : "")"
                  Note="@(myBench == null ? "you vote alone; a bench votes together" : benchSeats >= majority ? $"{benchSeats} seats: a majority of the chamber" : $"{benchSeats} seats{(largest ? ", the largest bench" : "")} · {majority - benchSeats} short of a majority")"
                  Title="The bar is your bench's share of the whole chamber." />
            <Tile Label="Before the chamber" Value="@(motions == 0 ? "nothing" : motions == 1 ? "1 motion" : motions + " motions")" Tone="@(againstMe != null ? "bad" : "")"
                  Note="@(sen == null ? "" : motions == 0 ? (sen.MayPropose ? "you may move one" : "and you may not move one") : againstMe != null ? "one of them against you" : $"{carry} to carry, {motions - carry} to fail, as it stands")"
                  Title="Motions are voted at the year's end, by weight of seats." />
            @if (ThroneSystem.Emperor(w) is { } sits)
            {
                int th = ThroneSystem.Hold(w); var up = w.Rising != null ? w.House(w.Rising.HouseId) : null;
                <Tile Label="The throne" Value="@($"{th} · {ThroneSystem.HoldName(th)}")" Share="@th" Tone="@(th < ThroneSystem.RiseAt || up != null ? "bad" : th < ThroneSystem.ShakenAt ? "warn" : "good")"
                      Note="@(up != null ? $"{up.Name} has raised a standard" : sits.Id == house.Id ? "your hold on it" : $"the hold of {sits.Name}")"
                      Title="@($"How firmly the house on the throne holds it, out of 100. Below {ThroneSystem.RiseAt} for two years and a house of rank raises a standard. What it is made of is under Offices, parties and titles.")" />
            }
            @if (elect != null)
            {
                <Tile Label="The consulship" Value="@(elect.AmConsul ? "yours" : elect.NextIn == 0 ? "this year" : elect.NextIn == 1 ? "next year" : $"in {elect.NextIn} years")" Tone="@(elect.AmConsul ? "good" : "")"
                      Note="@(elect.AmConsul ? (elect.CanVeto ? "your veto is unspent this term" : "your veto is spent this term") : (elect.Standing ? "you stand" : "you do not stand") + (lead is { HouseName: not null } l2 ? $" · {l2.HouseName} leads with {l2.Tally}" : " · no candidate yet"))"
                      Title="@($"Two consuls are elected every {elect.TermTurns} years, by the weight of the houses that vote for them.")" />
            }
            <Tile Label="Fear of you" Value="@threat.ToString()" Share="@(100 * threat / SphereSystem.CoalitionThreshold)" Tone="@(threat >= SphereSystem.CoalitionThreshold ? "bad" : threat * 3 >= SphereSystem.CoalitionThreshold * 2 ? "warn" : "")"
                  Note="@($"the houses draw together at {SphereSystem.CoalitionThreshold}" + (pressure > 0 ? $" · pressure {pressure} of {SphereSystem.MaxCoalitionPressure}" : ""))"
                  Title="How over-mighty the Reach thinks your house. Past the mark, the houses begin to combine against it." />
            <Tile Label="Trust in the magistrates" Value="@trust.ToString()" Share="@trust" Tone="@(trust < LadderSystem.TrustLow ? "bad" : trust < 50 ? "warn" : trust >= LadderSystem.TrustHigh ? "good" : "")"
                  Note="@(trust < LadderSystem.TrustLow ? "the squares blame whoever holds office" : trust < 50 ? "a scandal costs twice the votes" : trust >= LadderSystem.TrustHigh ? "office is honoured" : "neither honoured nor blamed")"
                  Title="@LadderSystem.TrustSays(w)" />
            @if (sen?.Embargoed == true) { <Tile Label="Embargo" Value="@($"{Counted.Years(sen.EmbargoLifts)}")" Tone="bad" Note="the Reach does not trade with you until it lifts" /> }
        </div>
    </header>

    <div class="ex-tabs">
        <button class="rung @(_view == "chamber" ? "here" : "")" @onclick='() => _view = "chamber"'>The chamber@(motions > 0 ? $" · {motions}" : "")</button>
        <button class="rung @(_view == "move" ? "here" : "")" @onclick='() => _view = "move"'>Move a motion</button>
        @if (sen?.Election != null) { <button class="rung @(_view == "consuls" ? "here" : "")" @onclick='() => _view = "consuls"'>The consuls</button> }
        <button class="rung @(_view == "offices" ? "here" : "")" @onclick='() => _view = "offices"'>Offices and parties</button>
        <button class="rung @(_view == "duties" ? "here" : "") @(workWaits ? "warn" : "")" @onclick='() => _view = "duties"'>Your duties@(workWaits ? " · waiting" : "")</button>
        <button class="rung @(_view == "ladder" ? "here" : "")" @onclick='() => _view = "ladder"'>Ladder and courts</button>
        <button class="rung @(_view == "orders" ? "here" : "")" @onclick='() => _view = "orders"'>The orders</button>
    </div>
    @if (_view == "duties") { <div class="dash-grid deck-one"><div class="deck-col"><DutiesPanel /></div></div> }
    else if (_view == "ladder") { <div class="dash-grid deck-one"><div class="deck-col"><LadderPanel /><CourtsPanel /></div></div> }
    else if (_view == "orders") { <div class="dash-grid deck-one"><div class="deck-col"><OrdersPanel /><BreakawayPanel /></div></div> }
    else if (_view == "offices")
    {
    <div class="dash-grid senate2-grid">
        <div class="deck-col">
        @if (sen?.Offices is { Count: > 0 })
        {
            <section class="panel">
                <h3><Icon Name="throne" Size="13" /> The offices of the Reach</h3>
                @foreach (var o in sen.Offices.Where(o => !o.Elected))
                {
                    <div class="off-card @(o.Mine ? "mine" : "") @(o.HolderHouse == null ? "vacant" : "")" title="@o.Description">
                        <div class="of-head"><b>@o.Name</b> <span class="muted small">@o.Track rank @o.MinRank+@(o.Hulls > 0 ? $" · {Counted.OfficeHulls(o.Hulls)}" : "")</span></div>
                        <div class="small">@if (o.HolderHouse != null) { <Sigil HouseId="@o.HolderHouseId" Accent="@o.HolderAccent" Size="12" /> <span>@o.HolderName of @o.HolderHouse</span> <span class="muted">since turn @o.Since</span> } else { <span class="muted">vacant</span> }
                            @if (o.MyCandidate != null && !o.Mine) { <span class="muted"> · @o.MyCandidate qualifies@(sen.MayPropose ? ": move a Commission" : ", but your house may not move a motion yet")</span> }</div>
                    </div>
                }
            </section>
        }
        @if (sen != null && (sen.Factions is { Count: > 0 } || sen.FoundRefusal == null || sen.Followers > 0))
        {
            <section class="panel">
                <h3><Icon Name="houses" Size="13" /> The parties <span class="muted">four of the Republic, and any you found</span></h3>
                @foreach (var fa in sen.Factions ?? Array.Empty<FactionCard>())
                {
                    <div class="bench @(fa.Mine ? "mine" : "")" style="--party:@fa.LeaderAccent" title="@(fa.Description.Length > 0 ? fa.Description : fa.Platform.Length > 0 ? fa.Platform : "no record yet")">
                        <div class="of-head"><i class="party-dot" style="background:@fa.LeaderAccent"></i><b>@fa.Name</b> <span class="muted small">weight @fa.Weight · led by <span style="color:@fa.LeaderAccent">@fa.LeaderName</span>@(fa.Record != 0 ? $" · record {(fa.Record > 0 ? "+" : "")}{fa.Record}" : "")</span></div>
                        <div class="bench-members">@foreach (var mb in fa.Members) { <span class="member" title="@mb.Name"><Sigil HouseId="@mb.Id" Accent="@mb.Accent" Size="13" /></span> }
                            @if (fa.Platform.Length > 0) { <span class="muted small"> · @fa.Platform</span> }</div>
                        @if (fa.Courts.Length > 0 || fa.LawPlatform.Length > 0) { <div class="muted small">@(fa.Courts.Length > 0 ? $"courts {fa.Courts}" : "")@(fa.Courts.Length > 0 && fa.LawPlatform.Length > 0 ? " · " : "")@fa.LawPlatform</div> }
                        @{ var seated = FactionSystem.Of(w, house.Id); string faId = fa.Id, faName = fa.Name; }
                        @if (fa.Mine && seated != null && seated.LeaderHouseId != house.Id)
                        {
                            /* ask the bench to choose between you and its leader (docs/PLAYTHROUGH.md, Medium, The Senate, P9 and P99) */
                            var askLead = new ChallengeLeaderCommand(pid, senate); string? leadNo = askLead.Refusal(G.Ctx); var count = FactionSystem.LeadCount(w, id => senate.Weight(w, id), house.Id);
                            <div class="small" data-lead-count="@(count is { } lc ? lc.mine + ":" + lc.leaders : "")">
                                @if (count is { } cnt) { <span class="muted">If the bench were asked to choose, @cnt.mine of its seats would be behind you and @cnt.leaders behind @fa.LeaderName. </span> }
                                <button class="opt inline tiny" data-challenge disabled="@(leadNo != null)" title="@(leadNo ?? askLead.Says(w))" @onclick='() => G.Ask("Ask " + faName + " to choose its leader?", askLead.Says(w), "Ask the bench", () => G.Execute(askLead))'>Ask the bench to choose · @FactionSystem.ChallengeInfluence influence</button>
                            </div>
                        }
                        @if (!fa.Mine && seated != null)
                        {
                            <button class="opt inline tiny" data-cross="@fa.Id" disabled="@(fa.JoinRefusal != null)" title="@(fa.JoinRefusal ?? $"{FactionSystem.JoinInfluence} influence, in one step: you leave {seated.Name} and sit with {fa.Name}. {FactionSystem.WalkSays(w, seated)}.")" @onclick="() => AskCross(faId, faName)">cross to them · @FactionSystem.JoinInfluence</button>
                            @if (fa.JoinRefusal != null) { <span class="muted small">@fa.JoinRefusal</span> }
                        }
                        else if (!fa.Mine) { <button class="opt inline tiny" disabled="@(fa.JoinRefusal != null)" title="@(fa.JoinRefusal ?? $"{FactionSystem.JoinInfluence} influence: take a seat with them")" @onclick="() => G.Execute(new JoinFactionCommand(pid, fa.Id))">take a seat · @FactionSystem.JoinInfluence</button> }
                        else if (sen.LeaveRefusal == null) { <button class="opt inline tiny" title="@($"Leave the bench and sit with none. It costs no influence. {(seated != null ? FactionSystem.WalkSays(w, seated) : "")}.")" @onclick="() => G.Execute(new LeaveFactionCommand(pid))">leave</button> }
                    </div>
                }
                @if (!(sen.Factions?.Any(f => f.Mine) ?? false)) { <button class="opt inline" disabled="@(sen.FoundRefusal != null)" title="@(sen.FoundRefusal ?? $"{FactionSystem.FoundInfluence} influence: a bench of your own, with those who vote with you")" @onclick="() => G.Execute(new FoundFactionCommand(pid))">Found a bench@(sen.Followers > 0 ? $" · {sen.Followers} would follow" : "")</button> }
            </section>
        }
        </div>
        <div class="deck-col">
        @if (s != null)
        {
            <section class="panel">
                <h3><Icon Name="throne" Size="13" /> The ladder of titles</h3>
                <div class="ladder">
                    @foreach (var t in ladder) { int r = c.Titles.RankOf(t.Id); int mr = c.Titles.RankOf(house.Title); <span class="rung @(r == mr ? "here" : r < mr ? "past" : "")" data-rung="@t.Id" title="@RungTip(t)">@t.NameIn(G.World!.Era)</span> }
                </div>
                <div class="kv"><span>Legitimacy</span><b>@s.Legitimacy@(s.NextTitle != null ? $" / {s.NextRequirement} for {s.NextTitle}" : "")</b></div>
                @if (s.Made is { } made)
                {
                    <details data-legitimacy-details><summary title="@made.Line">What it is made of</summary><LegitimacyMade Card="made" /></details>
                }
                @if (s.NextTitle != null)
                {
                    <div class="rung-needs" data-rung-needs="@s.NextTitle">
                        <div class="muted small" data-rung-earned>@s.Earned</div>
                        @foreach (var need in s.Needs) { <div class="kv small @(need.Met ? string.Empty : "warn")" data-rung-need="@need.Id" data-met="@(need.Met ? 1 : 0)"><span>@need.Asks</span><b>@(need.Met ? "✓" : "✗") @need.Has</b></div> }
                    </div>
                }
                @if (s.Instability > 0) { <div class="kv warn"><span>Instability</span><b>@s.Instability</b></div> }
                @if (s.Claims.Count > 0) { <div class="kv"><span>Claims held</span><b>@string.Join(", ", s.Claims.Select(cl => c.Titles.NameOf(cl, w.Era)))</b></div> }
                @if (s.NextTitle != null) { foreach (var path in s.Paths) { var pth = path; string ptip = path.Available ? path.Tooltip : PathWhy(path); <button class="opt" data-path="@path.Id" disabled="@(!path.Available)" title="@ptip" @onclick="() => AskPath(pth, s.NextTitle)">@path.Label <span class="muted small">· @path.Cost</span></button> @if (!path.Available && path.Refusal != null) { <div class="sw-no path-no">@path.Label: @path.Refusal.</div> } } }
                <details open="@w.IsImperium"><summary>@(w.IsImperium ? "The throne" : "The end of the Republic") @(s.Throne.HoldsThrone ? "· yours" : s.Throne.EmperorName != null ? $"· {s.Throne.EmperorName}" : w.IsImperium ? "· empty" : "· no throne stands")</summary>
                    @if (ThroneSystem.Emperor(w) is { } onThrone)
                    {
                        int hold = ThroneSystem.Hold(w); var holdParts = ThroneSystem.HoldParts(w); var rising = w.Rising; var riser = rising != null ? w.House(rising.HouseId) : null;
                        string? raiseNo = new ThroneCommand(pid, ThroneCommand.Raise, c.Titles, G.Turn!.Fleets).Refusal(G.Ctx), overNo = new ThroneCommand(pid, ThroneCommand.Pretender, c.Titles, G.Turn!.Fleets).Refusal(G.Ctx), byNo = new ThroneCommand(pid, ThroneCommand.Throne, c.Titles, G.Turn!.Fleets).Refusal(G.Ctx);
                        <div class="kv @(hold < ThroneSystem.RiseAt ? "warn" : "")" title="@("Out of 100, from 50. " + string.Join(" · ", holdParts.Select(x => $"{x.what} {(x.points >= 0 ? "+" : "")}{x.points}")) + $". Below {ThroneSystem.RiseAt} for two years and a house of rank that has no love for the throne raises a standard.")"><span>The hold of @onThrone.Name</span><b>@hold · @ThroneSystem.HoldName(hold)</b></div>
                        <div class="muted small">@string.Join(" · ", holdParts.Where(x => x.points != 0).OrderBy(x => x.points).Take(4).Select(x => $"{x.what} {(x.points >= 0 ? "+" : "")}{x.points}"))</div>
                        @if (rising != null && riser != null)
                        {
                            <div class="small"><b class="warn">@riser.Name has raised a standard</b>, since year @rising.Since.@(rising.With.Count > 0 ? $" With it: {string.Join(", ", rising.With.Select(id => w.House(id)?.Name))}." : "")@(rising.Against.Count > 0 ? $" By the throne: {string.Join(", ", rising.Against.Select(id => w.House(id)?.Name))}." : "") It is broken if the war goes against it, its fleet is spent, or @ThroneSystem.PretenderYears years pass.</div>
                            @if (overNo == null || byNo == null)
                            {
                                <div class="suit-acts">
                                    <button class="opt inline" disabled="@(overNo != null)" title="@(overNo ?? $"Your house is at war with the throne. {riser.Name}'s head thinks better of you; the throne's does not forget it.")" @onclick="() => G.Execute(new ThroneCommand(pid, ThroneCommand.Pretender, c.Titles, G.Turn!.Fleets))">Go over to @riser.Name</button>
                                    <button class="opt inline" disabled="@(byNo != null)" title="@(byNo ?? $"Your house is at war with {riser.Name}. The throne thinks better of you; {riser.Name}'s head does not forget it.")" @onclick="() => G.Execute(new ThroneCommand(pid, ThroneCommand.Throne, c.Titles, G.Turn!.Fleets))">Stand by the throne</button>
                                </div>
                            }
                        }
                        @if (!s.Throne.HoldsThrone) { <button class="opt" disabled="@(raiseNo != null)" title="@(raiseNo ?? "A war for the throne itself: it is not ended by treaty. The other houses take a side by what their heads think of you and of the one who sits there. You take the throne by the terms of a seizure; if the war goes against you, your fleet is spent, or eight years pass, you are broken.")" @onclick="() => G.Execute(new ThroneCommand(pid, ThroneCommand.Raise, c.Titles, G.Turn!.Fleets))">Raise your standard against the throne (3 influence)</button> }
                    }
                    <button class="opt" disabled="@(s.Throne.ProclaimRefusal != null)" title="@s.Throne.ProclaimRefusal" @onclick="() => G.Execute(new ProclaimImperiumCommand(pid, c.Titles))">Proclaim the Imperium (3 influence, 2 agents)</button>
                    <button class="opt" disabled="@(s.Throne.SeizeRefusal != null)" title="@s.Throne.SeizeRefusal" @onclick="() => G.Execute(new SeizeThroneCommand(pid, c.Titles, c.Friction))">Seize the throne (2 treasury, 2 agents)</button>
                </details>
                <details><summary>Succession: @s.SuccessionLaw</summary>@foreach (var o in s.LawOptions) { <button class="opt" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new SetSuccessionLawCommand(pid, o.Id))">@o.Label</button> }</details>
                @if (s.Honors.Count > 0) { <div class="kv"><span><Icon Name="honor" Size="13" /> Honors</span><b>@string.Join(", ", s.Honors)</b></div> }
            </section>
        }
        @if (m.Crises is { } cr)
        {
            <section class="panel">
                <h3><Icon Name="crisis" Size="13" /> Crises</h3>
                <div class="muted small">@cr.Counters</div>
                @foreach (var a in cr.Active)
                {
                    <div class="crisis"><div><b>@a.Name</b> · <span title="How much relief it takes to end it. It does not grow with time; it rises only if the crisis breaks out again while it is active.">severity @a.Severity</span> · since year @a.Since @(a.Author != null ? $"· set going by {a.Author}" : "· nobody set it going: it came of itself")</div>
                        @foreach (var d in a.Dampers) { <button class="opt" disabled="@(!d.Available)" title="@d.Tooltip" @onclick="() => Damper(d)">@d.Label</button> }
                        @if (G.Turn!.Crises is { } engine && engine.Def(a.Id) is { } cdef)
                        {
                            <details class="crisis-facts" data-crisis-facts="@a.Id"><summary>What this is, and what each answer does</summary>
                                @foreach (var line in CrisisFacts.For(w, engine, cdef, c.Recovery)) { <div class="small"><b>@line.Label.</b> @line.Text</div> }
                            </details>
                        }</div>
                }
                @if (cr.Active.Count == 0) { <div class="muted">No crisis is active.</div> }
                @if (cr.Causable.Count > 0) { <div class="flag">Ripe to be lit, by you or by a rival: @string.Join(", ", cr.Causable)</div> }
                @if (m.GreatCrisis is { } gc) { <div class="kv" title="How near the Reach is to the next stage of its great war. Before the war it rises each year by what is wrong with the Reach (the Senate window lists what) and falls back when nothing is; once the war has begun it runs on, faster the more wars there are. The second figure is where the next stage begins."><span>@gc.Name</span><b>@(gc.Resolved ? "resolved" : gc.Stage ?? "not yet") · @gc.Clock@(gc.NextAt != null ? $"/{gc.NextAt}" : "")</b></div> }
            </section>
        }
        </div>
    </div>
    }
    else
    {
    <div class="dash-grid senate2-grid">
        <div class="deck-col">
        @if (sen == null) { <section class="panel resolutions"><div class="muted">The Senate does not sit in this age.</div></section> }
        else if (_view == "chamber") { <section class="panel resolutions">
            @if (sen.Docket.Count > 0 || sen.History.Count > 0) { <h3><Icon Name="influence" Size="13" /> Before the chamber <span class="muted">voted at the year's end · by weight of seats · a tie fails</span></h3> }
                @if (sen.Docket.Count == 0) { <div class="empty-line">Nothing is before the Senate this year.@(sen.MayPropose ? " What you could move is under Move a motion; one moved now is voted at the end of next year." : "")</div> }
                @foreach (var mo in sen.Docket)
                {
                    int total = Math.Max(1, mo.ForWeight + mo.AgainstWeight);
                    var motionNow = w.Motions.FirstOrDefault(x => x.Id == mo.Id); bool motionHeld = motionNow?.HeldOver == true; int motionChair = motionNow?.Chair ?? 0;
                    bool tied = mo.ForWeight == mo.AgainstWeight && mo.ForWeight > 0; var presides = LadderSystem.Presiding(w);
                    bool chairCarries = tied && presides != null && (presides.HouseId == house.Id ? mo.MyStance : mo.Stances.FirstOrDefault(x => x.HouseId == presides.HouseId)?.Stance ?? 0) > 0;
                    <div class="motion @(mo.AgainstMe ? "against" : mo.Mine ? "mine" : mo.Petition ? "petition" : "") @(watched?.Id == mo.Id ? "watched" : "")" @onclick="() => _watch = mo.Id">
                        <div class="mo-head"><b>@mo.KindName</b> <span class="muted small">@(mo.Petition ? "the petition of" : "moved by") <span style="color:@mo.ProposerAccent">@mo.ProposerName</span> · vote @(mo.ProposedTurn < w.Turn ? "at the end of this year" : "next year")@(motionHeld ? " · held over by the Speaker" : "")@(motionChair != 0 ? $" · the chair has spoken {(motionChair > 0 ? "for" : "against")} it" : "")</span></div>
                        <div class="mo-text">@mo.Text</div>
                        @{ int patronWish = motionNow != null ? senate.PatronWish(w, motionNow, house.Id) : 0; }
                        @if (patronWish != 0) { <div class="small warn">Your patron, @(w.House(house.PatronId)?.Name), wants this @(patronWish > 0 ? "carried" : "thrown out"). How you vote will be noticed.</div> }
                        @if (motionNow != null && senate.Motions.Def(motionNow.Kind) is { } wishDef)
                        {
                            /* the houses you hold a province under, and what each wants of this motion (docs/PLAYTHROUGH.md, Medium, The Senate, P90) */
                            foreach (var ow in ProvinceSystem.Wishes(w, c.Holdings, motionNow, wishDef.Interest, wishDef.Target == "house", house.Id))
                            {
                                <div class="small warn" data-overlord-wish="@ow.over.Id">@ow.over.Name, which you hold @ow.province under, wants this @(ow.want > 0 ? "carried" : "thrown out"). Vote its way and its head thinks @SenateSystem.ObligeRegard the better of you@(ow.defied > 0 ? " and one of your votes against it is forgotten" : ""); vote the other way and it thinks @Math.Abs(SenateSystem.DefyRegard) the worse. You have voted against it @Counted.Times(ow.defied) on what touched it: at @ow.bears, if it is at least your match in arms and at peace, it asks for the province back.</div>
                            }
                        }
                        <div class="tally"><span class="for" style="width:@(100 * mo.ForWeight / total)%"></span><span class="against" style="width:@(100 * mo.AgainstWeight / total)%"></span></div>
                        <div class="small tally-line"><b class="@(mo.ForWeight > mo.AgainstWeight || chairCarries ? "good" : "warn")">@(mo.ForWeight > mo.AgainstWeight ? "Carries" : chairCarries ? $"Tied: carries on the casting vote of {presides!.Name}, presiding," : tied && presides != null ? $"Tied: fails, since {presides.Name}, presiding, is not for it," : mo.ForWeight == mo.AgainstWeight ? "Tied: fails" : "Fails") as the benches lean</b> <span class="muted">· for @mo.ForWeight · against @mo.AgainstWeight</span></div>
                        @if (motionNow != null)
                        {
                            bool declared = motionNow.Votes.TryGetValue(house.Id, out var myVote); int myLean = Math.Sign(senate.Lean(w, motionNow, house.Id));
                            <div class="small @(declared ? "good" : "muted")" data-myvote="@(declared ? myVote : 9)">@(declared ? $"You have declared {(myVote > 0 ? "for it" : myVote < 0 ? "against it" : "that you abstain")}. You may change it until the year ends." : $"You have not declared. Left alone, your house votes as it leans: {(myLean > 0 ? "for" : myLean < 0 ? "against" : "it abstains")}.")</div>
                            var paid = motionNow.BoughtBy.Where(kv => kv.Value == house.Id).Select(kv => (w.House(kv.Key)?.Name ?? kv.Key) + (motionNow.Bought.GetValueOrDefault(kv.Key) > 0 ? " (for)" : " (against)")).ToList();
                            @if (paid.Count > 0) { <div class="small warn" data-bought="@paid.Count">Votes you have paid for on this motion: @string.Join(", ", paid). One time in @SenateSystem.BribeOutOneIn each comes out at the count.</div> }
                        }
                        <div class="row small">
                            @foreach (var (stance, label) in new[] { (1, "Vote for"), (-1, "Vote against"), (0, "Abstain") })
                            { <button class="opt inline @(mo.MyStance == stance ? "here" : "")" @onclick="() => G.Execute(new VoteCommand(pid, mo.Id, stance))" @onclick:stopPropagation="true">@label</button> }
                            @if (LadderSystem.SpeakerOf(w)?.Id == pid) { var holdNo = LadderSystem.ChairRefusal(w, p, motionNow, LadderSystem.HoldMotion); <button class="opt inline veto" disabled="@(holdNo != null)" title="@(holdNo ?? "As Speaker: it is not reached this year, and is voted next year. Once a year; whoever moved it will not thank you.")" @onclick="() => G.Execute(new ChairCommand(pid, mo.Id, LadderSystem.HoldMotion, G.Turn!.Senate))" @onclick:stopPropagation="true">Hold it over</button> }
                            @if (presides?.Id == pid)
                            {
                                var forNo = LadderSystem.ChairRefusal(w, p, motionNow, LadderSystem.SpeakFor); var againstNo = LadderSystem.ChairRefusal(w, p, motionNow, LadderSystem.SpeakAgainst);
                                <button class="opt inline" disabled="@(forNo != null)" title="@(forNo ?? "As presiding consul: the houses lean with the chair. Once a year.")" @onclick="() => G.Execute(new ChairCommand(pid, mo.Id, LadderSystem.SpeakFor, G.Turn!.Senate))" @onclick:stopPropagation="true">Speak for it from the chair</button>
                                <button class="opt inline" disabled="@(againstNo != null)" title="@(againstNo ?? "As presiding consul: the houses lean with the chair. Once a year.")" @onclick="() => G.Execute(new ChairCommand(pid, mo.Id, LadderSystem.SpeakAgainst, G.Turn!.Senate))" @onclick:stopPropagation="true">Speak against it</button>
                            }
                            @if (sen.Election is { AmConsul: true }) { <button class="opt inline veto" disabled="@(mo.VetoRefusal != null)" title="@(mo.VetoRefusal ?? "the consul's veto: struck from the docket, once a term")" @onclick='() => G.AskDo("Veto this motion?", mo.Text + " It is struck from the docket and cannot be moved again this term. A consul has one veto a term: this spends yours. The house that moved it will not thank you.", "Veto it", new VetoCommand(pid, mo.Id, c.Offices, G.Turn!.Senate))' @onclick:stopPropagation="true">Veto</button> }
                        </div>
                        <details @onclick:stopPropagation="true"><summary>The benches · whip them</summary>
                            @{ int margin = mo.ForWeight - mo.AgainstWeight; int side = mo.MyStance >= 0 ? 1 : -1; }
                            <div class="small" data-margin="@margin">As the benches lean it @(margin > 0 ? $"carries by {margin}" : margin < 0 ? $"fails by {-margin}" : "is tied, and a tie fails unless the chair is for it"), by weight of seats. A house that goes from one side to the other moves that by twice its seats; one that goes to abstaining, or comes from it, by its seats. A whip is worth @SenateSystem.LobbyWeight to a house's lean and a bought vote @SenateSystem.BribeWeight; a house votes for above nought, against below it, and abstains at nought.</div>
                            @foreach (var st in mo.Stances.Take(16))
                            {
                                var why = motionNow != null ? senate.Why(w, motionNow, st.HouseId) : new List<(string why, int by)>(); int leanNow = why.Sum(x => x.by);
                                <div class="bench-row">
                                    <Sigil HouseId="@st.HouseId" Accent="@st.Accent" Size="12" /> <span class="bn" title="@(st.Faction != null ? $"{st.HouseName} · {st.Faction}{(st.FactionLeader ? " (leads)" : "")}" : st.HouseName)">@st.HouseName@(st.Faction != null ? (st.FactionLeader ? " ★" : " ·") : "")</span><span class="wt muted">@st.Weight</span>
                                    <span class="stance @(st.Stance > 0 ? "for" : st.Stance < 0 ? "against" : "")" title="@(st.Declared ? "declared" : "leaning — a whip may move it")">@(st.Stance > 0 ? "for" : st.Stance < 0 ? "against" : "abstains")@(st.Declared ? "" : "?")</span>
                                    <button class="opt inline tiny" disabled="@(st.LobbyRefusal != null)" title="@(st.LobbyRefusal ?? "1 influence. " + MoveSays(st, leanNow, side, SenateSystem.LobbyWeight))" @onclick="() => G.Execute(new LobbyCommand(pid, mo.Id, st.HouseId, mo.MyStance >= 0 ? 1 : -1))">whip</button>
                                    <button class="opt inline tiny" disabled="@(st.BribeRefusal != null)" title="@(st.BribeRefusal ?? BribeTip(st))" @onclick="() => AskBribe(mo.Id, st, mo.MyStance >= 0 ? 1 : -1)">bribe · @Money.Show(st.BribePrice)</button>
                                </div>
                                @if (why.Count > 0) { <div class="bench-why muted small" data-why-vote="@st.HouseId">leans @Signed(leanNow): @string.Join("; ", why.Take(3).Select(x => $"{x.why} ({Signed(x.by)})"))@(why.Count > 3 ? $"; and {Counted.LesserThings(why.Count - 3)} ({Signed(why.Skip(3).Sum(x => x.by))})" : "")</div> }
                            }
                            <div class="muted small">Whipping leans a house toward your own stance (for, unless you voted against).</div>
                        </details>
                    </div>
                }
                @if (sen.History.Count > 0)
                {
                    <details open="@(sen.Docket.Count == 0)"><summary>Decided lately · @sen.History.Count</summary>
                        @foreach (var h in sen.History) { <div class="muted small hist"><b class="@(h.Passed ? "good" : "warn")">@(h.Vetoed ? $"vetoed by {h.VetoedBy}" : h.Passed ? "carried" : "thrown out")</b> @(h.Vetoed ? "" : $"{h.ForWeight}–{h.AgainstWeight} · ")turn @h.ProposedTurn · @h.Text@(h.Swing.Length > 0 ? " (" + h.Swing + ")" : "")</div> }
                    </details>
                }
        </section> }
        else if (_view == "move") { <section class="panel resolutions">
                <h3>Move a motion</h3>
                @{ var oweMe = WealthSystem.OweMe(w, house.Id); var iOwe = WealthSystem.IOwe(w, house.Id); }
                @if (oweMe.Count + iOwe.Count > 0)
                {
                    <div class="small" data-favours="@(oweMe.Count + iOwe.Count)">
                        @if (oweMe.Count > 0) { <span><b>Owe you a favour:</b> @string.Join(", ", oweMe.Select(h => $"{h.Name} ({FavourLeft(w, h.Id, house.Id)})")). Each leans @Signed(WealthSystem.FavourLeanBy) for the next motion you move, and the favour is spent at that vote. To call one in for something else, see House, under what is owed. </span> }
                        @if (iOwe.Count > 0) { <span><b>You owe a favour to:</b> @string.Join(", ", iOwe.Select(h => $"{h.Name} ({FavourLeft(w, house.Id, h.Id)})")). Vote for that house's next motion and the account is even; vote otherwise and its head remembers who kept the gift.</span> }
                    </div>
                }
                <div class="propose @(sen.MayPropose || _showForms ? "" : "cannot")">@if (!sen.MayPropose) { <div class="muted" data-cannot-move="1">Your house may not move a motion yet: @NoSeatLine(w).TrimStart('·', ' '). <button class="opt inline tiny" @onclick="() => _showForms = !_showForms">@(_showForms ? "Hide the motions" : "Show what could be moved, " + sen.Proposals.Count + " kinds")</button></div> }
                    @foreach (var pr in sen.Proposals)
                    {
                        <div class="proposal">
                            <div><b>@pr.KindName</b> <span class="muted small">(@pr.Influence influence)</span> <span class="muted small">@pr.Description</span>
                                @if (senate.Motions.Def(pr.KindId) is { } mdef && CourtProjection.MotionDoes(mdef) is { Length: > 0 } does) { <div class="small" data-motion-does="@pr.KindId">@does A motion is voted at the end of the year after it is moved.</div> }</div>
                            @if (ForecastSays(pr) is { Length: > 0 } fare) { <div class="small" data-motion-fare="@pr.KindId">@fare</div> }
                            @foreach (var (ab, asWhat) in AskAbove.Above(w, house.Id))
                            {
                                /* your patron or your bench's leader may move it in its own name: the way a house with no voice gets a
                                   motion onto the floor (docs/PLAYTHROUGH.md, Medium, The Senate, P6) */
                                var askMove = AskMoveCmd(pr, ab.Id); string? askMoveNo = askMove.Refusal(G.Ctx); string abName = ab.Name;
                                <div class="small" data-ask-move="@(pr.KindId + "|" + ab.Id)">
                                    <button class="opt inline tiny" disabled="@(askMoveNo != null)" title="@(askMoveNo ?? $"{ab.Name}, {asWhat}, moves it in its own name and at its own cost in influence, with the choices made here. It is counted as that house's motion: the houses lean as they think of {ab.Name}, not of you. You owe it a favour for it.")" @onclick='() => G.Ask("Ask " + abName + " to move it?", abName + " moves this motion in its own name, with the choices made here. The houses lean as they think of " + abName + ", not of you. You owe it a favour: vote for the next motion it moves and the account is even.", "Ask", () => G.Execute(askMove))'>Ask @ab.Name to move it</button>
                                    @if (askMoveNo != null) { <span class="muted">@char.ToUpperInvariant(askMoveNo[0])@askMoveNo[1..].</span> }
                                </div>
                            }
                            @if (pr.NeedsLaw && pr.Laws != null)
                            {
                                <select class="sel" @onchange="e => SetLaw(pr.KindId, e)">
                                    <option value="">— which law of the Reach —</option>
                                    @foreach (var grp in pr.Laws.GroupBy(l => l.Category)) { <optgroup label="@grp.Key" data-act-category="@grp.Key">@foreach (var l in grp) { <option value="@l.Id">@l.Name · now @l.Options.First(o => o.Id == l.InForce).Name.ToLowerInvariant()</option> }</optgroup> }
                                </select>
                                @if (ActLaw(pr) is { } al)
                                {
                                    <div class="muted small">@al.Description</div>
                                    <select class="sel" @onchange="e => SetOption(pr.KindId, e)">
                                        <option value="">— be set to —</option>
                                        @foreach (var o in al.Options.Where(o => o.Id != al.InForce)) { <option value="@o.Id">@o.Name — @o.Effects@(o.Opinions.Length > 0 ? " · " + o.Opinions : "")</option> }
                                    </select>
                                }
                                <button class="opt inline" disabled="@(!CanMoveAct(pr))" title="@ActRefusal(pr)" @onclick="() => MoveAct(pr.KindId)">Move it</button>
                                @if (ActRefusal(pr) is { } ar && ActOption(pr) != null) { <span class="muted small">@ar</span> }
                            }
                            else if (pr.TargetType == "none") { <button class="opt inline" disabled="@(pr.Refusal != null)" title="@pr.Refusal" @onclick="() => MoveNone(pr.KindId)">Move it</button> }
                            else
                            {
                                <select class="sel" @onchange="e => SetTarget(pr.KindId, e)">
                                    <option value="">— choose @(pr.TargetType == "house" ? "a house" : pr.TargetType == "nation" ? "a nation beyond the Reach" : pr.TargetType == "edict" ? "an edict in force" : "a region") —</option>
                                    @foreach (var t in pr.Targets) { <option value="@t.Id">@t.Name</option> }
                                </select>
                                @if (pr.NeedsOffice && pr.Offices != null)
                                {
                                    <select class="sel" @onchange="e => SetOffice(pr.KindId, e)">
                                        <option value="">— which office —</option>
                                        @foreach (var o in pr.Offices) { <option value="@o.Id">@o.Name</option> }
                                    </select>
                                }
                                { string? tno = TargetRefusal(pr); <button class="opt inline" disabled="@(tno != null)" title="@tno" @onclick="() => MoveTarget(pr.KindId)">Move it</button> @if (tno != null && !string.IsNullOrEmpty(_target.GetValueOrDefault(pr.KindId))) { <span class="muted small" data-motion-no>@tno</span> } }
                            }
                        </div>
                    }
                </div>
        </section> }
        </div>
        <div class="deck-col">
        @if (_view == "chamber") {
        <section class="panel chamber">
            <h3><Icon Name="influence" Size="13" /> The chamber <span class="muted">@(watched != null ? $"seats coloured by their lean on: {watched.KindName}" : "each dot a seat, in its bench's colour · yours are ringed · click one for its house")</span></h3>
            <svg class="hemicycle" viewBox="0 0 1000 540" role="img" aria-label="the Senate's seats">
                <defs><radialGradient id="floor" cx="50%" cy="100%" r="70%"><stop offset="0" stop-color="#1b2234" /><stop offset="1" stop-color="#0a0e16" /></radialGradient></defs>
                <path d="M 40 520 A 460 460 0 0 1 960 520 Z" fill="url(#floor)" stroke="#2a3348" />
                <path d="M 440 520 A 60 60 0 0 1 560 520 Z" fill="#1d1a12" stroke="#8a6c2a" />
                <text x="500" y="508" text-anchor="middle" class="rostrum">@(sen?.Offices?.FirstOrDefault(o => o.Id == "speaker")?.HolderName ?? "the rostrum")</text>
                @foreach (var seat in seats)
                {
                    int st = watched != null && stanceOf.TryGetValue(seat.houseId, out var sv) ? sv : 0;
                    string cls = (seat.houseId == house.Id ? "mine " : "") + (seat.houseId == _focus ? "focus " : "") + (watched == null ? "" : st > 0 ? "for" : st < 0 ? "against" : "abstain");
                    <circle cx="@seat.x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" cy="@seat.y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" r="8.5" class="seat @cls" style="fill:@(seatFill.TryGetValue(seat.houseId, out var sf) ? sf : seat.accent)" @onclick="() => _focus = seat.houseId"><title>@seat.name · @Counted.Seats(seat.weight)@(seat.bench != null ? $" · {seat.bench}" : "")</title></circle>
                }
            </svg>
            <div class="chamber-legend">
                @foreach (var f in benches)
                {
                    int wt = f.Members.Sum(x => senate.Weight(w, x)); var lh = w.House(f.LeaderHouseId);
                    <span class="lg @(f.Members.Contains(house.Id) ? "mine" : "")" title="led by @(lh?.Name ?? f.LeaderHouseId) · @string.Join(", ", f.Members.Select(x => w.House(x)?.Name ?? x))"><i style="background:@(f.Accent.Length > 0 ? f.Accent : lh?.AccentColor ?? "#888")"></i>@f.Name <b>@wt</b></span>
                }
                <span class="lg"><i class="none"></i>unaffiliated <b>@ordered.Where(x => x.bench == null).Sum(x => x.weight)</b></span>
                @if (watched != null) { <span class="lg key"><i class="for"></i>for <i class="against"></i>against <i class="abstain"></i>abstains</span> }
                @if (sen != null && sen.Docket.Count > 1) { <span class="lg">show lean on: @foreach (var d in sen.Docket) { <button class="opt inline tiny @(watched?.Id == d.Id ? "here" : "")" @onclick="() => _watch = d.Id">@d.KindName</button> }</span> }
            </div>
            @if (focusHouse != null)
            {
                var rel = focusHead != null ? w.GetRelationship(focusHead.Id, pid) : null; int d = rel?.Disposition ?? 0; var cn = focusHead != null ? m.Connections.FirstOrDefault(x => x.Id == focusHead.Id) : null;
                var fb = FactionSystem.Of(w, focusHouse.Id);
                <div class="seat-card">
                    @if (focusHead != null) { <Portrait Id="@focusHead.Id" Name="@focusHead.Name" Sex="@focusHead.Sex" Age="@focusHead.Age" Accent="@focusHouse.AccentColor" Size="56" /> }
                    <div class="sc-body">
                        <div class="sc-name"><Sigil HouseId="@focusHouse.Id" Accent="@focusHouse.AccentColor" Size="14" /> @focusHouse.Name <span class="muted">@(c.Titles.NameOf(focusHouse.Title, G.World!.Era)) · @Counted.Seats(senate.Weight(w, focusHouse.Id))@(fb != null ? $" · {fb.Name}{(fb.LeaderHouseId == focusHouse.Id ? " (leads)" : "")}" : "")</span></div>
                        <div class="muted small">@(focusHead != null ? $"{focusHead.Name}, {c.Careers.RankName(focusHead.CareerTrack, focusHead.CareerRank, G.World!.Era) ?? "head"}" : "no head") · legitimacy @focusHouse.Legitimacy · @string.Join(" · ", focusHouse.SphereInfluence.Where(k => k.Value > 0).Select(k => $"{k.Key} {k.Value}"))
                            @if (focusHouse.Id != house.Id) { <span> · <span class="@(d < -20 ? "warn" : d > 20 ? "good" : "")">disposition @d</span>@(w.AtWar(house.Id, focusHouse.Id) ? " · AT WAR" : "")</span> }</div>
                        @if (watched != null && focusStance != null && focusHouse.Id != house.Id)
                        {
                            <div class="small">On @watched.KindName: <b class="@(focusStance.Stance > 0 ? "good" : focusStance.Stance < 0 ? "warn" : "")">@(focusStance.Stance > 0 ? "for" : focusStance.Stance < 0 ? "against" : "abstains")@(focusStance.Declared ? "" : " (leaning)")</b>
                                <button class="opt inline tiny" disabled="@(focusStance.LobbyRefusal != null)" title="@(focusStance.LobbyRefusal ?? "1 influence: lean them your way")" @onclick="() => G.Execute(new LobbyCommand(pid, watched.Id, focusHouse.Id, watched.MyStance >= 0 ? 1 : -1))">whip</button>
                                <button class="opt inline tiny" disabled="@(focusStance.BribeRefusal != null)" title="@(focusStance.BribeRefusal ?? BribeTip(focusStance))" @onclick="() => AskBribe(watched.Id, focusStance, watched.MyStance >= 0 ? 1 : -1)">bribe · @Money.Show(focusStance.BribePrice)</button></div>
                        }
                        @if (cn != null) { <div class="sc-actions">@foreach (var o in TreatyFirst(cn.Actions)) { <button class="opt inline tiny" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => AskConn(o.Id, o.Label, cn.Id)">@o.Label</button> }</div> }
                    </div>
                    <button class="win-close" @onclick="() => _focus = null">✕</button>
                </div>
            }
            <div class="muted small" data-sphere-legend>The three estates of the Reach. A house's weight in each is the ranks of its family serving on that track, added up; each bar is cut by house, yours outlined. Weight in the Senate is also what your vote counts for in the chamber. A share well above an even split is what makes the other houses fear you.</div>
            <div class="spheres-row">
                @foreach (var sp in spheres)
                {
                    var shares = w.Houses.Values.Select(h => (h, v: h.SphereInfluence.TryGetValue(sp, out var v) ? v : 0)).Where(x => x.v > 0).OrderByDescending(x => x.v).ToList(); int total = Math.Max(1, shares.Sum(x => x.v));
                    var def = c.Spheres.IsEmpty ? null : c.Spheres.Defs.FirstOrDefault(x => x.Id == sp);
                    <div class="sphere" title="@SphereTip(sp, def?.Name ?? sp)">
                        <div class="sphere-head"><b>@(def?.Name ?? sp)</b> <span class="muted">your weight @(house.SphereInfluence.TryGetValue(sp, out var mine) ? mine : 0) of @total</span></div>
                        <div class="sphere-bar">@foreach (var x in shares) { <i style="width:@(100.0 * x.v / total)%; background:@x.h.AccentColor" title="@x.h.Name @x.v" class="@(x.h.Id == house.Id ? "mine" : "")"></i> }</div>
                    </div>
                }
            </div>
        </section>
        }
        @if (sen?.Election is { } el)
        {
            var consuls = sen.Offices?.Where(o => o.Elected).ToList() ?? new List<OfficeCard>();
        @if (_view == "consuls") {
            <section class="panel consulship">
                <h3><Icon Name="throne" Size="13" /> The consulship <span class="muted">elected every @el.TermTurns years · @(el.NextIn == 0 ? "the next at the end of this year" : el.NextIn == 1 ? "the next at the end of next year" : "the next in " + el.NextIn + " years")</span></h3>
                @foreach (var o in consuls)
                {
                    <div class="off-card @(o.Mine ? "mine" : "") @(o.HolderHouse == null ? "vacant" : "")" title="@o.Description">
                        <div class="of-head"><b>@o.Name</b> <span class="muted small">weight +@(o.Id == "consul_senior" ? 4 : 3) · the veto</span></div>
                        <div class="small">@if (o.HolderHouse != null) { <Sigil HouseId="@o.HolderHouseId" Accent="@o.HolderAccent" Size="12" /> <span>@o.HolderName of @o.HolderHouse</span> <span class="muted">since turn @o.Since</span> } else { <span class="muted">vacant until the election</span> }</div>
                    </div>
                }
                @{
                    var em = w.Emergency; string? danger = EmergencySystem.Danger(w); var emHolder = em != null ? w.Char(em.HolderId) : null; bool emMine = em != null && em.HolderId == pid;
                    string? askNo = new ProposeMotionCommand(pid, "emergency", house.Id, senate).Refusal(G.Ctx), lifeNo = new ProposeMotionCommand(pid, "for_life", house.Id, senate).Refusal(G.Ctx);
                    string? levyNo = new EmergencyCommand(pid, EmergencyCommand.Levy).Refusal(G.Ctx), layNo = new EmergencyCommand(pid, EmergencyCommand.LayDown).Refusal(G.Ctx);
                }
                @if (em != null)
                {
                    <div class="off-card emergency @(emMine ? "mine" : "")" title="While the powers run the other consul has no veto, the holder may strike one motion a year, the Senate leans toward what the holder moves, the houses can be levied without a vote, and no election is held. They are to be laid down when the term is up or the danger is past.">
                        <div class="of-head"><b>Emergency powers</b> <span class="muted small">voted for @em.Cause · @(em.Due ? (em.KeptYears > 0 ? $"kept {Counted.Years(em.KeptYears)} past leave" : "due to be laid down") : $"until year {em.Until}")@(em.Renewals > 0 ? $" · extended {Counted.Times(em.Renewals)}" : "")</span></div>
                        <div class="small">@(emHolder?.Name ?? "A consul") of @(w.House(em.HouseId)?.Name) holds them, since year @em.Since.@(emMine && em.Due ? $" Each year you keep them costs the Reach's trust, your house's standing and every head's regard; after {EmergencySystem.KeptMax} the Senate takes them." : "")</div>
                        @if (emMine)
                        {
                            <div class="suit-acts">
                                <button class="opt inline" disabled="@(layNo != null)" title="@(layNo ?? $"Give them back. Your house gains {EmergencySystem.LaidDownStanding} standing (two more if it is before they are due), the Reach trusts its magistrates more, and every head thinks better of you. Nothing is gained if you have kept them past leave.")" @onclick="() => G.Execute(new EmergencyCommand(pid, EmergencyCommand.LayDown))">Lay them down</button>
                                <button class="opt inline" disabled="@(levyNo != null)" title="@(levyNo ?? $"Every other house pays up to {Money.Credits(EmergencySystem.LevyCredits)} to yours, without a vote. Each head thinks the worse of you, and the Reach a little less of its magistrates. Once a year.")" @onclick="() => G.Execute(new EmergencyCommand(pid, EmergencyCommand.Levy))">Levy on the houses</button>
                                <button class="opt inline" disabled="@(askNo != null)" title="@(askNo ?? "Put it to the Senate that the powers run three years more. Each time you ask, the houses are slower to agree.")" @onclick='() => MoveSelf("emergency")'>Ask for more time</button>
                                <button class="opt inline veto" disabled="@(lifeNo != null)" title="@(lifeNo ?? "Put it to the Senate that you hold them for life. If it carries, the Republic ends by its own vote and you rule. If it fails, the Senate ends the powers in the same breath and your house is disgraced.")" @onclick='() => MoveSelf("for_life")'>Ask for them for life</button>
                            </div>
                        }
                    </div>
                }
                else if (danger != null)
                {
                    <div class="muted small">The Reach is in danger: @danger. The Senate may be asked to give a consul its emergency powers for @EmergencySystem.Years years.
                        @if (el.AmConsul) { <button class="opt inline" disabled="@(askNo != null)" title="@(askNo ?? "Put it to the Senate. The graver the danger the readier it is; a consul it fears is refused.")" @onclick='() => MoveSelf("emergency")'>Ask for them</button> }</div>
                }
                <h4>The nominees as they stand</h4>
                @foreach (var n in el.Nominees) { <div class="nominee"><i class="party-dot" style="background:@n.PartyAccent"></i><Sigil HouseId="@n.HouseId" Accent="@n.Accent" Size="13" /> <span><b>@n.HouseName</b> <span class="muted small">for @n.Party</span></span><b class="tally-n">@n.Tally</b>@{ var nid = n.HouseId; var canvassNo = G.Turn!.Orders.CanvassRefusal(w, house, nid, el.Nominees.Select(x => x.HouseId)); }<button class="opt inline tiny" disabled="@(canvassNo != null)" title="@(canvassNo ?? "largesse in the candidate's name: one more vote's weight at the election")" @onclick="() => Canvass(nid)">Canvass · @Money.Show(OrderSystem.CanvassCredits)</button></div> }
                @if (el.Nominees.Count == 0) { <div class="muted small">No house of standing has a candidate yet.</div> }
                else { <div class="small" data-election-chances="1">@ChancesSay(el, c.Offices)</div> }
                @if (el.Nominees.Count > 0 && !el.Standing && !el.AmConsul)
                {
                    /* your seats can be pledged to a nominee (docs/PLAYTHROUGH.md, Medium, The Senate, P59) */
                    string? pledged = ElectionSystem.PledgedTo(w, house.Id);
                    <div class="suit-acts" data-pledge="@(pledged ?? "")">
                        <span class="small">@(pledged != null ? "Your seats are pledged to " + (w.House(pledged)?.Name ?? pledged) + "." : "Your " + Counted.Seats(G.Turn!.Senate.Weight(w, house.Id)) + " " + Counted.Go(G.Turn!.Senate.Weight(w, house.Id)) + " as your bench or your patron has it. Pledge them to:")</span>
                        @if (pledged != null)
                        {
                            var back = new PledgeVotesCommand(pid, string.Empty, c.Offices, G.Turn!.Senate);
                            <button class="opt inline tiny" title="@($"Its head thinks {ElectionSystem.UnpledgeRegard} the worse of you for it.")" @onclick="() => G.Execute(back)">Take the pledge back</button>
                        }
                        else
                        {
                            @foreach (var n in el.Nominees.Where(x => x.HouseId != house.Id))
                            {
                                var pl = new PledgeVotesCommand(pid, n.HouseId, c.Offices, G.Turn!.Senate); string? plNo = pl.Refusal(G.Ctx); string nname = n.HouseName;
                                <button class="opt inline tiny" data-pledge-to="@n.HouseId" disabled="@(plNo != null)" title="@(plNo ?? pl.Says(w))" @onclick='() => G.Ask("Pledge your seats to " + nname + "?", pl.Says(w), "Pledge them", () => G.Execute(pl))'>@n.HouseName</button>
                            }
                        }
                    </div>
                }
                @if (!el.AmConsul && FactionSystem.Of(w, house.Id) is { } ownBench && ElectionSystem.BenchContest(w, c.Offices, id => G.Turn!.Senate.Weight(w, id), ownBench) is { rivalId.Length: > 0 } bc)
                {
                    /* whom the bench would put forward, you or another of it (docs/PLAYTHROUGH.md, Medium, The Senate, P87) */
                    string rivalName = w.House(bc.rivalId)?.Name ?? bc.rivalId; string Names(List<string> ids) => ids.Count == 0 ? "its own seats only" : "with " + string.Join(", ", ids.Select(x => w.House(x)?.Name ?? x));
                    <div class="small" data-bench-nomination="@(bc.won ? "yours" : "theirs")">
                        <b>Inside @ownBench.Name.</b>
                        @if (ownBench.LeaderHouseId == house.Id) { <span>You lead the bench: its nomination is yours when you stand.</span> }
                        else
                        {
                            <span>@(el.Standing ? "You have declared, and the bench" : "If you declared, the bench") @(bc.won ? "puts you forward" : "puts " + rivalName + " forward, not you"): @bc.mine of its seats behind you (@Names(bc.forMine)), @bc.rival behind @rivalName (@Names(bc.forRival)). Each other member backs whichever of you its head thinks the better of.@(bc.won ? "" : " You may still stand alone against the bench's nominee, with your own seats and whatever is pledged to you; the rest of the bench votes for " + rivalName + ".")</span>
                        }
                    </div>
                }
                <button class="opt" disabled="@(el.StandRefusal != null)" title="@(el.StandRefusal ?? StandSays(c.Offices))" @onclick="() => G.Execute(new StandForConsulCommand(pid, c.Offices))">@(el.AmConsul ? ConsulIs(c.Offices) : StandWord(c.Offices, el.Standing))</button>
                @if (el.AmConsul)
                {
                    <div class="muted small">@(el.CanVeto ? "Your veto is unspent this term: strike a motion from the docket above." : "Your veto is spent this term.")</div>
                    <div class="small" data-consul-year>A consul has a charge every year (render the Reach's account, sweep its most lawless region, or see to your bench's business), may speak from the chair on one motion, and decides a tied Senate. <button class="opt inline tiny" @onclick='() => _view = "duties"'>Your duties ▸</button></div>
                }
            </section>
        }
        }
        </div>
    </div>
    }
</div>


@code {
    /* crossing the floor: say what leaving costs before it is done */
    private void AskCross(string benchId, string benchName)
    {
        var w = G.World!; string pid = w.ProtagonistId; var seated = FactionSystem.Of(w, w.Protagonist!.HouseId); if (seated == null) return;
        G.Ask("Cross the floor to " + benchName + "?", $"It costs {FactionSystem.JoinInfluence} influence. You leave {seated.Name}: {FactionSystem.WalkSays(w, seated)}. Your house is then counted with {benchName}: to vote against its leader's line is to break the whip.",
            "Cross the floor", () => G.Execute(new JoinFactionCommand(pid, benchId)));
    }
    private static string FavourLeft(Praetoria.Core.State.World w, string ower, string to)
    { int left = WealthSystem.FavourYears - (w.Turn - w.Counter(WealthSystem.FavourKey(ower, to))); return left <= 1 ? "forgotten after this year" : $"forgotten in {left} years"; }
    /* where the count for consul stands today: who would be elected, and how far the player's house is from it */
    private string ChancesSay(Praetoria.Core.Presentation.ElectionCard el, Praetoria.Core.Data.OfficeCatalog offices)
    {
        var w = G.World!; string mine = w.Protagonist!.HouseId; int seats = ElectionSystem.ConsulOffices(offices).Count();
        var order = el.Nominees.OrderByDescending(n => n.Tally).ThenBy(n => n.HouseId, StringComparer.Ordinal).ToList(); var winners = order.Take(seats).ToList();
        string said = $"As the houses would vote today, {string.Join(" and ", winners.Select(n => $"{n.HouseName} ({n.Tally})"))} would be elected: {seats} are chosen, the most votes first. A house votes for its own candidate, else the one it has pledged its seats to, else its patron's, else its bench's; a house on no bench for the candidate whose head it likes best.";
        int at = order.FindIndex(n => n.HouseId == mine);
        if (at < 0) return said + (el.Standing ? "" : " Your house has no candidate in the count.");
        if (at < seats) { int next = order.Count > seats ? order[seats].Tally : 0; return said + $" Your house is {(at == 0 ? "first" : "second")} with {order[at].Tally}, {order[at].Tally - next} clear of the first house left out."; }
        return said + $" Your house is {at + 1}{(at == 2 ? "rd" : "th")} with {order[at].Tally}: {winners[^1].Tally - order[at].Tally + 1} more would put it among the elected. A canvass adds one; a house that comes over to your bench, or takes you for patron, brings its seats.";
    }
    private static string Signed(int n) => n > 0 ? "+" + n : n < 0 ? "−" + (-n) : "0";
    private static string VoteWord(int lean) => lean > 0 ? "for" : lean < 0 ? "against" : "abstaining";
    /* what a whip or a bought vote would do to one house: where its lean goes, and whether its vote changes */
    private static string MoveSays(Praetoria.Core.Presentation.StanceLine st, int lean, int side, int worth)
    {
        int after = lean + side * worth; bool turns = Math.Sign(after) != Math.Sign(lean);
        return $"{st.HouseName} leans {Signed(lean)} and would lean {Signed(after)}: " + (turns ? $"it goes from {VoteWord(lean)} to {VoteWord(after)}, and its {Counted.Seats(st.Weight)} with it." : $"it is still {VoteWord(after)}. This one would change nothing in the count.");
    }
    /* who of the house would be consul: the head when qualified, else the relative who is, and the button says which */
    private Praetoria.Core.State.Character? Stands(Praetoria.Core.Data.OfficeCatalog offices)
    { var w = G.World!; var d = ElectionSystem.ConsulOffices(offices).FirstOrDefault(); return d == null ? null : OfficeSystem.Candidate(w, d, w.Protagonist!.HouseId); }
    private string StandWord(Praetoria.Core.Data.OfficeCatalog offices, bool standing)
    { var who = Stands(offices); bool me = who == null || who.Id == G.World!.ProtagonistId; return standing ? (me ? "You stand for consul" : $"{who!.Name} stands for consul") : me ? "Stand for consul" : $"Put {who!.Name} forward for consul"; }
    private string StandSays(Praetoria.Core.Data.OfficeCatalog offices)
    {
        var who = Stands(offices); string cost = $"{ElectionSystem.StandInfluence} influence: your party nominates {(who == null || who.Id == G.World!.ProtagonistId ? "you, or you run alone" : "your house, or it runs alone")}.";
        if (who == null || who.Id == G.World!.ProtagonistId) return cost;
        var d = ElectionSystem.ConsulOffices(offices).First();
        return $"{cost} You may not stand yourself: a consul must be {OfficeSystem.Wants(offices, d, G.World)}. {who.Name} of your house may, and it is {who.Name} who would be consul.";
    }
    private string ConsulIs(Praetoria.Core.Data.OfficeCatalog offices)
    {
        var w = G.World!; var mine = w.Protagonist!.HouseId;
        var who = ElectionSystem.ConsulOffices(offices).Select(d => OfficeSystem.Holding(w, d.Id)).FirstOrDefault(h => h?.HouseId == mine);
        return who == null || who.CharacterId == w.ProtagonistId ? "You hold the consulship" : $"{w.Char(who.CharacterId)?.Name ?? "Your house"} holds the consulship";
    }
    private static string SphereTip(string id, string name) => id switch
    {
        "navy" => $"Weight in {name}: the ranks of your family serving in the fleet, added up, and one more while you chair the committee on the fleet.",
        "treasury" => $"Weight in {name}: the ranks of your family serving in the administration, added up, and one more while you chair the committee on the purse.",
        "senate" => $"Weight in {name}: the ranks of your family at the law, plus one for each motion of yours the chamber has carried and less one for each it threw out, plus {Praetoria.Core.Systems.SphereSystem.CapitalSenateWeight} if you hold the capital and one while you chair the committee on the laws. With your title's rank, this is what your vote counts for.",
        _ => $"Weight in {name}: the ranks of your family serving on that track, added up.",
    };
    private string _view = "chamber";
    /// <summary>The tab an alert asked for, and a stamp that changes each time one asks; a stamp is used once.</summary>
    private static string BribeTip(StanceLine st) => $"{Money.Credits(st.BribePrice)} from the treasury to the head of {st.HouseName}: its own vote leans your way by {SenateSystem.BribeWeight}." + (st.FactionLeader ? " It leads a bench, but the bench was not paid and does not follow a bought vote." : "") + $" One time in {SenateSystem.BribeOutOneIn} it comes out at the count: the vote is struck and your house loses {SenateSystem.BribeOutLegitimacy} legitimacy.";
    private void AskBribe(string motionId, StanceLine st, int side) => G.Ask("Pay " + st.HouseName + " for its vote?", BribeTip(st), "Pay " + Money.Show(st.BribePrice), () => G.Execute(new LobbyCommand(G.World!.ProtagonistId, motionId, st.HouseId, side, bribe: true)));
    private bool _showForms;
    [Parameter] public string Tab { get; set; } = "";
    [Parameter] public int TabStamp { get; set; }
    private static int _seenStamp;
    protected override void OnParametersSet() { if (TabStamp != _seenStamp) { _seenStamp = TabStamp; if (Tab.Length > 0) _view = Tab; } }
    private static string Ordinal(int n) => n % 100 is 11 or 12 or 13 ? $"{n}th" : (n % 10) switch { 1 => $"{n}st", 2 => $"{n}nd", 3 => $"{n}rd", _ => $"{n}th" };
    private static string NoSeatLine(World w) => w.IsImperium ? "· only a house of rank, or a Judge, may" : "· the house has its votes but no voice: a voice comes by land of rank, a Judge at its head, a name great in arms, or enrolment by the census";
    private void Canvass(string nomineeId) { var names = G.Court().Senate?.Election?.Nominees.Select(x => x.HouseId).ToList() ?? new List<string>(); G.Execute(new CanvassCommand(G.World!.ProtagonistId, nomineeId, G.Turn!.Orders, _ => names)); }
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    private string? _focus, _watch; private readonly Dictionary<string, string> _target = new();
    private readonly Dictionary<string, string> _office = new();
    private void SetTarget(string kind, ChangeEventArgs e) => _target[kind] = e.Value?.ToString() ?? "";
    private void SetOffice(string kind, ChangeEventArgs e) => _office[kind] = e.Value?.ToString() ?? "";
    private readonly Dictionary<string, string> _law = new(), _lawOpt = new();
    private void SetLaw(string kind, ChangeEventArgs e) { _law[kind] = e.Value?.ToString() ?? ""; _lawOpt.Remove(kind); }
    private void SetOption(string kind, ChangeEventArgs e) => _lawOpt[kind] = e.Value?.ToString() ?? "";
    private ActLawChoice? ActLaw(MotionProposal pr) => pr.Laws?.FirstOrDefault(l => l.Id == _law.GetValueOrDefault(pr.KindId));
    private (string Id, string Name, string Effects, string? Refusal, string Opinions)? ActOption(MotionProposal pr) { var l = ActLaw(pr); var id = _lawOpt.GetValueOrDefault(pr.KindId); if (l == null || string.IsNullOrEmpty(id)) return null; var o = l.Options.FirstOrDefault(x => x.Id == id); return o.Id == null ? null : o; }
    private string? ActRefusal(MotionProposal pr) => ActOption(pr)?.Refusal ?? (ActOption(pr) == null ? "choose a law and what it should be" : null);
    private bool CanMoveAct(MotionProposal pr) => ActOption(pr) is { Refusal: null };
    private void MoveAct(string kind) => G.Execute(new ProposeMotionCommand(G.World!.ProtagonistId, kind, "", G.Turn!.Senate, lawId: _law.GetValueOrDefault(kind) ?? "", optionId: _lawOpt.GetValueOrDefault(kind) ?? ""));
    /* the refusal for the house, region or nation chosen in the form, not for whichever the list happened to begin with */
    private string? TargetRefusal(MotionProposal pr)
    {
        string t = _target.GetValueOrDefault(pr.KindId) ?? "", o = _office.GetValueOrDefault(pr.KindId) ?? "";
        if (t.Length == 0) return pr.TargetType == "house" ? "choose a house" : pr.TargetType == "nation" ? "choose a nation" : pr.TargetType == "edict" ? (pr.Targets.Count == 0 ? "no edict in force may be struck down" : "choose an edict") : "choose a region";
        if (pr.NeedsOffice && o.Length == 0) return "choose the office";
        return new ProposeMotionCommand(G.World!.ProtagonistId, pr.KindId, t, G.Turn!.Senate, o).Refusal(G.Ctx);
    }
    /* how a motion would stand if it were moved now: nothing is said until every choice the motion needs has been made */
    private string ForecastSays(MotionProposal pr)
    {
        var w = G.World!; var senate = G.Turn!.Senate; string mine = w.Protagonist!.HouseId;
        string t = _target.GetValueOrDefault(pr.KindId) ?? "", o = _office.GetValueOrDefault(pr.KindId) ?? "", law = _law.GetValueOrDefault(pr.KindId) ?? "", opt = _lawOpt.GetValueOrDefault(pr.KindId) ?? "";
        if (pr.NeedsLaw) { if (law.Length == 0 || opt.Length == 0) return ""; t = ""; }
        else if (pr.TargetType == "self") t = mine;
        else if (pr.TargetType != "none" && (t.Length == 0 || pr.NeedsOffice && o.Length == 0)) return "";
        var (f, a) = senate.Forecast(w, mine, pr.KindId, t, o, law, opt);
        return $"If it were moved now it would {(f > a ? $"carry by {f - a}" : f < a ? $"fail by {a - f}" : "be tied, and a tie fails unless the chair is for it")}: for {f}, against {a}, your own seats counted for. The vote is at the end of next year, and the benches can be whipped and will shift before then.";
    }
    private bool CanMove(MotionProposal pr) => !string.IsNullOrEmpty(_target.GetValueOrDefault(pr.KindId)) && (!pr.NeedsOffice || !string.IsNullOrEmpty(_office.GetValueOrDefault(pr.KindId)))
        && (pr.Refusal == null || pr.Refusal == "not against yourself" || pr.Refusal == "already before the Senate" || pr.Refusal.StartsWith("no one of") || pr.Refusal.EndsWith("holds it already"));
    /* the motion as chosen in the form, to be moved by a house above yours in its own name */
    private AskToMoveCommand AskMoveCmd(MotionProposal pr, string byHouseId)
    {
        string kind = pr.KindId; string t = pr.TargetType is "house" or "nation" or "region" or "edict" ? _target.GetValueOrDefault(kind) ?? "" : "";
        return new AskToMoveCommand(G.World!.ProtagonistId, byHouseId, kind, t, G.Turn!.Senate, _office.GetValueOrDefault(kind) ?? "", _law.GetValueOrDefault(kind) ?? "", _lawOpt.GetValueOrDefault(kind) ?? "");
    }
    private void MoveSelf(string kind) => G.Execute(new ProposeMotionCommand(G.World!.ProtagonistId, kind, G.World.Protagonist!.HouseId, G.Turn!.Senate));
    private void MoveNone(string kind) => G.Execute(new ProposeMotionCommand(G.World!.ProtagonistId, kind, "", G.Turn!.Senate));
    private void MoveTarget(string kind) => G.Execute(new ProposeMotionCommand(G.World!.ProtagonistId, kind, _target.GetValueOrDefault(kind) ?? "", G.Turn!.Senate, _office.GetValueOrDefault(kind) ?? ""));

    /// <summary>The hemicycle (Lawgivers-style): every seat on concentric arcs, filled left to right in bench order so each bench holds a wedge;
    /// seat k of N sits at angle fraction (k + ½)/N and on row k mod R, with R the fewest rows whose arcs hold N seats at a readable spacing.</summary>
    private static List<(double x, double y, string houseId, string name, string accent, int weight, string? bench)> Seats(List<(House h, int weight, Faction? bench)> ordered)
    {
        var list = new List<(double, double, string, string, string, int, string?)>();
        int n = Math.Max(1, ordered.Sum(x => x.weight)); const double cx = 500, cy = 520, r0 = 150, dr = 40, spacing = 23;
        int rows = 1; while (Enumerable.Range(0, rows).Sum(r => (int)(Math.PI * (r0 + r * dr) / spacing)) < n && rows < 12) rows++;
        int k = 0;
        foreach (var (h, weight, bench) in ordered)
            for (int i = 0; i < weight; i++, k++)
            {
                double t = (k + 0.5) / n, a = Math.PI - t * Math.PI; double rr = r0 + (k % rows) * dr;
                list.Add((cx + rr * Math.Cos(a), cy - rr * Math.Sin(a), h.Id, h.Name, h.AccentColor, weight, bench?.Name));
            }
        return list;
    }
    /* what a rung of the ladder asks: the standing; from Legate up, land or seats, and the Senate's vote on a petition */
    private static string RungTip(Praetoria.Core.Progression.TitleDef t)
    {
        if (t.LegitimacyRequirement <= 0) return string.Empty;
        string tip = $"needs legitimacy {t.LegitimacyRequirement}";
        if (t.Id == Praetoria.Core.Progression.Title.Emperor) return tip + ". It is not petitioned for: it is proclaimed, or taken";
        if (t.Rank < ProgressionSystem.LandedFromRank) return tip + ". A petition is granted to a house that has it";
        return tip + $", and {Counted.Worlds(ProgressionSystem.WorldsFor(t.Rank))} or {Counted.Seats(ProgressionSystem.SeatsFor(t.Rank))} in the Senate. A petition for it is voted by the Senate";
    }
    private static string PathWhy(PathOption p) { string r = p.Refusal ?? p.Tooltip; return r.Length == 0 ? r : char.ToUpperInvariant(r[0]) + r[1..] + "."; }
    /// <summary>A rise in rank is asked about first: what it is, what it costs, what follows (docs/PLAYTHROUGH.md 3).</summary>
    private void AskPath(PathOption p, string? next) => G.Ask(p.Label + (next != null ? ": " + next : ""), p.Confirm + " It costs " + p.Cost + ".", p.Label, () => G.Execute(PathCommand(p.Id)));
    private ICommand PathCommand(string id) { var pid = G.World!.ProtagonistId; var prog = G.Turn!.Progression!; return id switch { "seize" => new SeizeTitleCommand(pid, prog), "petition" => new PetitionTitleCommand(pid, prog), _ => new ClaimTitleCommand(pid, prog) }; }
    private void Damper(DamperOption d) { var crises = G.Turn!.Crises!; var def = crises.Def(d.CrisisId)!; G.Execute(new ApplyDamperCommand(G.World!.ProtagonistId, crises, def, def.Dampers.First(x => x.Id == d.DamperId))); }
    private void AskConn(string optionId, string label, string targetId) { if (optionId.StartsWith("marry:")) G.AskTreatyMarriage(label, Conn(optionId, targetId)); else G.AskAccident(label, Conn(optionId, targetId)); }
    /* a match by treaty: every one of yours the family would take today (three at most), or the first with why not; then the rest */
    private static IEnumerable<Option> TreatyFirst(IReadOnlyList<Option> actions)
    {
        var matches = actions.Where(o => o.Id.StartsWith("marry:")).ToList(); var willing = matches.Where(o => o.Refusal == null).Take(3).ToList();
        return (willing.Count > 0 ? willing : matches.Take(1)).Concat(actions.Where(o => !o.Id.StartsWith("marry:")));
    }
    private ICommand Conn(string optionId, string targetId) { var pid = G.World!.ProtagonistId; var c = G.Content!; return optionId.StartsWith("marry:") ? new ProposeMarriageCommand(pid, optionId["marry:".Length..], targetId, c.Titles) : new AssassinateCommand(pid, targetId, c.Friction); }
}
