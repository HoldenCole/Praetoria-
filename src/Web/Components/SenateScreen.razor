                        else
                        {
                            <span title="@($"{bc.mine} of its seats behind you ({Names(bc.forMine)}), {bc.rival} behind {rivalName} ({Names(bc.forRival)}). Each other member backs whichever of you its head thinks the better of." + (bc.won ? "" : $" You may still stand alone against the bench's nominee, with your own seats and whatever is pledged to you; the rest of the bench votes for {rivalName}."))">@(el.Standing ? "You have declared, and the bench" : "If you declared, the bench") @(bc.won ? "puts you forward" : "puts " + rivalName + " forward, not you"): @bc.mine seats to @bc.rival. <Icon Name="info" Tone="ivory" Size="12" /></span>
                        }</span>
