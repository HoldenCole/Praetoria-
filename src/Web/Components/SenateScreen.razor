@preservewhitespace true
@using Praetoria.Core.Commands
@using Praetoria.Core.Systems
@inject GameClient G
@* The Senate window (docs/VISUAL_SYSTEM.md 5.3): the senate painting with the kicker, the title, the house's place in the chamber as facts
   and five figures on the plinth. Six tabs: the chamber (the hemicycle under the header, the benches beside it, the motions before the
   chamber, what was decided lately and the houses' weight in the three estates), the motions the house may move, the offices (the
   consulship and its election, the offices of the Reach, the legates, the parties, the house's rank and the throne, the crises), the
   year's duties, the ladder of offices with the courts, and the orders with breaking away. Every block is a section of rows. *@
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var p = w.Protagonist!; var house = w.House(p.HouseId)!;
    var spheres = c.Spheres.IsEmpty ? new List<string>() : c.Spheres.Defs.Select(s => s.Id).ToList();
    if (spheres.Count == 0) spheres = w.Houses.Values.SelectMany(h => h.SphereInfluence.Keys).Distinct().OrderBy(x => x, StringComparer.Ordinal).ToList();
    var s = m.Standing; var sen = m.Senate; var ladder = c.Titles.ByRank.ToList();
    int threat = w.Counter("threat"), pressure = w.Counter("coalition_pressure");
    var senate = G.Turn!.Senate;
    // the chamber: every house's seats (its Senate weight), grouped by bench, the unaffiliated in the middle
    var seatHouses = w.Houses.Values.Where(h => h.Id != PirateSystem.HouseId).Select(h => (h, weight: senate.Weight(w, h.Id), bench: FactionSystem.Of(w, h.Id))).ToList();
    var benches = w.Factions.OrderByDescending(f => f.Members.Sum(x => senate.Weight(w, x))).ThenBy(f => f.Id, StringComparer.Ordinal).ToList();
    var ordered = new List<(House h, int weight, Faction? bench)>();
    int half = (benches.Count + 1) / 2;
    foreach (var f in benches.Take(half)) ordered.AddRange(seatHouses.Where(x => x.bench?.Id == f.Id).OrderByDescending(x => x.weight).ThenBy(x => x.h.Id, StringComparer.Ordinal));
    ordered.AddRange(seatHouses.Where(x => x.bench == null).OrderByDescending(x => x.weight).ThenBy(x => x.h.Id, StringComparer.Ordinal));
    foreach (var f in benches.Skip(half)) ordered.AddRange(seatHouses.Where(x => x.bench?.Id == f.Id).OrderByDescending(x => x.weight).ThenBy(x => x.h.Id, StringComparer.Ordinal));
    int totalSeats = Math.Max(1, ordered.Sum(x => x.weight));
    var seats = Seats(ordered);
    var watched = sen != null && sen.Docket.Count > 0 ? (sen.Docket.FirstOrDefault(d => d.Id == _watch) ?? sen.Docket[0]) : null;
    var stanceOf = watched?.Stances.ToDictionary(x => x.HouseId, x => x.Stance) ?? new Dictionary<string, int>();
    if (watched != null) stanceOf[house.Id] = watched.MyStance;
    var focusHouse = _focus != null ? w.House(_focus) : null;
    var focusHead = focusHouse != null ? Economy.HeadOf(w, focusHouse) : null;
    var focusStance = watched?.Stances.FirstOrDefault(x => x.HouseId == _focus);
    int myWeight = senate.Weight(w, house.Id);
    // a seat is drawn in its bench's colour, so that the legend beside the chamber reads against it
    var seatFill = ordered.GroupBy(x => x.h.Id).ToDictionary(g => g.Key, g => g.First().bench is { } sb ? (sb.Accent.Length > 0 ? sb.Accent : w.House(sb.LeaderHouseId)?.AccentColor ?? "#888") : "#7d8598");
    // The picture (docs/DASHBOARDS.md): what is before the chamber and how it will go, whose the seats are, and when the next count is.
    int seatRank = 1 + seatHouses.Count(x => x.weight > myWeight); var topSeat = seatHouses.OrderByDescending(x => x.weight).ThenBy(x => x.h.Id, StringComparer.Ordinal).FirstOrDefault();
    var myBench = FactionSystem.Of(w, house.Id); int benchSeats = myBench?.Members.Sum(x => senate.Weight(w, x)) ?? 0; int majority = totalSeats / 2 + 1;
    bool largest = myBench != null && benches.Count > 0 && benches[0].Id == myBench.Id;
    int motions = sen?.Docket.Count ?? 0, carry = sen?.Docket.Count(d => d.ForWeight > d.AgainstWeight) ?? 0; var againstMe = sen?.Docket.FirstOrDefault(d => d.AgainstMe);
    var elect = sen?.Election; var lead = elect?.Nominees.OrderByDescending(n => n.Tally).Select(n => (n.HouseName, n.Tally)).FirstOrDefault();
    bool yearUnspent = LadderSystem.DutyOf(w, p.Id, LadderSystem.SeatKind) != null; int workWaiting = w.OfficeWork.Count(b => b.HolderId == p.Id && b.Choice.Length == 0); bool workWaits = workWaiting > 0;
    int trust = LadderSystem.Trust(w);
    string countLine = elect == null ? "" : elect.AmConsul ? " You hold the consulship." : elect.NextIn == 0 ? $" The consuls are elected at the year's end{(lead is { HouseName: not null } l1 ? $"; {l1.HouseName} leads the count" : "")}." : $" The consuls are elected in {elect.NextIn} years.";
    string story, storyTone;
    if (sen == null) { story = "The Senate does not sit in this age."; storyTone = ""; }
    else if (againstMe != null) { bool passes = againstMe.ForWeight > againstMe.AgainstWeight; story = $"A motion against you is before the chamber: {againstMe.KindName}, moved by {againstMe.ProposerName}. As the benches lean it {(passes ? "carries" : "fails")}, {againstMe.ForWeight} to {againstMe.AgainstWeight}."; storyTone = passes ? "bad" : "warn"; }
    else if (motions > 0) { var first = sen.Docket[0]; story = motions == 1 ? $"One motion is before the chamber: {first.KindName}, moved by {first.ProposerName}. As the benches lean it {(first.ForWeight > first.AgainstWeight ? "carries" : "fails")}, {first.ForWeight} to {first.AgainstWeight}.{countLine}" : $"{motions} motions are before the chamber. As the benches lean, {carry} carry and {motions - carry} fail.{countLine}"; storyTone = ""; }
    else { story = $"Nothing is before the Senate this year. You hold {myWeight} of its {totalSeats} seats{(myBench != null ? $"; {myBench.Name}, your bench, hold {benchSeats}, {(benchSeats >= majority ? "a majority" : $"{majority - benchSeats} short of a majority")}" : " and sit on no bench")}.{countLine}"; storyTone = ""; }
    if (yearUnspent) story += " Your own year in the Senate is not yet spent.";

    // the header: the house's place in the chamber as facts, and five figures on the plinth (numbers only)
    string throneLine = s?.Throne.HoldsThrone == true ? "The throne is yours" : s?.Throne.EmperorName != null ? $"The throne is {s.Throne.EmperorName}'s" : w.IsImperium ? "The throne stands empty" : "A republic: no throne stands";
    string consulFact = elect == null ? (benches.Count == 1 ? "1 bench" : $"{benches.Count} benches") :elect.AmConsul ? "You hold the consulship" : elect.NextIn == 0 ? "Consuls elected this year" : elect.NextIn == 1 ? "Consuls elected next year" : $"Consuls elected in {Counted.Years(elect.NextIn)}";
    var facts = new List<(string icon, string text, string tip)>
    {
        ("greek-temple", $"{Counted.Houses(seatHouses.Count)} · {Counted.Seats(totalSeats)}", $"{Counted.Houses(seatHouses.Count)} sit in the chamber, with {Counted.Seats(totalSeats)} between them, on {benches.Count} {(benches.Count == 1 ? "bench" : "benches")}. A majority is {majority}."),
        ("flying-flag", myBench != null ? "Your bench, " + Plain(myBench.Name) : "You sit on no bench", myBench != null ? $"{myBench.Name}: {benchSeats} seats{(largest ? ", the largest bench" : "")}, {(benchSeats >= majority ? "a majority of the chamber" : $"{majority - benchSeats} short of a majority")}" : "You vote alone; a bench votes together"),
        ("throne-king", throneLine, w.IsImperium ? "Who holds the throne of the Reach" : "The Republic has no throne; it ends only if a house ends it"),
        (elect == null ? "flying-flag" : "sundial", consulFact, elect == null ? $"{benches.Count} {(benches.Count == 1 ? "bench" : "benches")} in the chamber" : $"Two consuls are elected every {elect.TermTurns} years, by the weight of the houses that vote for them." + (lead is { HouseName: not null } l3 ? $" {l3.HouseName} leads the count with {l3.Tally}." : " No candidate yet."))
    };
    string seatNote = myWeight == 0 ? "the house has no seat" : topSeat.h == null || topSeat.h.Id == house.Id ? $"the most of any house, of {seatHouses.Count}" : $"{Ordinal(seatRank)} of {seatHouses.Count} houses · {topSeat.h.Name} has {topSeat.weight}";
    string benchNote = myBench == null ? "you vote alone; a bench votes together" : benchSeats >= majority ? $"{benchSeats} seats: a majority of the chamber" : $"{benchSeats} seats{(largest ? ", the largest bench" : "")} · {majority - benchSeats} short of a majority";
    string motionNote = sen == null ? "" : motions == 0 ? (sen.MayPropose ? "you may move one" : sen.HeadAbroad != null ? "and you may move only a return from exile" : "and you may not move one") : againstMe != null ? "one of them against you" : $"{carry} to carry, {motions - carry} to fail, as it stands";
    var figures = new List<WindowHeader.Figure>
    {
        new("vote", myWeight.ToString(), "Your seats", myWeight == 0 ? "ember" : "brass", Of: totalSeats.ToString(), Tip: $"[vote] Your seats\n{Cap(seatNote)}.\nA house votes with the weight of its seats.")
    };
    if (ThroneSystem.Emperor(w) is { } sits)
    {
        int th = ThroneSystem.Hold(w); var up = w.Rising != null ? w.House(w.Rising.HouseId) : null;
        figures.Add(new("throne-king", th.ToString(), "The throne", th < ThroneSystem.RiseAt || up != null ? "ember" : th < ThroneSystem.ShakenAt ? "ivory" : "good", Of: "100",
            Tip: $"[throne-king] The throne · {ThroneSystem.HoldName(th)}\n{Cap(up != null ? $"{up.Name} has raised a standard" : sits.Id == house.Id ? "your hold on it" : $"the hold of {sits.Name}")}.\nHow firmly the house on the throne holds it, out of 100. Below {ThroneSystem.RiseAt} for two years and a house of rank raises a standard. What it is made of is under Offices."));
    }
    else figures.Add(new("flying-flag", benchSeats.ToString(), myBench != null ? "Bench seats" : "No bench", myBench != null && benchSeats >= majority ? "good" : "ivory", Tip: $"[flying-flag] Your bench{(myBench != null ? " · " + myBench.Name : "")}\n{Cap(benchNote)}.\nA majority is {majority} of {totalSeats} seats."));
    figures.Add(new("scroll-quill", motions.ToString(), motions == 1 ? "Motion" : "Motions", againstMe != null ? "ember" : "ivory", Tip: $"[scroll-quill] Before the chamber\n{(motionNote.Length > 0 ? Cap(motionNote) + ".\n" : "")}Motions are voted at the year's end, by weight of seats."));
    figures.Add(new("threat", threat.ToString(), "Fear of you", threat >= SphereSystem.CoalitionThreshold ? "ember" : "ivory", Of: SphereSystem.CoalitionThreshold.ToString(),
        Tip: $"[threat] Fear of you\nHow over-mighty the Reach thinks your house. Past the mark, the houses begin to combine against it.\nThe houses draw together at {SphereSystem.CoalitionThreshold}" + (pressure > 0 ? $"; pressure {pressure} of {SphereSystem.MaxCoalitionPressure}" : "") + "."));
    figures.Add(new("scales", trust.ToString(), "Trust in office", trust < LadderSystem.TrustLow ? "ember" : trust >= LadderSystem.TrustHigh ? "good" : "ivory", Of: "100",
        Tip: $"[scales] Trust in the magistrates\n{Cap(trust < LadderSystem.TrustLow ? "the squares blame whoever holds office" : trust < 50 ? "a scandal costs twice the votes" : trust >= LadderSystem.TrustHigh ? "office is honoured" : "neither honoured nor blamed")}.\n{LadderSystem.TrustSays(w)}"));

    int ladderCount = LadderSystem.Active(w, c.Offices) ? Docket.Of(w, c.Offices, house.Id).Count + (LadderSystem.BusinessOf(w, pid) != null ? 1 : 0) : 0;
    var tabs = new List<Tabs.Tab>
    {
        new("chamber", "Chamber", "greek-temple", motions > 0 ? motions.ToString() : "", againstMe != null || (sen?.Docket.Any(d => w.Motions.FirstOrDefault(x => x.Id == d.Id) is { } mm && !mm.Votes.ContainsKey(house.Id)) ?? false), Tip: "The chamber: its seats and benches, the motions before it, and what it decided lately"),
        new("move", "Motions", "scroll-quill", Tip: "Move a motion: what your house may put before the chamber"),
        new("offices", "Offices", "podium", elect is { NextIn: 0 } ? "!" : "", elect is { NextIn: 0 }, Tip: "The consulship, the offices of the Reach, the parties, your rank and the crises"),
        new("duties", "Duties", "tied-scroll", workWaits ? workWaiting.ToString() : "", workWaits, Tip: "Your duties this year: what your positions ask of you"),
        new("ladder", "Ladder", "stairs-goal", ladderCount > 0 ? ladderCount.ToString() : "", ladderCount > 0, Tip: "The ladder of offices, and the courts"),
        new("orders", "Orders", "laurels", Tip: "The three orders, patronage, and breaking away")
    };
}
<div class="sn-win" data-senate="@_view">
    <WindowHeader Scene="senate" Kicker="@("Senate · " + (w.Era == "imperium" ? "the Imperium" : "the Republic"))" Title="@(w.Era == "imperium" ? "The Imperial Senate" : "The Senate of the Reach")" Glyph="greek-temple" Figures="figures" Class="sn-head">
        <Facts>
            @for (int i = 0; i < facts.Count; i++) { var (icon, text, tip) = facts[i]; <span class="@(i >= 2 ? "sn-fx2" : "")" title="@tip"><Icon Name="@icon" Tone="ivory" Size="16" />@text</span> }
            @if (facts.Count > 2) { <span class="sn-fmore" title="@string.Join("\n", facts.Skip(2).Select(x => x.text + ": " + x.tip))">@string.Join(" · ", facts.Skip(2).Select(x => x.text))</span> }
        </Facts>
    </WindowHeader>
    <Tabs Items="tabs" Active="@_view" OnPick="Pick" />
    <div class="ui-wbody fades sn-body">
    @if (sen == null && _view is "chamber" or "move") { <EmptyState Icon="greek-temple" Text="The Senate does not sit in this age." /> }
    else if (_view == "chamber")
    {
        <p class="ui-lede sn-lede @storyTone">@Bold(story)</p>
        @if (sen!.Embargoed) { <div class="ui-wstrip bad sn-strip"><Icon Name="customs_post" Tone="ember" Size="18" /><span class="ui-wstrip-t"><b>Embargo, @Counted.Years(sen.EmbargoLifts).</b> The Reach does not trade with you until it lifts.</span></div> }
        <TriumphGate />
        @* the chamber: the seats on their arcs, each bench a wedge in its colour; the benches beside it with their seats *@
        <div class="sn-chamber">
            <div class="sn-hemi">
                @{ int rows = Rows(totalSeats); double rf = R0 + (rows - 1) * DR + 26; string vb = F(500 - rf - 6) + " " + F(520 - rf - 6) + " " + F(2 * rf + 12) + " " + F(rf + 14); }
                <svg class="hemicycle" viewBox="@vb" role="img" aria-label="the Senate's seats">
                    <defs>
                        <radialGradient id="sn-floor" cx="50%" cy="100%" r="100%"><stop offset="0" stop-color="#1e2330" /><stop offset=".7" stop-color="#11141b" /><stop offset="1" stop-color="#0a0c11" /></radialGradient>
                        <linearGradient id="sn-rim" x1="0" x2="1"><stop offset="0" stop-color="#6f5020" /><stop offset=".5" stop-color="#c9a24a" /><stop offset="1" stop-color="#6f5020" /></linearGradient>
                    </defs>
                    <path d="@($"M {F(500 - rf)} 520 A {F(rf)} {F(rf)} 0 0 1 {F(500 + rf)} 520 Z")" fill="url(#sn-floor)" stroke="url(#sn-rim)" stroke-width="2" />
                    <path d="@($"M {F(500 - R0 + 34)} 520 A {F(R0 - 34)} {F(R0 - 34)} 0 0 1 {F(500 + R0 - 34)} 520")" fill="none" stroke="rgba(201,162,74,.22)" stroke-width="1" />
                    <path d="M 440 520 A 60 60 0 0 1 560 520 Z" fill="#1d1a12" stroke="#a5813a" stroke-width="1.5" />
                    @foreach (var seat in seats)
                    {
                        int st = watched != null && stanceOf.TryGetValue(seat.houseId, out var sv) ? sv : 0;
                        string cls = (seat.houseId == house.Id ? "mine " : "") + (seat.houseId == _focus ? "focus " : "") + (watched == null ? "" : st > 0 ? "for" : st < 0 ? "against" : "abstain");
                        <circle cx="@F(seat.x)" cy="@F(seat.y)" r="8.5" class="seat @cls" style="fill:@SeatFill(seatFill.TryGetValue(seat.houseId, out var sf) ? sf : seat.accent, watched != null)" @onclick="() => _focus = seat.houseId"><title>@seat.name · @Counted.Seats(seat.weight)@(seat.bench != null ? $" · {seat.bench}" : "")</title></circle>
                    }
                </svg>
                <div class="sn-hemi-cap"><b>@(sen.Offices?.FirstOrDefault(o => o.Id == "speaker")?.HolderName ?? "Nobody")</b> at the rostrum · @(watched != null ? $"seats ringed by their lean on {watched.KindName}" : "each dot a seat, in its bench's colour; yours are ringed. Click one for its house.")</div>
            </div>
            <div class="sn-legend">
                <div class="sn-leg-h"><span>Benches</span><span title="@($"A motion carries with more seats for it than against; {majority} of {totalSeats} is a majority of the whole chamber")">majority <b>@majority</b></span></div>
                @foreach (var f in benches)
                {
                    int wt = f.Members.Sum(x => senate.Weight(w, x)); var lh = w.House(f.LeaderHouseId); string acc = f.Accent.Length > 0 ? f.Accent : lh?.AccentColor ?? "#888";
                    <div class="sn-bench @(f.Members.Contains(house.Id) ? "mine" : "")" title="@($"{f.Name}\nLed by {lh?.Name ?? f.LeaderHouseId}\n{string.Join(", ", f.Members.Select(x => w.House(x)?.Name ?? x))}")">
                        <i class="sw" style="background:@acc"></i><span class="nm">@f.Name</span><span class="bar"><i style="width:@Pc(100.0 * wt / totalSeats);background:@acc"></i><i class="mj" style="left:@Pc(100.0 * majority / totalSeats)"></i></span><b>@wt</b>
                    </div>
                }
                <div class="sn-bench none"><i class="sw"></i><span class="nm">Unaffiliated</span><span class="bar"><i style="width:@Pc(100.0 * ordered.Where(x => x.bench == null).Sum(x => x.weight) / totalSeats)"></i></span><b>@ordered.Where(x => x.bench == null).Sum(x => x.weight)</b></div>
                @if (watched != null) { <div class="sn-key"><i class="for"></i>for <i class="against"></i>against <i class="abstain"></i>abstains</div> }
                @if (sen.Docket.Count > 1)
                {
                    <div class="sn-leanon"><span class="ui-seg-l">Show lean on</span>
                        <span class="ui-seg sn-seg">@foreach (var d in sen.Docket) { var did = d.Id; <button class="@(watched?.Id == did ? "on" : "")" title="@d.Text" @onclick="() => _watch = did">@d.KindName</button> }</span>
                    </div>
                }
            </div>
        </div>
        @if (focusHouse != null)
        {
            var rel = focusHead != null ? w.GetRelationship(focusHead.Id, pid) : null; int d = rel?.Disposition ?? 0; var cn = focusHead != null ? m.Connections.FirstOrDefault(x => x.Id == focusHead.Id) : null;
            var fb = FactionSystem.Of(w, focusHouse.Id);
            <div class="sn-focus seat-card" data-focus-house="@focusHouse.Id">
                <div class="sn-focus-pic">@if (focusHead != null) { <Portrait Id="@focusHead.Id" Name="@focusHead.Name" Sex="@focusHead.Sex" Age="@focusHead.Age" Accent="@focusHouse.AccentColor" Size="46" Height="56" /> } else { <Portrait Size="46" Height="56" EmptyGlyph="castle" /> }</div>
                <div class="sn-focus-main">
                    <div class="sn-hd"><Sigil HouseId="@focusHouse.Id" Accent="@focusHouse.AccentColor" Size="16" /><b class="sn-nm">@focusHouse.Name</b><span class="sn-sub">@(c.Titles.NameOf(focusHouse.Title, G.World!.Era)) · @Counted.Seats(senate.Weight(w, focusHouse.Id))@(fb != null ? $" · {fb.Name}{(fb.LeaderHouseId == focusHouse.Id ? " (leads)" : "")}" : "")</span></div>
                    <div class="sn-tx">@(focusHead != null ? $"{focusHead.Name}, {c.Careers.RankName(focusHead.CareerTrack, focusHead.CareerRank, G.World!.Era) ?? "head"}" : "no head") · legitimacy @focusHouse.Legitimacy@(focusHouse.SphereInfluence.Any(k => k.Value > 0) ? " · " + string.Join(" · ", focusHouse.SphereInfluence.Where(k => k.Value > 0).Select(k => $"{k.Key} {k.Value}")) : "")
                        @if (focusHouse.Id != house.Id) { <span> · <span class="@(d < -20 ? "ui-down" : d > 20 ? "ui-up" : "")">disposition @Counted.Figure(d)</span>@if (w.AtWar(house.Id, focusHouse.Id)) { <b class="ui-down"> · at war</b> }</span> }</div>
                    @if (watched != null && focusStance != null && focusHouse.Id != house.Id)
                    {
                        <div class="sn-acts"><span class="sn-say">On @watched.KindName: <b class="@(focusStance.Stance > 0 ? "ui-up" : focusStance.Stance < 0 ? "ui-down" : "")">@(focusStance.Stance > 0 ? "for" : focusStance.Stance < 0 ? "against" : "abstains")@(focusStance.Declared ? "" : " (leaning)")</b></span>
                            <Plate Label="Whip" Small="true" Locked="@(focusStance.LobbyRefusal != null)" Disabled="@(focusStance.LobbyRefusal != null)" Tip="@(focusStance.LobbyRefusal ?? "1 influence: lean them your way")" CostIcon="public-speaker" CostText="1" OnClick="() => G.Execute(new LobbyCommand(pid, watched.Id, focusHouse.Id, watched.MyStance >= 0 ? 1 : -1))" />
                            <Plate Label="Bribe" Small="true" Locked="@(focusStance.BribeRefusal != null)" Disabled="@(focusStance.BribeRefusal != null)" Tip="@(focusStance.BribeRefusal ?? BribeTip(focusStance))" CostIcon="credits" CostText="@Money.Show(focusStance.BribePrice)" OnClick="() => AskBribe(watched.Id, focusStance, watched.MyStance >= 0 ? 1 : -1)" /></div>
                    }
                    @if (cn != null && cn.Actions.Count > 0) { <div class="sn-acts">@foreach (var o in TreatyFirst(cn.Actions)) { var oid = o.Id; var ol = o.Label; <Plate Label="@o.Label" Small="true" Locked="@(o.Refusal != null)" Disabled="@(o.Refusal != null)" Tip="@(o.Refusal ?? o.Label)" OnClick="() => AskConn(oid, ol, cn.Id)" /> }</div> }
                </div>
                <button class="ui-round sn-x" title="Close the house" aria-label="Close" @onclick="() => _focus = null"><Icon Name="close" Tone="ivory" Size="11" /></button>
            </div>
        }

        @* the motions before the chamber: each one an entry, its tally as a bar, the house's vote as joined plates, the roll call under it *@
        <Section Title="Before the chamber" Count="@(motions > 0 ? motions.ToString() : "")" Info="Motions are voted at the year's end, by weight of seats; a tie fails, unless the one presiding is for it. Click a motion to colour the seats by how they lean on it."
                 IsEmpty="@(sen.Docket.Count == 0)" EmptyIcon="scroll-quill" EmptyLine="@("Nothing is before the Senate this year." + (sen.MayPropose ? " What you could move is under Motions; one moved now is voted at the end of next year." : ""))" EmptyLink="@(sen.MayPropose ? "Move a motion" : "")" OnEmptyLink='() => Pick("move")'>
            <Right>@if (motions > 0) { <span><b class="ui-up">@carry</b> carry · <b class="@(motions - carry > 0 ? "ui-down" : "")">@(motions - carry)</b> fail</span> }</Right>
            <ChildContent>
            @foreach (var mo in sen.Docket)
            {
                int total = Math.Max(1, mo.ForWeight + mo.AgainstWeight);
                var motionNow = w.Motions.FirstOrDefault(x => x.Id == mo.Id); bool motionHeld = motionNow?.HeldOver == true; int motionChair = motionNow?.Chair ?? 0;
                bool tied = mo.ForWeight == mo.AgainstWeight && mo.ForWeight > 0; var presides = LadderSystem.Presiding(w);
                bool chairCarries = tied && presides != null && (presides.HouseId == house.Id ? mo.MyStance : mo.Stances.FirstOrDefault(x => x.HouseId == presides.HouseId)?.Stance ?? 0) > 0;
                bool carries = mo.ForWeight > mo.AgainstWeight || chairCarries; string moId = mo.Id;
                <div class="sn-mo motion @(mo.AgainstMe ? "against" : mo.Mine ? "mine" : mo.Petition ? "petition" : "") @(watched?.Id == mo.Id ? "watched" : "")" data-motion="@mo.Id">
                    <span class="sn-ic @(mo.AgainstMe ? "bad" : mo.Mine ? "mine" : "")" title="@mo.KindName"><Icon Name="@MotionIcon(mo)" Tone="@(mo.AgainstMe ? "ember" : mo.Mine ? "brass" : "ivory")" Size="22" /></span>
                    <div class="sn-mo-main">
                        <div class="sn-hd click" title="Click to colour the chamber by how the houses lean on it" @onclick="() => _watch = moId">
                            <b class="sn-nm">@mo.KindName</b>
                            <span class="sn-sub">@(mo.Petition ? "the petition of" : "moved by") <i class="sn-sq" style="background:@mo.ProposerAccent"></i>@mo.ProposerName · vote @(mo.ProposedTurn < w.Turn ? "at the end of this year" : "next year")@(motionHeld ? " · held over by the Speaker" : "")@(motionChair != 0 ? $" · the chair has spoken {(motionChair > 0 ? "for" : "against")} it" : "")</span>
                            <span class="sn-verdict @(carries ? "up" : "down")">@(carries ? "Carries" : "Fails")</span>
                        </div>
                        <div class="sn-tx">@mo.Text</div>
                        <ForeignGoldBlock MotionId="@mo.Id" />
                        @{ int patronWish = motionNow != null ? senate.PatronWish(w, motionNow, house.Id) : 0; }
                        @if (patronWish != 0) { <div class="sn-note warn"><Icon Name="shaking-hands" Tone="brass" Size="15" /><span>Your patron, @(w.House(house.PatronId)?.Name), wants this @(patronWish > 0 ? "carried" : "thrown out"). How you vote will be noticed.</span></div> }
                        @if (motionNow != null && senate.Motions.Def(motionNow.Kind) is { } wishDef)
                        {
                            /* the houses you hold a province under, and what each wants of this motion (docs/PLAYTHROUGH.md, Medium, The Senate, P90) */
                            foreach (var ow in ProvinceSystem.Wishes(w, c.Holdings, motionNow, wishDef.Interest, wishDef.Target == "house", house.Id))
                            {
                                <div class="sn-note warn" data-overlord-wish="@ow.over.Id"><Icon Name="castle" Tone="brass" Size="15" /><span>@ow.over.Name, which you hold @ow.province under, wants this @(ow.want > 0 ? "carried" : "thrown out"). Vote its way and its head thinks @SenateSystem.ObligeRegard the better of you@(ow.defied > 0 ? " and one of your votes against it is forgotten" : ""); vote the other way and it thinks @Math.Abs(SenateSystem.DefyRegard) the worse. You have voted against it @Counted.Times(ow.defied) on what touched it: at @ow.bears, if it is at least your match in arms and at peace, it asks for the province back.</span></div>
                            }
                        }
                        <div class="sn-tally" title="@($"For {mo.ForWeight}, against {mo.AgainstWeight}, by weight of seats, as the benches lean")">
                            <b class="f">@mo.ForWeight</b>
                            <span class="sn-tally-trk"><i class="for" style="width:@Pc(100.0 * mo.ForWeight / total)"></i><i class="against" style="width:@Pc(100.0 * mo.AgainstWeight / total)"></i><i class="half"></i></span>
                            <b class="a">@mo.AgainstWeight</b>
                        </div>
                        <div class="sn-tally-line tally-line"><b class="@(carries ? "ui-up" : "ui-down")">@(mo.ForWeight > mo.AgainstWeight ? "Carries" : chairCarries ? $"Tied: carries on the casting vote of {presides!.Name}, presiding," : tied && presides != null ? $"Tied: fails, since {presides.Name}, presiding, is not for it," : mo.ForWeight == mo.AgainstWeight ? "Tied: fails" : "Fails") as the benches lean</b> <span class="ui-mute">· for @mo.ForWeight · against @mo.AgainstWeight</span></div>
                        @if (motionNow != null)
                        {
                            bool declared = motionNow.Votes.TryGetValue(house.Id, out var myVote); int myLean = Math.Sign(senate.Lean(w, motionNow, house.Id));
                            var paid = motionNow.BoughtBy.Where(kv => kv.Value == house.Id).Select(kv => (w.House(kv.Key)?.Name ?? kv.Key) + (motionNow.Bought.GetValueOrDefault(kv.Key) > 0 ? " (for)" : " (against)")).ToList();
                            @if (paid.Count > 0) { <div class="sn-note warn" data-bought="@paid.Count"><Icon Name="credits" Tone="brass" Size="15" /><span>Votes you have paid for on this motion: @string.Join(", ", paid). One time in @SenateSystem.BribeOutOneIn each comes out at the count.</span></div> }
                            <div class="sn-vote">
                                <span class="ui-seg" role="radiogroup" aria-label="Your vote">
                                    @foreach (var (stance, label) in new[] { (1, "Vote for"), (-1, "Vote against"), (0, "Abstain") })
                                    { bool isOn = declared && myVote == stance, leans = !declared && myLean == stance; <button class="@(isOn ? "on" : leans ? "leans" : "")" role="radio" aria-checked="@(isOn ? "true" : "false")" title="@(VoteTip(stance) + (leans ? "\nLeft alone, your house votes this way: it is how it leans, not yet declared." : ""))" @onclick="() => G.Execute(new VoteCommand(pid, mo.Id, stance))">@label</button> }
                                </span>
                                <span class="sn-myvote @(declared ? "ui-up" : "")" data-myvote="@(declared ? myVote : 9)">@(declared ? $"You have declared {(myVote > 0 ? "for it" : myVote < 0 ? "against it" : "that you abstain")}. You may change it until the year ends." : $"You have not declared. Left alone, your house votes as it leans: {(myLean > 0 ? "for" : myLean < 0 ? "against" : "it abstains")}.")</span>
                            </div>
                        }
                        else
                        {
                            <div class="sn-vote"><span class="ui-seg" role="radiogroup" aria-label="Your vote">@foreach (var (stance, label) in new[] { (1, "Vote for"), (-1, "Vote against"), (0, "Abstain") }) { bool isOn = motionNow != null && motionNow.Votes.TryGetValue(house.Id, out var mv) && mv == stance; <button class="@(isOn ? "on" : "")" title="@VoteTip(stance)" @onclick="() => G.Execute(new VoteCommand(pid, mo.Id, stance))">@label</button> }</span></div>
                        }
                        @{ bool speaker = LadderSystem.SpeakerOf(w)?.Id == pid, chair = presides?.Id == pid, consul = sen.Election is { AmConsul: true }; }
                        @if (speaker || chair || consul)
                        {
                            <div class="sn-acts">
                                @if (speaker) { var holdNo = LadderSystem.ChairRefusal(w, p, motionNow, LadderSystem.HoldMotion); <Plate Label="Hold it over" Small="true" Icon="hourglass" Locked="@(holdNo != null)" Disabled="@(holdNo != null)" Tip="@(holdNo ?? "As Speaker: it is not reached this year, and is voted next year. Once a year; whoever moved it will not thank you.")" OnClick="() => G.Execute(new ChairCommand(pid, mo.Id, LadderSystem.HoldMotion, G.Turn!.Senate))" /> }
                                @if (chair)
                                {
                                    var forNo = LadderSystem.ChairRefusal(w, p, motionNow, LadderSystem.SpeakFor); var againstNo = LadderSystem.ChairRefusal(w, p, motionNow, LadderSystem.SpeakAgainst);
                                    <Plate Label="Speak for it from the chair" Small="true" Icon="public-speaker" Locked="@(forNo != null)" Disabled="@(forNo != null)" Tip="@(forNo ?? "As presiding consul: the houses lean with the chair. Once a year.")" OnClick="() => G.Execute(new ChairCommand(pid, mo.Id, LadderSystem.SpeakFor, G.Turn!.Senate))" />
                                    <Plate Label="Speak against it" Small="true" Icon="public-speaker" Locked="@(againstNo != null)" Disabled="@(againstNo != null)" Tip="@(againstNo ?? "As presiding consul: the houses lean with the chair. Once a year.")" OnClick="() => G.Execute(new ChairCommand(pid, mo.Id, LadderSystem.SpeakAgainst, G.Turn!.Senate))" />
                                }
                                @if (consul) { <Plate Label="Veto" Small="true" Icon="close" Class="sn-veto" Locked="@(mo.VetoRefusal != null)" Disabled="@(mo.VetoRefusal != null)" Tip="@(mo.VetoRefusal ?? "The consul's veto: struck from the docket, once a term")" OnClick='() => G.AskDo("Veto this motion?", mo.Text + " It is struck from the docket and cannot be moved again this term. A consul has one veto a term: this spends yours. The house that moved it will not thank you.", "Veto it", new VetoCommand(pid, mo.Id, c.Offices, G.Turn!.Senate))' /> }
                            </div>
                        }
                        <details class="sn-roll">
                            <summary><Icon Name="chev" Size="11" Class="flat" />The benches · whip them<span class="ui-mute">@Counted.Houses(Math.Min(16, mo.Stances.Count))</span></summary>
                            @{ int margin = mo.ForWeight - mo.AgainstWeight; int side = mo.MyStance >= 0 ? 1 : -1; }
                            <div class="sn-roll-say" data-margin="@margin">As the benches lean it @(margin > 0 ? $"carries by {margin}" : margin < 0 ? $"fails by {-margin}" : "is tied, and a tie fails unless the chair is for it"), by weight of seats. A house that goes from one side to the other moves that by twice its seats; one that goes to abstaining, or comes from it, by its seats. A whip is worth @SenateSystem.LobbyWeight to a house's lean and a bought vote @SenateSystem.BribeWeight; a house votes for above nought, against below it, and abstains at nought.</div>
                            @foreach (var st in mo.Stances.Take(16))
                            {
                                var why = motionNow != null ? senate.Why(w, motionNow, st.HouseId) : new List<(string why, int by)>(); int leanNow = why.Sum(x => x.by); var stl = st;
                                <div class="sn-roll-row bench-row">
                                    <Sigil HouseId="@st.HouseId" Accent="@st.Accent" Size="16" />
                                    <div class="sn-roll-nm">
                                        <span class="bn" title="@(st.Faction != null ? $"{st.HouseName} · {st.Faction}{(st.FactionLeader ? " (leads)" : "")}" : st.HouseName)">@st.HouseName@if (st.FactionLeader) { <Icon Name="crown" Tone="brass" Size="12" /> }@if (st.Faction != null) { <small>@st.Faction</small> }</span>
                                        @if (why.Count > 0) { <span class="bench-why" data-why-vote="@st.HouseId">leans @Signed(leanNow): @string.Join("; ", why.Take(3).Select(x => $"{x.why} ({Signed(x.by)})"))@(why.Count > 3 ? $"; and {Counted.LesserThings(why.Count - 3)} ({Signed(why.Skip(3).Sum(x => x.by))})" : "")</span> }
                                    </div>
                                    <span class="wt" title="@Counted.Seats(st.Weight)">@st.Weight</span>
                                    <span class="stance @(st.Stance > 0 ? "for" : st.Stance < 0 ? "against" : "")" title="@(st.Declared ? "declared" : "leaning: a whip may move it")">@(st.Stance > 0 ? "for" : st.Stance < 0 ? "against" : "abstains")@if (!st.Declared) { <i>?</i> }</span>
                                    <Plate Label="Whip" Small="true" Locked="@(st.LobbyRefusal != null)" Disabled="@(st.LobbyRefusal != null)" Tip="@(st.LobbyRefusal ?? "1 influence. " + MoveSays(st, leanNow, side, SenateSystem.LobbyWeight))" OnClick="() => G.Execute(new LobbyCommand(pid, mo.Id, stl.HouseId, mo.MyStance >= 0 ? 1 : -1))" />
                                    <Plate Label="Bribe" Small="true" Locked="@(st.BribeRefusal != null)" Disabled="@(st.BribeRefusal != null)" Tip="@(st.BribeRefusal ?? BribeTip(st))" CostIcon="credits" CostText="@Money.Show(st.BribePrice)" OnClick="() => AskBribe(mo.Id, stl, mo.MyStance >= 0 ? 1 : -1)" />
                                </div>
                            }
                            <div class="sn-roll-say">Whipping leans a house toward your own stance (for, unless you voted against).</div>
                        </details>
                    </div>
                </div>
            }
            </ChildContent>
        </Section>
        @if (sen.History.Count > 0)
        {
            <Section Title="Decided lately" Count="@sen.History.Count.ToString()" Info="What the chamber decided in the last years: carried, thrown out or vetoed, with the count by weight of seats.">
                @foreach (var h in _allHistory ? sen.History : sen.History.Take(4))
                {
                    <div class="sn-hist hist @(h.Passed ? "won" : "lost")">
                        <b class="sn-chip @(h.Vetoed ? "veto" : h.Passed ? "up" : "down")">@(h.Vetoed ? $"vetoed by {h.VetoedBy}" : h.Passed ? "carried" : "thrown out")</b>
                        <span class="sn-hist-t"><span class="ui-mute">@(h.Vetoed ? "" : $"{h.ForWeight}–{h.AgainstWeight} · ")year @h.ProposedTurn ·</span> @h.Text@(h.Swing.Length > 0 ? " (" + h.Swing + ")" : "")</span>
                    </div>
                }
                @if (sen.History.Count > 4) { <div class="sn-more"><Link Label="@(_allHistory ? "Show fewer" : "Show all " + sen.History.Count)" OnClick="() => _allHistory = !_allHistory" /></div> }
            </Section>
        }
        <Section Title="Weight in the estates" Count="@spheres.Count.ToString()" Info="The three estates of the Reach. A house's weight in each is the ranks of its family serving on that track, added up; each bar is cut by house, yours outlined. Weight in the Senate is also what your vote counts for in the chamber. A share well above an even split is what makes the other houses fear you.">
            <div class="sn-spheres spheres-row" data-sphere-legend>
                @foreach (var sp in spheres)
                {
                    var shares = w.Houses.Values.Select(h => (h, v: h.SphereInfluence.TryGetValue(sp, out var v) ? v : 0)).Where(x => x.v > 0).OrderByDescending(x => x.v).ToList(); int stotal = Math.Max(1, shares.Sum(x => x.v));
                    var def = c.Spheres.IsEmpty ? null : c.Spheres.Defs.FirstOrDefault(x => x.Id == sp); int mineW = house.SphereInfluence.TryGetValue(sp, out var mw) ? mw : 0;
                    <div class="sn-sphere sphere" title="@SphereTip(sp, def?.Name ?? sp)">
                        <span class="sn-sphere-nm">@Cap(def?.Name ?? sp)</span>
                        @* the three heaviest houses and yours as named segments in toned colours; the rest one grey "others" segment (the split in the tooltip) *@
                        @{ var top = shares.Take(3).ToList(); if (mineW > 0 && top.All(x => x.h.Id != house.Id)) top.Add((house, mineW)); var rest = shares.Where(x => top.All(t => t.h.Id != x.h.Id)).ToList(); int restW = rest.Sum(x => x.v); }
                        <span class="sphere-bar sn-wbar">@foreach (var x in top) { double pc = 100.0 * x.v / stotal; <i style="width:@Pc(pc); --hc:@x.h.AccentColor" title="@($"{x.h.Name}: {x.v} of {stotal}")" class="@(x.h.Id == house.Id ? "mine" : "")">@if (pc >= 16) { <span>@x.h.Name.Replace("House ", "")</span> }</i> }@if (restW > 0) { <i class="others" style="width:@Pc(100.0 * restW / stotal)" title="@($"{rest.Count} other houses: {string.Join(", ", rest.Take(12).Select(x => x.h.Name.Replace("House ", "") + " " + x.v))}{(rest.Count > 12 ? ", and more" : "")}")">@if (100.0 * restW / stotal >= 16) { <span>@rest.Count others</span> }</i> }</span>
                        <span class="sn-sphere-v"><b>@mineW</b><small>/@stotal</small></span>
                    </div>
                }
            </div>
        </Section>
    }
    else if (_view == "move")
    {
        var oweMe = WealthSystem.OweMe(w, house.Id); var iOwe = WealthSystem.IOwe(w, house.Id);
        <p class="ui-lede sn-lede">@Bold(sen!.MayPropose ? $"Your house may move a motion. It costs influence of this year's and is voted at the end of the year after it is moved, by weight of seats; you hold {myWeight} of {totalSeats}." : sen.HeadAbroad != null ? $"Your house may move nothing but a return from exile of its own. It votes on every motion with its {myWeight} seats." : $"Your house may not move a motion yet. It votes on every motion with its {myWeight} seats; a house above yours may move one in its own name.")</p>
        @if (oweMe.Count + iOwe.Count > 0)
        {
            <Section Title="Favours" Count="@((oweMe.Count + iOwe.Count).ToString())" Info="A favour owed leans a house your way on the next motion you move, and is spent at that vote. One you owe is settled by voting for that house's next motion.">
                <div class="sn-favours" data-favours="@(oweMe.Count + iOwe.Count)">
                    @if (oweMe.Count > 0) { <div class="sn-note"><Icon Name="shaking-hands" Tone="good" Size="15" /><span><b>Owe you a favour:</b> @string.Join(", ", oweMe.Select(h => $"{h.Name} ({FavourLeft(w, h.Id, house.Id)})")). Each leans @Signed(WealthSystem.FavourLeanBy) for the next motion you move, and the favour is spent at that vote. To call one in for something else, see House, under what is owed.</span></div> }
                    @if (iOwe.Count > 0) { <div class="sn-note"><Icon Name="shaking-hands" Tone="ivory" Size="15" /><span><b>You owe a favour to:</b> @string.Join(", ", iOwe.Select(h => $"{h.Name} ({FavourLeft(w, house.Id, h.Id)})")). Vote for that house's next motion and the account is even; vote otherwise and its head remembers who kept the gift.</span></div> }
                </div>
            </Section>
        }
        <div class="propose @(sen.MayPropose || _showForms ? "" : "cannot")">
            @if (!sen.MayPropose)
            {
                <div class="ui-wstrip sn-strip" data-cannot-move="1"><Icon Name="padlock" Tone="brass" Size="18" />
                    <span class="ui-wstrip-t">@if (sen.HeadAbroad is { } abroad) { <b>Abroad.</b> <text>@(char.ToUpperInvariant(abroad[0]) + abroad[1..]).</text> } else { <b>No voice.</b> <text>Your house may not move a motion yet: @NoSeatLine(w).TrimStart('·', ' ').@(!w.IsImperium && TriumphSystem.HeldMagistracy(w, w.Protagonist!) ? MayMoveGenerals : string.Empty)</text> }</span>
                    <button class="ui-btn sm" title="Every kind of motion, what it costs and what it does, though your house may not move one yet" @onclick="() => _showForms = !_showForms">@(_showForms ? "Hide the motions" : "Show what could be moved, " + sen.Proposals.Count + " kinds")</button>
                </div>
            }
            @if (sen.MayPropose || _showForms)
            {
                <Section Title="What may be moved" Count="@sen.Proposals.Count.ToString()" Info="Each kind of motion, what it costs in influence and what it does. Choose what it is about and move it; a motion is voted at the end of the year after it is moved. Your patron or your bench's leader may move it in its own name for you.">
                    <Right><span class="sn-pool" title="Influence of this year's, which moving a motion spends"><Icon Name="public-speaker" Tone="ivory" Size="16" /><b>@m.Pools.Influence</b> to spend</span></Right>
                </Section>
            }
            @* each motion a row (docs/VISUAL_SYSTEM.md 4.7) under a band by what it is about: its glyph, its name, what it does if it carries,
               the cost once, on its one plate; the whole "You move that..." in the tooltip. Choosing what it is about docks one order bar
               under the row picked (4.13), not a select in every row. *@
            @foreach (var mgrp in sen.Proposals.GroupBy(MotionGroup).OrderBy(g => Array.IndexOf(MotionGroups, g.Key)))
            {
                <div class="sn-mgrp-h" data-motion-group="@mgrp.Key"><i class="sn-dia" aria-hidden="true"></i><span>@mgrp.Key</span><span class="ui-n">@mgrp.Count()</span></div>
                @foreach (var pr in mgrp)
                {
                    var prk = pr.KindId; bool picked = _pickMotion == prk; var mdef = senate.Motions.Def(pr.KindId); string does = mdef != null ? CourtProjection.MotionDoes(mdef) : "";
                    string fare = ForecastSays(pr) ?? "";
                    <div class="proposal sn-ent sn-mrow @(picked ? "open" : "")" data-proposal="@pr.KindId">
                        <Row Name="@pr.KindName" SubText="@(does.Length > 0 ? does : pr.Description)" Wrap="true" On="@picked" Tip="@(pr.Description + (fare.Length > 0 ? "\n" + fare : "") + "\nA motion is voted at the end of the year after it is moved.")" OnClick="() => _pickMotion = picked ? null : prk">
                            <Picture><span class="ui-medal sn-medal"><Icon Name="@KindIcon(pr.KindId)" Tone="@(picked ? "brass" : "ivory")" Size="22" /></span></Picture>
                            <Action>
                                @if (pr.TargetType == "none" && !pr.NeedsLaw) { <Plate Label="Move it" Small="true" Icon="scroll-quill" Stop="true" Locked="@(pr.Refusal != null)" Disabled="@(pr.Refusal != null)" Need="@(pr.Refusal != null ? Cap(pr.Refusal) : "")" ShowNeed="false" Tip="@(pr.Refusal ?? "Put it before the chamber")" CostIcon="public-speaker" CostText="@pr.Influence.ToString()" OnClick="() => MoveNone(prk)" /> }
                                else { <Plate Label="@(picked ? "Close" : "Move")" Small="true" Icon="scroll-quill" Stop="true" CostIcon="public-speaker" CostText="@pr.Influence.ToString()" Tip="@(picked ? "Put it away" : "Choose what it is about, then move it")" OnClick="() => _pickMotion = picked ? null : prk" /> }
                            </Action>
                        </Row>
                        @if (pr.TargetType == "none" && !pr.NeedsLaw && pr.Refusal != null) { <div class="sn-mneed"><Icon Name="padlock" Tone="ember" Size="13" />@Cap(pr.Refusal)</div> }
                        <div class="sn-orderbar">
                        @if (fare.Length > 0) { <div class="sn-note" data-motion-fare="@pr.KindId"><Icon Name="vote" Tone="brass" Size="15" /><span>@fare</span></div> }
                        <div class="sn-form">
                        @if (pr.NeedsLaw && pr.Laws != null)
                        {
                            <span class="sn-selwrap"><select class="sel" @onchange="e => SetLaw(pr.KindId, e)">
                                <option value="">Which law of the Reach</option>
                                @foreach (var grp in pr.Laws.GroupBy(l => l.Category)) { <optgroup label="@grp.Key" data-act-category="@grp.Key">@foreach (var l in grp) { <option value="@l.Id">@l.Name · now @l.Options.First(o => o.Id == l.InForce).Name.ToLowerInvariant()</option> }</optgroup> }
                            </select><Icon Name="chev" Tone="brass" Size="12" /></span>
                            @if (ActLaw(pr) is { } al)
                            {
                                <span class="sn-selwrap"><select class="sel" @onchange="e => SetOption(pr.KindId, e)">
                                    <option value="">Be set to</option>
                                    @foreach (var o in al.Options.Where(o => o.Id != al.InForce)) { <option value="@o.Id">@o.Name · @o.Effects@(o.Opinions.Length > 0 ? " · " + o.Opinions : "")</option> }
                                </select><Icon Name="chev" Tone="brass" Size="12" /></span>
                            }
                            <Plate Label="Move it" Small="true" Icon="scroll-quill" Locked="@(!CanMoveAct(pr))" Disabled="@(!CanMoveAct(pr))" Tip="@(ActRefusal(pr) ?? "Put it before the chamber")" CostIcon="public-speaker" CostText="@pr.Influence.ToString()" OnClick="() => MoveAct(prk)" />
                        }
                        else if (pr.TargetType == "none") { <Plate Label="Move it" Small="true" Icon="scroll-quill" Locked="@(pr.Refusal != null)" Disabled="@(pr.Refusal != null)" Tip="@(pr.Refusal ?? "Put it before the chamber")" CostIcon="public-speaker" CostText="@pr.Influence.ToString()" OnClick="() => MoveNone(prk)" /> @if (pr.Refusal != null) { <span class="sn-no">@Cap(pr.Refusal)</span> } }
                        else
                        {
                            <span class="sn-selwrap"><select class="sel" @onchange="e => SetTarget(pr.KindId, e)">
                                <option value="">@(pr.TargetType == "house" ? "Choose a house" : pr.TargetType == "nation" ? "Choose a nation beyond the Reach" : pr.TargetType == "edict" ? "Choose an edict in force" : "Choose a region")</option>
                                @foreach (var t in pr.Targets) { <option value="@t.Id">@t.Name</option> }
                            </select><Icon Name="chev" Tone="brass" Size="12" /></span>
                            @if (pr.NeedsOffice && pr.Offices != null)
                            {
                                <span class="sn-selwrap"><select class="sel" @onchange="e => SetOffice(pr.KindId, e)">
                                    <option value="">Which office</option>
                                    @foreach (var o in pr.Offices) { <option value="@o.Id">@o.Name</option> }
                                </select><Icon Name="chev" Tone="brass" Size="12" /></span>
                            }
                            { string? tno = TargetRefusal(pr); <Plate Label="Move it" Small="true" Icon="scroll-quill" Locked="@(tno != null)" Disabled="@(tno != null)" Tip="@(tno ?? "Put it before the chamber")" CostIcon="public-speaker" CostText="@pr.Influence.ToString()" OnClick="() => MoveTarget(prk)" /> @if (tno != null && !string.IsNullOrEmpty(_target.GetValueOrDefault(pr.KindId))) { <span class="sn-no" data-motion-no>@Cap(tno)</span> } }
                        }
                        </div>
                        @if (pr.NeedsLaw && ActLaw(pr) is { } al2)
                        {
                            <div class="sn-tx ui-dim">@al2.Description</div>
                            @if (ActOption(pr) is { } chosenOpt) { <div class="sn-note" data-act-option-does="@chosenOpt.Id"><Icon Name="scales" Tone="brass" Size="15" /><span><b>@chosenOpt.Name</b>: @(chosenOpt.Effects.TrimEnd('.')). @(chosenOpt.Opinions.Length > 0 ? "The estates: " + chosenOpt.Opinions + "." : "")</span></div> }
                            @if (ActRefusal(pr) is { } ar && ActOption(pr) != null) { <div class="sn-no">@Cap(ar)</div> }
                        }
                        @foreach (var (ab, asWhat) in AskAbove.Above(w, house.Id))
                        {
                            /* your patron or your bench's leader may move it in its own name: the way a house with no voice gets a
