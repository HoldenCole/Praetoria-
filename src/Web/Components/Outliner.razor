@inject GameClient G
@* The outliner (docs/VISUAL_SYSTEM.md 3.7): on the right over the map, no slab behind it. Each section is a head strip of brushed
   steel (a brass chevron that turns when folded, an icon, small capitals, the count at the right, in warn colour when something is
   missing) over rows with their own dark backing. Reports carry a crop of the event's painting, the title, a state line and a brass
   wax seal while unanswered; fleets their token; holdings a small lit globe. Empty sections are hidden. With a window open (or
   under 1500px) only Reports stays open and the rest fold to their heads; a click on a head opens or folds it. The alerts that
   used to stand here are the alerts row (AlertsRow) under the top bar. It stops above the console. *@
@{
    var m = Model; var w = G.World!; var house = w.House(w.Protagonist!.HouseId)!;
    int unanswered = m.Briefing.Count(b => !b.Resolved);
    var underOthers = w.ProvincesOf(house.Id).Where(x => x.h.OwnerId != house.Id).ToList();
    int filled = m.Advisors.Count(a => !a.Vacant);
}
<aside class="outliner @(Folded ? "folded" : "")">
    @if (m.Briefing.Count > 0)
    {
        <section class="ol-sec @(Open("reports") ? "" : "shut")" data-ol="reports">
            @Head("reports", "report", "Reports", unanswered.ToString(), false, "The year's reports: who waits at your door and what came. Each is answered in its own window; left unanswered at the year's end, it lapses.")
            @if (Open("reports"))
            {
                @foreach (var b in m.Briefing)
                {
                    string scene = SceneArt.For(b.Item.Fired.Def.Id, b.Title);
                    <button class="ol-row ol-report rep @b.Tier.ToLowerInvariant() @(b.Resolved ? "done" : "")" data-report title="@(b.Resolved ? "Answered: open it again to read what was said" : "Open this report")" @onclick="() => OnOpenReport.InvokeAsync(b)">
                        <span class="crop"><img src="img/scenes/@(scene).webp" alt="" loading="lazy" /></span>
                        <span class="nm"><span class="title">@b.Title</span><span class="k">@(b.Resolved ? "Answered" : b.Setpiece || b.Tier == "AMBIENT" ? "Lapses at the year's end" : "Answer by the year's end")</span></span>
                        @if (b.Resolved) { <Icon Name="check" Tone="good" Size="14" Class="tick" /> }
                        else { <Icon Name="wax-seal" Tone="brass" Size="20" Class="wseal" /> }
                    </button>
                }
            }
        </section>
    }
    @if (m.Fleets.Count > 0)
    {
        <section class="ol-sec @(Open("fleets") ? "" : "shut")" data-ol="fleets">
            @Head("fleets", "fleet", "Fleets", m.Fleets.Count.ToString(), false, "Your fleets. Pick one and the map goes to it; the next world you click shows the way there.")
            @if (Open("fleets"))
            {
                @foreach (var f in m.Fleets)
                {
                    <button class="ol-row" data-ol-fleet="@f.Id" title="@($"Pick this fleet: the map goes to it, and the next world you click shows the way there\n{Counted.Hulls(f.Strength)} · {(f.Moving ? "bound for " + f.Destination : "at " + f.Where)}")" @onclick='() => OnGo.InvokeAsync("fleet:" + f.Id)'>
                        <svg class="tok" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20 L12 3 L21 20 L12 15 Z" fill="@m.HouseAccent" stroke="#000" stroke-width="1.4" stroke-linejoin="round" /><path d="M12 3 L12 15 L3 20 Z" fill="#fff" opacity=".22" /></svg>
                        <span class="nm">@f.Name</span><span class="m">@(f.Moving ? "bound for " + f.Destination : Counted.Hulls(f.Strength))</span>
                    </button>
                }
            }
        </section>
    }
    @if (m.Holdings.Count + underOthers.Count > 0)
    {
        <section class="ol-sec @(Open("holdings") ? "" : "shut")" data-ol="holdings">
            @Head("holdings", "planet", "Holdings", (m.Holdings.Count + underOthers.Count).ToString(), false, "The worlds and provinces the house holds. Click one and the map goes to it.")
            @if (Open("holdings"))
            {
                @foreach (var h in m.Holdings)
                {
                    var hold = w.Holding(h.Id); string cls = hold != null ? w.Galaxy?.System(hold.SystemId)?.PlanetClass ?? "terran" : "terran";
                    <button class="ol-row" title="@($"{h.Name}: {h.SpecName}{(h.Unrest >= 50 ? ", restless" : "")}{(h.Besieged ? ", besieged" : "")}. Click and the map goes to it.")" @onclick='() => OnGo.InvokeAsync("galaxy:" + (hold?.SystemId ?? ""))'>
                        <Globe Class="@cls" Size="18" Ringed="false" />
                        <span class="nm">@h.Name</span><span class="m @(h.Besieged || h.Unrest >= 50 ? "warn" : "")">@(h.Besieged ? "besieged" : h.Unrest >= 50 ? "restless" : h.SpecName)</span>
                    </button>
                }
                @foreach (var (uh, ui) in underOthers)
                {
                    string usys = uh.SystemId; string ucls = w.Galaxy?.System(usys)?.PlanetClass ?? "terran";
                    <button class="ol-row" data-ol-province title="@($"A province you hold under another house, for life: {uh.Provinces[ui].Name}, on {uh.Name}, under {w.House(uh.OwnerId)?.Name}")" @onclick='() => OnGo.InvokeAsync("galaxy:" + usys)'>
                        <Globe Class="@ucls" Size="18" Ringed="false" />
                        <span class="nm">@uh.Provinces[ui].Name</span><span class="m">Province</span>
                    </button>
                }
            }
        </section>
    }
    @if (m.Advisors.Count > 0)
    {
        <section class="ol-sec shut" data-ol="council">
            <button class="ol-head" data-ol-council title="The posts of the house's council: who holds each, what they did this year, and what you have told them." @onclick='() => OnGo.InvokeAsync("house:council")'>
                <i class="chev"></i><Icon Name="round-table" Tone="ivory" Size="16" /><span class="t">Council</span><span class="n @(filled < m.Advisors.Count ? "warn" : "")">@filled of @m.Advisors.Count</span>
            </button>
        </section>
    }
</aside>

@code {
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    [Parameter] public EventCallback<BriefingCard> OnOpenReport { get; set; }
    [Parameter] public EventCallback<string> OnGo { get; set; }
    /// <summary>A window is open, or the screen is under 1500px: every section but Reports shows only its head until it is opened.</summary>
    [Parameter] public bool Folded { get; set; }

    /// <summary>What the player opened or folded: kept apart for the map at rest and for when a window is open.</summary>
    private readonly Dictionary<string, bool> _open = new();
    private string Key(string section) => Folded && section != "reports" ? section + ":folded" : section;
    private bool Open(string section) => _open.TryGetValue(Key(section), out var o) ? o : !Folded || section == "reports";
    private void Toggle(string section) => _open[Key(section)] = !Open(section);

    private RenderFragment Head(string section, string icon, string title, string count, bool warn, string tip) => __builder =>
    {
        <button class="ol-head" aria-expanded="@Open(section)" title="@tip" @onclick="() => Toggle(section)">
            <i class="chev"></i><Icon Name="@icon" Tone="ivory" Size="16" /><span class="t">@title</span><span class="n @(warn ? "warn" : "")">@count</span>
        </button>
    };
}
