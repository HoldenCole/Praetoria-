@inject GameClient G
@{
    var m = Model; var w = G.World!; var house = w.House(w.Protagonist!.HouseId)!;
    var open = m.Briefing.Where(b => !b.Resolved).ToList();
    var alerts = new List<(string cls, string text, string? go)>();
    if (m.Treasury.Insolvent) alerts.Add(("warn", $"Insolvent: {m.Treasury.Credits} credits", "house"));
    foreach (var war in m.Wars) alerts.Add(("warn", $"At war with {war.EnemyName}{(war.TheyAreSuing ? " — they sue for peace" : "")}", "military"));
    foreach (var sg in m.Sieges.Where(s => s.Ours)) alerts.Add(("warn", $"{sg.HoldingName} besieged by {sg.BesiegerName} ({sg.Turns}/{sg.Required})", "galaxy"));
    foreach (var h in m.Household.Where(h => h.Actions.Any(a => a.Id == "defiant"))) alerts.Add(("warn", $"{h.Name} is defiant", "dynasty"));
    if (m.Character.Regency) alerts.Add(("info", "A regent rules in your name", "dynasty"));
    if (w.HasFlag("pirates_near")) alerts.Add(("warn", "Raiders within a lane of your worlds", "galaxy"));
    if (w.HasFlag("raided")) alerts.Add(("warn", "Your shipping was plundered", "galaxy"));
    if (w.HasFlag("fuel_short")) alerts.Add(("warn", "The tanks are dry — the fleet cannot sail", "military"));
    string NationName(string prefix) => w.WorldFlags.Where(f => f.StartsWith(prefix)).Select(f => G.Content!.Nations.Def(f[prefix.Length..])?.Name ?? f[prefix.Length..]).FirstOrDefault() ?? "a nation beyond the Reach";
    if (w.HasFlag("foreign_war_declared")) alerts.Add(("warn", $"The Senate has made war on {NationName("foreign_war:")} — fleets may be sent", "military"));
    else if (w.HasFlag("foreign_war")) alerts.Add(("info", $"The Reach is at war with {NationName("foreign_war:")}{(w.HasFlag("expedition_away") ? " — your fleet is in their space" : " — send a fleet, or let others win the triumph")}", "military"));
    if (w.HasFlag("expedition_victory")) alerts.Add(("good", "Your fleet beat them in their own space", "military"));
    if (w.HasFlag("expedition_defeat")) alerts.Add(("warn", "Your fleet was beaten beyond the Reach", "military"));
    if (w.HasFlag("expedition_lost")) alerts.Add(("warn", "Your expedition is broken and limping home", "military"));
    if (w.HasFlag("expedition_returned")) alerts.Add(("good", "Your fleet is home from beyond the Reach", "military"));
    if (w.HasFlag("triumph")) alerts.Add(("good", $"The triumph is yours — {NationName("nation_subdued:")} pays tribute", "military"));
    else if (w.HasFlag("nation_subdued")) alerts.Add(("good", $"{NationName("nation_subdued:")} sues for peace and pays tribute", "military"));
    if (w.HasFlag("war_lost_abroad")) alerts.Add(("warn", "The war abroad is lost — the chair buys peace", "military"));
    if (w.HasFlag("raided_by_nation")) alerts.Add(("warn", $"Raiders of {NationName("raided_by:")} fell on your world", "military"));
    if (w.HasFlag("nation_freed")) alerts.Add(("info", "A tributary's treaty is done; its tribute stops", "military"));
    foreach (var f in w.WorldFlags.Where(f => f.StartsWith("price_spike:")).Take(2)) { var gd = G.Content!.Market.Good(f["price_spike:".Length..]); var gs = w.Market?.Good(gd?.Id ?? ""); if (gd != null && gs != null) alerts.Add(("info", $"{gd.Name} dear on the Exchange: {gs.Cause}", "exchange")); }
    if (w.HasFlag("venture_offered")) alerts.Add(("info", "A venture is offered to you — the offer stands for the year", "exchange"));
    if (w.HasFlag("project_stalled")) alerts.Add(("warn", "A building site has stalled: the year's instalment was not met", "exchange"));
    if (w.HasFlag("project_done")) alerts.Add(("good", "A project of yours is finished", "exchange"));
    if (w.HasFlag("first_refusal_taken")) alerts.Add(("info", "The world's holder matched your price and took the venture first", "exchange"));
    if (w.HasFlag("motion_against_me")) alerts.Add(("warn", "A motion against your house is before the Senate", "senate"));
    else if (w.HasFlag("petition_open")) alerts.Add(("info", "An estate petitions the Senate — its regard in every house rides on the vote", "senate"));
    else if (w.HasFlag("motion_open")) alerts.Add(("info", "A motion is before the Senate — your vote has weight", "senate"));
    else if (w.HasFlag("act_open")) alerts.Add(("info", "An Act of the Senate is before the chamber — the law of the Reach rides on it", "senate"));
    if (w.Motions.Any(x => x.Open && x.ProposedTurn < w.Turn && !x.Votes.ContainsKey(w.Protagonist!.HouseId))) alerts.Add(("warn", "A motion is decided at the end of this turn and your vote is undeclared", "senate"));
    if (w.HasFlag("election_near")) alerts.Add(("info", "The consuls are elected at the turn's end — stand, or see who the parties put up", "senate"));
    if (w.HasFlag("consul_elected")) alerts.Add(("good", "You are elected consul", "senate"));
    if (w.HasFlag("consul_lost")) alerts.Add(("info", "Your consulship has ended", "senate"));
    if (w.HasFlag("vetoed_mine")) alerts.Add(("warn", "A consul has vetoed your motion", "senate"));
    if (w.HasFlag("petition_refused")) alerts.Add(("warn", "The Senate turned a petition away — the estate's worlds stir", "laws"));
    if (w.HasFlag("petition_carried")) alerts.Add(("good", "The Senate heard a petition — the estate's regard rises", "laws"));
    if (w.HasFlag("embargoed")) alerts.Add(("warn", "The Senate's embargo closes the exchanges to you", "senate"));
    if (w.HasFlag("office_granted")) alerts.Add(("good", "The Senate has commissioned you to an office", "senate"));
    if (w.HasFlag("office_lost")) alerts.Add(("warn", w.HasFlag("treason") ? "Stripped of office for treason" : "Relieved of office by the Senate", "senate"));
    foreach (var f in w.WorldFlags.Where(f => f.StartsWith("office_vacant:")).Take(1)) alerts.Add(("info", "An office of the Reach stands vacant", "senate"));
    if (w.HasFlag("faction_against_me")) alerts.Add(("warn", "A bench's leader has moved against you — the whole bench will follow", "senate"));
    if (w.HasFlag("broke_the_whip")) alerts.Add(("warn", "You voted against your bench", "senate"));
    if (w.HasFlag("faction_formed")) alerts.Add(("info", "A bench has formed with you on it", "senate"));
    if (w.HasFlag("faction_dissolved")) alerts.Add(("info", "Your bench has broken", "senate"));
    foreach (var f in w.WorldFlags.Where(f => f.StartsWith("estate_hostile:")).Take(2)) alerts.Add(("warn", $"{G.Content!.Policies.Estate(f["estate_hostile:".Length..])?.Name ?? f} are hostile to the house", "laws"));
    if (w.HasFlag("governor_revolt")) alerts.Add(("warn", "A governor has declared a world for themselves", "houses"));
    if (w.HasFlag("freehold_of_ours")) alerts.Add(("info", "A world of yours is a free hold — buy it back or take it", "houses"));
    if (w.HasFlag("capital_taken")) alerts.Add(("good", "You hold the capital", "senate"));
    // the military depth (docs/MILITARY.md): battles about to be joined, crews and supply, the campaign, the Achilles name
    foreach (var sys in w.Fleets.Values.Where(f => f.OwnerId == house.Id && !f.Moving).Select(f => f.SystemId).Distinct().Where(sid => w.Fleets.Values.Any(e => !e.Moving && e.SystemId == sid && e.OwnerId != house.Id && w.AtWar(house.Id, e.OwnerId))).Take(2))
    {
        var enemy = w.Fleets.Values.First(e => !e.Moving && e.SystemId == sys && e.OwnerId != house.Id && w.AtWar(house.Id, e.OwnerId));
        alerts.Add(("warn", $"Battle at {w.Galaxy?.System(sys)?.Name ?? sys} at the turn's end — {w.House(enemy.OwnerId)?.Name ?? "the enemy"} in the sky; set your stance", "military"));
    }
    if (w.HasFlag("fleet_mutinous")) alerts.Add(("warn", "A fleet has mutinied — hulls are deserting", "military"));
    else if (w.HasFlag("fleet_restive")) alerts.Add(("warn", "A fleet's crews are restive and will not sail", "military"));
    if (w.HasFlag("out_of_supply")) alerts.Add(("warn", "A fleet is out of supply — hulls will desert", "military"));
    else if (w.HasFlag("supply_low")) alerts.Add(("info", "A fleet is running short of supply", "military"));
    if (w.HasFlag("campaign_over")) alerts.Add(("info", "The campaign is over — the fleet is recalled", "military"));
    if (w.HasFlag("became_achilles")) alerts.Add(("good", "The Reach speaks your name as it speaks of Achilles", "military"));
    if (w.HasFlag("hulls_captured")) alerts.Add(("good", "Prize crews have taken enemy hulls", "military"));
    if (w.HasFlag("capital_lost")) alerts.Add(("warn", "The capital is lost", "senate"));
    if (w.HasFlag("rebellion")) alerts.Add(("warn", "A world of yours is in revolt", "house"));
    if (w.HasFlag("fief_granted")) alerts.Add(("good", w.IsImperium ? "You have been granted a fief" : "You have been entrusted with a world", "house"));
    foreach (var f in w.WorldFlags.Where(f => f.StartsWith("house_fell:"))) alerts.Add(("info", $"{f["house_fell:".Length..]} has passed out of the rolls", "houses"));
    if (m.GreatCrisis is { Stage: not null, Resolved: false } gc) alerts.Add(("info", $"{gc.Name}: {gc.Stage}", "houses"));
    if (!w.Characters.Values.Any(c => c.Alive && c.HouseId == house.Id && c.Id != w.ProtagonistId)) alerts.Add(("warn", "No heir — the line hangs by a thread", "dynasty"));
    if (m.Crises != null) foreach (var c in m.Crises.Active) alerts.Add(("warn", $"Crisis: {c.Name} (severity {c.Severity})", "house"));
}
<aside class="outliner">
    <section class="ol-block">
        <h4><Icon Name="report" Size="13" /> Reports <span class="count">@open.Count</span></h4>
        @if (m.Briefing.Count == 0) { <div class="ol-empty">A quiet turn. No one waits at your door.</div> }
        @foreach (var b in m.Briefing)
        {
            <button class="ol-report @b.Tier.ToLowerInvariant() @(b.Resolved ? "done" : "")" @onclick="() => OnOpenReport.InvokeAsync(b)">
                <span class="glyph">@(b.Setpiece ? "✦" : b.Tier == "AMBIENT" ? "·" : "◆")</span>
                <span class="title">@b.Title</span>
                @if (b.Resolved) { <span class="tick">✓</span> }
            </button>
        }
    </section>
    <section class="ol-block">
        <h4><Icon Name="alert" Size="13" /> Alerts <span class="count">@alerts.Count</span></h4>
        @if (alerts.Count == 0) { <div class="ol-empty">Nothing presses.</div> }
        @foreach (var a in alerts) { <button class="ol-alert @a.cls" @onclick='() => OnGo.InvokeAsync(a.go ?? "office")'>@a.text</button> }
    </section>
    <section class="ol-block">
        <h4><Icon Name="claim" Size="13" /> Council</h4>
        @foreach (var a in m.Advisors.OrderBy(a => { var o = RoleTheme.AdvisorOrder(RoleTheme.Of(w)); int i = o.ToList().IndexOf(a.Seat); return i < 0 ? 9 : i; })) { <div class="ol-adv @(a.Warning ? "warn" : "")" title="@a.Line"><b>@a.Seat</b> <span class="muted">@(a.AdvisorName ?? "vacant")</span><div class="line">@a.Line</div></div> }
    </section>
    <section class="ol-block">
        <h4><Icon Name="fleet" Size="13" /> Fleets <span class="count">@m.Fleets.Count</span></h4>
        @foreach (var f in m.Fleets) { <button class="ol-row" @onclick='() => OnGo.InvokeAsync("galaxy")'><b>@f.Name</b> <span class="muted">@f.Strength hulls · @(f.Moving ? $"→ {f.Destination}" : f.Where)</span></button> }
    </section>
    <section class="ol-block">
        <h4><Icon Name="planet" Size="13" /> Holdings <span class="count">@m.Holdings.Count</span></h4>
        @foreach (var h in m.Holdings) { <button class="ol-row" @onclick='() => OnGo.InvokeAsync("house")'><b>@h.Name</b> <span class="muted">@h.SpecName@(h.Unrest >= 50 ? " · restless" : "")@(h.Besieged ? " · besieged" : "")</span></button> }
    </section>
</aside>

@code {
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    [Parameter] public EventCallback<BriefingCard> OnOpenReport { get; set; }
    [Parameter] public EventCallback<string> OnGo { get; set; }
}
