@* A warn strip (docs/VISUAL_SYSTEM.md 4.9): one thing that needs doing. A warn rule at the left, a faint wash, an icon, one sentence
   with its lead in bold ("No governor.") and the way to do it as a small plate at the right. Bad makes it the danger red. *@
<div class="ui-wstrip @(Bad ? " bad" : "") @(Class.Length > 0 ? " " + Class : "")">
    <Icon Name="@Icon" Tone="@(Bad ? "ember" : "brass")" Size="18" />
    <span class="ui-wstrip-t">@if (Lead.Length > 0) { <b>@Lead</b>@(" ") }@ChildContent</span>
    @Action
</div>
@code {
    [Parameter] public string Icon { get; set; } = "office-chair";
    [Parameter] public string Lead { get; set; } = "";
    [Parameter] public bool Bad { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Action { get; set; }
    [Parameter] public string Class { get; set; } = "";
}
