@* Segmented plates (docs/VISUAL_SYSTEM.md 4.11): joined with no gaps; the chosen one recessed with brass text and a brass foot. *@
<span class="ui-seg-wrap">
    @if (Label.Length > 0) { <span class="ui-seg-l">@Label</span> }
    <span class="ui-seg" role="radiogroup">
        @foreach (var (key, text, tip) in Options)
        {
            var k = key;
            <button class="@(k == Value ? "on" : "")" role="radio" aria-checked="@(k == Value ? "true" : "false")" title="@tip" @onclick="() => OnChange.InvokeAsync(k)">@text</button>
        }
    </span>
</span>
@code {
    [Parameter] public IReadOnlyList<(string key, string text, string tip)> Options { get; set; } = Array.Empty<(string, string, string)>();
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public EventCallback<string> OnChange { get; set; }
}
