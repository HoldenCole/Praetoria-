@* The painted header (docs/VISUAL_SYSTEM.md 4.2, 4.3): the subject's painting (img/scenes, brightened), a shade dark only behind
   the text, the house's wax seal or the screen's glyph in a brass medallion, the kicker, the title in Cinzel, the facts, and on the
   painting's foot under a gilt rule the plinth: at most five figures (seven for a person), numbers only. A person's header is 288px
   tall and stands their portrait (the Who slot) where the seal would be. Paintings by window: House world, You by career, Dynasty
   family, Worlds world, Military bridge, Exchange audience, Senate senate, Laws court, Houses audience, Chronicle funeral or
   dispatch, Office audience. *@
<header class="ui-head @(Who != null ? " tall portrait-head" : Tall ? " tall" : "") @(Class.Length > 0 ? " " + Class : "")">
    <div class="ui-head-art" style="background-image:url('img/scenes/@(Scene).webp')"></div>
    <div class="ui-head-shade"></div>
    @if (Who != null) { <div class="ui-head-who">@Who</div> }
    else if (HouseId.Length > 0) { <div class="ui-head-mark"><Sigil HouseId="@HouseId" Accent="@Accent" Size="82" Mode="seal" /></div> }
    else if (Glyph.Length > 0) { <div class="ui-head-mark"><span class="ui-medal"><Icon Name="@Glyph" Tone="brass" Size="40" /></span></div> }
    <div class="ui-head-text">
        @if (Kicker.Length > 0) { <div class="ui-kick">@Kicker</div> }
        <h2 class="ui-title">@Title</h2>
        @if (Lede != null) { <p class="ui-lede-head">@Lede</p> }
        @if (Facts != null) { <div class="ui-facts">@Facts</div> }
        @ChildContent
    </div>
    @if (Figures is { Count: > 0 })
    {
        <div class="ui-plinth">
            @foreach (var f in Figures.Take(Who != null ? 7 : 5))
            {
                <div class="ui-fig" title="@f.Tip">
                    <Icon Name="@f.Icon" Tone="@(f.Tone.Length > 0 ? f.Tone : "ivory")" Size="24" />
                    <div class="ui-fig-vv">
                        <span class="ui-fig-v">@f.Value@if (f.Of.Length > 0) { <small>/@f.Of</small> }@if (f.Delta.Length > 0) { <span class="d @(f.Delta.StartsWith("−") || f.Delta.StartsWith("-") ? "ui-down" : "ui-up")">@f.Delta</span> }</span>
                        <span class="ui-fig-l">@f.Label</span>
                    </div>
                </div>
            }
        </div>
    }
</header>
@code {
    /// <summary>One figure on the plinth: a 24px icon, the value (its ceiling as "/8" when Of is set, a yearly change in Delta), a label.</summary>
    public sealed record Figure(string Icon, string Value, string Label, string Tone = "", string Of = "", string Delta = "", string Tip = "");
    /// <summary>The painting's key in img/scenes (SceneArt's names): world, bridge, court, senate, family, audience, funeral, dispatch...</summary>
    [Parameter] public string Scene { get; set; } = "audience";
    [Parameter] public string Kicker { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    /// <summary>The house whose wax seal marks the header; leave empty for a screen not about a house and give a Glyph instead.</summary>
    [Parameter] public string HouseId { get; set; } = "";
    [Parameter] public string Accent { get; set; } = Palette.Player;
    [Parameter] public string Glyph { get; set; } = "";
    [Parameter] public bool Tall { get; set; }
    [Parameter] public RenderFragment? Who { get; set; }
    [Parameter] public RenderFragment? Lede { get; set; }
    [Parameter] public RenderFragment? Facts { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public IReadOnlyList<Figure>? Figures { get; set; }
    [Parameter] public string Class { get; set; } = "";
}
