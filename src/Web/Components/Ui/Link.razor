@* A link to another window or tab (docs/VISUAL_SYSTEM.md 4.11): brass text with a small chevron, never a plate. *@
<button class="ui-link @(Class.Length > 0 ? " " + Class : "")" title="@Tip" @onclick="OnClick">@Label<Icon Name="chev" Size="11" Class="flat" /></button>
@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Tip { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback OnClick { get; set; }
}
