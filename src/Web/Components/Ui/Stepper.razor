@* A quantity (docs/VISUAL_SYSTEM.md 4.12): a joined stepper, a minus plate, a recessed figure, a plus plate. Format writes the figure
   (a sum of money through Money.Show, say); Input makes the figure a recessed field the player can type into, clamped to Min and
   Max. FewerTip and MoreTip are the plates' tooltips ("−1,000"). Any other attribute (a data-* hook for the scripts) lands on the
   figure. *@
<span class="ui-step-wrap @(Class.Length > 0 ? " " + Class : "")">
    @if (Label.Length > 0) { <span class="ui-seg-l" title="@(LabelTip.Length > 0 ? LabelTip : null)">@Label</span> }
    <span class="ui-step @(Input ? " input" : "")" title="@(Tip.Length > 0 ? Tip : null)">
        <button aria-label="@FewerLabel" title="@(FewerTip.Length > 0 ? FewerTip : null)" disabled="@(Value - Step < Min)" @onclick="() => OnChange.InvokeAsync(Math.Max(Min, Value - Step))"><Icon Name="minus" Tone="ivory" Size="12" /></button>
        @if (Input)
        {
            if (Live) { <input type="number" min="@Min" max="@Max" step="@Step" value="@Value" aria-label="@(InputLabel.Length > 0 ? InputLabel : Label)" @oninput="Typed" @attributes="Attrs" /> }
            else { <input type="number" min="@Min" max="@Max" step="@Step" value="@Value" aria-label="@(InputLabel.Length > 0 ? InputLabel : Label)" @onchange="Typed" @attributes="Attrs" /> }
        }
        else
        {
            <b @attributes="Attrs">@(Format != null ? Format(Value) : Value.ToString("N0"))</b>
        }
        <button aria-label="@MoreLabel" title="@(MoreTip.Length > 0 ? MoreTip : null)" disabled="@(Value + Step > Max)" @onclick="() => OnChange.InvokeAsync(Math.Min(Max, Value + Step))"><Icon Name="plus" Tone="ivory" Size="12" /></button>
    </span>
</span>
@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public int Min { get; set; }
    [Parameter] public int Max { get; set; } = 999;
    [Parameter] public int Step { get; set; } = 1;
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string LabelTip { get; set; } = "";
    [Parameter] public string Tip { get; set; } = "";
    /// <summary>How the figure is written: a sum through Money.Show, a count with its noun. Leave it null for the plain number.</summary>
    [Parameter] public Func<int, string>? Format { get; set; }
    /// <summary>The figure is a field the player can type a number into, kept within Min and Max.</summary>
    [Parameter] public bool Input { get; set; }
    [Parameter] public string InputLabel { get; set; } = "";
    /// <summary>With Input: the figure is taken as it is typed, not when the field is left.</summary>
    [Parameter] public bool Live { get; set; }
    [Parameter] public string FewerLabel { get; set; } = "Fewer";
    [Parameter] public string MoreLabel { get; set; } = "More";
    [Parameter] public string FewerTip { get; set; } = "";
    [Parameter] public string MoreTip { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback<int> OnChange { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attrs { get; set; }
    private Task Typed(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var v) ? OnChange.InvokeAsync(Math.Clamp(v, Min, Max)) : Task.CompletedTask;
}
