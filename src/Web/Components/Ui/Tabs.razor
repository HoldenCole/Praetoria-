@* Tabs (docs/VISUAL_SYSTEM.md 4.4): one row under the painting, at most six; a tab with Hidden set (an empty one) is not drawn. Raised
   plates with a 16px icon; a count is a small round badge, gold when it needs action. The chosen tab takes the body's colour, loses
   its bottom edge and gains a brass top line, so it joins the page. Long names are cut to one or two words by the caller. Under
   1500px wide, a row of five or more drops its icons before it wraps. *@
<nav class="ui-tabs @(Shown.Count >= 5 ? " many" : "") @(Class.Length > 0 ? " " + Class : "")" role="tablist">
    @foreach (var t in Shown)
    {
        var key = t.Key;
        <button class="ui-tab @(key == Active ? " on" : "")" role="tab" aria-selected="@(key == Active ? "true" : "false")" data-tab="@key" title="@t.Tip" @onclick="() => OnPick.InvokeAsync(key)">
            @if (t.Icon.Length > 0) { <Icon Name="@t.Icon" Tone="@(key == Active ? "brass" : "ivory")" Size="16" /> }
            @t.Label
            @if (t.Count.Length > 0) { <span class="ui-cnt @(t.Warn ? " warn" : "")">@t.Count</span> }
        </button>
    }
</nav>
@code {
    public sealed record Tab(string Key, string Label, string Icon = "", string Count = "", bool Warn = false, bool Hidden = false, string Tip = "");
    [Parameter] public IReadOnlyList<Tab> Items { get; set; } = Array.Empty<Tab>();
    [Parameter] public string Active { get; set; } = "";
    [Parameter] public EventCallback<string> OnPick { get; set; }
    [Parameter] public string Class { get; set; } = "";
    private List<Tab> Shown => Items.Where(t => !t.Hidden).Take(6).ToList();
}
