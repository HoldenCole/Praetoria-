@* A game-icons.net glyph (CC BY 3.0) drawn in the current text colour. *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 512 512" aria-hidden="true" focusable="false"><path d="@Icons.Path(Name)" fill="currentColor"/></svg>
@code {
    [Parameter] public string Name { get; set; } = "sigil";
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public string Class { get; set; } = "";
}
