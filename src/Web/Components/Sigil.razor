@* A procedural house sigil: a shield in the house accent carrying a charge chosen from the house id, so every house has a
   stable, distinct mark without any art assets (GDD §19 "territory shaded by house accent" extended to heraldry). *@
<svg class="sigil" width="@Size" height="@Size" viewBox="0 0 40 44" aria-label="sigil of @HouseId">
    <defs>
        <linearGradient id="@("sg" + Key)" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="@Accent" stop-opacity="1"/><stop offset="1" stop-color="@Accent" stop-opacity=".55"/></linearGradient>
    </defs>
    <path d="M20 2 L37 7 V22 C37 32 29 39 20 42 C11 39 3 32 3 22 V7 Z" fill="url(#@("sg" + Key))" stroke="#e6c77a" stroke-width="1.2"/>
    @switch (Charge)
    {
        case 0: <path d="M8 26 L20 12 L32 26 L28 26 L20 17 L12 26 Z" fill="#f3e9cf"/> break;
        case 1: <path d="M20 9 L23 18 L32 19 L25 25 L27 34 L20 29 L13 34 L15 25 L8 19 L17 18 Z" fill="#f3e9cf"/> break;
        case 2: <g fill="#f3e9cf"><rect x="9" y="12" width="22" height="4"/><rect x="9" y="20" width="22" height="4"/><rect x="9" y="28" width="22" height="4"/></g> break;
        case 3: <circle cx="20" cy="22" r="9" fill="none" stroke="#f3e9cf" stroke-width="3.5"/> break;
        case 4: <path d="M20 8 L31 22 L20 36 L9 22 Z" fill="none" stroke="#f3e9cf" stroke-width="3.5"/> break;
        case 5: <g fill="#f3e9cf"><rect x="18" y="8" width="4" height="28"/><rect x="8" y="18" width="24" height="4"/></g> break;
        case 6: <path d="M8 30 Q20 6 32 30 Z" fill="#f3e9cf"/> break;
        default: <path d="M20 10 C27 10 32 16 32 22 C32 30 20 36 20 36 C20 36 8 30 8 22 C8 16 13 10 20 10 Z" fill="none" stroke="#f3e9cf" stroke-width="3"/> break;
    }
</svg>

@code {
    [Parameter] public string HouseId { get; set; } = "";
    [Parameter] public string Accent { get; set; } = "#888";
    [Parameter] public int Size { get; set; } = 28;
    private int Charge => Math.Abs(Hash(HouseId)) % 8;
    private string Key => Math.Abs(Hash(HouseId)).ToString();
    private static int Hash(string s) { unchecked { int h = 17; foreach (var ch in s) h = h * 31 + ch; return h; } }
}
