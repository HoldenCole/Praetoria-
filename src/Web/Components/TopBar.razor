@inject GameClient G
@{
    var w = G.World!; var p = w.Protagonist!; var house = w.House(p.HouseId)!; var t = house.Treasury;
    var fc = G.Turn!.Economy?.Forecast(w, house.Id, G.Turn.Fleets)?.Clone();
    // what also goes out this year: the shares of what is being built, hastening, tutors, allowances, the household (docs/PLAYTHROUGH.md 6)
    var outs = HouseAccounts.Outgoings(w, G.Content!.Holdings, house, G.Turn!.Economy); var outTotal = HouseAccounts.Total(outs);
    if (fc != null) foreach (var k in Resource.All) fc.Add(k, -outTotal.Get(k));
    string outTip = outs.Count == 0 ? "" : "\n\nAlso going out this year:\n" + string.Join("\n", outs.Select(o => o.what + ": " + string.Join(", ", Resource.All.Where(k => o.cost.Get(k) != 0).Select(k => "-" + o.cost.Get(k) + " " + Resource.Label(k)))));
    string purseTip = "Your own purse, apart from the house's treasury: " + p.Purse + " credits. Physicians, gifts and bribes \"of your own\" are paid from it. Move coin between the two in House, under Purses and the will.";
    var pools = G.Turn.PlayerPools;
    var ledgerTip = G.Turn.Economy == null ? "" : string.Join("\n", G.Turn.Economy.Compute(w, house.Id, G.Turn.Fleets).Lines.Take(12).Select(l => l.Source + ": " + string.Join(", ", Resource.All.Where(k => l.Delta.Get(k) != 0).Select(k => (l.Delta.Get(k) > 0 ? "+" : "") + l.Delta.Get(k) + " " + k))));
}
<header class="topbar" style="--accent:@house.AccentColor">
    <div class="tb-house" title="@house.Name · @(G.Content!.Titles.NameOf(house.Title, G.World!.Era))">
        <span class="tb-ruler"><Portrait Id="@p.Id" Name="@p.Name" Sex="@p.Sex" Age="@p.Age" Alive="@p.Alive" Accent="@house.AccentColor" Size="52" /><i class="tb-sigil"><Sigil HouseId="@house.Id" Accent="@house.AccentColor" Size="20" /></i></span>
        <div><div class="tb-name">@house.Name</div><div class="tb-sub">@(G.Content!.Titles.NameOf(house.Title, G.World!.Era)) · <span title="Legitimacy, from 0 to 100: how rightful the Reach holds your house's place to be. It is asked for at every step up in rank, and it falls when the house is caught doing what it should not.">legitimacy @house.Legitimacy</span></div></div>
    </div>
    <div class="tb-res" title="@(ledgerTip + outTip)">
        @Res("credits", t.Credits, fc?.Credits, "Credits — the one you run out of. Upkeep, hulls, bribes. The small figure is what the year will add or take, the shares of what is being built counted.")
        <span class="res purse" title="@purseTip" data-purse="@p.Purse"><small class="pl">purse</small><b>@p.Purse</b></span>
        @Res("materials", t.Materials, fc?.Materials, "Materials — building and shipbuilding.")
        @Res("manpower", t.Manpower, fc?.Manpower, "Manpower — crews and garrisons; people are soldiers.")
        @Res("influence", t.Influence, fc?.Influence, "Clout: the house's political capital in store. Seats and standing earn it; decrees and the Exchange spend it. It is not this year's influence (at the right), which is how much you can act in the Senate this year.")
        @Res("exotics", t.Exotics, fc?.Exotics, "Exotics — rare finds; sell dear or study them.")
    </div>
    <div class="tb-res strat @(w.HasFlag("fuel_short") ? "dry" : "")" title="The strategic three — dug or skimmed only where the galaxy put them. Helium-3 fuels the fleet (three hulls burn one a turn); rare earths build the heavy hulls and the clever buildings; isotopes arm battleships and bastions and are never on the open market.">
        @Res("helium3", t.Helium3, fc?.Helium3, w.HasFlag("fuel_short") ? "Helium-3 — THE TANKS ARE DRY: the fleet rides at anchor." : "Helium-3 — fusion fuel; the fleet burns it every turn.")
        @Res("rare_earths", t.RareEarths, fc?.RareEarths, "Rare earths — drives, sensors, electronics; cruisers, carriers, foundries.")
        @Res("isotopes", t.Isotopes, fc?.Isotopes, "Isotopes — weapons-grade; battleships, bastion guns, arsenals. Never sold on the open market.")
    </div>
    <div class="tb-pools" title="What you can do this year: treasury actions, influence and agents. Reading is free; acting spends them, and they come back each year.">
        <span class="pool inf" title="Influence this year: what you can do in politics before the year ends. Every button that says 'N influence' spends this. It comes back each year, and is not the clout the house keeps in store (at the left)."><Icon Name="influence_pool" Size="14" />@pools.Influence</span>
        <span class="pool tre" title="Treasury actions this year: orders that take the house's officers (a build, a fleet order). They come back each year."><Icon Name="treasury_pool" Size="14" />@pools.Treasury</span>
        <span class="pool agt" title="Agents this year: people you can send on quiet business. They come back each year."><Icon Name="agents_pool" Size="14" />@pools.Agents</span>
    </div>
    <div class="tb-right">
        <div class="tb-era">@(w.Era == "imperium" ? "The Imperium" : "The Republic")</div>
        <div class="tb-turn" title="Each turn is a year. A generation is one head of the house: when the head dies or steps down and an heir takes the seat, the next generation begins. This is year @w.Turn of the saga, under its @Nth(w.Counter("generation") + 1) head."><Icon Name="turn" Size="13" /> Year @w.Turn · @Nth(w.Counter("generation") + 1) head</div>
        <button class="btn ghost sm" title="@(G.ActedThisYear ? "The game is kept as it stood when this year began, and again each time you end a year. What you have done this year is kept when you end it." : "The game is kept in this browser as it stands now, at the start of the year, and again each time you end a year.")" @onclick="OnSave">@(SavedFlash ? (G.ActedThisYear ? "Saved: as the year began" : "Saved ✓") : "Save")</button>
        <button class="btn ghost sm" title="Download the save as a file" @onclick="OnExport">Export</button>
        <button class="btn ghost sm" title="The primer: what the screens and the pools are" @onclick="OnPrimer">?</button>
        <button class="btn ghost sm" title="Leave to the title screen. The saga is kept as it stood when this year began." @onclick="OnQuit">Quit</button>
    </div>
</header>

@code {
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }
    [Parameter] public EventCallback OnQuit { get; set; }
    [Parameter] public EventCallback OnPrimer { get; set; }
    [Parameter] public bool SavedFlash { get; set; }

    private static string Nth(int n) => n % 100 is 11 or 12 or 13 ? n + "th" : (n % 10) switch { 1 => n + "st", 2 => n + "nd", 3 => n + "rd", _ => n + "th" };
    private static RenderFragment Res(string name, int value, int? delta, string tip) => __builder =>
    {
        <span class="res" title="@tip">
            <Icon Name="@name" Size="16" Class="ri" /><b>@value</b>
            @if (delta != null && delta != 0) { <small class="@(delta > 0 ? "up" : "down")">@(delta > 0 ? "+" : "")@delta</small> }
        </span>
    };
}
