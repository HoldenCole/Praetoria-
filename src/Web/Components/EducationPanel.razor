@using Praetoria.Core.Systems
@inject GameClient G
@implements IDisposable
@{
    var w = G.World!; var p = w.Protagonist!; var pid = p.Id; var house = w.House(p.HouseId)!;
    var young = w.LivingCharacters().Where(c => c.HouseId == house.Id && c.Id != pid && c.Age < EducationSystem.Adult).OrderByDescending(c => c.Age).ThenBy(c => c.Id, StringComparer.Ordinal).ToList();
    var grown = w.LivingCharacters().Where(c => c.HouseId == house.Id && c.Id != pid && c.Age >= EducationSystem.Adult).OrderByDescending(c => c.Skills.Values.DefaultIfEmpty(0).Max()).ThenBy(c => c.Id, StringComparer.Ordinal).ToList();
    int bill = w.LivingCharacters().Where(c => c.HouseId == house.Id).Sum(c => EducationSystem.TutorCost(c.Tutor));
    string Best(Character x) => x.Skills.Count(kv => kv.Value > 0) == 0 ? "nothing yet" : string.Join(", ", x.Skills.Where(kv => kv.Value > 0).OrderByDescending(kv => kv.Value).ThenBy(kv => kv.Key, StringComparer.Ordinal).Take(4).Select(kv => $"{kv.Key} {kv.Value}"));
}
<section class="panel education">
    <h3><Icon Name="dynasty" Size="13" /> Upbringing and learning <span class="muted">@young.Count(c => c.Age >= EducationSystem.SchoolAge) at their lessons@(bill > 0 ? $" · teachers cost {Money.Show(bill)} a year" : "")</span></h3>
    <div class="muted small">Nobody has to be managed. A child is brought up toward what they show a bent for, and a grown person studies what they choose. You can set a child a different course, and pay for a teacher for anyone.</div>

    @foreach (var c in young)
    {
        string cid = c.Id;
        if (c.Age < EducationSystem.SchoolAge) { <div class="suit"><b>@c.Name</b> <span class="muted">@c.Age · too young for lessons. They begin at @EducationSystem.SchoolAge.</span></div> continue; }
        string bent = EducationSystem.BentGroup(c); var lesson = EducationSystem.Lesson(w, c);
        <div class="suit">
            <div class="suit-who">
                <Portrait Id="@c.Id" Name="@c.Name" Sex="@c.Sex" Age="@c.Age" Accent="@house.AccentColor" Size="34" />
                <div><b>@c.Name</b> <span class="muted">@c.Age · shows a bent for @EducationSystem.GroupName(bent)@(c.Flags.Contains(HouseholdSystem.Ward) ? " · your ward" : "")</span>
                    <div class="muted small">Has learned: @Best(c). This year: @lesson.skill, +@lesson.points point@(lesson.points == 1 ? "" : "s") toward the next step (@c.Learning.GetValueOrDefault(lesson.skill) of @EducationSystem.Need(c.Skill(lesson.skill)) so far).</div>
                    @if (lesson.against) { <div class="small bad">Set against their bent: they learn a third as fast, and hold it against you a little more each year.</div> }
                    @if (c.Id != pid)
                    {
                        var raised = EducationSystem.Raised(w, c, w.Protagonist!); int thinks = w.GetRelationship(c.Id, pid)?.Disposition ?? 0; int sum = raised.Sum(x => x.by);
                        <div class="muted small" data-child-thinks="@thinks" title="What a child thinks of you follows how they are raised: a point a year when they are brought up as their own bent runs, a point more for a tutor, a point lost each year they are set against it. Upbringing alone takes it no higher than @EducationSystem.RaisedCap.">Thinks <b class="@(thinks >= 20 ? "good" : thinks < 0 ? "bad" : "")">@thinks.ToString("+0;-0")</b> of you. @(raised.Count == 0 ? (thinks >= EducationSystem.RaisedCap ? "An upbringing can make them think no better of you than this." : "") : "This year's upbringing: " + string.Join(", ", raised.Select(x => (x.by > 0 ? "+" : "−") + Math.Abs(x.by) + " " + x.why)) + (raised.Count > 1 ? " (" + sum.ToString("+0;-0") + " in all)" : "") + ".")</div>
                    }
                    @if (c.Flags.Contains(EducationSystem.ProdigyChar)) { <div class="small good">Far ahead of their years.</div> }</div>
            </div>
            <div class="suit-acts"><span class="muted small">Course</span>
                <button class="opt inline tiny @(c.Upbringing.Length == 0 ? "here" : "")" @onclick="() => G.Execute(new EducationCommand(pid, EducationCommand.Upbringing, cid, string.Empty))">their own bent</button>
                @foreach (var g in EducationSystem.Groups) { string grp = g; <button class="opt inline tiny @(c.Upbringing == g ? "here" : "")" title="@(g == bent ? "their bent" : "against their bent")" @onclick="() => G.Execute(new EducationCommand(pid, EducationCommand.Upbringing, cid, grp))">@EducationSystem.GroupName(g)</button> }
                <span class="muted small">Tutor</span>
                @foreach (int t in Tutors) { int lv = t; var no = new EducationCommand(pid, EducationCommand.Tutor, cid, lv.ToString()).Refusal(G.Ctx); <button class="opt inline tiny @(c.Tutor == t ? "here" : "")" disabled="@(no != null)" title="@(no ?? TutorTip(t))" @onclick="() => G.Execute(new EducationCommand(pid, EducationCommand.Tutor, cid, lv.ToString()))">@TutorLabel(t)</button> }
            </div>
        </div>
    }
    @if (young.Count == 0) { <div class="muted small">There are no children in the house.</div> }

    @if (grown.Count > 0) { <div class="hh-head"><b>The grown</b> <span class="muted small">What they study is their own choice. You may ask, and they may say no. A teacher is yours to pay for.</span></div> }
    @foreach (var c in grown.Take(_all ? 40 : 6))
    {
        string cid = c.Id; var practice = EducationSystem.Practice(w, c);
        <div class="suit">
            <b>@c.Name</b> <span class="muted">@c.Age · @Best(c)</span>
            <div class="muted small">@(c.Study.Length > 0 ? $"Studying {c.Study} ({c.Skill(c.Study)}, can reach {EducationSystem.Ceiling(c, c.Study)})" : "Has not settled on a study")@(practice.Count > 0 ? " · learning " + string.Join(", ", practice.Select(x => x.skill).Distinct()) + " by their work" : "")</div>
            @{
                var mentor = c.MentorId.Length > 0 ? w.Char(c.MentorId) : null; string under = mentor is { Alive: true } ? "Under the wing of " + mentor.Name + (mentor.HouseId == house.Id ? "" : " of " + w.House(mentor.HouseId)?.Name) + "." : "";
                var subjects = Suggest(c); var teachers = grown.Where(t => t.Id != c.Id && new EducationCommand(pid, EducationCommand.Teach, cid, t.Id).Refusal(G.Ctx) == null).Take(2).ToList();
            }
            @if (under.Length > 0)
            {
                var noThanks = new EducationCommand(pid, EducationCommand.Thank, cid, string.Empty).Refusal(G.Ctx); bool ofHouse = mentor is { Alive: true } && mentor.HouseId == house.Id && mentor.Id != pid;
                <div class="muted small">@under
                    @if (ofHouse) { string thankLabel = "Thank " + mentor!.Name.Split(' ')[0] + " · " + Money.Show(EducationSystem.ThanksCredits); <button class="opt inline tiny" disabled="@(noThanks != null)" title="@(noThanks ?? ThankTip)" @onclick="() => G.Execute(new EducationCommand(pid, EducationCommand.Thank, cid, string.Empty))">@thankLabel</button> }
                </div>
            }
            <div class="suit-acts"><span class="muted small">Ask them to study</span>
                @foreach (var sk in subjects)
                {
                    string skill = sk; var no = new EducationCommand(pid, EducationCommand.Ask, cid, skill).Refusal(G.Ctx); bool would = EducationSystem.WouldStudy(w, p, c, skill);
                    <button class="opt inline tiny" disabled="@(no != null)" title="@(no ?? ((would ? AskYes : AskNo) + " " + SkillWords.For(skill)))" @onclick="() => G.Execute(new EducationCommand(pid, EducationCommand.Ask, cid, skill))">@skill</button>
                    @if (no == null && !would)
                    {
                        int price = EducationSystem.StudyPrice(w, p, c, skill); var noPay = new EducationCommand(pid, EducationCommand.AskAndPay, cid, skill).Refusal(G.Ctx); string payLabel = "…for " + Money.Show(price) + " of your own";
                        if (price > 0)
                        {
                            int word = EducationSystem.FavourPrice(w, p, c, skill); var noWord = new EducationCommand(pid, EducationCommand.AskAndSpeak, cid, skill).Refusal(G.Ctx); string wordLabel = "…or a word for them · " + word + " influence";
                            <button class="opt inline tiny" disabled="@(noPay != null)" title="@(noPay ?? PayTip)" @onclick="() => G.Execute(new EducationCommand(pid, EducationCommand.AskAndPay, cid, skill))">@payLabel</button>
                            <button class="opt inline tiny" disabled="@(noWord != null)" title="@(noWord ?? WordTip)" @onclick="() => G.Execute(new EducationCommand(pid, EducationCommand.AskAndSpeak, cid, skill))">@wordLabel</button>
                        }
                    }
                }
                @foreach (var t in teachers)
                {
                    string tid = t.Id; string label = "Have " + t.Name.Split(' ')[0] + " teach them " + EducationSystem.Lesson(t, c);
                    <button class="opt inline tiny" title="@TeachTip" @onclick="() => G.Execute(new EducationCommand(pid, EducationCommand.Teach, cid, tid))">@label</button>
                }
            </div>
            <div class="suit-acts"><span class="muted small">Teacher</span>
                @foreach (int t in Tutors) { int lv = t; var no = new EducationCommand(pid, EducationCommand.Tutor, cid, lv.ToString()).Refusal(G.Ctx); <button class="opt inline tiny @(c.Tutor == t ? "here" : "")" disabled="@(no != null)" title="@(no ?? TutorTip(t))" @onclick="() => G.Execute(new EducationCommand(pid, EducationCommand.Tutor, cid, lv.ToString()))">@TutorLabel(t)</button> }
            </div>
        </div>
    }
    @if (grown.Count > 6) { <button class="opt inline tiny" @onclick="() => _all = !_all">@(_all ? "Show fewer" : $"Show all {grown.Count}")</button> }
</section>

@code {
    private bool _all;
    private static readonly int[] Tutors = { 0, 1, 2 };
    private const string AskYes = "They would do it for the asking.";
    private const string AskNo = "They would refuse, and think the less of you for asking.";
    private const string PayTip = "They name a price, you pay it out of your own purse, and they turn to it. A bargain: nobody thinks the worse of anybody.";
    private const string WordTip = "Not money: you have a word said for them in the right place. They turn to it, and think a little better of you.";
    private const string ThankTip = "A purse out of your own, to the one of the house who is bringing them on. They will think the better of you for noticing.";
    private const string TeachTip = "They take them under their wing and pass on a step every third year.";
    /// <summary>Three things worth asking of them: the skills of their service and of rule that they have most room left in.</summary>
    private static List<string> Suggest(Character c)
    {
        var pool = EducationSystem.TrackSkills(c.CareerTrack).Concat(new[] { "administration", "oratory", "tactics", "economics", "diplomacy" }).Distinct();
        return pool.Where(s => s != c.Study && c.Skill(s) < EducationSystem.Ceiling(c, s)).OrderByDescending(s => EducationSystem.Ceiling(c, s) - c.Skill(s)).ThenBy(s => s, StringComparer.Ordinal).Take(3).ToList();
    }
    private static string TutorLabel(int t) => t == 0 ? "none" : t == 1 ? $"good · {Money.Credits(EducationSystem.GoodTutorCredits)} a year" : $"the best · {Money.Credits(EducationSystem.BestTutorCredits)} a year";
    private static string TutorTip(int t) => t == 0 ? "No tutor: they learn what the year teaches them." : $"+{EducationSystem.TutorPoints(t)} point{(EducationSystem.TutorPoints(t) == 1 ? "" : "s")} a year toward the next step of what they are learning. The fee is {Money.Credits(EducationSystem.TutorCost(t))} a year from the house treasury, taken at the year's end; a tutor the treasury cannot pay leaves.";
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;
}
