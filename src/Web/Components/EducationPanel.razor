@using Praetoria.Core.Systems
@inject GameClient G
@implements IDisposable
@{
    var w = G.World!; var p = w.Protagonist!; var pid = p.Id; var house = w.House(p.HouseId)!;
    var young = w.LivingCharacters().Where(c => c.HouseId == house.Id && c.Id != pid && c.Age < EducationSystem.Adult).OrderByDescending(c => c.Age).ThenBy(c => c.Id, StringComparer.Ordinal).ToList();
    var grown = w.LivingCharacters().Where(c => c.HouseId == house.Id && c.Id != pid && c.Age >= EducationSystem.Adult).OrderByDescending(c => c.Skills.Values.DefaultIfEmpty(0).Max()).ThenBy(c => c.Id, StringComparer.Ordinal).ToList();
    int bill = w.LivingCharacters().Where(c => c.HouseId == house.Id).Sum(c => EducationSystem.TutorCost(c.Tutor));
    int atLessons = young.Count(c => c.Age >= EducationSystem.SchoolAge);
    string Best(Character x) => x.Skills.Count(kv => kv.Value > 0) == 0 ? "nothing yet" : string.Join(", ", x.Skills.Where(kv => kv.Value > 0).OrderByDescending(kv => kv.Value).ThenBy(kv => kv.Key, StringComparer.Ordinal).Take(4).Select(kv => $"{kv.Key} {kv.Value}"));
}
@* Upbringing and learning (docs/EDUCATION.md) on the Dynasty window: each child as a face, their bent, what they learned and what they
   learn this year, what they think of you for it, and their course and tutor as joined plates; then the grown, what they study, and
   what you may ask of them. "panel education", its .suit and .suit-who blocks and the data-course and data-tutor plates are what
   tools/browser reads. *@
<div class="panel education dy-edu">
    <p class="ui-lede dy-lede">@LawsScreen.Bold($"{(atLessons == 0 ? "No child of the house is at their lessons" : $"{atLessons} {(atLessons == 1 ? "child is" : "children are")} at their lessons")}{(bill > 0 ? $", and teachers cost the house {Money.Show(bill)} a year" : "")}. Nobody has to be managed: a child is brought up toward what they show a bent for, and a grown person studies what they choose.")</p>
    <Section Title="The young" Count="@young.Count.ToString()" Info="@($"Lessons begin at {EducationSystem.SchoolAge}. A child is brought up toward what they show a bent for; you can set them a different course, and pay for a tutor. Set against their bent they learn a third as fast, and hold it against you a little more each year. What a child thinks of you follows how they are raised: a point a year when they are brought up as their own bent runs, a point more for a tutor, a point lost each year they are set against it; upbringing alone takes it no higher than {EducationSystem.RaisedCap}.")"
             IsEmpty="@(young.Count == 0)" EmptyIcon="open-book" EmptyLine="There are no children in the house.">
    @foreach (var c in young)
    {
        string cid = c.Id;
        if (c.Age < EducationSystem.SchoolAge)
        {
            <Row Wrap="true" Name="@c.Name" SubText="@($"{c.Age} · too young for lessons. They begin at {EducationSystem.SchoolAge}.")" Class="suit dy-young">
                <Picture><Portrait Id="@c.Id" Name="@c.Name" Sex="@c.Sex" Age="@c.Age" Accent="@house.AccentColor" Size="46" Height="56" /></Picture>
            </Row>
            continue;
        }
        string bent = EducationSystem.BentGroup(c); var lesson = EducationSystem.Lesson(w, c);
        <div class="suit dy-blk">
            <Portrait Id="@c.Id" Name="@c.Name" Sex="@c.Sex" Age="@c.Age" Accent="@house.AccentColor" Size="46" Height="56" />
            <div class="dy-blk-body">
                <div class="suit-who"><span class="dy-blk-nm">@c.Name</span> <span class="dy-blk-sub">@c.Age · shows a bent for @EducationSystem.GroupName(bent)@(c.Flags.Contains(HouseholdSystem.Ward) ? " · your ward" : "")</span>
                    <div class="dy-blk-sub">Has learned: @Best(c). This year: @lesson.skill, <b class="ui-up">+@lesson.points</b> point@(lesson.points == 1 ? "" : "s") toward the next step (@c.Learning.GetValueOrDefault(lesson.skill) of @EducationSystem.Need(c.Skill(lesson.skill)) so far).</div>
                </div>
                @if (lesson.against) { <div class="dy-blk-sub ui-down">Set against their bent: they learn a third as fast, and hold it against you a little more each year.</div> }
                @if (c.Id != pid)
                {
                    var raised = EducationSystem.Raised(w, c, w.Protagonist!); int thinks = w.GetRelationship(c.Id, pid)?.Disposition ?? 0; int sum = raised.Sum(x => x.by);
                    <div class="dy-blk-sub" data-child-thinks="@thinks" title="@($"What a child thinks of you follows how they are raised: a point a year when they are brought up as their own bent runs, a point more for a tutor, a point lost each year they are set against it. Upbringing alone takes it no higher than {EducationSystem.RaisedCap}.")">Thinks <b class="@(thinks >= 20 ? "ui-up" : thinks < 0 ? "ui-down" : "")">@thinks.ToString("+0;−0")</b> of you. @(raised.Count == 0 ? (thinks >= EducationSystem.RaisedCap ? "An upbringing can make them think no better of you than this." : "") : "This year's upbringing: " + string.Join(", ", raised.Select(x => (x.by > 0 ? "+" : "−") + Math.Abs(x.by) + " " + x.why)) + (raised.Count > 1 ? " (" + sum.ToString("+0;−0") + " in all)" : "") + ".")</div>
                }
                @if (c.Flags.Contains(EducationSystem.ProdigyChar)) { <div class="dy-blk-sub ui-up">Far ahead of their years.</div> }
                <div class="you-acts dy-acts suit-acts">
                    <span class="you-lbl">Course</span>
                    <span class="ui-seg dy-seg">
                        <button class="@(c.Upbringing.Length == 0 ? "on" : "")" data-course="" title="Their own bent" @onclick="() => G.Execute(new EducationCommand(pid, EducationCommand.Upbringing, cid, string.Empty))">Their bent</button>
                        @foreach (var g in EducationSystem.Groups) { string grp = g; <button class="@(c.Upbringing == g ? "on" : "")" data-course="@grp" title="@(g == bent ? "their bent" : "against their bent")" @onclick="() => G.Execute(new EducationCommand(pid, EducationCommand.Upbringing, cid, grp))">@CharacterScreen.Cap(EducationSystem.GroupName(g))</button> }
                    </span>
                </div>
                <div class="you-acts dy-acts">
                    <span class="you-lbl">Tutor</span>
                    <span class="ui-seg dy-seg">
                    @foreach (int t in Tutors) { int lv = t; var no = new EducationCommand(pid, EducationCommand.Tutor, cid, lv.ToString()).Refusal(G.Ctx); <button class="@(c.Tutor == t ? "on" : "")" data-tutor="@t" disabled="@(no != null)" title="@(no != null ? LifePanel.Say(no) : TutorTip(t))" @onclick="() => G.Execute(new EducationCommand(pid, EducationCommand.Tutor, cid, lv.ToString()))">@LearningPanel.TutorLabel(t)</button> }
                    </span>
                </div>
            </div>
        </div>
    }
    </Section>

    @if (grown.Count > 0)
    {
        <Section Title="The grown" Count="@grown.Count.ToString()" Info="What they study is their own choice. You may ask, and they may say no; one who would refuse may do it for a price out of your own purse, or for a word said for them. A teacher is yours to pay for, from the house treasury.">
            <Right>@if (grown.Count > 6) { <Link Label="@(_all ? "Show fewer" : $"Show all {grown.Count}")" OnClick="() => _all = !_all" /> }</Right>
            <ChildContent>
            @* one row a grown relative (docs/VISUAL_SYSTEM.md 4.7): the face, the name, what they are best at and what they learn, and one
               Select (4.12) "Study…" whose options are the skills worth asking, each with its price as a dim note, and the teachers of the
               house; the teacher they are paid as a second, small select *@
            @foreach (var c in grown.Take(_all ? 40 : 6))
            {
                string cid = c.Id; var practice = EducationSystem.Practice(w, c);
                var mentor = c.MentorId.Length > 0 ? w.Char(c.MentorId) : null; string under = mentor is { Alive: true } ? "Under the wing of " + mentor.Name + (mentor.HouseId == house.Id ? "" : " of " + w.House(mentor.HouseId)?.Name) + "." : "";
                var subjects = Suggest(c); var teachers = grown.Where(t => t.Id != c.Id && new EducationCommand(pid, EducationCommand.Teach, cid, t.Id).Refusal(G.Ctx) == null).Take(2).ToList();
                var opts = new List<Select.Option>();
                foreach (var sk in subjects)
                {
                    var no = new EducationCommand(pid, EducationCommand.Ask, cid, sk).Refusal(G.Ctx); bool would = EducationSystem.WouldStudy(w, p, c, sk);
                    if (no != null) { opts.Add(new Select.Option("x:" + sk, CharacterScreen.Cap(sk), "cannot: " + LifePanel.Say(no))); continue; }
                    if (would) { opts.Add(new Select.Option("ask:" + sk, CharacterScreen.Cap(sk), "they would, for the asking")); continue; }
                    int price = EducationSystem.StudyPrice(w, p, c, sk);
                    if (price <= 0) { opts.Add(new Select.Option("ask:" + sk, CharacterScreen.Cap(sk), "they would refuse")); continue; }
                    opts.Add(new Select.Option("pay:" + sk, CharacterScreen.Cap(sk) + ", pay " + Money.Show(price) + " of your own", new EducationCommand(pid, EducationCommand.AskAndPay, cid, sk).Refusal(G.Ctx) is { } np ? "cannot: " + LifePanel.Say(np) : "a bargain"));
                    opts.Add(new Select.Option("word:" + sk, CharacterScreen.Cap(sk) + ", a word for them", new EducationCommand(pid, EducationCommand.AskAndSpeak, cid, sk).Refusal(G.Ctx) is { } nw ? "cannot: " + LifePanel.Say(nw) : EducationSystem.FavourPrice(w, p, c, sk) + " influence"));
                }
                foreach (var t in teachers) opts.Add(new Select.Option("teach:" + t.Id, "Have " + First(t.Name) + " teach them " + EducationSystem.Lesson(t, c), "a step every third year", t.Id, t.Sex, t.Age, house.AccentColor));
                <div class="suit dy-blk dy-grown-row" data-grown="@cid">
                    <Row Name="@c.Name" Wrap="true" Tip="@($"Best at: {Best(c)}" + (under.Length > 0 ? "\n" + under : ""))">
                        <Picture><Portrait Id="@c.Id" Name="@c.Name" Sex="@c.Sex" Age="@c.Age" Accent="@house.AccentColor" Size="46" Height="56" /></Picture>
                        <Sub>@c.Age · @BestShort(c) · @(c.Study.Length > 0 ? $"studying {c.Study} ({c.Skill(c.Study)}, can reach {EducationSystem.Ceiling(c, c.Study)})" : "has not settled on a study")@(practice.Count > 0 ? " · learning " + string.Join(", ", practice.Select(x => x.skill).Distinct()) + " by their work" : "")</Sub>
                        <Action><span class="hs-acts dy-study suit-acts">
                            <span class="you-lbl visually-hidden">Ask them to study</span>
                            <Select Value="" Placeholder="Study…" Tip="Ask them to study something, or have one of the house teach them. Each choice carries its price." Options="@opts" OnChange="v => AskStudy(cid, v)" />
                            <Select Value="@c.Tutor.ToString()" Class="dy-tutor" Tip="@($"Their teacher, paid from the house treasury. {TutorTip(c.Tutor)}")" Options="@Tutors.Select(t => new Select.Option(t.ToString(), t == 0 ? "No teacher" : t == 1 ? "A good teacher" : "The best teacher", t == 0 ? "" : Money.Show(EducationSystem.TutorCost(t)) + " a year")).ToList()" OnChange="v => G.Execute(new EducationCommand(pid, EducationCommand.Tutor, cid, v))" />
                        </span></Action>
                    </Row>
                    @if (under.Length > 0 && mentor is { Alive: true } && mentor.HouseId == house.Id && mentor.Id != pid)
                    {
                        var noThanks = new EducationCommand(pid, EducationCommand.Thank, cid, string.Empty).Refusal(G.Ctx);
                        <div class="hs-note dy-under">@under <Plate Label="@("Thank " + First(mentor.Name))" Small="true" CostIcon="credits" CostText="@Money.Show(EducationSystem.ThanksCredits)" Locked="@(noThanks != null)" Disabled="@(noThanks != null)" Need="@LifePanel.Say(noThanks)" ShowNeed="false" Tip="@ThankTip" OnClick="() => G.Execute(new EducationCommand(pid, EducationCommand.Thank, cid, string.Empty))" /></div>
                    }
                </div>
            }
            </ChildContent>
        </Section>
    }
</div>

@code {
    private bool _all;
    /// <summary>A choice from a grown relative's Study select: ask, pay, a word, or a teacher of the house. A refused one does nothing.</summary>
    private void AskStudy(string cid, string v)
    {
        var pid = G.World!.ProtagonistId; int at = v.IndexOf(':'); if (at < 0) return; string what = v[..at], arg = v[(at + 1)..];
        string? kind = what switch { "ask" => EducationCommand.Ask, "pay" => EducationCommand.AskAndPay, "word" => EducationCommand.AskAndSpeak, "teach" => EducationCommand.Teach, _ => null };
        if (kind != null) G.Execute(new EducationCommand(pid, kind, cid, arg));
    }
    /// <summary>Their two best skills as a figure: "Tactics 4 · Law 3".</summary>
    private static string BestShort(Character x) => x.Skills.Count(kv => kv.Value > 0) == 0 ? "–" : string.Join(" · ", x.Skills.Where(kv => kv.Value > 0).OrderByDescending(kv => kv.Value).ThenBy(kv => kv.Key, StringComparer.Ordinal).Take(2).Select(kv => $"{CharacterScreen.Cap(kv.Key)} {kv.Value}"));
    private static readonly int[] Tutors = { 0, 1, 2 };
    private const string AskYes = "They would do it for the asking.";
    private const string AskNo = "They would refuse, and think the less of you for asking.";
    private const string PayTip = "They name a price, you pay it out of your own purse, and they turn to it. A bargain: nobody thinks the worse of anybody.";
    private const string WordTip = "Not money: you have a word said for them in the right place. They turn to it, and think a little better of you.";
    private const string ThankTip = "A purse out of your own, to the one of the house who is bringing them on. They will think the better of you for noticing.";
    private const string TeachTip = "They take them under their wing and pass on a step every third year.";
    private static string First(string name) => name.Split(' ')[0];
    /// <summary>Three things worth asking of them: the skills of their service and of rule that they have most room left in.</summary>
    private static List<string> Suggest(Character c)
    {
        var pool = EducationSystem.TrackSkills(c.CareerTrack).Concat(new[] { "administration", "oratory", "tactics", "economics", "diplomacy" }).Distinct();
        return pool.Where(s => s != c.Study && c.Skill(s) < EducationSystem.Ceiling(c, s)).OrderByDescending(s => EducationSystem.Ceiling(c, s) - c.Skill(s)).ThenBy(s => s, StringComparer.Ordinal).Take(3).ToList();
    }
    private static string TutorTip(int t) => t == 0 ? "No tutor: they learn what the year teaches them." : $"+{EducationSystem.TutorPoints(t)} point{(EducationSystem.TutorPoints(t) == 1 ? "" : "s")} a year toward the next step of what they are learning. The fee is {Money.Credits(EducationSystem.TutorCost(t))} a year from the house treasury, taken at the year's end; a tutor the treasury cannot pay leaves.";
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;
}
