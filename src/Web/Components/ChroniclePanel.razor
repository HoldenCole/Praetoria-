@inject GameClient G

@{
    var w = G.World!;
    var turns = w.History.GroupBy(h => h.Turn).OrderByDescending(g => g.Key).ToList();
}
<div class="chronicle">
    <section class="card">
        <h2>The chronicle of @(w.House(w.Protagonist!.HouseId)?.Name)</h2>
        <div class="muted">@w.History.Count entries over @w.Turn turns · wars @w.Counter(FleetSystem.WarsDeclaredCounter) · battles @w.Counter(FleetSystem.BattlesCounter) · births @w.Counter("dynasty_births") · generation @(w.Counter("generation") + 1)</div>
        <label class="inline"><input type="checkbox" @bind="_onlyNotable" /> only the notable</label>
    </section>
    @foreach (var g in turns)
    {
        var lines = g.Where(h => !_onlyNotable || h.EventId != null || Notable(h.Text)).ToList();
        if (lines.Count == 0) continue;
        <section class="card turn-block">
            <h3>Turn @g.Key</h3>
            @foreach (var h in lines) { <div class="line @(h.EventId != null ? "event" : "")">@h.Text</div> }
        </section>
    }
</div>

@code {
    private bool _onlyNotable;
    private static bool Notable(string t) =>
        t.Contains("war", StringComparison.OrdinalIgnoreCase) || t.Contains("dies") || t.Contains("born") || t.Contains("wed") || t.Contains("takes ") ||
        t.Contains("destroyed") || t.Contains("Crisis") || t.Contains("throne", StringComparison.OrdinalIgnoreCase) || t.Contains("succeeds") || t.Contains("desert");
}
