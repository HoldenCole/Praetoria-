@using Praetoria.Core.Systems
@using Praetoria.Core.State
@using Praetoria.Core.Commands
@inject GameClient G
@implements IDisposable
@{
    var w = G.World!; var p = w.Protagonist!; var pid = p.Id; var house = w.House(p.HouseId)!;
    var owed = FeudSystem.Open(w).Where(f => f.WrongedId == house.Id).OrderBy(f => f.Since).ThenBy(f => f.Id, StringComparer.Ordinal).ToList();
    var owe = FeudSystem.Open(w).Where(f => f.OwingId == house.Id).OrderBy(f => f.Since).ThenBy(f => f.Id, StringComparer.Ordinal).ToList();
    var elsewhere = FeudSystem.Open(w).Where(f => f.WrongedId != house.Id && f.OwingId != house.Id).OrderByDescending(f => f.Since).ThenBy(f => f.Id, StringComparer.Ordinal).ToList();
    var ended = w.Feuds.Where(f => !f.Open && (f.WrongedId == house.Id || f.OwingId == house.Id) && f.Ended != "extinct").OrderByDescending(f => f.EndedTurn).Take(3).ToList();
    string Years(BloodFeud f) { int y = w.Turn - f.Since; return y <= 0 ? "this year" : y == 1 ? "a year ago" : y + " years ago"; }
    string HowEnded(BloodFeud f) => f.Ended switch { "blood" => "answered in blood", "duel" => "settled on the field", "price" => "bought off", "let_lie" => "let lie", _ => f.Ended };
    string Name(string houseId) => w.House(houseId)?.Name ?? houseId;
    string? No(BloodFeud f, string what, Character? champion = null) => FeudSystem.ActRefusal(w, p, f, what, champion);
    void Do(BloodFeud f, string what, string champion = "") => G.Execute(new FeudCommand(pid, f.Id, what, champion));
    var champions = w.LivingCharacters().Where(c => c.HouseId == house.Id && c.Id != pid && c.Age >= DynastySystem.AgeOfMajority && FeudSystem.TakesTheField(c)).OrderByDescending(FeudSystem.Prowess).ThenBy(c => c.Id, StringComparer.Ordinal).Take(2).ToList();
}
@if (owed.Count + owe.Count + elsewhere.Count + ended.Count > 0)
{
<section class="panel feud">
    <h3><Icon Name="war" Size="13" /> Blood between houses <span class="muted">@(owed.Count > 0 ? $"{owed.Count} owed to you" : "")@(owed.Count > 0 && owe.Count > 0 ? " · " : "")@(owe.Count > 0 ? $"{owe.Count} held against you" : "")@(owed.Count + owe.Count == 0 ? "none of it yours" : "")</span></h3>
    @foreach (var f in owed)
    {
        var blamed = FeudSystem.Blamed(w, f); int odds = blamed != null ? FeudSystem.DuelOdds(p, blamed) : 0;
        string? challenge = No(f, FeudCommand.Challenge), demand = No(f, FeudCommand.Demand), lie = No(f, FeudCommand.LetLie);
        var knife = blamed != null ? new AssassinateCommand(pid, blamed.Id, G.Content!.Friction) : null; bool canKnife = knife != null && knife.CanExecute(G.Ctx);
        <div class="health-row">
            <b>@f.VictimName</b>, @Years(f) · <span class="bad">@Name(f.OwingId) owes you blood</span>@(blamed != null ? $" · held against {blamed.Name}" : "")
            <div class="muted small">@(f.Unanswered > FeudSystem.GraceYears ? $"Unanswered {f.Unanswered} years: it has cost the house {f.Shame} standing, and your near kin hold it against you. " : f.Unanswered > 0 ? $"Unanswered {Counted.Years(f.Unanswered)}. After {FeudSystem.GraceYears} it begins to cost the house standing. " : "")After @FeudSystem.LetLieYears years it is let lie whether you say so or not.@(f.Refused ? " They have refused you once: what you do now is on them." : "")</div>
            @if (f.Asked == "offer")
            {
                <div class="suit-acts"><span class="small">They offer <b>@f.Price credits</b> to end it.</span>
                    <button class="opt inline" disabled="@(No(f, FeudCommand.Take) != null)" title="The money comes to the house and the debt is ended. The dead person's near kin think the less of you for it." @onclick="() => Do(f, FeudCommand.Take)">Take it</button>
                    <button class="opt inline" title="The offer is not made twice." @onclick="() => Do(f, FeudCommand.Spurn)">Spurn it</button></div>
            }
            else
            {
                <div class="suit-acts">
                    <button class="opt inline" disabled="@(challenge != null)" title="@(challenge ?? $"Meet them yourself, one against one. You would win about {odds} times in a hundred. The loser dies four times in ten and is otherwise wounded. However it falls, it ends there, and a death in it is nobody's to avenge. If they will not come, their house loses {FeudSystem.FieldRefusedStanding} standing.")" @onclick="() => Do(f, FeudCommand.Challenge)">Call them out@(blamed != null && challenge == null ? $" · {odds} in 100" : "")</button>
                    @foreach (var c in champions)
                    {
                        var who = c; string? no = No(f, FeudCommand.Challenge, who); int o = blamed != null ? FeudSystem.DuelOdds(who, blamed) : 0;
                        <button class="opt inline" disabled="@(no != null)" title="@(no ?? $"{who.Name} goes in your place: about {o} in a hundred.")" @onclick="() => Do(f, FeudCommand.Challenge, who.Id)">Send @who.Name.Split(' ')[0] · @o in 100</button>
                    }
                    <button class="opt inline" disabled="@(demand != null)" title="@(demand ?? $"Ask {f.Price} credits. A house pays if it has the money twice over or you are the stronger. Taking money for the dead costs you with their near kin.")" @onclick="() => Do(f, FeudCommand.Demand)">Ask the price · @f.Price</button>
                    <button class="opt inline veto" disabled="@(!canKnife)" title="@(canKnife ? $"A hired hand for {blamed!.Name}: about {(int)(AssassinateCommand.Odds(w, p, blamed) * 100)} in a hundred, 2 agents. If the one to blame dies, the debt is paid. Anyone else of theirs is the wrong blood, and they will hold it against you in turn." : "You have not the agents, or there is nobody to reach.")" @onclick="() => G.Execute(knife!)">A knife</button>
                    <button class="opt inline" disabled="@(lie != null)" title="@(lie ?? $"Say that it is let lie. It costs the house {Math.Max(0, FeudSystem.LetLieStanding - f.Shame)} standing, the dead person's near kin take it hard, and the other house had not expected it.")" @onclick="() => Do(f, FeudCommand.LetLie)">Let it lie</button>
                </div>
            }
        </div>
    }
    @foreach (var f in owe)
    {
        var asker = w.Char(f.AskerId); string? offer = No(f, FeudCommand.Offer);
        <div class="health-row">
            <b>@f.VictimName</b> of @Name(f.WrongedId), @Years(f) · <span class="warn">held against @(FeudSystem.Blamed(w, f)?.Name ?? "your house")</span>
            <div class="muted small">They vote against what your house moves, and nobody of theirs will marry one of yours. Sooner or later they come: with a challenge, a price, or a knife for one of your kin.</div>
            @if (f.Asked == "price")
            {
                <div class="suit-acts"><span class="small">@(asker?.Name ?? "Their head") asks <b>@f.Price credits</b>.</span>
                    <button class="opt inline" disabled="@(No(f, FeudCommand.Pay) != null)" title="@(No(f, FeudCommand.Pay) ?? $"The house pays and the debt is ended. To pay is to admit it: {FeudSystem.PriceAdmits} standing.")" @onclick="() => Do(f, FeudCommand.Pay)">Pay it</button>
                    <button class="opt inline" title="A house that is refused its price takes something else." @onclick="() => Do(f, FeudCommand.Refuse)">Refuse</button></div>
            }
            else if (f.Asked == "duel" && asker != null)
            {
                int o = 100 - FeudSystem.DuelOdds(asker, p);
                <div class="suit-acts"><span class="small"><b>@asker.Name</b> has called you out.</span>
                    <button class="opt inline" disabled="@(No(f, FeudCommand.Fight) != null)" title="@(No(f, FeudCommand.Fight) ?? $"You would win about {o} times in a hundred. The loser dies four times in ten. It ends there whoever falls.")" @onclick="() => Do(f, FeudCommand.Fight)">Take the field · @o in 100</button>
                    <button class="opt inline" title="@($"Your house loses {FeudSystem.FieldRefusedStanding} standing, it is remembered of you, and what they do next is on you.")" @onclick="() => Do(f, FeudCommand.Decline)">Do not come</button></div>
            }
            else
            {
                <div class="suit-acts"><button class="opt inline" disabled="@(offer != null)" title="@(offer ?? $"Offer {f.Price} credits for their dead. Most heads take it. The vengeful, the cruel and the proud do not. It can be offered once.")" @onclick="() => Do(f, FeudCommand.Offer)">Offer the price · @f.Price</button></div>
            }
        </div>
    }
    @if (ended.Count > 0) { <div class="muted small">Behind you: @string.Join(" · ", ended.Select(f => $"{f.VictimName}, {HowEnded(f)} in year {f.EndedTurn}"))</div> }
    @if (elsewhere.Count > 0) { <div class="muted small">Elsewhere: @string.Join(" · ", elsewhere.Take(4).Select(f => $"{Name(f.WrongedId)} against {Name(f.OwingId)} for {f.VictimName}"))@(elsewhere.Count > 4 ? $" · and {elsewhere.Count - 4} more" : "")</div> }
</section>
}
@code {
    protected override void OnInitialized() => G.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= OnChanged;
}
