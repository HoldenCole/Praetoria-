@inject IJSRuntime JS
@inject GameClient G
@* Settings kept in this browser (docs/WEB_CLIENT.md, "Settings"; docs/PLAYTHROUGH.md, a first game: N47, N3). Opened from the top
   bar and from the title. What is here works; what the game does not have (sound) is said, not shown as a dead switch. *@
@* Each option is one row (docs/VISUAL_SYSTEM.md 4.7): its glyph, its name, an "i" whose tooltip says what it does, and its plates at
   the right; the keys are rows of key caps sized to their glyph. *@
<Box data-settings-box="1" BoxClass="settings" Glyph="cog" Kicker="Options" Title="Settings" Width="min(45.3333rem, calc(100vw - 2rem))" OnClose="() => OnClose.InvokeAsync()">
        <div class="set-row">
            <Icon Name="open-book" Tone="brass" Size="20" /><b>Text size</b><span class="ui-info" title="Every word and figure in the game follows this. The map does not." tabindex="0" aria-label="What it does">i</span>
            <div class="set-pick" data-set="text">
                @foreach (var (id, label) in new[] { ("small", "Small"), ("normal", "Normal"), ("large", "Large"), ("larger", "Larger") })
                {
                    <button class="opt inline @(_text == id ? "on" : "")" data-text-size="@id" aria-pressed="@(_text == id)" @onclick="() => Set(nameof(_text), id)">@label</button>
                }
            </div>
        </div>
        <div class="set-row">
            <Icon Name="hourglass" Tone="brass" Size="20" /><b>Enter ends the year</b><span class="ui-info" title="With this off, a year ends only by the End Year medallion." tabindex="0" aria-label="What it does">i</span>
            <div class="set-pick"><button class="opt inline set-sw @(_enterEnds ? "on" : "")" data-set-enter aria-pressed="@_enterEnds" title="@(_enterEnds ? "On: press to turn it off" : "Off: press to turn it on")" @onclick="() => Set(nameof(_enterEnds), !_enterEnds)"><i></i>@(_enterEnds ? "On" : "Off")</button></div>
        </div>
        <div class="set-row">
            <Icon Name="expand" Tone="brass" Size="20" /><b>Number keys open windows</b><span class="ui-info" title="1 to 9, then 0, - and =, in the order of the buttons at the left." tabindex="0" aria-label="What it does">i</span>
            <div class="set-pick"><button class="opt inline set-sw @(_numberKeys ? "on" : "")" data-set-numbers aria-pressed="@_numberKeys" title="@(_numberKeys ? "On: press to turn it off" : "Off: press to turn it on")" @onclick="() => Set(nameof(_numberKeys), !_numberKeys)"><i></i>@(_numberKeys ? "On" : "Off")</button></div>
        </div>
        <div class="set-row">
            <Icon Name="flying-flag" Tone="brass" Size="20" /><b>Show rail labels</b><span class="ui-info" title="The name of each window under its button at the left, for a new player. The name shows beside a button whenever the pointer is on it, either way. In a first game they are on by themselves for the first three years, until you choose here." tabindex="0" aria-label="What it does">i</span>
            <div class="set-pick">@if (_railAuto) { <span class="set-auto" data-rail-labels-auto>On for your first years</span> }<button class="opt inline set-sw @(_railLabels ? "on" : "")" data-set-rail-labels aria-pressed="@_railLabels" title="@(_railLabels ? "On: press to turn it off" : "Off: press to turn it on")" @onclick="() => Set(nameof(_railLabels), !_railLabels)"><i></i>@(_railLabels ? "On" : "Off")</button></div>
        </div>
        <div class="set-row">
            <Icon Name="scroll-unfurled" Tone="brass" Size="20" /><b>The year in brief</b><span class="ui-info" title="A card as each year opens, saying what the last one did to the house." tabindex="0" aria-label="What it does">i</span>
            <div class="set-pick"><button class="opt inline set-sw @(_brief ? "on" : "")" data-set-brief aria-pressed="@_brief" title="@(_brief ? "Every year: press for only when asked" : "Only when asked: press for every year")" @onclick="ToggleBrief"><i></i>@(_brief ? "Every year" : "Only when asked")</button></div>
        </div>
        <div class="set-row" data-set-guidance>
            <Icon Name="laurels" Tone="brass" Size="20" /><b>Guidance</b><span class="ui-info" title="Guided: your aim stands on the map under the top bar, a goal for your first ten years and then your ambition, with its steps and Go there. Sandbox: the map is left to you, with no aim and no steps. Either way, a warning shows when the money will run out within three years. The first steps of a first game have a close of their own." tabindex="0" aria-label="What it does">i</span>
            <div class="set-pick" data-set="guidance">
                <button class="opt inline @(_guided ? "on" : "")" data-guidance="guided" aria-pressed="@_guided" title="An aim and its steps on the map" @onclick="() => Set(nameof(_guided), true)">Guided</button>
                <button class="opt inline @(_guided ? "" : "on")" data-guidance="sandbox" aria-pressed="@(!_guided)" title="The map is yours to read" @onclick="() => Set(nameof(_guided), false)">Sandbox</button>
            </div>
        </div>
        <div class="set-row" data-set-sound>
            <Icon Name="public-speaker" Tone="steel" Size="20" /><b>Sound</b><span class="ui-info" title="The game has no music or sound yet, so there is nothing here to turn up or down." tabindex="0" aria-label="What it says">i</span>
            <div class="set-pick"><span class="set-none">None in the game yet</span></div>
        </div>
        <div class="box-sec set-keys-head"><h3>The keys</h3><span class="ui-info" title="The keys cannot be changed to others yet." tabindex="0" aria-label="The rules">i</span></div>
        <div class="set-keys">
            <span class="set-caps"><kbd>Enter</kbd></span><span>End the year, when no report is open@(_enterEnds ? "" : " (switched off above)")</span>
            <span class="set-caps"><kbd>Esc</kbd></span><span>Close whatever is in front; from a window, back to the map; on the map, the game menu</span>
            <span class="set-caps"><kbd>1</kbd><i>to</i><kbd>9</kbd><kbd>0</kbd><kbd>-</kbd><kbd>=</kbd></span><span>The windows, in the order at the left@(_numberKeys ? "" : " (switched off above)")</span>
            <span class="set-caps"><kbd>?</kbd></span><span>The primer, the glossary and the lectures</span>
            <span class="set-caps"><kbd>drag</kbd></span><span>Move the map; the wheel zooms it, and so do Page Up and Page Down</span>
        </div>
        <div class="box-note">These are kept in this browser and apply to every saga played in it.</div>
</Box>
@code {
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>A setting changed: whoever reads the settings should read them again.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    private string _text = "normal"; private bool _enterEnds = true, _numberKeys = true, _brief = true, _railLabels, _guided = true;
    /// <summary>The rail's labels are on by themselves, a first game's first years, and the player has not chosen.</summary>
    private bool _railAuto;

    protected override async Task OnInitializedAsync()
    {
        try { Read(await JS.InvokeAsync<string>("praetoriaSettings.get")); _brief = await JS.InvokeAsync<string?>("localStorage.getItem", "praetoria.brief.every") != "0"; } catch { }
    }
    private void Read(string json)
    {
        var s = Praetoria.Web.Services.ClientSettings.Parse(json);
        _text = s.Text; _enterEnds = s.EnterEnds; _numberKeys = s.NumberKeys; _guided = s.Guided; _railLabels = s.RailLabelsChosen ?? (G.Turn != null && G.LabelsByThemselves);
        _railAuto = s.RailLabelsChosen == null && _railLabels;
    }
    private async Task Set(string field, object value)
    {
        string key = field switch { nameof(_text) => "text", nameof(_enterEnds) => "enterEnds", nameof(_railLabels) => "railLabels", nameof(_guided) => "guided", _ => "numberKeys" };
        try { Read(await JS.InvokeAsync<string>("praetoriaSettings.set", key, value)); } catch { }
        await OnChanged.InvokeAsync();
    }
    private async Task ToggleBrief()
    {
        _brief = !_brief;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "praetoria.brief.every", _brief ? "1" : "0"); } catch { }
        await OnChanged.InvokeAsync();
    }
}
