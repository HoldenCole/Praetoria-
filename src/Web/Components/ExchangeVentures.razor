@inject GameClient G
@using Praetoria.Core.Presentation
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var vs = G.Turn!.Ventures;
    var mine = m.Businesses ?? new List<BusinessCard>(); var assets = m.Assets;
    var open = (m.Ventures ?? new List<VentureOption>()).Where(v => v.Refusal == null).OrderBy(v => v.PerYear > 0 ? 0 : 1).ThenByDescending(v => v.PerYear).ThenBy(v => v.Name, StringComparer.Ordinal).ToList();
    var shut = (m.Ventures ?? new List<VentureOption>()).Where(v => v.Refusal != null).ToList();
    int earns = mine.Sum(b => b.Earnings), worth = mine.Sum(b => b.Value);
    var settleOn = new[] { w.Protagonist! }.Concat(WealthSystem.Members(w, w.House(w.Protagonist!.HouseId)!).Where(k => k.Id != pid)).ToList();
}
<div class="dash-grid exchange-grid">
    <section class="panel">
        <h3><Icon Name="trade_hub" Size="13" /> Your ventures <span class="muted">@mine.Count · earning @Money.Show(earns) credits a year at this year's prices · worth @Money.Show(worth)</span></h3>
        @if (VentureSystem.BadName(w, w.Protagonist!.HouseId)) { <div class="row small"><span class="pill warn" title="A venture of the house failed and was wound up. Buyers know it: they bid a tenth less for anything the house sells, until the year is out.">A name for bad business until year @w.Counter(VentureSystem.BadNameKey(w.Protagonist!.HouseId))</span> <span class="muted">Other houses bid a tenth less for what you sell.</span></div> }
        @if (mine.Count == 0) { <div class="muted">The house owns no venture. Found one below, or buy one from a house that needs the coin.</div> }
        @foreach (var b in mine)
        {
            <div class="vcard">
                <div class="vc-head"><b>@b.Name</b> <span class="muted small">@b.KindName · level @b.Level/@b.MaxLevel@(b.SystemName != null ? $" · {b.SystemName}" : "")@(b.CompanyName != null ? $" · held by {b.CompanyName}" : "")</span>
                    <span class="pill @(b.Earnings <= 0 ? "warn" : "good")">@(b.Earnings >= 0 ? "+" : "")@Money.Show(b.Earnings) a year</span>
                    @if (w.Business(b.Id) is { LosingYears: > 0 } losing) { <span class="pill bad" title="A venture that earns nothing or loses money three years running is wound up: half its salvage comes back, and whoever of the house founded it has failed at it.">@losing.LosingYears of @VentureSystem.FailsAfter years without a profit</span> }</div>
                @if (vs != null && w.Business(b.Id) is { LosingYears: > 0 } failing)
                {
                    var noProp = vs.PropRefusal(w, w.House(w.Protagonist!.HouseId), failing);
                    <div class="row small"><span class="warn">@(failing.LosingYears >= VentureSystem.FailsAfter - 1 ? "It will be wound up next year if it does not pay." : "It has stopped paying.")</span>
                        <button class="opt inline tiny" disabled="@(noProp != null)" title="@(noProp ?? "The losing years are wiped out, and it has three more to come right.")" @onclick="() => G.Execute(new PropVentureCommand(pid, b.Id, vs))">Put @Money.Show(vs.PropCost(w, failing)) credits in</button>
                        <span class="muted">or sell it below. Wound up, it returns @Money.Show(vs.WoundUp(failing)).</span></div>
                }
                @if (vs != null && w.Business(b.Id) is { CompanyId.Length: 0 } own)
                {
                    var its = VentureSystem.HolderOf(w, own); string bid0 = b.Id;
                    <div class="row small">
                        @if (its != null) { <span class="pill" title="What it earns is paid over to them each year, it is not sold or listed unless they agree, and it goes as they leave it.">@(its.Id == pid ? "your own, apart from the house" : its.Name + "'s own")</span> }
                        else if (own.FounderId.Length > 0 && w.Char(own.FounderId) is { Alive: true } fo && fo.Id != pid) { <span class="muted">Founded by @fo.Name: a fifth of its price is theirs if it is sold, and they will mind.</span> }
                        @if (its == null)
                        {
                            bool pledged = w.House(w.Protagonist!.HouseId)!.PledgedId == bid0; var noPledge = vs.PledgeRefusal(w, w.Protagonist, pledged ? string.Empty : bid0);
                            <button class="opt inline tiny @(pledged ? "here" : "")" disabled="@(noPledge != null)" title="@(noPledge ?? (pledged ? "Withdraw it: the creditors take the least of your ventures, as they would have." : "If the house is foreclosed on, its creditors take this first, and leave the rest. Otherwise they take the least of your ventures."))" @onclick="() => G.Execute(new PledgeCommand(pid, pledged ? string.Empty : bid0, vs))">@(pledged ? "Pledged to the creditors" : "Pledge it")</button>
                        }
                        @if (its == null || its.Id == pid)
                        {
                            <span class="muted">Settle it on</span>
                            @foreach (var k in settleOn.Where(k => k.Id != its?.Id).Take(5)) { string kid = k.Id; var noSettle = vs.SettleRefusal(w, w.Protagonist, own, k); <button class="opt inline tiny" disabled="@(noSettle != null)" title="@(noSettle ?? (kid == pid ? "It is yours, not the house's: what it earns goes to your purse, and it goes by your will." : "It is theirs from now on: what it earns, and the say in selling it. They will think much better of you. You cannot take it back."))" @onclick="() => G.Execute(new SettleVentureCommand(pid, bid0, kid, vs))">@(kid == pid ? "yourself" : k.Name.Split(' ')[0])</button> }
                        }
                    </div>
                }
                <div class="kv"><span>Pays</span><b>@b.Yield@(b.Charter != null ? $" · charter {b.Charter}" : "")</b></div>
                <div class="kv"><span>Worth</span><b>@Money.Show(b.Value) <i class="muted">six years of what it earns now, half its book at least</i></b></div>
                <div class="row small">
                    <button class="opt inline tiny" disabled="@(b.Expand.Refusal != null)" title="@b.Expand.Refusal" @onclick="() => G.Execute(new ExpandBusinessCommand(pid, b.Id, c.Businesses))">@b.Expand.Label</button>
                    @if (b.CompanyName == null && G.Turn!.Companies is { Open: true } cx)
                    {
                        var listing = cx.IncorporateRefusal(w, w.Protagonist!.HouseId, w.Businesses.GetValueOrDefault(b.Id), string.Empty);
                        <button class="opt inline tiny" disabled="@(listing != null)" title="@(listing ?? "list it on the Exchange as a company: a hundred shares, all yours")" @onclick='() => G.AskDo("Incorporate " + b.Name + "?", "It is listed on the Exchange as a company of a hundred shares, all yours to begin with. It is then a company and not a venture of the house: its profit is paid as dividends to whoever holds the shares, and others may buy in. It cannot be made a private venture again.", "Incorporate", new IncorporateCommand(pid, b.Id, string.Empty, cx))'>Incorporate</button>
                    }
                    @if (vs != null && b.CompanyName == null)
                    {
                        <button class="opt inline tiny" disabled="@(b.Sell.Refusal != null)" title="@(b.Sell.Refusal ?? "four-fifths of its worth; the caravaneers break it up")" @onclick='() => G.AskDo("Sell " + b.Name + "?", b.Sell.Label + ". The caravaneers break it up and pay four-fifths of what it is worth today: a venture is worth what it cost in its first year and comes to its full worth over five. It is gone for good, and what it yielded each year goes with it.", "Sell it", new SellVentureCommand(pid, b.Id, string.Empty, vs))'>@b.Sell.Label</button>
                        @foreach (var bid in b.Bids ?? new List<VentureBid>())
                        {
                            string? bidNo = new SellVentureCommand(pid, b.Id, bid.HouseId, vs).Refusal(G.Ctx);
                            <button class="opt inline tiny" disabled="@(bidNo != null)" title="@(bidNo ?? ((bid.HoldsTheWorld ? "It holds the world the venture works, and pays the more for that. " : "") + $"A private sale: the venture stays whole and goes on working for {bid.HouseName}, whose head thinks {VentureSystem.PrivateSaleRegard} the better of you for it. The open market breaks it up and buys you no regard: take whichever pays you more for what you want."))" @onclick='() => G.AskDo("Sell " + b.Name + " to " + bid.HouseName + "?", bid.HouseName + " pays " + Money.Credits(bid.Price) + " and has the venture and what it yields from now on. It cannot be asked back.", "Sell for " + Money.Show(bid.Price), new SellVentureCommand(pid, b.Id, bid.HouseId, vs))'>Sell to @bid.HouseName for @Money.Show(bid.Price)</button>
                        }
                    }
                </div>
            </div>
        }

        @if (assets is { Offers.Count: > 0 } && vs != null)
        {
            <h4>Offered to you <span class="muted">good until the year is out</span></h4>
            @foreach (var o in assets.Offers)
            {
                <div class="vcard offer">
                    <div class="vc-head"><b>@o.BusinessName</b> <span class="muted small">@o.KindName@(o.SystemName != null ? $" · {o.SystemName}" : "") · from @o.FromName</span><span class="pill good" title="What it yields is goods, not coin: this is what a year of it is worth at today's prices, after its keep and the charter.">worth +@Money.Show(o.PerYear) credits a year to you at today's prices</span></div>
                    <div class="muted small">@Cap(o.Reason).</div>
                    <button class="opt inline" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new AcceptVentureOfferCommand(pid, o.Id, vs))">Take it for @Money.Show(o.Price) credits</button>
                </div>
            }
        }

        <h4>Found a venture <span class="muted">what it would earn at this year's prices, and how long until it has paid for itself</span></h4>
        @{ var boards = w.Companies.Where(x => !x.Chartered && x.ControllerId == w.Protagonist!.HouseId).OrderBy(x => x.Id, StringComparer.Ordinal).ToList(); if (boards.All(x => x.Id != _payFrom)) _payFrom = string.Empty; }
        @if (boards.Count > 0)
        {
            <div class="row small"><span class="muted">Paid for by</span>
                <button class="opt inline tiny @(_payFrom.Length == 0 ? "here" : "")" @onclick="() => _payFrom = string.Empty">the house</button>
                @foreach (var bd in boards) { var bid = bd.Id; <button class="opt inline tiny @(_payFrom == bid ? "here" : "")" title="from the company's own cash; the venture is the company's" @onclick="() => _payFrom = bid">@bd.Name · @Money.Show(bd.Cash) in hand</button> }
            </div>
        }
        @if (open.Count == 0) { <div class="muted small">Nothing can be founded with what the house holds and where it stands.</div> }
        <table class="standings ventures">
            <thead><tr><th>Venture</th><th>Where</th><th>Cost</th><th>Built in</th><th>Earns</th><th>Pays back</th><th></th></tr></thead>
            <tbody>
            @foreach (var v in open.Take(_all ? 200 : 12))
            {
                <tr title="@v.Description">
                    <td class="hn"><b>@v.Name</b> <span class="muted small">@v.Sector</span></td>
                    <td class="muted small">@v.SystemName</td>
                    <td class="small">@v.Cost@(v.BuildTurns > 1 ? $" · {v.First} a year" : "")</td>
                    <td class="small">@(v.BuildTurns <= 0 ? "at once" : v.BuildTurns == 1 ? "a year" : $"{v.BuildTurns} years")</td>
                    <td><span class="@(v.PerYear > 0 ? "good" : "warn")" title="What it yields is goods, not coin: this is what a year of it is worth at today's prices, after its keep and the charter. Prices move.">@(v.PerYear >= 0 ? "+" : "")@Money.Show(v.PerYear) cr worth</span>@if (v.Swing.Length > 0) { <div class="muted small" data-swing>@v.Swing</div> }</td>
                    <td class="small">@v.Payback</td>
                    <td>@{ var foundCmd = new FoundBusinessCommand(pid, v.DefId, v.SystemId, c.Businesses, c.Holdings, c.Titles, _payFrom); var foundNo = _payFrom.Length > 0 ? foundCmd.Refusal(new CommandContext(w, new Praetoria.Core.Rng.SplitMix64Rng(0))) : null; }<button class="opt inline tiny" disabled="@(foundNo != null)" title="@foundNo" @onclick="() => G.Execute(foundCmd)">Found</button></td>
                </tr>
            }
            </tbody>
        </table>
        @if (open.Count > 12) { <button class="opt inline tiny" @onclick="() => _all = !_all">@(_all ? "Show the best twelve" : $"Show all {open.Count}")</button> }
        @if (shut.Count > 0) { <details><summary class="muted small">@shut.Count more on your own worlds that cannot be founded yet</summary>@foreach (var v in shut) { <div class="line small"><b>@v.Name</b> at @v.SystemName <span class="muted">— @v.Refusal</span></div> }</details> }
    </section>

    <aside class="dash-side">
        <section class="panel">
            <h3><Icon Name="houses" Size="13" /> For sale in the Reach <span class="muted">every house has its price</span></h3>
            @if (assets == null || assets.ForSale.Count == 0) { <div class="muted">No house has a venture it would part with to you.</div> }
            else
            {
                @foreach (var f in assets.ForSale)
                {
                    <div class="vcard @(f.Distressed ? "distress" : "")">
                        <div class="vc-head"><Sigil HouseId="@f.OwnerId" Accent="@f.OwnerAccent" Size="14" /> <b>@f.Name</b></div>
                        <div class="muted small">@f.KindName · level @f.Level@(f.SystemName != null ? $" · {f.SystemName}" : "") · @f.OwnerName@(f.Distressed ? " · short of coin" : "")@(f.OnYourWorld ? " · works your world" : "")</div>
                        <div class="kv"><span>To you</span><b><span class="@(f.PerYear > 0 ? "good" : "warn")">@(f.PerYear >= 0 ? "+" : "")@Money.Show(f.PerYear) credits' worth a year, in goods at today's prices</span> · @(f.Payback == "never" ? "does not pay itself back at this price" : "pays back in " + f.Payback)</b></div>
                        <VentureBuy BusinessId="@f.BusinessId" />
                    </div>
                }
                <div class="muted small">A house asks a premium to part with a venture, more for one on its own world or its last, less when it is short of coin. It would take less than it asks: make an offer, once a year for each. The holder of the world it works may match your price and take it first. Any venture of any house can be offered for from that house's page, under Houses.</div>
            }
        </section>
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    private bool _all;
    private string _payFrom = string.Empty;
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
}
