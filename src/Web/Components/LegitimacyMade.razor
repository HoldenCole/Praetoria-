@* What a house's legitimacy is made of (docs/TITLES.md): where it began, what each kind of cause has added or taken over the
   whole game and over the last ten years, where it stands, and the last changes with their year. The figures add up. Rows of a
   label and a right-aligned figure (docs/VISUAL_SYSTEM.md 4.7, 4.13), the signed figures green or red; its rules are in house.css
   (lm-*), so it reads the same under the House window, a house's page and the Senate. *@
@using Praetoria.Core.Presentation
<div class="legit-made lm" data-legitimacy-made="@Card.Now">
    <div class="lm-row lm-ends"><span class="lm-k">Began at <small>@(Card.BeganTurn <= 0 ? "as the game opened" : "year " + Card.BeganTurn)</small></span><b class="lm-v" data-legitimacy-began="@Card.Began">@Card.Began</b></div>
    @foreach (var c in Card.Causes)
    {
        <div class="lm-row" data-legitimacy-cause="@c.Id" title="@Lately(c)"><span class="lm-k">@c.Name <small>@LegitimacyProjection.Signed(c.Lately) in the last ten years</small></span><b class="lm-v @(c.Total < 0 ? "ui-down" : c.Total > 0 ? "ui-up" : string.Empty)">@LegitimacyProjection.Signed(c.Total)</b></div>
    }
    @if (Card.Causes.Count == 0) { <p class="lm-note">Nothing has moved it since.</p> }
    <div class="lm-row lm-ends lm-sum"><span class="lm-k">Stands at</span><b class="lm-v" data-legitimacy-now="@Card.Now">@Card.Now</b></div>
    @if (Card.Changes.Count > 0)
    {
        <div class="lm-hd">The last changes, the newest first</div>
        @foreach (var ch in Card.Changes)
        {
            <div class="lm-row lm-change" data-legitimacy-change="@ch.Cause" title="@ch.CauseName"><span class="lm-yr">Year @ch.Turn</span><span class="lm-k">@ch.Line <small>@ch.CauseName</small></span><b class="lm-v @(ch.By < 0 ? "ui-down" : "ui-up")">@LegitimacyProjection.Signed(ch.By)</b></div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public LegitimacyCard Card { get; set; } = default!;
    private static string Lately(LegitimacyCause c) => $"{c.Name}: {LegitimacyProjection.Signed(c.Total)} since the house began, {LegitimacyProjection.Signed(c.Lately)} of it in the last ten years.";
}
