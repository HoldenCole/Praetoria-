@inject GameClient G
@inject IJSRuntime JS
@{
    var w = G.World!; var c = G.Content!; var house = w.House(w.Protagonist!.HouseId)!;
    var nodes = GalaxyProjection.Nodes(w).ToDictionary(n => n.SystemId); var regions = GalaxyProjection.Regions(w);
    var fn = _focus != null && nodes.TryGetValue(_focus, out var f0) ? f0 : null;
    int myWorlds = nodes.Values.Count(n => n.IsPlayerTerritory && n.PlanetHoldingId != null), restless = nodes.Values.Count(n => n.Population > 0 && n.Unrest >= 50), unclaimed = nodes.Values.Count(n => n.OwnerHouseId == null);
    var shown = _region == null ? regions : regions.Where(r => r.Id == _region).ToList();

    // The picture (docs/DASHBOARDS.md): what is yours, what is restless, and what is there to be had.
    var worlds = nodes.Values.Where(n => n.PlanetHoldingId != null).ToList(); var peopled = worlds.Where(n => n.Population > 0).ToList();
    var ours = worlds.Where(n => n.IsPlayerTerritory).OrderByDescending(n => n.Unrest).ThenBy(n => n.SystemId, StringComparer.Ordinal).ToList(); var worst = ours.FirstOrDefault();
    var marches = regions.Where(r => r.FreeMarch).ToList(); var unruly = regions.OrderByDescending(r => r.Unrest).FirstOrDefault();
    int withDeposits = nodes.Values.Count(n => n.Deposits is { Count: > 0 }), oursDeposits = nodes.Values.Count(n => n.IsPlayerTerritory && n.Deposits is { Count: > 0 });
    string story, storyTone;
    if (worst is { Unrest: >= 50 }) { story = $"{worst.Name}, a world of yours, is restless: loyalty {100 - worst.Unrest}. You hold {ours.Count} of the Reach's {worlds.Count} worlds."; storyTone = "bad"; }
    else if (ours.Count == 0) { story = $"You hold no world. {unclaimed} system(s) lie unclaimed, and {restless} of the Reach's {peopled.Count} peopled worlds are restless."; storyTone = ""; }
    else { story = $"You hold {ours.Count} of the Reach's {worlds.Count} worlds, and none of them is restless{(worst == null ? "" : worst.Unrest == 0 ? ": every one is wholly loyal" : $": the least loyal is {worst.Name}, at {100 - worst.Unrest}")}. Across the Reach {restless} of {peopled.Count} peopled worlds are restless{(unruly != null && restless > 0 ? $", most of all in {unruly.Name}" : "")}."; storyTone = "good"; }
}
<div class="dash worlds" style="--accent:@house.AccentColor">
    <header class="dash-head picture">
        <div class="dh-title"><Icon Name="worlds" Size="18" /> <b>The Worlds of @w.Galaxy!.Name</b> <span class="muted">@regions.Count regions · @nodes.Count systems · @w.Holdings.Values.Count(h => !h.IsPlanet) stations</span></div>
        <p class="headline @storyTone">@story</p>
        <div class="tiles">
            <Tile Label="Yours" Value="@($"{ours.Count} of {worlds.Count}")" Share="@(worlds.Count > 0 ? 100 * ours.Count / worlds.Count : 0)" Note="@(ours.Count == 0 ? "a fief is won, granted, or married into" : $"worlds, in {ours.Select(n => n.RegionId).Distinct().Count()} region(s)")" Title="The bar is your share of the Reach's worlds." />
            @if (worst != null) { <Tile Label="Your least loyal" Value="@($"{100 - worst.Unrest}")" Share="@(100 - worst.Unrest)" Tone="@(worst.Unrest >= 50 ? "bad" : worst.Unrest >= 35 ? "warn" : "good")" Note="@($"{worst.Name} · restless below 50")" Title="Loyalty is a hundred less the unrest. A restless world yields less and may rise." /> }
            <Tile Label="Restless in the Reach" Value="@restless.ToString()" Share="@(peopled.Count > 0 ? 100 * restless / peopled.Count : 0)" Tone="@(restless > 3 ? "warn" : "")" Note="@($"of {peopled.Count} peopled worlds{(unruly != null && unruly.Unrest > 0 ? $" · worst region: {unruly.Name}" : "")}")" />
            <Tile Label="Unclaimed" Value="@unclaimed.ToString()" Note="@(unclaimed == 0 ? "every system has a master" : "systems with no master: to be settled or taken")" />
            <Tile Label="Free marches" Value="@(marches.Count == 0 ? "none" : marches.Count.ToString())" Tone="@(marches.Count > 0 ? "warn" : "")" Note="@(marches.Count == 0 ? "no region has thrown off the Reach" : string.Join(", ", marches.Take(2).Select(r => r.Name)))" Title="A region that answers to nobody." />
            <Tile Label="Deposits" Value="@withDeposits.ToString()" Share="@(withDeposits > 0 ? 100 * oursDeposits / withDeposits : 0)" Note="@($"systems with something under them · {oursDeposits} of them yours")" Title="Helium-3, rare earths and isotopes lie under some systems; what you lack, you buy." />
        </div>
    </header>
    <div class="dash-grid worlds-grid">
        <nav class="cw-tabs">
            @foreach (var (id, label) in new[] { ("worlds", "The worlds"), ("regions", "The regions") }) { var tid = id; <button class="rung @(_tab == tid ? "here" : "")" @onclick="() => _tab = tid">@label</button> }
        </nav>
        @if (_tab == "worlds") {
        <section class="panel" data-great-cities="@CitySystem.Great(w, c.Holdings).Count()">
            <h3><Icon Name="worlds" Size="13" /> The great cities of the Reach <span class="muted">one of each · click to go there</span></h3>
            @foreach (var (gk, gw, gi) in CitySystem.Great(w, c.Holdings))
            {
                string gsys = gw.SystemId; var gholder = w.House(ProvinceSystem.HolderOf(gw, gi)); var gb = c.Holdings.Work(gk.Building); bool gstands = gb != null && (gw.Provinces[gi].Buildings.Contains(gb.Id) || w.BodyWorks.Any(x => x.SystemId == gsys && x.DefId == gb.Id));
                string gdoes = CitySystem.Says(gk); string gonly = gb == null ? "" : " Only here: " + gb.Name + (gstands ? " (it stands)." : " (not yet raised).");
                <div class="great-row" @onclick="() => OnFocus.InvokeAsync(gsys)">
                    <b>★ @gw.Provinces[gi].City</b> <span class="city-kind">@gk.Name</span> <span class="muted small">on @gw.Name · @Census.Say(CitySystem.Citizens(w, c.Holdings, gw, gi)) citizens · held by <span style="color:@(gholder?.AccentColor ?? "inherit")">@(gholder?.Id == house.Id ? "your house" : gholder?.Name ?? "nobody")</span></span>
                    <div class="muted small">@gk.What @(gdoes.Length > 0 ? gdoes + "." : "")@gonly</div>
                </div>
            }
        </section>
        <section class="panel">
            <h3><Icon Name="worlds" Size="13" /> The world board <span class="muted">click a world</span></h3>
            <div class="pick-row"><span class="muted small">Region</span> <select @onchange='e => _region = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()'><option value="">all the regions</option>@foreach (var r in regions) { <option value="@r.Id" selected="@(_region == r.Id)">@r.Name</option> }</select></div>
            @foreach (var r in shown)
            {
                <div class="region-head" style="--accent:@r.AccentColor"><h4>@r.Name <span class="ring @r.Ring">@r.Ring</span></h4><span class="muted small">@r.Culture · @(r.DominantHouseName != null ? $"{r.DominantHouseName} dominates" : "no house dominates")@(r.FreeMarch ? " · FREE MARCH" : "")@(r.StateName != null ? " · " + r.StateName : "") · unrest @r.Unrest</span></div>
                <table class="standings worlds-tbl">
                    <thead><tr><th>World</th><th>Class</th><th>Holder</th><th>Governor</th><th>Loyalty</th><th>Prosperity</th><th>Pop</th><th>Riches</th></tr></thead>
                    <tbody>
                    @foreach (var id in r.SystemIds)
                    {
                        var n = nodes[id]; var owner = n.OwnerHouseId != null ? w.House(n.OwnerHouseId) : null;
                        <tr class="@(n.IsPlayerTerritory ? "mine" : "") @(id == _focus ? "here" : "")" @onclick="() => _focus = id">
                            <td class="hn"><img class="sprite" data-planet="@n.PlanetClass|@n.SystemId|20" alt="" /> <b>@n.Name</b>@if (n.Capital) { <span class="tier small opulent">capital</span> }@if (n.Chokepoint) { <span class="pill small" title="chokepoint">⋈</span> }</td>
                            <td class="muted">@n.PlanetClass</td>
                            <td>@if (owner != null) { <Sigil HouseId="@owner.Id" Accent="@owner.AccentColor" Size="13" /> <span>@owner.Name</span> } else { <span class="muted">—</span> }</td>
                            <td class="muted small">@(n.GovernorName ?? "")</td>
                            <td>@if (n.Population > 0) { <span class="mbar"><i style="width:@(100 - n.Unrest)%; background:@(n.Unrest >= 50 ? "var(--warn)" : "var(--good)")"></i></span>@(100 - n.Unrest) }</td>
                            <td>@if (n.PlanetHoldingId != null) { <span class="mbar"><i style="width:@n.Prosperity%; background:var(--brass)"></i></span>@n.Prosperity }</td>
                            <td class="muted" title="@(n.Population > 0 ? "scale " + n.Population : "")">@(n.Population > 0 && n.PlanetHoldingId != null && w.Holding(n.PlanetHoldingId) is { } nh ? Census.Short(Census.Citizens(w, nh)) : "")</td>
                            <td class="small">@if (n.Stations > 0) { <span class="pill small">@n.Stations st</span> }@if (n.Belt > 0) { <span class="pill small" title="belt richness @n.Belt">@(new string('●', n.Belt))</span> }@if (n.Deposits is { Count: > 0 }) { foreach (var d in n.Deposits) { <span class="pill small dep" title="@Resource.Label(d.Key) deposit, richness @d.Value">@(d.Key == "helium3" ? "³He" : d.Key == "rare_earths" ? "RE" : "Iso") @d.Value</span> } }@if (n.Ventures > 0) { <span class="pill small" title="ventures">@n.Ventures v</span> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>
        }
        <aside class="dash-side">
            @if (fn != null)
            {
                var planet = fn.PlanetHoldingId != null ? w.Holding(fn.PlanetHoldingId) : null; var owner = fn.OwnerHouseId != null ? w.House(fn.OwnerHouseId) : null; var region = regions.FirstOrDefault(r => r.Id == fn.RegionId);
                var stations = w.Holdings.Values.Where(h => h.SystemId == fn.SystemId && !h.IsPlanet).ToList(); var sys = w.Galaxy.System(fn.SystemId);
                var fleets = GalaxyProjection.Fleets(w).Where(f => f.SystemId == fn.SystemId).ToList();
        @if (_tab == "worlds") {
                <section class="panel">
                    <div class="seat-card">
                        <img class="sprite big" data-planet="@fn.PlanetClass|@fn.SystemId|64" alt="" />
                        <div class="sc-body">
                            <div class="sc-name">@fn.Name <span class="muted">@fn.PlanetClass world@(region != null ? $" · {region.Name}" : "") · @fn.Culture culture</span></div>
                            <div class="muted small">@(owner != null ? $"held by {owner.Name}" : "unclaimed")@(fn.GovernorName != null ? $" · governor {fn.GovernorName}" : "")@(planet != null ? $" · {c.Holdings.Spec(planet.Specialization)?.Name ?? planet.Specialization}" : "")@(fn.Population > 0 ? $" · {(planet != null ? Census.Say(Census.Citizens(w, planet)) : fn.Population.ToString())} citizens · loyalty {100 - fn.Unrest}" : "")@(fn.Rebellion > 0 ? $" · rebellion {fn.Rebellion}" : "")</div>
                            @if (planet != null) { <div class="muted small">Built: @(planet.Buildings.Count == 0 ? "nothing" : string.Join(", ", planet.Buildings.Select(b => c.Holdings.Building(b)?.Name ?? b)))</div> }
                            @if (stations.Count > 0) { <div class="muted small">Stations: @string.Join(", ", stations.Select(s => s.Name))</div> }
                            @if (fn.Deposits is { Count: > 0 }) { <div class="muted small">Deposits: @string.Join(", ", fn.Deposits.Select(d => $"{Resource.Label(d.Key)} ({d.Value})"))</div> }
                            @if (fleets.Count > 0) { <div class="muted small">In the sky: @string.Join(", ", fleets.Select(f => $"{f.Name} ({f.OwnerHouseName}, {f.Strength})"))</div> }
                            @if (sys != null && sys.Description.Length > 0) { <div class="muted small">@sys.Description</div> }
                            <div class="sc-actions"><button class="opt inline tiny" @onclick="() => OnFocus.InvokeAsync(fn.SystemId)">Open on the galaxy map</button></div>
                        </div>
                        <button class="win-close" @onclick="() => _focus = null">✕</button>
                    </div>
                </section>
        }
            }
        @if (_tab == "regions") {
            <section class="panel">
                <h3><Icon Name="galaxy" Size="13" /> The regions</h3>
                @foreach (var r in regions)
                {
                    int mineHere = r.SystemIds.Count(id => nodes[id].IsPlayerTerritory);
                    <div class="region-row" style="--accent:@r.AccentColor" @onclick='() => { _region = r.Id; _tab = "worlds"; }'><b>@r.Name</b> <span class="ring @r.Ring">@r.Ring</span><div class="muted small">@r.SystemIds.Count systems · @(r.DominantHouseName ?? "no one") dominates@(mineHere > 0 ? $" · {mineHere} yours" : "")@(r.FreeMarch ? " · free march" : "")</div>
                        <div class="gauge" title="regional unrest"><span>Unrest</span><i><b style="width:@r.Unrest%" class="@(r.Unrest >= 50 ? "low" : "")"></b></i><em>@r.Unrest</em></div>
                        @if (w.Counter(LadderSystem.RegionTrustKey(r.Id)) != 0) { int rt = LadderSystem.RegionTrust(w, r.Id); <div class="gauge" title="What this region thinks of the magistrates, against the Reach's @LadderSystem.Trust(w). Under @LadderSystem.TrustLow it holds a little less closely to the Reach each year; at @LadderSystem.TrustHigh or more, a little closer."><span>Magistrates</span><i><b style="width:@rt%" class="@(rt < LadderSystem.TrustLow ? "low" : "")"></b></i><em>@rt</em></div> }</div>
                }
            </section>
        }
        </aside>
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnFocus { get; set; }
    private string? _focus, _region;
    private string _tab = "worlds";
    // an alert opens this window on its subject (docs/PLAYTHROUGH.md 15): "window:tab", or "window:tab:person"
    [Parameter] public string Tab { get; set; } = "";
    [Parameter] public int TabStamp { get; set; }
    private static int _seenStamp;
    protected override void OnParametersSet() { if (TabStamp != _seenStamp) { _seenStamp = TabStamp; if (Tab.Length > 0) OpenOn(Tab); } }
    private void OpenOn(string tab) { if (tab is "worlds" or "regions") _tab = tab; }
    protected override async Task OnAfterRenderAsync(bool first) { try { await JS.InvokeVoidAsync("praetoriaFx.paint"); } catch { } }
}
