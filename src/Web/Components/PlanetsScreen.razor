@inject GameClient G
@inject IJSRuntime JS
@{
    var w = G.World!; var c = G.Content!; var house = w.House(w.Protagonist!.HouseId)!;
    var nodes = GalaxyProjection.Nodes(w).ToDictionary(n => n.SystemId); var regions = GalaxyProjection.Regions(w);
    var fn = _focus != null && nodes.TryGetValue(_focus, out var f0) ? f0 : null;
    int myWorlds = nodes.Values.Count(n => n.IsPlayerTerritory && n.PlanetHoldingId != null), restless = nodes.Values.Count(n => n.Population > 0 && n.Unrest >= 50), unclaimed = nodes.Values.Count(n => n.OwnerHouseId == null);
    var shown = _region == null ? regions : regions.Where(r => r.Id == _region).ToList();
}
<div class="dash worlds" style="--accent:@house.AccentColor">
    <header class="dash-head">
        <div class="dh-title"><Icon Name="worlds" Size="18" /> <b>The Worlds of @w.Galaxy!.Name</b> <span class="muted">@regions.Count regions · @nodes.Count systems · @w.Holdings.Values.Count(h => !h.IsPlanet) stations</span></div>
        <div class="dh-stats">
            <div class="stat"><span>Yours</span><b>@myWorlds</b></div>
            <div class="stat"><span>Unclaimed</span><b>@unclaimed</b></div>
            <div class="stat @(restless > 3 ? "warn" : "")"><span>Restless worlds</span><b>@restless</b></div>
            <div class="stat"><span>Free marches</span><b>@regions.Count(r => r.FreeMarch)</b></div>
            <div class="stat"><span>Deposits</span><b>@nodes.Values.Count(n => n.Deposits is { Count: > 0 })</b></div>
        </div>
    </header>
    <div class="dash-grid worlds-grid">
        <section class="panel">
            <h3><Icon Name="worlds" Size="13" /> The world board <span class="muted">click a world</span></h3>
            <div class="vols"><button class="rung @(_region == null ? "here" : "")" @onclick="() => _region = null">all regions</button>@foreach (var r in regions) { <button class="rung @(_region == r.Id ? "here" : "")" style="--accent:@r.AccentColor" @onclick="() => _region = r.Id">@r.Name</button> }</div>
            @foreach (var r in shown)
            {
                <div class="region-head" style="--accent:@r.AccentColor"><h4>@r.Name <span class="ring @r.Ring">@r.Ring</span></h4><span class="muted small">@r.Culture · @(r.DominantHouseName != null ? $"{r.DominantHouseName} dominates" : "no house dominates")@(r.FreeMarch ? " · FREE MARCH" : "") · unrest @r.Unrest</span></div>
                <table class="standings worlds-tbl">
                    <thead><tr><th>World</th><th>Class</th><th>Holder</th><th>Governor</th><th>Loyalty</th><th>Prosperity</th><th>Pop</th><th>Riches</th></tr></thead>
                    <tbody>
                    @foreach (var id in r.SystemIds)
                    {
                        var n = nodes[id]; var owner = n.OwnerHouseId != null ? w.House(n.OwnerHouseId) : null;
                        <tr class="@(n.IsPlayerTerritory ? "mine" : "") @(id == _focus ? "here" : "")" @onclick="() => _focus = id">
                            <td class="hn"><img class="sprite" data-planet="@n.PlanetClass|@n.SystemId|20" alt="" /> <b>@n.Name</b>@if (n.Capital) { <span class="tier small opulent">capital</span> }@if (n.Chokepoint) { <span class="pill small" title="chokepoint">⋈</span> }</td>
                            <td class="muted">@n.PlanetClass</td>
                            <td>@if (owner != null) { <Sigil HouseId="@owner.Id" Accent="@owner.AccentColor" Size="13" /> <span>@owner.Name</span> } else { <span class="muted">—</span> }</td>
                            <td class="muted small">@(n.GovernorName ?? "")</td>
                            <td>@if (n.Population > 0) { <span class="mbar"><i style="width:@(100 - n.Unrest)%; background:@(n.Unrest >= 50 ? "var(--warn)" : "var(--good)")"></i></span>@(100 - n.Unrest) }</td>
                            <td>@if (n.PlanetHoldingId != null) { <span class="mbar"><i style="width:@n.Prosperity%; background:var(--brass)"></i></span>@n.Prosperity }</td>
                            <td class="muted">@(n.Population > 0 ? n.Population.ToString() : "")</td>
                            <td class="small">@if (n.Stations > 0) { <span class="pill small">@n.Stations st</span> }@if (n.Belt > 0) { <span class="pill small" title="belt richness @n.Belt">@(new string('●', n.Belt))</span> }@if (n.Deposits is { Count: > 0 }) { foreach (var d in n.Deposits) { <span class="pill small dep" title="@Resource.Label(d.Key) deposit, richness @d.Value">@(d.Key == "helium3" ? "³He" : d.Key == "rare_earths" ? "RE" : "Iso") @d.Value</span> } }@if (n.Ventures > 0) { <span class="pill small" title="ventures">@n.Ventures v</span> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>
        <aside class="dash-side">
            @if (fn != null)
            {
                var planet = fn.PlanetHoldingId != null ? w.Holding(fn.PlanetHoldingId) : null; var owner = fn.OwnerHouseId != null ? w.House(fn.OwnerHouseId) : null; var region = regions.FirstOrDefault(r => r.Id == fn.RegionId);
                var stations = w.Holdings.Values.Where(h => h.SystemId == fn.SystemId && !h.IsPlanet).ToList(); var sys = w.Galaxy.System(fn.SystemId);
                var fleets = GalaxyProjection.Fleets(w).Where(f => f.SystemId == fn.SystemId).ToList();
                <section class="panel">
                    <div class="seat-card">
                        <img class="sprite big" data-planet="@fn.PlanetClass|@fn.SystemId|64" alt="" />
                        <div class="sc-body">
                            <div class="sc-name">@fn.Name <span class="muted">@fn.PlanetClass world@(region != null ? $" · {region.Name}" : "") · @fn.Culture culture</span></div>
                            <div class="muted small">@(owner != null ? $"held by {owner.Name}" : "unclaimed")@(fn.GovernorName != null ? $" · governor {fn.GovernorName}" : "")@(planet != null ? $" · {c.Holdings.Spec(planet.Specialization)?.Name ?? planet.Specialization}" : "")@(fn.Population > 0 ? $" · pop {fn.Population} · loyalty {100 - fn.Unrest}" : "")@(fn.Rebellion > 0 ? $" · rebellion {fn.Rebellion}" : "")</div>
                            @if (planet != null) { <div class="muted small">Built: @(planet.Buildings.Count == 0 ? "nothing" : string.Join(", ", planet.Buildings.Select(b => c.Holdings.Building(b)?.Name ?? b)))</div> }
                            @if (stations.Count > 0) { <div class="muted small">Stations: @string.Join(", ", stations.Select(s => s.Name))</div> }
                            @if (fn.Deposits is { Count: > 0 }) { <div class="muted small">Deposits: @string.Join(", ", fn.Deposits.Select(d => $"{Resource.Label(d.Key)} ({d.Value})"))</div> }
                            @if (fleets.Count > 0) { <div class="muted small">In the sky: @string.Join(", ", fleets.Select(f => $"{f.Name} ({f.OwnerHouseName}, {f.Strength})"))</div> }
                            @if (sys != null && sys.Description.Length > 0) { <div class="muted small">@sys.Description</div> }
                            <div class="sc-actions"><button class="opt inline tiny" @onclick="() => OnFocus.InvokeAsync(fn.SystemId)">Open on the galaxy map</button></div>
                        </div>
                        <button class="win-close" @onclick="() => _focus = null">✕</button>
                    </div>
                </section>
            }
            <section class="panel">
                <h3><Icon Name="galaxy" Size="13" /> The regions</h3>
                @foreach (var r in regions)
                {
                    int mineHere = r.SystemIds.Count(id => nodes[id].IsPlayerTerritory);
                    <div class="region-row" style="--accent:@r.AccentColor" @onclick="() => _region = r.Id"><b>@r.Name</b> <span class="ring @r.Ring">@r.Ring</span><div class="muted small">@r.SystemIds.Count systems · @(r.DominantHouseName ?? "no one") dominates@(mineHere > 0 ? $" · {mineHere} yours" : "")@(r.FreeMarch ? " · free march" : "")</div>
                        <div class="gauge" title="regional unrest"><span>Unrest</span><i><b style="width:@r.Unrest%" class="@(r.Unrest >= 50 ? "low" : "")"></b></i><em>@r.Unrest</em></div></div>
                }
            </section>
        </aside>
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnFocus { get; set; }
    private string? _focus, _region;
    protected override async Task OnAfterRenderAsync(bool first) { try { await JS.InvokeVoidAsync("praetoriaFx.paint"); } catch { } }
}
