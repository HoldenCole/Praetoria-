@inject GameClient G
@inject IJSRuntime JS
@implements IAsyncDisposable
@{
    var w = G.World!; var c = G.Content!; var house = w.House(w.Protagonist!.HouseId)!;
    var nodes = GalaxyProjection.Nodes(w).ToDictionary(n => n.SystemId); var regions = GalaxyProjection.Regions(w);
    _pending = BuildOptions(w, house, regions, nodes);
    var fn = _focus != null && nodes.TryGetValue(_focus, out var f0) ? f0 : null;
}
<div class="office orrery" style="--accent:@house.AccentColor">
    <div class="office-stage">
        <div class="gl-host" @ref="_host"></div>
        <div class="stage-foot">
            <div class="stage-title"><Icon Name="worlds" Size="16" /> <b>The Orrery of @w.Galaxy!.Name</b> <span class="muted">@regions.Count regions · @nodes.Count worlds · @w.Holdings.Values.Count(h => !h.IsPlanet) stations</span></div>
            <span class="muted small">each arm a region, each globe a world · click one</span>
        </div>
        @if (fn != null)
        {
            var planet = fn.PlanetHoldingId != null ? w.Holding(fn.PlanetHoldingId) : null; var owner = fn.OwnerHouseId != null ? w.House(fn.OwnerHouseId) : null; var region = regions.FirstOrDefault(r => r.Id == fn.RegionId);
            var stations = w.Holdings.Values.Where(h => h.SystemId == fn.SystemId && !h.IsPlanet).ToList(); var sys = w.Galaxy.System(fn.SystemId);
            <div class="stage-card">
                <img class="sprite big" data-planet="@fn.PlanetClass|@fn.SystemId|64" alt="" />
                <div class="sc-body">
                    <div class="sc-name">@fn.Name <span class="muted">@fn.PlanetClass world@(region != null ? $" · {region.Name}" : "") · @fn.Culture culture</span></div>
                    <div class="muted small">@(owner != null ? $"held by {owner.Name}" : "unclaimed")@(fn.GovernorName != null ? $" · governor {fn.GovernorName}" : "")@(planet != null ? $" · {c.Holdings.Spec(planet.Specialization)?.Name ?? planet.Specialization} · pop {fn.Population} · loyalty {100 - fn.Unrest}" : "")@(stations.Count > 0 ? $" · {string.Join(", ", stations.Select(s => $"{s.Name} ({w.House(s.OwnerId)?.Name})"))}" : "")@(fn.Contested ? " · contested" : "")</div>
                    @if (sys != null && sys.Description.Length > 0) { <div class="muted small">@sys.Description</div> }
                    <div class="sc-actions"><button class="opt inline" @onclick="() => OnFocus.InvokeAsync(fn.SystemId)">Open on the galaxy map</button></div>
                </div>
                <button class="win-close" @onclick="() => _focus = null">✕</button>
            </div>
        }
    </div>

    <aside class="office-side">
        @foreach (var r in regions)
        {
            <section class="panel region-block" style="--accent:@r.AccentColor">
                <div class="region-head"><h3>@r.Name</h3><span class="muted">@r.Culture · @(r.DominantHouseName != null ? $"{r.DominantHouseName} dominates" : "no house dominates") · loyalty @(100 - r.Unrest)</span></div>
                @foreach (var id in r.SystemIds)
                {
                    var n = nodes[id]; var owner = n.OwnerHouseId != null ? w.House(n.OwnerHouseId) : null;
                    <div class="world-line @(n.IsPlayerTerritory ? "mine" : "") @(id == _focus ? "here" : "")" @onclick="() => _focus = id">
                        <img class="sprite" data-planet="@n.PlanetClass|@n.SystemId|28" alt="" />
                        <span><b>@n.Name</b> <span class="muted">@n.PlanetClass@(n.GovernorName != null ? $" · {n.GovernorName}" : "")</span></span>
                        <span class="holder">@if (owner != null) { <Sigil HouseId="@owner.Id" Accent="@owner.AccentColor" Size="14" /> }<span class="muted">@(owner?.Name ?? "—")</span></span>
                        @if (n.Population > 0) { <span class="pill @(n.Unrest >= 50 ? "warn" : "")">@(100 - n.Unrest)</span> }
                        @if (n.Stations > 0) { <span class="pill small">@n.Stations st</span> }
                    </div>
                }
            </section>
        }
    </aside>
</div>

@code {
    [Parameter] public EventCallback<string> OnFocus { get; set; }
    private ElementReference _host; private readonly string _id = Guid.NewGuid().ToString("N"); private DotNetObjectReference<PlanetsScreen>? _self; private bool _created; private string _pending = "", _sent = ""; private string? _focus;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first) { _self = DotNetObjectReference.Create(this); try { if (await JS.InvokeAsync<bool>("praetoria.ready", "praetoriaSets")) { await JS.InvokeVoidAsync("praetoriaSets.create", "orrery", _id, _host, _self); _created = true; } } catch { } }
        if (_created && _pending != _sent) { _sent = _pending; try { await JS.InvokeVoidAsync("praetoriaSets.build", _id, _pending); } catch { } }
        try { await JS.InvokeVoidAsync("praetoriaFx.paint"); } catch { }
    }
    [JSInvokable] public void OnPlate(string key) { _focus = key; StateHasChanged(); }

    private string BuildOptions(World w, House house, IReadOnlyList<MapRegion> regions, Dictionary<string, MapNode> nodes)
    {
        var list = regions.Select(r => new
        {
            id = r.Id, name = r.Name, accent = r.AccentColor, unrest = r.Unrest,
            worlds = r.SystemIds.Select(id => nodes[id]).Select(n => new { id = n.SystemId, name = n.Name, planetClass = n.PlanetClass, accent = n.OwnerHouseId == null ? "#4a5468" : n.AccentColor, mine = n.IsPlayerTerritory, stations = n.Stations, unrest = n.Unrest }).ToList()
        }).ToList();
        return System.Text.Json.JsonSerializer.Serialize(new { accent = house.AccentColor, regions = list });
    }
    public async ValueTask DisposeAsync() { try { if (_created) await JS.InvokeVoidAsync("praetoriaSets.destroy", _id); } catch { } _self?.Dispose(); }
}
