@inject GameClient G
@using Praetoria.Core.Presentation
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var house = w.House(w.Protagonist!.HouseId)!; var t = c.Trade;
    var mk = m.Market;
    var mover = mk?.Goods.OrderByDescending(g => Math.Abs(g.ChangePct)).FirstOrDefault();
    int wars = w.Wars.Count;

    // The picture (docs/DASHBOARDS.md): on what terms you trade, what is dear and what is cheap against its usual price, and what you own.
    var goods = mk?.Goods ?? (IReadOnlyList<GoodLine>)Array.Empty<GoodLine>();
    static int Against(GoodLine g) => g.Base > 0 ? (int)Math.Round(100 * (g.Price - g.Base) / g.Base) : 0;
    var dearest = goods.OrderByDescending(Against).FirstOrDefault(); var cheapest = goods.OrderBy(Against).FirstOrDefault();
    var lacking = goods.Where(g => g.Held <= 0 && g.NetPerTurn < 0).OrderBy(g => g.NetPerTurn).FirstOrDefault();
    int ventures = m.Businesses?.Count ?? 0, earning = m.Businesses?.Sum(x => x.Earnings) ?? 0, sites = m.Assets?.Projects.Count ?? 0, net = m.Ledger?.Net.Credits ?? 0;
    string terms = mk == null ? "" : mk.OwnMarket ? "through your own market" : "through the caravaneers";
    static string Signed(int n) => (n > 0 ? "+" : n < 0 ? "−" : "") + Math.Abs(n);
    string story, storyTone;
    if (mk == null) { story = "There is no market in this age."; storyTone = ""; }
    else if (mk.Embargoed) { story = "The Senate's embargo closes the exchanges to your house. Nothing may be bought or sold until it lifts."; storyTone = "bad"; }
    else if (lacking != null) { int want = Math.Max(3, -lacking.NetPerTurn * 3); var q = MarketSystem.QuoteBuy(w, t, house.Id, lacking.Id, want);
        story = $"The house burns {-lacking.NetPerTurn} {lacking.Name.ToLowerInvariant()} a year and has none. It stands at {F2(lacking.Price)} a unit, {(Against(lacking) == 0 ? "its usual price" : Signed(Against(lacking)) + "% against its usual price")}: "
            + (q.Refusal != null ? $"buying {want} units {q.Refusal}, and the treasury has {m.Treasury.Credits}." : $"{want} units would cost {q.Credits} credits, and the treasury has {m.Treasury.Credits}."); storyTone = "warn"; }
    else if (mover != null && mover.ChangePct != 0) { story = $"{mover.Name} has moved most: {Signed(mover.ChangePct)}% in five years. {Cap(mover.Cause)}. You trade {terms} at a {mk.SpreadPct}% spread."; storyTone = ""; }
    else { story = $"Prices are steady. You trade {terms} at a {mk.SpreadPct}% spread."; storyTone = ""; }
}
<div class="dash exchange" style="--accent:@m.HouseAccent">
    <header class="dash-head picture">
        <div class="dh-title"><Icon Name="trade_hub" Size="18" /> <b>The Exchange</b>
            <span class="muted">the Reach's markets · prices follow what the houses make, burn and fight over</span></div>
        <p class="headline @storyTone">@story</p>
        <div class="tiles">
            <Tile Label="Credits to trade with" Value="@m.Treasury.Credits.ToString()" Tone="@(m.Treasury.Insolvent ? "bad" : "")" Note="@(net > 0 ? $"+{net} a year coming in" : net < 0 ? $"−{-net} a year going out" : "neither growing nor shrinking")" />
            @if (mk != null)
            {
                <Tile Label="Your terms" Value="@(mk.Embargoed ? "embargoed" : $"{mk.SpreadPct}% spread")" Tone="@(mk.Embargoed ? "bad" : mk.OwnMarket ? "good" : "warn")"
                      Note="@(mk.Embargoed ? "nothing bought or sold until it lifts" : mk.OwnMarket ? "through your own market: the narrow spread" : $"through the caravaneers · a market of your own makes it {c.Market.Rules.SpreadPct}%")" Title="The spread is what you lose between the price you buy at and the price you sell at." />
                @if (dearest != null)
                {
                    <Tile Label="Dearest good" Value="@(Against(dearest) == 0 ? "usual price" : Signed(Against(dearest)) + "%")" Tone="@(Against(dearest) >= 50 ? "warn" : "")"
                          Note="@($"{dearest.Name}: {F2(dearest.Price)} a unit against a usual {F2(dearest.Base)}{(dearest.Held > 0 ? $" · you hold {dearest.Held}" : "")}")" Title="@Cap(dearest.Cause)" />
                }
                @if (cheapest != null && cheapest.Id != dearest?.Id)
                {
                    <Tile Label="Cheapest good" Value="@(Against(cheapest) == 0 ? "usual price" : Signed(Against(cheapest)) + "%")" Tone="@(Against(cheapest) <= -30 ? "good" : "")"
                          Note="@($"{cheapest.Name}: {F2(cheapest.Price)} a unit against a usual {F2(cheapest.Base)}{(cheapest.Held > 0 ? $" · you hold {cheapest.Held}" : "")}")" Title="@Cap(cheapest.Cause)" />
                }
            }
            <Tile Label="Wars in the Reach" Value="@wars.ToString()" Tone="@(wars > 0 ? "warn" : "")" Note="@(wars > 0 ? "each lifts fuel, isotopes, crews and materials" : "peace: yards and magazines are not buying ahead")" />
            <Tile Label="Your ventures" Value="@(ventures == 0 ? "none" : ventures.ToString())" Tone="@(ventures > 0 && earning > 0 ? "good" : "")" Note="@(ventures == 0 ? (sites > 0 ? $"{sites} site(s) being built" : "coin that is not land still counts") : $"{Signed(earning)} a year between them{(sites > 0 ? $" · {sites} site(s) being built" : "")}")" Title="Found, enlarge, buy and sell them on the Ventures tab." />
        </div>
    </header>

    <div class="ex-tabs">
        @foreach (var (id, label, count) in Tabs(m)) { <button class="rung @(_tab == id ? "here" : "")" @onclick="() => _tab = id">@label@(count > 0 ? $" · {count}" : "")</button> }
    </div>

    @if (_tab == "ventures") { <ExchangeVentures Model="m" /> }
    else if (_tab == "projects") { <ExchangeProjects Model="m" OnTab="@(x => _tab = x)" OnGo="OnGo" /> }
    else if (_tab == "shares") { <ExchangeShares Model="m" /> }
    else
    {
    <div class="dash-grid deck-one">
        <div class="deck-col">
        <section class="panel">
            <h3><Icon Name="materials" Size="13" /> Goods <span class="muted">credits a unit · hover a good for what moves it</span></h3>
            @if (mk == null) { <div class="muted">No market in this age.</div> }
            else
            {
                @if (mk.Embargoed) { <div class="flag">The Senate's embargo closes the exchanges to your house. Nothing may be bought or sold until it lifts.</div> }
                else if (!mk.OwnMarket) { <div class="muted small">You have no market of your own and do not hold the capital: the caravaneers carry your orders at a @mk.SpreadPct% spread. A market, a free port or a patronage office narrows it to @c.Market.Rules.SpreadPct%.</div> }
                <table class="standings goods">
                    <thead><tr><th>Good</th><th>Price</th><th title="the last twelve years; the dash is the usual price">12 years</th><th title="the change over five years">5 yrs</th><th title="what the merchants hold">Stock</th><th title="what your house holds, and what it makes or burns a year">Held</th><th>Order</th></tr></thead>
                    <tbody>
                    @foreach (var g in mk.Goods)
                    {
                        int qty = Qty(g.Id);
                        var buy = MarketSystem.QuoteBuy(w, t, house.Id, g.Id, qty); var sell = MarketSystem.QuoteSell(w, t, house.Id, g.Id, qty);
                        bool loud = g.Price >= g.Base * 1.5 || g.Price <= g.Base * 0.7 || g.Deficit >= 15 || g.BuyRefusal != null || Math.Abs(g.ChangePct) >= 10;
                        <tr class="@(g.Price >= g.Base * 1.5 ? "spike" : g.Price <= g.Base * 0.7 ? "slump" : "") @(loud ? "" : "quiet")" title="@Cap(g.Cause)">
                            <td class="hn"><Icon Name="@(Icons.Paths.ContainsKey(g.Id) ? g.Id : "materials")" Size="14" /> <b>@g.Name</b>@if (g.Deficit >= 15) { <span class="pill small warn" title="the Reach needs more than it brings up and is shipped">short @g.Deficit%</span> }</td>
                            <td><b>@F2(g.Price)</b> <span class="muted small">buy @F2(g.BuyUnit) · sell @F2(g.SellUnit)</span></td>
                            <td>@((MarkupString)Spark(g))</td>
                            <td><span class="@(g.ChangePct >= 10 ? "warn" : g.ChangePct <= -10 ? "good" : "muted")">@(g.ChangePct > 0 ? "+" : "")@g.ChangePct%</span></td>
                            <td>@g.Stock</td>
                            <td>@g.Held @if (g.NetPerTurn != 0) { <small class="@(g.NetPerTurn > 0 ? "up" : "down")">@(g.NetPerTurn > 0 ? "+" : "")@g.NetPerTurn</small> }</td>
                            <td class="order">
                                <label class="lot" title="How many units to buy or sell at once. Change it: the buttons show the lot and what it comes to."><small class="muted">lot</small> <input type="number" min="1" max="999" value="@qty" @oninput="e => SetQty(g.Id, e)" /></label>
                                @if (g.CanBuy) { <button class="opt inline tiny" disabled="@(buy.Refusal != null)" title="@(buy.Refusal ?? $"{F2(buy.UnitPrice)} a unit with your order's weight")" @onclick="() => G.Execute(new BuyGoodCommand(pid, g.Id, qty, t))">Buy @qty · @(buy.Credits > 0 ? buy.Credits + " cr" : "—")</button> }
                                @if (g.CanSell) { <button class="opt inline tiny" disabled="@(sell.Refusal != null)" title="@(sell.Refusal ?? $"{F2(sell.UnitPrice)} a unit with your order's weight")" @onclick="() => G.Execute(new SellGoodCommand(pid, g.Id, qty, t))">Sell @qty · @(sell.Refusal == null ? sell.Credits + " cr" : "—")</button> }
                            </td>
                        </tr>
                        @if (loud) { <tr class="cause"><td colspan="7"><span class="muted small">@Cap(g.Cause)@(g.BuyRefusal != null ? " · " + g.BuyRefusal : "")</span></td></tr> }
                    }
                    </tbody>
                </table>
                <details class="orders"><summary>What moves a price</summary>
                <div class="ac-fact"><span>War</span><p>Every war lifts demand for fuel, isotopes, rare earths, crews and materials: yards and magazines buying ahead.</p></div>
                <div class="ac-fact"><span>Siege and revolt</span><p>A blockaded world sends half; a world in revolt sends nothing. If it made much of a good, the price shows it.</p></div>
                <div class="ac-fact"><span>Raiders</span><p>Lawless lanes lose a share of everything that travels them.</p></div>
                <div class="ac-fact"><span>The nations</span><p>Nations at peace ship goods in. War with one closes its ports; a tributary ships double.</p></div>
                <div class="ac-fact"><span>The law</span><p>The Trade Charter taxes or frees every purchase. The Arms Market decides whether isotopes may be bought at all.</p></div>
                <div class="ac-fact"><span>You</span><p>Buy a tenth of the stock and the market notices. Buy half and everyone pays for it next year. An order moves the price against itself by its share of the merchants' stock, so a large one costs more a unit than the quote. Splitting it does not help.</p></div>
                </details>
            }
        </section>

            @if (m.Standing is { } s && s.ExchangeOptions.Count > 0)
            {
                <div class="favours-row" title="Clout (the house's political capital in store) is not a good and has no market. It is bought and sold in private, at a fixed and poor rate. A house with no exchange of its own gets half.">
                    <span class="fr-label"><Icon Name="influence" Size="13" /> Favours for coin</span>
                    @foreach (var o in s.ExchangeOptions) { var rate = c.Holdings.Rates.First(r => $"{r.Give}>{r.Get}" == o.Id); <button class="opt inline" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new ExchangeCommand(pid, rate, c.Holdings))">@o.Label</button> }
                </div>
            }
        </div>
    </div>
    }
</div>

@code {
    private string _tab = "goods";
    // an alert opens this window on its subject (docs/PLAYTHROUGH.md 15): "window:tab", or "window:tab:person"
    [Parameter] public string Tab { get; set; } = "";
    [Parameter] public int TabStamp { get; set; }
    private static int _seenStamp;
    protected override void OnParametersSet() { if (TabStamp != _seenStamp) { _seenStamp = TabStamp; if (Tab.Length > 0) OpenOn(Tab); } }
    private void OpenOn(string tab) { if (tab is "goods" or "projects" or "shares" or "ventures") _tab = tab; }
    private static IEnumerable<(string id, string label, int count)> Tabs(CourtModel m)
    {
        yield return ("goods", "Goods", 0);
        yield return ("ventures", "Ventures", (m.Assets?.Offers.Count ?? 0));
        yield return ("projects", "Projects", m.Assets?.Projects.Count ?? 0);
        yield return ("shares", "Shares", m.Exchange?.Companies.Count ?? 0);
    }
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    [Parameter] public EventCallback<string> OnGo { get; set; }
    private readonly Dictionary<string, int> _qty = new();
    private int Qty(string good) => _qty.TryGetValue(good, out var q) ? q : 5;
    private void SetQty(string good, ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var q)) _qty[good] = Math.Clamp(q, 1, 999); }
    private static string F2(double v) => v.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    /// <summary>A twelve-year price line against the usual price: 120 by 26, the dash at base.</summary>
    private static string Spark(GoodLine g)
    {
        var h = g.History; if (h.Count == 0) return "";
        double lo = Math.Min(h.Min(), g.Base) * 0.9, hi = Math.Max(h.Max(), g.Base) * 1.1; if (hi - lo < 0.01) hi = lo + 0.01;
        double Y(double v) => 24 - (v - lo) / (hi - lo) * 22; double X(int i) => h.Count == 1 ? 118 : 2 + i * 116.0 / (h.Count - 1);
        string pts = string.Join(" ", h.Select((v, i) => $"{F1(X(i))},{F1(Y(v))}"));
        string colour = g.Price >= g.Base * 1.5 ? "#E63946" : g.Price <= g.Base * 0.7 ? "#2EC27E" : "#C9D1DC";
        return $"<svg class=\"spark\" viewBox=\"0 0 120 26\" width=\"120\" height=\"26\" role=\"img\" aria-label=\"price history\"><line x1=\"0\" x2=\"120\" y1=\"{F1(Y(g.Base))}\" y2=\"{F1(Y(g.Base))}\" stroke=\"#5b6577\" stroke-dasharray=\"3 3\" stroke-width=\"1\"/><polyline points=\"{pts}\" fill=\"none\" stroke=\"{colour}\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><circle cx=\"{F1(X(h.Count - 1))}\" cy=\"{F1(Y(h[^1]))}\" r=\"2.4\" fill=\"{colour}\"/></svg>";
    }
}
