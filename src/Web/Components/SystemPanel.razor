@inject GameClient G
@* A solar system, place by place (docs/SYSTEMS.md, docs/BUILDINGS.md): its development first, then the sun, each world with its moons
   under it, and open space. A row is a place: its kind, its feature, its deposit, its building slots as pips (the ones still to be
   opened shown faint) and its one site for a great work as a diamond. One place is open at a time: what stands there and how high it
   may be taken, where its slots come from and what clearing another costs, the buildings that suit it, and the great works its site
   could take. The home world has its own buildings, the ones only a home world takes, and the ordinary ones of its kind.
   With Infrastructure set, the system's own tracks instead: each a row of levels, bought one at a time. *@
@{
    var w = G.World!; var c = G.Content!; var cat = c.Holdings; var sys = w.Galaxy!.System(SystemId); if (sys == null) return;
    var me = w.Protagonist!; var house = w.House(me.HouseId)!; var planet = w.PlanetOf(sys.Id); bool mine = planet?.OwnerId == house.Id;
    var ctx = new CommandContext(w, new Praetoria.Core.Rng.SplitMix64Rng(0));
    if (_for != sys.Id) { _for = sys.Id; _open = -1; }
    // the sun first, then each world with its moons under it, then open space
    var order = new List<int>(); int sun = sys.Bodies.FindIndex(b => b.IsStar); if (sun >= 0) order.Add(sun);
    for (int i = 0; i < sys.Bodies.Count; i++) { if (sys.Bodies[i].IsStar || sys.Bodies[i].IsSpace || sys.Bodies[i].Orbits >= 0) continue; order.Add(i); for (int m = 0; m < sys.Bodies.Count; m++) if (sys.Bodies[m].Orbits == i) order.Add(m); }
    int deep = sys.Bodies.FindIndex(b => b.IsSpace); if (deep >= 0) order.Add(deep);
    var colony = planet == null ? w.Projects.FirstOrDefault(p => p.Kind == Project.Colony && p.TargetId == sys.Id) : null;
    var raising = SystemWorks.Raising(w, cat, house.Id).ToList(); int may = SystemWorks.Capacity(w, cat, house); string standingAs = SystemWorks.StandingName(w, house);
    var rules = cat.Rules; int dev = SystemWorks.Development(w, sys.Id), devLevel = dev / 10, devTop = SystemWorks.DevelopmentCeiling(w, cat, sys.Id), levelMay = SystemWorks.LevelAllowed(w, cat, sys.Id);
    string devParts = string.Join(" · ", SystemWorks.CeilingParts(w, cat, sys.Id).Select(x => x.what + " " + x.points));
    int nextWorld = rules.DevelopmentWorld.Where(l => l > devLevel).DefaultIfEmpty(0).Min(), nextBody = rules.DevelopmentBody.Where(l => l > devLevel).DefaultIfEmpty(0).Min(), nextUp = rules.UpgradeAt.Where(l => l > devLevel).DefaultIfEmpty(0).Min();
    string devNext = (nextWorld > 0 ? "A slot more on the home world at " + nextWorld : "") + (nextBody > 0 ? (nextWorld > 0 ? ", on every other place at " : "A slot more on every other place at ") + nextBody : "") + (nextWorld > 0 || nextBody > 0 ? ". " : "")
        + "Buildings may stand at level " + SystemWorks.Roman(levelMay) + (nextUp > 0 ? "; " + SystemWorks.Roman(levelMay + 1) + " at " + nextUp + "." : ".");
    string devTrend = dev < devTop ? "growing toward " + devTop : dev > devTop ? "more than it can bear: falling toward " + devTop : "as high as it can bear";
}
<div class="sysp" data-system="@sys.Id">
    @if (planet == null)
    {
        var fc = new FoundColonyCommand(me.Id, sys.Id, cat); string? why = fc.Refusal(ctx);
        <div class="sysp-settle">
            @if (colony != null) { <div class="empty-line">@(w.House(colony.OwnerId)?.Name ?? "A house") has a colony on its way here: @colony.TurnsLeft year(s) more.</div> }
            else
            {
                <div class="empty-line">Nobody holds this system. A colony would make its world yours, and every body round its sun yours to build on.</div>
                <button class="opt" disabled="@(why != null)" title="@(why ?? "Ships, settlers and stores: the cost is paid over the years they are on the way.")" @onclick="() => G.Execute(new FoundColonyCommand(me.Id, sys.Id, cat))">Send a colony · @CourtProjection.Bundle(cat.Colony.Cost) · @cat.Colony.BuildTurns years</button>
                @if (why != null) { <div class="muted small">@Cap(why).</div> }
            }
        </div>
    }
    else if (!mine) { <div class="muted small sysp-note">Held by @(w.House(planet.OwnerId)?.Name ?? "another"). What is built here is theirs while they hold the world, and would be yours if you took it.</div> }
    @if (planet != null)
    {
        <div class="sysp-dev" data-development="@dev" title="@($"Development {dev} of 100. It can bear {devTop}: {devParts}. It grows a point a year toward that, two on a prosperous world, and falls under siege or revolt.")">
            <span class="dv-level">@devLevel</span>
            <span class="dv-text"><b>Development</b> <span class="muted">@dev of 100 · @devTrend</span><span class="dv-bar"><i style="@($"width:{dev}%")"></i><u style="@($"left:{devTop}%")"></u></span></span>
        </div>
        <div class="muted small sysp-devnote">@devNext</div>
    }

    @if (Infrastructure)
    {
        <p class="sysp-desc">What the whole system rests on. It belongs to no one world: it is laid a level at a time, each dearer than the last, and the higher levels take years. Every level laid adds @rules.DevPerLevel to the system's development at once, and @rules.DevCeilingPerLevel to how far it can grow.</p>
        @foreach (var t in cat.Infrastructure)
        {
            int level = SystemWorks.Level(w, sys.Id, t.Id); var laying = SystemWorks.Laying(w, sys.Id, t.Id); int next = level + 1; string tid = t.Id;
            string? no = mine && level < t.MaxLevel ? new InvestInfrastructureCommand(me.Id, sys.Id, t.Id, cat).Refusal(ctx) : null;
            <div class="sysp-work infra" data-track="@t.Id">
                @Art(t.Id)
                <div class="sw-text">
                    <div class="sw-head"><b>@t.Name</b> <span class="lv" title="@($"level {level} of {t.MaxLevel}")">@for (int k = 1; k <= t.MaxLevel; k++) { <i class="@(k <= level ? "on" : laying != null && k == next ? "up" : "")"></i> }</span></div>
                    <div class="muted small">@t.Description</div>
                    <div class="sw-does">@TrackDoes(t)</div>
                    @if (laying != null) { <div class="sw-cost"><span>Level @SystemWorks.Roman(next) is being laid: @laying.TurnsLeft year(s) more.</span></div> }
                    else if (level >= t.MaxLevel) { <div class="sw-cost"><span>Carried as far as it goes.</span></div> }
                    else
                    {
                        <div class="sw-cost"><span>Level @SystemWorks.Roman(next) · @CourtProjection.Bundle(t.CostOf(next))@(t.YearsOf(next) > 1 ? $" · {t.YearsOf(next)} years" : "") · development +@rules.DevPerLevel</span>
                            @if (mine) { <button class="opt inline" disabled="@(no != null)" title="@(no != null ? Cap(no) : "")" @onclick="() => G.Execute(new InvestInfrastructureCommand(me.Id, sys.Id, tid, cat))">Lay it</button> }
                        </div>
                        @if (mine && no != null) { <div class="sw-no">@Cap(no)</div> }
                    }
                </div>
            </div>
        }
    }
    else
    {
    @foreach (int i in order)
    {
        var b = sys.Bodies[i]; var feat = b.Feature.Length > 0 ? cat.Feature(b.Feature) : null; bool world = b.IsPrimary && planet != null;
        var standing = SystemWorks.On(w, sys.Id, i).Select(x => cat.Work(x.DefId)).Where(d => d != null).Select(d => d!).ToList(); var rising = SystemWorks.Underway(w, sys.Id, i).ToList();
        string? siteId = SystemWorks.Site(w, cat, sys.Id, i); var great = siteId != null ? cat.Work(siteId) : null; bool greatRising = great != null && !standing.Contains(great);
        // the home world: the holding's own buildings share its slots with what is raised on it
        var hb = world ? planet!.Buildings.Select(id => cat.Building(id)).Where(x => x != null).Select(x => x!).ToList() : new List<BuildingDef>();
        var hbRising = world ? w.Projects.Where(p => p.Kind == Project.Building && p.TargetId == planet!.Id).ToList() : new List<Project>();
        string target = SystemWorks.Target(sys.Id, i); var upgrading = w.Projects.Where(p => p.Kind == Project.Upgrade && (p.TargetId == target || (world && p.TargetId == planet!.Id))).ToList();
        int slots = SystemWorks.Slots(w, cat, sys, i), most = b.IsStar ? 0 : b.IsPrimary ? rules.MaxWorld : rules.MaxBody;
        int used = hb.Count + standing.Count(d => !d.IsMegastructure), up = hbRising.Count + rising.Count(p => cat.Work(p.DefId)?.IsMegastructure != true);
        var parts = SystemWorks.SlotParts(w, cat, sys, i).ToList(); string partsLine = string.Join(" · ", parts.Select(x => x.what + " " + x.slots));
        bool open = _open == i; int idx = i; int px = b.IsStar || b.IsPrimary ? 30 : b.Orbits >= 0 ? 16 : 18 + b.Size * 4;
        string sprite = $"{b.Class}|{sys.Id}{b.Name}|{px}";
        <div class="sysp-body @(open ? "open" : "") @(b.Orbits >= 0 ? "moon" : "") @(b.IsStar ? "star" : "") @(b.IsSpace ? "space" : "") @(world ? "home" : "")" data-body="@b.Class">
            <button class="sysp-row" @onclick="() => _open = _open == idx ? -1 : idx" title="@(feat?.Description ?? Kind(b))">
                @if (b.IsSpace) { <span class="sprite deep" aria-hidden="true"></span> } else { <img class="sprite" data-planet="@sprite" alt="" /> }
                <span class="sysp-name"><b>@b.Name</b><span class="muted">@Kind(b)@(b.IsPrimary ? " · the home world" : "")</span></span>
                <span class="sysp-marks">
                    @if (feat != null) { <span class="pill small feat">@feat.Name</span> }
                    @if (b.Deposit.Length > 0) { <span class="pill small dep" title="@($"A {Resource.Label(b.Deposit)} deposit: richness {sys.Deposit(b.Deposit)}")">@Resource.Label(b.Deposit) @(new string('●', sys.Deposit(b.Deposit)))</span> }
                    <span class="sysp-slots" title="@(most == 0 ? "No building slots: only a great work can be raised here" : $"Building slots: {used} built · {up} rising · {slots} open of {most} at the most. From: {partsLine}.")">@for (int k = 0; k < Math.Max(slots, most); k++) { <i class="@(k < used ? "on" : k < used + up ? "up" : k >= slots ? "lock" : "")"></i> }</span>
                    <span class="sysp-site @(great == null ? "" : greatRising ? "up" : "on")" title="@(great == null ? "The site for a great work: free" : greatRising ? $"{great.Name} is rising on its site" : $"{great.Name} stands on its site")">◆</span>
                </span>
            </button>
            @if (!open && (standing.Count > 0 || rising.Count > 0 || hb.Count > 0 || hbRising.Count > 0))
            {
                <div class="sysp-built">
                    @foreach (var d in hb) { int lv = planet!.LevelOf(d.Id); <span class="built" title="@BuildingDoes(d, lv)">@d.Name@(lv > 1 ? " " + SystemWorks.Roman(lv) : "")</span> }
                    @foreach (var p in hbRising) { <span class="built up">@(cat.Building(p.DefId)?.Name ?? p.DefId) · @p.TurnsLeft y</span> }
                    @foreach (var x in SystemWorks.On(w, sys.Id, i)) { var d = cat.Work(x.DefId); if (d == null) continue; <span class="built @(d.IsMegastructure ? "great" : "")" title="@(d.Description + " " + Does(d, sys, x.Level))">@d.Name@(x.Level > 1 ? " " + SystemWorks.Roman(x.Level) : "")</span> }
                    @foreach (var p in rising) { <span class="built up @(cat.Work(p.DefId)?.IsMegastructure == true ? "great" : "")" title="@($"{Bundle(ProjectSystem.Remaining(p))} still to pay")">@(cat.Work(p.DefId)?.Name ?? p.DefId) · @p.TurnsLeft y@(p.Hastened ? " · hastened" : "")</span> }
                </div>
            }
            @if (open)
            {
                <div class="sysp-open">
                    @if (feat != null) { <p class="sysp-desc">@feat.Description</p> }
                    @if (b.IsSpace) { <p class="sysp-desc">The dark between the worlds. What is built here is tied to no body: stations on the approaches, and the greatest works of all.</p> }
                    @if (world) { <p class="sysp-desc">The home world: where the system's people live and its holder sits. It takes its own buildings, some that only a home world takes, and the ordinary ones of its kind, all in the same slots.</p> }
                    @if (world && planet!.Provinces.Count > 0)
                    {
                        var over = ProvinceSystem.Over(w, planet); string hid3 = planet.Id; string ownerName = mine ? "Your house" : w.House(planet.OwnerId)?.Name ?? "A house";
                        <h5 class="sysp-h prov">Provinces <span class="muted">three to a world · each held by a house, for life</span></h5>
                        @if (planet.Provinces[0].SettledUntil > w.Turn) { <div class="muted small">A peace holds the world its holder's until year @planet.Provinces[0].SettledUntil.</div> }
                        <div class="muted small sysp-over">@ownerName holds the world, and its seat with it. @(over == null ? "Nobody stands over it." : (over.Id == house.Id ? "You stand" : over.Name + " stands") + " over it, and may ask it to make way.")</div>
                        @for (int pi = 0; pi < planet.Provinces.Count; pi++)
                        {
                            var pv = planet.Provinces[pi]; var pf = cat.Provinces.Focus(pv.Focus); string holderId = ProvinceSystem.HolderOf(planet, pi); bool pmine = holderId == house.Id; int pidx = pi;
                            var pending = w.SeatDemands.FirstOrDefault(d => d.HoldingId == planet.Id && d.Province == pidx);
                            string? ino = pmine && pv.Level < rules.MaxLevel ? new ImproveProvinceCommand(me.Id, planet.Id, pi, cat).Refusal(ctx) : null;
                            string giveTo = _giveTo.TryGetValue(planet.Id + "#" + pi, out var gt) ? gt : house.Id; string? dno = mine && pi > 0 && !pmine ? new DemandSeatCommand(me.Id, planet.Id, pi, giveTo, cat).Refusal(ctx) : null;
                            string? wno = pi == 0 && over?.Id == house.Id && !mine ? new DemandSeatCommand(me.Id, planet.Id, 0, WorldFor(planet, giveTo), cat).Refusal(ctx) : null;
                            bool atWar = !pmine && pi > 0 && w.AtWar(holderId, planet.OwnerId);
                            <div class="sysp-prov @(pmine ? "mine" : "") @(atWar ? "war" : "")" data-province="@pv.Focus" data-holder="@holderId">
                                @{ int pslots = ProvinceSystem.Slots(w, cat, planet, pi), pbuilt = pv.Buildings.Count, prising = ProvinceSystem.Rising(w, planet, pi); var owed = ProvinceSystem.Dues(w, cat, planet, pi); var pyield = ProvinceSystem.Yield(w, cat, planet, pv); }
                                <div class="sw-head"><b>@pv.Name</b> @LevelPips(pv.Level) <span class="muted small">@(pf?.Name ?? pv.Focus)</span>
                                    @if (pi > 0) { <span class="sysp-slots" title="@($"Building slots of the province: {pbuilt} built · {prising} rising · {pslots} open of {cat.Provinces.SlotMax} at the most. One to begin with; more by the system's development and the rank of the house that holds the province.")">@for (int k = 0; k < Math.Max(pslots, cat.Provinces.SlotMax); k++) { <i class="@(k < pbuilt ? "on" : k < pbuilt + prising ? "up" : k >= pslots ? "lock" : "")"></i> }</span> }
                                </div>
                                <div class="sw-does">@(pmine ? "Yours" : w.House(holderId)?.Name ?? "nobody's")@(pi > 0 && holderId != planet.OwnerId ? (pv.Since > 0 ? " since year " + pv.Since : ", for life") : pi == 0 ? ", with the world" : "") · @(pyield.IsEmpty() ? "pays nothing" : "+" + CourtProjection.Bundle(pyield) + " a year")@(pf != null && pf.Defense > 0 ? " · defence +" + (pf.Defense * Math.Max(1, pv.Level)).ToString("0.##") : "")@(atWar ? " · withheld: its house is at war with the holder of the world" : "")</div>
                                @if (pi > 0 && holderId != planet.OwnerId && !atWar)
                                {
                                    string overName = mine ? "you" : w.House(planet.OwnerId)?.Name ?? "the holder of the world"; bool warNow = w.EnemiesOf(planet.OwnerId).Any(); int squad = cat.Provinces.LevySquadron * Math.Max(1, pv.Level); string dkey = planet.Id;
                                    <div class="muted small sysp-owes">
                                        @if (pv.Withheld) { <span class="warnline">@(pmine ? "You are withholding" : "It is withholding") the dues. Nothing is paid, no levy is sent, and @overName may ask for the province at no cost. It ends when @(pmine ? "you pay" : "the holder pays") again of @(pmine ? "your" : "its") own accord, when the province changes hands, or when the two houses fight over it and make peace (the peace settles it for @cat.Provinces.SettleYears years).</span> }
                                        else if (pv.EasedUntil > w.Turn) { <span>Its dues are commuted until year @pv.EasedUntil: nothing is owed, no levy is sent, and @(pmine ? "your house is expected to lean" : "it leans") @overName's way in the Senate the more for it.</span> }
                                        else if (pv.Dues <= ProvinceSystem.Forgiven) { <span>Its dues are forgiven: nothing is owed, no levy is sent, and @(pmine ? "your house is expected to lean" : "it leans") @overName's way in the Senate the more for it.</span> }
                                        else { <span>@(pmine ? "You owe" : "It owes") @overName @(owed.IsEmpty() ? "nothing this year" : Bundle(owed) + " a year") (@ProvinceSystem.DuesName(pv.Dues) dues)@(warNow ? ", levy included, and a squadron of " + squad + " under one of " + (pmine ? "your" : "its") + " own officers sails for " + (mine ? "you" : "that house") + " until the peace" : "; in a war of " + (mine ? "yours" : "that house's") + ", a levy too and a squadron of " + squad)@(pv.Dues >= ProvinceSystem.Heavy ? ". Heavy dues buy no voice in the Senate." : ", and " + (pmine ? "your house is expected to lean" : "it leans") + " that way in the Senate.")</span> }
                                    </div>
                                    @if (mine && !pmine)
                                    {
                                        <div class="sw-cost sysp-dues"><span>Its dues</span><span class="seg">
                                            @foreach (var dv in new[] { ProvinceSystem.Forgiven, ProvinceSystem.Customary, ProvinceSystem.Heavy })
                                            {
                                                int dvv = dv; string? duno = new SetDuesCommand(me.Id, planet.Id, pi, dv).Refusal(ctx); bool cur = pv.Dues == dv;
                                                <button class="opt inline tiny @(cur ? "on" : "")" disabled="@(duno != null)" title="@(dv == ProvinceSystem.Forgiven ? "Nothing is paid; it leans your way the more." : dv == ProvinceSystem.Heavy ? "Twice the dues; it leans nowhere, and a house that is your match may stop paying." : "The tithe, the levy in war, and its voice.")" @onclick="() => G.Execute(new SetDuesCommand(me.Id, dkey, pidx, dvv))">@ProvinceSystem.DuesName(dv)</button>
                                            }
                                        </span></div>
                                    }
                                    @if (pv.SettledUntil > w.Turn) { <div class="muted small">Settled by a peace: it may not be asked for, nor its dues made heavy, until year @pv.SettledUntil.</div> }
                                    @if ((pmine || mine) && !pv.Withheld && pv.EasedUntil <= w.Turn && pv.Dues > ProvinceSystem.Forgiven)
                                    {
                                        string? cno = new CommuteDuesCommand(me.Id, planet.Id, pi, cat).Refusal(ctx); var ccost = ProvinceSystem.CommuteCost(cat, pv);
                                        <div class="sw-cost"><span>Commute the dues: @Bundle(ccost) @(pmine ? "from you" : "to you") now, nothing owed for @cat.Provinces.CommuteTerm years</span>
                                            <button class="opt inline" disabled="@(cno != null)" title="@(cno != null ? Cap(cno) : pmine ? "No tithe, no levy and no squadron for the term. Their side has agreed." : "They pay now and owe nothing for the term: no tithe, no levy, no squadron.")" @onclick="() => G.Execute(new CommuteDuesCommand(me.Id, dkey, pidx, cat))">@(pmine ? "Commute" : "Offer")</button>
                                        </div>
                                        @if (cno != null && !cno.StartsWith("needs")) { <div class="sw-no">@Cap(cno)</div> }
                                    }
                                    @if (pmine && ProvinceSystem.DuesOf(w, pv) > ProvinceSystem.Forgiven)
                                    {
                                        bool wh = pv.Withheld; string? whno = new WithholdDuesCommand(me.Id, planet.Id, pi, !wh).Refusal(ctx);
                                        <div class="sw-cost"><span>@(wh ? "Pay what is owed again" : "Refuse to pay")</span><button class="opt inline @(wh ? "" : "warn")" disabled="@(whno != null)" title="@(wh ? "The dues, the levy and your voice are theirs again." : "You keep what you owe. " + overName + " may ask you to give up the province at no cost, and if it is your match it will.")" @onclick="() => G.Execute(new WithholdDuesCommand(me.Id, dkey, pidx, !wh))">@(wh ? "Pay again" : "Withhold the dues")</button></div>
                                    }
                                }
                                @if (pv.Buildings.Count > 0 || prising > 0)
                                {
                                    string ptarget = ProvinceSystem.Target(planet.Id, pi); var pup = w.Projects.Where(x => x.Kind == Project.Upgrade && x.TargetId == ptarget).ToList();
                                    @if (pmine)
                                    {
                                        @foreach (var bid in pv.Buildings)
                                        {
                                            var bd = cat.Work(bid); if (bd == null) continue; int blv = pv.LevelOf(bid);
                                            <div class="sysp-work stands">@Art(bd.Id)<div class="sw-text"><div class="sw-head"><b>@bd.Name</b> @LevelPips(blv) <span class="muted small">stands</span></div><div class="sw-does">@Does(bd, sys, blv)</div>@UpgradeLine(ptarget, bd.Id, bd.Cost, bd.BuildTurns, blv, true, pup, ctx)</div></div>
                                        }
                                    }
                                    <div class="sysp-built prov">
                                        @if (!pmine) { @foreach (var bid in pv.Buildings) { var bd = cat.Work(bid); if (bd == null) continue; int blv = pv.LevelOf(bid); <span class="built" title="@(bd.Description + " " + Does(bd, sys, blv))">@bd.Name@(blv > 1 ? " " + SystemWorks.Roman(blv) : "")</span> } }
                                        @foreach (var pp in w.Projects.Where(x => x.Kind == Project.ProvinceWork && x.TargetId == ptarget)) { <span class="built up">@(cat.Work(pp.DefId)?.Name ?? pp.DefId) · @pp.TurnsLeft y</span> }
                                        @foreach (var pp in pup) { <span class="built up">@Cap(pp.Name) · @pp.TurnsLeft y</span> }
                                    </div>
                                }
                                @if (pmine && pi > 0)
                                {
                                    var pfits = cat.Works.Where(d => ProvinceSystem.Suits(cat, sys, pv, d) && !pv.Buildings.Contains(d.Id) && !w.Projects.Any(x => x.Kind == Project.ProvinceWork && x.TargetId == ProvinceSystem.Target(planet.Id, pidx) && x.DefId == d.Id)).OrderByDescending(d => d.Deposit.Length > 0).ThenBy(d => d.Cost.Credits + d.Cost.Materials).ToList();
                                    bool showAll = _provOpen == planet.Id + "#" + pi; string key = planet.Id + "#" + pi;
                                    <div class="sw-cost"><span>@(pslots - pbuilt - prising > 0 ? (pslots - pbuilt - prising) + " of " + pslots + " slot" + (pslots == 1 ? "" : "s") + " free" : "No slot free") · @pfits.Count building@(pfits.Count == 1 ? "" : "s") would suit it</span>
                                        @if (pfits.Count > 0) { <button class="opt inline" @onclick="() => _provOpen = showAll ? null : key">@(showAll ? "Close" : "Build…")</button> }
                                    </div>
                                    @if (showAll)
                                    {
                                        @foreach (var d in pfits)
                                        {
                                            string? bno = new BuildInProvinceCommand(me.Id, planet.Id, pi, d.Id, cat).Refusal(ctx); string bdid = d.Id;
                                            <div class="sysp-work" data-work="@d.Id">
                                                @Art(d.Id)
                                                <div class="sw-text">
                                                    <div class="sw-head"><b>@d.Name</b></div>
                                                    <div class="sw-does">@Does(d, sys)</div>
                                                    <div class="sw-cost"><span>@CourtProjection.Bundle(d.Cost)@(d.BuildTurns > 1 ? $" · {d.BuildTurns} years" : "")</span>
                                                        <button class="opt inline" disabled="@(bno != null)" title="@(bno != null ? Cap(bno) : "")" @onclick="() => G.Execute(new BuildInProvinceCommand(me.Id, hid3, pidx, bdid, cat))">@(d.BuildTurns > 1 ? "Begin" : "Build")</button>
                                                    </div>
                                                    @if (bno != null) { <div class="sw-no">@Cap(bno)</div> }
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                                @if (mine && pi > 0 && !pmine && pending == null)
                                {
                                    <div class="sw-cost"><span>Ask them to step down, for <select class="sysp-pick" @onchange="e => SetGive(hid3, pidx, e)">
                                            <option value="@house.Id" selected="@(giveTo == house.Id)">your own house</option>
                                            @foreach (var oh in w.Houses.Values.Where(x => !World.Outsider(x.Id) && x.Id != house.Id && x.Id != holderId).OrderBy(x => x.Name)) { <option value="@oh.Id" selected="@(giveTo == oh.Id)">@oh.Name</option> }
                                        </select> · @cat.Provinces.DemandInfluence influence</span>
                                        <button class="opt inline" disabled="@(dno != null)" title="@(dno != null ? Cap(dno) : "It was theirs for life. A house that cannot hope to win steps down; one that can, fights.")" @onclick="() => G.AskSeat(planet, pidx, giveTo)">Ask</button>
                                    </div>
                                    @if (dno != null) { <div class="sw-no">@Cap(dno)</div> }
                                }
                                @if (pi == 0 && over?.Id == house.Id && !mine && pending == null)
                                {
                                    string wfor = WorldFor(planet, giveTo);
                                    <div class="sw-cost"><span>Ask its holder to make way for <select class="sysp-pick" @onchange="e => SetGive(hid3, pidx, e)">
                                            @for (int k = 1; k < planet.Provinces.Count; k++) { string kh = ProvinceSystem.HolderOf(planet, k); if (kh == planet.OwnerId) continue; <option value="@kh" selected="@(wfor == kh)">@(kh == house.Id ? "your own house" : w.House(kh)?.Name ?? kh)</option> }
                                        </select> · @cat.Provinces.DemandInfluenceWorld influence</span>
                                        <button class="opt inline" disabled="@(wno != null)" title="@(wno != null ? Cap(wno) : "The world was theirs for life. They step down and hold a province under the house that rises, or they fight you.")" @onclick="() => G.AskSeat(planet, 0, wfor)">Ask</button>
                                    </div>
                                    @if (wno != null) { <div class="sw-no">@Cap(wno)</div> }
                                }
                                @if (pending != null)
                                {
                                    string did2 = pending.Id; string asker = w.House(pending.ById)?.Name ?? "A house"; string forWhom = pending.ForId == pending.ById ? "itself" : pending.ForId == house.Id ? "you" : w.House(pending.ForId)?.Name ?? "another";
                                    @if (pending.AgainstId == house.Id)
                                    {
                                        <div class="sysp-demand">
                                            <div><b>@asker asks you to give this up</b>, for @forWhom. It was yours for life. @(pi == 0 ? "Step down, and you hold a province under the house that rises, your name is the less for it and your house a rung the lower. Stand, and it is war with " + asker + "." : "Step down and it is gone. Stand, and it is war with " + asker + ".") Left unanswered for a year, it is taken for defiance, and that too is war.</div>
                                            <div class="row small"><button class="opt inline" @onclick="() => G.Execute(new AnswerSeatDemandCommand(me.Id, did2, true, cat))">Step down</button><button class="opt inline warn" @onclick="() => G.Execute(new AnswerSeatDemandCommand(me.Id, did2, false, cat))">Stand, and fight</button></div>
                                        </div>
                                    }
                                    else { <div class="muted small">@asker has asked for it, for @forWhom. No answer yet.</div> }
                                }
                            </div>
                        }
                    }

                    @* what stands here, and how high it may be taken *@
                    @foreach (var d in hb)
                    {
                        int lv = planet!.LevelOf(d.Id);
                        <div class="sysp-work stands">@Art(d.Id)<div class="sw-text"><div class="sw-head"><b>@d.Name</b> @LevelPips(lv) <span class="muted small">stands</span></div><div class="sw-does">@BuildingDoes(d, lv)</div>@UpgradeLine(planet.Id, d.Id, d.Cost, d.BuildTurns, lv, mine, upgrading, ctx)</div></div>
                    }
                    @foreach (var x in SystemWorks.On(w, sys.Id, i).ToList())
                    {
                        var d = cat.Work(x.DefId); if (d == null) continue; int lv = Math.Max(1, x.Level);
                        <div class="sysp-work stands @(d.IsMegastructure ? "mega" : "")">@Art(d.Id)<div class="sw-text"><div class="sw-head"><b>@d.Name</b> @if (!d.IsMegastructure) { @LevelPips(lv) } <span class="muted small">@(d.IsMegastructure ? "great work · stands" : "stands")</span></div><div class="sw-does">@Does(d, sys, lv)</div>@if (!d.IsMegastructure) { @UpgradeLine(target, d.Id, d.Cost, d.BuildTurns, lv, mine, upgrading, ctx) }</div></div>
                    }
                    @foreach (var p in hbRising.Concat(rising))
                    {
                        bool isGreat = SystemWorks.IsGreat(cat, p); string pid = p.Id; bool hastened = p.Hastened; var hd = ProjectSystem.HastenDue(p, rules.HastenPct); var both = hd.due.Clone(); foreach (var r in Resource.All) both.Add(r, hd.extra.Get(r));
                        string? hno = isGreat && mine ? new HastenWorkCommand(me.Id, p.Id, !p.Hastened, cat).Refusal(ctx) : null;
                        <div class="sysp-work stands up" data-rising="@p.DefId">@Art(p.DefId)<div class="sw-text"><div class="sw-head"><b>@Cap(p.Name)</b> <span class="muted small">@(p.Stalled ? "stalled: the purse could not pay" : hastened ? "rising · hastened" : "rising")</span></div><div class="sw-does">@p.TurnsLeft of @p.TurnsTotal year(s) to go · @Bundle(ProjectSystem.Remaining(p)) still to pay@(p.Paused ? " · paused" : "")</div>
                            @if (p.OwnerId == me.HouseId && p.CompanyId.Length == 0)
                            {
                                string? rushNo = new RushProjectCommand(me.Id, pid).Refusal(ctx); int rushMore = ProjectSystem.RushPremium(w, p); string? payNo = p.Stalled ? new PayInstalmentCommand(me.Id, pid).Refusal(ctx) : null;
                                <div class="suit-acts" data-site="@pid">
                                    <button class="opt inline tiny" @onclick="() => G.Execute(new PauseProjectCommand(me.Id, pid))">@(p.Paused ? "Resume" : "Pause")</button>
                                    @if (p.Stalled) { <button class="opt inline tiny" disabled="@(payNo != null)" title="@(payNo ?? "Pay the instalment that was missed now: the work goes on and the lost year is made up")" @onclick="() => G.Execute(new PayInstalmentCommand(me.Id, pid))">Pay the instalment now · @Bundle(ProjectSystem.NextInstalment(p))</button> }
                                    @if (!isGreat && p.TurnsLeft > 1) { <button class="opt inline tiny" disabled="@(rushNo != null)" title="@(rushNo != null ? Cap(rushNo) : "Everything still owed is paid now, and " + rushMore + " credits more for the haste: it is done next year")" @onclick="() => G.Execute(new RushProjectCommand(me.Id, pid))">Rush · @Bundle(ProjectSystem.Remaining(p)) and @rushMore credits more</button> }
                                    <button class="opt inline tiny" title="half of what was paid comes back" @onclick='() => G.AskDo("Abandon " + p.Name + "?", "The site is cleared. Of the " + Bundle(p.Paid) + " paid so far, " + Bundle(ProjectSystem.Refund(p)) + " comes back and the rest is lost.", "Abandon it", new AbandonProjectCommand(me.Id, pid))'>Abandon · get back @Bundle(ProjectSystem.Refund(p))</button>
                                </div>
                            }
                            @if (isGreat && mine && p.TurnsLeft > 1)
                            {
                                <div class="sw-cost"><span>@(hastened ? "Hastened: two years' work in one. This year " + Bundle(both) + " (" + Bundle(hd.extra) + " of it for the speed)." : "Hasten it: two years' work in one, for " + Bundle(both) + " a year (" + Bundle(hd.extra) + " of it for the speed), every year it is hastened.")</span>
                                    <button class="opt inline" disabled="@(hno != null)" title="@(hno != null ? Cap(hno) : "A year the purse cannot stand it, the work goes at its own pace.")" @onclick="() => G.Execute(new HastenWorkCommand(me.Id, pid, !hastened, cat))">@(hastened ? "Stop hastening" : "Hasten")</button>
                                </div>
                            }
                        </div></div>
                    }
                    @foreach (var p in upgrading) { <div class="sysp-work stands up">@Art(p.DefId)<div class="sw-text"><div class="sw-head"><b>@Cap(p.Name)</b> <span class="muted small">a level higher</span></div><div class="sw-does">@p.TurnsLeft of @p.TurnsTotal year(s) to go · @Bundle(ProjectSystem.Remaining(p)) still to pay</div></div></div> }

                    @* buildings: in the slots *@
                    @if (most > 0)
                    {
                        int cleared = SystemWorks.Cleared(w, sys.Id, i), clearMost = b.IsPrimary ? rules.ClearMaxWorld : rules.ClearMaxBody; string? cno = mine ? new ClearSlotCommand(me.Id, sys.Id, i, cat).Refusal(ctx) : null; string sid2 = sys.Id;
                        <h5 class="sysp-h">Buildings <span class="muted">@Math.Max(0, slots - used - up) of @slots slot@(slots == 1 ? "" : "s") free · @most at the most</span></h5>
                        <div class="sysp-parts" data-slots="@slots">
                            @foreach (var part in parts) { <span><b>@part.slots</b> @part.what</span> }
                        </div>
                        @if (mine && cleared < clearMost && slots < most)
                        {
                            <div class="sw-cost sysp-clear"><span>Clear ground for another slot · @Bundle(rules.ClearCostOf(cleared)) <span class="muted">(@cleared of @clearMost cleared; each dearer than the last)</span></span>
                                <button class="opt inline" disabled="@(cno != null)" title="@(cno != null ? Cap(cno) : "Paid at once: the slot is open this year.")" @onclick="() => G.Execute(new ClearSlotCommand(me.Id, sid2, idx, cat))">Clear</button>
                            </div>
                        }
                        @if (slots - used - up < 0) { <div class="sw-no">More stands here than its slots now allow: nothing new can be built until there is room again.</div> }
                        @if (world)
                        {
                            var wfits = cat.Buildings.Where(x => x.FitsSpecialization(planet!.Specialization) && !planet.Buildings.Contains(x.Id) && !hbRising.Any(p => p.DefId == x.Id) && (x.RequiresDeposit == null || sys.Deposit(x.RequiresDeposit) > 0)).OrderBy(x => x.Cost.Credits + x.Cost.Materials).ToList();
                            var homeOnly = cat.Works.Where(d => !d.IsMegastructure && d.On == "world" && SystemWorks.Suits(sys, b, d) && !standing.Any(x => x.Id == d.Id) && !rising.Any(p => p.DefId == d.Id)).OrderBy(d => d.Cost.Credits + d.Cost.Materials).ToList();
                            var ordinary = cat.Works.Where(d => !d.IsMegastructure && d.On != "world" && SystemWorks.Suits(sys, b, d) && !standing.Any(x => x.Id == d.Id) && !rising.Any(p => p.DefId == d.Id)).OrderByDescending(d => d.Deposit.Length > 0).ThenBy(d => d.Cost.Credits + d.Cost.Materials).ToList();
                            @if (homeOnly.Count > 0) { <h6 class="sysp-sub">Only on a home world</h6> }
                            @foreach (var d in homeOnly) { @WorkRow(d, sys, idx, mine, ctx) }
                            @if (wfits.Count > 0) { <h6 class="sysp-sub">The world's own · @(cat.Spec(planet!.Specialization)?.Name ?? planet.Specialization)</h6> }
                            @foreach (var d in wfits)
                            {
                                string? no = mine ? new BuildCommand(me.Id, planet!.Id, d.Id, cat, c.Titles).Refusal(ctx) : null; string did = d.Id; string hid = planet!.Id;
                                <div class="sysp-work">
                                    @Art(d.Id)
                                    <div class="sw-text">
                                        <div class="sw-head"><b>@d.Name</b></div>
                                        <div class="sw-does">@BuildingDoes(d, 1)</div>
                                        <div class="sw-cost"><span>@CourtProjection.Bundle(d.Cost)@(d.BuildTurns > 1 ? $" · {d.BuildTurns} years" : "")</span>
                                            @if (mine) { <button class="opt inline" disabled="@(no != null)" title="@(no != null ? Cap(no) : "")" @onclick="() => G.Execute(new BuildCommand(me.Id, hid, did, cat, c.Titles))">@(d.BuildTurns > 1 ? "Begin" : "Build")</button> }
                                        </div>
                                        @if (mine && no != null) { <div class="sw-no">@Cap(no)</div> }
                                    </div>
                                </div>
                            }
                            @if (ordinary.Count > 0) { <h6 class="sysp-sub">Ordinary buildings · @Kind(b)</h6> }
                            @foreach (var d in ordinary) { @WorkRow(d, sys, idx, mine, ctx) }
                            @if (homeOnly.Count + wfits.Count + ordinary.Count == 0) { <div class="muted small">Everything that suits this world stands.</div> }
                        }
                        else
                        {
                            var fits = cat.Works.Where(d => !d.IsMegastructure && SystemWorks.Suits(sys, b, d) && !standing.Any(x => x.Id == d.Id) && !rising.Any(p => p.DefId == d.Id)).OrderByDescending(d => d.Deposit.Length > 0).ThenBy(d => d.Cost.Credits + d.Cost.Materials).ToList();
                            @if (fits.Count == 0) { <div class="muted small">Every building that suits it stands.</div> }
                            @foreach (var d in fits) { @WorkRow(d, sys, idx, mine, ctx) }
                        }
                    }

                    @* the one site: a great work *@
                    @{ var greats = cat.Works.Where(d => d.IsMegastructure && SystemWorks.Suits(sys, b, d)).OrderByDescending(d => d.Feature.Length > 0).ThenBy(d => d.Cost.Credits + d.Cost.Materials).ToList(); }
                    @if (greats.Count > 0 || great != null)
                    {
                        <h5 class="sysp-h great">Great work <span class="muted">@(great != null ? (greatRising ? "the site is taken: it is rising" : "the site is taken") : "one site, for one of these · years in the raising")</span></h5>
                        @if (great == null)
                        {
                            @if (mine) { <div class="muted small sysp-cap" data-capacity="@may">The house is raising @raising.Count of the @may great work@(may == 1 ? "" : "s") @standingAs may raise at a time@(raising.Count > 0 ? ": " + string.Join(", ", raising.Select(p => p.Name)) : "").</div> }
                            @foreach (var d in greats) { @WorkRow(d, sys, idx, mine, ctx) }
                        }
                    }
                    @if (most == 0 && greats.Count == 0 && great == null) { <div class="muted small">Nothing can be built here.</div> }
                </div>
            }
        </div>
    }
    }
</div>

@code {
    [Parameter] public string SystemId { get; set; } = "";
    /// <summary>Show the system's infrastructure and not its bodies.</summary>
    [Parameter] public bool Infrastructure { get; set; }
    private int _open = -1; private string? _for;
    /// <summary>The painting of a thing, where it has one; an empty plate of the same size where it has not.</summary>
    private RenderFragment Art(string id) => __builder =>
    {
        if (G.WorkPicture(id) is { } src) { <img class="sw-art" src="@src" alt="" loading="lazy" /> } else { <span class="sw-art none" aria-hidden="true"></span> }
    };
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    private static string Bundle(Resources r) => r.IsEmpty() ? "nothing" : CourtProjection.Bundle(r);
    private static string Kind(Body b) => b.Class switch
    {
        "star" => "the sun", "space" => "tied to no world", "moon" => "moon", "comet" => "comet", "belt" => "asteroid belt", "gas" => "gas giant", "terran" => "living world", "ocean" => "ocean world",
        "arid" => "arid world", "forge" => "forge world", "frozen" => b.Size <= 1 ? "ice dwarf" : "frozen world", "barren" => b.Size <= 1 ? "rock" : "dead world", _ => b.Class
    };
    private static string Category(WorkDef d) => d.Feature.Length > 0 ? "only here" : d.Limit == WorkDef.PerGalaxy ? "one in the galaxy" : d.Limit == WorkDef.PerHouse ? "one to a house" : d.Limit == WorkDef.PerSystem ? "one to a system" : d.IsMegastructure ? "great work" : d.Category switch
    {
        WorkDef.Colony => "colony", WorkDef.Extraction => "extraction", WorkDef.Military => "military", _ => "civil"
    };

    private readonly Dictionary<string, string> _giveTo = new(); private string? _provOpen;
    private void SetGive(string holdingId, int index, ChangeEventArgs e) { _giveTo[holdingId + "#" + index] = e.Value?.ToString() ?? string.Empty; }
    /// <summary>Whom a world is asked for: the choice made, if that house holds a province of it; else the first that does.</summary>
    private static string WorldFor(Holding planet, string chosen)
    {
        if (ProvinceSystem.ProvinceOf(planet, chosen) > 0) return chosen;
        for (int k = 1; k < planet.Provinces.Count; k++) { string kh = ProvinceSystem.HolderOf(planet, k); if (kh != planet.OwnerId) return kh; }
        return chosen;
    }
    private static string ProvinceDoes(ProvinceFocus? f, int level)
    {
        if (f == null) return string.Empty; var y = new Resources(); foreach (var r in Resource.All) y.Set(r, f.Yield.Get(r) * Math.Max(1, level));
        string s = y.IsEmpty() ? string.Empty : "+" + CourtProjection.Bundle(y) + " a year";
        if (f.Defense > 0) s += (s.Length > 0 ? " · " : string.Empty) + "defence +" + (f.Defense * Math.Max(1, level)).ToString("0.##");
        return s;
    }
    private RenderFragment LevelPips(int level) => __builder =>
    {
        int max = G.Content!.Holdings.Rules.MaxLevel;
        <span class="lvl" title="@("Level " + level + " of " + max + ": it yields, and costs to keep, " + (level == 1 ? "once" : level == 2 ? "twice over" : "three times over") + ".")">@for (int k = 1; k <= max; k++) { <i class="@(k <= level ? "on" : "")"></i> }</span>
    };
    /// <summary>The next level of a building that stands: what it costs, and the button or why not.</summary>
    private RenderFragment UpgradeLine(string target, string defId, Resources cost, int years, int level, bool mine, List<Project> upgrading, CommandContext ctx) => __builder =>
    {
        var w = G.World!; var cat = G.Content!.Holdings; var me = w.Protagonist!;
        if (level >= cat.Rules.MaxLevel || upgrading.Any(p => p.DefId == defId && p.TargetId == target)) return;
        string? no = mine ? new UpgradeBuildingCommand(me.Id, target, defId, cat).Refusal(ctx) : null; int y = Math.Max(1, years);
        <div class="sw-cost"><span title="A building at level II yields twice what it does at level I and costs twice to keep; at level III, three times.">Level @SystemWorks.Roman(level + 1) · @Bundle(SystemWorks.UpgradeCost(cost, level)) · @y year@(y == 1 ? "" : "s") · then it yields and costs to keep @(level + 1) times what level I does</span>
            @if (mine) { <button class="opt inline" disabled="@(no != null)" title="@(no != null ? Cap(no) : "It will yield, and cost to keep, " + (level + 1) + " times over.")" @onclick="() => G.Execute(new UpgradeBuildingCommand(me.Id, target, defId, cat))">Upgrade</button> }
        </div>
        @if (mine && no != null) { <div class="sw-no">@Cap(no)</div> }
    };

    /// <summary>One thing that could be built on a body: its picture, what it does, what it costs, and the button or why not.</summary>
    private RenderFragment WorkRow(WorkDef d, StarSystem sys, int body, bool mine, CommandContext ctx) => __builder =>
    {
        var w = G.World!; var c = G.Content!; var me = w.Protagonist!; string did = d.Id; string sid = sys.Id;
        string? no = mine ? new BuildWorkCommand(me.Id, sid, body, did, c.Holdings, c.Titles).Refusal(ctx) : null;
        <div class="sysp-work @(d.Feature.Length > 0 ? "unique" : "") @(d.IsMegastructure ? "mega" : "")" data-work="@d.Id">
            @Art(d.Id)
            <div class="sw-text">
                <div class="sw-head"><b>@d.Name</b> <span class="muted small">@Category(d)</span></div>
                <div class="muted small">@d.Description</div>
                <div class="sw-does">@Does(d, sys)</div>
                <div class="sw-cost"><span>@CourtProjection.Bundle(d.Cost)@(d.BuildTurns > 1 ? $" · {d.BuildTurns} years" : "")</span>
                    @if (mine) { <button class="opt inline" disabled="@(no != null)" title="@(no != null ? Cap(no) : d.BuildTurns > 1 ? "Begun now and paid for as it rises." : "")" @onclick="() => G.Execute(new BuildWorkCommand(me.Id, sid, body, did, c.Holdings, c.Titles))">@(d.IsMegastructure ? "Raise" : d.BuildTurns > 1 ? "Begin" : "Build")</button> }
                </div>
                @if (mine && no != null) { <div class="sw-no">@Cap(no)</div> }
            </div>
        </div>
    };

    /// <summary>What a work does, in a line: what it brings a year, what it costs to keep, and the rest.</summary>
    private static string Does(WorkDef d, StarSystem sys, int level = 1)
    {
        var parts = new List<string>(); var y = new Resources(); var keep = new Resources(); level = Math.Max(1, level);
        foreach (var r in Resource.All) { y.Set(r, (d.Deposit == r ? d.Yield.Get(r) * Math.Max(1, sys.Deposit(r)) : d.Yield.Get(r)) * level); keep.Set(r, d.Upkeep.Get(r) * level); }
        if (!y.IsEmpty()) parts.Add($"+{CourtProjection.Bundle(y)} a year");
        if (!keep.IsEmpty()) parts.Add($"upkeep {CourtProjection.Bundle(keep)}");
        if (d.Defense > 0) parts.Add($"defence +{d.Defense * level:0.##} ({(int)Math.Ceiling(2 * d.Defense * level)} more year(s) to besiege)");
        if (d.Depot) parts.Add("supplies fleets as a depot");
        if (d.Population > 0) parts.Add($"room for {d.Population * level} more people");
        if (d.Prosperity != 0) parts.Add($"prosperity {(d.Prosperity > 0 ? "+" : "")}{d.Prosperity}");
        if (d.Unrest != 0) parts.Add(d.Unrest < 0 ? $"unrest {d.Unrest} a year" : $"unrest +{d.Unrest} a year");
        if (d.Legitimacy > 0) parts.Add($"legitimacy +{d.Legitimacy} when finished");
        if (d.Glory > 0) parts.Add($"glory +{d.Glory}");
        return string.Join(" · ", parts);
    }
    private static string BuildingDoes(BuildingDef d, int level)
    {
        var parts = new List<string>(); var y = new Resources(); var keep = new Resources(); level = Math.Max(1, level);
        foreach (var r in Resource.All) { y.Set(r, d.Yield.Get(r) * level); keep.Set(r, d.Upkeep.Get(r) * level); }
        string perPoint = d.RequiresDeposit != null ? " for each point of the deposit" : "";
        if (!y.IsEmpty()) parts.Add("+" + CourtProjection.Bundle(y) + " a year" + perPoint);
        if (!keep.IsEmpty()) parts.Add($"upkeep {CourtProjection.Bundle(keep)}");
        if (d.Defense > 0) parts.Add($"defence +{d.Defense * 100:0}% to fleets defending here");
        if (d.Id == Economy.GranaryId) parts.Insert(0, $"unrest eases {Economy.GranaryCalm} more each year");
        if (d.Id == "supply_depot") parts.Insert(0, "your fleets are in supply within 2 lanes of here, not 1");
        return parts.Count == 0 ? "Nothing that is counted." : string.Join(" · ", parts);
    }
    private static string TrackDoes(InfrastructureDef t)
    {
        var parts = new List<string>();
        if (!t.Yield.IsEmpty()) parts.Add($"+{CourtProjection.Bundle(t.Yield)} a year");
        if (t.Defense > 0) parts.Add($"defence +{t.Defense:0.##}");
        if (t.Prosperity != 0) parts.Add($"prosperity +{t.Prosperity}");
        if (t.Population != 0) parts.Add($"room for {t.Population} more people");
        string each = parts.Count > 0 ? "Each level: " + string.Join(" · ", parts) + "." : "";
        string calmLevels = string.Join(" and ", t.CalmAt.Select(SystemWorks.Roman));
        if (t.CalmAt.Count > 0) each += " Levels " + calmLevels + " take a point a year off the world's unrest.";
        if (t.DepotAt > 0) each += " From level " + SystemWorks.Roman(t.DepotAt) + " the system supplies fleets as a depot.";
        return each.Trim();
    }
}
