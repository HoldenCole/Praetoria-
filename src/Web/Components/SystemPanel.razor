                            var all = SystemWorks.BuildableOn(w, cat, c.Titles, house, planet!, ctx);
                            var homeOnly = all.Where(x => x.Group == "home").Select(x => x.Work!).ToList(); var wfits = all.Where(x => x.Group == "own").Select(x => x.Building!).ToList(); var ordinary = all.Where(x => x.Group == "ordinary").Select(x => x.Work!).ToList();
                            var nowHome = all.Where(x => x.Group == "home" && mine && x.Refusal == null).Select(x => x.Work!).ToList(); var nowOwn = all.Where(x => x.Group == "own" && mine && x.Refusal == null).Select(x => x.Building!).ToList(); var nowOrd = all.Where(x => x.Group == "ordinary" && mine && x.Refusal == null).Select(x => x.Work!).ToList();
                            var laterHome = homeOnly.Except(nowHome).ToList(); var laterOwn = wfits.Except(nowOwn).ToList(); var laterOrd = ordinary.Except(nowOrd).ToList(); int nowCount = nowHome.Count + nowOwn.Count + nowOrd.Count;
                            @if (mine)
                            {
                                <details class="sysp-fold now" open data-can-begin="@nowCount">
                                    <summary>What can be begun now <span class="muted">@nowCount</span></summary>
                                    @if (nowCount == 0) { <div class="muted small">Nothing can be begun now. Each thing below says what it lacks.</div> }
                                    @foreach (var d in nowHome) { @WorkRow(d, sys, idx, mine, ctx) }
                                    @foreach (var d in nowOwn) { @OwnRow(d, planet!, mine, ctx) }
                                    @foreach (var d in nowOrd) { @WorkRow(d, sys, idx, mine, ctx) }
                                </details>
                            }
                            @if (laterHome.Count > 0) { <details class="sysp-fold" open="@(!mine)" data-fold="home"><summary>Only on a home world <span class="muted">@laterHome.Count@(mine ? " not yet" : "")</span></summary>@foreach (var d in laterHome) { @WorkRow(d, sys, idx, mine, ctx) }</details> }
                            @if (laterOwn.Count > 0) { <details class="sysp-fold" open="@(!mine)" data-fold="own"><summary>The world's own · @(cat.Spec(planet!.Specialization)?.Name ?? planet.Specialization) <span class="muted">@laterOwn.Count@(mine ? " not yet" : "")</span></summary>@foreach (var d in laterOwn) { @OwnRow(d, planet!, mine, ctx) }</details> }
                            @if (laterOrd.Count > 0) { <details class="sysp-fold" open="@(!mine)" data-fold="ordinary"><summary>Ordinary buildings · @Kind(b) <span class="muted">@laterOrd.Count@(mine ? " not yet" : "")</span></summary>@foreach (var d in laterOrd) { @WorkRow(d, sys, idx, mine, ctx) }</details> }
                            @if (homeOnly.Count + wfits.Count + ordinary.Count == 0) { <div class="muted small">Everything that suits this world stands.</div> }
                        }
                        else
                        {
                            var fits = cat.Works.Where(d => !d.IsMegastructure && SystemWorks.Suits(sys, b, d) && !standing.Any(x => x.Id == d.Id) && !rising.Any(p => p.DefId == d.Id)).OrderByDescending(d => d.Deposit.Length > 0).ThenBy(d => d.Cost.Credits + d.Cost.Materials).ToList();
                            var nowFits = fits.Where(d => mine && new BuildWorkCommand(me.Id, sys.Id, idx, d.Id, cat, c.Titles).Refusal(ctx) == null).ToList(); var laterFits = fits.Except(nowFits).ToList();
                            @if (fits.Count == 0) { <div class="muted small">Every building that suits it stands.</div> }
                            @if (mine && fits.Count > 0)
                            {
                                <details class="sysp-fold now" open data-can-begin="@nowFits.Count">
                                    <summary>What can be begun now <span class="muted">@nowFits.Count</span></summary>
                                    @if (nowFits.Count == 0) { <div class="muted small">Nothing can be begun now. Each thing below says what it lacks.</div> }
                                    @foreach (var d in nowFits) { @WorkRow(d, sys, idx, mine, ctx) }
                                </details>
                            }
                            @if (laterFits.Count > 0) { <details class="sysp-fold" open="@(!mine)" data-fold="later"><summary>@(mine ? "Not yet possible" : "What suits it") <span class="muted">@laterFits.Count</span></summary>@foreach (var d in laterFits) { @WorkRow(d, sys, idx, mine, ctx) }</details> }
                        }
                    }

                    @* the one site: a great work *@
                    @{ var greats = cat.Works.Where(d => d.IsMegastructure && SystemWorks.Suits(sys, b, d)).OrderByDescending(d => d.Feature.Length > 0).ThenBy(d => d.Cost.Credits + d.Cost.Materials).ToList(); }
                    @if (greats.Count > 0 || great != null)
                    {
                        <h5 class="sysp-h great">Great work <span class="muted">@(great != null ? (greatRising ? "the site is taken: it is rising" : "the site is taken") : "one site, for one of these · years in the raising")</span></h5>
                        @if (great == null)
                        {
                            @if (mine) { <div class="muted small sysp-cap" data-capacity="@may">The house is raising @raising.Count of the @may great work@(may == 1 ? "" : "s") @standingAs may raise at a time@(raising.Count > 0 ? ": " + string.Join(", ", raising.Select(p => p.Name)) : "").</div> }
                            <details class="sysp-fold great" data-fold="great"><summary>The great works that could stand here <span class="muted">@greats.Count</span></summary>@foreach (var d in greats) { @WorkRow(d, sys, idx, mine, ctx) }</details>
                        }
                    }
                    @if (most == 0 && greats.Count == 0 && great == null) { <div class="muted small">Nothing can be built here.</div> }
                </div>
            }
        </div>
    }
    }
    @* the system's bodies first (the tab's subject), the world's local law after them (docs/VISUAL_SYSTEM.md 4.6) *@
    @if (!Infrastructure && planet != null) { <LocalLawBlock HoldingId="@planet.Id" /> }
</div>

@code {
    /* how long a thing takes, on every line: a building on a world stands at once only when it takes no years; a work or a province's building of one year stands at once too */
    private static string Takes(int turns, int atOnceUpTo) => turns <= atOnceUpTo ? " · at once" : turns == 1 ? " · 1 year" : $" · {turns} years";
    /* said before the click: whether this holder is the house's match (docs/PLAYTHROUGH.md, Easy, B18 and B20) */
    private string HeavySays(string holderId)
    {
        var w = G.World!; var h = w.House(holderId); int theirs = FleetSystem.StrengthOf(w, holderId), yours = FleetSystem.StrengthOf(w, w.Protagonist!.HouseId);
        return theirs > 0 && theirs >= yours ? $"{h?.Name ?? "This house"} is your match ({Counted.Hulls(theirs)} to your {yours}): it will stop paying." : $"{h?.Name ?? "This house"} is not your match ({Counted.Hulls(theirs)} to your {yours}): it will pay.";
    }
    private string YieldSays(string holderId)
    {
        var w = G.World!; var h = w.House(holderId); int theirs = FleetSystem.StrengthOf(w, holderId), yours = FleetSystem.StrengthOf(w, w.Protagonist!.HouseId);
        return ProvinceSystem.WillYield(w, G.Content!.Holdings, w.Protagonist!.HouseId, holderId) ? $"{h?.Name ?? "This house"} cannot hope to win ({Counted.Hulls(theirs)} to your {yours}): it will step down." : $"{h?.Name ?? "This house"} can hope to win ({Counted.Hulls(theirs)} to your {yours}): asking is war.";
    }
    // its parameters are a name and a flag, which do not change when a year passes: without this the open row showed last year's
    // figures until it was closed and opened again (docs/PLAYTHROUGH.md, buildings)
    private void Redraw() => InvokeAsync(StateHasChanged);
    protected override void OnInitialized() => G.Changed += Redraw;
    public void Dispose() => G.Changed -= Redraw;
    [Parameter] public string SystemId { get; set; } = "";
    /// <summary>Show the system's infrastructure and not its bodies.</summary>
    [Parameter] public bool Infrastructure { get; set; }
    /// <summary>A body picked on the close map: its row is opened (each time the stamp changes, so picking the same one again opens it again).</summary>
    [Parameter] public int OpenBody { get; set; } = -1;
    [Parameter] public int OpenStamp { get; set; }
    private int _open = -1, _stampSeen = -1; private string? _for;
    /// <summary>The painting of a thing, where it has one; an empty plate of the same size where it has not.</summary>
    private RenderFragment Art(string id) => __builder =>
    {
        if (G.WorkPicture(id) is { } src) { <img class="sw-art" src="@src" alt="" loading="eager" decoding="async" /> } else { <span class="sw-art none" aria-hidden="true"></span> }
    };
    /// <summary>The lit globe a body is drawn as (Globe's classes): moons and comets grey, a belt as rock.</summary>
    /// <summary>A moon is a small lit globe of rock and a comet one of ice; the ring of dots is for an asteroid belt alone.</summary>
    private static string GlobeClass(Body b) => b.Class switch { "moon" => "barren", "comet" => "frozen", "belt" => "belt", _ => b.Class };
    private static int GlobePx(Body b) => b.IsPrimary ? 30 : b.Orbits >= 0 ? 16 : b.Class == "comet" ? 14 : 18 + Math.Min(3, b.Size) * 3;
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    /// <summary>The icon a resource is drawn with (clout is the laurels).</summary>
    private static string ResIcon(string k) => k == Resource.Influence ? "laurels" : k;
    /// <summary>A cost as icon-and-number pairs, for inside a plate after its hairline (docs/VISUAL_SYSTEM.md 4.11): "1,000 · 8".</summary>
    private static RenderFragment CostIcons(Resources r) => __builder =>
    {
        foreach (var k in Resource.All) { long v = r.Get(k); if (v == 0) continue; <span class="cost-p"><Icon Name="@ResIcon(k)" Tone="brass" Size="14" />@Money.Of(k, v)</span> }
    };
    /// <summary>What a yield is shown by in a row's figure: its credits, or else its first good.</summary>
    private static string YieldIcon(Resources r) => ResIcon(Resource.All.FirstOrDefault(k => r.Get(k) != 0) ?? Resource.Credits);
    private static string YieldMain(Resources r) { var k = r.Get(Resource.Credits) != 0 ? Resource.Credits : Resource.All.FirstOrDefault(x => r.Get(x) != 0) ?? Resource.Credits; return Money.Of(k, r.Get(k)); }
    /// <summary>The three dues a province may owe, as the joined plates (docs/VISUAL_SYSTEM.md 4.11), in sentence case with what each means.</summary>
    private IReadOnlyList<(string key, string text, string tip)> DuesOptions(string holderId) => new[] { ProvinceSystem.Forgiven, ProvinceSystem.Customary, ProvinceSystem.Heavy }
        .Select(dv => (dv.ToString(), Cap(ProvinceSystem.DuesName(dv)), dv == ProvinceSystem.Forgiven ? "Nothing is paid; it leans your way the more." : dv == ProvinceSystem.Heavy ? "Twice the dues; it leans nowhere, and a house that is your match stops paying. " + HeavySays(holderId) : "The tithe, the levy in war, and its voice.")).ToList();
    private static string Bundle(Resources r) => r.IsEmpty() ? "nothing" : CourtProjection.Bundle(r);
    private static string Kind(Body b) => b.Class switch
    {
        "star" => "the sun", "space" => "tied to no world", "moon" => "moon", "comet" => "comet", "belt" => "asteroid belt", "gas" => "gas giant", "terran" => "living world", "ocean" => "ocean world",
        "arid" => "arid world", "forge" => "forge world", "frozen" => b.Size <= 1 ? "ice dwarf" : "frozen world", "barren" => b.Size <= 1 ? "rock" : "dead world", _ => b.Class
    };
    private static string Category(WorkDef d) => d.Feature.Length > 0 ? "only here" : d.Limit == WorkDef.PerGalaxy ? "one in the galaxy" : d.Limit == WorkDef.PerHouse ? "one to a house" : d.Limit == WorkDef.PerSystem ? "one to a system" : d.IsMegastructure ? "great work" : d.Category switch
    {
        WorkDef.Colony => "colony", WorkDef.Extraction => "extraction", WorkDef.Military => "military", _ => "civil"
    };

    private readonly Dictionary<string, string> _giveTo = new(); private string? _provOpen;
    /// <summary>The house picked to be given each province, by "holding#index".</summary>
    private readonly Dictionary<string, string> _grantTo = new();
    private int RegardFor(House h) { var w = G.World!; var head = Economy.HeadOf(w, h); return head == null ? 0 : w.GetRelationship(head.Id, w.ProtagonistId)?.Disposition ?? 0; }
    private void AskGrant(GrantProvinceCommand cmd, string province, string world, string toId)
    {
        string to = G.World!.House(toId)?.Name ?? "that house";
        G.Ask("Give " + province + " to " + to + "?", province + " on " + world + " is theirs for life, with what is built in it. They owe you the customary dues. To have it back you must ask for it, and they may refuse.", "Give it", () => G.Execute(cmd));
    }
    private void SetGive(string holdingId, int index, string v) { _giveTo[holdingId + "#" + index] = v ?? string.Empty; }
    /// <summary>Whom a world is asked for: the choice made, if that house holds a province of it; else the first that does.</summary>
    private static string WorldFor(Holding planet, string chosen)
    {
        if (ProvinceSystem.ProvinceOf(planet, chosen) > 0) return chosen;
        for (int k = 1; k < planet.Provinces.Count; k++) { string kh = ProvinceSystem.HolderOf(planet, k); if (kh != planet.OwnerId) return kh; }
        return chosen;
    }
    private static string ProvinceDoes(ProvinceFocus? f, int level)
    {
        if (f == null) return string.Empty; var y = new Resources(); foreach (var r in Resource.All) y.Set(r, f.Yield.Get(r) * Math.Max(1, level));
        string s = y.IsEmpty() ? string.Empty : "+" + CourtProjection.Bundle(y) + " a year";
        if (f.Defense > 0) s += (s.Length > 0 ? " · " : string.Empty) + "defence +" + (f.Defense * Math.Max(1, level)).ToString("0.##");
        return s;
    }
    private RenderFragment LevelPips(int level) => __builder =>
    {
        int max = G.Content!.Holdings.Rules.MaxLevel;
        <span class="lvl" title="@("Level " + level + " of " + max + ": it yields, and costs to keep, " + (level == 1 ? "once" : level == 2 ? "twice over" : "three times over") + ".")">@for (int k = 1; k <= max; k++) { <i class="@(k <= level ? "on" : "")"></i> }</span>
    };
    /// <summary>The next level of a building that stands: what it costs, and the button or why not.</summary>
    private RenderFragment UpgradeLine(string target, string defId, Resources cost, int years, int level, bool mine, List<Project> upgrading, CommandContext ctx) => __builder =>
    {
        var w = G.World!; var cat = G.Content!.Holdings; var me = w.Protagonist!;
        if (level >= cat.Rules.MaxLevel || upgrading.Any(p => p.DefId == defId && p.TargetId == target)) return;
        string? no = mine ? new UpgradeBuildingCommand(me.Id, target, defId, cat).Refusal(ctx) : null; int y = Math.Max(1, years);
        <div class="sw-cost"><span title="A building at level II yields twice what it does at level I and costs twice to keep; at level III, three times.">Level @SystemWorks.Roman(level + 1) · @Bundle(SystemWorks.UpgradeCost(cost, level)) · @y year@(y == 1 ? "" : "s") · then it yields and costs to keep @(level + 1) times what level I does</span>
            @if (mine) { <button class="opt inline" disabled="@(no != null)" title="@(no != null ? Cap(no) : "It will yield, and cost to keep, " + (level + 1) + " times over.")" @onclick="() => G.Execute(new UpgradeBuildingCommand(me.Id, target, defId, cat))">Upgrade</button> }
        </div>
        @if (mine && no != null) { <div class="sw-no">@Cap(no)</div> }
    };

    /// <summary>One of the home world's own buildings that could be built: its picture, what it does, what it costs, and the button or why not.</summary>
    private RenderFragment OwnRow(BuildingDef d, Holding planet, bool mine, CommandContext ctx) => __builder =>
    {
        var w = G.World!; var c = G.Content!; var cat = c.Holdings; var me = w.Protagonist!;
        string? no = mine ? new BuildCommand(me.Id, planet.Id, d.Id, cat, c.Titles).Refusal(ctx) : null; string did = d.Id; string hid = planet.Id;
        <div class="sysp-work" data-own-building="@d.Id">
            @Art(d.Id)
            <div class="sw-text">
                <div class="sw-head"><b>@d.Name</b></div>
                <div class="sw-does">@BuildingDoes(d, 1)</div>
                <div class="sw-cost"><span>@CourtProjection.Bundle(d.Cost)@Takes(d.BuildTurns, 0)</span>
                    @if (mine) { <button class="opt inline" disabled="@(no != null)" title="@(no != null ? Cap(no) : "")" @onclick="() => G.Execute(new BuildCommand(me.Id, hid, did, cat, c.Titles))">@(d.BuildTurns > 1 ? "Begin" : "Build")</button> }
                </div>
                @if (mine && no != null) { <div class="sw-no">@Cap(no)</div> }
            </div>
        </div>
    };

    /// <summary>Pull down a building that stands: a small button, behind a confirm that says what comes back and what stops.</summary>
    private RenderFragment PullDownLine(string target, string defId, string name, bool mine) => __builder =>
    {
        if (!mine) return;
        var w = G.World!; var cat = G.Content!.Holdings; var me = w.Protagonist!; var cmd = new PullDownCommand(me.Id, target, defId, cat); string? no = cmd.Refusal(G.Ctx);
        <div class="sw-pull"><button class="opt inline tiny" data-pull-down="@(target + "|" + defId)" disabled="@(no != null)" title="@(no != null ? Cap(no) : cmd.Says(w))" @onclick="() => AskPullDown(cmd, name)">Pull down</button></div>
    };
    private void AskBuyOut(BuyOutClaimCommand cmd, string owner, int price, bool closes) =>
        G.Ask("Buy out the claim of " + owner + "?", owner + " is paid " + Money.Credits(price) + ". " + (closes ? "You have a claim in this belt already, so this one is closed down and the belt has room for another." : "The claim is yours, with what it brings up each year.") + " It cannot be undone.", "Buy it out", () => G.Execute(cmd));
    private void AskPullDown(PullDownCommand cmd, string name) => G.Ask("Pull down " + name + "?", cmd.Says(G.World!), "Pull it down", () => G.Execute(cmd));

    /// <summary>One thing that could be built on a body: its picture, what it does, what it costs, and the button or why not.</summary>
    private RenderFragment WorkRow(WorkDef d, StarSystem sys, int body, bool mine, CommandContext ctx) => __builder =>
    {
        var w = G.World!; var c = G.Content!; var me = w.Protagonist!; string did = d.Id; string sid = sys.Id;
        string? no = mine ? new BuildWorkCommand(me.Id, sid, body, did, c.Holdings, c.Titles).Refusal(ctx) : null;
        <div class="sysp-work @(d.Feature.Length > 0 ? "unique" : "") @(d.IsMegastructure ? "mega" : "")" data-work="@d.Id">
            @Art(d.Id)
            <div class="sw-text">
                <div class="sw-head"><b>@d.Name</b> <span class="muted small">@Category(d)</span></div>
                <div class="muted small">@d.Description</div>
                <div class="sw-does">@Does(d, sys)</div>
                <div class="sw-cost"><span>@CourtProjection.Bundle(d.Cost)@Takes(d.BuildTurns, 1)</span>
                    @if (mine) { <button class="opt inline" disabled="@(no != null)" title="@(no != null ? Cap(no) : d.BuildTurns > 1 ? "Begun now and paid for as it rises." : "")" @onclick="() => G.Execute(new BuildWorkCommand(me.Id, sid, body, did, c.Holdings, c.Titles))">@(d.IsMegastructure ? "Raise" : d.BuildTurns > 1 ? "Begin" : "Build")</button> }
                </div>
                @if (mine && no != null) { <div class="sw-no">@Cap(no)</div> }
            </div>
        </div>
    };

    /// <summary>What a work does, in a line: what it brings a year, what it costs to keep, and the rest.</summary>
    private static string Does(WorkDef d, StarSystem sys, int level = 1)
    {
        var parts = new List<string>(); var y = new Resources(); var keep = new Resources(); level = Math.Max(1, level);
        foreach (var r in Resource.All) { y.Set(r, (d.Deposit == r ? d.Yield.Get(r) * Math.Max(1, sys.Deposit(r)) : d.Yield.Get(r)) * level); keep.Set(r, d.Upkeep.Get(r) * level); }
        if (!y.IsEmpty()) parts.Add($"+{CourtProjection.Bundle(y)} a year");
        if (!keep.IsEmpty()) parts.Add($"upkeep {CourtProjection.Bundle(keep)}");
        if (d.Defense > 0) parts.Add($"defence +{d.Defense * level:0.##} ({Counted.MoreYears((int)Math.Ceiling(2 * d.Defense * level))} to besiege)");
        if (d.Depot) parts.Add("supplies fleets as a depot");
        if (d.Population > 0) parts.Add($"room for more people (+{d.Population * level} on the world's scale)");
        if (d.Prosperity != 0) parts.Add($"prosperity {(d.Prosperity > 0 ? "+" : "")}{d.Prosperity}");
        if (d.Unrest != 0) parts.Add(d.Unrest < 0 ? $"unrest {d.Unrest} a year" : $"unrest +{d.Unrest} a year");
        if (d.Legitimacy > 0) parts.Add($"legitimacy +{d.Legitimacy} when finished");
        if (d.Glory > 0) parts.Add($"glory +{d.Glory}");
        return string.Join(" · ", parts);
    }
    private static string BuildingDoes(BuildingDef d, int level)
    {
        var parts = new List<string>(); var y = new Resources(); var keep = new Resources(); level = Math.Max(1, level);
        foreach (var r in Resource.All) { y.Set(r, d.Yield.Get(r) * level); keep.Set(r, d.Upkeep.Get(r) * level); }
        string perPoint = d.RequiresDeposit != null ? " for each point of the deposit" : "";
        if (!y.IsEmpty()) parts.Add("+" + CourtProjection.Bundle(y) + " a year" + perPoint);
        if (!keep.IsEmpty()) parts.Add($"upkeep {CourtProjection.Bundle(keep)}");
        if (d.Defense > 0) parts.Add($"defence +{d.Defense * 100:0}% to fleets defending here");
        if (d.Id == Economy.GranaryId) parts.Insert(0, $"unrest eases {Economy.GranaryCalm} more each year");
        if (d.Id == "supply_depot") parts.Insert(0, "your fleets are in supply within 2 lanes of here, not 1");
        return parts.Count == 0 ? "Nothing that is counted." : string.Join(" · ", parts);
    }
    private static string TrackDoes(InfrastructureDef t)
    {
        var parts = new List<string>();
        if (!t.Yield.IsEmpty()) parts.Add($"+{CourtProjection.Bundle(t.Yield)} a year");
        if (t.Defense > 0) parts.Add($"defence +{t.Defense:0.##}");
        if (t.Prosperity != 0) parts.Add($"prosperity +{t.Prosperity}");
        if (t.Population != 0) parts.Add($"room for more people (+{t.Population} on the world's scale)");
        string each = parts.Count > 0 ? "Each level: " + string.Join(" · ", parts) + "." : "";
        string calmLevels = string.Join(" and ", t.CalmAt.Select(SystemWorks.Roman));
        if (t.CalmAt.Count > 0) each += " Levels " + calmLevels + " take a point a year off the world's unrest.";
        if (t.DepotAt > 0) each += " From level " + SystemWorks.Roman(t.DepotAt) + " the system supplies fleets as a depot.";
        return each.Trim();
    }
}
