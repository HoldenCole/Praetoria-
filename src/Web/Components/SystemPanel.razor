@inject GameClient G
@implements IDisposable
@* A solar system, place by place (docs/SYSTEMS.md, docs/BUILDINGS.md): its development first, then the sun, each world with its moons
   under it, and open space. A row is a place: its kind, its feature, its deposit, its building slots as pips (the ones still to be
   opened shown faint) and its one site for a great work as a diamond. One place is open at a time: what stands there and how high it
   may be taken, where its slots come from and what clearing another costs, the buildings that suit it, and the great works its site
   could take. The home world has its own buildings, the ones only a home world takes, and the ordinary ones of its kind.
   With Infrastructure set, the system's own tracks instead: each a row of levels, bought one at a time. *@
@{
    var w = G.World!; var c = G.Content!; var cat = c.Holdings; var sys = w.Galaxy!.System(SystemId); if (sys == null) return;
    var me = w.Protagonist!; var house = w.House(me.HouseId)!; var planet = w.PlanetOf(sys.Id); bool mine = planet?.OwnerId == house.Id;
    var ctx = new CommandContext(w, new Praetoria.Core.Rng.SplitMix64Rng(0));
    if (_for != sys.Id) { _for = sys.Id; _open = -1; }
    if (OpenStamp != _stampSeen) { _stampSeen = OpenStamp; if (OpenBody >= 0 && OpenBody < sys.Bodies.Count) _open = OpenBody; }
    // the sun first, then each world with its moons under it, then open space
    var order = new List<int>(); int sun = sys.Bodies.FindIndex(b => b.IsStar); if (sun >= 0) order.Add(sun);
    for (int i = 0; i < sys.Bodies.Count; i++) { if (sys.Bodies[i].IsStar || sys.Bodies[i].IsSpace || sys.Bodies[i].Orbits >= 0) continue; order.Add(i); for (int m = 0; m < sys.Bodies.Count; m++) if (sys.Bodies[m].Orbits == i) order.Add(m); }
    int deep = sys.Bodies.FindIndex(b => b.IsSpace); if (deep >= 0) order.Add(deep);
    var colony = planet == null ? w.Projects.FirstOrDefault(p => p.Kind == Project.Colony && p.TargetId == sys.Id) : null;
    var raising = SystemWorks.Raising(w, cat, house.Id).ToList(); int may = SystemWorks.Capacity(w, cat, house); string standingAs = SystemWorks.StandingName(w, house);
    var rules = cat.Rules; int dev = SystemWorks.Development(w, sys.Id), devLevel = dev / 10, devTop = SystemWorks.DevelopmentCeiling(w, cat, sys.Id), levelMay = SystemWorks.LevelAllowed(w, cat, sys.Id);
    string devParts = string.Join(" · ", SystemWorks.CeilingParts(w, cat, sys.Id).Select(x => x.what + " " + x.points));
    int nextWorld = rules.DevelopmentWorld.Where(l => l > devLevel).DefaultIfEmpty(0).Min(), nextBody = rules.DevelopmentBody.Where(l => l > devLevel).DefaultIfEmpty(0).Min(), nextUp = rules.UpgradeAt.Where(l => l > devLevel).DefaultIfEmpty(0).Min();
    string devNext = (nextWorld > 0 ? "A slot more on the home world at " + nextWorld : "") + (nextBody > 0 ? (nextWorld > 0 ? ", on every other place at " : "A slot more on every other place at ") + nextBody : "") + (nextWorld > 0 || nextBody > 0 ? ". " : "")
        + "Buildings may stand at level " + SystemWorks.Roman(levelMay) + (nextUp > 0 ? "; " + SystemWorks.Roman(levelMay + 1) + " at " + nextUp + "." : ".");
    string devTrend = dev < devTop ? "growing toward " + devTop : dev > devTop ? "more than it can bear: falling toward " + devTop : "as high as it can bear";
}
<div class="sysp @(Infrastructure ? "infra" : "")" data-system="@sys.Id">
    @if (sys.Description.Length > 0 && !Infrastructure) { <p class="sysp-lede">@sys.Description</p> }
    @if (planet == null)
    {
        var fc = new FoundColonyCommand(me.Id, sys.Id, cat); string? why = fc.Refusal(ctx);
        <div class="sysp-settle">
            @if (colony != null) { <div class="empty-line">@(w.House(colony.OwnerId)?.Name ?? "A house") has a colony on its way here: @Counted.Years(colony.TurnsLeft) more.</div> }
            else
            {
                <div class="empty-line">Nobody holds this system. A colony would make its world yours, and every body round its sun yours to build on.</div>
                <div class="sysp-cost">@CourtProjection.Bundle(ProjectSystem.Split(cat.Colony.Cost, cat.Colony.BuildTurns).First) now@(cat.Colony.BuildTurns > 1 ? $", the same in each of {Counted.MoreYears(cat.Colony.BuildTurns - 1)}" : ""); it lands in @cat.Colony.BuildTurns years.</div>
                <button class="opt" disabled="@(why != null)" title="@(why ?? $"Ships, settlers and stores. The cost is paid a share a year while they are on the way: {CourtProjection.Bundle(cat.Colony.Cost)} in all. Only the first share is needed in hand to send it. A fleet that stood in the system to make the claim may leave once the colony has sailed.")" @onclick="() => G.Execute(new FoundColonyCommand(me.Id, sys.Id, cat))">Send a colony</button>
                @if (why != null) { <div class="muted small">@Cap(why).</div> }
            }
        </div>
    }
    else if (!mine) { <div class="muted small sysp-note">Held by @(w.House(planet.OwnerId)?.Name ?? "another"). What is built here is theirs while they hold the world, and would be yours if you took it.</div> }
    @if (planet != null)
    {
        <div class="sysp-dev" data-development="@dev" title="@($"[upgrade] Development {dev} of 100\nIt can bear {devTop} (the tick): {devParts}. It grows a point a year toward that, two on a prosperous world, and falls under siege or revolt.\n{devNext}")">
            <span class="dv-level" title="@($"Level {devLevel}: a tenth of the development")">@devLevel</span>
            <span class="dv-text"><span class="dv-l"><b>Development</b><span class="ui-dim">@devTrend</span></span>
                <Meter Value="@dev" Target="@devTop" Text="@($"{dev}")" Small="/100" Color="@(dev > devTop ? "#c4472f" : "#c9a24a")" /></span>
        </div>
        @if (mine && ClaimSystem.Of(w, sys.Id, house.Id).ToList() is { Count: > 0 } claims)
        {
            /* the claims other houses hold in your belt: what each brings its house, what it owes you, and a price to buy it out
               (docs/PLAYTHROUGH.md, Medium, Building and holding, B50) */
            var eco = G.Turn!.Ventures?.Economy;
            <div class="sysp-claims" data-claims="@claims.Count">
                <h5 class="sysp-h">Claims of other houses in this belt <span class="muted">@claims.Count of @sys.Belt the belt has room for</span></h5>
                <div class="muted small">A belt claim is its house's own: it brings up what the belt holds for that house and owes you nothing, though it lies in your system. You may offer to buy it out.</div>
                @foreach (var cl in claims)
                {
                    string clid = cl.Id; var co = w.House(cl.OwnerId); var brings = eco?.Compute(w, cl.OwnerId).Lines.FirstOrDefault(l => l.Kind == "claim" && l.Source == cl.Name)?.Delta;
                    var buy = new BuyOutClaimCommand(me.Id, cl.Id, G.Content!.Businesses); string? buyNo = buy.Refusal(ctx); int price = ClaimSystem.Price(w, G.Content!.Businesses, cl, house);
                    bool closes = w.Holdings.Values.Any(x => x.IsClaim && x.SystemId == sys.Id && x.OwnerId == house.Id);
                    <div class="sw-cost" data-claim="@clid">
                        <span><b>@(co?.Name ?? "A house")</b> <span class="muted small">· brings it @(brings == null || brings.IsEmpty() ? "nothing this year" : Bundle(brings) + " a year") · owes you nothing</span></span>
                        <button class="opt inline" disabled="@(buyNo != null)" title="@(buyNo != null ? Cap(buyNo) : closes ? "You have a claim in this belt already: this one would be closed down, and the belt has room for another." : "The claim and what it brings up are yours from this year.")" @onclick="() => AskBuyOut(buy, co?.Name ?? string.Empty, price, closes)">Buy it out for @Money.Show(price)</button>
                    </div>
                    @if (buyNo != null && !buyNo.StartsWith("needs")) { <div class="sw-no">@Cap(buyNo)</div> }
                }
            </div>
        }
    }

    @if (Infrastructure)
    {
        <p class="sysp-desc">What the whole system rests on. It belongs to no one world: it is laid a level at a time, each dearer than the last, and the higher levels take years. Every level laid adds @rules.DevPerLevel to the system's development at once, and @rules.DevCeilingPerLevel to how far it can grow.</p>
        @foreach (var t in cat.Infrastructure)
        {
            int level = SystemWorks.Level(w, sys.Id, t.Id); var laying = SystemWorks.Laying(w, sys.Id, t.Id); int next = level + 1; string tid = t.Id;
            string? no = mine && level < t.MaxLevel ? new InvestInfrastructureCommand(me.Id, sys.Id, t.Id, cat).Refusal(ctx) : null;
            <div class="sysp-work infra" data-track="@t.Id">
                @Art(t.Id)
                <div class="sw-text">
                    <div class="sw-head"><b>@t.Name</b> <span class="lv" title="@($"level {level} of {t.MaxLevel}")">@for (int k = 1; k <= t.MaxLevel; k++) { <i class="@(k <= level ? "on" : laying != null && k == next ? "up" : "")"></i> }</span></div>
                    <div class="muted small">@t.Description</div>
                    <div class="sw-does">@TrackDoes(t)</div>
                    @if (laying != null) { <div class="sw-cost"><span>Level @SystemWorks.Roman(next) is being laid: @Counted.Years(laying.TurnsLeft) more.</span></div> }
                    else if (level >= t.MaxLevel) { <div class="sw-cost"><span>Carried as far as it goes.</span></div> }
                    else
                    {
                        /* the next level: what it adds under the name, its cost inside the plate after a hairline (docs/VISUAL_SYSTEM.md 4.11) */
                        string costLine = $"Level {SystemWorks.Roman(next)} · {CourtProjection.Bundle(t.CostOf(next))}{(t.YearsOf(next) > 1 ? $" · {t.YearsOf(next)} years" : "")} · development +{rules.DevPerLevel}";
                        <div class="sw-cost infra-next"><span class="sw-sub">Level @SystemWorks.Roman(next) · development +@rules.DevPerLevel@(t.YearsOf(next) > 1 ? $" · {t.YearsOf(next)} years" : "")</span>
                            @if (mine) { <Plate Label="Lay it" Small="true" Icon="gears" Locked="@(no != null)" Disabled="@(no != null)" Need="@(no != null ? Cap(no) : "")" ShowNeed="false" Class="opt" Tip="@($"[gears] Lay level {SystemWorks.Roman(next)} of {t.Name}\n{costLine}.")" OnClick="() => G.Execute(new InvestInfrastructureCommand(me.Id, sys.Id, tid, cat))"><Cost>@CostIcons(t.CostOf(next))</Cost></Plate> }
                            else { <span class="sw-c" title="@costLine">@CostIcons(t.CostOf(next))</span> }
                        </div>
                        @if (mine && no != null) { <div class="sw-no">@Cap(no)</div> }
                    }
                </div>
            </div>
        }
    }
    else
    {
    @foreach (int i in order)
    {
        var b = sys.Bodies[i]; var feat = b.Feature.Length > 0 ? cat.Feature(b.Feature) : null; bool world = b.IsPrimary && planet != null;
        var standing = SystemWorks.On(w, sys.Id, i).Select(x => cat.Work(x.DefId)).Where(d => d != null).Select(d => d!).ToList(); var rising = SystemWorks.Underway(w, sys.Id, i).ToList();
        string? siteId = SystemWorks.Site(w, cat, sys.Id, i); var great = siteId != null ? cat.Work(siteId) : null; bool greatRising = great != null && !standing.Contains(great);
        // the home world: the holding's own buildings share its slots with what is raised on it
        var hb = world ? planet!.Buildings.Select(id => cat.Building(id)).Where(x => x != null).Select(x => x!).ToList() : new List<BuildingDef>();
        var hbRising = world ? w.Projects.Where(p => p.Kind == Project.Building && p.TargetId == planet!.Id).ToList() : new List<Project>();
        string target = SystemWorks.Target(sys.Id, i); var upgrading = w.Projects.Where(p => p.Kind == Project.Upgrade && (p.TargetId == target || (world && p.TargetId == planet!.Id))).ToList();
        int slots = SystemWorks.Slots(w, cat, sys, i), most = b.IsStar ? 0 : b.IsPrimary ? rules.MaxWorld : rules.MaxBody;
        int used = hb.Count + standing.Count(d => !d.IsMegastructure), up = hbRising.Count + rising.Count(p => cat.Work(p.DefId)?.IsMegastructure != true);
        var parts = SystemWorks.SlotParts(w, cat, sys, i).ToList(); string partsLine = string.Join(" · ", parts.Select(x => x.what + " " + x.slots));
        bool open = _open == i; int idx = i;
        <div class="sysp-body @(open ? "open" : "") @(b.Orbits >= 0 ? "moon" : "") @(b.IsStar ? "star" : "") @(b.IsSpace ? "space" : "") @(world ? "home" : "")" data-body="@b.Class" data-body-index="@idx">
            <button class="sysp-row" @onclick="() => _open = _open == idx ? -1 : idx" title="@((feat != null ? feat.Name + ": " + feat.Description : Kind(b)) + (most == 0 ? "\nNo building slots: only a great work can be raised here. " + (great == null ? "The site for a great work: free." : greatRising ? great.Name + " is rising on its site." : great.Name + " stands on its site.") : ""))">
                @if (b.IsSpace) { <span class="sprite deep" aria-hidden="true"></span> }
                else if (b.IsStar) { <span class="sysp-sun" aria-hidden="true"></span> }
                else { <span class="sysp-globe" style="@($"--gs:{GlobePx(b)}px")"><Globe Class="@GlobeClass(b)" Size="@GlobePx(b)" Ringed="@(world && mine)" /></span> }
                <span class="sysp-name"><b>@b.Name</b><span class="muted">@Kind(b)@(b.IsPrimary ? " · the home world" : "")</span></span>
                <span class="sysp-marks">
                    @if (feat != null) { <span class="sysp-feat" title="@($"[medal] {feat.Name}\n{feat.Description}")"><Icon Name="medal" Tone="brass" Size="15" /></span> }
                    @if (b.Deposit.Length > 0) { <span class="pill small dep" title="@($"[{b.Deposit}] A {Resource.Label(b.Deposit)} deposit\nRichness {sys.Deposit(b.Deposit)}")"><Icon Name="@b.Deposit" Tone="@(b.Deposit == "isotopes" ? "ember" : b.Deposit == "rare_earths" ? "ivory" : "steel")" Size="14" /><b>@sys.Deposit(b.Deposit)</b></span> }
                    @if (most > 0) { <span class="sysp-slots @(used + up >= slots ? "full" : "")" data-slots-used="@(used + up)" data-slots-open="@slots" title="@($"[build] Building slots\n{used} built · {up} rising · {slots} open of {most} at the most. From: {partsLine}.\nThe site for a great work: {(great == null ? "free" : greatRising ? great.Name + " is rising on it" : great.Name + " stands on it")}.")"><Icon Name="build" Tone="@(used > 0 ? "brass" : "ivory")" Size="14" /><b>@(used + up)</b><small>of @slots</small>@for (int k = 0; k < Math.Max(slots, most); k++) { <i class="@(k < used ? "on" : k < used + up ? "up" : k >= slots ? "lock" : "")" aria-hidden="true"></i> }</span> }
                    @* the site of a great work is drawn only where one stands or rises; a free site is still marked (hidden) for tools/browser/systems.js *@
                    @if (great == null) { <span class="sysp-site free" aria-hidden="true"></span> }
                    else { <span class="sysp-site @(greatRising ? "up" : "on")" title="@(greatRising ? $"[crown] {great.Name}\nIt is rising on the site for a great work" : $"[crown] {great.Name}\nIt stands on the site for a great work")"></span> }
                </span>
            </button>
            @if (!open && (standing.Count > 0 || rising.Count > 0 || hb.Count > 0 || hbRising.Count > 0))
            {
                <div class="sysp-built">
                    @foreach (var d in hb) { int lv = planet!.LevelOf(d.Id); <span class="built" title="@BuildingDoes(d, lv)">@d.Name@(lv > 1 ? " " + SystemWorks.Roman(lv) : "")</span> }
                    @foreach (var p in hbRising) { <span class="built up">@(cat.Building(p.DefId)?.Name ?? p.DefId) · @p.TurnsLeft y</span> }
                    @foreach (var x in SystemWorks.On(w, sys.Id, i)) { var d = cat.Work(x.DefId); if (d == null) continue; <span class="built @(d.IsMegastructure ? "great" : "")" title="@(d.Description + " " + Does(d, sys, x.Level))">@d.Name@(x.Level > 1 ? " " + SystemWorks.Roman(x.Level) : "")</span> }
                    @foreach (var p in rising) { <span class="built up @(cat.Work(p.DefId)?.IsMegastructure == true ? "great" : "")" title="@($"{Bundle(ProjectSystem.Remaining(p))} still to pay")">@(cat.Work(p.DefId)?.Name ?? p.DefId) · @p.TurnsLeft y@(p.Hastened ? " · hastened" : "")</span> }
                </div>
            }
            @if (open)
            {
                <div class="sysp-open">
                    @if (feat != null) { <p class="sysp-desc">@feat.Description</p> }
                    @if (b.IsSpace) { <p class="sysp-desc">The dark between the worlds. What is built here is tied to no body: stations on the approaches, and the greatest works of all.</p> }
                    @if (world) { <p class="sysp-desc">The home world: where the system's people live and its holder sits. It takes its own buildings, some that only a home world takes, and the ordinary ones of its kind, all in the same slots.</p> }
                    @if (world && planet!.Provinces.Count > 0)
                    {
                        /* the provinces (docs/PROVINCES.md, docs/CITIES.md), one row each (docs/VISUAL_SYSTEM.md 4.7): the chief city's painting or the
                           holder's arms, the name, the city and the holder under it, the figures (citizens, what it yields, the dues, its slots), and
                           one action at the right; what else can be done with it is a strip of small plates under the row, and every rule sentence
                           is in a tooltip */
                        var over = ProvinceSystem.Over(w, planet); string hid3 = planet.Id; string ownerName = mine ? "Your house" : w.House(planet.OwnerId)?.Name ?? "A house";
                        string overLine = ownerName + " holds the world, and its seat with it. " + (over == null ? "Nobody stands over it." : (over.Id == house.Id ? "You stand" : over.Name + " stands") + " over it, and may ask it to make way.");
                        string provRules = "[region] Provinces and their cities\nThree to a world: each held by a house, for life, each with a chief city of its own kind."
                            + (planet.Population > 0 && planet.Provinces.Any(x => x.City.Length > 0) ? $"\nBesides its chief cities the world has about {CitySystem.Lesser(w, cat, planet)} lesser cities and towns, where most of its {Census.Say(Census.Citizens(w, planet))} citizens live. They grow with the world's development and are not named." : "")
                            + (planet.Provinces[0].SettledUntil > w.Turn ? $"\nA peace holds the world its holder's until year {planet.Provinces[0].SettledUntil}." : "");
                        <h5 class="sysp-h prov" data-lesser="@CitySystem.Lesser(w, cat, planet)">Provinces <span class="sysp-n">@planet.Provinces.Count</span><span class="ui-info" title="@provRules" tabindex="0" aria-label="The rules">i</span></h5>
                        <div class="sysp-over" title="@overLine">@overLine</div>
                        @for (int pi = 0; pi < planet.Provinces.Count; pi++)
                        {
                            var pv = planet.Provinces[pi]; var pf = cat.Provinces.Focus(pv.Focus); string holderId = ProvinceSystem.HolderOf(planet, pi); bool pmine = holderId == house.Id; int pidx = pi;
                            var pending = w.SeatDemands.FirstOrDefault(d => d.HoldingId == planet.Id && d.Province == pidx);
                            string giveTo = _giveTo.TryGetValue(planet.Id + "#" + pidx, out var gt) ? gt : house.Id; string? dno = mine && pidx > 0 && !pmine ? new DemandSeatCommand(me.Id, planet.Id, pidx, giveTo, cat).Refusal(ctx) : null;
                            string? wno = pidx == 0 && over?.Id == house.Id && !mine ? new DemandSeatCommand(me.Id, planet.Id, 0, WorldFor(planet, giveTo), cat).Refusal(ctx) : null;
                            bool atWar = !pmine && pidx > 0 && w.AtWar(holderId, planet.OwnerId);
                            int pslots = ProvinceSystem.Slots(w, cat, planet, pidx), pbuilt = pv.Buildings.Count, prising = ProvinceSystem.Rising(w, planet, pidx); var owed = ProvinceSystem.Dues(w, cat, planet, pidx); var pyield = ProvinceSystem.Yield(w, cat, planet, pv);
                            var holderHouse = w.House(holderId); var ck = CitySystem.KindOf(cat, pv);
                            var cb = ck != null && ck.Building.Length > 0 ? cat.Work(ck.Building) : null; bool cbStands = cb != null && (pv.Buildings.Contains(cb.Id) || (pidx == 0 && w.BodyWorks.Any(x => x.SystemId == sys.Id && x.DefId == cb.Id)));
                            string cityDoes = ck != null ? CitySystem.Says(ck) : ""; string cityOnly = cb == null ? "" : " Only here: " + cb.Name + (cbStands ? " (it stands)." : pidx == 0 ? ", raised on the home world." : ", raised in the province's slots.");
                            string cityLine = ck == null ? "" : $"{pv.City}, {ck.Name}: {Census.Say(CitySystem.Citizens(w, cat, planet, pidx))} citizens.\n{ck.What} {(cityDoes.Length > 0 ? cityDoes + "." : "")}{cityOnly}";
                            string tenure = pidx > 0 && holderId != planet.OwnerId ? (pv.Since > 0 ? " since year " + pv.Since : ", for life") : pidx == 0 ? ", with the world" : "";
                            string holds = (pmine ? "Yours" : holderHouse?.Name ?? "nobody's") + tenure;
                            string doesLine = holds + " · " + (pyield.IsEmpty() ? "pays nothing" : "+" + CourtProjection.Bundle(pyield) + " a year") + (pf != null && pf.Defense > 0 ? " · defence +" + (pf.Defense * Math.Max(1, pv.Level)).ToString("0.##") : "") + (atWar ? " · withheld: its house is at war with the holder of the world" : "");
                            bool under = pidx > 0 && holderId != planet.OwnerId && !atWar;
                            string overName = mine ? "you" : w.House(planet.OwnerId)?.Name ?? "the holder of the world"; bool warNow = w.EnemiesOf(planet.OwnerId).Any(); int squad = cat.Provinces.LevySquadron * Math.Max(1, pv.Level); string dkey = planet.Id;
                            string youLean = pmine ? "your house is expected to lean" : "it leans";
                            string owesLine = !under ? "" : pv.Withheld ? (pmine ? "You are withholding" : "It is withholding") + " the dues. Nothing is paid, no levy is sent, and " + overName + " may ask for the province at no cost. It ends when " + (pmine ? "you pay" : "the holder pays") + " again of " + (pmine ? "your" : "its") + " own accord, when the province changes hands, or when the two houses fight over it and make peace (the peace settles it for " + cat.Provinces.SettleYears + " years)."
                                : pv.EasedUntil > w.Turn ? "Its dues are commuted until year " + pv.EasedUntil + ": nothing is owed, no levy is sent, and " + youLean + " " + overName + "'s way in the Senate the more for it."
                                : pv.Dues <= ProvinceSystem.Forgiven ? "Its dues are forgiven: nothing is owed, no levy is sent, and " + youLean + " " + overName + "'s way in the Senate the more for it."
                                : (pmine ? "You owe" : "It owes") + " " + overName + " " + (owed.IsEmpty() ? "nothing this year" : Bundle(owed) + " a year") + " (" + ProvinceSystem.DuesName(pv.Dues) + " dues)" + (warNow ? ", levy included, and a squadron of " + squad + " under one of " + (pmine ? "your" : "its") + " own officers sails for " + (mine ? "you" : "that house") + " until the peace" : "; in a war of " + (mine ? "yours" : "that house's") + ", a levy too and a squadron of " + squad) + (pv.Dues >= ProvinceSystem.Heavy ? ". Heavy dues buy no voice in the Senate." : ", and " + youLean + " that way in the Senate.");
                            long owedCr = owed.Get(Resource.Credits); string duesFig = !under ? "" : pv.Withheld ? "withheld" : pv.EasedUntil > w.Turn ? "commuted" : pv.Dues <= ProvinceSystem.Forgiven ? "forgiven" : owedCr == 0 ? "0" : pmine ? "−" + Money.Show(owedCr) : "+" + Money.Show(owedCr);
                            string rowTip = $"[region] {pv.Name}\n{(pf?.Name ?? pv.Focus)}{(planet.Population > 0 ? " · " + Census.Say(Census.CitizensOfProvince(w, planet, pidx)) + " citizens" : "")}\n{doesLine}." + (cityLine.Length > 0 ? "\n" + cityLine : "");
                            <div class="sysp-prov @(pmine ? "mine" : "") @(atWar ? "war" : "")" data-province="@pv.Focus" data-holder="@holderId">
                                <Row Name="@pv.Name" Class="@("prov-row" + (ck?.Great == true ? " great" : ""))" Tip="@rowTip" Wrap="true">
                                    <Picture>
                                        @if (cb != null && G.WorkPicture(cb.Id) is { } cpic) { <span class="prov-pic" style="background-image:url('@cpic')" data-city="@(ck?.Id ?? "")"></span> }
                                        else { <span class="prov-pic arms" data-city="@(ck?.Id ?? "")">@if (holderHouse != null) { <Sigil HouseId="@holderHouse.Id" Accent="@holderHouse.AccentColor" Size="30" /> } else { <Icon Name="region" Tone="ivory" Size="22" /> }</span> }
