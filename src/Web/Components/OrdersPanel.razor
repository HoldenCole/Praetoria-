@preservewhitespace true
@using Praetoria.Core.Systems
@inject GameClient G
@implements IDisposable
@* The three orders on the Senate window (docs/ORDERS.md; docs/VISUAL_SYSTEM.md 4.6, 4.10): each order a meter row with its tier, the
   house's rank and what its score is made of; then the house's voice, its weight in the chamber, its sway and its patronage as rows
   (a glyph or the arms of the house named, what it is, one line, and its figure or its one action), with the asks of those above it. *@
@{
    var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var house = w.House(w.Protagonist!.HouseId)!; var os = G.Turn!.Orders; var senate = G.Turn!.Senate;
    var door = senate.Door(w, house); var swayed = OrderSystem.Swayed(w, house); var clients = OrderSystem.ClientsOf(w, house.Id).ToList(); var patron = w.House(house.PatronId);
    int great = OrderSystem.All.Count(o => OrderSystem.Tier(house, o) >= 2);
    var enroll = os.EnrollRefusal(w, house, door != null);
}
<section class="panel orders sn-panel">
    <p class="ui-lede sn-lede">@SenateScreen.Bold($"Your house is {OrderSystem.TierName(OrderSystem.Tier(house, OrderSystem.Senate))} in the Senate, {OrderSystem.TierName(OrderSystem.Tier(house, OrderSystem.Arms))} in Arms and {OrderSystem.TierName(OrderSystem.Tier(house, OrderSystem.Commerce))} in Commerce, " + (door switch { "land" => "and is heard by land.", "the bench" => "and is heard by the bench.", "the purse" => "and is heard by the purse.", "the sword" => "and is heard by the sword.", _ => "and has no voice in the chamber." }) + (patron != null ? $" It is the client of {patron.Name}." : clients.Count > 0 ? $" It keeps {Counted.Clients(clients.Count)}." : ""))</p>
    <Section Title="The three orders" Info="A house's standing in the three orders of the Republic: the Senate, Arms and Commerce. Each is a score out of 100; at each tier the house counts for more in the chamber and may keep more clients.">
        <Right><span>@(house.Calling.Length > 0 ? OrderSystem.CallingName(house.Calling) : "a house of no order yet")@(house.Origin == "new" ? " · a new name" : house.Origin == "old" ? " · an old name" : "")@(great >= 3 ? " · great in all three" : great == 2 ? " · great in two" : "")</span></Right>
    </Section>
    @foreach (var o in OrderSystem.All)
    {
        var (score, parts) = os.Measure(w, house, o); int tier = OrderSystem.Tier(score); int next = OrderSystem.NextAt(score);
        int rank = 1 + w.Houses.Values.Count(h => h.Id != PirateSystem.HouseId && h.Id != house.Id && h.Order(o) > score);
        <div class="sn-order order-row @(house.Calling == o ? "calling" : "")" title="@string.Join(" · ", parts.Select(p => $"{p.what} +{p.points}"))">
            <span class="sn-ic @(tier >= 2 ? "mine" : "")"><Icon Name="@OrderIcon(o)" Tone="@(tier >= 2 ? "brass" : "ivory")" Size="22" /></span>
            <div class="sn-order-main">
                <div class="sn-order-l1"><span class="sn-order-nm"><b class="sn-nm">@Cap(OrderSystem.Name(o))</b>@if (house.Calling == o) { <span class="sn-tag mine sn-calling" title="The order the house is called to">Calling</span> }</span>
                    <span class="ui-trk sn-gauge"><i class="ui-fill" style="width:@SenateScreen.Pc(score);--mc:@(tier >= 2 ? "#c9a24a" : tier == 1 ? "#a5813a" : "#6f5020")"></i>@if (next > 0) { <i class="ui-tick" style="left:@SenateScreen.Pc(next)"></i> }</span>
                    <span class="sn-order-v"><b>@score</b><small>/100</small></span></div>
                <div class="sn-sub2"><b class="@(tier >= 2 ? "ui-up" : "")">@Cap(OrderSystem.TierName(tier))</b> · @Ordinal(rank) among the houses@(next > 0 ? $" · {OrderSystem.TierName(tier + 1)} at {next}" : "")@(parts.Count > 0 ? " · " + string.Join(", ", parts.Take(3).Select(p => $"{p.what} +{p.points}")) : " · nothing yet")</div>
            </div>
        </div>
    }
    <Section Title="Voice and patronage" Info="A house with a voice may move motions; a house without one still votes. A patron gives coin and backing for your vote; clients vote with you." Class="sn-sub-sec" />
    @* each fact a row (docs/VISUAL_SYSTEM.md 4.7) on the orders' own grid: its glyph, what it is, one line of what it says, and its figure
       or its one action at the right; the houses it names by their arms *@
    <div class="sn-prows">
        <Row Name="Your voice" SubText="@(door switch { "land" => "By land: the rank the house holds.", "the bench" => "By the bench: its head is a magistrate.", "the purse" => "By the purse: enrolled by the census.", "the sword" => "By the sword: a house great in arms is heard.", _ => "None: the house votes, but may not move a motion." })" Wrap="true"
             Tip="@(door == null ? "The house has its votes in every count, but no voice: it may not move a motion. Its people may still stand for any office the ladder opens to them. A voice comes by land of rank, by the bench (a Judge at the head of the house), by the sword (a name great in arms) or by the purse (enrolment by the census)." : "")" Class="@(door == null ? "sn-pr off" : "sn-pr")">
            <Picture><span class="sn-ic @(door != null ? "mine" : "")"><Icon Name="public-speaker" Tone="@(door != null ? "brass" : "ivory")" Size="22" /></span></Picture>
            <Action>@if (door == null && !w.IsImperium) { <Plate Label="Enrol by the census" Small="true" Icon="scroll-quill" Locked="@(enroll != null)" Disabled="@(enroll != null)" Tip="@(enroll ?? "The fee goes to the chair; the house may move motions and stand for office from then on")" CostIcon="credits" CostText="@Money.Show(OrderSystem.CensusFee)" OnClick="() => G.Execute(new EnrollCommand(pid, os, c.Titles))" /> }</Action>
        </Row>
        <Row Name="In the chamber" SubText="Standing adds to the house's voice: one seat for each step in Arms and in Commerce, and one for every two clients." Wrap="true" Class="sn-pr"
             Tip="@($"Standing adds {Counted.Seats(OrderSystem.WeightOf(w, house))} to the house's voice: one for each step in Arms and in Commerce, and one for every two clients.")">
            <Picture><span class="sn-ic"><Icon Name="vote" Tone="ivory" Size="22" /></span></Picture>
            <Cells><span class="sn-pfig"><b>@SenateScreen.Signed(OrderSystem.WeightOf(w, house))</b><small>@(OrderSystem.WeightOf(w, house) == 1 ? "seat" : "seats")</small></span></Cells>
        </Row>
        <Row Name="Sway" SubText="@(swayed.Count == 0 ? "No house leans your way because it depends on you." : $"{Counted.Houses(swayed.Count)} lean your way.")" Wrap="true" Class="sn-pr"
             Tip="@(swayed.Count == 0 ? "Debtors, clients, holders of your companies' shares and fleets that burn fuel you corner all lean your way." : string.Join("\n", swayed.Select(x => $"{x.house.Name}: +{x.lean} ({string.Join(", ", x.why)})")))">
            <Picture><span class="sn-ic @(swayed.Count > 0 ? "mine" : "")"><Icon Name="shaking-hands" Tone="@(swayed.Count > 0 ? "brass" : "ivory")" Size="22" /></span></Picture>
            <Cells>
                @foreach (var x in swayed.Take(4)) { <span class="sn-sway" title="@($"{x.house.Name}: +{x.lean} ({string.Join(", ", x.why)})")"><Sigil HouseId="@x.house.Id" Accent="@x.house.AccentColor" Size="20" /><b class="ui-up">+@x.lean</b><span class="sr-only">@x.house.Name</span></span> }
                @if (swayed.Count > 4) { <span class="sn-sway more">and @(swayed.Count - 4) more</span> }
            </Cells>
        </Row>
        @if (house.Corners.Count > 0)
        {
            <div data-makes-quarter>
                <Row Name="Makes a quarter" SubText="@($"The house brings up a quarter or more of all the {string.Join(" and ", house.Corners.Select(g => Resource.Label(g)))} the Reach makes in a year. That is a maker's share, and counts toward Commerce; it is not a corner in the market, which is held in store (the Exchange, Goods).")" Wrap="true" Class="sn-pr">
                    <Picture><span class="sn-ic mine"><Icon Name="coins-pile" Tone="brass" Size="22" /></span></Picture>
                </Row>
            </div>
        }
        @if (!w.IsImperium)
        {
            @if (patron != null)
            {
                <Row Name="@patron.Name" SubText="Your patron: 100 credits a year, its backing in the chamber, and your vote expected at the election." Wrap="true" Class="sn-pr" Tip="The house is the client of its patron.">
                    <Picture><span class="sn-arms"><Sigil HouseId="@patron.Id" Accent="@patron.AccentColor" Size="30" /></span></Picture>
                    <Action><Plate Label="@("Leave " + patron.Name + "'s protection")" Small="true" Tip="Its head will not forgive it quickly" OnClick="() => G.Execute(new ClientCommand(pid, ClientCommand.Leave, string.Empty, os))" /></Action>
                </Row>
            }
            else if (clients.Count > 0)
            {
                <Row Name="Your clients" SubText="@($"The house keeps {clients.Count} of {Counted.Clients(OrderSystem.ClientCap(house))}. They vote for your house's candidate at an election, unless one of their own stands, and lean the way you vote in the chamber, once you have voted.")" Wrap="true" Class="sn-pr">
                    <Picture><span class="sn-ic mine"><Icon Name="three-friends" Tone="brass" Size="22" /></span></Picture>
                    <Cells><span class="sn-pfig"><b>@clients.Count</b><small>of @OrderSystem.ClientCap(house)</small></span></Cells>
                </Row>
                @foreach (var cl in clients)
                {
                    var cid = cl.Id;
                    <Row Name="@cl.Name" SubText="Your client" Class="sn-pr sn-client">
                        <Picture><span class="sn-arms"><Sigil HouseId="@cl.Id" Accent="@cl.AccentColor" Size="26" /></span></Picture>
                        <Action><Plate Label="@("Turn " + cl.Name + " away")" Small="true" Tip="@($"{cl.Name} is no longer your client: it no longer votes for you or leans your way")" OnClick="() => G.Execute(new ClientCommand(pid, ClientCommand.Release, cid, os))" /></Action>
                    </Row>
                }
            }
            else
            {
                @* an empty state (4.17): a faint glyph, one line, one way on. The window has no way to another window of its own (the shell
                   gives the Senate none), so the link presses the rail's Houses socket. *@
                <div class="ui-empty sn-pempty" data-patronage="none">
                    <Icon Name="three-friends" Tone="ivory" Size="46" />
                    <div>
                        <p>No patron and no clients. Take a needy house as a client, or seek a greater house's protection, on the Houses screen. The house could keep @OrderSystem.ClientCap(house).</p>
                        <button class="ui-link" title="The Houses window: a client is taken, and a patron sought, from a house's page" onclick="var b = document.querySelector('[data-rail=&quot;houses&quot;]'); if (b) b.click();">Open Houses<Icon Name="chev" Size="11" Class="flat" /></button>
                    </div>
                </div>
            }
            @foreach (var (ab, asWhat) in AskAbove.Above(w, house.Id))
            {
                /* what may be asked of those above you (docs/PLAYTHROUGH.md, Medium, The Senate, P6, P17 and P54) */
                string abId = ab.Id; int abRegard = AskAbove.RegardOf(w, ab, house);
                var coin = new AskAboveCommand(pid, abId, AskAbove.Coin, c.Offices, senate); string? coinNo = coin.Refusal(G.Ctx);
                var backing = new AskAboveCommand(pid, abId, AskAbove.Backing, c.Offices, senate); string? backNo = backing.Refusal(G.Ctx);
                <div data-ask-above="@abId">
                    <Row Name="@("Ask " + ab.Name)" Wrap="true" Class="sn-pr acts-under" Tip="What is given is a favour owed: you settle it by voting for the next motion that house moves of its own (not one it moved at your asking, nor one that strikes at your house).">
                        <Picture><span class="sn-arms"><Sigil HouseId="@ab.Id" Accent="@ab.AccentColor" Size="30" /></span></Picture>
                        <Sub>@Cap(asWhat). Its head thinks <b class="@(abRegard >= AskAbove.AskAt ? "ui-up" : "ui-warn-t")">@SenateScreen.Signed(abRegard)</b> of you and hears a request at @SenateScreen.Signed(AskAbove.AskAt). What is given is a favour owed: you settle it by voting for the next motion that house moves of its own (not one it moved at your asking, nor one that strikes at your house).</Sub>
                        <Action><span>
                            <Plate Label="For coin" Small="true" Icon="credits" Locked="@(coinNo != null)" Disabled="@(coinNo != null)" Tip="@(coinNo ?? coin.Says(w))" CostIcon="credits" CostText="@Money.Show(AskAbove.CoinOf(ab))" OnClick='() => G.Ask("Ask " + ab.Name + " for coin?", coin.Says(w), "Ask", () => G.Execute(coin))' data-ask-coin="1" />
                            <Plate Label="For its backing for consul" Small="true" Icon="podium" Locked="@(backNo != null)" Disabled="@(backNo != null)" Tip="@(backNo ?? backing.Says(w))" OnClick='() => G.Ask("Ask " + ab.Name + " for its backing?", backing.Says(w), "Ask", () => G.Execute(backing))' data-ask-backing="1" />
                            <span class="ui-mute">To have it move a motion for you: Senate, Motions.</span>
                        </span></Action>
                    </Row>
                </div>
            }
        }
    </div>
</section>

@code {
    // A panel with no parameters is not redrawn when its parent is, so it listens for the world changing itself: without this
    // it showed last year's figures after End Turn until something in it was clicked.
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;

    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    private static string Ordinal(int n) => n + (n % 100 is 11 or 12 or 13 ? "th" : (n % 10) switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" });
    private static string OrderIcon(string o) => o switch { OrderSystem.Arms => "crossed-sabres", OrderSystem.Commerce => "coins-pile", _ => "greek-temple" };
}
