@* A cameo portrait (docs/ART_DIRECTION.md §3): drawn by js/portrait.js from the character's id, sex, age and house colour, stable
   everywhere the person appears. The <img> is filled after render by praetoriaBust.paint(). *@
<span class="portrait @(Alive ? "" : "dead") @(Age >= 60 ? "elder" : "")" style="--ring:@Accent; width:@(Size)px; height:@(Size)px" title="@Name">
    <img data-bust="@Spec(Id, Sex, Age, Accent, Alive)" alt="@Name" width="@Size" height="@Size" />
</span>

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Sex { get; set; } = "";
    [Parameter] public int Age { get; set; }
    [Parameter] public bool Alive { get; set; } = true;
    [Parameter] public string Accent { get; set; } = "#888";
    [Parameter] public int Size { get; set; } = 48;
    public static string Spec(string id, string sex, int age, string accent, bool alive = true) =>
        System.Text.Json.JsonSerializer.Serialize(new { id, sex = sex.Length > 0 ? sex : (Math.Abs(id.GetHashCode()) % 2 == 0 ? "male" : "female"), age, accent, alive });
}
