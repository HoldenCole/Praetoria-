@* An illustrated portrait from the pre-drawn pool (DiceBear "Lorelei", CC0), chosen by the character's id and sex so a face is
   stable across every screen, set in a medallion ringed in the house accent and shaded with age. *@
<span class="portrait @(Alive ? "" : "dead") @(Age >= 60 ? "elder" : "")" style="--ring:@Accent; width:@(Size)px; height:@(Size)px" title="@Name">
    <img src="@Src" alt="@Name" width="@Size" height="@Size" loading="lazy" />
    @if (!Alive) { <i class="cross"></i> }
</span>

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Sex { get; set; } = "";
    [Parameter] public int Age { get; set; }
    [Parameter] public bool Alive { get; set; } = true;
    [Parameter] public string Accent { get; set; } = "#888";
    [Parameter] public int Size { get; set; } = 48;
    private const int Pool = 40;
    private string Src { get { unchecked { int h = 23; foreach (var ch in Id) h = h * 31 + ch; string s = Sex == "female" ? "f" : Sex == "male" ? "m" : (Math.Abs(h) % 2 == 0 ? "m" : "f"); return $"img/portraits/{s}{Math.Abs(h) % Pool}.svg"; } } }
}
