@inject IJSRuntime JS
@inject GameClient G
@* A portrait plate (docs/VISUAL_SYSTEM.md 4.15): a backdrop tinted by the house colour, the painting, an inner vignette, a band in
   the house colour along the foot, and a frame by size: the window frame from 120px, the medium frame from 64px, the small frame
   below, a round face of 22px and under (a chip). The dead are greyscale with a black ribbon; a condition (an illness, a wound,
   prison) is a small ember badge at the top right; an empty post is a hatched well with the post's glyph (EmptyGlyph). Sizes are
   given in px at the normal text size and written in rem; Height makes a plate taller than wide (150 by 188, 46 by 56).
   A portrait (docs/ART_DIRECTION.md, "Portraits and profiles"): drawn by js/portrait.js from the person's id, sex, age and house
   colour, dressed for their service and rank, its face set by what they think of you; stable everywhere the person appears. Small
   ones are the head alone, large ones the bust. Clicking one opens that person's profile. The <img> is filled after render by
   praetoriaBust.paint(), which this component calls for itself so any screen may place a portrait without a paint hook of its own. *@
@if (EmptyGlyph.Length > 0)
{
    <span class="portrait pf-empty @Tier" style="width:@Rem(Size); height:@Rem(Height ?? Size)" title="@(Titled ? Name : null)"><Icon Name="@EmptyGlyph" Tone="ivory" Size="@(Math.Max(10, Size * 11 / 20))" /></span>
}
else
{
<span class="portrait @(Alive ? "" : "dead") @(Age >= 60 ? "elder" : "") @(CanOpen ? "opens" : "") @(Size <= CloseBelow ? "close" : "") @Tier" style="--ring:@Accent; width:@Rem(Size); height:@Rem(Height ?? Size)" title="@(!Titled ? null : CanOpen ? Name + " · open their profile" : Name)"
      @onclick="Open" @onclick:stopPropagation="CanOpen">
    @if (Painted is { } url) { <img @key="url" class="lib" src="@url" alt="@Name" width="@Size" height="@(Height ?? Size)" loading="eager" decoding="async" /> }
    else { <img @key="SpecNow" data-bust="@SpecNow" alt="@Name" width="@Size" height="@(Height ?? Size)" /> }
    @if (Size > 22) { <i class="pf-band"></i> }
    @if (!Alive && Size > 22) { <i class="pf-ribbon"></i> }
    @if (Condition.Length > 0 && Size >= 40) { <i class="pf-cond" title="@ConditionTip"><Icon Name="@Condition" Tone="ember" Size="12" /></i> }
</span>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Sex { get; set; } = "";
    [Parameter] public int Age { get; set; }
    [Parameter] public bool Alive { get; set; } = true;
    [Parameter] public string Accent { get; set; } = "#888";
    [Parameter] public int Size { get; set; } = 48;
    /// <summary>The plate's height in px when it is not square (the profile's 150 by 188, a row's 46 by 56).</summary>
    [Parameter] public int? Height { get; set; }
    /// <summary>A condition shown as a badge: an icon key such as "pill" (ill), "sticking-plaster" (wounded), "candle-light".</summary>
    [Parameter] public string Condition { get; set; } = "";
    [Parameter] public string ConditionTip { get; set; } = "";
    /// <summary>An empty post: the post's glyph in a hatched well, and no person.</summary>
    [Parameter] public string EmptyGlyph { get; set; } = "";
    private string Tier => Size <= 22 ? "pf-chip" : Size >= 120 ? "pf-lg" : Size >= 64 ? "pf-md" : Size < 40 ? "pf-xs" : "";
    private static string Rem(int px) => (px / 15.0).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) + "rem";
    /// <summary>A face by choice, as "skin=2,hair=1,style=-1,beard=1,scar=1"; null reads the world's record for this person, if any.</summary>
    [Parameter] public string? Look { get; set; }
    /// <summary>Whether the plate carries its own tooltip (the name). Off where the plate stands inside something whose tooltip says more:
    /// an Office visitor, whose tooltip is their business.</summary>
    [Parameter] public bool Titled { get; set; } = true;
    /// <summary>Whether a click opens the person's profile. Off inside the profile itself and where there is no such person yet.</summary>
    [Parameter] public bool Opens { get; set; } = true;
    /// <summary>Dress for someone the world does not hold yet (the creation screen): "military", "stewardship", "law".</summary>
    [Parameter] public string? Career { get; set; }
    /// <summary>The ancestry to paint someone the world does not hold yet from (the creation screen); null reads the world.</summary>
    [Parameter] public string? Ancestry { get; set; }
    /// <summary>The painted picture of this person, if the library holds one.</summary>
    private string? Painted => PaintedUrl(G, Id, Sex, Age, Look ?? G.World?.Cosmetics.GetValueOrDefault("look:" + Id), Ancestry);
    public static string? PaintedUrl(GameClient g, string id, string sex, int age, string? look = null, string? ancestry = null)
    {
        if (g.Portraits == null || sex.Length == 0) return null;
        var c = g.World?.Char(id);
        // a house's people are painted from its ancestry; someone married in keeps their own; a child takes after a parent (Lineage)
        string blood = ancestry ?? (c != null && g.Content != null ? Lineage.Of(g.World!, g.Content.Ancestries, c) : "");
        return g.Portraits.Url(id, sex, age, blood, Chosen(look));
    }
    private static int Chosen(string? look) { if (look != null) foreach (var part in look.Split(',')) if (part.StartsWith("face=") && int.TryParse(part[5..], out int f)) return f; return -1; }
    private bool CanOpen => Opens && G.World?.Char(Id) != null && G.ProfileId != Id;
    private void Open() { if (CanOpen) G.ShowProfile(Id); }
    private string SpecNow => Spec(G.World, Id, Sex, Age, Accent, Alive, Look ?? G.World?.Cosmetics.GetValueOrDefault("look:" + Id), Size <= CloseBelow, Career);
    /// <summary>At or under this many pixels a portrait is the head alone.</summary>
    public const int CloseBelow = 72;

    public static string Spec(World? w, string id, string sex, int age, string accent, bool alive = true, string? look = null, bool close = false, string? career = null)
    {
        var spec = new Dictionary<string, object?> { ["id"] = id, ["sex"] = sex.Length > 0 ? sex : (Math.Abs(id.GetHashCode()) % 2 == 0 ? "male" : "female"), ["age"] = age, ["accent"] = accent, ["alive"] = alive };
        if (close) spec["close"] = true;
        if (career != null) spec["career"] = career;
        if (w != null && ProfileProjection.Dress(w, id) is { } d)
        {
            spec["career"] = d.Career; spec["rank"] = d.Rank; if (d.Mood != 0) spec["mood"] = d.Mood;
            if (d.Head) spec["head"] = true; if (d.Laurel) spec["laurel"] = true; if (d.Scar) spec["scar"] = true; if (d.Foreign) spec["foreign"] = true;
        }
        if (!string.IsNullOrEmpty(look))
        {
            var parts = look.Split(',').Select(x => x.Split('=')).Where(x => x.Length == 2 && int.TryParse(x[1], out _)).ToDictionary(x => x[0], x => int.Parse(x[1]));
            spec["look"] = new { skin = parts.GetValueOrDefault("skin", -1), hair = parts.GetValueOrDefault("hair", -1), style = parts.GetValueOrDefault("style", -1), beard = parts.GetValueOrDefault("beard", -1), scar = parts.GetValueOrDefault("scar", 0) == 1 };
        }
        return System.Text.Json.JsonSerializer.Serialize(spec);
    }
    protected override async Task OnAfterRenderAsync(bool first) { if (EmptyGlyph.Length > 0 || Painted != null) return; try { await JS.InvokeVoidAsync("praetoriaBust.paint"); } catch { } }
}
