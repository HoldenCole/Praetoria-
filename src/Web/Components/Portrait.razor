@inject IJSRuntime JS
@inject GameClient G
@* A cameo portrait (docs/ART_DIRECTION.md §3): drawn by js/portrait.js from the character's id, sex, age and house colour, stable
   everywhere the person appears. The <img> is filled after render by praetoriaBust.paint(), which this component calls for itself
   so any screen may place a portrait without a paint hook of its own. *@
<span class="portrait @(Alive ? "" : "dead") @(Age >= 60 ? "elder" : "")" style="--ring:@Accent; width:@(Size)px; height:@(Size)px" title="@Name">
    <img @key="SpecNow" data-bust="@SpecNow" alt="@Name" width="@Size" height="@Size" />
</span>

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Sex { get; set; } = "";
    [Parameter] public int Age { get; set; }
    [Parameter] public bool Alive { get; set; } = true;
    [Parameter] public string Accent { get; set; } = "#888";
    [Parameter] public int Size { get; set; } = 48;
    /// <summary>A face by choice, as "skin=2,hair=1,style=-1,beard=1,scar=1"; null reads the world's record for this person, if any.</summary>
    [Parameter] public string? Look { get; set; }
    private string SpecNow => Spec(Id, Sex, Age, Accent, Alive, Look ?? G.World?.Cosmetics.GetValueOrDefault("look:" + Id));
    public static string Spec(string id, string sex, int age, string accent, bool alive = true, string? look = null)
    {
        string sexNow = sex.Length > 0 ? sex : (Math.Abs(id.GetHashCode()) % 2 == 0 ? "male" : "female");
        if (string.IsNullOrEmpty(look)) return System.Text.Json.JsonSerializer.Serialize(new { id, sex = sexNow, age, accent, alive });
        var parts = look.Split(',').Select(x => x.Split('=')).Where(x => x.Length == 2 && int.TryParse(x[1], out _)).ToDictionary(x => x[0], x => int.Parse(x[1]));
        return System.Text.Json.JsonSerializer.Serialize(new { id, sex = sexNow, age, accent, alive, look = new { skin = parts.GetValueOrDefault("skin", -1), hair = parts.GetValueOrDefault("hair", -1), style = parts.GetValueOrDefault("style", -1), beard = parts.GetValueOrDefault("beard", -1), scar = parts.GetValueOrDefault("scar", 0) == 1 } });
    }
    protected override async Task OnAfterRenderAsync(bool first) { try { await JS.InvokeVoidAsync("praetoriaBust.paint"); } catch { } }
}
