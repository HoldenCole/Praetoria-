@inject GameClient G
@{
    var m = Model; var w = G.World!; var c = G.Content!; var p = w.Protagonist!; var house = w.House(p.HouseId)!;
    var track = c.Careers.ById(p.CareerTrack); int maxRank = track?.MaxRank ?? 0;
    var skills = p.Skills.Where(k => k.Value > 0).OrderByDescending(k => k.Value).ThenBy(k => k.Key, StringComparer.Ordinal).ToList();
    var mine = w.History.Where(h => h.EventId != null && h.Text.Contains(p.Name)).Reverse().Take(12).ToList();
    var spouse = DynastySystem.Spouse(w, p);
    var heirNow = DynastySystem.FindHeir(w, w.Protagonist!);
    var children = w.Characters.Values.Where(k => k.MotherId == p.Id || k.FatherId == p.Id).OrderByDescending(k => k.Age).ToList();
    var ambition = c.Traits.Ambitions.FirstOrDefault(a => a.Id == p.Ambition);
    var honors = m.Standing?.Honors ?? new List<string>();
    var flags = p.Flags.Where(f => !f.StartsWith("background:") && !f.StartsWith("honor:")).OrderBy(f => f, StringComparer.Ordinal).ToList();
    var ties = m.Connections.OrderByDescending(x => Math.Abs(x.Disposition)).Take(10).ToList();
    int valour = w.Counter(FleetSystem.ValourKey(p.Id)); string style = SetCommandStyleCommand.StyleOf(p);
    // The picture (docs/DASHBOARDS.md): what you are, what state you are in, and what you are best at.
    int cap = LifeSystem.Cap(p.Age), renown = LifeSystem.Renown(p); string healthName = LifeSystem.HealthName(p.Health);
    bool ill = p.Flags.Contains(LifeSystem.IllChar), wounded = p.Flags.Contains(LifeSystem.WoundedChar);
    var best = skills.FirstOrDefault(); int bestCeil = best.Key != null ? EducationSystem.Ceiling(p, best.Key) : 0;
    string rankName = track?.RankName(p.CareerRank, w.Era) ?? p.CareerRank.ToString(), trackName = track?.NameIn(w.Era) ?? p.CareerTrack;
    string? nextRank = p.CareerRank < maxRank ? track?.RankName(p.CareerRank + 1, w.Era) : null;
    int renownNext = renown >= 70 ? 0 : renown >= 45 ? 70 : renown >= 25 ? 45 : renown >= 10 ? 25 : 10;
    string Mine(string said) => said.Replace("their own", "your own");
    string story, storyTone;
    if (m.Character.Broken) { story = $"The strain has broken you ({p.Stress} of 100). Until it eases you decide worse and are worse company; a season away is the cure."; storyTone = "bad"; }
    else if (p.Health < LifeSystem.Sound || ill || wounded) { story = $"You are {healthName}{(ill ? ", and ill" : "")}{(wounded ? ", and carrying a wound" : "")}: health {p.Health} of the {cap} a body of {p.Age} can have. Rest or the physicians come before anything else."; storyTone = p.Health < LifeSystem.Frail ? "bad" : "warn"; }
    else if (p.Stress >= 70) { story = $"The strain is telling: {p.Stress} of 100. A season away eases it; left alone it breaks you."; storyTone = "warn"; }
    else { story = $"{rankName} in {trackName} at {p.Age}, {healthName}, and {Mine(LifeSystem.RenownName(renown))}."
            + (best.Key != null ? $" Your best is {best.Key}, at {best.Value} of a possible {bestCeil}." : " You are untrained: skills grow from what you do, what you study and who teaches you.")
            + (ambition != null ? $" Your ambition is to {ambition.Name.ToLowerInvariant()}." : ""); storyTone = ""; }
}
@* The character window (docs/ART_DIRECTION.md, "The windows, one by one"): laid out as Crusader Kings III lays its own. The person at
   the top — a large portrait, who stands closest to them beside it, what they are like, what they are good at, the state they are
   in — and everything else behind tabs, so the first screen is the person and nothing has to be scrolled for. *@
<div class="dash sheet cw" style="--accent:@house.AccentColor">
    <header class="cw-head">
        <div class="hero-frame"><Portrait Id="@p.Id" Name="@p.Name" Sex="@p.Sex" Age="@p.Age" Alive="@p.Alive" Accent="@house.AccentColor" Size="188" /></div>
        <div class="cw-who">
            <div class="profile-house"><i></i>@house.Name · @G.Content!.Ancestries.Name(Lineage.Of(w, G.Content.Ancestries, p))</div>
            <h2>@p.Name</h2>
            @if (LifeSystem.Epithet(p).Length > 0) { <div class="profile-epithet">@LifeSystem.Epithet(p)</div> }
            <div class="profile-station">@rankName in @trackName · @m.Character.TitleName · @p.Age years@(m.Character.Background != null ? $" · {m.Character.Background}" : "")</div>
            <div class="cw-close">
                @if (spouse != null) { <div class="cw-near"><Portrait Id="@spouse.Id" Name="@spouse.Name" Sex="@spouse.Sex" Age="@spouse.Age" Alive="@spouse.Alive" Accent="@(w.House(spouse.HouseId)?.AccentColor ?? "#888")" Size="58" /><span>@(spouse.Sex == "female" ? "wife" : "husband")</span></div> }
                @if (heirNow != null) { <div class="cw-near heir"><Portrait Id="@heirNow.Id" Name="@heirNow.Name" Sex="@heirNow.Sex" Age="@heirNow.Age" Alive="@heirNow.Alive" Accent="@house.AccentColor" Size="58" /><span>heir</span></div> }
                @foreach (var k in children.Where(k => k.Alive && k.Id != heirNow?.Id).Take(4)) { <div class="cw-near"><Portrait Id="@k.Id" Name="@k.Name" Sex="@k.Sex" Age="@k.Age" Alive="@k.Alive" Accent="@house.AccentColor" Size="44" /><span>@(k.Sex == "female" ? "daughter" : "son")</span></div> }
                @if (spouse == null && heirNow == null) { <span class="muted small">Unwed and without an heir: the line is you.</span> }
            </div>
        </div>
    </header>
    <div class="cw-traits">
        @foreach (var t in m.Character.Nature) { <span class="cw-trait nature" title="@(TraitName(t) + " — " + TraitDesc(t))">@TraitName(t)</span> }
        @foreach (var t in m.Character.Aptitude) { <span class="cw-trait apt" title="@(TraitName(t) + " — " + TraitDesc(t))">@TraitName(t)</span> }
        @if (ambition != null) { <span class="cw-trait amb" title="@("Ambition — " + ambition.Description)">wants to @ambition.Name.ToLowerInvariant()</span> }
    </div>
    <div class="cw-skills">
        @foreach (var sk in skills.Take(6)) { <div class="cw-skill" title="@($"{char.ToUpper(sk.Key[0])}{sk.Key[1..]} — {sk.Value} of a possible {EducationSystem.Ceiling(p, sk.Key)}; every skill runs to ten. {SkillWords.For(sk.Key)}")"><b>@sk.Value</b><span>@sk.Key</span></div> }
        @if (skills.Count == 0) { <span class="muted small">Untrained. Skills grow from what you do, what you study and who teaches you.</span> }
    </div>
    <div class="tiles">
            <Tile Label="Rank" Value="@rankName" Share="@(maxRank > 0 ? 100 * p.CareerRank / maxRank : 0)"
                  Note="@($"{Ordinal(p.CareerRank + 1)} of {maxRank + 1} ranks in {trackName}" + (nextRank != null ? $" · next: {nextRank}" : " · the top of it"))" Title="How far you have risen in your own service. The bar is how far up its ladder you stand." />
            <Tile Label="Health" Value="@($"{p.Health} · {healthName}")" Share="@p.Health" Tone="@(p.Health < LifeSystem.Frail ? "bad" : p.Health < LifeSystem.Sound || ill || wounded ? "warn" : p.Health >= 80 ? "good" : "")"
                  Note="@((ill ? "ill · " : "") + (wounded ? "wounded · " : "") + $"at {p.Age} it can be no better than {cap}")" Title="Age lowers what it can be. Wounds, illness and great strain lower it. Rest and time restore it. It bears on how long you live." />
            <Tile Label="Renown" Value="@renown.ToString()" Share="@renown" Tone="@(renown >= 45 ? "good" : "")"
                  Note="@(Mine(LifeSystem.RenownName(renown)) + (renownNext > 0 ? $" · {LifeSystem.RenownName(renownNext)} at {renownNext}" : ""))" Title="What you are apart from your house: how far you rose and what you did." />
            <Tile Label="Strain" Value="@p.Stress.ToString()" Share="@p.Stress" Tone="@(m.Character.Broken ? "bad" : p.Stress >= 70 ? "warn" : "")"
                  Note="@(m.Character.Broken ? "broken" : p.Stress >= 70 ? "close to breaking, of 100" : p.Stress == 0 ? "none, of 100 · it tells at 70" : "of 100 · it tells at 70")" Title="What you carry. Hard choices and bad years add to it; rest takes it away." />
            <Tile Label="Your own purse" Value="@Money.Credits(p.Purse)" Tone="@(p.Purse > 0 ? "good" : "")" Note="apart from the house's treasury" Title="Yours, not the house's: physicians, gifts and bribes 'of your own' are paid from it, and it goes by your will. Move coin between the two in House, under Purses and the will." />
    </div>
    <nav class="cw-tabs">
        @foreach (var (id, label) in new[] { ("life", "A life"), ("family", "Family"), ("ties", "Relations"), ("learning", "Learning"), ("record", "Record") }) { var tid = id; <button class="rung @(_tab == tid ? "here" : "")" @onclick="() => _tab = tid">@label</button> }
    </nav>
    @if (_tab == "life")
    {
        <p class="headline @storyTone">@story</p>
        <section class="panel">
            <h3>Career · @trackName</h3>
            <div class="ladder">@for (int r = 0; r <= maxRank; r++) { <span class="rung @(r == p.CareerRank ? "here" : r < p.CareerRank ? "past" : "")">@(track?.RankName(r, G.World!.Era) ?? r.ToString())</span> }</div>
            <div class="kv"><span>Commands from</span><b>@(style == "front" ? "the front" : style == "flag" ? "the flag" : "the staff")@(valour > 0 ? $" · valour {valour}" : "")@(p.Flags.Contains(FleetSystem.AchillesFlag) ? " · the fleet will not fight without you" : "")</b></div>
            @if (ambition != null)
            {
                /* what the ambition asks, how near it is and what would bring it nearer (docs/PLAYTHROUGH.md, Medium, A first game) */
                var aim = Praetoria.Core.Presentation.OwnAim.For(G.World!, p);
                <div class="kv"><span>Ambition</span><b>@ambition.Name</b></div>
                @if (aim != null)
                {
                    string aimTarget = aim.Target;
                    <div class="aim" data-aim="@aim.Progress">
                        <div class="gauge" title="How near you are to what you want, from 0 to 100, reckoned as the ambitions of the house's other people are. Nothing in the game waits on it: it is yours to follow or not."><span>How near (of 100)</span><i><b style="width:@aim.Progress%" class="@(aim.Progress >= 70 ? "high" : aim.Progress < 25 ? "low" : "")"></b></i><em>@aim.Progress</em></div>
                        <div class="small">@(aim.Had ? "You have it. " : "")@aim.Stands</div>
                        @if (aim.Next.Length > 0) { <div class="small"><b>A next step:</b> @aim.Next <button class="opt inline tiny" @onclick="() => OnGo.InvokeAsync(aimTarget)">Go there ▸</button></div> }
                    </div>
                }
            }
            @if (honors.Count > 0) { <div class="kv"><span>Honours</span><b>@string.Join(", ", honors)</b></div> }
            @if (flags.Count > 0) { <div class="kv"><span>Marked as</span><b>@foreach (var f in flags) { <span class="mark-word" title="@Marks.Tip(f)">@Marks.Label(f)</span> }</b></div> }
        </section>
        <LifePanel />
        <FeudPanel />
    }
    else if (_tab == "family")
    {
        <section class="panel">
            <h3>Blood and bonds</h3>
            @if (spouse != null) { <div class="person"><Portrait Id="@spouse.Id" Name="@spouse.Name" Sex="@spouse.Sex" Age="@spouse.Age" Alive="@spouse.Alive" Accent="@(w.House(spouse.HouseId)?.AccentColor ?? "#888")" Size="30" /><span><b>@spouse.Name</b> <span class="muted">your spouse · @(spouse.Alive ? spouse.Age.ToString() : "†")@(spouse.HouseId != house.Id ? $" · of {w.House(spouse.HouseId)?.Name}" : "")</span></span></div> }
            else { <div class="muted">Unwed.</div> }
            @foreach (var k in children) { <div class="person"><Portrait Id="@k.Id" Name="@k.Name" Sex="@k.Sex" Age="@k.Age" Alive="@k.Alive" Accent="@house.AccentColor" Size="28" /><span><b>@k.Name</b> <span class="muted">@(k.Alive ? $"{k.Age}" : "†")@(c.Careers.RankName(k.CareerTrack, k.CareerRank, G.World!.Era) is { } rn ? $" · {rn}" : "")</span></span></div> }
            @if (children.Count == 0) { <div class="muted small">No children yet. The line is you.</div> }
        </section>
    }
    else if (_tab == "ties")
    {
        <section class="panel">
            <h3>Those who matter</h3>
            @if (ties.Count == 0) { <div class="muted small">Nobody outside your blood feels strongly about you yet, for or against.</div> }
            @foreach (var t in ties)
            {
                var ch = w.Char(t.Id)!; var th = w.House(ch.HouseId);
                <div class="tie"><Portrait Id="@ch.Id" Name="@ch.Name" Sex="@ch.Sex" Age="@ch.Age" Accent="@(th?.AccentColor ?? "#888")" Size="26" />
                    <span class="tn"><b>@t.Name</b> <span class="muted small">@t.Detail of @t.HouseName@(t.Bond.Length > 0 ? $" · {t.Bond}" : "")</span></span>
                    <span class="dbar"><i class="zero"></i><i class="fill @(t.Disposition >= 0 ? "pos" : "neg")" style="left:@(t.Disposition >= 0 ? 50 : 50 + t.Disposition / 2)%; width:@(Math.Abs(t.Disposition) / 2)%"></i></span>
                    <b class="@(t.Disposition < -20 ? "warn" : t.Disposition > 20 ? "good" : "")">@(t.Disposition >= 0 ? "+" : "")@t.Disposition</b></div>
            }
        </section>
    }
    else if (_tab == "learning") { <LearningPanel /> }
    else
    {
        <section class="panel">
            @if (mine.Count == 0) { <div class="empty-line">Nothing is written of you yet. It is what will be said of you.</div> }
            else { <h3>Your story so far</h3> }
            @foreach (var h in mine) { <div class="line small"><span class="muted">T@(h.Turn)</span> @h.Text</div> }
        </section>
    }
</div>

@code {
    private string _tab = "life";
    // an alert opens this window on its subject (docs/PLAYTHROUGH.md 15): "window:tab", or "window:tab:person"
    [Parameter] public EventCallback<string> OnGo { get; set; }
    [Parameter] public string Tab { get; set; } = "";
    [Parameter] public int TabStamp { get; set; }
    private static int _seenStamp;
    protected override void OnParametersSet() { if (TabStamp != _seenStamp) { _seenStamp = TabStamp; if (Tab.Length > 0) OpenOn(Tab); } }
    private void OpenOn(string tab) { if (tab is "life" or "family" or "learning" or "ties") _tab = tab; }
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    private static string Ordinal(int n) => n % 100 is 11 or 12 or 13 ? $"{n}th" : (n % 10) switch { 1 => $"{n}st", 2 => $"{n}nd", 3 => $"{n}rd", _ => $"{n}th" };
    private string TraitName(string id) => G.Content!.Traits.Nature.Concat(G.Content.Traits.Aptitude).FirstOrDefault(t => t.Id == id)?.Name ?? id;
    private string TraitDesc(string id) => G.Content!.Traits.Nature.Concat(G.Content.Traits.Aptitude).FirstOrDefault(t => t.Id == id)?.Description ?? "";
}
