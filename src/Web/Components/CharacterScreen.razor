@inject GameClient G
@{
    var m = Model; var w = G.World!; var c = G.Content!; var p = w.Protagonist!; var house = w.House(p.HouseId)!;
    var track = c.Careers.ById(p.CareerTrack); int maxRank = track?.MaxRank ?? 0;
    var skills = p.Skills.Where(k => k.Value > 0).OrderByDescending(k => k.Value).ThenBy(k => k.Key, StringComparer.Ordinal).ToList();
    var axes = new[] { "tactics", "gunnery", "leadership", "economics", "law", "oratory", "charisma", "intrigue" }.Union(skills.Select(s => s.Key)).Distinct().Take(10).ToList();
    var mine = w.History.Where(h => h.EventId != null && h.Text.Contains(p.Name)).Reverse().Take(12).ToList();
    var spouse = DynastySystem.Spouse(w, p);
    var children = w.Characters.Values.Where(k => k.MotherId == p.Id || k.FatherId == p.Id).OrderByDescending(k => k.Age).ToList();
    var ambition = c.Traits.Ambitions.FirstOrDefault(a => a.Id == p.Ambition);
    var honors = m.Standing?.Honors ?? new List<string>();
    var flags = p.Flags.Where(f => !f.StartsWith("background:") && !f.StartsWith("honor:")).OrderBy(f => f, StringComparer.Ordinal).ToList();
    var ties = m.Connections.OrderByDescending(x => Math.Abs(x.Disposition)).Take(10).ToList();
    int valour = w.Counter(FleetSystem.ValourKey(p.Id)); string style = SetCommandStyleCommand.StyleOf(p);
    string F(double v) => v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
    (double x, double y) Pt(int i, double r) { double a = -Math.PI / 2 + i * 2 * Math.PI / axes.Count; return (150 + r * Math.Cos(a), 150 + r * Math.Sin(a)); }
    string poly = string.Join(" ", axes.Select((k, i) => { var (x, y) = Pt(i, 20 + 100 * Math.Min(10, p.Skill(k)) / 10.0); return $"{F(x)},{F(y)}"; }));
}
<div class="dash sheet" style="--accent:@house.AccentColor">
    <header class="dash-head">
        <div class="dh-title"><Portrait Id="@p.Id" Name="@p.Name" Sex="@p.Sex" Age="@p.Age" Alive="@p.Alive" Accent="@house.AccentColor" Size="34" /> <b>@p.Name</b> <span class="muted">@m.Character.RankName of @house.Name · @m.Character.TitleName · @p.Age years@(m.Character.Background != null ? $" · {m.Character.Background}" : "")</span></div>
        <div class="dh-stats">
            <div class="stat"><span>Career</span><b>@(track?.RankName(p.CareerRank, G.World!.Era) ?? p.CareerRank.ToString()) <i class="muted">@(track?.NameIn(G.World!.Era) ?? p.CareerTrack)</i></b></div>
            <div class="stat @(p.Stress >= 70 ? "warn" : "")"><span>Stress</span><b>@p.Stress@(m.Character.Broken ? " · broken" : "")</b></div>
            <div class="stat"><span>Ambition</span><b>@(ambition?.Name ?? (p.Ambition.Length > 0 ? p.Ambition.Replace('_', ' ') : "none"))</b></div>
            <div class="stat"><span>Commands from</span><b>@(style == "front" ? "the front" : style == "flag" ? "the flag" : "the staff")@(valour > 0 ? $" · valour {valour}" : "")@(p.Flags.Contains(FleetSystem.AchillesFlag) ? " · ACHILLES" : "")</b></div>
            <div class="stat"><span>Honors</span><b>@honors.Count</b></div>
        </div>
    </header>
    <div class="dash-grid sheet-grid">
        <section class="panel">
            <h3><Icon Name="military" Size="13" /> The person</h3>
            <div class="sheet-top">
                <svg class="radar" viewBox="-30 -12 360 324" role="img" aria-label="skills">
                    @foreach (var r in new[] { 40, 60, 80, 100, 120 }) { <circle cx="150" cy="150" r="@r" class="grid" /> }
                    @foreach (var (k, i) in axes.Select((k, i) => (k, i))) { var (x, y) = Pt(i, 120); var (lx, ly) = Pt(i, 138); <line x1="150" y1="150" x2="@F(x)" y2="@F(y)" class="axis" />@((MarkupString)$"<text x=\"{F(lx)}\" y=\"{F(ly)}\" class=\"ax\">{System.Net.WebUtility.HtmlEncode(k)} {p.Skill(k)}</text>") }
                    <polygon points="@poly" class="shape" />
                    @foreach (var (k, i) in axes.Select((k, i) => (k, i))) { var (x, y) = Pt(i, 20 + 100 * Math.Min(10, p.Skill(k)) / 10.0); <circle cx="@F(x)" cy="@F(y)" r="3.5" class="pt" /> }
                </svg>
                <div class="sheet-facts">
                    <div class="traits">
                        @foreach (var t in m.Character.Nature) { <span class="trait nature" title="@TraitDesc(t)">@TraitName(t)</span> }
                        @foreach (var t in m.Character.Aptitude) { <span class="trait apt" title="@TraitDesc(t)">@TraitName(t)</span> }
                    </div>
                    <h4>Career · @(track?.NameIn(G.World!.Era) ?? p.CareerTrack)</h4>
                    <div class="ladder">@for (int r = 0; r <= maxRank; r++) { <span class="rung @(r == p.CareerRank ? "here" : r < p.CareerRank ? "past" : "")">@(track?.RankName(r, G.World!.Era) ?? r.ToString())</span> }</div>
                    @if (ambition != null) { <div class="kv"><span><Icon Name="ambition" Size="12" /> Ambition</span><b>@ambition.Name</b></div><p class="muted small">@ambition.Description</p> }
                    <div class="gauge" title="stress"><span>Stress</span><i><b style="width:@p.Stress%" class="@(p.Stress >= 70 ? "low" : "")"></b></i><em>@p.Stress</em></div>
                    @if (honors.Count > 0) { <div class="kv"><span><Icon Name="honor" Size="12" /> Honors</span><b>@string.Join(", ", honors)</b></div> }
                    @if (flags.Count > 0) { <div class="chips">@foreach (var f in flags) { <span class="pill small">@f.Replace('_', ' ')</span> }</div> }
                    @if (skills.Count == 0) { <div class="muted small">Untrained. Skills grow from what you do, what you study and who teaches you.</div> }
                </div>
            </div>
        </section>
        <LearningPanel />
        <section class="panel">
            <h3><Icon Name="marriage" Size="13" /> Blood and bonds</h3>
            @if (spouse != null) { <div class="person"><Portrait Id="@spouse.Id" Name="@spouse.Name" Sex="@spouse.Sex" Age="@spouse.Age" Alive="@spouse.Alive" Accent="@(w.House(spouse.HouseId)?.AccentColor ?? "#888")" Size="30" /><span><b>@spouse.Name</b> <span class="muted">your spouse · @(spouse.Alive ? spouse.Age.ToString() : "†")@(spouse.HouseId != house.Id ? $" · of {w.House(spouse.HouseId)?.Name}" : "")</span></span></div> }
            else { <div class="muted">Unwed.</div> }
            @foreach (var k in children) { <div class="person"><Portrait Id="@k.Id" Name="@k.Name" Sex="@k.Sex" Age="@k.Age" Alive="@k.Alive" Accent="@house.AccentColor" Size="28" /><span><b>@k.Name</b> <span class="muted">@(k.Alive ? $"{k.Age}" : "†")@(c.Careers.RankName(k.CareerTrack, k.CareerRank, G.World!.Era) is { } rn ? $" · {rn}" : "")</span></span></div> }
            @if (children.Count == 0) { <div class="muted small">No children yet. The line is you.</div> }
            <h4>Those who matter <span class="muted">by the strength of their feeling</span></h4>
            @foreach (var t in ties)
            {
                var ch = w.Char(t.Id)!; var th = w.House(ch.HouseId);
                <div class="tie"><Portrait Id="@ch.Id" Name="@ch.Name" Sex="@ch.Sex" Age="@ch.Age" Accent="@(th?.AccentColor ?? "#888")" Size="26" />
                    <span class="tn"><b>@t.Name</b> <span class="muted small">@t.Detail of @t.HouseName@(t.Bond.Length > 0 ? $" · {t.Bond}" : "")</span></span>
                    <span class="dbar"><i class="zero"></i><i class="fill @(t.Disposition >= 0 ? "pos" : "neg")" style="left:@(t.Disposition >= 0 ? 50 : 50 + t.Disposition / 2)%; width:@(Math.Abs(t.Disposition) / 2)%"></i></span>
                    <b class="@(t.Disposition < -20 ? "warn" : t.Disposition > 20 ? "good" : "")">@(t.Disposition >= 0 ? "+" : "")@t.Disposition</b></div>
            }
        </section>
        <aside class="dash-side">
            <section class="panel">
                <h3><Icon Name="chronicle" Size="13" /> Your story so far</h3>
                @if (mine.Count == 0) { <div class="muted">Nothing written yet.</div> }
                @foreach (var h in mine) { <div class="line small"><span class="muted">T@(h.Turn)</span> @h.Text</div> }
            </section>
        </aside>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    private string TraitName(string id) => G.Content!.Traits.Nature.Concat(G.Content.Traits.Aptitude).FirstOrDefault(t => t.Id == id)?.Name ?? id;
    private string TraitDesc(string id) => G.Content!.Traits.Nature.Concat(G.Content.Traits.Aptitude).FirstOrDefault(t => t.Id == id)?.Description ?? "";
}
