@preservewhitespace true
@using Praetoria.Core.Systems
@inject GameClient G
@implements IDisposable
@* Breaking away, on the Senate window's Orders (docs/BREAKAWAY.md; docs/VISUAL_SYSTEM.md 4.6, 4.7): the peace of the Reach as a line and a
   meter, stirring the camps, then each region the house holds as an entry: what it controls, whether the Reach would fight, whether it
   could stand alone, and the houses there with their faces and the plates to work them; the form to declare as, and the states gone. *@
@{
    var w = G.World!; var p = w.Protagonist!; var pid = p.Id; var house = w.House(p.HouseId)!; var ps = G.Turn!.Polities; var gc = G.Turn.GreatCrisis;
    var own = PolitySystem.Of(w, house.Id); var others = w.Polities.Where(x => x != own).OrderBy(x => x.Since).ToList();
    var regions = own == null ? PolitySystem.RegionsOf(w, house) : new();
    bool greatWar = CaesarSystem.GreatWar(w); int warYears = GreatCrisisSystem.WarYears(w); string? ending = greatWar ? gc.Ending(w) : null;
    string warLine = !greatWar ? "" : "The War of the Reach is in its " + Ordinal(warYears + 1) + " year. It will not end before the " + Ordinal(GreatCrisisSystem.MinWarYears) + ", and then only when one side is crushed, a side that cannot win takes a region out of the Reach, or both are spent. Holding the capital is winning, not having won. "
        + (warYears < GreatCrisisSystem.MinWarYears ? "" : ending == null ? "As things stand it goes on." : "As things stand it would end " + EndingSays(ending) + ".");
    string? noPartition = greatWar && own == null ? new SecessionCommand(pid, SecessionCommand.SeekPartition, "", "", ps).Refusal(G.Ctx) : "not now";
    var pressure = GreatCrisisSystem.Pressure(w); int near = gc.Nearness(w); bool warOver = w.HasFlag(GreatCrisisSystem.ResolvedFlag);
    var pastWars = GreatCrisisSystem.Past(w); string pastLine = pastWars.Count == 0 ? "" : "Great wars fought: " + string.Join("; ", pastWars.Select((x, i) => (i == 0 ? "the first" : i == 1 ? "the second" : "another") + " from year " + x.began + ", " + x.years + " years, ended " + EndingSays(x.how))) + ".";
    int peaceLeft = GreatCrisisSystem.PeaceLeft(w); int wars = w.Counter(GreatCrisisSystem.WarsCounter);
    string? noStir = new SecessionCommand(pid, SecessionCommand.Stir, "", "", ps).Refusal(G.Ctx); bool stirring = PolitySystem.Stirring(w);
    var great = w.Houses.Values.Where(h => h.Id != house.Id && h.Id != PirateSystem.HouseId && PolitySystem.InReach(w, h.Id) && Economy.HeadOf(w, h) != null).OrderByDescending(h => FleetSystem.StrengthOf(w, h.Id)).ThenBy(h => h.Id, StringComparer.Ordinal).Take(4).ToList();
    string? noLeave = own == null ? "not of a state" : new SecessionCommand(pid, SecessionCommand.Leave, "", "", ps).Refusal(G.Ctx);
    string promisedLine = own == null || own.Promised.Count == 0 ? "" : "Promised a place, and paid " + Money.Credits(PolitySystem.PromiseCredits) + " a year by its ruler until year " + (own.Since + PolitySystem.PledgeYears) + ": " + string.Join(", ", own.Promised.Select(id => id == house.Id ? "your house" : w.House(id)?.Name ?? id)) + ".";
    var court = own != null && own.HeadHouseId == house.Id ? w.Houses.Values.Where(h => PolitySystem.Courtable(w, own, h)).OrderBy(h => h.Id, StringComparer.Ordinal).Take(6).ToList() : new List<House>();
    string stirLine = stirring ? "Somebody's money is setting the great houses against one another, until year " + w.Counter(PolitySystem.StirKey) + "." : "";
    string peace = warOver ? "The Reach has fought its great war" + (wars > 1 ? " (" + wars + " of them now)" : "") + ". For " + Counted.MoreYears(peaceLeft) + " nobody will be stirred to another; after that it is something people were told about, and what is wrong with the Reach can bring one again. " : greatWar ? "" : near == 0 && pressure.Count == 0 ? "The Reach is at peace with itself, and nothing is pushing it toward a great war. "
        : (near < 15 ? "The Reach is quiet" : near < 50 ? "The Reach is uneasy" : "The houses are counting each other's fleets") + " (" + near + " in a hundred of the way to a great war). "
          + (pressure.Count == 0 ? "Nothing is pushing it that way this year, and it is easing." : "What is pushing it: " + string.Join("; ", pressure.Select(x => x.what)) + ". Put those right and it recedes.");
    string treatyLine = own == null || own.Recognised == 0 ? "" : "The Reach named it in a treaty in year " + own.Recognised + ". "
        + (w.Turn < own.TreatyUntil ? "Until year " + own.TreatyUntil + " no house of the Reach may make war on it, nor it on them. After that the Senate may vote to come back for it, if the Reach is rested and thinks it can."
                                    : "The treaty's years have run out. The Senate may vote to come back for it, if the Reach is rested and thinks it can.")
        + (own.Reconquests > 0 ? " It has been come back for " + Counted.Times(own.Reconquests) + " already." : "");
    string ownLine = "", ownWar = "";
    if (own != null)
    {
        var ruler = w.House(own.HeadHouseId); var head = ruler != null ? Economy.HeadOf(w, ruler) : null; bool rule = own.HeadHouseId == house.Id;
        ownLine = (rule ? "You are " + PolitySystem.RulerStyle(own.Form, head) + " of " : "Your house is of ") + own.Name + ", " + PolitySystem.FormName(own.Form) + ", since year " + own.Since + ". "
            + (rule ? "" : (head?.Name ?? ruler?.Name) + " is its " + PolitySystem.RulerStyle(own.Form, head) + ". ")
            + "Its houses: " + string.Join(", ", own.Members.Select(id => id == house.Id ? "yours" : w.House(id)?.Name ?? id)) + ". It has no seat in the Senate and answers to nobody.";
        if (own.Recognised == 0)
        {
            int will = PolitySystem.Will(w, own), share = PolitySystem.Share(w, own), lead = PolitySystem.Standing(w, own), years = w.Turn - own.WarSince;
            ownWar = "The Reach has not accepted it. " + string.Join(", ", own.Foes.Select(id => w.House(id)?.Name ?? id)) + " are at war to bring it back, " + Counted.Years(years) + " now. "
                + "Its houses hold " + share + "% of the region (lose it below " + PolitySystem.LostShare + "% and the state is finished). The war stands at " + (lead > 0 ? "+" + lead : Counted.Figure(lead)) + ". "
                + (will <= 0 ? "The Reach has no will left for it" : "The Reach's will for it is " + will + ", and falls by one every " + PolitySystem.TemperFallsEvery + " years")
                + ": hold more than half the region for " + PolitySystem.WinYears + " years and outlast or beat them, and they make peace.";
        }
    }
}
<section class="panel breakaway sn-panel">
    <Section Title="Breaking away" Info="@($"A house that controls a region may take it out of {(w.IsImperium ? "the Imperium" : "the Republic")} and found a state of its own: a republic, a republic under one hand, or a kingdom. It must hold a quarter of the region's worlds itself, and three in five with the houses there that would follow it. Whether the Reach fights for it depends on its temper. You may also declare with what you have and fight for as long as you can.")">
        <Right>@if (!greatWar && !warOver) { <span title="How far the Reach is on the way to a great war, in a hundred">@near in a hundred to a great war</span> } else if (greatWar) { <span class="ui-down">the great war, year @(warYears + 1)</span> }</Right>
    </Section>
    @if (peace.Length > 0)
    {
        @* a row (4.7): the glyph, "The peace of the Reach", what holds it or what pushes it, and the way to a great war as its meter *@
        <div class="ac-fact sn-peace">
            <Row Name="The peace of the Reach" SubText="@peace" Wrap="true" Class="sn-pr">
                <Picture><span class="sn-ic @(near >= 50 ? "bad" : "")"><Icon Name="@(warOver ? "laurels" : near < 15 ? "dove" : "threat")" Tone="@(near >= 50 ? "ember" : near < 15 ? "good" : "brass")" Size="22" /></span></Picture>
                <Cells>@if (!warOver && !greatWar) { <span class="sn-peacem"><Meter Label="Toward war" Value="@near" Max="100" Color="@(near < 15 ? "#a5813a" : near < 50 ? "#e3a64a" : "#b8452f")" Tip="@($"{near} in a hundred of the way to a great war")" /></span> }</Cells>
            </Row>
        </div>
    }
    @if (pastLine.Length > 0) { <p class="sn-say sn-pad ui-dim">@pastLine</p> }
    @if (own == null && !greatWar)
    {
        <div class="sn-acts sn-pad suit-acts">
            <Plate Label="Stir the camps" Small="true" Icon="cowled" Locked="@(noStir != null)" Disabled="@(noStir != null)" Tip="@(noStir ?? StirTip)" OnClick="() => G.Execute(new SecessionCommand(pid, SecessionCommand.Stir, string.Empty, string.Empty, ps))"><Cost><Icon Name="public-speaker" Tone="brass" Size="14" />@PolitySystem.StirInfluence <Icon Name="credits" Tone="brass" Size="14" />@Money.Show(PolitySystem.StirCredits)</Cost></Plate>
            @if (stirLine.Length > 0) { <span class="sn-say ui-warn-t">@stirLine</span> }
            @if (noStir != null) { <span class="sn-no">@Cap(noStir)</span> }
        </div>
        @if (noStir == null && great.Count > 0)
        {
            <div class="sn-acts sn-pad suit-acts">
                <span class="sn-lbl">Or set them against one house</span>
                @{ var against = great.FirstOrDefault(x => x.Id == _against) ?? great[0]; string gid = against.Id; }
                <Select Value="@gid" Options="@great.Select(x => new Select.Option(x.Id, x.Name)).ToList()" OnChange="v => _against = v" Class="sn-pledge-sel" />
                <Plate Label="Stir against them" Small="true" Icon="cowled" Tip="@StirAgainstTip" OnClick="() => G.Execute(new SecessionCommand(pid, SecessionCommand.Stir, gid, string.Empty, ps))" data-stir-against="@gid" />
            </div>
        }
    }
    @if (own != null)
    {
        <p class="sn-say sn-pad">@ownLine</p>
        @if (ownWar.Length > 0) { <div class="ui-wstrip bad sn-strip caesar-recall"><Icon Name="war" Tone="ember" Size="18" /><span class="ui-wstrip-t"><b>A war of independence.</b> @ownWar</span></div> }
        else { <p class="sn-say sn-pad ui-dim">@treatyLine</p> }
        @if (own.HeadHouseId == house.Id)
        {
            <div class="sn-acts sn-pad suit-acts">
                @if (_confirm == RejoinKey) { <Plate Label="Yes: take the state back into the Reach" Small="true" Class="sn-veto" Tip="@RejoinTip" OnClick="() => { _confirm = string.Empty; G.Execute(new SecessionCommand(pid, SecessionCommand.Rejoin, string.Empty, string.Empty, ps)); }" /> <Plate Label="No" Small="true" Tip="Keep the state" OnClick="() => _confirm = string.Empty" /> }
                else { <Plate Label="Rejoin the Reach" Small="true" Icon="greek-temple" Tip="@RejoinTip" OnClick="() => _confirm = RejoinKey" /> }
            </div>
            @foreach (var h in court)
            {
                string hid = h.Id; int regard = PolitySystem.Regard(w, h, house);
                string? noWord = new WorkHouseCommand(pid, hid, PolitySystem.Word, ps).Refusal(G.Ctx); string? noGift = new WorkHouseCommand(pid, hid, PolitySystem.Gift, ps).Refusal(G.Ctx);
                string cLine = h.Name + " is of the Reach and holds worlds in your state or beside it (regard " + Counted.Figure(regard) + "; at " + PolitySystem.GoesOverRegard + ", and no friend of the capital, it may come over).";
                <div class="sn-hrow suit-acts">
                    <Sigil HouseId="@h.Id" Accent="@h.AccentColor" Size="20" />
                    <span class="sn-say">@cLine</span>
                    <span class="sn-acts">
                        <Plate Label="A quiet word" Small="true" Locked="@(noWord != null)" Disabled="@(noWord != null)" Tip="@(noWord ?? CourtTip)" CostIcon="public-speaker" CostText="@PolitySystem.WordInfluence.ToString()" OnClick="() => G.Execute(new WorkHouseCommand(pid, hid, PolitySystem.Word, ps))" />
                        <Plate Label="A gift" Small="true" Locked="@(noGift != null)" Disabled="@(noGift != null)" Tip="@(noGift ?? CourtTip)" CostIcon="credits" CostText="@Money.Show(PolitySystem.GiftCredits)" OnClick="() => G.Execute(new WorkHouseCommand(pid, hid, PolitySystem.Gift, ps))" />
                    </span>
                </div>
            }
        }
        else
        {
            <div class="sn-acts sn-pad suit-acts">
                @if (_confirm == LeaveKey) { <Plate Label="Yes: leave it, and go back to the Reach" Small="true" Class="sn-veto" Tip="@LeaveTip" OnClick="() => { _confirm = string.Empty; G.Execute(new SecessionCommand(pid, SecessionCommand.Leave, string.Empty, string.Empty, ps)); }" /> <Plate Label="No" Small="true" Tip="Stay in the state" OnClick="() => _confirm = string.Empty" /> }
                else { <Plate Label="Leave the state" Small="true" Locked="@(noLeave != null)" Disabled="@(noLeave != null)" Tip="@(noLeave ?? LeaveTip)" OnClick="() => _confirm = LeaveKey" /> }
            </div>
        }
        @if (promisedLine.Length > 0) { <p class="sn-say sn-pad ui-dim">@promisedLine</p> }
    }
    else
    {
        @if (greatWar)
        {
            <div class="ui-wstrip bad sn-strip caesar-recall"><Icon Name="war" Tone="ember" Size="18" />
                <span class="ui-wstrip-t"><b>The great war.</b> @warLine</span>
                <Plate Label="Take a region as the price" Small="true" Locked="@(noPartition != null)" Disabled="@(noPartition != null)" Tip="@((noPartition ?? PartitionTip) + " Let it be known you would take a region as the price of peace.")" OnClick="() => G.Execute(new SecessionCommand(pid, SecessionCommand.SeekPartition, string.Empty, string.Empty, ps))" />
            </div>
        }
        @if (regions.Count == 0) { <p class="sn-say sn-pad ui-dim">The house holds no world.</p> }
        @foreach (var r in regions.Take(4))
        {
            string rid = r.Id; var (mine, with, total, backers) = PolitySystem.Control(w, house, r.Id); var (temper, why) = ps.Temper(w, house, r.Id);
            string? no = new SecessionCommand(pid, SecessionCommand.Declare, rid, _form, ps).Refusal(G.Ctx);
            string holdLine = "You hold " + mine + " of its " + total + " worlds" + (backers.Count > 0 ? "; with " + string.Join(", ", backers.Select(b => b.Name)) + ", " + with : "; nobody else there would follow you") + ".";
            var alone = ps.StandAlone(w, house, r.Id);
            var here = PolitySystem.Neighbours(w, house).Where(h => w.Holdings.Values.Any(x => x.IsPlanet && x.OwnerId == h.Id && w.Galaxy!.System(x.SystemId)?.RegionId == rid)).ToList();
            string temperLine = (temper <= 0 ? "The Reach would let it go" : "The Reach would fight for it (will " + temper + ")") + (why.Count > 0 ? ": " + string.Join("; ", why) + "." : ".");
            <div class="sn-ent rung-row" data-region="@rid">
                <span class="sn-ic"><Icon Name="region" Tone="ivory" Size="22" /></span>
                <div class="sn-ent-main">
                    <div class="sn-hd"><b class="sn-nm">@r.Name</b><span class="sn-sub">@r.Ring</span><span class="sn-fig" title="Worlds you hold of the region's"><Icon Name="ringed-planet" Tone="ivory" Size="15" />@mine<small>/@total</small></span></div>
                    <div class="sn-tx">@holdLine</div>
                    <div class="sn-tx @(temper <= 0 ? "ui-dim" : "ui-warn-t")">@temperLine</div>
                    @if (alone.tests.Count > 0)
                    {
                        <div class="sn-tests">
                            @foreach (var t in alone.tests) { <div class="gate-row sn-test pip @(t.ok ? "met" : "warn")" title="@($"{(t.ok ? Yes : No)}: {t.name}. {Cap(t.says)}")"><span class="pill small @(t.ok ? GoodPill : "bad")"><Icon Name="@(t.ok ? "check" : "close")" Tone="@(t.ok ? "good" : "ember")" Size="12" /></span><b>@t.name</b><span class="sn-test-says">@t.says</span></div> }
                        </div>
                    }
                    @foreach (var h in here)
                    {
                        string hid = h.Id; bool joins = PolitySystem.Joins(w, h, house); int regard = PolitySystem.Regard(w, h, house);
                        string? noWord = new WorkHouseCommand(pid, hid, PolitySystem.Word, ps).Refusal(G.Ctx); string? noGift = new WorkHouseCommand(pid, hid, PolitySystem.Gift, ps).Refusal(G.Ctx);
                        bool bound = PolitySystem.Bound(w, h, house), cowed = PolitySystem.Cowed(w, h, house), promised = PolitySystem.IsPromised(w, h, house); int need = PolitySystem.JoinRegard - (bound ? PolitySystem.MarriageEases : 0);
                        string? noPromise = new WorkHouseCommand(pid, hid, PolitySystem.Promise, ps).Refusal(G.Ctx); string? noThreat = new WorkHouseCommand(pid, hid, PolitySystem.Threat, ps).Refusal(G.Ctx);
                        string hLine = h.Name + (joins ? " would follow you" : " would not follow you") + " (regard " + Counted.Figure(regard) + " of " + need + (bound ? ", bound to you by a marriage" : "") + (cowed ? ", afraid of you" : "") + (promised ? ", promised a place" : "") + ").";
                        <div class="sn-hrow suit-acts">
                            <Sigil HouseId="@h.Id" Accent="@h.AccentColor" Size="20" />
                            <span class="sn-say @(joins ? "ui-up" : "")">@hLine</span>
                            <span class="sn-acts">
                                <Plate Label="A quiet word" Small="true" Locked="@(noWord != null)" Disabled="@(noWord != null)" Tip="@(noWord ?? WordTip)" CostIcon="public-speaker" CostText="@PolitySystem.WordInfluence.ToString()" OnClick="() => G.Execute(new WorkHouseCommand(pid, hid, PolitySystem.Word, ps))" />
                                <Plate Label="A gift" Small="true" Locked="@(noGift != null)" Disabled="@(noGift != null)" Tip="@(noGift ?? GiftTip)" CostIcon="credits" CostText="@Money.Show(PolitySystem.GiftCredits)" OnClick="() => G.Execute(new WorkHouseCommand(pid, hid, PolitySystem.Gift, ps))" />
                                <Plate Label="Promise a place" Small="true" Locked="@(noPromise != null)" Disabled="@(noPromise != null)" Tip="@(noPromise ?? PromiseTip)" OnClick="() => G.Execute(new WorkHouseCommand(pid, hid, PolitySystem.Promise, ps))" />
                                <Plate Label="Threaten" Small="true" Locked="@(noThreat != null)" Disabled="@(noThreat != null)" Tip="@(noThreat ?? ThreatTip)" OnClick="() => G.Execute(new WorkHouseCommand(pid, hid, PolitySystem.Threat, ps))" />
                            </span>
                        </div>
                    }
                    @foreach (var st in others.Where(o => o.Recognised > 0 && o.Regions.Any(x => PolitySystem.Borders(w, x, rid))))
                    {
                        string stid = st.Id; string? noTake = new SecessionCommand(pid, SecessionCommand.Join, rid, stid, ps).Refusal(G.Ctx); string takeLabel = "Take " + r.Name + " into " + st.Name; string key = rid + ">" + stid;
                        <div class="sn-acts suit-acts">
                            @if (_confirm == key) { <Plate Label="@("Yes: " + takeLabel)" Small="true" Class="sn-veto" Tip="@TakeTip" OnClick="() => { _confirm = string.Empty; G.Execute(new SecessionCommand(pid, SecessionCommand.Join, rid, stid, ps)); }" /> <Plate Label="No" Small="true" Tip="Not now" OnClick="() => _confirm = string.Empty" /> }
                            else { <Plate Label="@takeLabel" Small="true" Locked="@(noTake != null)" Disabled="@(noTake != null)" Tip="@(noTake ?? TakeTip)" OnClick="() => _confirm = key" /> }
                            @if (noTake != null) { <span class="sn-no">@Cap(noTake).</span> }
                        </div>
                    }
                    <div class="sn-acts suit-acts">
                        @if (_confirm == rid) { <Plate Label="@("Yes: declare " + PolitySystem.NameFor(_form, r.Name))" Small="true" Class="sn-veto" Tip="@DeclareTip" OnClick="() => { _confirm = string.Empty; G.Execute(new SecessionCommand(pid, SecessionCommand.Declare, rid, _form, ps)); }" /> <Plate Label="No" Small="true" Tip="Not now" OnClick="() => _confirm = string.Empty" /> }
                        else { <Plate Label="Declare independence" Small="true" Icon="flying-flag" Locked="@(no != null)" Disabled="@(no != null)" Tip="@(no ?? DeclareTip)" OnClick="() => _confirm = rid" /> }
                        @if (no != null) { <span class="sn-no">@Cap(no).</span> }
                    </div>
                </div>
            </div>
        }
        @if (regions.Count > 0)
        {
            <div class="sn-acts sn-pad suit-acts sn-forms">
                <span class="ui-seg-l">As:</span>
                <span class="ui-seg">@foreach (var f in PolitySystem.Forms) { string form = f; <button class="@(_form == form ? Chosen : string.Empty)" title="@($"Declare the state as {PolitySystem.FormName(form)}")" @onclick="() => _form = form">@Cap(PolitySystem.FormName(form))</button> }</span>
            </div>
        }
    }
    @if (others.Count > 0)
    {
        <Section Title="States that have left" Count="@others.Count.ToString()" Info="States that have left the Reach: free holds of one world, and states under a ruler. A motion to go back for one is moved in the Senate, under Motions." Class="sn-sub-sec">
            @foreach (var o in others.Where(PolitySystem.IsFreeHold))
            {
                var world = w.HoldingsOf(o.HeadHouseId).FirstOrDefault(h => h.IsPlanet); string was = world != null && w.House(world.FormerOwnerId) is { } old ? ", once " + old.Name + "'s" : "";
                <div class="sn-hrow"><Sigil HouseId="@o.HeadHouseId" Accent="@(w.House(o.HeadHouseId)?.AccentColor ?? "#888")" Size="20" /><span class="sn-say">@(Cap(o.Name))@was, a free hold since year @o.Since: @(o.Recognised == 0 ? "sworn to no one, and named in no treaty yet" : w.Turn < o.TreatyUntil ? "named in a treaty that holds until year " + o.TreatyUntil : "its treaty run out"). Its old holder may buy it back or take it; the Senate does not go back for one world.</span></div>
            }
            @foreach (var o in others.Where(x => !PolitySystem.IsFreeHold(x)))
            {
                string line = Cap(o.Name) + ", " + PolitySystem.FormName(o.Form) + " under " + (w.House(o.HeadHouseId)?.Name ?? o.HeadHouseId) + ", since year " + o.Since
                    + (o.Recognised == 0 ? ", still fighting for it" : w.Turn < o.TreatyUntil ? ", under treaty until year " + o.TreatyUntil : ", its treaty run out") + ". A motion to go back for it is moved on the Senate screen.";
                <div class="sn-hrow"><Sigil HouseId="@o.HeadHouseId" Accent="@(w.House(o.HeadHouseId)?.AccentColor ?? "#888")" Size="20" /><span class="sn-say">@line</span>
                @if (own == null)
                {
                    string oid = o.Id; string? noGo = new SecessionCommand(pid, SecessionCommand.Join, string.Empty, oid, ps).Refusal(G.Ctx); string goKey = "go>" + oid;
                    <span class="sn-acts suit-acts">
                        @if (_confirm == goKey) { <Plate Label="@("Yes: go over to " + o.Name)" Small="true" Class="sn-veto" Tip="@GoOverTip" OnClick="() => { _confirm = string.Empty; G.Execute(new SecessionCommand(pid, SecessionCommand.Join, string.Empty, oid, ps)); }" /> <Plate Label="No" Small="true" Tip="Not now" OnClick="() => _confirm = string.Empty" /> }
                        else { <Plate Label="Go over to it" Small="true" Locked="@(noGo != null)" Disabled="@(noGo != null)" Tip="@(noGo ?? GoOverTip)" OnClick="() => _confirm = goKey" /> }
                        @if (noGo != null) { <span class="sn-no">@Cap(noGo).</span> }
                    </span>
                }
                </div>
            }
        </Section>
    }
</section>

@code {
    /// <summary>The great house the camps would be set against, as chosen in the select.</summary>
    private string? _against;
    private string _form = PolitySystem.Republic, _confirm = "";
    private const string RejoinKey = "@rejoin", LeaveKey = "@leave";
    private const string LeaveTip = "Your house goes back to the Reach with its worlds and takes its seat in the Senate again. The state's ruler will not forgive it; the capital will be glad of it.";
    private const string PromiseTip = "Their regard for you rises by 15 at once. If the state is founded with them in it, you owe them 300 credits a year for ten years; a ruler who cannot pay is thought the less of, and a house that comes to think ill of its ruler leaves.";
    private const string ThreatTip = "It takes three hulls to their one. They will follow you for as long as they are afraid, think 20 the less of you, and leave the state the day they are not.";
    private const string CourtTip = "Their regard for you rises. A house of the Reach that thinks well of a state's ruler and ill of the capital may come over by itself, with its worlds or with a whole region on your border.";
    private const string StirAgainstTip = "The same price and the same risk. The five strongest of the other houses each think 8 the less of this one. If the capital hears whose money it was, so does this house.";
    private const string RejoinTip = "The state ends and its houses take their seats in the Senate again. At peace it comes back whole, and the capital thinks the better of you. In the middle of its war it comes back on the Reach's terms, which are lighter than defeat.";
    private const string Chosen = "on", GoodPill = "good", Yes = "yes", No = "no";
    private const string WordTip = "Their regard for you rises. At 25 they give their word to go with the region. A house that is the capital's creature and no friend of yours will report it.";
    private const string GiftTip = "Their regard for you rises more than a word buys, and more still if they are poor. The same risk.";
    private const string DeclareTip = "The house leaves the Senate, its offices and its party, and takes the region and the houses that would follow. If the Reach will fight, it is war until it tires, is beaten, or takes the region back.";
    private const string StirTip = "Money and letters in the right places, for three years. It pushes the Reach toward its great war. One time in three the capital hears whose money it was: it thinks 15 the less of you, and your house loses standing.";
    private const string TakeTip = "Your house and those that would follow leave the Senate and take the region into that state. If the Reach has the will to fight for it, it calls the treaty broken and comes for the whole state.";
    private const string GoOverTip = "Your house leaves the Senate, its offices and its party and becomes a house of that state, under its ruler. The capital will not forgive it.";
    private const string PartitionTip = "If your side cannot win the great war but holds a region, the peace will leave it to you as a state of your own. Without this the war goes on and your house stays in the Reach.";
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    private static string Ordinal(int n) => n + (n % 100 is >= 11 and <= 13 ? "th" : (n % 10) switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" });
    private static string EndingSays(string e) => e switch { GreatCrisisSystem.Crushed => "with one side crushed", GreatCrisisSystem.PartitionEnd => "in a partition", GreatCrisisSystem.Exhaustion => "in exhaustion", _ => "with the capital held" };
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;
}
