@preservewhitespace true
@using Praetoria.Core.Systems
@inject GameClient G
@implements IDisposable
@* Your duties this year, on the Senate window (docs/LADDER.md, "Duties"; docs/VISUAL_SYSTEM.md 4.6, 4.7): each position that asks
   something of the head this year is an entry with its glyph, what it is, and its choices as plates with what each does beside it;
   a duty done is one quiet line. What the officers of the Reach did follows. *@
@{
    var w = G.World!; var c = G.Content!; var p = w.Protagonist!; var pid = p.Id; var house = w.House(p.HouseId)!; var offices = c.Offices; var policy = c.Policies;
    var seat = LadderSystem.DutyOf(w, pid, LadderSystem.SeatKind); var bench = LadderSystem.DutyOf(w, pid, LadderSystem.Hearing, LadderSystem.Appeal);
    var charge = LadderSystem.DutyOf(w, pid, LadderSystem.Charge); string chargeTitle = charge == null ? "" : "Your charge as " + (offices.Def(charge.RungId)?.Name ?? "an officer of the Reach");
    string chargeSays = charge == null ? "" : LadderSystem.DutySays(w, policy, charge); bool holdsCharge = w.Offices.Any(o => o.CharacterId == pid && LadderSystem.ChargeOf(offices.Def(o.OfficeId)).Length > 0);
    var officers = w.OfficeWork.Where(b => b.Kind == LadderSystem.Charge && b.HolderId != pid && b.Choice.Length > 0 && b.Choice != "left" && b.Turn == (w.OfficeWork.Count == 0 ? -1 : w.OfficeWork.Max(x => x.Turn))).Select(b => (b, who: w.Char(b.HolderId))).Where(x => x.who != null).ToList();
    string DidCharge(OfficeBusiness b) => b.Choice switch
    {
        LadderSystem.Account => "called the magistrates to account",
        LadderSystem.Sweep => "sent the Reach's fleet onto the lanes of " + (w.Galaxy?.Region(b.RegionId)?.Name ?? "a region"),
        LadderSystem.Party => "spent the year on their own bench",
        LadderSystem.Balance => "balanced the books",
        LadderSystem.Remit => "forgave " + (w.Galaxy?.Region(b.RegionId)?.Name ?? "a region") + " its levy",
        LadderSystem.Contracts => "let the Reach's contracts, it is said, to their own house",
        LadderSystem.Fair => "kept the order of business fair",
        LadderSystem.Own => "brought their own bench's business forward",
        LadderSystem.Silence => "gave " + (w.House(b.HouseA)?.Name ?? "a house") + " no day in the Senate",
        _ => "held the office"
    };
    var post = LadderSystem.DutyOf(w, pid, LadderSystem.Desk, LadderSystem.Posting, LadderSystem.Brief, LadderSystem.Ledgers, LadderSystem.Watch);
    int waitingN = new object?[] { charge, seat, bench, post }.Count(x => x != null);
    string postTitle = post == null ? "" : PostTitle(post.Kind);
    string postSays = post == null ? "" : LadderSystem.DutySays(w, policy, post);
    bool judge = LadderSystem.OnTheBench(p); int absent = w.Counter(LadderSystem.AbsentKey);
    bool sat = w.OfficeWork.Any(b => b.HolderId == pid && b.Kind == LadderSystem.SeatKind); bool heard = w.OfficeWork.Any(b => b.HolderId == pid && (b.Kind == LadderSystem.Hearing || b.Kind == LadderSystem.Appeal));
    string rank = c.Careers.RankName(p.CareerTrack, p.CareerRank, w.Era) ?? "";
    string benchTitle = bench == null ? "" : bench.Kind == LadderSystem.Appeal ? "Your bench: an appeal" : "Your bench: a hearing";
    string benchSays = bench == null ? "" : LadderSystem.DutySays(w, policy, bench);
    string seatSays = seat == null ? "" : LadderSystem.DutySays(w, policy, seat); bool inReach = PolitySystem.InReach(w, p.HouseId);
    string absentLine = absent <= 0 ? "" : absent == 1 ? "You did nothing with your seat last year." : "You have done nothing with your seat for " + absent + " years. At " + LadderSystem.AbsentYears + " it is remarked on.";
    int latest = w.OfficeWork.Count == 0 ? -1 : w.OfficeWork.Max(b => b.Turn);
    var kin = w.OfficeWork.Where(b => b.Turn == latest && b.HolderId != pid && b.Choice.Length > 0 && b.Choice != "left" && (b.Kind == LadderSystem.Hearing || b.Kind == LadderSystem.Appeal))
        .Select(b => (b, who: w.Char(b.HolderId))).Where(x => x.who != null && (x.who.HouseId == house.Id || x.b.HouseA == house.Id || x.b.HouseB == house.Id)).ToList();
    string Did(OfficeBusiness b) => b.Choice switch
    {
        LadderSystem.Law => "ruled on the law",
        LadderSystem.ForHouse => "found for " + (w.House(b.HouseA)?.Name ?? "the house"),
        LadderSystem.ForEstate => "found for the petitioners",
        LadderSystem.Overturn => "overturned the ruling for " + (w.House(b.HouseB)?.Name ?? "a house") + ", and " + (w.House(b.HouseA)?.Name ?? "a house") + " was paid back",
        LadderSystem.Uphold => "upheld the ruling for " + (w.House(b.HouseB)?.Name ?? "a house") + " against " + (w.House(b.HouseA)?.Name ?? "a house"),
        LadderSystem.SendBack => "sent the appeal of " + (w.House(b.HouseA)?.Name ?? "a house") + " back to be heard again",
        _ => "sat"
    };
}
<section class="panel duties sn-panel">
    <p class="ui-lede sn-lede">A position is work, not a title. Each of these is yours alone to decide, once a year; the business of an elected office is on the Ladder.</p>
    <Section Title="Your duties this year" Count="@(waitingN > 0 ? waitingN.ToString() : "")" Info="What your positions ask of you: the charge of an office of the Reach, your seat in the Senate, a matter before your bench, and the work of your rank. Each is decided once a year; one left undone is noticed.">
        <Right><span>@(rank.Length > 0 ? Cap(rank) : "")</span></Right>
    </Section>
    @if (charge != null)
    {
        <div class="sn-ent rung-row duty-charge waits">
            <span class="sn-ic mine"><Icon Name="podium" Tone="brass" Size="22" /></span>
            <div class="sn-ent-main">
                <div class="sn-hd"><b class="sn-nm">@chargeTitle</b><span class="sn-tag warn">waits on you</span></div>
                <div class="sn-tx">@chargeSays</div>
                <div class="sn-choices">
                @foreach (var choice in LadderSystem.ChoicesOf(offices, charge))
                {
                    string ch = choice; var no = new DutyCommand(pid, LadderSystem.Charge, ch, offices, policy).Refusal(G.Ctx); string tip = LadderSystem.DutyChoiceSays(w, policy, charge, ch);
                    <div class="sn-choice suit-acts">
                        <Plate Label="@Label(ch)" Small="true" Locked="@(no != null)" Disabled="@(no != null)" Tip="@(no ?? tip)" OnClick='() => G.ExecuteTold(new DutyCommand(pid, LadderSystem.Charge, ch, offices, policy), "The year’s duty", Label(ch))' />
                        <span class="sn-say">@tip</span>
                    </div>
                }
                </div>
                <div class="sn-say ui-mute">A great office held and not used is noticed, and said.</div>
            </div>
        </div>
    }
    else if (holdsCharge) { <div class="sn-done"><Icon Name="check" Tone="good" Size="14" /><span>@ChargeDone</span></div> }
    @if (seat != null)
    {
        <div class="sn-ent rung-row duty-seat waits">
            <span class="sn-ic"><Icon Name="greek-temple" Tone="ivory" Size="22" /></span>
            <div class="sn-ent-main">
                <div class="sn-hd"><b class="sn-nm">Your seat in the Senate</b><span class="sn-tag warn">not yet spent</span></div>
                <div class="sn-tx">@seatSays</div>
                @* the year's four choices as the event window's choice plates (docs/VISUAL_SYSTEM.md 6): full width, the digit disc, a verb,
                   what it does in the tooltip *@
                <div class="sn-duty-choices">
                @{ int dn = 0; }
                @foreach (var choice in LadderSystem.DutyChoices(LadderSystem.SeatKind))
                {
                    string ch = choice; dn++; var no = new DutyCommand(pid, LadderSystem.SeatKind, ch, offices, policy).Refusal(G.Ctx); string tip = LadderSystem.DutyChoiceSays(w, policy, seat, ch);
                    <button class="sn-duty-ch @(no != null ? "locked" : "")" disabled="@(no != null)" title="@(Label(ch) + "\n" + (no != null ? LawsScreen.Say(no) + ". " : "") + tip)" @onclick='() => G.ExecuteTold(new DutyCommand(pid, LadderSystem.SeatKind, ch, offices, policy), "The year’s duty", Label(ch))'>
                        <span class="n">@dn</span><span class="l">@Label(ch)</span>@if (no != null) { <span class="req"><Icon Name="padlock" Tone="ember" Size="13" />@LawsScreen.Say(no)</span> }
                    </button>
                }
                </div>
                @if (absentLine.Length > 0) { <WarnStrip Icon="alert" Lead="Absent." Class="sn-absent">@absentLine</WarnStrip> }   @* a warn strip (4.9), never a whole sentence in red *@
                @{ var curCom = LadderSystem.CommitteeOf(w, w.House(p.HouseId)!); }
                <div class="sn-acts suit-acts sn-committee" title="@($"{LadderSystem.CommitteeSays(w, w.House(p.HouseId)!)} {LadderSystem.AttendanceSays(w, p)}")">
                    <Segmented Label="Committee" Value="@curCom" Options="@LadderSystem.Committees.Select(cm => (cm, CommitteeShort(cm), cm == curCom ? "Your house sits on it" : MoveTip)).ToList()" Refusal="@(cm => cm == curCom ? null : new CommitteeCommand(pid, cm).Refusal(G.Ctx) is { } r ? LawsScreen.Say(r) : null)" OnChange="cm => { if (cm != curCom) G.Execute(new CommitteeCommand(pid, cm)); }" />
                </div>
            </div>
        </div>
    }
    else if (!holdsCharge) { <div class="sn-done"><Icon Name="@(sat ? "check" : "hourglass")" Tone="@(sat ? "good" : "ivory")" Size="14" /><span>@(sat ? SeatDone : SeatNotYet) @(inReach ? LadderSystem.CommitteeSays(w, w.House(p.HouseId)!) + " " + LadderSystem.AttendanceSays(w, p) : "")</span></div> }
    @if (bench != null)
    {
        <div class="sn-ent rung-row duty-bench waits">
            <span class="sn-ic mine"><Icon Name="scales" Tone="brass" Size="22" /></span>
            <div class="sn-ent-main">
                <div class="sn-hd"><b class="sn-nm">@benchTitle</b><span class="sn-sub">@rank</span><span class="sn-tag warn">waits on you</span></div>
                <div class="sn-tx">@benchSays</div>
                <div class="sn-choices">
                @foreach (var choice in LadderSystem.DutyChoices(bench.Kind))
                {
                    string ch = choice; string kind = bench.Kind; var no = new DutyCommand(pid, kind, ch, offices, policy).Refusal(G.Ctx); string tip = LadderSystem.DutyChoiceSays(w, policy, bench, ch);
                    <div class="sn-choice suit-acts">
                        <Plate Label="@Label(ch)" Small="true" Locked="@(no != null)" Disabled="@(no != null)" Tip="@(no ?? tip)" OnClick='() => G.ExecuteTold(new DutyCommand(pid, kind, ch, offices, policy), "The year’s duty", Label(ch))' />
                        <span class="sn-say">@tip</span>
                    </div>
                }
                </div>
                <div class="sn-say ui-mute">Left unheard, it is noticed.</div>
            </div>
        </div>
    }
    else if (judge) { <div class="sn-done"><Icon Name="@(heard ? "check" : "hourglass")" Tone="@(heard ? "good" : "ivory")" Size="14" /><span>@(heard ? BenchDone : BenchNotYet)</span></div> }
    @if (post != null)
    {
        <div class="sn-ent rung-row duty-post waits">
            <span class="sn-ic"><Icon Name="@PostIcon(post.Kind)" Tone="ivory" Size="22" /></span>
            <div class="sn-ent-main">
                <div class="sn-hd"><b class="sn-nm">@postTitle</b><span class="sn-sub">@rank</span></div>
                <div class="sn-tx">@postSays</div>
                <div class="sn-choices">
                @foreach (var choice in LadderSystem.DutyChoices(post.Kind))
                {
                    string ch = choice; string kind = post.Kind; var no = new DutyCommand(pid, kind, ch, offices, policy).Refusal(G.Ctx); string tip = LadderSystem.DutyChoiceSays(w, policy, post, ch);
                    <div class="sn-choice suit-acts">
                        <Plate Label="@Label(ch)" Small="true" Locked="@(no != null)" Disabled="@(no != null)" Tip="@(no ?? tip)" OnClick='() => G.ExecuteTold(new DutyCommand(pid, kind, ch, offices, policy), "The year’s duty", Label(ch))' />
                        <span class="sn-say">@tip</span>
                    </div>
                }
                </div>
            </div>
        </div>
    }
    else if (post == null && charge == null) { <div class="sn-done"><Icon Name="check" Tone="ivory" Size="14" /><span>@NoBench</span></div> }
    @if (officers.Count > 0 || kin.Count > 0)
    {
        <Section Title="What others did" Count="@((officers.Count + kin.Count).ToString())" Info="What the officers of the Reach did with their charge this year, and the rulings of the bench that touch your house." Class="sn-sub-sec">
            @if (officers.Count > 0)
            {
                <details class="sn-det"><summary><Icon Name="chev" Size="11" Class="flat" />What the officers of the Reach did this year (@officers.Count)</summary>
                    @foreach (var (b, who) in officers)
                    {
                        <div class="sn-tx ui-dim">@who!.Name@(who.HouseId == house.Id ? " (yours)" : " of " + w.House(who.HouseId)?.Name), @(offices.Def(b.RungId)?.Name ?? "officer"): @DidCharge(b).</div>
                    }
                </details>
            }
            @foreach (var (b, who) in kin)
            {
                <div class="sn-note sn-pad"><Icon Name="scales" Tone="ivory" Size="15" /><span>@who!.Name@(who.HouseId == house.Id ? " (yours)" : " of " + w.House(who.HouseId)?.Name), on the bench: @Did(b).</span></div>
            }
        </Section>
    }
</section>

@code {
    private const string MoveTip = "You take a place at the bottom of its table: your standing starts again from nothing, and you may not move again for five years.";
    private const string ChargeDone = "The year's charge of your office is carried. It is your year in the Senate too.";
    private const string SeatDone = "Your year in the Senate is spent.";
    private const string SeatNotYet = "The Senate has not yet sat. Your year in it begins at the turn of the year.";
    private const string BenchNotYet = "Nothing has come before your bench yet. The first matter comes at the turn of the year.";
    private const string BenchDone = "Nothing more is before your bench this year.";
    private static string PostTitle(string kind) => kind switch
    {
        LadderSystem.Desk => "Your desk: the year's returns", LadderSystem.Posting => "Your posting: a year ashore", LadderSystem.Brief => "A brief",
        LadderSystem.Ledgers => "The ledgers", LadderSystem.Watch => "A junior's year", _ => "Your work"
    };
    private static string PostIcon(string kind) => kind switch { LadderSystem.Desk => "desk", LadderSystem.Posting => "eagle-emblem", LadderSystem.Brief => "scroll-quill", LadderSystem.Ledgers => "abacus", LadderSystem.Watch => "spyglass", _ => "tied-scroll" };
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    private const string NoBench = "Your rank asks nothing more of you this year. Every rank in a service has work: a brief, the ledgers or the watches for a junior; a bench, a desk or a posting above that.";
    /// <summary>A committee in one word for the segmented control: "Fleet", "Purse", "Laws".</summary>
    private static string CommitteeShort(string cm) { string n = LadderSystem.CommitteeName(cm); foreach (var w in new[] { "Fleet", "Purse", "Laws", "Law" }) if (n.Contains(w)) return w; return LawsScreen.Cap(n.Replace("the Committee of the ", "").Replace("the Committee on the ", "").Replace("the ", "")); }
    private static string Label(string choice) => choice switch
    {
        LadderSystem.Law => "Rule on the law", LadderSystem.ForHouse => "Find for the house", LadderSystem.ForEstate => "Find for the petitioners",
        LadderSystem.Overturn => "Overturn the ruling", LadderSystem.SendBack => "Send it back", LadderSystem.Uphold => "Uphold the praetor",
        LadderSystem.Account => "Call the magistrates to account", LadderSystem.Sweep => "Send the fleet onto the lanes", LadderSystem.Party => "Spend the year on your bench",
        LadderSystem.Balance => "Balance the books", LadderSystem.Remit => "Forgive a region its levy", LadderSystem.Contracts => "Let the contracts to your own house",
        LadderSystem.Fair => "Keep the order fair", LadderSystem.Own => "Bring your own business forward", LadderSystem.Silence => "Give an enemy no day",
        LadderSystem.Plead => "Plead it on the law", LadderSystem.RichClient => "Take the side that pays", LadderSystem.PoorClient => "Plead for one who cannot pay",
        LadderSystem.Diligent => "Keep them exactly", LadderSystem.Useful => "Make yourself useful", LadderSystem.Pad => "Pad an account",
        LadderSystem.Watches => "Stand your watches", LadderSystem.Volunteer => "Volunteer for the patrol", LadderSystem.Mess => "Make friends in the mess",
        LadderSystem.Assess => "Assess it fairly", LadderSystem.Press => "Press the collection", LadderSystem.Skim => "Keep a share",
        LadderSystem.Drill => "Drill the crews", LadderSystem.Patrol => "Patrol the home lanes", LadderSystem.Board => "Sit on a board of inquiry",
        LadderSystem.Audit => "Read the accounts", LadderSystem.SpeakRegion => "Speak for your region", LadderSystem.Whip => "Work your bench", LadderSystem.CommitteeWork => "Do the committee's work", _ => choice
    };
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;
}
