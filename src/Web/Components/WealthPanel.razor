@using Praetoria.Core.Systems
@inject GameClient G
@implements IDisposable
@{
    var w = G.World!; var p = w.Protagonist!; var pid = p.Id; var house = w.House(p.HouseId)!;
    var members = WealthSystem.Members(w, house).Where(c => c.Id != pid).OrderBy(c => c.Purse).ThenBy(c => c.Id, StringComparer.Ordinal).ToList();
    var heads = w.Houses.Values.Where(h => h.Id != house.Id && h.Id != PirateSystem.HouseId).OrderByDescending(h => h.Legitimacy).ThenBy(h => h.Id, StringComparer.Ordinal).Select(h => Economy.HeadOf(w, h)).Where(c => c is { Alive: true }).Select(c => c!).Take(3).ToList();
    var cs = G.Turn?.Companies; var myShares = CompanySystem.HeldPersonally(w, pid);
    var offered = w.Companies.Where(c => c.HeldBy(Company.Public) > 0).OrderByDescending(c => c.Price > 0 && c.Shares > 0 ? c.LastDividend / (c.Price * c.Shares) : 0).ThenBy(c => c.Id, StringComparer.Ordinal).Take(3).ToList();
    var flownElsewhere = w.Heirlooms.Where(h => WealthSystem.IsSpoil(h) && h.FromHouseId == house.Id && w.Char(h.HolderId) is { Alive: true } k && k.HouseId != house.Id).OrderBy(h => h.Id, StringComparer.Ordinal).ToList();
    var oweMe = WealthSystem.OweMe(w, house.Id); var favoursIOwe = WealthSystem.IOwe(w, house.Id);
    var mine = WealthSystem.HeldBy(w, pid); var others = w.Heirlooms.Where(h => h.HolderId != pid && w.Char(h.HolderId)?.HouseId == house.Id).OrderBy(h => h.Id, StringComparer.Ordinal).ToList();
    var heir = DynastySystem.FindHeir(w, p); var will = p.Will; var legatee = will != null && will.LegateeId.Length > 0 ? w.Char(will.LegateeId) : null;
    var people = w.LivingCharacters().Where(c => c.HouseId == house.Id && c.Id != pid && c.Age >= 6).OrderByDescending(c => c.Age).ThenBy(c => c.Id, StringComparer.Ordinal).ToList();
    var spouse = DynastySystem.Spouse(w, p); if (spouse != null && !people.Contains(spouse)) people.Insert(0, spouse);
    int income = WealthSystem.Pay(p) + WealthSystem.EstateIncome(w, pid); int bill = WealthSystem.AllowanceBill(w, house);
    int keep = HouseholdSystem.Keep(w, house); string keepLine = keep > 0 ? " · the household's keep " + keep + " a year" : "";
}
<section class="panel wealth">
    <h3><Icon Name="house" Size="13" /> Purses, heirlooms and the will <span class="muted">your own purse @p.Purse · the allowance costs @bill a year@(keepLine)</span></h3>
    <div class="hh-cols">
    <div>
        <div class="hh-head"><b>Your own purse</b> <span class="muted small">@p.Purse credits@(income > 0 ? $", and {income} a year from your service and estates" : ""). It is yours, not the house's: it goes by your will, and the house's creditors cannot touch it.</span></div>
        <div class="suit-acts"><span class="muted small">From the treasury</span>
            @foreach (int a in Sums) { int amt = a; var no = new WealthCommand(pid, WealthCommand.Move, string.Empty, amt.ToString()).Refusal(G.Ctx); <button class="opt inline tiny" disabled="@(no != null)" title="@(no ?? (house.Allowance == WealthSystem.Mean ? "the family, kept on a mean allowance, will notice" : ""))" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Move, string.Empty, amt.ToString()))">take @a</button> }
            <span class="muted small">Into it</span>
            @foreach (int a in Sums) { int amt = a; var no = new WealthCommand(pid, WealthCommand.Move, string.Empty, (-amt).ToString()).Refusal(G.Ctx); <button class="opt inline tiny" disabled="@(no != null)" title="@no" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Move, string.Empty, (-amt).ToString()))">put @a</button> }
        </div>

        @if (cs != null && cs.Open)
        {
            <div class="hh-head"><b>Shares of your own</b> <span class="muted small">Bought out of your purse, in your name. What they pay goes into your purse, and they go by your will. They are not the house's, and what is taken from the house does not take them. They vote with the house's own shares, if it has any. One person may hold a tenth of a company.</span></div>
            @if (myShares.Count == 0) { <div class="muted small">You hold none in your own name.</div> }
            @foreach (var (co, n) in myShares)
            {
                string coid = co.Id; int held = n; int pays = co.Shares > 0 ? co.LastDividend * n / co.Shares : 0;
                var one = cs.QuotePrivateSell(w, p, co, 1); var all = cs.QuotePrivateSell(w, p, co, n);
                <div class="purse-row own-share">
                    <b>@co.Name</b> <span class="pill small good">@n share@(n == 1 ? "" : "s") · worth @((int)(n * co.Price))</span>
                    <span class="muted small">@(pays > 0 ? $"pays you {pays} a year" : "paid nothing last year")</span>
                    <span class="suit-acts">
                        <button class="opt inline tiny" disabled="@(one.Refusal != null)" title="@one.Refusal" @onclick="() => G.Execute(new PrivateSharesCommand(pid, coid, 1, false, cs))">Sell 1 · @one.Credits</button>
                        @if (n > 1) { <button class="opt inline tiny" disabled="@(all.Refusal != null)" title="@all.Refusal" @onclick="() => G.Execute(new PrivateSharesCommand(pid, coid, held, false, cs))">Sell all · @all.Credits</button> }
                    </span>
                </div>
            }
            <div class="suit-acts"><span class="muted small">Buy for yourself</span>
                @foreach (var co in offered)
                {
                    string coid = co.Id; var q1 = cs.QuotePrivateBuy(w, p, co, 1); var q5 = cs.QuotePrivateBuy(w, p, co, 5);
                    int yield = co.Price > 0 && co.Shares > 0 ? (int)Math.Round(co.LastDividend * 100.0 / (co.Price * co.Shares)) : 0;
                    <button class="opt inline tiny" disabled="@(q1.Refusal != null)" title="@(q1.Refusal ?? $"{co.Name}: paid {yield}% of its price last year. One share, out of your purse.")" @onclick="() => G.Execute(new PrivateSharesCommand(pid, coid, 1, true, cs))">@co.Name · 1 for @(q1.Credits > 0 ? q1.Credits.ToString() : "—")</button>
                    <button class="opt inline tiny" disabled="@(q5.Refusal != null)" title="@(q5.Refusal ?? "Five shares, out of your purse.")" @onclick="() => G.Execute(new PrivateSharesCommand(pid, coid, 5, true, cs))">5 for @(q5.Credits > 0 ? q5.Credits.ToString() : "—")</button>
                }
                @if (offered.Count == 0) { <span class="muted small">No company has shares on the float.</span> }
            </div>
        }

        <div class="hh-head"><b>What the house gives its own</b> <span class="muted small">Every grown member's allowance, paid from the treasury each year. @WealthSystem.AllowanceSays(house.Allowance)</span></div>
        <div class="suit-acts">
            @foreach (var a in WealthSystem.Allowances) { string pol = a; <button class="opt inline @(house.Allowance == a ? "here" : "")" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Allowance, string.Empty, pol))">@a · @WealthSystem.AllowanceOf(a) each</button> }
        </div>

        <div class="hh-head"><b>Their purses</b> <span class="muted small">What they do with their own money is their own business. You may give or lend them some of yours, and pay what they owe when they cannot.</span></div>
        @if (members.Count == 0) { <div class="muted small">Nobody grown of the house but you.</div> }
        @foreach (var c in members.Take(_all ? 40 : 7))
        {
            string cid = c.Id; bool debt = c.Purse < 0;
            <div class="purse-row">
                <b>@c.Name</b> <span class="pill small @(debt ? "warn" : c.Purse >= 15 ? "good" : "")">@(debt ? $"owes {-c.Purse}" : $"{c.Purse} credits")</span>
                <span class="muted small">@(c.LastSpend.Length > 0 ? c.LastSpend : "Nothing to note yet.")@OwnsLine(w, c)</span>
                <span class="suit-acts">
                    @foreach (int a in Gifts) { int amt = a; var no = new WealthCommand(pid, WealthCommand.Gift, cid, amt.ToString()).Refusal(G.Ctx); <button class="opt inline tiny" disabled="@(no != null)" title="@(no ?? GiftTip)" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Gift, cid, amt.ToString()))">Give @amt</button> }
                    @if (c.OwesHead > 0)
                    {
                        string owes = "owes you " + c.OwesHead + (w.Turn - c.OwesSince >= WealthSystem.LoanSoursAfter ? ", and it sits between you" : "");
                        <span class="pill small warn">@owes</span>
                        <button class="opt inline tiny" title="@ForgiveTip" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Forgive, cid, string.Empty))">Forgive it</button>
                    }
                    else
                    {
                        var no = new WealthCommand(pid, WealthCommand.Lend, cid, LoanSum).Refusal(G.Ctx);
                        <button class="opt inline tiny" disabled="@(no != null)" title="@(no ?? LendTip)" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Lend, cid, LoanSum))">Lend @LoanSum</button>
                        <button class="opt inline tiny" disabled="@(no != null)" title="@(no ?? InterestTip)" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.LendAtInterest, cid, LoanSum))">Lend @LoanSum at interest</button>
                    }
                    @if (c.LentHead > 0)
                    {
                        string iOwe = "you owe them " + c.LentHead + (w.Turn - c.LentSince >= WealthSystem.LoanSoursAfter ? ", and they mind it" : ""); var noPay = new WealthCommand(pid, WealthCommand.Repay, cid, string.Empty).Refusal(G.Ctx);
                        <span class="pill small warn">@iOwe</span>
                        <button class="opt inline tiny" disabled="@(noPay != null)" title="@(noPay ?? RepayTip)" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Repay, cid, string.Empty))">Pay them back</button>
                    }
                    else if (c.OwesHead == 0)
                    {
                        foreach (int sum in Borrows)
                        {
                            string amt = sum.ToString(); var noAsk = new WealthCommand(pid, WealthCommand.Borrow, cid, amt).Refusal(G.Ctx); string askTip = noAsk ?? (WealthSystem.BorrowOwed(c, sum) > sum ? "They would lend it, and want " + WealthSystem.BorrowOwed(c, sum) + " back." : BorrowTip);
                            <button class="opt inline tiny" disabled="@(noAsk != null)" title="@askTip" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Borrow, cid, amt))">Borrow @sum</button>
                        }
                    }
                    @if (c.OwesKin > 0) { string kinOwes = "owes " + (w.Char(c.OwesKinId)?.Name ?? "one of the house") + " " + c.OwesKin; <span class="pill small">@kinOwes</span> }
                </span>
                @if (debt)
                {
                    var t = new WealthCommand(pid, WealthCommand.Settle, cid, "treasury").Refusal(G.Ctx); var mp = new WealthCommand(pid, WealthCommand.Settle, cid, "purse").Refusal(G.Ctx);
                    <span class="suit-acts">
                        <button class="opt inline tiny" disabled="@(t != null)" title="@t" @onclick="@(() => G.Execute(new WealthCommand(pid, WealthCommand.Settle, cid, Treasury)))">Pay it from the treasury</button>
                        <button class="opt inline tiny" disabled="@(mp != null)" title="@(mp ?? "they will remember it was your own money")" @onclick="@(() => G.Execute(new WealthCommand(pid, WealthCommand.Settle, cid, Purse)))">Pay it yourself</button>
                        <span class="muted small">Left alone it grows; past @(-WealthSystem.ScandalAt) the creditors come to the house.</span>
                    </span>
                }
            </div>
        }
        @if (members.Count > 7) { <button class="opt inline tiny" @onclick="() => _all = !_all">@(_all ? "Show fewer" : $"Show all {members.Count}")</button> }
    </div>
    <div>
        <div class="hh-head"><b>Heirlooms</b> <span class="muted small">They belong to a person, not to the house, unless the head entails them. Each does something for whoever holds it.</span></div>
        @if (mine.Count == 0 && others.Count == 0) { <div class="muted small">Nothing has been handed down in this house. A new name has to make its own.</div> }
        <div class="suit-acts"><span class="muted small">Have one made, out of your own purse</span>
            @foreach (var kind in WealthSystem.Commissions) { string k = kind; var no = new WealthCommand(pid, WealthCommand.Commission, string.Empty, k).Refusal(G.Ctx); <button class="opt inline tiny" disabled="@(no != null)" title="@(no ?? MadeTip(k))" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Commission, string.Empty, k))">A @k · @WealthSystem.CommissionCost(k)</button> }
            <span class="muted small">A standard is taken in a battle by whoever commanded. Plate comes from another house at a wedding.</span>
        </div>
        @if (oweMe.Count + favoursIOwe.Count > 0)
        {
            <div class="muted small">
                @if (oweMe.Count > 0) { <span title="A thing given to the head of another house is a favour asked. That house leans your way on the next motion you bring, and the favour is spent."><b>Owe you a favour:</b> @string.Join(", ", oweMe.Select(h => h.Name)). </span> }
                @if (favoursIOwe.Count > 0) { <span title="You kept a gift that asked a favour. Vote for that house's next motion and the account is even; vote otherwise and its head will remember who kept the gift."><b>You owe a favour to:</b> @string.Join(", ", favoursIOwe.Select(h => h.Name)).</span> }
            </div>
        }
        @foreach (var item in mine)
        {
            string iid = item.Id; var left = will != null && will.Items.TryGetValue(item.Id, out var toId) ? w.Char(toId) : null;
            <div class="suit">
                <b>@Cap(item.Name)</b> <span class="muted">yours · worth @item.Value · @(item.Entailed ? "entailed: it goes with the house" : "left to " + (left?.Name ?? heir?.Name ?? "nobody yet"))</span>
                <div class="muted small">@WealthSystem.Does(w, item)</div>
                @{ var noEntail = new WealthCommand(pid, WealthCommand.EntailItem, iid, string.Empty).Refusal(G.Ctx); var noBreak = new WealthCommand(pid, WealthCommand.BreakEntail, iid, string.Empty).Refusal(G.Ctx); }
                @if (item.Entailed)
                {
                    <div class="suit-acts">
                        @if (_break == iid) { <button class="opt inline tiny veto" @onclick="() => { _break = null; G.Execute(new WealthCommand(pid, WealthCommand.BreakEntail, iid, string.Empty)); }">Yes, break the entail</button> <button class="opt inline tiny" @onclick="() => _break = null">No</button> }
                        else { <button class="opt inline tiny" disabled="@(noBreak != null)" title="@(noBreak ?? BreakTip)" @onclick="() => _break = iid">Break the entail</button> }
                    </div>
                }
                else
                {
                <div class="suit-acts"><button class="opt inline tiny" disabled="@(noEntail != null)" title="@(noEntail ?? EntailTip)" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.EntailItem, iid, string.Empty))">Entail it</button>
                    @if (G.Turn?.Ventures is { } pv) { bool pledged = house.PledgedId == iid; var noPledge = pv.PledgeRefusal(w, p, pledged ? string.Empty : iid); <button class="opt inline tiny @(pledged ? "here" : "")" disabled="@(noPledge != null)" title="@(noPledge ?? (pledged ? "Withdraw it." : "If the house is foreclosed on, its creditors take this first. A thing that is entailed can never be taken; one that is not can be, once there is no venture left."))" @onclick="() => G.Execute(new PledgeCommand(pid, pledged ? string.Empty : iid, pv))">@(pledged ? "Pledged to the creditors" : "Pledge it")</button> }</div>
                <div class="suit-acts"><span class="muted small">Leave it to</span>
                    <button class="opt inline tiny @(left == null ? "here" : "")" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Bequeath, iid, string.Empty))">the heir</button>
                    @foreach (var c in people.Take(6)) { string cid = c.Id; <button class="opt inline tiny @(left?.Id == c.Id ? "here" : "")" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Bequeath, iid, cid))">@First(c.Name)</button> }
                </div>
                <div class="suit-acts"><span class="muted small">Give it now to</span>
                    @foreach (var c in people.Take(6)) { string cid = c.Id; <button class="opt inline tiny" title="they will not forget it" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Give, iid, cid))">@First(c.Name)</button> }
                    @if (WealthSystem.IsSpoil(item) && w.House(item.FromHouseId) is { } lostBy && Economy.HeadOf(w, lostBy) is { Alive: true } theirHead) { string thid = theirHead.Id; <button class="opt inline tiny" title="@($"It was {lostBy.Name}'s. Sent home with nothing asked, {theirHead.Name} will think much better of you. While you keep it, they think a little worse of you each year.")" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Give, iid, thid))">Send it home to @lostBy.Name.Replace("House ", "")</button> }
                    @foreach (var hd in heads) { string hid = hd.Id; <button class="opt inline tiny" title="@($"A gift to the head of {w.House(hd.HouseId)?.Name}. They will think much better of you for it, it is theirs for good, and their house owes you a favour: it leans your way on the next motion you bring.")" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Give, iid, hid))">@First(hd.Name) of @(w.House(hd.HouseId)?.Name.Replace("House ", ""))</button> }
                    @if (_confirm == iid) { <button class="opt inline tiny veto" @onclick="() => { _confirm = null; G.Execute(new WealthCommand(pid, WealthCommand.Sell, iid, string.Empty)); }">Yes, sell it</button> <button class="opt inline tiny" @onclick="() => _confirm = null">No</button> }
                    else { <button class="opt inline tiny" title="@(item.OfHouseId == house.Id ? "The family has always had it: the house loses standing and your blood kin resent it." : "")" @onclick="() => _confirm = iid">Sell · @item.Value</button> }
                </div>
                }
            </div>
        }
        @foreach (var item in flownElsewhere)
        {
            string lid = item.Id; var keeper = w.Char(item.HolderId); var no = new WealthCommand(pid, WealthCommand.Ransom, lid, string.Empty).Refusal(G.Ctx);
            <div class="suit"><b>@Cap(item.Name)</b> <span class="muted">taken from your house, and held by @keeper?.Name of @(w.House(keeper?.HouseId ?? "")?.Name)</span>
                <div class="suit-acts"><button class="opt inline tiny" disabled="@(no != null)" title="@(no ?? "Out of your own purse. It comes home as yours, with nothing owed. Beating them in battle would bring it home too.")" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Ransom, lid, string.Empty))">Buy it home · @WealthSystem.RansomPrice(item)</button></div></div>
        }
        @foreach (var item in others) { <div class="suit"><b>@Cap(item.Name)</b> <span class="muted">held by @w.Char(item.HolderId)?.Name · worth @item.Value@(item.Entailed ? " · entailed" : "")</span><div class="muted small">@WealthSystem.Does(w, item)</div></div> }

        <div class="hh-head"><b>Your will</b> <span class="muted small">The house goes to @(heir?.Name ?? "nobody: there is no heir") by @house.SuccessionLaw.Replace('_', ' '), whatever you write. Your purse and heirlooms go as you say.</span></div>
        <div class="suit-acts"><span class="muted small">Of your purse</span>
            <button class="opt inline tiny @(legatee == null ? "here" : "")" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Will, string.Empty, Zero))">all to the heir</button>
            @foreach (int pct in Shares) { int sh = pct; <button class="opt inline tiny @(legatee != null && will!.SharePct == pct ? "here" : "")" disabled="@(_legatee == null && legatee == null)" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Will, _legatee ?? legatee!.Id, sh.ToString()))">@(pct == 100 ? "all" : pct == 50 ? "half" : "a quarter")</button> }
            <span class="muted small">to</span>
            @foreach (var c in people.Where(c => c.Id != heir?.Id).Take(7)) { string cid = c.Id; <button class="opt inline tiny @((_legatee ?? legatee?.Id) == c.Id ? "here" : "")" @onclick="() => _legatee = cid">@First(c.Name)</button> }
        </div>
        @if (legatee != null) { <div class="muted small">@(will!.SharePct == 100 ? "All" : will.SharePct == 50 ? "Half" : "A quarter") of your purse to <b>@legatee.Name</b>, the rest to the heir.@(will.SharePct >= 50 ? " The heir will not thank them for it." : "")</div> }

        <div class="hh-head"><b>Dowries</b> <span class="muted small">When a daughter of the house marries with a dowry, whose money it is.</span></div>
        <div class="suit-acts">
            <button class="opt inline @(house.DowryFromPurse ? "" : "here")" title="@DowryTreasuryTip" @onclick="@(() => G.Execute(new WealthCommand(pid, WealthCommand.Dowries, string.Empty, Treasury)))">From the treasury</button>
            <button class="opt inline @(house.DowryFromPurse ? "here" : "")" title="@DowryPurseTip" @onclick="@(() => G.Execute(new WealthCommand(pid, WealthCommand.Dowries, string.Empty, Purse)))">From my own purse first</button>
        </div>

        <div class="hh-head"><b>The estate</b> <span class="muted small">What becomes of the treasury when the head dies.</span></div>
        <div class="suit-acts">
            <button class="opt inline @(house.Inheritance == WealthSystem.Entail ? "here" : "")" title="the heir takes all of it; the other grown children resent being passed over" @onclick="@(() => G.Execute(new WealthCommand(pid, WealthCommand.Inheritance, string.Empty, WealthSystem.Entail)))">Kept whole</button>
            <button class="opt inline @(house.Inheritance == WealthSystem.Portions ? "here" : "")" title="each other grown child of the head takes a tenth of the treasury; they mind less, and the house is poorer" @onclick="@(() => G.Execute(new WealthCommand(pid, WealthCommand.Inheritance, string.Empty, WealthSystem.Portions)))">Shared out in portions</button>
        </div>
    </div>
    </div>
</section>

@code {
    private bool _all; private string? _legatee, _confirm, _break;
    private const string InterestTip = "The same loan with a fifth on top. It is business, and they take it as business.";
    private const string BorrowTip = "Out of their own purse into yours. They will not ask for it. Left six years unpaid, they mind it.";
    private const string RepayTip = "As far as your purse goes.";
    /// <summary>What a relative has besides credits: shares in their own name, and a stake in what they founded.</summary>
    private static string OwnsLine(World w, Character c)
    {
        var held = CompanySystem.HeldPersonally(w, c.Id); int stake = AmbitionSystem.StakesOf(w, c).Sum(x => x.Stake);
        string shares = held.Count > 0 ? $" Holds {held.Sum(h => h.Shares)} share{(held.Sum(h => h.Shares) == 1 ? "" : "s")} of their own, worth {CompanySystem.PersonalWorth(w, c.Id)}." : "";
        if (held.Count > 0 && !CompanySystem.VotesWithHouse(w, c)) shares += " They do not vote them with the house.";
        var own = w.BusinessesOf(c.HouseId).Where(b => VentureSystem.HolderOf(w, b)?.Id == c.Id).ToList();
        return shares + (own.Count > 0 ? $" Has {own.Count} venture{(own.Count == 1 ? "" : "s")} of their own." : "") + (stake > 0 ? $" Draws {stake} a year from what they founded." : "");
    }
    private static string MadeTip(string kind) => kind == WealthSystem.Library
        ? "A library of your own house: everyone in it who has set themselves a study learns it a little faster. It is yours, and the house's after you."
        : $"A shrine in your house's name: the commons think a point better of the house each year, while they think less than {WealthSystem.ShrineCeiling} of it. It is yours, and the house's after you.";
    private const string EntailTip = "It goes with the house from now on, to whoever has it, and cannot be sold, given or willed away. The old families approve.";
    private const string BreakTip = "Done in a court. The house loses standing, the old families think the worse of it, and your blood kin do not forget why.";
    private const string Treasury = "treasury", Purse = "purse", Zero = "0", LoanSum = "10";
    private static readonly int[] Gifts = { 5, 10 }; private static readonly int[] Borrows = { 5, 10 };
    private const string GiftTip = "Out of your own purse, once a year. It is theirs to do as they like with, and they will think the better of you.";
    private const string LendTip = "Out of your own purse. They pay it back as they can. Left six years unpaid it sits between you.";
    private const string ForgiveTip = "They owe you nothing more, and will not forget it.";
    private const string DowryTreasuryTip = "The house pays, as is usual.";
    private const string DowryPurseTip = "You pay what your purse holds and the treasury the rest. A bride whose portion came mostly from your own hand thinks the better of you for it.";
    private static readonly int[] Sums = { 5, 20 }; private static readonly int[] Shares = { 25, 50, 100 };
    private static string First(string name) => name.Split(' ')[0];
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;
}
