@inject GameClient G
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var house = w.House(w.Protagonist!.HouseId)!;
    var fc = G.Turn!.Economy?.Forecast(w, house.Id, G.Turn.Fleets);
    int planets = m.Holdings.Count(h => h.Kind == "planet"), stations = m.Holdings.Count(h => h.Kind == "station"), claims = m.Holdings.Count(h => h.Kind == "claim"), pop = m.Holdings.Sum(h => h.Population); long citizens = Census.CitizensOf(G.World!, G.World!.Protagonist!.HouseId);
    var lg = m.Ledger; int maxAbs = lg == null ? 1 : Math.Max(1, lg.Lines.Select(l => Math.Abs(l.Delta.Credits)).DefaultIfEmpty(1).Max());
    var focus = _focus != null ? w.Char(_focus) : null;

    // The picture (docs/DASHBOARDS.md): what the house takes in and spends, where it stands among the others, and what is wrong.
    int credits = m.Treasury.Credits, net = lg?.Net.Credits ?? fc?.Credits ?? 0;
    int gross = lg == null ? Math.Max(0, net) : lg.Lines.Where(l => l.Delta.Credits > 0).Sum(l => l.Delta.Credits);
    int spend = lg == null ? Math.Max(0, -net) : -lg.Lines.Where(l => l.Delta.Credits < 0).Sum(l => l.Delta.Credits);
    var top = lg?.Lines.Where(l => l.Delta.Credits > 0).OrderByDescending(l => l.Delta.Credits).FirstOrDefault();
    var drain = lg?.Lines.Where(l => l.Delta.Credits < 0).OrderBy(l => l.Delta.Credits).FirstOrDefault();
    int lasts = net < 0 ? credits / -net : -1;
    var lands = m.Holdings.Where(h => h.Kind != "claim").ToList();
    var weakest = lands.OrderByDescending(h => h.Unrest).FirstOrDefault(); var besieged = m.Holdings.FirstOrDefault(h => h.Besieged);
    int loyal = weakest == null ? 0 : 100 - weakest.Unrest, thriving = lands.Count == 0 ? 0 : (int)lands.Average(h => h.Prosperity);
    var above = lg == null || lg.Rank <= 1 ? null : lg.Table.ElementAtOrDefault(lg.Rank - 2);
    var below = lg == null ? null : lg.Table.ElementAtOrDefault(lg.Rank);
    int richest = lg == null || lg.Table.Count == 0 ? 1 : Math.Max(1, lg.Table[0].Wealth);
    int legitRank = 1 + w.Houses.Values.Count(h => h.Id != house.Id && h.Id != PirateSystem.HouseId && h.Legitimacy > house.Legitimacy);
    int legitOf = w.Houses.Values.Count(h => h.Id != PirateSystem.HouseId);
    string titleName = c.Titles.NameOf(house.Title, w.Era);
    string story, storyTone;
    if (m.Treasury.Insolvent) { story = "The house cannot pay its way. Unrest climbs on every populated world and unpaid crews will desert until the treasury is above nought."; storyTone = "bad"; }
    else if (besieged != null) { story = $"{besieged.Name} is under siege. Nothing it yields reaches the house until the siege is lifted."; storyTone = "bad"; }
    else if (net < 0 && lasts >= 10) { story = $"The house does not quite pay its way: {Money.Show(-net)} more goes out each year than comes in{(drain != null ? $", the most of it on {drain.Source}" : "")}. The treasury would bear that for {lasts} years."; storyTone = "warn"; }
    else if (net < 0) { story = $"The house spends {Money.Show(-net)} more than it takes in each year{(drain != null ? $", the most of it on {drain.Source}" : "")}. The treasury lasts {(lasts == 0 ? "less than a year" : lasts == 1 ? "one more year" : lasts + " years")} at this rate."; storyTone = "warn"; }
    else if (weakest is { Unrest: >= 50 }) { story = $"{weakest.Name} is restless, at loyalty {100 - weakest.Unrest}. A restless world yields less and may rise; the house otherwise clears {Money.Show(net)} a year."; storyTone = "warn"; }
    else if (lg is { Debt: > 0 }) { story = $"The house owes {Money.Show(lg.Debt)}{(lg.LenderName != null ? $" to the bank of {lg.LenderName}" : " to the counting-houses")}, and pays {Money.Show(lg.LoanInstalment)} of it a year. After that it clears {Money.Show(net)} a year."; storyTone = "warn"; }
    else if (lands.Count == 0) { story = "The house holds no land. What it has is its purse, its ventures and its name; a fief is won, granted, or married into."; storyTone = ""; }
    else if (lg != null) { story = $"The house clears {Money.Show(net)} a year{(top != null ? $", the most of it from {top.Source}" : "")}, and is the {Ordinal(lg.Rank)} richest of {lg.Houses} houses{(above != null ? $", {Money.Show(above.Wealth - lg.Wealth)} behind {above.Name}" : below != null ? $", {Money.Show(lg.Wealth - below.Wealth)} ahead of {below.Name}" : "")}."; storyTone = net > 0 ? "good" : ""; }
    else { story = $"The house clears {Money.Show(net)} a year."; storyTone = net > 0 ? "good" : ""; }
}
<div class="dash keep" style="--accent:@m.HouseAccent">
    <header class="dash-head picture">
        <div class="dh-title"><Sigil HouseId="@house.Id" Accent="@house.AccentColor" Size="22" /> <b>@house.Name</b>
            <span class="muted">@titleName · @house.Culture culture · @Counted.Worlds(planets)@(stations > 0 ? $" · {Counted.Stations(stations)}" : "")@(claims > 0 ? $" · {Counted.Claims(claims)}" : "") · <span data-house-citizens="@citizens" title="The citizens of every world and station of the house. On the scale the rules reckon by, they come to @pop.">@Census.Say(citizens) citizens</span> · tithe @(m.Standing?.TaxPolicy ?? "customary")</span></div>
        <p class="headline @storyTone">@story</p>
        <div class="tiles">
            <Tile Label="In the treasury" Value="@Money.Held(house.Treasury)" Tone="@(m.Treasury.Insolvent ? "bad" : net < 0 ? "warn" : net > 0 ? "good" : "")"
                  Note="@(net > 0 ? $"+{Money.Show(net)} a year" : net < 0 ? $"−{Money.Show(-net)} a year · {(lasts <= 0 ? "gone within the year" : Counted.Years(lasts) + " left")}" : "neither growing nor shrinking")"
                  Title="What the house has in hand, and what a year adds to it or takes from it." />
            <Tile Label="Takes in a year" Value="@($"+{Money.Show(gross)}")" Tone="@(spend > gross ? "warn" : "")" Share="@(gross > 0 ? 100 * spend / gross : spend > 0 ? 100 : 0)"
                  Note="@(gross == 0 ? (spend > 0 ? $"nothing, and spends {Money.Show(spend)}" : "nothing, and spends nothing") : (spend > gross ? $"spends {Money.Show(spend)}, which is {Money.Show(spend - gross)} more" : $"spends {Money.Show(spend)} of it ({100 * spend / gross}%)") + (drain != null ? $" · most on {drain.Source}" : ""))"
                  Title="@(lg == null ? "" : string.Join(" · ", lg.Lines.Where(l => l.Delta.Credits != 0).OrderByDescending(l => l.Delta.Credits).Select(l => $"{l.Source} {Money.Signed(l.Delta.Credits)}")))" />
            @if (lg != null)
            {
                <Tile Label="Wealth" Value="@Money.Show(lg.Wealth)" Share="@(100 * Math.Max(0, lg.Wealth) / richest)" Tone="@(lg.Rank * 3 <= lg.Houses ? "good" : "")"
                      Note="@($"{Ordinal(lg.Rank)} of {lg.Houses} houses · {lg.Tier}")"
                      Title="@(above != null ? $"{above.Name} is next above, at {Money.Show(above.Wealth)}. The bar is your wealth against the richest house's." : "The richest house of the Reach.")" />
                <Tile Label="Debt" Value="@(lg.Debt > 0 ? Money.Show(lg.Debt) : "none")" Tone="@(lg.Debt > 0 ? "warn" : "good")"
                      Note="@(lg.Debt > 0 ? $"{Money.Show(lg.LoanInstalment)} a year to {(lg.LenderName != null ? "the bank of " + lg.LenderName : "the counting-houses")}" : lg.Loan.Refusal == null ? "nothing owed · the counting-houses would lend" : "nothing owed")"
                      Title="@(lg.Debt > 0 ? "" : lg.Loan.Refusal ?? lg.Loan.Label)" />
            }
            @if (lands.Count > 0)
            {
                <Tile Label="The worlds" Value="@($"{lands.Count} · {pop} pop")" Tone="@(besieged != null || loyal < 50 ? "bad" : loyal < 65 || thriving < 35 ? "warn" : "good")"
                      Bars="@(new (string, int, bool)[] { ("Loyalty", loyal, loyal < 50), ("Thriving", thriving, thriving < 35) })"
                      Note="@(besieged != null ? $"{besieged.Name} is besieged" : lands.Count == 1 ? $"{weakest!.Name}" : $"least loyal: {weakest!.Name}")"
                      Title="Loyalty is that of the least loyal world; thriving is the average prosperity of them all." />
            }
            else { <Tile Label="The worlds" Value="none" Note="a fief is won, granted, or married into" /> }
            <Tile Label="Legitimacy" Value="@house.Legitimacy.ToString()" Tone="@(m.Standing is { Instability: > 0 } ? "warn" : "")"
                  Share="@(m.Standing is { NextTitle: not null, NextRequirement: > 0 } st ? 100 * house.Legitimacy / st.NextRequirement : house.Legitimacy)"
                  Note="@(m.Standing is { Instability: > 0 } si ? $"the rank of {titleName} outstrips it by {si.Instability}" : m.Standing is { NextTitle: not null, NextRequirement: > 0 } sn ? $"{sn.NextRequirement} is wanted for {sn.NextTitle} · {Ordinal(legitRank)} of {legitOf}" : $"{Ordinal(legitRank)} of {legitOf} houses")"
                  Title="How rightful the house is held to be. It is what a petition for a higher title is judged on." />
        </div>
    </header>
    @if (w.Boosts.Count > 0 || w.MoneyEase != MoneySettings.Standard)
    {
        <div class="muted small money-settings" data-money-settings title="Chosen when this game was begun. They cannot be changed in a game.">@(w.MoneyEase != MoneySettings.Standard ? "Making money: " + MoneySettings.Name(w.MoneyEase) + ". " : "")@MoneySettings.Says(w)</div>
    }
    <div class="ex-tabs">
        <button class="rung @(_view == "estate" ? "here" : "")" @onclick='() => _view = "estate"'>The estate</button>
        <button class="rung @(_view == "ledger" ? "here" : "")" @onclick='() => _view = "ledger"'>The ledger</button>
        <button class="rung @(_view == "ventures" ? "here" : "")" @onclick='() => _view = "ventures"'>Ventures@(m.Businesses?.Count > 0 ? $" · {m.Businesses.Count}" : "")</button>
        <button class="rung @(_view == "household" ? "here" : "")" @onclick='() => _view = "household"'>The household · @m.Household.Count</button>
        <button class="rung @(_view == "council" ? "here" : "")" data-tab-council @onclick='() => _view = "council"'>The council · @house.Duties.Count of @HouseholdSystem.Roles.Length</button>
        <button class="rung @(_view == "court" ? "here" : "")" data-tab-court title="The house's own court: tutor, wet nurse, physician, guard, duel master, shipwright, master of ceremonies. It goes with the house whatever rank or office it holds." @onclick='() => _view = "court"'>The court · @house.Court.Count of @CourtSystem.Positions.Length</button>
        <button class="rung @(_view == "purse" ? "here" : "")" @onclick='() => _view = "purse"'>Purses and the will</button>
    </div>
    @if (_view == "household")
    {
    <div class="dash-grid keep2-grid">
        <div class="deck-col">
        <section class="panel">
            <h3><Icon Name="dynasty" Size="13" /> The household <span class="muted">@m.Household.Count</span></h3>
            @if (focus != null)
            {
                var hl = m.Household.FirstOrDefault(x => x.Id == focus.Id); var rel = w.GetRelationship(focus.Id, pid); int d = rel?.Disposition ?? 0;
                <div class="seat-card">
                    <Portrait Id="@focus.Id" Name="@focus.Name" Sex="@focus.Sex" Age="@focus.Age" Alive="@focus.Alive" Accent="@m.HouseAccent" Size="56" />
                    <div class="sc-body">
                        <div class="sc-name">@focus.Name <span class="muted">@focus.Age@(focus.Sex.Length > 0 ? $" · {focus.Sex}" : "")@(c.Careers.RankName(focus.CareerTrack, focus.CareerRank, G.World!.Era) is { } rn ? $" · {rn}" : "")</span></div>
                        <div class="muted small">@(hl?.Married == true ? "wed · " : "")@(hl?.Hidden == true ? "fostered away · " : "")<span class="@(d < -20 ? "warn" : d > 20 ? "good" : "")">@(d >= 0 ? "+" : "")@d toward you</span>@(focus.NatureTraits.Count > 0 ? " · " + string.Join(", ", focus.NatureTraits.Concat(focus.AptitudeTraits)) : "")@(focus.Ambition.Length > 0 ? $" · wants: {focus.Ambition.Replace('_', ' ')}" : "")</div>
                        @if (hl != null && hl.Actions.Count > 0) { <div class="sc-actions">@foreach (var o in hl.Actions) { if (o.Id == "defiant") { <span class="pill warn">defiant</span> } else { <button class="opt inline tiny" disabled="@(o.Refusal != null)" title="@(o.Refusal ?? HouseholdWords.Tip(o.Id))" @onclick="() => G.Execute(Household(o.Id, hl.Id))">@o.Label</button> } } </div> }
                    </div>
                    <button class="win-close" @onclick="() => _focus = null">✕</button>
                </div>
            }
            @foreach (var h in m.Household)
            {
                var pc = w.Char(h.Id); int pd = w.GetRelationship(h.Id, pid)?.Disposition ?? 0;
                string what = pc == null ? "" : string.Join(" · ", new[] { c.Careers.RankName(pc.CareerTrack, pc.CareerRank, w.Era), pc.Ambition.Length > 0 && pc.Age >= 16 ? "wants " + AmbitionSystem.Wants(pc.Ambition) : null }.Where(x => !string.IsNullOrEmpty(x)));
                <div class="person" @onclick="() => _focus = h.Id">
                    <Portrait Id="@h.Id" Name="@h.Name" Sex="@h.Sex" Age="@h.Age" Accent="@m.HouseAccent" Size="28" />
                    <span class="p-who"><b>@h.Name</b> <span class="muted">@h.Age@(h.Sex.Length > 0 ? $" · {h.Sex}" : "")@(h.Married ? " · wed" : "")@(h.Hidden ? " · fostered away" : "")</span>
                        <span class="p-what">@if (h.Id != pid) { <i class="@(pd < -20 ? "bad" : pd > 20 ? "good" : "")">@(pd >= 0 ? "+" : "")@pd toward you</i> }@(what.Length > 0 ? (h.Id != pid ? " · " : "") + what : "")</span></span>
                    @foreach (var o in h.Actions)
                    {
                        @if (o.Id == "defiant") { <span class="pill warn">defiant</span> }
                        else { <button class="opt inline tiny" disabled="@(o.Refusal != null)" title="@(o.Refusal ?? HouseholdWords.Tip(o.Id))" @onclick:stopPropagation @onclick="() => G.Execute(Household(o.Id, h.Id))">@o.Label</button> }
                    }
                </div>
            }
            @if (m.Household.Count == 0) { <div class="muted">You are the last of your name.</div> }
        </section>
        @if (m.Standing is { } s)
        {
            <section class="panel">
                <h3><Icon Name="legitimacy" Size="13" /> Decrees</h3>
                <div class="muted small">Tithe: @s.TaxPolicy — set in the Chancery (Laws), with the rest of the house's law.</div>
                <details><summary>Succession: @s.SuccessionLaw</summary>@foreach (var o in s.LawOptions) { var wouldBe = DynastySystem.Line(G.World!, G.World!.Protagonist!, o.Id).FirstOrDefault(); var nowHeir = DynastySystem.FindHeir(G.World!, G.World!.Protagonist!); <button class="opt" disabled="@(o.Refusal != null)" title="@(o.Refusal ?? $"{char.ToUpperInvariant(o.Label[0])}{o.Label[1..]}: {DynastySystem.LawSays(o.Id)}. Your heir would be {wouldBe?.Name ?? "nobody"}{(wouldBe?.Id == nowHeir?.Id ? ", as now" : nowHeir != null ? $", not {nowHeir.Name}" : "")}{(G.World!.House(G.World.Protagonist!.HouseId)?.NamedHeirId.Length > 0 ? " (the heir you named comes first under any law)" : "")}. Costs 2 influence this year.")" @onclick='() => G.AskDo("Change the law of succession to " + o.Label + "?", "The law decides who of the blood comes first when you die: it changes who your heir is from today, and those passed over will know it. The Dynasty window shows the line as it stands; look there after.", "Change the law", new SetSuccessionLawCommand(pid, o.Id))'>@o.Label</button> }</details>
                <div class="kv" title="How dangerous the other houses take yours to be. It rises with your share of the spheres (the Navy, the Senate, the courts, the counting-houses) above an even share, by 5 for every holding past the first, with every rank seized by force, and with holding the capital. The higher it stands, the readier the others are to band against you."><span><Icon Name="threat" Size="12" /> How dangerous others think us</span><b class="@(s.Threat >= 60 ? "warn" : "")">@s.Threat</b></div>
                @if (s.Instability > 0) { <div class="kv"><span>Title instability</span><b class="warn">@s.Instability</b></div> }
                @if (s.Honors.Count > 0) { <div class="kv"><span><Icon Name="honor" Size="12" /> Honors</span><b>@string.Join(", ", s.Honors)</b></div> }
                @if (s.Claims.Count > 0) { <div class="kv"><span><Icon Name="claim" Size="12" /> Claims</span><b>@string.Join(", ", s.Claims.Select(tid => c.Titles.NameOf(tid, G.World!.Era)))</b></div> }
                <div class="muted small">Titles, the throne and the spheres are pursued in the Senate.</div>
            </section>
        }
        </div>
        <div class="deck-col"><HouseholdPanel /></div>
    </div>
    }
    else if (_view == "council") { <div class="dash-grid deck-one"><div class="deck-col"><CouncilPanel /></div></div> }
    else if (_view == "court") { <div class="dash-grid deck-one"><div class="deck-col"><CourtPanel /></div></div> }
    else if (_view == "purse") { <div class="dash-grid deck-one"><div class="deck-col"><WealthPanel /></div></div> }
    else
    {
    <div class="dash-grid deck2-grid">
        <div class="deck-col">
        @if (_view == "estate") {
        <section class="panel">
            <h3><Icon Name="worlds" Size="13" /> The domain <span class="muted">@Counted.Holdings(m.Holdings.Count)</span></h3>
            @if (m.Holdings.Count == 0) { <div class="muted">Your house holds no land. A fief is won, granted, or married into.</div> }
            @if (m.Petition != null && !m.Holdings.Any(h => h.Kind == "planet"))
            {
                /* whom to ask for a world, and how far each is from saying yes (docs/PLAYTHROUGH.md, Medium, P80, P23) */
                var grantors = PetitionFiefCommand.Grantors(w, house.Id); var named = PetitionFiefCommand.Grantor(w, house.Id);
                <div class="petition" data-petition>
                    <div class="muted small">A house with a world to spare may entrust its least peopled one to you. It costs @PetitionFiefCommand.Influence influence, and its head must think @PetitionFiefCommand.Need.ToString("+0;-0") of you or better. Visits, gifts and votes move that: a house's page under Houses says what can be done.</div>
                    @if (grantors.Count == 0) { <div class="small warn">No house has a world to spare.</div> }
                    @foreach (var gr in grantors.Take(8))
                    {
                        string gid = gr.Id; int regard = PetitionFiefCommand.RegardOf(w, gr, w.Protagonist!); var would = PetitionFiefCommand.WouldGrant(w, gr); var ask = new PetitionFiefCommand(pid, gid); string? askNo = ask.Refusal(G.Ctx);
                        <div class="line petition-row" data-grantor="@gid" data-short="@Math.Max(0, PetitionFiefCommand.Need - regard)">
                            <b>@gr.Name</b>@(gr.Id == named?.Id ? " · the house the Reach would name" : "")
                            <span class="muted small"> · would give @(would?.Name ?? "a world") · its head thinks <b class="@(regard >= PetitionFiefCommand.Need ? "good" : "warn")">@regard.ToString("+0;-0")</b> of you@(regard >= PetitionFiefCommand.Need ? ": enough" : $": {PetitionFiefCommand.Need - regard} short")</span>
                            <button class="opt inline tiny" disabled="@(askNo != null)" title="@(askNo ?? "")" @onclick="() => G.Execute(ask)">Petition</button>
                            <button class="opt inline tiny" @onclick='() => OnGo.InvokeAsync("houses:" + gid)'>Its page ▸</button>
                        </div>
                    }
                </div>
            }
            @{ var under = w.ProvincesOf(house.Id).Where(x => x.h.OwnerId != house.Id).ToList(); }
            @if (under.Count > 0)
            {
                /* one player did not know for nineteen years that the house held any (docs/PLAYTHROUGH.md, Medium, P89) */
                <div class="held-under" data-held-under="@under.Count">
                    <h4>Provinces held under other houses <span class="muted small">yours for life · what they yield is in the ledger, less the dues</span></h4>
                    @foreach (var (uh, ui) in under)
                    {
                        var up = uh.Provinces[ui]; var uy = ProvinceSystem.Yield(w, c.Holdings, uh, up); var ud = ProvinceSystem.Dues(w, c.Holdings, uh, ui); string usys = uh.SystemId;
                        <button class="ol-row held-row" title="Open its system: the province, its city and what can be built there" @onclick='() => OnGo.InvokeAsync("galaxy:" + usys)'>
                            <b>@up.Name</b> <span class="muted">on @uh.Name · under @(w.House(uh.OwnerId)?.Name) · @(c.Holdings.Provinces.Focus(up.Focus)?.Name ?? up.Focus)@(up.City.Length > 0 ? " · " + up.City : "") · level @up.Level · @(uy.IsEmpty() ? "pays nothing" : "+" + CourtProjection.Bundle(uy) + " a year")@(up.Withheld ? " · you are withholding the dues" : ud.IsEmpty() ? " · no dues owed" : " · owes " + CourtProjection.Bundle(ud) + " (" + ProvinceSystem.DuesName(ProvinceSystem.DuesOf(w, up)) + ")")</span>
                        </button>
                    }
                </div>
            }
            <div class="holding-board">
                @foreach (var h in m.Holdings)
                {
                    var holding = w.Holding(h.Id)!; var sys = w.Galaxy?.System(holding.SystemId); var (pf, pg) = Svg.Planet(sys?.PlanetClass ?? "terran");
                    <div class="hcard @(h.Besieged ? "besieged" : "") @(h.Unrest >= 50 ? "restless" : "")">
                        <div class="hc-head"><i class="pdot" style="background:radial-gradient(circle at 35% 35%, @pg, @pf)"></i><div><b>@h.Name</b><div class="muted small">@h.SpecName@(h.Kind == "station" ? " · station" : h.Kind == "claim" ? " · claim" : "")@(h.SystemName != null ? $" · {h.SystemName}" : "")@(h.Culture.Length > 0 ? $" · {h.Culture}" : "")@(h.Kind == "planet" && w.Holding(h.Id) is { } hw && SystemWorks.In(w, hw.SystemId).Count() is > 0 and var nw ? $" · {nw} work{(nw == 1 ? "" : "s")} round its sun" : "")</div></div>
                            @if (h.Besieged) { <span class="pill warn">besieged</span> }
                            @if (house.SeatGrade > 0 && house.SeatHoldingId == h.Id) { <span class="pill good" data-seat="@house.SeatGrade" title="@WealthSystem.SeatGives(house.SeatGrade)">the house's seat: a @WealthSystem.SeatName(house.SeatGrade)</span> }</div>
                        @if (h.Kind != "claim")
                        {
                            <div class="gauges">
                                <div class="gauge" title="@("Loyalty is 100 less the world's unrest (" + h.Unrest + "). " + WhySays(G.Turn?.Economy?.UnrestWhy(w, w.Holding(h.Id)!), "Each year unrest moves by", "a year"))"><span>Loyalty</span><i><b style="width:@(100 - h.Unrest)%" class="@(h.Unrest >= 50 ? "low" : "")"></b></i><em>@(100 - h.Unrest)</em></div>
                                <div class="gauge" title="@("Prosperity is " + h.Prosperity + " and settles at " + h.ProsperityTarget + ", a step nearer each year. " + WhySays(G.Turn?.Economy?.ProsperityWhy(w, w.Holding(h.Id)!), "It settles there because", "in all, held between 0 and 100"))"><span>Prosperity</span><i><b style="width:@h.Prosperity%" class="@(h.Prosperity < 35 ? "low" : h.Prosperity >= 75 ? "high" : "")"></b><u style="left:@h.ProsperityTarget%"></u></i><em>@h.Prosperity</em></div>
                                @if (h.MaxPopulation > 0) { <div class="gauge" title="@(h.Population >= h.MaxPopulation ? "Population: the world is full. Habitats, laid on the world from the map (its system, then the body), make room for more." : "Population, and the most the world can hold. Habitats laid on the world make room for more.")"><span>Pop@(h.Population >= h.MaxPopulation ? " · full" : "")</span><i><b style="width:@(100 * h.Population / Math.Max(1, h.MaxPopulation))%"></b></i><em title="@(G.World!.Holding(h.Id) is { } hcw ? GalaxyMap.CitizensTip(G.World!, hcw, h.MaxPopulation) : "")">@(G.World!.Holding(h.Id) is { } hcc ? Census.Say(Census.Citizens(G.World!, hcc)) : h.Population.ToString()) <span class="muted">· @h.Population/@h.MaxPopulation</span></em></div> }
                            </div>
                            <details class="why" data-why="@h.Id"><summary>Why loyalty and prosperity are what they are</summary>
                                @{ var uw = G.Turn?.Economy?.UnrestWhy(w, w.Holding(h.Id)!) ?? new(); var pw = G.Turn?.Economy?.ProsperityWhy(w, w.Holding(h.Id)!) ?? new(); }
                                <div class="why-col"><b>Unrest, each year</b> <span class="muted small">(loyalty is 100 less unrest: @h.Unrest now)</span>
                                    @foreach (var x in uw) { <div class="why-line"><span>@Cap(x.what)</span><em class="@(x.by > 0 ? "bad" : "good")">@(x.by > 0 ? "+" : "−")@Math.Abs(x.by)</em></div> }
                                    <div class="why-line sum"><span>In all</span><em>@(uw.Sum(x => x.by) > 0 ? "+" : uw.Sum(x => x.by) < 0 ? "−" : "")@Math.Abs(uw.Sum(x => x.by)) a year</em></div></div>
                                <div class="why-col"><b>Prosperity settles at @h.ProsperityTarget</b> <span class="muted small">(@h.Prosperity now, a step nearer each year)</span>
                                    @foreach (var x in pw) { <div class="why-line"><span>@Cap(x.what)</span><em class="@(x.by > 0 ? "good" : "bad")">@(x.by > 0 ? "+" : "−")@Math.Abs(x.by)</em></div> }
                                    <div class="why-line sum"><span>In all</span><em>@pw.Sum(x => x.by)@(pw.Sum(x => x.by) is < 0 or > 100 ? " (held between 0 and 100)" : "")</em></div></div>
                            </details>
                        }
                        @if (h.Belt > 0) { <div class="kv"><span>Belt</span><b>@(new string('●', h.Belt)) richness @h.Belt</b></div> }
                        <div class="kv"><span><Icon Name="governor" Size="12" /> Governor</span><b>@(h.GovernorName ?? "—") @if (h.GovernorName != null && h.GovernorDisposition < 100) { <span class="gov-chip @GovClass(h)" title="@GovTitle(h)">@GovText(h)</span> } @if (h.GovernorAdministration >= 3) { <span class="gov-chip able" title="an able administrator">able</span> }</b></div>
                        <div class="chips">@foreach (var b in h.Buildings) { <span class="pill small">@b</span> } <span class="muted small" title="The world's building slots: what stands, what is rising and the works on the world itself. The same count as the system's own panel on the map, where each is built.">@h.SlotsUsed of @h.Slots slots in use (standing, rising and works)</span></div>
                        <div class="row">
                            @if (h.Invest != null && h.Kind != "claim") { <button class="opt inline tiny" disabled="@(h.Invest.Refusal != null)" title="@h.Invest.Refusal" @onclick="() => G.Execute(new InvestCommand(pid, h.Id, c.Businesses))">@h.Invest.Label</button> }
                        </div>
                        @if (holding.IsPlanet && sys != null)
                        {
                            /* what is rising, the slots free, and the one list of what can be built, the same the system's own panel
                               reads (docs/PLAYTHROUGH.md, Medium, Building and holding, B2 and B42) */
                            var risingHere = w.Projects.Where(p => p.OwnerId == house.Id && (p.TargetId == holding.Id || p.TargetId.StartsWith(holding.SystemId + "#", StringComparison.Ordinal) || p.TargetId.StartsWith(holding.Id + "@", StringComparison.Ordinal))).ToList();
                            var canBuild = SystemWorks.BuildableOn(w, c.Holdings, c.Titles, house, holding, G.Ctx); var nowBuild = canBuild.Where(x => x.Refusal == null).ToList(); int homeBody = sys.Bodies.FindIndex(x => x.IsPrimary); string sysId = sys.Id; string hidB = holding.Id;
                            int free = Math.Max(0, h.Slots - h.SlotsUsed);
                            <div class="kv" data-free-slots="@free"><span>Slots</span><b class="@(free > 0 ? "good" : "")">@free free of @h.Slots</b></div>
                            @if (risingHere.Count > 0)
                            {
                                <div class="hc-rising" data-rising-here="@risingHere.Count"><span class="muted small">Rising</span>
                                    @foreach (var rp in risingHere) { <span class="pill small @(rp.Stalled ? "warn" : "")" title="@(rp.Stalled ? "Stalled: the treasury could not pay its share last year." : rp.Paused ? "Paused." : "")">@Cap(rp.Name) · @rp.TurnsLeft yr</span> }
                                </div>
                            }
                            <details class="hc-build" data-can-begin="@nowBuild.Count"><summary><Icon Name="build" Size="12" /> Build <span class="muted small">@(free <= 0 ? "no free slot" : nowBuild.Count + " can be begun now")</span></summary>
                                @if (nowBuild.Count == 0) { <div class="muted small">@(free <= 0 ? "Every slot is taken. Development, rank and cleared ground open more." : "Nothing can be begun now.") The system's own panel says what each thing lacks.</div> }
                                @foreach (var bo in nowBuild)
                                {
                                    string boId = bo.Id; bool isWork = bo.Work != null; string label = (bo.BuildTurns > 1 ? "Begin " : "Build ") + bo.Name + "  (" + CourtProjection.Bundle(bo.Cost) + (bo.BuildTurns > 1 ? " · " + bo.BuildTurns + " years" : "") + ")";
                                    <button class="opt" title="@(bo.Work?.Description ?? "")" @onclick="() => G.Execute(isWork ? new BuildWorkCommand(pid, sysId, homeBody, boId, c.Holdings, c.Titles) : new BuildCommand(pid, hidB, boId, c.Holdings, c.Titles))">@label</button>
                                }
                                <button class="opt inline tiny" @onclick='() => OnGo.InvokeAsync("galaxy:" + sysId)'>@(canBuild.Count - nowBuild.Count) more not yet possible, the other bodies and the great works: its system ▸</button>
                            </details>
                        }
                        else
                        {
                            <details><summary><Icon Name="build" Size="12" /> Build</summary>@foreach (var b in h.Builds) { <button class="opt" disabled="@(!b.Available)" title="@b.Tooltip" @onclick="() => G.Execute(new BuildCommand(pid, h.Id, b.BuildingId, c.Holdings, c.Titles))">@b.Label</button> }</details>
                        }
                        @if (h.Ships.Count > 0) { <details><summary><Icon Name="ship" Size="12" /> Shipyard</summary>@foreach (var sh in h.Ships) { <button class="opt" disabled="@(sh.Refusal != null)" title="@sh.Refusal" @onclick="() => G.Execute(new RaiseFleetCommand(pid, h.Id, c.Fleets, c.ShipClasses, sh.ClassId, c.Titles))">@sh.Label</button> }</details> }
                        @if (h.GovernorOptions is { Count: > 0 }) { <details><summary>Governor's chair</summary>@foreach (var o in h.GovernorOptions) { <button class="opt" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new AppointGovernorCommand(pid, h.Id, o.Id))">@o.Label</button> }</details> }
                    </div>
                }
            </div>
        </section>
        }
        @if (lg != null)
        {
        @if (_view == "ledger") {
        <section class="panel">
            <h3><Icon Name="houses" Size="13" /> The wealth of the houses <span class="muted">the eight richest@(lg.Rank > 8 ? ", and you" : "")</span></h3>
                @foreach (var wl in lg.Table.Take(8)) { <div class="wealth-row @(wl.Mine ? "mine" : "")"><Sigil HouseId="@wl.HouseId" Accent="@wl.Accent" Size="14" /> <span>@wl.Name</span><span class="bar"><i style="width:@(Math.Max(2, 100 * Math.Max(0, wl.Wealth) / Math.Max(1, lg.Table[0].Wealth)))%; background:@wl.Accent"></i></span><b>@Money.Show(wl.Wealth)</b></div> }
            @if (lg.Rank > 8 && lg.Table.FirstOrDefault(x => x.Mine) is { } mine) { <div class="wealth-row mine"><Sigil HouseId="@mine.HouseId" Accent="@mine.Accent" Size="14" /> <span>@Ordinal(lg.Rank) · @mine.Name</span><span class="bar"><i style="width:@(Math.Max(2, 100 * Math.Max(0, mine.Wealth) / richest))%; background:@mine.Accent"></i></span><b>@Money.Show(mine.Wealth)</b></div> }
        </section>
        }
        }
        </div>
        <div class="deck-col">
        @if (lg != null)
        {
        @if (_view == "ledger") {
        <section class="panel">
            <h3><Icon Name="credits" Size="13" /> Where the coin comes from, and goes <span class="muted">credits a year, largest first</span></h3>
                <div class="ledger-bars">
                    @foreach (var l in lg.Lines.OrderByDescending(x => x.Delta.Credits))
                    {
                        int v = l.Delta.Credits;
                        <div class="lb" title="@Delta(l.Delta)"><span class="src"><Icon Name="@(l.Kind == "world" ? "planet" : l.Kind == "station" || l.Kind == "claim" || l.Kind == "work" ? "station" : l.Kind == "fleet" ? "fleet" : l.Kind == "loan" || l.Kind == "interest" ? "treasury_pool" : "trade_hub")" Size="11" /> @l.Source</span>
                            <span class="track"><i class="neg" style="width:@(v < 0 ? 50.0 * -v / maxAbs : 0)%"></i><i class="pos" style="width:@(v > 0 ? 50.0 * v / maxAbs : 0)%"></i></span>
                            <b class="@(v > 0 ? "good" : v < 0 ? "warn" : "muted")">@Money.Signed(v)</b></div>
                    }
                    <div class="lb net"><span class="src"><b>What is left</b></span><span class="track"><i class="neg" style="width:@(net < 0 ? Math.Min(50.0, 50.0 * -net / maxAbs) : 0)%"></i><i class="pos" style="width:@(net > 0 ? Math.Min(50.0, 50.0 * net / maxAbs) : 0)%"></i></span><b class="@(net > 0 ? "good" : net < 0 ? "warn" : "muted")">@Money.Signed(net)</b></div>
                </div>
                @if (Goods(lg.Net) is { Length: > 0 } goods) { <div class="muted small">And in goods, each year: @goods</div> }
                @if (YearInBrief.Accounts(w, Resource.Credits) is { } acc)
                {
                    <details class="why" data-last-year open="@(acc.close < 0)"><summary>Last year's accounts: the treasury opened at @Money.Show(acc.open) credits and closed at @Money.Show(acc.close) (@(acc.close - acc.open >= 0 ? "+" : "−")@Money.Show(Math.Abs(acc.close - acc.open)))</summary>
                        <div class="why-col">
                            <div class="why-line"><span>Opened the year at</span><em>@Money.Show(acc.open)</em></div>
                            @foreach (var a in acc.lines) { <div class="why-line" title="@a.Says"><span>@a.What</span><em class="@(a.By > 0 ? "good" : a.By < 0 ? "bad" : "")">@(a.By > 0 ? "+" : a.By < 0 ? "−" : "")@Money.Show(Math.Abs(a.By))</em></div> }
                            <div class="why-line sum"><span>Closed the year at</span><em>@Money.Show(acc.close)</em></div>
                        </div>
                        <div class="muted small">The three lines add up to the change. Hover each for what is in it. The same for the goods: @string.Join("; ", new[] { Resource.Materials, Resource.Manpower, Resource.Helium3 }.Select(r => YearInBrief.Accounts(w, r) is { } g ? $"{Resource.Label(r).ToLowerInvariant()} {g.open} → {g.close}" : "").Where(x => x.Length > 0)).</div>
                    </details>
                }
                @{ var outs = HouseAccounts.Outgoings(w, c.Holdings, house, G.Turn!.Economy); var outTotal = HouseAccounts.Total(outs); int yearEnd = house.Treasury.Credits + lg.Net.Credits - outTotal.Credits; }
                @if (outs.Count > 0)
                {
                    <h4 class="ledger-sub">Also going out this year <span class="muted">not standing costs: they end when the work does</span></h4>
                    <div class="ledger-outs" data-outgoings="@outTotal.Credits">
                        @foreach (var o in outs) { <div class="kv"><span>@Cap(o.what)</span><b class="warn">−@CourtProjection.Bundle(o.cost)</b></div> }
                    </div>
                }
                <div class="kv @(yearEnd < 0 ? "warn" : "")" data-yearend="@yearEnd"><span>The treasury at the year's end, if nothing else is done</span><b>@Money.Show(yearEnd) credits <i class="muted">· it holds @Money.Held(house.Treasury) now@(w.Protagonist!.Purse > 0 ? ", and your own purse " + Money.Show(w.Protagonist.Purse) : "")</i></b></div>
                @foreach (var su in LadderSystem.SuitsNaming(w, house.Id)) { bool forUs = su.RightId == house.Id; <div class="kv @(forUs ? "" : "warn")" data-atrisk="@su.Id"><span>@(forUs ? "May come in from the courts" : "At risk in the courts")</span><b>@Money.Show(LadderSystem.StakeOf(su)) credits <i class="muted">· @(w.House(LadderSystem.OtherIn(su, house.Id))?.Name)'s suit over @LadderSystem.MatterOf(su), heard at the year's end: Senate, Ladder and courts</i></b></div> }
                @{ var lastRulings = w.Judgments.Where(j => j.Turn == w.Turn - 1).ToList(); }
                @foreach (var jr in lastRulings) { bool won = jr.WinnerId == house.Id; <div class="kv @(won ? "good" : "warn")"><span>Last year, by order of the court</span><b>@(won ? "+" : "−")@Money.Show(jr.Sum) credits <i class="muted">· @(won ? "from" : "to") @(w.House(won ? jr.LoserId : jr.WinnerId)?.Name)</i></b></div> }
                @{ var fin = c.Businesses.Finance; int instal = Lending.InstalmentOf(house, fin); var lenders = Lending.Lenders(w, house.Id, c.Businesses); }
                @if (lg.Debt > 0)
                {
                    int left = Lending.Years(lg.Debt, instal);
                    <div class="kv warn" data-debt="@lg.Debt"><span>Debt</span><b>@Money.Show(lg.Debt) credits to @Lending.LenderName(w, house.LenderId) <i class="muted">· @Money.Show(instal) a year, and @(left == 1 ? "this year clears it" : left + " years clear it")</i></b></div>
                    <div class="row" data-repay>
                        <span class="muted small" title="What is owed is the whole of it, interest and all, from the day it is borrowed: paying sooner saves no interest. It shortens the years, ends the instalments, and a house that owes nothing is not sold up by its creditors.">Pay down</span>
                        @foreach (int part in new[] { 5, 10, 20, 50 }.Where(x => x < lg.Debt))
                        {
                            int pt = part; var payPart = new RepayLoanCommand(pid, pt); var partNo = payPart.Refusal(G.Ctx);
                            <button class="opt inline tiny" data-repay-part="@pt" disabled="@(partNo != null)" title="@(partNo ?? $"{Money.Show(lg.Debt - pt)} would be owed: {Counted.Years(Lending.Years(lg.Debt - pt, instal))} at {Money.Show(instal)} a year.")" @onclick="() => G.Execute(payPart)">@Money.Show(pt)</button>
                        }
                        <button class="opt inline" disabled="@(lg.Repay.Refusal != null)" title="@lg.Repay.Refusal" @onclick="() => G.Execute(new RepayLoanCommand(pid))">@lg.Repay.Label</button>
                    </div>
                }
                <details class="inline borrow" data-borrow>
                    <summary>@(lg.Debt > 0 ? "Borrow more" : "Borrow")</summary>
                    <div class="muted small">One lender at a time. What is owed is the sum and its interest together, paid off by the year; a year the treasury cannot find the instalment it goes below nought, and a house two years below nought is sold up for its creditors.</div>
                    @foreach (var lt in lenders)
                    {
                        string lid = lt.LenderId; int room = Lending.Room(w, house, lt);
                        int amt = Math.Clamp(_borrow.GetValueOrDefault(lid, Math.Min(room, fin.LoanPrincipal)) / Lending.Step * Lending.Step, Math.Min(Lending.Step, room), Math.Max(Lending.Step, room));
                        var take = new TakeLoanCommand(pid, c.Businesses, lid, amt); var takeNo = take.Refusal(G.Ctx);
                        int owedNew = Lending.Owed(amt, lt.RatePct), owedAll = (house.LenderId == lid ? house.Debt : 0) + owedNew, instNew = Lending.Instalment(fin, owedAll);
                        <div class="lender @(lt.Refusal != null ? "off" : "")" data-lender="@(lid.Length == 0 ? "counting-houses" : lid)" title="@lt.Why">
                            <div class="lender-top"><b>@Cap(lt.Lender)</b> <span class="muted small">up to @Money.Show(lt.Limit) credits · @lt.RatePct in the hundred@(house.LenderId == lid && house.Debt > 0 ? $" · you owe it {Money.Show(house.Debt)}, so {Money.Show(room)} more" : "")</span></div>
                            @if (lt.Refusal != null) { <div class="small warn">@Cap(lt.Refusal).</div> }
                            else if (room < Lending.Step) { <div class="small warn">It will lend you no more until some of what is owed is paid.</div> }
                            else
                            {
                                <div class="row">
                                    <button class="opt inline tiny" disabled="@(amt <= Lending.Step)" @onclick="() => _borrow[lid] = amt - Lending.Step">−@Money.Show(Lending.Step)</button>
                                    <b class="lender-amt" data-amount="@amt">@Money.Show(amt)</b>
                                    <button class="opt inline tiny" disabled="@(amt >= room)" @onclick="() => _borrow[lid] = amt + Lending.Step">+@Money.Show(Lending.Step)</button>
                                    <button class="opt inline tiny" disabled="@(amt >= room)" @onclick="() => _borrow[lid] = room">all @Money.Show(room)</button>
                                    <button class="opt inline" data-take-loan disabled="@(takeNo != null)" title="@(takeNo ?? lt.Why)" @onclick="() => G.Execute(take)">Borrow @Money.Show(amt)</button>
                                    <span class="muted small" data-loan-terms>owe @Money.Show(owedNew) for it@(owedAll != owedNew ? $" ({Money.Show(owedAll)} in all)" : ""): @Money.Show(instNew) a year for @Counted.Years(Lending.Years(owedAll, instNew))</span>
                                </div>
                            }
                        </div>
                    }
                </details>
        </section>
        }
        }
        @if (_view == "ledger") {
        <section class="panel">
            <h3><Icon Name="materials" Size="13" /> In the stores <span class="muted">what the house holds, and what a year adds</span></h3>
            <div class="res-grid">
                @foreach (var (name, val, d) in new[] { ("credits", m.Treasury.Credits, fc?.Credits), ("materials", m.Treasury.Materials, fc?.Materials), ("manpower", m.Treasury.Manpower, fc?.Manpower), ("influence", m.Treasury.Influence, fc?.Influence), ("exotics", m.Treasury.Exotics, fc?.Exotics), ("helium3", m.Treasury.Helium3, fc?.Helium3), ("rare_earths", m.Treasury.RareEarths, fc?.RareEarths), ("isotopes", m.Treasury.Isotopes, fc?.Isotopes) })
                { <div class="res-cell @(Resource.IsStrategic(name) ? "strat" : "")"><span class="muted"><Icon Name="@name" Size="12" /> @Resource.Label(name)</span><b>@(name == Resource.Credits ? Money.Held(house.Treasury) : Money.Of(name, val))</b>@if (d != null && d != 0) { <small class="@(d > 0 ? "up" : "down")">@Money.SignedOf(name, d.Value) /turn</small> }</div> }
            </div>
            @if (w.HasFlag("fuel_short")) { <div class="flag">The tanks are dry: readiness slides fifteen a turn and no fleet of yours may sail until helium-3 is found — a skimmer, or the Exchange.</div> }
            @if (m.Treasury.Insolvent) { <div class="flag">Insolvent: unrest climbs on every populated world and unpaid crews will desert.</div> }
            <div class="muted small deposits">Deposits under your worlds and claims: @(m.Deposits is { Count: > 0 } ? string.Join(" · ", m.Deposits.Select(Resource.Label)) : "none — what you need, you buy")</div>
            <div class="row">@if (m.Procure != null) { foreach (var o in m.Procure) { var res = o.Id["procure_".Length..]; <button class="opt inline tiny" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new BuyGoodCommand(pid, res, 3, c.Trade))">@o.Label</button> } }
                <button class="opt inline tiny" @onclick="@(() => OnGo.InvokeAsync("exchange"))">Every good, bought and sold: the Exchange ▸</button></div>
        </section>
        }
        @if (_view == "ventures") {
        <section class="panel">
            <h3><Icon Name="trade_hub" Size="13" /> Ventures <span class="muted">@(m.Businesses?.Count ?? 0) · @Counted.Sites(m.Assets?.Projects.Count ?? 0) under construction</span></h3>
            @if (m.Businesses is { Count: > 0 } bz)
            {
                foreach (var b in bz) { <div class="line small"><b>@b.Name</b> <span class="muted">@b.KindName · level @b.Level/@b.MaxLevel@(b.SystemName != null ? $" · {b.SystemName}" : "")</span> <span class="pill small @(b.Earnings <= 0 ? "warn" : "good")">@(b.Earnings >= 0 ? "+" : "")@Money.Show(b.Earnings) a year · worth @Money.Show(b.Value)</span></div> }
            }
            else { <div class="muted small">The house owns no venture. Coin that is not land still counts.</div> }
            <div class="row"><button class="opt inline tiny" @onclick="@(() => OnGo.InvokeAsync("exchange:ventures"))">Found, enlarge, buy and sell ventures: the Exchange ▸</button></div>
            @if (m.Claims is { Count: > 0 } cl)
            {
                <details><summary>Stake a belt claim <span class="muted">@Money.Show(c.Businesses.Finance.ClaimCredits) credits, @c.Businesses.Finance.ClaimMaterials materials</span></summary>
                    @{ var cspec = c.Holdings.Spec(StakeClaimCommand.Spec); int cbase = cspec?.BaseYield.Materials ?? 0, ckeep = cspec?.Upkeep.Credits ?? 0; }
                    <div class="muted small" data-claim-yield>A claim brings up @cbase materials a year and one more for each ● of the belt's richness, with some of any rare earths the belt holds and an exotic a year from the richest (●●●). It costs @Money.Credits(ckeep) a year to keep, and a belt takes as many claims as it has ●.</div>
                    @foreach (var k in cl) { <button class="opt" disabled="@(k.Refusal != null)" title="@k.Refusal" @onclick="() => G.Execute(new StakeClaimCommand(pid, k.SystemId, c.Holdings, c.Businesses))">@k.SystemName belt @(new string('●', k.Belt)) · +@(cbase + k.Belt) materials a year · @k.Staked/@k.Belt staked@(k.Refusal != null ? $" — {k.Refusal}" : "")</button> }
                </details>
            }
        </section>
        }
        </div>
    </div>
    }
</div>


@code {
    /* a list of causes in one line, for a tooltip: "Each year unrest moves by: a solvent house −2; the tithe +1: −1 a year" */
    private static string WhySays(List<(string what, int by)>? why, string lead, string tail) =>
        why == null || why.Count == 0 ? "" : lead + ": " + string.Join("; ", why.Select(x => $"{x.what} {(x.by > 0 ? "+" : "−")}{Math.Abs(x.by)}")) + $". That is {(why.Sum(x => x.by) > 0 ? "+" : why.Sum(x => x.by) < 0 ? "−" : "")}{Math.Abs(why.Sum(x => x.by))} {tail}.";
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    [Parameter] public EventCallback<string> OnGo { get; set; }
    private string? _focus; private string _view = "estate";
    /// <summary>The amount picked at each lender, by lender id.</summary>
    private readonly Dictionary<string, int> _borrow = new();
    /// <summary>The tab an alert asked for, and a stamp that changes each time one asks; a stamp is used once.</summary>
    [Parameter] public string Tab { get; set; } = "";
    [Parameter] public int TabStamp { get; set; }
    private static int _seenStamp;
    protected override void OnParametersSet() { if (TabStamp != _seenStamp) { _seenStamp = TabStamp; if (Tab.Length > 0) _view = Tab; } }
    private static string GovClass(HoldingCard h) => h.GovernorDisposition <= -30 ? "hostile" : h.GovernorDisposition < 10 ? "cool" : "loyal";
    private static string GovText(HoldingCard h) => h.GovernorDisposition <= -30 ? (h.GovernorAmbitious ? "hostile · ambitious" : "hostile") : h.GovernorDisposition < 10 ? "cool" : "loyal";
    private static string GovTitle(HoldingCard h) => "disposition toward you " + h.GovernorDisposition + (h.GovernorAmbitious ? " · ambitious" : "");
    private static string Ordinal(int n) => n % 100 is 11 or 12 or 13 ? $"{n}th" : (n % 10) switch { 1 => $"{n}st", 2 => $"{n}nd", 3 => $"{n}rd", _ => $"{n}th" };
    private static string Goods(Resources r) => string.Join(" · ", Resource.All.Where(k => k != "credits" && r.Get(k) != 0).Select(k => $"{(r.Get(k) > 0 ? "+" : "−")}{Math.Abs(r.Get(k))} {Resource.Label(k)}"));
    private static string Delta(Resources r) { var parts = Resource.All.Where(k => r.Get(k) != 0).Select(k => $"{Money.SignedOf(k, r.Get(k))} {k}").ToList(); return parts.Count == 0 ? "—" : string.Join(" · ", parts); }
    private ICommand Household(string optionId, string childId) => optionId == "recall" ? new RecallCommand(G.World!.ProtagonistId, childId) : new FosterCommand(G.World!.ProtagonistId, childId);
}
