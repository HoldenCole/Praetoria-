@inject GameClient G
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var house = w.House(w.Protagonist!.HouseId)!;
    var fc = G.Turn!.Economy?.Forecast(w, house.Id, G.Turn.Fleets);
}
<div class="house-screen" style="--accent:@m.HouseAccent">
    <div class="col">
        <section class="panel">
            <div class="who-head"><Sigil HouseId="@house.Id" Accent="@house.AccentColor" Size="56" /><div><h2>@house.Name</h2><div class="sub">@m.Character.TitleName · legitimacy @house.Legitimacy · @house.Culture culture</div></div></div>
            <div class="res-grid">
                @foreach (var (name, val, d) in new[] { ("credits", m.Treasury.Credits, fc?.Credits), ("materials", m.Treasury.Materials, fc?.Materials), ("manpower", m.Treasury.Manpower, fc?.Manpower), ("influence", m.Treasury.Influence, fc?.Influence), ("exotics", m.Treasury.Exotics, fc?.Exotics) })
                { <div class="res-cell"><span class="muted">@name</span><b>@val</b>@if (d != null && d != 0) { <small class="@(d > 0 ? "up" : "down")">@(d > 0 ? "+" : "")@d /turn</small> }</div> }
            </div>
            @if (m.Treasury.Insolvent) { <div class="flag">Insolvent: unrest climbs on every populated world and unpaid crews will desert.</div> }
        </section>

        @if (m.Standing is { } s)
        {
            <section class="panel">
                <h3>Standing</h3>
                <div class="kv"><span>Threat the galaxy reads in us</span><b>@s.Threat</b></div>
                @if (s.Instability > 0) { <div class="kv"><span>Title instability</span><b class="warn">@s.Instability</b></div> }
                @if (s.Spheres.Length > 0) { <div class="kv"><span>Spheres</span><b>@s.Spheres</b></div> }
                @if (s.Honors.Count > 0) { <div class="kv"><span>Honors</span><b>@string.Join(", ", s.Honors)</b></div> }
                @if (s.Claims.Count > 0) { <div class="kv"><span>Claims</span><b>@string.Join(", ", s.Claims)</b></div> }
                @if (s.NextTitle != null)
                {
                    <h4>Toward @s.NextTitle <span class="muted">(needs legitimacy @s.NextRequirement)</span></h4>
                    @foreach (var p in s.Paths) { <button class="opt" disabled="@(!p.Available)" title="@p.Tooltip" @onclick="() => G.Execute(PathCommand(p.Id))">@p.Label</button> }
                }
            </section>
            <section class="panel">
                <h3>Decrees</h3>
                <details><summary>Succession: @s.SuccessionLaw</summary>@foreach (var o in s.LawOptions) { <button class="opt" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new SetSuccessionLawCommand(pid, o.Id))">@o.Label</button> }</details>
                <details><summary>Tithe: @s.TaxPolicy</summary>@foreach (var o in s.TaxOptions) { <button class="opt" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new SetTaxPolicyCommand(pid, o.Id, c.Holdings))">@o.Label</button> }</details>
                <details><summary>The exchange @(ExchangeCommand.HasExchange(w, house.Id, c.Holdings) ? "" : "· no market: the caravaneers take half")</summary>
                    @foreach (var o in s.ExchangeOptions) { var rate = c.Holdings.Rates.First(r => $"{r.Give}>{r.Get}" == o.Id); <button class="opt" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new ExchangeCommand(pid, rate, c.Holdings))">@o.Label</button> }
                </details>
                <details><summary>The throne @(s.Throne.HoldsThrone ? "· yours" : s.Throne.EmperorName != null ? $"· {s.Throne.EmperorName}" : "· empty")</summary>
                    <button class="opt" disabled="@(s.Throne.ProclaimRefusal != null)" title="@s.Throne.ProclaimRefusal" @onclick="() => G.Execute(new ProclaimImperiumCommand(pid, c.Titles))">Proclaim the Imperium (3 influence, 2 agents)</button>
                    <button class="opt" disabled="@(s.Throne.SeizeRefusal != null)" title="@s.Throne.SeizeRefusal" @onclick="() => G.Execute(new SeizeThroneCommand(pid, c.Titles, c.Friction))">Seize the throne (2 treasury, 2 agents)</button>
                </details>
            </section>
        }

        @if (m.Crises is { } cr)
        {
            <section class="panel">
                <h3>The realm's temperature</h3>
                <div class="muted small">@cr.Counters</div>
                @foreach (var a in cr.Active)
                {
                    <div class="crisis"><div><b>@a.Name</b> · severity @a.Severity · since turn @a.Since @(a.Author != null ? $"· authored by {a.Author}" : "· organic")</div>
                        @foreach (var d in a.Dampers) { <button class="opt" disabled="@(!d.Available)" title="@d.Tooltip" @onclick="() => Damper(d)">@d.Label</button> }</div>
                }
                @if (cr.Active.Count == 0) { <div class="muted">No crisis is active.</div> }
                @if (cr.Causable.Count > 0) { <div class="muted small">Ripe to be lit: @string.Join(", ", cr.Causable)</div> }
            </section>
        }
    </div>

    <div class="col">
        <section class="panel">
            <h3>Holdings <span class="muted">@m.Holdings.Count</span></h3>
            @if (m.Holdings.Count == 0) { <div class="muted">Your house holds no land. A fief is won, granted, or married into.</div> }
            @foreach (var h in m.Holdings)
            {
                var planet = w.Holding(h.Id)!; var sys = w.Galaxy?.System(planet.SystemId); var (pf, pg) = Svg.Planet(sys?.PlanetClass ?? "terran");
                <details class="holding @(h.Besieged ? "besieged" : "")" open="@(m.Holdings.Count <= 2)">
                    <summary><i class="pdot" style="background:radial-gradient(circle at 35% 35%, @pg, @pf)"></i> <b>@h.Name</b> <span class="muted">@h.SpecName@(h.Kind == "station" ? " (station)" : "")@(h.SystemName != null ? $" · {h.SystemName}" : "")</span>
                        @if (h.MaxPopulation > 0) { <span class="pill">pop @h.Population/@h.MaxPopulation</span> }
                        <span class="pill @(h.Unrest >= 50 ? "warn" : "")">loyalty @(100 - h.Unrest)</span>
                        @if (h.Besieged) { <span class="pill warn">besieged</span> }
                    </summary>
                    <div class="kv"><span>Governor</span><b>@(h.GovernorName ?? "—")</b></div>
                    <div class="kv"><span>Culture</span><b>@h.Culture</b></div>
                    <div class="kv"><span>Built</span><b>@(h.Buildings.Count == 0 ? "nothing yet" : string.Join(", ", h.Buildings)) (@h.SlotsUsed/@h.Slots)</b></div>
                    <details><summary>Build</summary>@foreach (var b in h.Builds) { <button class="opt" disabled="@(!b.Available)" title="@b.Tooltip" @onclick="() => G.Execute(new BuildCommand(pid, h.Id, b.BuildingId, c.Holdings, c.Titles))">@b.Label</button> }</details>
                    @if (h.Ships.Count > 0) { <details><summary>Shipyard</summary>@foreach (var sh in h.Ships) { <button class="opt" disabled="@(sh.Refusal != null)" title="@sh.Refusal" @onclick="() => G.Execute(new RaiseFleetCommand(pid, h.Id, c.Fleets, c.ShipClasses, sh.ClassId, c.Titles))">@sh.Label</button> }</details> }
                    @if (h.GovernorOptions is { Count: > 0 }) { <details><summary>Governor's chair</summary>@foreach (var o in h.GovernorOptions) { <button class="opt" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(new AppointGovernorCommand(pid, h.Id, o.Id))">@o.Label</button> }</details> }
                </details>
            }
        </section>
        <section class="panel">
            <h3>Household</h3>
            @foreach (var h in m.Household)
            {
                <div class="person">
                    <Portrait Id="@h.Id" Name="@h.Name" Sex="@h.Sex" Age="@h.Age" Accent="@m.HouseAccent" Size="28" />
                    <span><b>@h.Name</b> <span class="muted">@h.Age@(h.Sex.Length > 0 ? $" · {h.Sex}" : "")@(h.Married ? " · wed" : "")@(h.Hidden ? " · fostered away" : "")</span></span>
                    @foreach (var o in h.Actions)
                    {
                        @if (o.Id == "defiant") { <span class="pill warn">defiant</span> }
                        else { <button class="opt inline" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(Household(o.Id, h.Id))">@o.Label</button> }
                    }
                </div>
            }
            @if (m.Household.Count == 0) { <div class="muted">You are the last of your name.</div> }
        </section>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    private ICommand Household(string optionId, string childId) => optionId == "recall" ? new RecallCommand(G.World!.ProtagonistId, childId) : new FosterCommand(G.World!.ProtagonistId, childId);
    private ICommand PathCommand(string id) { var pid = G.World!.ProtagonistId; var prog = G.Turn!.Progression!; return id switch { "seize" => new SeizeTitleCommand(pid, prog), "petition" => new PetitionTitleCommand(pid, prog), _ => new ClaimTitleCommand(pid, prog) }; }
    private void Damper(DamperOption d) { var crises = G.Turn!.Crises!; var def = crises.Def(d.CrisisId)!; G.Execute(new ApplyDamperCommand(G.World!.ProtagonistId, crises, def, def.Dampers.First(x => x.Id == d.DamperId))); }
}
