@using Praetoria.Core.Systems
@inject GameClient G
@* The House window (docs/VISUAL_SYSTEM.md 5.1; the mockup docs/ui/house.jpg). The world painting with the house's wax seal, "Your
   house" over its name, its facts, and five figures on the plinth: the treasury and its yearly take, the house's wealth, its worlds,
   its legitimacy and where it stands among the richest. Six tabs: Estate (the lede; each world as one composed entry, a lit globe,
   three meters and the building slots, a warn strip when the chair is empty; provinces held under other houses as rows with their
   yields and the dues as a loss; what the land yields as the signed ledger), Ledger (where the coin comes from and goes, this year's
   and last year's accounts, debt and the lenders, the stores, the wealth of the houses), Household, Council, Court, and Purse (the
   purses, heirlooms and the will, with the seat and estates). Ventures moved to the Exchange. Sections and rows, never cards. *@
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var house = w.House(w.Protagonist!.HouseId)!;
    var fc = G.Turn!.Economy?.Forecast(w, house.Id, G.Turn.Fleets);
    int planets = m.Holdings.Count(h => h.Kind == "planet"), stations = m.Holdings.Count(h => h.Kind == "station"), claims = m.Holdings.Count(h => h.Kind == "claim"), pop = m.Holdings.Sum(h => h.Population); long citizens = Census.CitizensOf(G.World!, G.World!.Protagonist!.HouseId);
    var lg = m.Ledger; int maxAbs = lg == null ? 1 : Math.Max(1, lg.Lines.Select(l => Math.Abs(l.Delta.Credits)).DefaultIfEmpty(1).Max());

    // The picture (docs/DASHBOARDS.md): what the house takes in and spends, where it stands among the others, and what is wrong.
    int credits = m.Treasury.Credits, net = lg?.Net.Credits ?? fc?.Credits ?? 0;
    int gross = lg == null ? Math.Max(0, net) : lg.Lines.Where(l => l.Delta.Credits > 0).Sum(l => l.Delta.Credits);
    int spend = lg == null ? Math.Max(0, -net) : -lg.Lines.Where(l => l.Delta.Credits < 0).Sum(l => l.Delta.Credits);
    var top = lg?.Lines.Where(l => l.Delta.Credits > 0).OrderByDescending(l => l.Delta.Credits).FirstOrDefault();
    var drain = lg?.Lines.Where(l => l.Delta.Credits < 0).OrderBy(l => l.Delta.Credits).FirstOrDefault();
    int lasts = net < 0 ? credits / -net : -1;
    var lands = m.Holdings.Where(h => h.Kind != "claim").ToList();
    var weakest = lands.OrderByDescending(h => h.Unrest).FirstOrDefault(); var besieged = m.Holdings.FirstOrDefault(h => h.Besieged);
    int loyal = weakest == null ? 0 : 100 - weakest.Unrest, thriving = lands.Count == 0 ? 0 : (int)lands.Average(h => h.Prosperity);
    var above = lg == null || lg.Rank <= 1 ? null : lg.Table.ElementAtOrDefault(lg.Rank - 2);
    var below = lg == null ? null : lg.Table.ElementAtOrDefault(lg.Rank);
    int richest = lg == null || lg.Table.Count == 0 ? 1 : Math.Max(1, lg.Table[0].Wealth);
    int legitRank = 1 + w.Houses.Values.Count(h => h.Id != house.Id && h.Id != PirateSystem.HouseId && h.Legitimacy > house.Legitimacy);
    int legitOf = w.Houses.Values.Count(h => h.Id != PirateSystem.HouseId);
    string titleName = c.Titles.NameOf(house.Title, w.Era);
    string story, storyTone;
    if (m.Treasury.Insolvent) { story = "The house cannot pay its way. Unrest climbs on every populated world and unpaid crews will desert until the treasury is above nought."; storyTone = "bad"; }
    else if (besieged != null) { story = $"{besieged.Name} is under siege. Nothing it yields reaches the house until the siege is lifted."; storyTone = "bad"; }
    else if (net < 0 && lasts >= 10) { story = $"The house does not quite pay its way: {Money.Show(-net)} more goes out each year than comes in{(drain != null ? $", the most of it on {drain.Source}" : "")}. The treasury would bear that for {lasts} years."; storyTone = "warn"; }
    else if (net < 0) { story = $"The house spends {Money.Show(-net)} more than it takes in each year{(drain != null ? $", the most of it on {drain.Source}" : "")}. The treasury lasts {(lasts == 0 ? "less than a year" : lasts == 1 ? "one more year" : lasts + " years")} at this rate."; storyTone = "warn"; }
    else if (weakest is { Unrest: >= 50 }) { story = $"{weakest.Name} is restless, at loyalty {100 - weakest.Unrest}. A restless world yields less and may rise; the house otherwise clears {Money.Show(net)} a year."; storyTone = "warn"; }
    else if (lg is { Debt: > 0 }) { story = $"The house owes {Money.Show(lg.Debt)}{(lg.LenderName != null ? $" to the bank of {lg.LenderName}" : " to the counting-houses")}, and pays {Money.Show(lg.LoanInstalment)} of it a year. After that it clears {Money.Show(net)} a year."; storyTone = "warn"; }
    else if (lands.Count == 0) { story = "The house holds no land. What it has is its purse, its ventures and its name; a fief is won, granted, or married into."; storyTone = ""; }
    else if (lg != null) { story = $"The house clears {Money.Show(net)} a year{(top != null ? $", the most of it from {top.Source}" : "")}, and is the {Ordinal(lg.Rank)} richest of {lg.Houses} houses{(above != null ? $", {Money.Show(above.Wealth - lg.Wealth)} behind {above.Name}" : below != null ? $", {Money.Show(lg.Wealth - below.Wealth)} ahead of {below.Name}" : "")}."; storyTone = net > 0 ? "good" : ""; }
    else { story = $"The house clears {Money.Show(net)} a year."; storyTone = net > 0 ? "good" : ""; }

    int yearNet = YearNet(G, w, house);
    // the plinth: five numbers; the old tiles' notes are their tooltips
    var figures = new List<WindowHeader.Figure>
    {
        new("credits", Money.Held(house.Treasury), "Treasury, a year", m.Treasury.Insolvent ? "ember" : "brass", Delta: yearNet == 0 ? "" : Sg(yearNet),
            Tip: $"[credits] In the treasury\nWhat the house has in hand, and what a year adds to it or takes from it.\nIn hand: {Money.Held(house.Treasury)}\nA year, as the top bar has it: {(yearNet > 0 ? $"+{Money.Show(yearNet)}" : yearNet < 0 ? $"−{Money.Show(-yearNet)}, {(lasts <= 0 ? "gone within the year" : Counted.Years(lasts) + " left")}" : "neither growing nor shrinking")}\nTakes in: +{Money.Show(gross)}\nSpends: {(gross == 0 ? Money.Show(spend) : spend > gross ? $"{Money.Show(spend)}, {Money.Show(spend - gross)} more than it takes in" : $"{Money.Show(spend)}, {100 * spend / gross}% of it")}{(drain != null ? $"\nMost on: {drain.Source}" : "")}\nkey: The Ledger tab has every line"),
    };
    if (lg != null)
        figures.Add(new("money-stack", Money.Show(lg.Wealth), lg.Debt > 0 ? "Wealth, in debt" : "Wealth, no debt", "brass",
            Tip: $"[money-stack] Wealth\n{(above != null ? $"{above.Name} is next above, at {Money.Show(above.Wealth)}." : "The richest house of the Reach.")}\nRank: {Ordinal(lg.Rank)} of {lg.Houses} houses, {lg.Tier}\nDebt: {(lg.Debt > 0 ? $"{Money.Show(lg.Debt)}, {Money.Show(lg.LoanInstalment)} a year to {(lg.LenderName != null ? "the bank of " + lg.LenderName : "the counting-houses")}" : lg.Loan.Refusal == null ? "nothing owed; the counting-houses would lend" : "nothing owed")}"));
    figures.Add(new("ringed-planet", lands.Count.ToString(), lands.Count == 0 ? "Worlds" : $"Worlds, {Census.Short(citizens)}", "ivory",
        Tip: lands.Count == 0 ? "[ringed-planet] The worlds\nThe house holds none: a fief is won, granted, or married into." :
            $"[ringed-planet] The worlds\n{Counted.Worlds(planets)}{(stations > 0 ? $", {Counted.Stations(stations)}" : "")}{(claims > 0 ? $", {Counted.Claims(claims)}" : "")}, {Census.Say(citizens)} citizens.\nLoyalty: {loyal}{(lands.Count > 1 ? $", the least loyal, {weakest!.Name}" : "")}\nThriving: {thriving}, the average prosperity\n{(besieged != null ? $"{besieged.Name} is besieged." : "Loyalty is that of the least loyal world; thriving is the average prosperity of them all.")}"));
    figures.Add(new("legitimacy", house.Legitimacy.ToString(), "Legitimacy", m.Standing is { Instability: > 0 } ? "ember" : "ivory",
        Of: m.Standing is { NextTitle: not null, NextRequirement: > 0 } nr ? nr.NextRequirement.ToString() : "",
        Tip: $"[legitimacy] Legitimacy\nHow rightful the house is held to be. It is what a petition for a higher title is judged on.\n{(m.Standing is { Instability: > 0 } si ? $"The rank of {titleName} outstrips it by {si.Instability}." : m.Standing is { NextTitle: not null, NextRequirement: > 0 } sn ? $"{sn.NextRequirement} is wanted for {sn.NextTitle}." : "")}\nAmong the houses: {Ordinal(legitRank)} of {legitOf}{(m.Standing?.Made is { } md ? $"\nBegan at: {md.Began}" : "")}\nkey: Click for what it is made of, on the Household tab under Standing",
        OnClick: m.Standing?.Made != null ? EventCallback.Factory.Create(this, () => { _view = "household"; _made = true; }) : default,
        Attrs: new Dictionary<string, object> { ["data-legitimacy-tile"] = house.Legitimacy }));
    if (lg != null)
        figures.Add(new("trophy", Ordinal(lg.Rank), $"Richest of {lg.Houses}", lg.Rank * 3 <= lg.Houses ? "brass" : "ivory",
            Tip: $"[trophy] Among the richest\nThe {Ordinal(lg.Rank)} richest of {lg.Houses} houses, {lg.Tier}.{(above != null ? $" {Money.Show(above.Wealth - lg.Wealth)} behind {above.Name}." : below != null ? $" {Money.Show(lg.Wealth - below.Wealth)} ahead of {below.Name}." : "")}\nkey: The Ledger tab has the wealth of the houses"));

    int councilFilled = house.Duties.Count, courtFilled = house.Court.Count;
    var tabs = new List<Tabs.Tab>
    {
        new("estate", "Estate", "castle", Tip: "The house's worlds, the provinces it holds under other houses, and what the land yields"),
        new("ledger", "Ledger", "abacus", Tip: "Where the coin comes from and goes, the accounts, debt and the lenders, the stores, and the wealth of the houses"),
        new("household", "Household", "three-friends", m.Household.Count.ToString(), house.Petitions.Count > 0 || m.Household.Any(h => h.Actions.Any(a => a.Id == "defiant")), Tip: "The house's people, those taken in, a mentor, and the house's standing"),
        new("council", "Council", "round-table", $"{councilFilled}/{HouseholdSystem.Roles.Length}", councilFilled == 0, Tip: "The council: six posts you can give away, and what each holder sees", Attrs: Hook("data-tab-council")),
        new("court", "Court", "throne-king", $"{courtFilled}/{CourtSystem.Positions.Length}", Tip: "The house's own court: tutor, wet nurse, physician, guard, duel master, shipwright, master of ceremonies. It goes with the house whatever rank or office it holds.", Attrs: Hook("data-tab-court")),
        new("purse", "Purse", "swap-bag", Tip: "Purses, heirlooms and the will, and what the treasury can do for the house's people and its name: a seat, land for a relative, a town house, a campaign", Attrs: Hook("data-tab-riches"))
    };
}
<div class="hs-win" data-house="@_view" style="--accent:@m.HouseAccent">
    <WindowHeader Scene="world" Kicker="House · your house" Title="@house.Name" HouseId="@house.Id" Accent="@house.AccentColor" Figures="figures" Class="hs-head">
        <Facts>
            <span title="@($"[legitimacy] {titleName}\nThe house's rank. A higher one is petitioned for in the Senate.")"><Icon Name="legitimacy" Tone="ivory" Size="16" /><b>@titleName</b></span>
            <span class="hs-culture"><Icon Name="rolled-cloth" Tone="ivory" Size="16" />@Cap(house.Culture) culture</span>
            <span data-house-citizens="@citizens" title="@($"The citizens of every world and station of the house. On the scale the rules reckon by, they come to {pop}.")"><Icon Name="population" Tone="ivory" Size="16" /><b>@Census.Say(citizens)</b> citizens</span>
            <span title="The house's tithe, set in the Chancery (Laws) with the rest of the house's law"><Icon Name="scales" Tone="ivory" Size="16" />Tithe <b>@(m.Standing?.TaxPolicy ?? "customary")</b></span>
        </Facts>
    </WindowHeader>
    <Tabs Items="tabs" Active="@_view" OnPick="Pick" />
    <div class="ui-wbody fades hs-body" @key="_view">
    @if (_view == "household")
    {
        var found = HouseholdSystem.Found(w, house.Id); int room = HouseholdSystem.Room(house);
        <p class="ui-lede hs-lede">@Bold($"{(m.Household.Count == 1 ? "One person" : m.Household.Count + " people")} of the house{(found.Count > 0 ? $", {found.Count} of them taken in of the {room} places" : $", and {room} places for those you take in")}. {(house.Duties.Count == 0 ? "No post of the council is given away" : $"{house.Duties.Count} of the {HouseholdSystem.Roles.Length} posts of the council are given away")}.")</p>
        <Section Title="The household" Count="@m.Household.Count.ToString()" Info="Everyone of the house: the blood, those married in, and those taken in. Click a row for what they want and what they are like; click a face for their profile."
                 IsEmpty="@(m.Household.Count == 0)" EmptyLine="You are the last of your name." EmptyIcon="three-friends">
            @foreach (var h in m.Household)
            {
                var pc = w.Char(h.Id); int pd = w.GetRelationship(h.Id, pid)?.Disposition ?? 0; string hid = h.Id; bool on = _focus == h.Id;
                string what = pc == null ? "" : string.Join(" · ", new[] { c.Careers.RankName(pc.CareerTrack, pc.CareerRank, w.Era), pc.Ambition.Length > 0 && pc.Age >= 16 ? "wants " + AmbitionSystem.Wants(pc.Ambition) : null }.Where(x => !string.IsNullOrEmpty(x)));
                <Row Class="hs-person" Name="@h.Name" On="on" OnClick="() => _focus = on ? null : hid" Tip="@(on ? "Click to close" : "Click for what they want and what they are like")" data-household-person="@h.Id">
                    <Picture><Portrait Id="@h.Id" Name="@h.Name" Sex="@h.Sex" Age="@h.Age" Accent="@m.HouseAccent" Size="46" Height="56" /></Picture>
                    <Sub>@h.Age@(h.Sex.Length > 0 ? $" · {h.Sex}" : "")@(h.Married ? " · wed" : "")@(h.Hidden ? " · fostered away" : "")@(what.Length > 0 ? " · " + what : "")</Sub>
                    <NameExtra>@if (h.Id == pid) { <span class="hs-tag">you</span> }</NameExtra>
                    <Cells>@if (h.Id != pid) { <span class="ui-cell @(pd < -20 ? "ui-down" : pd > 20 ? "ui-up" : "")" title="What they think of you">@Fig(pd)<small>&nbsp;to you</small></span> }</Cells>
                    <Action>
                        <span class="hs-acts" @onclick:stopPropagation="true">
                        @foreach (var o in h.Actions)
                        {
                            var oo = o;
                            if (o.Id == "defiant") { <span class="hs-tag bad" title="They will not do as the head says">defiant</span> }
                            else { <Plate Label="@(o.Id == "foster" ? "Foster away" : o.Id == "recall" ? "Recall" : Cap(o.Label))" Small="true" CostIcon="@(o.Id == "foster" ? "agents_pool" : "")" CostText="@(o.Id == "foster" ? "1" : "")" Locked="@(o.Refusal != null)" Disabled="@(o.Refusal != null)" ShowNeed="false" Need="@(o.Refusal ?? "")" Tip="@($"{Cap(o.Label)}\n{HouseholdWords.Tip(o.Id)}")" OnClick="() => G.Execute(Household(oo.Id, hid))" /> }
                        }
                        </span>
                    </Action>
                </Row>
                @if (on && pc != null)
                {
                    var rel = w.GetRelationship(pc.Id, pid);
                    <div class="hs-detail" data-household-focus="@pc.Id">
                        <span>@(pc.NatureTraits.Count + pc.AptitudeTraits.Count > 0 ? string.Join(", ", pc.NatureTraits.Concat(pc.AptitudeTraits)) : "No traits of note")</span>
                        @if (pc.Ambition.Length > 0) { <span>Wants: <b>@pc.Ambition.Replace('_', ' ')</b></span> }
                        @if (pc.Id != pid) { <span class="@((rel?.Disposition ?? 0) < -20 ? "ui-down" : (rel?.Disposition ?? 0) > 20 ? "ui-up" : "")">@Fig(rel?.Disposition ?? 0) toward you</span> }
                        @if (c.Careers.RankName(pc.CareerTrack, pc.CareerRank, w.Era) is { } rn) { <span>@rn</span> }
                    </div>
                }
            }
        </Section>
        <HouseholdPanel />
        @if (m.Standing is { } s)
        {
            <Section Title="Standing" Info="The house's standing: its law of succession, how dangerous the other houses take it to be, the honours and claims it holds, and what its legitimacy is made of. The tithe is set in the Chancery (Laws), with the rest of the house's law. Titles, the throne and the spheres are pursued in the Senate.">
                <Right><span title="Set in the Chancery (Laws), with the rest of the house's law">Tithe <b>@s.TaxPolicy</b></span></Right>
                <ChildContent>
                <div class="hs-kv hs-succ" data-succession="@s.SuccessionLaw">
                    <span class="hs-k"><Icon Name="family-tree" Tone="ivory" Size="16" />Succession</span>
                    <span class="hs-v">
                        <span class="ui-seg hs-seg" role="radiogroup">
                        @foreach (var o in s.LawOptions)
                        {
                            var wouldBe = DynastySystem.Line(G.World!, G.World!.Protagonist!, o.Id).FirstOrDefault(); var nowHeir = DynastySystem.FindHeir(G.World!, G.World!.Protagonist!); string oid = o.Id; string olabel = o.Label;
                            bool cur = o.Id == s.SuccessionLaw;
                            string tip = o.Refusal ?? $"{char.ToUpperInvariant(o.Label[0])}{o.Label[1..]}: {DynastySystem.LawSays(o.Id)}. Your heir would be {wouldBe?.Name ?? "nobody"}{(wouldBe?.Id == nowHeir?.Id ? ", as now" : nowHeir != null ? $", not {nowHeir.Name}" : "")}{(G.World!.House(G.World.Protagonist!.HouseId)?.NamedHeirId.Length > 0 ? " (the heir you named comes first under any law)" : "")}. Costs 2 influence this year.";
                            <button class="@(cur ? "on" : "")" role="radio" aria-checked="@(cur ? "true" : "false")" disabled="@(o.Refusal != null)" title="@tip"
                                    @onclick='() => G.AskDo("Change the law of succession to " + olabel + "?", "The law decides who of the blood comes first when you die: it changes who your heir is from today, and those passed over will know it. The Dynasty window shows the line as it stands; look there after.", "Change the law", new SetSuccessionLawCommand(pid, oid))'>@Cap(o.Label.Replace('_', ' '))</button>
                        }
                        </span>
                    </span>
                </div>
                <div class="hs-kv" title="How dangerous the other houses take yours to be. It rises with your share of the spheres (the Navy, the Senate, the courts, the counting-houses) above an even share, by 5 for every holding past the first, with every rank seized by force, and with holding the capital. The higher it stands, the readier the others are to band against you.">
                    <span class="hs-k"><Icon Name="threat" Tone="@(s.Threat >= 60 ? "ember" : "ivory")" Size="16" />How dangerous others think us</span><b class="hs-v @(s.Threat >= 60 ? "ui-warn-t" : "")">@s.Threat</b>
                </div>
                @if (s.Instability > 0) { <div class="hs-kv"><span class="hs-k"><Icon Name="alert" Tone="ember" Size="16" />Title instability</span><b class="hs-v ui-down">@s.Instability</b></div> }
                @if (s.Honors.Count > 0) { <div class="hs-kv"><span class="hs-k"><Icon Name="medal" Tone="brass" Size="16" />Honors</span><span class="hs-v">@string.Join(", ", s.Honors)</span></div> }
                @if (s.Claims.Count > 0) { <div class="hs-kv"><span class="hs-k"><Icon Name="claim" Tone="ivory" Size="16" />Claims</span><span class="hs-v">@string.Join(", ", s.Claims.Select(tid => c.Titles.NameOf(tid, G.World!.Era)))</span></div> }
                <div class="hs-kv">
                    <span class="hs-k"><Icon Name="legitimacy" Tone="ivory" Size="16" />Legitimacy</span>
                    <span class="hs-v"><b>@house.Legitimacy</b> <small class="ui-mute">@(m.Standing is { Instability: > 0 } si2 ? $"the rank of {titleName} outstrips it by {si2.Instability}" : m.Standing is { NextTitle: not null, NextRequirement: > 0 } sn2 ? $"{sn2.NextRequirement} is wanted for {sn2.NextTitle} · {Ordinal(legitRank)} of {legitOf}" : $"{Ordinal(legitRank)} of {legitOf} houses")</small>
                        @if (m.Standing?.Made != null) { <Link Tip="How rightful the house is held to be. It is what a petition for a higher title is judged on. Click to see what it is made of." OnClick="() => _made = !_made" Label='@(_made ? "Close" : "What it is made of")' /> }
                    </span>
                </div>
                @if (_made && m.Standing?.Made is { } made)
                {
                    <div class="hs-made" data-legitimacy-panel>
                        <LegitimacyMade Card="made" />
                        @if (m.Standing.NextTitle != null) { <p class="hs-note">@m.Standing.Earned The ladder is in the Senate window. <Link data-legitimacy-close="1" OnClick="() => _made = false" Label="Close" /></p> }
                        else { <p class="hs-note"><Link data-legitimacy-close="1" OnClick="() => _made = false" Label="Close" /></p> }
                    </div>
                }
                </ChildContent>
            </Section>
        }
    }
    else if (_view == "council") { <CouncilPanel /> }
    else if (_view == "court") { <CourtPanel /> }
    else if (_view == "purse") { <WealthPanel /> }
    else if (_view == "ledger")
    {
        <p class="ui-lede hs-lede @storyTone">@Bold(gross == 0 ? (spend > 0 ? $"The house takes in nothing, and spends {Money.Show(spend)} a year." : "The house takes in nothing and spends nothing.") : $"The house takes in {Money.Show(gross)} a year and spends {Money.Show(spend)}{(spend > gross ? $", {Money.Show(spend - gross)} more than it takes in" : $", {100 * spend / gross}% of it")}{(drain != null ? $", the most on {drain.Source}" : "")}.")</p>
        @if (lg != null)
        {
            <Section Title="Coin in and out" Count="@lg.Lines.Count(l => l.Delta.Credits != 0).ToString()" Info="Credits a year, largest first: what each world, venture, fleet, loan and office of the house brings in (gold, to the right of the line) or costs (red, to the left). Hover a line for everything in it.">
                <Right><span>The house clears <b class="@(net > 0 ? "ui-up" : net < 0 ? "ui-down" : "")">@Sg(net)</b></span></Right>
                <ChildContent>
                <div class="hs-led">
                    @foreach (var l in lg.Lines.OrderByDescending(x => x.Delta.Credits))
                    {
                        int v = l.Delta.Credits;
                        <span class="hs-led-src" title="@($"{Cap(l.Source)}: {Delta(l.Delta)}")"><Icon Name="@LineIcon(l.Kind)" Tone="ivory" Size="15" /><span class="hs-led-t">@LedLabel(l.Source)</span></span>
                        <span class="hs-led-neg">@if (v < 0) { <i style="width:@Pc(100.0 * -v / maxAbs)"></i> }</span>
                        <span class="hs-led-pos">@if (v > 0) { <i style="width:@Pc(100.0 * v / maxAbs)"></i> }</span>
                        <span class="hs-led-amt @(v > 0 ? "ui-up" : v < 0 ? "ui-down" : "ui-mute")">@Sg(v)</span>
                    }
                    <span class="hs-led-src net">What is left</span>
                    <span class="hs-led-neg">@if (net < 0) { <i style="width:@Pc(Math.Min(100.0, 100.0 * -net / maxAbs))"></i> }</span>
                    <span class="hs-led-pos">@if (net > 0) { <i style="width:@Pc(Math.Min(100.0, 100.0 * net / maxAbs))"></i> }</span>
                    <span class="hs-led-amt net @(net > 0 ? "ui-up" : net < 0 ? "ui-down" : "ui-mute")">@Sg(net)</span>
                </div>
                @if (Goods(lg.Net) is { Length: > 0 } goods) { <p class="hs-note">And in goods, each year: @goods</p> }
                </ChildContent>
            </Section>

            var outs = HouseAccounts.Outgoings(w, c.Holdings, house, G.Turn!.Economy); var outTotal = HouseAccounts.Total(outs); int yearEnd = house.Treasury.Credits + lg.Net.Credits - outTotal.Credits;
            var lastRulings = w.Judgments.Where(j => j.Turn == w.Turn - 1).ToList(); var suits = LadderSystem.SuitsNaming(w, house.Id).ToList();
            <Section Title="This year" Info="What the treasury will hold at the year's end if nothing else is done: what it holds now, the year's net, and what else is going out this year that is not a standing cost (it ends when the work does). Suits in the courts that name the house are heard at the year's end.">
                <Right><span>Year's end <b class="@(yearEnd < 0 ? "ui-down" : "")">@Money.Show(yearEnd)</b></span></Right>
                <ChildContent>
                @if (outs.Count > 0)
                {
                    <div class="hs-outs" data-outgoings="@outTotal.Credits">
                        @foreach (var o in outs) { <div class="hs-kv"><span class="hs-k">@Cap(o.what)</span><b class="hs-v ui-down">−@CourtProjection.Bundle(o.cost)</b></div> }
                    </div>
                }
                <div class="hs-kv hs-total @(yearEnd < 0 ? "bad" : "")" data-yearend="@yearEnd">
                    <span class="hs-k">The treasury at the year's end, if nothing else is done</span>
                    <span class="hs-v"><b class="@(yearEnd < 0 ? "ui-down" : "")">@Money.Show(yearEnd) credits</b> <small class="ui-mute">it holds @Money.Held(house.Treasury) now@(w.Protagonist!.Purse > 0 ? ", and your own purse " + Money.Show(w.Protagonist.Purse) : "")</small></span>
                </div>
                @foreach (var su in suits)
                {
                    bool forUs = su.RightId == house.Id;
                    <div class="hs-kv" data-atrisk="@su.Id" title="@($"{w.House(LadderSystem.OtherIn(su, house.Id))?.Name}'s suit over {LadderSystem.MatterOf(su)}, heard at the year's end: Senate, Ladder and courts")">
                        <span class="hs-k"><Icon Name="scales" Tone="@(forUs ? "brass" : "ember")" Size="16" />@(forUs ? "May come in from the courts" : "At risk in the courts")</span>
                        <span class="hs-v"><b class="@(forUs ? "ui-up" : "ui-down")">@Money.Show(LadderSystem.StakeOf(su)) credits</b> <small class="ui-mute">@(w.House(LadderSystem.OtherIn(su, house.Id))?.Name)'s suit over @LadderSystem.MatterOf(su)</small></span>
                    </div>
                }
                @foreach (var jr in lastRulings)
                {
                    bool won = jr.WinnerId == house.Id;
                    <div class="hs-kv"><span class="hs-k"><Icon Name="scales" Tone="ivory" Size="16" />Last year, by order of the court</span><span class="hs-v"><b class="@(won ? "ui-up" : "ui-down")">@(won ? "+" : "−")@Money.Show(jr.Sum) credits</b> <small class="ui-mute">@(won ? "from" : "to") @(w.House(won ? jr.LoserId : jr.WinnerId)?.Name)</small></span></div>
                }
                </ChildContent>
            </Section>

            @if (YearInBrief.Accounts(w, Resource.Credits) is { } acc)
            {
                <div data-last-year>
                <Section Title="Last year" Info="Last year's accounts: what the treasury opened the year at, the three things that moved it, and what it closed at. The lines add up to the change; hover each for what is in it.">
                    <Right><span>@Money.Show(acc.open) to <b>@Money.Show(acc.close)</b> <b class="@(acc.close - acc.open >= 0 ? "ui-up" : "ui-down")">(@(acc.close - acc.open >= 0 ? "+" : "−")@Money.Show(Math.Abs(acc.close - acc.open)))</b></span></Right>
                    <ChildContent>
                    <div class="hs-kv"><span class="hs-k">Opened the year at</span><b class="hs-v">@Money.Show(acc.open)</b></div>
                    @foreach (var a in acc.lines) { <div class="hs-kv" title="@a.Says"><span class="hs-k">@a.What</span><b class="hs-v @(a.By > 0 ? "ui-up" : a.By < 0 ? "ui-down" : "")">@(a.By > 0 ? "+" : a.By < 0 ? "−" : "")@Money.Show(Math.Abs(a.By))</b></div> }
                    <div class="hs-kv hs-total"><span class="hs-k">Closed the year at</span><b class="hs-v">@Money.Show(acc.close)</b></div>
                    <p class="hs-note">The same for the goods: @string.Join("; ", new[] { Resource.Materials, Resource.Manpower, Resource.Helium3 }.Select(r => YearInBrief.Accounts(w, r) is { } g ? $"{Resource.Label(r).ToLowerInvariant()} {g.open} to {g.close}" : "").Where(x => x.Length > 0)).</p>
                    </ChildContent>
                </Section>
                </div>
            }

            var fin = c.Businesses.Finance; int instal = Lending.InstalmentOf(w, house, fin); var lenders = Lending.Lenders(w, house.Id, c.Businesses); string? stayed = EdictSystem.Stay(w) is { } stay ? $"nothing falls due while {EdictSystem.Lower(stay.Name)} stands, until year {stay.Until}" : null;
            <Section Title="Debt and lenders" Count="@(lg.Debt > 0 ? "1" : "")" Info="One lender at a time. What is owed is the sum and its interest together, paid off by the year; a year the treasury cannot find the instalment it goes below nought, and a house two years below nought is sold up for its creditors. Paying sooner saves no interest: it shortens the years and ends the instalments.">
                <Right>@if (lg.Debt > 0) { <span>Owes <b class="ui-down">@Money.Show(lg.Debt)</b></span> } else { <span>Nothing owed</span> }</Right>
                <ChildContent>
                @if (lg.Debt > 0)
                {
                    int left = Lending.Years(lg.Debt, instal);
                    <Row Class="hs-debt" Name="@($"{Money.Show(lg.Debt)} credits to {Lending.LenderName(w, house.LenderId)}")" SubText="@(stayed ?? $"{Money.Show(instal)} a year, and {(left == 1 ? "this year clears it" : left + " years clear it")}")" data-debt="@lg.Debt">
                        <Picture><span class="ui-medal hs-medal"><Icon Name="treasury_pool" Tone="ember" Size="22" /></span></Picture>
                        <Action><Plate Label="Repay all" Icon="credits" IconTone="brass" Small="true" Locked="@(lg.Repay.Refusal != null)" Disabled="@(lg.Repay.Refusal != null)" ShowNeed="false" Need="@(lg.Repay.Refusal ?? "")" Tip="@lg.Repay.Label" OnClick="() => G.Execute(new RepayLoanCommand(pid))" /></Action>
                    </Row>
                    <div class="hs-line" data-repay>
                        <span class="hs-lbl" title="What is owed is the whole of it, interest and all, from the day it is borrowed: paying sooner saves no interest. It shortens the years, ends the instalments, and a house that owes nothing is not sold up by its creditors.">Pay down</span>
                        @foreach (int part in new[] { 5, 10, 20, 50 }.Where(x => x < lg.Debt))
                        {
                            int pt = part; var payPart = new RepayLoanCommand(pid, pt); var partNo = payPart.Refusal(G.Ctx);
                            <Plate Label="@Money.Show(pt)" Small="true" Locked="@(partNo != null)" Disabled="@(partNo != null)" ShowNeed="false" Need="@(partNo ?? "")" data-repay-part="@pt"
                                   Tip="@(stayed != null ? $"{Money.Show(lg.Debt - pt)} would be owed, and {stayed}." : $"{Money.Show(lg.Debt - pt)} would be owed: {Counted.Years(Lending.Years(lg.Debt - pt, instal))} at {Money.Show(instal)} a year.")" OnClick="() => G.Execute(payPart)" />
                        }
                    </div>
                }
                <div data-borrow>
                @foreach (var lt in lenders)
                {
                    string lid = lt.LenderId; int room = Lending.Room(w, house, lt);
                    int amt = Math.Clamp(_borrow.GetValueOrDefault(lid, Math.Min(room, fin.LoanPrincipal)) / Lending.Step * Lending.Step, Math.Min(Lending.Step, room), Math.Max(Lending.Step, room));
                    var take = new TakeLoanCommand(pid, c.Businesses, lid, amt); var takeNo = take.Refusal(G.Ctx);
                    int owedNew = Lending.Owed(w, amt, lt.RatePct, lid, house.Id), owedAll = (house.LenderId == lid ? house.Debt : 0) + owedNew, instNew = Lending.Instalment(fin, owedAll);
                    bool can = lt.Refusal == null && room >= Lending.Step;
                    <div class="hs-lender @(lt.Refusal != null ? "off" : "")" data-lender="@(lid.Length == 0 ? "counting-houses" : lid)" title="@lt.Why">
                        <div class="hs-lender-hd">
                            <span class="hs-lender-nm"><Icon Name="treasury_pool" Tone="@(can ? "brass" : "ivory")" Size="18" /><b>@Cap(lt.Lender)</b></span>
                            <span class="hs-lender-sub">up to @Money.Show(lt.Limit) credits · @lt.RatePct in the hundred@(house.LenderId == lid && house.Debt > 0 ? $" · you owe it {Money.Show(house.Debt)}, so {Money.Show(room)} more" : "")</span>
                        </div>
                        @if (lt.Refusal != null) { <div class="hs-lender-no ui-warn-t">@Cap(lt.Refusal).</div> }
                        else if (room < Lending.Step) { <div class="hs-lender-no ui-warn-t">It will lend you no more until some of what is owed is paid.</div> }
                        else
                        {
                            <div class="hs-acts">
                                <Stepper Value="amt" Min="Lending.Step" Max="room" Step="Lending.Step" Format="v => Money.Show(v)" FewerLabel="Less" FewerTip="@($"−{Money.Show(Lending.Step)}")" MoreTip="@($"+{Money.Show(Lending.Step)}")" Class="hs-step" data-amount="@amt" OnChange="v => _borrow[lid] = v" />
                                <Plate Label="@($"All {Money.Show(room)}")" Small="true" Disabled="@(amt >= room)" Tip="As much as it will lend" OnClick="() => _borrow[lid] = room" />
                                <Plate Label="@($"Borrow {Money.Show(amt)}")" Icon="credits" IconTone="brass" Small="true" Locked="@(takeNo != null)" Disabled="@(takeNo != null)" ShowNeed="false" Need="@(takeNo ?? "")" Tip="@lt.Why" data-take-loan="1" OnClick="() => G.Execute(take)" />
                                <span class="hs-terms" data-loan-terms>owe @Money.Show(owedNew) for it@(owedAll != owedNew ? $" ({Money.Show(owedAll)} in all)" : ""): @Money.Show(instNew) a year for @Counted.Years(Lending.Years(owedAll, instNew))</span>
                            </div>
                        }
                    </div>
                }
                </div>
                </ChildContent>
            </Section>
        }

        <Section Title="In the stores" Count="8" Info="What the house holds of each good, and what a year adds to it or takes from it. Helium-3, rare earths and isotopes are the strategic goods: what the house needs and does not bring up, it buys.">
            <Right><Link Label="Buy and sell" Tip="Every good, bought and sold: the Exchange" OnClick='() => OnGo.InvokeAsync("exchange")' /></Right>
            <ChildContent>
            @if (w.HasFlag("fuel_short")) { <WarnStrip Icon="helium3" Lead="The tanks are dry." Bad="true">Readiness slides fifteen a year and no fleet of yours may sail until helium-3 is found: a skimmer, or the Exchange.</WarnStrip> }
            @if (m.Treasury.Insolvent) { <WarnStrip Icon="credits" Lead="Insolvent." Bad="true">Unrest climbs on every populated world and unpaid crews will desert.</WarnStrip> }
            <div class="ui-table-wrap hs-stores">
                <table class="ui-table">
                    <thead><tr><th>Good</th><th>Held</th><th>A year</th>@if (m.Procure is { Count: > 0 }) { <th class="hs-buycol" title="What can be bought on the market for the house now; a dash where nothing can">Buy</th> }</tr></thead>
                    <tbody>
                    @foreach (var (name, val, d) in new[] { ("credits", m.Treasury.Credits, fc?.Credits), ("materials", m.Treasury.Materials, fc?.Materials), ("manpower", m.Treasury.Manpower, fc?.Manpower), ("influence", m.Treasury.Influence, fc?.Influence), ("exotics", m.Treasury.Exotics, fc?.Exotics), ("helium3", m.Treasury.Helium3, fc?.Helium3), ("rare_earths", m.Treasury.RareEarths, fc?.RareEarths), ("isotopes", m.Treasury.Isotopes, fc?.Isotopes) })
                    {
                        <tr class="@(Resource.IsStrategic(name) ? "strat" : "")">
                            <td><span class="hs-good"><Icon Name="@name" Tone="@ResTone(name)" Size="17" />@Cap(Resource.Label(name))@if (Resource.IsStrategic(name)) { <small class="hs-strat">strategic</small> }</span></td>
                            <td>@(name == Resource.Credits ? Money.Held(house.Treasury) : Money.Of(name, val))</td>
                            <td class="@(d > 0 ? "ui-up" : d < 0 ? "ui-down" : "ui-mute")">@(d is { } dd && dd != 0 ? (dd > 0 ? Money.SignedOf(name, dd) : "−" + Money.Of(name, -dd)) : "0")</td>
                            @if (m.Procure is { Count: > 0 })
                            {
                                <td class="hs-buycol">@if (m.Procure.FirstOrDefault(o => o.Id == "procure_" + name) is { } po)
                                {
                                    var q = new BuyGoodCommand(pid, name, 3, c.Trade).Quote(w);
                                    <Plate Label="Buy 3" Icon="@name" IconTone="@ResTone(name)" CostIcon="credits" CostText="@(q.Credits > 0 ? Money.Show(q.Credits) : "")" Small="true" Locked="@(po.Refusal != null)" Disabled="@(po.Refusal != null)" ShowNeed="false" Need="@(po.Refusal ?? "")" Tip="@($"Buy 3 {Resource.Label(name)} on the market at once, for {(q.Credits > 0 ? Money.Show(q.Credits) : "nothing")} credits")" data-procure="@name" OnClick="() => G.Execute(new BuyGoodCommand(pid, name, 3, c.Trade))" />
                                }
                                else { <span class="ui-mute">·</span> }</td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="hs-note deposits">Deposits under your worlds and claims: @(m.Deposits is { Count: > 0 } ? string.Join(" · ", m.Deposits.Select(Resource.Label)) : "none; what you need, you buy")</p>
            </ChildContent>
        </Section>

        @if (lg != null)
        {
            <Section Title="The wealth of the houses" Count="@lg.Houses.ToString()" Info="The house's wealth is its treasury, its worlds, its ventures and its paper, less what it owes. The bar is each house's wealth against the richest.">
                <Right><span>The eight richest@(lg.Rank > 8 ? ", and you" : "")</span></Right>
                <ChildContent>
                <div class="hs-wealth">
                @{ int ri = 0; }
                @foreach (var wl in lg.Table.Take(8))
                {
                    ri++;
                    <div class="hs-wl @(wl.Mine ? "mine" : "")" title="@($"{wl.Name}: {Money.Show(wl.Wealth)}, {wl.Tier}")">
                        <span class="hs-wl-n">@ri</span><Sigil HouseId="@wl.HouseId" Accent="@wl.Accent" Size="18" /><span class="hs-wl-nm">@wl.Name</span>
                        <span class="ui-trk"><i class="ui-fill" style="width:@Pc(Math.Max(2, 100.0 * Math.Max(0, wl.Wealth) / Math.Max(1, lg.Table[0].Wealth)));--mc:@(wl.Mine ? "#e9b949" : Tone(wl.Accent))"></i></span>
                        <b class="hs-wl-v">@Money.Show(wl.Wealth)</b>
                    </div>
                }
                @if (lg.Rank > 8 && lg.Table.FirstOrDefault(x => x.Mine) is { } mine)
                {
                    <div class="hs-wl mine"><span class="hs-wl-n">@lg.Rank</span><Sigil HouseId="@mine.HouseId" Accent="@mine.Accent" Size="18" /><span class="hs-wl-nm">@mine.Name</span>
                        <span class="ui-trk"><i class="ui-fill" style="width:@Pc(Math.Max(2, 100.0 * Math.Max(0, mine.Wealth) / richest));--mc:#e9b949"></i></span><b class="hs-wl-v">@Money.Show(mine.Wealth)</b></div>
                }
                </div>
                </ChildContent>
            </Section>
        }
    }
    else
    {
        <p class="ui-lede hs-lede @storyTone">@Bold(story)</p>
        @if (w.Boosts.Count > 0 || w.MoneyEase != MoneySettings.Standard)
        {
            <p class="hs-note hs-money" data-money-settings title="Chosen when this game was begun. They cannot be changed in a game.">@(w.MoneyEase != MoneySettings.Standard ? "Making money: " + MoneySettings.Name(w.MoneyEase) + ". " : "")@MoneySettings.Says(w)</p>
        }
        @if (m.Petition != null && !m.Holdings.Any(h => h.Kind == "planet"))
        {
            /* whom to ask for a world, and how far each is from saying yes (docs/PLAYTHROUGH.md, Medium, P80, P23) */
            var grantors = PetitionFiefCommand.Grantors(w, house.Id); var named = PetitionFiefCommand.Grantor(w, house.Id);
            <div data-petition>
            <Section Title="Ask for a world" Count="@grantors.Count.ToString()" Info="@($"A house with a world to spare may entrust its least peopled one to you. It costs {PetitionFiefCommand.Influence} influence, and its head must think {PetitionFiefCommand.Need:+0;-0} of you or better. Visits, gifts and votes move that: a house's page under Houses says what can be done.")"
                     IsEmpty="@(grantors.Count == 0)" EmptyLine="No house has a world to spare." EmptyIcon="ringed-planet">
                @foreach (var gr in grantors.Take(8))
                {
                    string gid = gr.Id; int regard = PetitionFiefCommand.RegardOf(w, gr, w.Protagonist!); var would = PetitionFiefCommand.WouldGrant(w, gr); var ask = new PetitionFiefCommand(pid, gid); string? askNo = ask.Refusal(G.Ctx);
                    <Row Class="petition-row" Name="@gr.Name" data-grantor="@gid" data-short="@Math.Max(0, PetitionFiefCommand.Need - regard)">
                        <Picture><span class="hs-arms"><Sigil HouseId="@gr.Id" Accent="@gr.AccentColor" Size="32" /></span></Picture>
                        <NameExtra>@if (gr.Id == named?.Id) { <span class="hs-tag" title="The house the Reach would name">named</span> }</NameExtra>
                        <Sub>would give <b>@(would?.Name ?? "a world")</b> · its head thinks <b class="@(regard >= PetitionFiefCommand.Need ? "ui-up" : "ui-warn-t")">@regard.ToString("+0;−0")</b> of you@(regard >= PetitionFiefCommand.Need ? ": enough" : $": {PetitionFiefCommand.Need - regard} short")</Sub>
                        <Action><span class="hs-acts">
                            <Plate Label="Petition" Icon="public-speaker" Small="true" CostIcon="public-speaker" CostText="@PetitionFiefCommand.Influence.ToString()" Locked="@(askNo != null)" Disabled="@(askNo != null)" ShowNeed="false" Need="@(askNo ?? "")" Tip="@($"Ask {gr.Name} for {(would?.Name ?? "a world")}")" OnClick="() => G.Execute(ask)" />
                            <Link Label="Its page" Tip="The house's page under Houses" OnClick='() => OnGo.InvokeAsync("houses:" + gid)' />
                        </span></Action>
                    </Row>
                }
            </Section>
            </div>
        }
        <Section Title="Worlds" Count="@m.Holdings.Count.ToString()" Info="Each world of the house: its loyalty (100 less its unrest), its prosperity and where it is settling (the brass tick), its people, and its building slots. Hover a meter for why it stands where it does. Build opens what can be begun there; Invest raises its prosperity at once. A world with an empty governor's chair goes ungoverned."
                 IsEmpty="@(m.Holdings.Count == 0)" EmptyLine="Your house holds no land. A fief is won, granted, or married into." EmptyIcon="ringed-planet">
            <Right><span><b>@Census.Say(citizens)</b> citizens</span></Right>
            <ChildContent>
            @foreach (var h in m.Holdings)
            {
                var holding = w.Holding(h.Id)!; var sys = w.Galaxy?.System(holding.SystemId); string hid = h.Id;
                string gcls = h.Kind == "claim" ? "belt" : h.Kind == "station" ? "barren" : sys?.PlanetClass ?? "terran";
                var risingHere = w.Projects.Where(p => p.OwnerId == house.Id && (p.TargetId == holding.Id || p.TargetId.StartsWith(holding.SystemId + "#", StringComparison.Ordinal) || p.TargetId.StartsWith(holding.Id + "@", StringComparison.Ordinal))).ToList();
                int free = Math.Max(0, h.Slots - h.SlotsUsed); int works = h.Kind == "planet" && SystemWorks.In(w, holding.SystemId).Count() is > 0 and var nw ? nw : 0;
                long cz = Census.Citizens(G.World!, holding);
                bool seat = house.SeatGrade > 0 && house.SeatHoldingId == h.Id;
                var canBuild = holding.IsPlanet && sys != null ? SystemWorks.BuildableOn(w, c.Holdings, c.Titles, house, holding, G.Ctx) : null; var nowBuild = canBuild?.Where(x => x.Refusal == null).ToList();
                int ready = nowBuild?.Count ?? h.Builds.Count(b => b.Available);
                bool noGov = h.GovernorName == null || h.GovernorName.StartsWith("nobody", StringComparison.Ordinal);
                var uw = G.Turn?.Economy?.UnrestWhy(w, holding) ?? new(); var pw = G.Turn?.Economy?.ProsperityWhy(w, holding) ?? new();
                var subParts = new List<string> { Labels.Sentence(h.SpecName) }; if (h.Kind == "station") subParts.Add("station"); if (h.Kind == "claim") subParts.Add("claim"); if (h.SystemName != null) subParts.Add(h.SystemName); if (h.Culture.Length > 0) subParts.Add(Cap(h.Culture) + " culture"); if (works > 0) subParts.Add($"{works} work{(works == 1 ? "" : "s")} round its sun"); if (h.Belt > 0) subParts.Add($"belt richness {h.Belt}");
                <div class="hs-world @(h.Besieged ? "besieged" : "") @(h.Unrest >= 50 ? "restless" : "")" data-world="@h.Id">
                    <div class="hs-gl"><button class="hs-globe-btn" title="@($"Open {h.SystemName ?? h.Name} on the map")" @onclick='() => OnGo.InvokeAsync("galaxy:" + holding.SystemId)'><Globe Class="@gcls" Size="62" Ringed="@(h.Kind == "planet")" Rich="@Math.Max(1, h.Belt)" /></button></div>
                    <div class="hs-wmain">
                        <div class="hs-whd">
                            <div class="hs-wtt">
                                <div class="hs-wnm">@h.Name
                                    @if (seat) { <span class="hs-tag gold" data-seat="@house.SeatGrade" title="@WealthSystem.SeatGives(house.SeatGrade)">the house's seat: a @WealthSystem.SeatName(house.SeatGrade)</span> }
                                </div>
                                <div class="hs-wsub" title="@string.Join(" · ", subParts)">@string.Join(" · ", subParts)</div>
                            </div>
                            <div class="hs-wacts">
                                <Plate Label="Build" Icon="build" CostText="@($"{ready} ready")" data-can-begin="@ready" Class="@(_build == hid ? "down" : "")"
                                       Tip="@($"[build] Build on {h.Name}\n{(free <= 0 && holding.IsPlanet ? "Every slot is taken. Development, rank and cleared ground open more." : $"{ready} can be begun now.")} The system's own panel says what each thing lacks.\nkey: Click to {(_build == hid ? "close the list" : "see what can be built")}")"
                                       OnClick="() => _build = _build == hid ? null : hid" />
                                @if (h.Invest != null && h.Kind != "claim")
                                {
                                    int ic = c.Businesses.Finance.InvestCredits, ip = c.Businesses.Finance.InvestProsperity;
                                    <Plate Label="Invest" Icon="sprout" CostIcon="credits" CostText="@Money.Show(ic)" Locked="@(h.Invest.Refusal != null)" Disabled="@(h.Invest.Refusal != null)" ShowNeed="false" Need="@(h.Invest.Refusal ?? "")"
                                           Tip="@($"[sprout] Invest in {h.Name}\nThe world's yields are scaled by its prosperity, which drifts back toward what its buildings and governor support by 5 a year.\n[credits] Credits = −{Money.Show(ic)}, {Money.Held(house.Treasury)} to {Money.Show(house.Treasury.Credits - ic)}\n[sprout] Prosperity = +{Math.Min(ip, 100 - h.Prosperity)}, {h.Prosperity} to {Math.Min(100, h.Prosperity + ip)}")"
                                           OnClick="() => G.Execute(new InvestCommand(pid, hid, c.Businesses))" />
                                }
                            </div>
                        </div>
                        @if (h.Kind != "claim")
                        {
                            <div class="hs-wmid">
                                <div class="hs-meters" data-why="@h.Id">
                                    <Meter Label="Loyalty" Value="@(100 - h.Unrest)" Color="@(h.Unrest >= 50 ? "#e0553f" : "#8cc47e")" ValueClass="@(h.Unrest >= 50 ? "ui-down" : "")"
                                           Tip="@WhyTip("[shaking-hands] Loyalty", $"Loyalty is 100 less the world's unrest ({h.Unrest}). Each year unrest moves by what is below; a loss of loyalty is a rise in unrest.", uw.Select(x => (x.what, -x.by)).ToList(), "In all, a year")" />
                                    <Meter Label="Prosperity" Value="@h.Prosperity" Target="@h.ProsperityTarget" Color="#c9a24a"
                                           Tip="@WhyTip("[sprout] Prosperity", $"Prosperity is {h.Prosperity} and settles at {h.ProsperityTarget}, a step nearer each year. It settles there because of what is below, held between 0 and 100.", pw.Select(x => (x.what, x.by)).ToList(), "It settles at")" />
                                    @if (h.MaxPopulation > 0)
                                    {
                                        <Meter Label="@(h.Population >= h.MaxPopulation ? "Pop, full" : "Population")" Value="@h.Population" Max="@Math.Max(1, h.MaxPopulation)" Color="#8fa3bd" Text="@Short(cz)"
                                               Tip="@($"[population] Population\n{Census.Say(cz)} citizens. {GalaxyMap.CitizensTip(G.World!, holding, h.MaxPopulation)}\nOn the rules' scale: {h.Population} of {h.MaxPopulation}\n{(h.Population >= h.MaxPopulation ? "The world is full. Habitats, laid on the world from the map (its system, then the body), make room for more." : "Habitats laid on the world make room for more.")}")" />
                                    }
                                </div>
                                @{
                                    var slots = new List<Slots.Slot>();
                                    for (int bi = 0; bi < h.Buildings.Count; bi++)
                                    {
                                        string bname = h.Buildings[bi]; string? bid = bi < holding.Buildings.Count ? holding.Buildings[bi] : null;
                                        slots.Add(new("built", bname, (bid != null ? G.WorkPicture(bid) : null) ?? ""));
                                    }
                                    foreach (var rp in risingHere)
                                        slots.Add(new("rising", $"Rising: {Cap(rp.Name)}, {Counted.Years(rp.TurnsLeft)} left{(rp.Stalled ? ". Stalled: the treasury could not pay its share last year." : rp.Paused ? ". Paused." : "")}", Note: $"{rp.TurnsLeft} yr", Stalled: rp.Stalled));
                                    for (int oi = 0; oi < Math.Max(0, h.SlotsUsed - h.Buildings.Count - risingHere.Count); oi++) slots.Add(new("other", "In use: a work on the world itself"));
                                    for (int fi = 0; fi < free; fi++) slots.Add(new("free", "A free slot: Build says what can be begun"));
                                }
                                <Slots Items="slots" Class="hs-slots" HeadTip="The world's building slots: what stands, what is rising and the works on the world itself. The same count as the system's own panel on the map, where each is built." data-free-slots="@free" data-rising-here="@risingHere.Count" />
                            </div>
                        }
                        @if (h.Besieged) { <WarnStrip Icon="siege" Lead="Under siege." Bad="true">Nothing it yields reaches the house until the siege is lifted.</WarnStrip> }
                        else if (h.Unrest >= 50) { <WarnStrip Icon="alert" Lead="Restless." Bad="@(h.Unrest >= 70)">Loyalty is @(100 - h.Unrest): a restless world yields less and may rise.</WarnStrip> }
                        @if (noGov)
                        {
                            <WarnStrip Icon="office-chair" Lead="No governor." Class="hs-gov-strip">
                                <ChildContent>@(h.GovernorName == null ? "Nobody sits in the governor's chair, and the world goes ungoverned." : Cap(h.GovernorName["nobody: ".Length..]) + ".")</ChildContent>
                                <Action>@if (h.GovernorOptions is { Count: > 0 }) { <Plate Label="@(_appoint == hid ? "Close" : "Appoint")" Icon="office-chair" Small="true" Tip="@($"[office-chair] Name a governor of {h.Name}\nOne of the house who is grown. It costs an influence. An able administrator keeps the world the better.")" OnClick="() => _appoint = _appoint == hid ? null : hid" /> }</Action>
                            </WarnStrip>
                        }
                        else if (h.GovernorName != null)
                        {
                            <div class="hs-gov">
                                <Icon Name="governor" Tone="ivory" Size="16" /><span>Governor <b>@h.GovernorName</b></span>
                                @if (h.GovernorDisposition < 100) { <span class="hs-tag @GovClass(h)" title="@GovTitle(h)">@GovText(h)</span> }
                                @if (h.GovernorAdministration >= 3) { <span class="hs-tag gold" title="an able administrator">able</span> }
                                @if (h.GovernorOptions is { Count: > 0 }) { <button class="ui-link hs-gov-chg" title="Name another of the house to the chair" @onclick="() => _appoint = _appoint == hid ? null : hid">@(_appoint == hid ? "Close" : "Change")<Icon Name="chev" Size="11" Class="flat" /></button> }
                            </div>
                        }
                        @if (_appoint == hid && h.GovernorOptions is { Count: > 0 })
                        {
                            <div class="hs-sub-list" data-governor-chair="@hid">
                                <div class="hs-sub-hd">The governor's chair</div>
                                @foreach (var o in h.GovernorOptions)
                                {
                                    var who = w.Char(o.Id); string oid = o.Id;
                                    <div class="hs-pick">
                                        @if (who != null) { <Portrait Id="@who.Id" Name="@who.Name" Sex="@who.Sex" Age="@who.Age" Accent="@m.HouseAccent" Size="24" Height="28" /> }
                                        <span class="hs-pick-nm">@(who?.Name ?? o.Id)</span><span class="hs-pick-sub">administration @(who?.Skill("administration") ?? 0) · @who?.Age</span>
                                        <Plate Label="Appoint" Small="true" CostIcon="public-speaker" CostText="1" Locked="@(o.Refusal != null)" Disabled="@(o.Refusal != null)" ShowNeed="false" Need="@(o.Refusal ?? "")" Tip="@o.Label" OnClick="() => G.Execute(new AppointGovernorCommand(pid, hid, oid))" />
                                    </div>
                                }
                            </div>
                        }
                        @if (_build == hid)
                        {
                            <div class="hs-sub-list" data-build-list="@hid">
                                @if (holding.IsPlanet && sys != null && canBuild != null && nowBuild != null)
                                {
                                    int homeBody = sys.Bodies.FindIndex(x => x.IsPrimary); string sysId = sys.Id;
                                    <div class="hs-sub-hd">Can be begun now <span>@nowBuild.Count</span></div>
                                    @if (nowBuild.Count == 0) { <p class="hs-note">@(free <= 0 ? "Every slot is taken. Development, rank and cleared ground open more." : "Nothing can be begun now.") The system's own panel says what each thing lacks.</p> }
                                    @foreach (var bo in nowBuild)
                                    {
                                        string boId = bo.Id; bool isWork = bo.Work != null;
                                        <div class="hs-pick">
                                            @if (G.WorkPicture(bo.Id) is { } bart) { <span class="ui-thumb hs-pick-art"><img src="@bart" alt="" loading="eager" decoding="async" /></span> } else { <span class="hs-pick-art none"><Icon Name="build" Tone="ivory" Size="15" /></span> }
                                            <span class="hs-pick-nm" title="@(bo.Work?.Description ?? "")">@Cap(bo.Name)</span>
                                            <span class="hs-pick-sub">@CourtProjection.Bundle(bo.Cost)@(bo.BuildTurns > 1 ? " · " + bo.BuildTurns + " years" : "")</span>
                                            <Plate Label="@(bo.BuildTurns > 1 ? "Begin" : "Build")" Icon="build" Small="true" Tip="@($"[build] {(bo.BuildTurns > 1 ? "Begin" : "Build")} {bo.Name}\n{(bo.Work?.Description ?? "")}\nCost: {CourtProjection.Bundle(bo.Cost)}{(bo.BuildTurns > 1 ? $", paid by the year over {bo.BuildTurns} years" : "")}")"
                                                   OnClick="() => G.Execute(isWork ? new BuildWorkCommand(pid, sysId, homeBody, boId, c.Holdings, c.Titles) : new BuildCommand(pid, hid, boId, c.Holdings, c.Titles))" />
                                        </div>
                                    }
                                    <p class="hs-note"><Link Label="@($"{canBuild.Count - nowBuild.Count} more not yet possible, the other bodies and the great works: its system")" Tip="Open its system on the map" OnClick='() => OnGo.InvokeAsync("galaxy:" + sysId)' /></p>
                                }
                                else
                                {
                                    <div class="hs-sub-hd">Can be built</div>
                                    @foreach (var b in h.Builds)
                                    {
                                        var bb = b;
                                        <div class="hs-pick">
                                            <span class="hs-pick-art none"><Icon Name="build" Tone="ivory" Size="15" /></span>
                                            <span class="hs-pick-nm" title="@b.Tooltip">@Cap(b.Label)</span>
                                            <Plate Label="Build" Icon="build" Small="true" Locked="@(!b.Available)" Disabled="@(!b.Available)" ShowNeed="false" Need="@(b.Available ? "" : b.Tooltip)" Tip="@b.Label" OnClick="() => G.Execute(new BuildCommand(pid, hid, bb.BuildingId, c.Holdings, c.Titles))" />
                                        </div>
                                    }
                                }
                                @if (h.Ships.Count > 0)
                                {
                                    <div class="hs-sub-hd">The shipyard <span>@h.Ships.Count</span></div>
                                    @foreach (var sh in h.Ships)
                                    {
                                        string shClass = sh.ClassId;
                                        <div class="hs-pick">
                                            <span class="hs-pick-art none"><Icon Name="ship" Tone="steel" Size="15" /></span>
                                            <span class="hs-pick-nm">@Cap(c.ShipClasses.ById(sh.ClassId)?.Name ?? sh.ClassId)</span><span class="hs-pick-sub" title="@sh.Label">@sh.Label</span>
                                            <Plate Label="Lay down" Icon="ship" Small="true" Locked="@(sh.Refusal != null)" Disabled="@(sh.Refusal != null)" ShowNeed="false" Need="@(sh.Refusal ?? "")" Tip="@sh.Label" OnClick="() => G.Execute(new RaiseFleetCommand(pid, hid, c.Fleets, c.ShipClasses, shClass, c.Titles))" />
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            </ChildContent>
        </Section>

        var under = w.ProvincesOf(house.Id).Where(x => x.h.OwnerId != house.Id).ToList();
        @if (under.Count > 0)
        {
            /* one player did not know for nineteen years that the house held any (docs/PLAYTHROUGH.md, Medium, P89) */
            <div class="held-under" data-held-under="@under.Count">
            <Section Title="Held under other houses" Count="@under.Count.ToString()" Info="Provinces your house holds on other houses' worlds, yours for life. What they yield is in the ledger, less the dues owed to the house over. Click one to open its system: the province, its city and what can be built there.">
                <Right><span>Yours for life</span></Right>
                <ChildContent>
                @foreach (var (uh, ui) in under)
                {
                    var up = uh.Provinces[ui]; var uy = ProvinceSystem.Yield(w, c.Holdings, uh, up); var ud = ProvinceSystem.Dues(w, c.Holdings, uh, ui); string usys = uh.SystemId; var focus = c.Holdings.Provinces.Focus(up.Focus);
                    <Row Class="held-row" Name="@up.Name" OnClick='() => OnGo.InvokeAsync("galaxy:" + usys)' Tip="Open its system: the province, its city and what can be built there">
                        <Picture>@if (G.WorkPicture(ProvinceArt.GetValueOrDefault(up.Focus, up.Focus)) is { } pa) { <span class="ui-thumb"><img src="@pa" alt="" loading="eager" decoding="async" /></span> } else { <span class="ui-thumb hs-thumb-none"><Icon Name="rolled-cloth" Tone="ivory" Size="18" /></span> }</Picture>
                        <Sub>@uh.Name, under <b>@(w.House(uh.OwnerId)?.Name)</b> · @(focus?.Name ?? up.Focus)@(up.City.Length > 0 ? " · " + up.City : "") · level @up.Level</Sub>
                        <Cells>
                            @if (uy.IsEmpty()) { <span class="ui-cell ui-mute">pays nothing</span> }
                            @foreach (var k in Resource.All.Where(k => uy.Get(k) != 0)) { <Cell Icon="@k" Tone="@ResTone(k)" Value="@ResSigned(k, uy.Get(k))" Class="@(uy.Get(k) > 0 ? "ui-up" : "ui-down")" Tip="@($"{Resource.Label(k)} a year")" /> }
                        </Cells>
                        <Action>
                            @if (up.Withheld) { <span class="ui-cell ui-warn-t" title="You are withholding the dues">withheld</span> }
                            else if (ud.IsEmpty()) { <span class="ui-cell ui-mute" title="No dues owed">no dues</span> }
                            else { <span class="hs-dues" title="@($"Owes {CourtProjection.Bundle(ud)} a year to the house over ({ProvinceSystem.DuesName(ProvinceSystem.DuesOf(w, up))})")">@foreach (var k in Resource.All.Where(k => ud.Get(k) != 0)) { <Cell Icon="swap-bag" Tone="brass" Value="@("−" + Money.Of(k, ud.Get(k)))" Class="ui-down" /> }</span> }
                        </Action>
                    </Row>
                }
                </ChildContent>
            </Section>
            </div>
        }

        @if (lg != null)
        {
            var landLines = lg.Lines.Where(l => EstateKinds.Contains(l.Kind) && l.Delta.Credits != 0).OrderByDescending(l => l.Delta.Credits).ToList(); int landNet = landLines.Sum(l => l.Delta.Credits);
            int landMax = Math.Max(1, landLines.Select(l => Math.Abs(l.Delta.Credits)).DefaultIfEmpty(1).Max());
            <Section Title="What the land yields" Count="@landLines.Count.ToString()" Info="Credits a year from the house's worlds, stations, claims, works and provinces, at this year's prices: gold to the right of the line, red to the left. Fleets, ventures, loans and the rest are on the Ledger tab."
                     IsEmpty="@(landLines.Count == 0)" EmptyLine="The land yields no credits this year." EmptyIcon="credits">
                <Right><span>The land <b class="@(landNet >= 0 ? "ui-up" : "ui-down")">@Sg(landNet)</b> · the house clears <b class="@(net >= 0 ? "ui-up" : "ui-down")">@Sg(net)</b></span></Right>
                <ChildContent>
                <div class="hs-led">
                    @foreach (var l in landLines)
                    {
                        int v = l.Delta.Credits;
                        <span class="hs-led-src" title="@($"{Cap(l.Source)}: {Delta(l.Delta)}")"><Icon Name="@LineIcon(l.Kind)" Tone="ivory" Size="15" /><span class="hs-led-t">@LedLabel(l.Source)</span></span>
                        <span class="hs-led-neg">@if (v < 0) { <i style="width:@Pc(100.0 * -v / landMax)"></i> }</span>
                        <span class="hs-led-pos">@if (v > 0) { <i style="width:@Pc(100.0 * v / landMax)"></i> }</span>
                        <span class="hs-led-amt @(v > 0 ? "ui-up" : "ui-down")">@Sg(v)</span>
                    }
                </div>
                <p class="hs-note"><Link Label="Every line, the accounts and the lenders" Tip="The Ledger tab" OnClick='() => Pick("ledger")' /></p>
                </ChildContent>
            </Section>
        }
    }
    </div>
</div>

@code {
    /// <summary>What the year adds to the treasury or takes from it, as the top bar and the Ledger's "This year" have it: the forecast
    /// less the year's outgoings (the shares of what is being built, hastening, tutors, allowances, the household).</summary>
    public static int YearNet(GameClient g, World w, House house)
    {
        var fc = g.Turn!.Economy?.Forecast(w, house.Id, g.Turn.Fleets); if (fc == null) return 0;
        var outs = HouseAccounts.Total(HouseAccounts.Outgoings(w, g.Content!.Holdings, house, g.Turn.Economy));
        return fc.Credits - outs.Credits;
    }

    /* a list of causes for a tooltip, one effect line each: "[icon] a solvent house = +2", then the sum */
    private static string WhyTip(string head, string lead, List<(string what, int by)> why, string sumLabel)
    {
        var lines = new List<string> { head, lead };
        foreach (var (what, by) in why) lines.Add($"[{(by >= 0 ? "sprout" : "alert")}] {Cap(what)} = {Fig(by)}");
        if (why.Count > 0) lines.Add($"{sumLabel}: {Fig(why.Sum(x => x.by))}");
        return string.Join("\n", lines);
    }
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    /// <summary>A ledger line's label, short enough for its column: "Dues of The Greywater Marches" is "Greywater Marches dues" (the
    /// whole name stays in the line's tooltip).</summary>
    private static string LedLabel(string s)
    {
        if (s.StartsWith("Dues of ", StringComparison.Ordinal)) { var n = s[8..]; if (n.StartsWith("The ", StringComparison.Ordinal)) n = n[4..]; return n + " dues"; }
        return Cap(s);
    }
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    [Parameter] public EventCallback<string> OnGo { get; set; }
    private string? _focus, _build, _appoint; private string _view = "estate";
    private void Pick(string k) => _view = k;
    /// <summary>A tab's old hook (data-tab-council and the rest), kept beside the shared data-tab.</summary>
    private static IReadOnlyDictionary<string, object> Hook(string name) => new Dictionary<string, object> { [name] = true };
    /// <summary>Whether "what its legitimacy is made of" is open under Standing.</summary>
    private bool _made;
    /// <summary>The amount picked at each lender, by lender id.</summary>
    private readonly Dictionary<string, int> _borrow = new();
    /// <summary>The tab an alert asked for, and a stamp that changes each time one asks; a stamp is used once.</summary>
    [Parameter] public string Tab { get; set; } = "";
    [Parameter] public int TabStamp { get; set; }
    private static int _seenStamp;
    protected override void OnParametersSet() { if (TabStamp != _seenStamp) { _seenStamp = TabStamp; if (Tab.Length > 0) OpenOn(Tab); } }
    /// <summary>"tab" or "tab:person". The old tabs land where their things went: the seat and estates in the purse, the ventures' list on the estate.</summary>
    private void OpenOn(string tab)
    {
        var parts = tab.Split(':'); string t = parts[0];
        _view = t switch { "riches" or "seat" or "will" => "purse", "ventures" or "domain" => "estate", "estate" or "ledger" or "household" or "council" or "court" or "purse" => t, _ => _view };
        if (parts.Length > 1 && _view == "household") _focus = parts[1];
    }
    /// <summary>A province's painting by what it is given to, where one was painted for that subject (docs/ART_DIRECTION.md: a picture matches its subject or none ships).</summary>
    private static readonly Dictionary<string, string> ProvinceArt = new()
    {
        ["rare_earths"] = "rare_earth_diggings", ["helium"] = "helium_skimmers", ["isotopes"] = "isotope_pits", ["march"] = "barracks_quarter", ["farmland"] = "farm_complex",
        ["ports"] = "deep_harbour", ["mines"] = "mine", ["icefields"] = "ice_works", ["seat"] = "governors_palace"
    };
    private static readonly HashSet<string> EstateKinds = new() { "world", "station", "claim", "work", "province", "tolls" };
    private static string GovClass(HoldingCard h) => h.GovernorDisposition <= -30 ? "bad" : h.GovernorDisposition < 10 ? "" : "good";
    private static string GovText(HoldingCard h) => h.GovernorDisposition <= -30 ? (h.GovernorAmbitious ? "hostile, ambitious" : "hostile") : h.GovernorDisposition < 10 ? "cool" : "loyal";
    private static string GovTitle(HoldingCard h) => "Disposition toward you " + Counted.Figure(h.GovernorDisposition) + (h.GovernorAmbitious ? ", and ambitious" : "");
    private static string Ordinal(int n) => n % 100 is 11 or 12 or 13 ? $"{n}th" : (n % 10) switch { 1 => $"{n}st", 2 => $"{n}nd", 3 => $"{n}rd", _ => $"{n}th" };
    private static string Goods(Resources r) => string.Join(" · ", Resource.All.Where(k => k != "credits" && r.Get(k) != 0).Select(k => $"{Fig(r.Get(k))} {Resource.Label(k)}"));
    private static string Delta(Resources r) { var parts = Resource.All.Where(k => r.Get(k) != 0).Select(k => $"{ResSigned(k, r.Get(k))} {Resource.Label(k).ToLowerInvariant()}").ToList(); return parts.Count == 0 ? "nothing" : string.Join(" · ", parts); }
    private ICommand Household(string optionId, string childId) => optionId == "recall" ? new RecallCommand(G.World!.ProtagonistId, childId) : new FosterCommand(G.World!.ProtagonistId, childId);
    /// <summary>A signed sum from the books, with the true minus: +1,000, −600.</summary>
    public static string Sg(long units) => units > 0 ? "+" + Money.Show(units) : units < 0 ? "−" + Money.Show(-units) : "0";
    /// <summary>A signed plain figure with the true minus.</summary>
    public static string Fig(long n) => n > 0 ? "+" + n : Counted.Figure(n);
    public static string ResSigned(string k, long n) => n > 0 ? "+" + Money.Of(k, n) : n < 0 ? "−" + Money.Of(k, -n) : "0";
    public static string ResTone(string k) => k switch { "credits" => "brass", "materials" or "exotics" or "helium3" => "steel", "isotopes" => "ember", _ => "ivory" };
    private static string LineIcon(string kind) => kind switch
    {
        "world" => "planet", "station" or "claim" or "work" => "station", "fleet" or "escort" => "fleet", "loan" or "interest" => "treasury_pool", "province" => "rolled-cloth",
        "venture" or "charter" => "factory", "dividend" => "coins-pile", "court" => "throne-king", "clients" => "three-friends", "fuel" => "helium3", "tolls" => "trade", _ => "trade_hub"
    };
    /// <summary>Citizens short enough for a meter's value: "3.8 bn", "742 m", the rest whole.</summary>
    public static string Short(long n) => n >= 1_000_000_000 ? (n / 1e9).ToString(n >= 10_000_000_000 ? "0" : "0.#", System.Globalization.CultureInfo.InvariantCulture) + " bn"
        : n >= 1_000_000 ? (n / 1e6).ToString(n >= 10_000_000 ? "0" : "0.#", System.Globalization.CultureInfo.InvariantCulture) + " m" : n.ToString("#,0", System.Globalization.CultureInfo.InvariantCulture);
    private static string Pc(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    /// <summary>A rival's colour toned for a bar larger than a mark (docs/VISUAL_SYSTEM.md 2.2: saturation times 0.8, value times 0.88).</summary>
    public static string Tone(string hex) => hex.Length == 7 ? $"color-mix(in srgb, {hex} 82%, #1b1e26)" : hex;
    /// <summary>Numbers in a lede set in bold roman lining figures (docs/VISUAL_SYSTEM.md 4.5).</summary>
    public static MarkupString Bold(string s) => new(System.Text.RegularExpressions.Regex.Replace(System.Net.WebUtility.HtmlEncode(s.Replace(" -", " −")), @"(?<![\w&#])([+−-]?\d(?:[\d,.]*\d)?(?:st|nd|rd|th)?)(?![\w;])", "<b>$1</b>"));
}
