@preservewhitespace true
@using Praetoria.Core.Systems
@using Praetoria.Core.Presentation
@inject GameClient G
@implements IDisposable
@* The courts on the Senate window (docs/LADDER.md, "The courts"; docs/VISUAL_SYSTEM.md 4.6, 4.7): sections of rows. The docket (every
   matter that touches the house, each an entry with how it is answered), the charges against the powerful, a suit to bring, what the
   courts have ruled, what stands on the record against former magistrates, what stands against the house, and the praetors on the
   bench with their faces. *@
@{
    var w = G.World!; var c = G.Content!; var p = w.Protagonist!; var pid = p.Id; var house = w.House(p.HouseId)!; var offices = c.Offices;
    bool active = LadderSystem.Active(w, offices);
    var charges = active ? LadderSystem.Chargeable(w, house.Id).Take(_all ? 30 : 5).ToList() : new List<OfficeDeed>();
    int more = active ? LadderSystem.Chargeable(w, house.Id).Count - charges.Count : 0;
    var ours = active ? w.OfficeRecord.Where(d => d.HouseId == house.Id && !d.Answered && !LadderSystem.UnderCharge(w, d.Id) && w.Char(d.CharacterId) is { Alive: true }).OrderByDescending(d => d.Turn).ThenBy(d => d.Id, StringComparer.Ordinal).ToList() : new List<OfficeDeed>();
    var bench = active ? w.Magistrates.Where(m => m.OfficeId == LadderSystem.Praetor && m.HouseId != house.Id).Select(m => w.Char(m.CharacterId)).Where(x => x is { Alive: true }).Select(x => x!).OrderBy(x => x.Id, StringComparer.Ordinal).ToList() : new List<Character>();
    var rulings = w.Judgments.AsEnumerable().Reverse().Take(_allRulings ? 40 : 5).ToList();
    var pleaders = w.LivingCharacters().Where(x => x.HouseId == house.Id && x.Age >= DynastySystem.AgeOfMajority).OrderByDescending(LadderSystem.Craft).ThenBy(x => x.Id, StringComparer.Ordinal).Take(4).ToList();
    string Nature(Character j) => LadderSystem.NatureOf(j);
    var docket = Docket.Of(w, offices, house.Id);
    var willsDecided = active ? DisownSystem.DecidedOn(w, house.Id) : new List<WillSuit>();   // the suits of the undutiful will lately decided (docs/HOUSEHOLD.md)
    var quarrels = active ? w.Houses.Values.Where(h => h.Id != house.Id && !World.Outsider(h.Id) && PolitySystem.InReach(w, h.Id) && Economy.HeadOf(w, h) != null && LadderSystem.Heat(w, house, h) >= LadderSystem.QuarrelHeat)
        .OrderByDescending(h => LadderSystem.Heat(w, house, h)).ThenBy(h => h.Id, StringComparer.Ordinal).ToList() : new List<House>();
    int moreQuarrels = Math.Max(0, quarrels.Count - 3);
}
@if (active)
{
<section class="panel courts sn-panel">
    <Section Title="The courts" Count="@(docket.Count > 0 ? docket.Count.ToString() : "")" Info="@(Intro + " The docket below is every matter before the courts that touches your house, and when it is heard. Until then you may answer it.")">
        <Right><span>@(charges.Count + more) on the record · @bench.Count praetor@(bench.Count == 1 ? "" : "s") of other houses sitting</span></Right>
        <ChildContent>
        <span hidden data-docket="1"></span>
        @if (docket.Count == 0) { <div class="ui-empty" data-docket-empty="1"><Icon Name="scales" Tone="ivory" Size="46" /><div><p>Nothing that touches your house is before the courts.</p></div></div> }
        @foreach (var e in docket)
        {
            string eid = e.Id;
            if (e.Kind == Docket.Charge)
            {
                var charge = w.Indictments.First(x => x.Id == eid); var accused = w.Char(charge.AccusedId)!;
                var noAdmit = new ChargeCommand(pid, ChargeCommand.Admit, eid, offices).Refusal(G.Ctx);
                string admitTip = noAdmit ?? LadderSystem.AdmitSays(w, accused);
                string answers = e.Pleader.Length > 0 ? e.Pleader + " is to answer it." : "Nobody is to answer it yet.";
                <div class="sn-ent suit court-suit warn" data-charge="@eid" data-kind="@e.Kind">
                    <span class="sn-pic">@SenateScreen.Face(w, accused, "scales")</span>
                    <div class="sn-ent-main">
                        <div class="sn-hd"><b class="sn-nm">@e.Title</b><span class="sn-fig down" title="The fine"><Icon Name="credits" Tone="ember" Size="15" />@Money.Show(e.Sum)</span></div>
                        <div class="sn-sub2">@e.Over · heard @e.Heard by @e.Judge@(e.JudgeIs.Length > 0 ? ", who is " + e.JudgeIs : string.Empty)</div>
                        <div class="sn-tx">@e.Law @answers</div>
                        <div class="sn-acts suit-acts">
                            <Plate Label="Admit it" Small="true" Locked="@(noAdmit != null)" Disabled="@(noAdmit != null)" Tip="@admitTip" CostIcon="credits" CostText="@Money.Show(LadderSystem.FineCredits)" OnClick="() => AskAdmit(eid, accused.Name)" data-admit="@eid" />
                            @foreach (var a in pleaders)
                            {
                                string aid = a.Id; var noDefend = new ChargeCommand(pid, ChargeCommand.Plead, eid, offices, aid).Refusal(G.Ctx); string defendTip = noDefend ?? LadderSystem.ChargePleadSays(w, charge, a);
                                <Plate Label="@("Send " + a.Name + " to plead")" Small="true" Locked="@(noDefend != null)" Disabled="@(noDefend != null)" Tip="@defendTip" CostIcon="public-speaker" CostText="@LadderSystem.PleadInfluence.ToString()" OnClick="() => G.Execute(new ChargeCommand(pid, ChargeCommand.Plead, eid, offices, aid))" data-defend="@aid" />
                            }
                        </div>
                    </div>
                </div>
            }
            else if (e.Kind == Docket.Will)
            {
                var ws = w.WillSuits.First(x => x.Id == eid);
                var noTerms = new WillSuitCommand(pid, WillSuitCommand.Settle, eid).Refusal(G.Ctx);
                string termsTip = noTerms ?? DisownSystem.TermsSays(w, ws);
                string answers = e.Pleader.Length > 0 ? e.Pleader + " is to answer it." : string.Empty;
                string winSays = DisownSystem.WinSays(w, ws);
                <div class="sn-ent suit court-suit warn" data-undutiful-will="@eid" data-kind="@e.Kind">
                    <span class="sn-ic bad"><Icon Name="scroll-unfurled" Tone="ember" Size="22" /></span>
                    <div class="sn-ent-main">
                        <div class="sn-hd"><b class="sn-nm">@e.Title</b></div>
                        <div class="sn-sub2">@e.Over · heard @e.Heard by @e.Judge@(e.JudgeIs.Length > 0 ? ", who is " + e.JudgeIs : string.Empty)</div>
                        <div class="sn-tx">@e.Law @winSays @answers</div>
                        <div class="sn-acts suit-acts">
                            <Plate Label="Come to terms" Small="true" Locked="@(noTerms != null)" Disabled="@(noTerms != null)" Tip="@termsTip" CostIcon="credits" CostText="@Money.Show(ws.Share)" OnClick="() => G.Execute(new WillSuitCommand(pid, WillSuitCommand.Settle, eid))" data-will-terms="@eid" />
                            @foreach (var a in pleaders)
                            {
                                string aid = a.Id; var noAnswer = new WillSuitCommand(pid, WillSuitCommand.Plead, eid, aid).Refusal(G.Ctx); string answerTip = noAnswer ?? DisownSystem.PleadSays(w, ws, a);
                                <Plate Label="@("Send " + a.Name + " to answer")" Small="true" Locked="@(noAnswer != null)" Disabled="@(noAnswer != null)" Tip="@answerTip" CostIcon="public-speaker" CostText="@LadderSystem.PleadInfluence.ToString()" OnClick="() => G.Execute(new WillSuitCommand(pid, WillSuitCommand.Plead, eid, aid))" data-will-plead="@aid" />
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                var s = w.OfficeWork.First(x => x.Id == eid); var other = w.House(e.OtherId); string otherName = other?.Name ?? string.Empty; bool forUs = e.Good; int stake = e.Sum;
                var noSettle = new SuitCommand(pid, SuitCommand.Settle, eid).Refusal(G.Ctx); var noCounter = new SuitCommand(pid, SuitCommand.Counter, eid).Refusal(G.Ctx);
                string ruled = forUs ? "If the praetor rules on the law, " + otherName + " pays you " + Money.Show(stake) + "." : "If the praetor rules on the law, you pay " + otherName + " " + Money.Show(stake) + ".";
                string pleads = e.Pleader.Length > 0 ? " " + e.Pleader + " is to plead it." : string.Empty;
                string settleTip = noSettle ?? (forUs ? otherName + " pays you " + Money.Show(stake / 2) + " now and the suit is withdrawn: half, but certain, whatever the praetor is" : "You pay " + otherName + " " + Money.Show(stake / 2) + " now and the suit is withdrawn: half of what a ruling on the law would cost");
                string counterTip = noCounter ?? CounterSays(otherName, stake);
                <div class="sn-ent suit court-suit @(forUs ? string.Empty : "warn")" data-suit="@eid" data-kind="@e.Kind">
                    <span class="sn-pic"><Sigil HouseId="@e.OtherId" Accent="@(other?.AccentColor ?? "#888")" Size="34" /></span>
                    <div class="sn-ent-main">
                        <div class="sn-hd"><b class="sn-nm">@e.Title</b><span class="sn-fig @(forUs ? "up" : "down")" title="What turns on it"><Icon Name="credits" Tone="@(forUs ? "good" : "ember")" Size="15" />@Money.Show(stake)</span></div>
                        <div class="sn-sub2">over @e.Over · @Money.Credits(stake) turn on it · heard @e.Heard by @e.Judge@(e.JudgeIs.Length > 0 ? ", who is " + e.JudgeIs : string.Empty)</div>
                        <div class="sn-tx">@e.Law @ruled@pleads</div>
                        <div class="sn-acts suit-acts">
                            <Plate Label="@(forUs ? "Take terms" : "Come to terms")" Small="true" Locked="@(noSettle != null)" Disabled="@(noSettle != null)" Tip="@settleTip" CostIcon="credits" CostText="@(Money.Show(stake / 2) + (forUs ? " to you" : ""))" OnClick="() => AskSettle(eid, forUs, otherName, stake / 2)" data-settle="@eid" />
                            @if (e.Kind == Docket.Against && !s.Countered) { <Plate Label="Counter-sue" Small="true" Locked="@(noCounter != null)" Disabled="@(noCounter != null)" Tip="@counterTip" OnClick="() => AskCounter(eid, otherName, stake)" data-counter="@eid"><Cost><Icon Name="credits" Tone="brass" Size="14" />@Money.Show(LadderSystem.FeeOf(stake)) <Icon Name="laurels" Tone="brass" Size="14" />@LadderSystem.CounterClout</Cost></Plate> }
                            @foreach (var a in pleaders)
                            {
                                string aid = a.Id; var noPlead = new SuitCommand(pid, SuitCommand.Plead, eid, aid).Refusal(G.Ctx); string pleadTip = noPlead ?? LadderSystem.PleadSays(w, s, a);
                                <Plate Label="@("Send " + a.Name + " to plead")" Small="true" Locked="@(noPlead != null)" Disabled="@(noPlead != null)" Tip="@pleadTip" CostIcon="public-speaker" CostText="@LadderSystem.PleadInfluence.ToString()" OnClick="() => G.Execute(new SuitCommand(pid, SuitCommand.Plead, eid, aid))" data-plead="@aid" />
                            }
                        </div>
                    </div>
                </div>
            }
        }
        @foreach (var ws in willsDecided)
        {
            <div class="sn-hist suit court-ruling @(ws.Outcome == DisownSystem.Undutiful ? "warn" : "good")" data-undutiful-will="@ws.Id" data-decided="@ws.Outcome">
                <b class="sn-chip @(ws.Outcome == DisownSystem.Undutiful ? "down" : "up")">year @ws.DecidedTurn</b><span class="sn-hist-t"><b>The suit over the will of @ws.DeceasedName</b> <span class="ui-mute">@ws.How</span></span>
            </div>
        }
        </ChildContent>
    </Section>

    <PowerfulCharges />

    @if (quarrels.Count == 0) { <div class="ui-empty" data-no-quarrel="1"><Icon Name="scales" Tone="ivory" Size="46" /><div><p>You have no quarrel with any house that a court would hear. It takes a war, or two heads who think ill of each other.</p></div></div> }
    else
    {
    <Section Title="Bring a suit" Count="@(quarrels.Count > 0 ? quarrels.Count.ToString() : "")" Info="@($"Against a house you have a quarrel with, on a ground the record gives you. It costs a fee and {LadderSystem.BringClout} clout, its head thinks the worse of you, and the loser pays what turns on it. Once a year.")" Class="sn-sub-sec">
        <Right><span data-bring="1" title="Clout in store, which bringing a suit spends"><Icon Name="laurels" Tone="ivory" Size="15" /> <b>@house.Treasury.Influence</b> clout</span></Right>
        <ChildContent>
        @foreach (var q in quarrels.Take(_allQuarrels ? 12 : 3))
        {
            string qid = q.Id; var judge = LadderSystem.Bench(w, house.Id, qid); bool war = w.AtWar(house.Id, qid);
            string why = war ? "at war with your house" : "its head and you think ill of each other (" + Counted.Figure(-LadderSystem.Heat(w, house, q)) + " between you)";
            string hears = judge == null ? "No praetor of a third house sits to hear it." : "It would come before " + judge.Name + " of " + (w.House(judge.HouseId)?.Name ?? string.Empty) + ", who is " + Nature(judge) + ".";
            <div class="sn-ent suit court-quarrel" data-quarrel="@qid">
                <span class="sn-pic"><Sigil HouseId="@q.Id" Accent="@q.AccentColor" Size="34" /></span>
                <div class="sn-ent-main">
                    <div class="sn-hd"><b class="sn-nm">@q.Name</b><span class="sn-sub @(war ? "ui-down" : "")">@why</span></div>
                    <div class="sn-tx ui-dim">@hears</div>
                    @foreach (var g in LadderSystem.Grounds(w, house, q))
                    {
                        string matter = g.Matter; var noBring = new BringSuitCommand(pid, qid, matter, offices).Refusal(G.Ctx); int fee = LadderSystem.FeeOf(g.Stake);
                        string law = LadderSystem.LawOn(g, house.Id); string bringTip = noBring ?? BringSays(q.Name, g.Stake);
                        <div class="sn-ground @(g.RightId == house.Id ? string.Empty : "warn")" data-ground="@matter">
                            <span class="sn-say">Over @g.Says <span class="ui-mute">(@g.Record)</span> · @Money.Credits(g.Stake) · @law</span>
                            <Plate Label="Bring it" Small="true" Locked="@(noBring != null)" Disabled="@(noBring != null)" Tip="@bringTip" OnClick="() => AskBring(qid, matter)" data-bring-suit="@matter"><Cost><Icon Name="credits" Tone="brass" Size="14" />@Money.Show(fee) <Icon Name="laurels" Tone="brass" Size="14" />@LadderSystem.BringClout</Cost></Plate>
                        </div>
                    }
                </div>
            </div>
        }
        @if (moreQuarrels > 0) { <div class="sn-more" data-more-quarrels="1"><Link Label="@(_allQuarrels ? "Show fewer" : "Show " + moreQuarrels + " more")" OnClick="() => _allQuarrels = !_allQuarrels" /></div> }
        </ChildContent>
    </Section>
    }

    @if (rulings.Count > 0)
    {
        <Section Title="What the courts ruled" Count="@w.Judgments.Count.ToString()" Info="What the courts have ruled on your house, the latest first." Class="sn-sub-sec">
            <span hidden data-rulings="1"></span>
            @foreach (var r in rulings)
            {
                bool won = r.WinnerId == house.Id; var them = w.House(won ? r.LoserId : r.WinnerId);
                <div class="sn-hist suit court-ruling @(won ? "good" : "warn")"><b class="sn-chip @(won ? "up" : "down")">year @r.Turn</b><span class="sn-hist-t"><b>@(won ? $"{them?.Name} paid you {Money.Credits(r.Sum)}" : $"you paid {them?.Name} {Money.Credits(r.Sum)}")</b><span class="ui-mute">@(r.Matter.Length > 0 ? " over " + r.Matter : "") · @(r.Judge.Length > 0 ? r.Judge + ", praetor: " : "")@r.How</span></span></div>
            }
            @if (w.Judgments.Count > 5) { <div class="sn-more"><Link Label="@(_allRulings ? "Show fewer" : "Show all " + w.Judgments.Count)" OnClick="() => _allRulings = !_allRulings" /></div> }
        </Section>
    }

    <Section Title="On the record" Count="@((charges.Count + more) > 0 ? (charges.Count + more).ToString() : "")" Info="What former magistrates of other houses did and have not answered for. A charge is heard once." Class="sn-sub-sec"
             IsEmpty="@(charges.Count == 0 && !_all)" EmptyIcon="scroll-unfurled" EmptyLine="@($"Nothing stands against anybody who no longer sits. It is kept {LadderSystem.RecordYears} years.")">
        @foreach (var d in charges)
        {
            string did = d.Id; var who = w.Char(d.CharacterId)!; var judge = LadderSystem.Court(w, d, house.Id);
            var no = new ProsecutionCommand(pid, ProsecutionCommand.Prosecute, did, offices).Refusal(G.Ctx);
            string hears = judge == null ? "No praetor of a third house sits to hear it." : "It would come before " + judge.Name + " of " + (w.House(judge.HouseId)?.Name ?? "") + ", who is " + LadderSystem.Verdict(w, d, house.Id, judge).why + ".";
            <div class="sn-ent suit court-charge">
                <span class="sn-pic">@SenateScreen.Face(w, who, "scales")</span>
                <div class="sn-ent-main">
                    <div class="sn-hd"><b class="sn-nm">@who.Name</b><span class="sn-sub">of @(w.House(d.HouseId)?.Name) · @LadderSystem.DeedSays(w, offices, d)</span></div>
                    <div class="sn-tx ui-dim">@hears</div>
                    <div class="sn-acts suit-acts"><Plate Label="Bring the charge" Small="true" Icon="scales" Locked="@(no != null)" Disabled="@(no != null)" Tip="@(no ?? ChargeTip)" CostIcon="public-speaker" CostText="@LadderSystem.ProsecuteInfluence.ToString()" OnClick="() => G.Execute(new ProsecutionCommand(pid, ProsecutionCommand.Prosecute, did, offices))" /></div>
                </div>
            </div>
        }
        @if (more > 0 || _all) { <div class="sn-more"><Link Label="@(_all ? "Show fewer" : "Show " + more + " more")" OnClick="() => _all = !_all" /></div> }
    </Section>

    @if (ours.Count > 0)
    {
        <Section Title="Against your house" Count="@ours.Count.ToString()" Info="Any house that thinks ill enough of yours may bring these, once the one named no longer sits." Class="sn-sub-sec">
            @foreach (var d in ours)
            {
                var who = w.Char(d.CharacterId)!; bool sits = !LadderSystem.ChargedAtOnce(d) && LadderSystem.Seat(w, who.Id)?.OfficeId == d.RungId;
                <div class="ui-row sn-row suit court-ours">
                    <div>@SenateScreen.Face(w, who, "scales")</div>
                    <div class="sn-rmain"><div class="ui-row-nm">@who.Name</div><div class="ui-row-sub sn-wrap">@LadderSystem.DeedSays(w, offices, d) · @(sits ? "still sits, and cannot be touched" : "can be charged") · forgotten in year @(d.Turn + LadderSystem.RecordYears + 1)</div></div>
                    <div class="ui-cols">@if (!sits) { <span class="sn-tag warn">can be charged</span> }</div><div></div>
                </div>
            }
        </Section>
    }

    <Section Title="The bench" Count="@(bench.Count > 0 ? bench.Count.ToString() : "")" Info="A praetor can be offered a sum. One who takes it finds for your house whenever it is before them, while they sit, until it comes out." Class="sn-sub-sec"
             IsEmpty="@(bench.Count == 0)" EmptyIcon="scales" EmptyLine="No praetor of another house sits this year.">
        @foreach (var j in bench)
        {
            string jid = j.Id; var no = new ProsecutionCommand(pid, ProsecutionCommand.Buy, jid, offices).Refusal(G.Ctx); string nature = Nature(j); bool mine = LadderSystem.BoughtBy(w, j) == house.Id;
            string tip = nature == "upright" ? UprightTip : nature == "known to be for sale" ? SaleTip : MaybeTip;
            <div class="ui-row sn-row suit court-bench">
                <div>@SenateScreen.Face(w, j, "scales")</div>
                <div class="sn-rmain"><div class="ui-row-nm">@j.Name</div><div class="ui-row-sub">of @(w.House(j.HouseId)?.Name) · <span class="@(nature == "upright" ? "ui-up" : nature == "known to be for sale" ? "ui-warn-t" : "")">@nature</span></div></div>
                <div class="ui-cols">@if (mine) { <span class="pill small warn sn-tag warn">in your pocket</span> }</div>
                <div>@if (!mine) { <span class="suit-acts"><Plate Label="Offer" Small="true" Locked="@(no != null)" Disabled="@(no != null)" Tip="@(no ?? tip + $" It costs {Money.Credits(LadderSystem.BribeCredits)} of your own.")" CostIcon="credits" CostText="@Money.Show(LadderSystem.BribeCredits)" OnClick="() => G.Execute(new ProsecutionCommand(pid, ProsecutionCommand.Buy, jid, offices))" /></span> }</div>
            </div>
        }
    </Section>
</section>
}

@code {
    private bool _all, _allRulings, _allQuarrels;
    private static string CounterSays(string other, int stake) => "Your own claim on the same matter. What turns on the suit doubles to " + Money.Credits(stake * 2) + ": if you win, " + other + " pays you that, and if you lose you pay it. Terms out of court become " + Money.Show(stake) + ".";
    private static string BringSays(string other, int stake) => "Heard at the end of next year. If you win, " + other + " pays you " + Money.Credits(stake) + "; if you lose, you pay it. Its head thinks the worse of you by " + LadderSystem.BringRegard + ", and may answer with a counter-suit, which doubles what turns on it.";
    private void AskCounter(string suitId, string other, int stake) => G.Ask("Counter-sue " + other + "?",
        "It costs " + Money.Credits(LadderSystem.FeeOf(stake)) + " and " + LadderSystem.CounterClout + " clout now. " + CounterSays(other, stake),
        "Bring the counter-suit", () => G.Execute(new SuitCommand(G.World!.ProtagonistId, SuitCommand.Counter, suitId)), "Leave it");
    private void AskBring(string houseId, string matter)
    {
        var w = G.World!; var mine = w.House(w.Protagonist!.HouseId)!; var them = w.House(houseId); var g = LadderSystem.Grounds(w, mine, them).FirstOrDefault(x => x.Matter == matter); if (them == null || g == null) return;
        var judge = LadderSystem.Bench(w, mine.Id, houseId);
        G.Ask("Bring a suit against " + them.Name + "?",
            "Over " + g.Says + " (" + g.Record + "). " + Money.Credits(g.Stake) + " turn on it, and the loser pays it. " + LadderSystem.LawOn(g, mine.Id) + " " + (judge != null ? judge.Name + ", praetor, who is " + LadderSystem.NatureOf(judge) + ", hears it at the end of next year. " : string.Empty)
            + "It costs " + Money.Credits(LadderSystem.FeeOf(g.Stake)) + " and " + LadderSystem.BringClout + " clout now. " + them.Name + " may answer with a counter-suit, which doubles what turns on it.",
            "Bring the suit", () => G.Execute(new BringSuitCommand(G.World!.ProtagonistId, houseId, matter, G.Content!.Offices)), "Not this year");
    }
    private void AskAdmit(string chargeId, string who) => G.Ask("Admit the charge against " + who + "?",
        "The house pays the fine of " + Money.Credits(LadderSystem.FineCredits) + " now and loses " + LadderSystem.AdmitLegitimacy + " legitimacy. It is not heard: " + who + " keeps what they hold and may stand. A conviction would cost " + LadderSystem.ConvictLegitimacy + " legitimacy, " + LadderSystem.BarYears + " years out of office and votes at every count for " + LadderSystem.ScandalYears + " years.",
        "Admit it, and pay", () => G.Execute(new ChargeCommand(G.World!.ProtagonistId, ChargeCommand.Admit, chargeId, G.Content!.Offices)), "Let it be heard");
    private void AskSettle(string suitId, bool forUs, string other, int half) => G.Ask(forUs ? "Take terms from " + other + "?" : "Come to terms with " + other + "?",
        forUs ? other + " pays you " + Money.Credits(half) + " now and the suit is withdrawn. A ruling on the law would have paid twice that, if the praetor ruled on the law." : "You pay " + other + " " + Money.Credits(half) + " now and the suit is withdrawn. A ruling on the law would cost twice that.",
        forUs ? "Take the terms" : "Pay, and end it", () => G.Execute(new SuitCommand(G.World!.ProtagonistId, SuitCommand.Settle, suitId)), "Let it be heard");
    private const string Intro = "A magistrate cannot be touched while they sit. When the term is over, what they took is still on the record, and any house may bring it before a sitting praetor. The verdict is that praetor's.";
    private const string ChargeTip = "If it is proved they may not stand for five years, their house pays and is thought the less of, and yours the better. If they are let go, your house looks the worse for bringing it. Either way their house will not forgive you.";
    private const string UprightTip = "Upright. They would refuse, and say in open court what you offered: your house would lose standing and its candidates votes.";
    private const string SaleTip = "Known to be for sale. They would take it. A bought ruling comes out one time in three, and you fall with them.";
    private const string MaybeTip = "They might take it, if they do not think ill of you. If they do not, they say nothing and think the less of you.";
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;
}
