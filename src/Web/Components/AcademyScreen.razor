@inject GameClient G
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var p = w.Protagonist!; var house = w.House(p.HouseId)!;
    var cohort = w.LivingCharacters().Where(x => x.Id != pid && Math.Abs(x.Age - p.Age) <= 4 && x.Age >= 14 && x.Age <= 26).OrderByDescending(x => x.Skills.Values.Sum()).ThenBy(x => x.Id, StringComparer.Ordinal).Take(12).ToList();
    var instructor = w.LivingCharacters().Where(x => x.Id != pid && x.CareerTrack == "military" && x.Age >= 40).OrderByDescending(x => x.CareerRank).ThenBy(x => x.Id, StringComparer.Ordinal).FirstOrDefault();
    int standing = w.Counter("standing");
    var record = w.History.Where(h => h.EventId != null && c.Events.FirstOrDefault(e => e.Id == h.EventId) is { } ev && IsAcademy(ev.Id)).Reverse().Take(12).ToList();
    var marks = p.Flags.Where(f => !f.StartsWith("background:") && !f.StartsWith("honor:")).OrderBy(f => f, StringComparer.Ordinal).ToList();
    int mySum = p.Skills.Values.Sum(); int place = 1 + cohort.Count(k => k.Skills.Values.Sum() > mySum);
    var fc = _focus != null ? w.Char(_focus) : null;
}
<div class="dash academy" style="--accent:@house.AccentColor">
    <header class="dash-head">
        <div class="dh-title"><Icon Name="military" Size="18" /> <b>The Academy of the Reach</b> <span class="muted">cadet @p.Name, @p.Age · @(c.Careers.ById(p.CareerTrack)?.Name ?? p.CareerTrack) · @(c.Careers.RankName(p.CareerTrack, p.CareerRank) ?? "")</span></div>
        <div class="dh-stats">
            <div class="stat @(standing < 0 ? "warn" : "")"><span>Standing</span><b>@(standing >= 0 ? "+" : "")@standing</b></div>
            <div class="stat"><span>Place in the cohort</span><b>@place <i class="muted">of @(cohort.Count + 1) by skill</i></b></div>
            <div class="stat @(p.Stress >= 70 ? "warn" : "")"><span>Stress</span><b>@p.Stress</b></div>
            <div class="stat"><span>Instructor</span><b>@(instructor?.Name ?? "none")</b></div>
            <div class="stat"><span>Feuds</span><b>@cohort.Count(k => k.Flags.Contains("feud"))</b></div>
        </div>
    </header>
    <div class="dash-grid academy-grid">
        <section class="panel">
            <h3><Icon Name="you" Size="13" /> The cohort <span class="muted">cadets of your year, by skill · click one</span></h3>
            <table class="standings">
                <thead><tr><th>Cadet</th><th>House</th><th>Skill</th><th>Best at</th><th>Toward you</th><th>Marks</th></tr></thead>
                <tbody>
                @foreach (var k in cohort.Prepend(p).OrderByDescending(x => x.Skills.Values.Sum()).ThenBy(x => x.Id, StringComparer.Ordinal))
                {
                    var kh = w.House(k.HouseId)!; var rel = w.GetRelationship(k.Id, pid); int d = rel?.Disposition ?? 0; int sum = k.Skills.Values.Sum(); int maxSum = Math.Max(1, cohort.Prepend(p).Max(x => x.Skills.Values.Sum()));
                    <tr class="@(k.Id == pid ? "mine" : "") @(k.Id == _focus ? "here" : "")" @onclick="() => _focus = k.Id">
                        <td class="hn"><Portrait Id="@k.Id" Name="@k.Name" Sex="@k.Sex" Age="@k.Age" Accent="@kh.AccentColor" Size="22" /> <b>@k.Name</b> <span class="muted small">@k.Age</span></td>
                        <td class="muted small"><Sigil HouseId="@kh.Id" Accent="@kh.AccentColor" Size="12" /> @kh.Name</td>
                        <td><span class="mbar"><i style="width:@(100 * sum / maxSum)%; background:@kh.AccentColor"></i></span>@sum</td>
                        <td class="muted small">@string.Join(", ", k.Skills.Where(s => s.Value > 0).OrderByDescending(s => s.Value).Take(2).Select(s => $"{s.Key} {s.Value}"))</td>
                        <td>@if (k.Id != pid) { <span class="pill @(d < -20 ? "warn" : d > 20 ? "good" : "")">@(d >= 0 ? "+" : "")@d@(rel?.Bond is { } b && b != BondType.None ? $" · {b.ToString().ToLowerInvariant()}" : "")</span> }</td>
                        <td>@foreach (var f in k.Flags.Where(f => f is "feud" or "humiliated" or "wounded" or "framed" or "owes_you" or "reconciled" or "marked_for_death" or "sabotaged")) { <span class="pill small warn">@f.Replace('_', ' ')</span> }</td>
                    </tr>
                }
                </tbody>
            </table>
            @if (cohort.Count == 0) { <div class="muted">No cadets of your year.</div> }
        </section>
        <aside class="dash-side">
            @if (fc != null)
            {
                var fh = w.House(fc.HouseId)!; var rel = w.GetRelationship(fc.Id, pid); int d = rel?.Disposition ?? 0; var cn = m.Connections.FirstOrDefault(x => x.Id == fc.Id);
                <section class="panel">
                    <div class="seat-card">
                        <Portrait Id="@fc.Id" Name="@fc.Name" Sex="@fc.Sex" Age="@fc.Age" Accent="@fh.AccentColor" Size="56" />
                        <div class="sc-body">
                            <div class="sc-name">@fc.Name <span class="muted">@(c.Careers.RankName(fc.CareerTrack, fc.CareerRank) ?? "") of @fh.Name · @fc.Age</span></div>
                            @if (fc.Id != pid) { <div class="muted small"><span class="@(d < -20 ? "warn" : d > 20 ? "good" : "")">@(d >= 0 ? "+" : "")@d toward you</span>@(rel?.Bond is { } b && b != BondType.None ? $" · {b.ToString().ToLowerInvariant()}" : "")</div> }
                            <div class="muted small">@string.Join(" · ", fc.Skills.Where(k => k.Value > 0).OrderByDescending(k => k.Value).Take(4).Select(k => $"{k.Key} {k.Value}"))@(fc.NatureTraits.Count > 0 ? " · " + string.Join(", ", fc.NatureTraits) : "")</div>
                            @if (cn != null) { <div class="sc-actions">@foreach (var o in cn.Actions) { <button class="opt inline tiny" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(Conn(o.Id, cn.Id))">@o.Label</button> }</div> }
                        </div>
                        <button class="win-close" @onclick="() => _focus = null">✕</button>
                    </div>
                </section>
            }
            <section class="panel">
                <h3><Icon Name="honor" Size="13" /> Your record</h3>
                <div class="gauge" title="standing in the cohort, −5 to +5"><span>Standing</span><i><b style="width:@Math.Min(100, Math.Max(0, 50 + standing * 10))%" class="@(standing < 0 ? "low" : "")"></b><u style="left:50%"></u></i><em>@(standing >= 0 ? "+" : "")@standing</em></div>
                <div class="gauge" title="stress"><span>Stress</span><i><b style="width:@p.Stress%" class="@(p.Stress >= 70 ? "low" : "")"></b></i><em>@p.Stress</em></div>
                @foreach (var sk in p.Skills.Where(k => k.Value > 0).OrderByDescending(k => k.Value)) { <div class="gauge"><span>@sk.Key</span><i><b style="width:@(Math.Min(100, sk.Value * 20))%" class="high"></b></i><em>@sk.Value</em></div> }
                @if (marks.Count > 0) { <div class="chips">@foreach (var f in marks) { <span class="pill small">@f.Replace('_', ' ')</span> }</div> }
                <div class="muted small">Standing rises when you win the trials and falls when you are humbled; it decides who petitions you and who sneers.</div>
                @if (instructor != null) { <div class="person" @onclick="() => _focus = instructor.Id"><Portrait Id="@instructor.Id" Name="@instructor.Name" Sex="@instructor.Sex" Age="@instructor.Age" Accent="@(w.House(instructor.HouseId)?.AccentColor ?? "#888")" Size="26" /><span><b>@instructor.Name</b> <span class="muted">instructor · @(c.Careers.RankName(instructor.CareerTrack, instructor.CareerRank) ?? "") of @(w.House(instructor.HouseId)?.Name)</span></span></div> }
            </section>
            <section class="panel">
                <h3><Icon Name="chronicle" Size="13" /> The year so far</h3>
                @if (record.Count == 0) { <div class="muted">The first morning has not yet come.</div> }
                @foreach (var h in record) { <div class="line small"><span class="muted">T@(h.Turn)</span> @h.Text</div> }
            </section>
        </aside>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    private string? _focus;
    private static bool IsAcademy(string id) => id is "first_formation" or "barracks_slight" or "the_reckoning" or "the_petitioner" or "the_humiliated_returns" or "the_wounded_mercy" or "the_frame_unravels" or "the_oath" or "the_blooding" or "the_instructors_eye" or "mess_hall" or "the_deciding_trial" or "the_sabotage" or "the_proctors_offer" or "the_letter_home" or "the_marked_man" or "night_watch_lapse" || id.Contains("drill") || id.Contains("trial");
    private ICommand Conn(string optionId, string targetId) { var pid = G.World!.ProtagonistId; var c = G.Content!; return optionId.StartsWith("marry:") ? new ProposeMarriageCommand(pid, optionId["marry:".Length..], targetId, c.Titles) : new AssassinateCommand(pid, targetId, c.Friction); }
}
