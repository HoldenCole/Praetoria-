@inject GameClient G
@inject IJSRuntime JS
@implements IAsyncDisposable
@{
    var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var playerHouse = w.Protagonist!.HouseId;
    var nodes = GalaxyProjection.Nodes(w); var fleets = GalaxyProjection.Fleets(w); var regions = GalaxyProjection.Regions(w);
    var pos = nodes.ToDictionary(n => n.SystemId, n => n);
    var selectedFleet = _fleetId != null && w.Fleets.TryGetValue(_fleetId, out var sf) && sf.OwnerId == playerHouse ? sf : null;
    var ctx = new CommandContext(w, new Praetoria.Core.Rng.SplitMix64Rng(0));
    var sel = _systemId != null && pos.TryGetValue(_systemId, out var sn) ? sn : null;
    _pendingModel = BuildModel(w, c, nodes, fleets, regions, selectedFleet, ctx);
}
<div class="galaxy">
    <div class="map-wrap">
        <div class="gl-host" @ref="_host"></div>
        <div class="map-tools">
            <button class="btn sm" @onclick='() => JS.InvokeVoidAsync("praetoriaSpace.zoom", _id, 0.8)' title="Zoom in">+</button>
            <button class="btn sm" @onclick='() => JS.InvokeVoidAsync("praetoriaSpace.zoom", _id, 1.25)' title="Zoom out">−</button>
            <button class="btn sm" @onclick='() => JS.InvokeVoidAsync("praetoriaSpace.home", _id)' title="Fit the Reach">⌂</button>
        </div>
        <div class="legend">
            <span><i class="sw own"></i> your fleet</span><span><i class="sw intel"></i> reported fleet (fainter = less certain)</span>
            <span><i class="sw siege"></i> siege clock</span><span><i class="sw front"></i> front line</span><span><i class="sw station"></i> station</span> <span class="lg"><i class="sw ck"></i> chokepoint</span>
            @if (selectedFleet != null) { <span class="hint">@selectedFleet.Name selected — click a ringed world to set course (1 treasury)</span> }
            else { <span class="muted">drag to pan · wheel to zoom · click a world or a fleet</span> }
        </div>
    </div>

    <aside class="map-side">
        @if (sel != null)
        {
            var sys = w.Galaxy!.System(sel.SystemId)!; var region = w.Galaxy.Region(sys.RegionId);
            var planet = sel.PlanetHoldingId != null ? w.Holding(sel.PlanetHoldingId) : null;
            var owner = sel.OwnerHouseId != null ? w.House(sel.OwnerHouseId) : null;
            var gov = planet != null && planet.GovernorId.Length > 0 ? w.Char(planet.GovernorId) : null;
            var stations = w.Holdings.Values.Where(h => h.SystemId == sel.SystemId && !h.IsPlanet).OrderBy(h => h.Id, StringComparer.Ordinal).ToList();
            <section class="panel planet-card">
                <div class="planet-hero vista vista-@sel.PlanetClass"><img class="planet-sprite" data-planet="@sel.PlanetClass|@sel.SystemId|160" alt="" /><div class="hero-fade"></div></div>
                <div class="planet-head">
                    <div>
                        <h2>@sel.Name</h2>
                        <div class="muted">@sel.PlanetClass world · @region?.Name <span class="ring @sel.Ring">@sel.Ring</span> · @sel.Culture culture@(sel.Capital ? " · THE CAPITAL" : "")</div>
                    </div>
                    @if (owner != null) { <Sigil HouseId="@owner.Id" Accent="@owner.AccentColor" Size="36" /> }
                </div>
                <p class="muted small">@sys.Description</p>
                <div class="bodies">@foreach (var b in sys.Bodies) { <span class="body @(b.IsPrimary ? "primary" : "")" title="@b.Class"><img class="sprite" data-planet="@b.Class|@(sys.Id)_@(b.Name)|@(b.IsPrimary ? 40 : 20 + b.Size * 6)" alt="" /><span>@b.Name</span></span> }</div>
                <div class="kv"><span>Lanes</span><b>@sel.Lanes@(sel.Chokepoint ? " · CHOKEPOINT" : "")</b></div>
                @if (sel.Chokepoint) { <div class="muted small">A key system on the lanes: its holder takes tolls (+@Economy.TollCredits credits a turn), and an enemy fleet cannot pass through while a fleet of the holder's sits here.</div> }
                @if (planet != null)
                {
                    var spec = c.Holdings.Spec(planet.Specialization);
                    <div class="kv"><span>Held by</span><b>@(owner?.Name ?? "no one")</b></div>
                    <div class="kv"><span>Governor</span><b>@(gov?.Name ?? "—")</b></div>
                    @if (gov != null) { <div class="gov-line"><Portrait Id="@gov.Id" Name="@gov.Name" Sex="@gov.Sex" Age="@gov.Age" Accent="@(owner?.AccentColor ?? "#888")" Size="44" /><span class="muted">@(c.Careers.RankName(gov.CareerTrack, gov.CareerRank) ?? "") · administration @gov.Skill("administration") · @gov.Age</span></div> }
                    <div class="kv"><span>Industry</span><b>@(spec?.Name ?? planet.Specialization)</b></div>
                    @if (planet.Population > 0) { <div class="kv"><span>Population</span><b>@planet.Population@(spec?.MaxPopulation > 0 ? $" / {spec.MaxPopulation}" : "")</b></div> }
                    <div class="kv"><span>Loyalty</span><b class="@(planet.Unrest >= 50 ? "warn" : "")">@(100 - planet.Unrest)<span class="bar"><i style="width:@(100 - planet.Unrest)%"></i></span></b></div>
                    <div class="kv"><span>Built</span><b>@(planet.Buildings.Count == 0 ? "nothing" : string.Join(", ", planet.Buildings.Select(b => c.Holdings.Building(b)?.Name ?? b)))</b></div>
                    @if (w.Sieges.TryGetValue(planet.Id, out var sg)) { <div class="kv warn"><span>Siege</span><b>@(w.House(sg.BesiegerId)?.Name) · @sg.Turns/@sg.Required</b></div> }
                    @if (planet.InRebellion) { <div class="kv warn"><span>Rising</span><b>in revolt for @planet.Rebellion turn(s) · breaks away after @RegionSystem.SecessionTurns</b></div> }
                    var rstate = RegionSystem.StateOf(w, sys.RegionId);
                    <div class="kv"><span>Region</span><b>allegiance @rstate.Allegiance · <span class="@(rstate.Lawlessness >= 60 ? "warn" : "")">lawlessness @rstate.Lawlessness</span></b></div>
                }
                else { <div class="muted">No one holds this world.</div> }
                @if (stations.Count > 0)
                {
                    <h4>In orbit</h4>
                    @foreach (var st in stations) { <div class="line"><b>@st.Name</b> <span class="muted">@(c.Holdings.Spec(st.Specialization)?.Name ?? st.Specialization) · @(w.House(st.OwnerId)?.Name)</span></div> }
                }
                @{ var here = fleets.Where(f => f.SystemId == sel.SystemId).ToList(); }
                @if (here.Count > 0)
                {
                    <h4>Fleets here</h4>
                    @foreach (var f in here) { <div class="fleet-line" @onclick="() => ClickFleet(f)"><i class="sw" style="background:@f.AccentColor"></i> <b>@f.Name</b> <span class="muted">@f.OwnerHouseName · @f.Strength hulls@(f.IsPlayer ? $" · readiness {f.Readiness}" : $" · intel {f.Confidence}%")</span></div> }
                }
                <div class="muted small">Lanes to @string.Join(", ", w.Galaxy.Neighbors(sel.SystemId).Select(id => w.Galaxy.System(id)?.Name ?? id))</div>
                @if (owner != null && owner.Id != playerHouse)
                {
                    var dw = new DeclareWarCommand(pid, owner.Id, c.Fleets);
                    <button class="opt" disabled="@(!dw.CanExecute(ctx))" title="@(dw.CanExecute(ctx) ? "" : "already at war, or no influence")" @onclick="() => G.Execute(new DeclareWarCommand(pid, owner.Id, c.Fleets))">Declare war on @owner.Name (2 influence)</button>
                }
            </section>
        }
        else
        {
            <section class="panel"><h2>@w.Galaxy!.Name</h2><div class="muted">@regions.Count regions · @nodes.Count worlds · @w.Houses.Count houses. Click a world or a fleet. Click one of your fleets, then a ringed world, to set its course.</div></section>
            <section class="panel">
                <h3>Regions</h3>
                @foreach (var ring in new[] { "core", "middle", "rim" })
                {
                    <div class="ring-head"><span class="ring @ring">@ring</span> <span class="muted small">@(ring == "core" ? "commerce and the court" : ring == "rim" ? "lawless, restless, breaking away" : "leaning either way")</span></div>
                    @foreach (var r in regions.Where(x => x.Ring == ring)) { <button class="ol-row region-row @(r.FreeMarch ? "free" : "")" @onclick="() => Focus(r.CX, r.CY)"><i class="sw" style="background:@r.AccentColor"></i> <b>@r.Name</b> <span class="muted">@(r.DominantHouseName ?? "contested")@(r.FreeMarch ? " · FREE MARCH" : "") · loyalty @(100 - r.Unrest)</span><span class="rstats"><span title="allegiance to the capital">⚜ @r.Allegiance</span> <span class="@(r.Lawlessness >= 60 ? "warn" : "")" title="lawlessness">☠ @r.Lawlessness</span>@(r.Rebellions > 0 ? $" ✦ {r.Rebellions} rising" : "")</span></button> }
                }
            </section>
        }
        <section class="panel">
            <h3>Your fleets</h3>
            @foreach (var f in fleets.Where(f => f.IsPlayer))
            {
                <div class="fleet-line @(f.FleetId == _fleetId ? "selected" : "")" @onclick="() => ClickFleet(f)"><b>@f.Name</b> <span class="muted">@(pos.TryGetValue(f.SystemId, out var at) ? at.Name : f.SystemId)@(f.Moving ? $" → {(pos.TryGetValue(f.DestinationId, out var d2) ? d2.Name : f.DestinationId)} ({f.Eta})" : "") · @f.Strength hulls · readiness @f.Readiness</span></div>
            }
            @if (!fleets.Any(f => f.IsPlayer)) { <div class="muted">No hull flies your colours. Lay one down (House → Holdings → Shipyard).</div> }
        </section>
    </aside>
</div>

@code {
    private string? _fleetId, _systemId; private ElementReference _host; private readonly string _id = Guid.NewGuid().ToString("N");
    private DotNetObjectReference<GalaxyMap>? _self; private bool _created; private string _pendingModel = "";
    private string _lastSent = "";

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            _self = DotNetObjectReference.Create(this);
            try { if (await JS.InvokeAsync<bool>("praetoria.ready", "praetoriaSpace")) { await JS.InvokeVoidAsync("praetoriaSpace.create", _id, _host, _self); _created = true; } } catch { }
        }
        if (_created && _pendingModel != _lastSent) { _lastSent = _pendingModel; try { await JS.InvokeVoidAsync("praetoriaSpace.setModel", _id, _pendingModel); } catch { } }
        try { await JS.InvokeVoidAsync("praetoriaFx.paint"); await JS.InvokeVoidAsync("praetoriaBust.paint"); } catch { }
    }

    [JSInvokable]
    public void OnPick(string kind, string id)
    {
        var w = G.World!;
        if (kind == "system")
        {
            if (_fleetId != null && w.Fleets.TryGetValue(_fleetId, out var f) && f.OwnerId == w.Protagonist!.HouseId && new MoveFleetCommand(w.ProtagonistId, _fleetId, id, G.Content!.Fleets).CanExecute(new CommandContext(w, new Praetoria.Core.Rng.SplitMix64Rng(0))))
            { G.Execute(new MoveFleetCommand(w.ProtagonistId, _fleetId, id, G.Content!.Fleets)); _fleetId = null; }
            _systemId = id;
        }
        else if (kind == "fleet") { if (w.Fleets.TryGetValue(id, out var f)) { if (f.OwnerId == w.Protagonist!.HouseId) _fleetId = _fleetId == id ? null : id; _systemId = f.SystemId; } }
        else { _fleetId = null; }
        StateHasChanged();
    }

    private void ClickFleet(MapFleet f) { if (f.IsPlayer) { _fleetId = _fleetId == f.FleetId ? null : f.FleetId; } _systemId = f.SystemId; }
    private async Task Focus(double x, double y) { try { await JS.InvokeVoidAsync("praetoriaSpace.focus", _id, x, y); } catch { } }

    private string BuildModel(World w, ContentDatabase c, IReadOnlyList<MapNode> nodes, IReadOnlyList<MapFleet> fleets, IReadOnlyList<MapRegion> regions, Fleet? selectedFleet, CommandContext ctx)
    {
        var pid = w.ProtagonistId;
        var systems = nodes.Select(n =>
        {
            var owner = n.OwnerHouseId != null ? w.House(n.OwnerHouseId) : null;
            var siege = w.Sieges.Values.FirstOrDefault(s => w.Holding(s.HoldingId)?.SystemId == n.SystemId);
            int target = selectedFleet != null && new MoveFleetCommand(pid, selectedFleet.Id, n.SystemId, c.Fleets).CanExecute(ctx) ? w.Galaxy!.Hops(selectedFleet.SystemId, n.SystemId) : 0;
            return new { id = n.SystemId, name = n.Name, x = n.X, y = n.Y, ownerId = n.OwnerHouseId, ownerName = n.OwnerHouseName, accent = n.AccentColor, isPlayer = n.IsPlayerTerritory, contested = n.Contested,
                planetClass = n.PlanetClass, pop = n.Population, unrest = n.Unrest, stations = n.Stations, regionId = n.RegionId, governor = n.GovernorName, rebel = n.Rebellion > 0, capital = n.Capital, ring = n.Ring, chokepoint = n.Chokepoint,
                bodies = (n.Bodies ?? Array.Empty<Body>()).Select(b => new { name = b.Name, cls = b.Class, size = b.Size, primary = b.IsPrimary }).ToList(),
                industry = n.PlanetHoldingId != null ? c.Holdings.Spec(w.Holding(n.PlanetHoldingId)!.Specialization)?.Name : null,
                siege = siege != null ? (double?)Math.Clamp(siege.Turns / (double)Math.Max(1, siege.Required), 0, 1) : null,
                bloc = owner != null && owner.Bloc.Length > 0 ? (owner.Bloc == GreatCrisisSystem.HegemonBloc ? "hegemon" : "alliance") : null, target };
        }).ToList();
        var lanes = GalaxyProjection.Lanes(w).Select(l =>
        {
            var a = nodes.First(n => n.SystemId == l.A); var b = nodes.First(n => n.SystemId == l.B);
            bool front = a.OwnerHouseId != null && b.OwnerHouseId != null && w.AtWar(a.OwnerHouseId, b.OwnerHouseId);
            bool reach = selectedFleet != null && (selectedFleet.SystemId == l.A || selectedFleet.SystemId == l.B);
            return new { a = l.A, b = l.B, front, reach };
        }).ToList();
        var fl = fleets.Select(f => new { id = f.FleetId, name = f.Name, ownerId = f.OwnerHouseId, ownerName = f.OwnerHouseName, accent = f.AccentColor, systemId = f.SystemId, strength = f.Strength, readiness = f.Readiness, isPlayer = f.IsPlayer, moving = f.Moving, destId = f.DestinationId, eta = f.Eta, confidence = f.Confidence }).ToList();
        var rg = regions.Select(r => new { id = r.Id, name = r.Name, culture = r.Culture, cx = r.CX, cy = r.CY, top = r.SystemIds.Select(id => nodes.First(n => n.SystemId == id).Y).Min(), bottom = r.SystemIds.Select(id => nodes.First(n => n.SystemId == id).Y).Max(), accent = r.AccentColor, dominant = r.DominantHouseName, loyalty = 100 - r.Unrest, ring = r.Ring, allegiance = r.Allegiance, lawlessness = r.Lawlessness, free = r.FreeMarch }).ToList();
        var rings = GalaxyProjection.Rings(w);
        return System.Text.Json.JsonSerializer.Serialize(new { systems, lanes, fleets = fl, regions = rg, rings = rings == null ? null : new { cx = rings.CX, cy = rings.CY, core = rings.Core, middle = rings.Middle, rim = rings.Rim }, playerHouse = w.Protagonist!.HouseId, selected = new { systemId = _systemId, fleetId = _fleetId } });
    }

    public async ValueTask DisposeAsync() { try { if (_created) await JS.InvokeVoidAsync("praetoriaSpace.destroy", _id); } catch { } _self?.Dispose(); }
}
