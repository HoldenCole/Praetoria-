@inject GameClient G
@inject IJSRuntime JS
@implements IAsyncDisposable
@{
    var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var playerHouse = w.Protagonist!.HouseId;
    var nodes = GalaxyProjection.Nodes(w); var fleets = GalaxyProjection.Fleets(w); var regions = GalaxyProjection.Regions(w);
    var pos = nodes.ToDictionary(n => n.SystemId, n => n);
    var selectedFleet = _fleetId != null && w.Fleets.TryGetValue(_fleetId, out var sf) && sf.OwnerId == playerHouse ? sf : null;
    var ctx = new CommandContext(w, new Praetoria.Core.Rng.SplitMix64Rng(0));
    var sel = _systemId != null && pos.TryGetValue(_systemId, out var sn) ? sn : null;
    _pendingModel = BuildModel(w, c, nodes, fleets, regions, selectedFleet, ctx);
}
<div class="galaxy">
    <div class="map-wrap">
        <div class="gl-host" @ref="_host"></div>
        <canvas class="minimap" @ref="_minimap" width="220" height="132" title="the whole Reach · click to travel"></canvas>
        @if (selectedFleet != null)
        {
            var here = pos.TryGetValue(selectedFleet.SystemId, out var hn) ? hn.Name : selectedFleet.SystemId;
            var move = sel != null && sel.SystemId != selectedFleet.SystemId ? new MoveFleetCommand(pid, selectedFleet.Id, sel.SystemId, c.Fleets) : null;
            string? no = move?.Refusal(ctx); int jumps = move != null && no == null ? w.Galaxy!.Hops(selectedFleet.SystemId, sel!.SystemId, MoveFleetCommand.Barred(w, selectedFleet.OwnerId)) : 0;
            var odds = move != null && no == null ? G.Turn!.Fleets.OddsAt(w, playerHouse, new[] { selectedFleet }, sel!.SystemId) : null;
            <div class="order-bar" data-order="@selectedFleet.Id">
                <div><b>⚑ @selectedFleet.Name</b> is picked: @selectedFleet.Strength hull(s) @(selectedFleet.Moving ? "under way" : "at " + here).
                    @if (selectedFleet.Moving) { <span>It is bound for @(pos.TryGetValue(selectedFleet.DestinationId, out var dn) ? dn.Name : selectedFleet.DestinationId), @selectedFleet.Eta year(s) off.</span> }
                    else if (move == null) { <span class="muted">Click a world to see the way there. Nothing is ordered until you say so.</span> }
                    else if (no != null) { <span class="bad">It cannot be sent to @sel!.Name: @no.</span> }
                    else { <span>To @sel!.Name: @jumps jump(s), there in @jumps year(s). @(odds != null ? Praetoria.Core.Systems.FleetSystem.Say(odds) : "No enemy fleet is known to be there.")</span>
                        @if (w.Fleets.TryGetValue(selectedFleet.Id, out var going)) { <span class="@(G.Turn!.Fleets.InSupply(w, playerHouse, sel.SystemId) ? "muted" : "warn")" data-supply-forecast="1"> @G.Turn!.Fleets.SupplySays(w, going, sel.SystemId)</span> } }
                </div>
                <div class="order-row">
                    @if (move != null && no == null) { <button class="btn primary sm" data-send="1" @onclick="() => Send(selectedFleet.Id, sel!.SystemId, jumps)">Send it to @sel!.Name (1 treasury action)</button> }
                    @if (selectedFleet.Moving) { var rc = new RecallFleetCommand(pid, selectedFleet.Id); var why = rc.Refusal(ctx); int back = RecallFleetCommand.YearsBack(selectedFleet);
                        <button class="btn sm" data-recall="1" disabled="@(why != null)" title="@(why ?? (back == 0 ? "The order was given this year: it is struck out and the fleet stays" : $"It has sailed {back} year(s): it takes as long to come back"))" @onclick="() => G.Execute(rc)">@(back == 0 ? "Strike out the order" : $"Call it back ({back} yr)")</button> }
                    <button class="btn ghost sm" data-deselect="1" @onclick="() => _fleetId = null">Let it be</button>
                </div>
            </div>
        }
        <div class="map-tools">
            <button class="btn sm" @onclick='() => JS.InvokeVoidAsync("praetoriaSpace.zoom", _id, 0.8)' title="Zoom in">+</button>
            <button class="btn sm" @onclick='() => JS.InvokeVoidAsync("praetoriaSpace.zoom", _id, 1.25)' title="Zoom out">−</button>
            <button class="btn sm" @onclick='() => JS.InvokeVoidAsync("praetoriaSpace.home", _id)' title="Back to your seat">⌂</button>
            <button class="btn sm" @onclick='() => JS.InvokeVoidAsync("praetoriaSpace.fit", _id)' title="Fit the whole Reach">▣</button>
            <button class="btn sm" @onclick="() => { _regions = !_regions; _systemId = null; }" title="The regions of the Reach">☰</button>
        </div>
        <div class="legend">
            <span><i class="sw own"></i> your fleet</span><span><i class="sw intel"></i> reported fleet (fainter = less certain)</span>
            <span title="Every held world is a cell in its holder's colour, with a dark line between cells and a wider one where two holders meet. A pale ring is a world nobody holds. A pale line is a region's edge."><i class="sw cell"></i> a holder's colour · <i class="sw free"></i> nobody's</span>
            <span title="A bright line is where a realm ends. Your own realm's border is gold. The land of another realm is hatched in its colour."><i class="sw realm-own"></i> your realm's border · <i class="sw realm-other"></i> another realm</span><span><i class="sw siege"></i> siege clock</span><span><i class="sw front"></i> front line</span><span><i class="sw station"></i> station</span><span><i class="sw raid"></i> raiders</span> <span class="lg" title="A world of the Reach's that a nation has taken or been ceded, or a world of a nation's that a house of the Reach holds: a broken ring in the holder's colour. It can be taken back."><i class="sw conq"></i> conquered</span> <span class="lg"><i class="sw ck"></i> chokepoint</span><span class="lg" title="³He helium-3 · RE rare earths · Iso isotopes"><i class="sw dep">³He</i> deposits</span>
            @if (selectedFleet != null) { <span class="hint">@selectedFleet.Name selected: click a ringed world to see the route, then give the order in the bar above</span> }
            else { <span class="muted">drag to pan · wheel to zoom · click a world or a fleet</span> }
        </div>
    </div>

    <aside class="map-side @(sel == null && !_regions ? "idle" : "")">
        <header class="win-bar"><h2>@(sel != null ? "System" : "The Reach")</h2><button class="win-x" @onclick="() => { _systemId = null; _regions = false; }" title="Close" aria-label="Close">×</button></header>
        <div class="win-body">
        @if (sel != null)
        {
            var sys = w.Galaxy!.System(sel.SystemId)!; var region = w.Galaxy.Region(sys.RegionId);
            var planet = sel.PlanetHoldingId != null ? w.Holding(sel.PlanetHoldingId) : null;
            var owner = sel.OwnerHouseId != null ? w.House(sel.OwnerHouseId) : null;
            var gov = planet != null && planet.GovernorId.Length > 0 ? w.Char(planet.GovernorId) : null;
            var stations = w.Holdings.Values.Where(h => h.SystemId == sel.SystemId && !h.IsPlanet).OrderBy(h => h.Id, StringComparer.Ordinal).ToList();
            <section class="panel planet-card">
                <div class="planet-hero vista vista-@sel.PlanetClass"><img class="planet-sprite" data-planet="@sel.PlanetClass|@sel.SystemId|160" alt="" /><div class="hero-fade"></div></div>
                <div class="planet-head">
                    <div>
                        <h2>@sel.Name</h2>
                        <div class="muted">@sel.PlanetClass world · @region?.Name <span class="ring @sel.Ring">@sel.Ring</span> · @sel.Culture culture@(sel.Capital ? " · THE CAPITAL" : "")@if (sel.PlanetHoldingId != null && w.Holding(sel.PlanetHoldingId) is { Population: > 0 } hw0) { <span data-head-citizens="@Census.Citizens(w, hw0)" title="@CitizensTip(w, hw0, c.Holdings.Spec(hw0.Specialization)?.MaxPopulation ?? 0)"> · @Census.Say(Census.Citizens(w, hw0)) citizens</span> }</div>
                        @if (sel.PlanetHoldingId != null && w.Holding(sel.PlanetHoldingId) is { } hwg) { foreach (var gp in hwg.Provinces) { if (CitySystem.KindOf(c.Holdings, gp) is { Great: true } gk) { <div class="great-city" data-great="@gk.Id" title="@($"{gk.What} {CitySystem.Says(gk)}.")">★ @gp.City, @gk.Name</div> } } }
                    </div>
                    @if (owner != null) { <Sigil HouseId="@owner.Id" Accent="@owner.AccentColor" Size="36" /> }
                </div>
                <p class="muted small">@sys.Description</p>
                @{ int laid = w.Infrastructure.TryGetValue(sys.Id, out var lvls) ? lvls.Values.Sum() : 0; }
                @{ int built = SystemWorks.In(w, sys.Id).Count() + (planet?.Buildings.Count ?? 0), rising = w.Projects.Count(p => (p.Kind == Project.Work && SystemWorks.Parse(p.TargetId).systemId == sys.Id) || (p.Kind == Project.Colony && p.TargetId == sys.Id)); }
                <div class="cw-tabs sys-tabs">
                    <button class="rung @(_sideTab == "system" ? "here" : "")" @onclick='() => _sideTab = "system"'>The system@(built > 0 ? $" · {built} built" : "")@(rising > 0 ? $" · {rising} rising" : "")</button>
                    <button class="rung @(_sideTab == "infra" ? "here" : "")" @onclick='() => _sideTab = "infra"'>Infrastructure@(laid > 0 ? $" · {laid}" : "")</button>
                    <button class="rung @(_sideTab == "world" ? "here" : "")" @onclick='() => _sideTab = "world"'>The world</button>
                </div>
                @if (_sideTab == "system") { <SystemPanel SystemId="@sys.Id" /> }
                else if (_sideTab == "infra") { <SystemPanel SystemId="@sys.Id" Infrastructure="true" /> }
                else
                {
                <div class="kv"><span>Lanes</span><b>@sel.Lanes@(sel.Chokepoint ? " · CHOKEPOINT" : "")</b></div>
                @if (sel.Deposits is { Count: > 0 }) { <div class="kv"><span>Deposits</span><b>@string.Join(" · ", sel.Deposits.Select(d => $"{Resource.Label(d.Key)} {new string('●', d.Value)}"))</b></div><div class="muted small">Worked by a building or a venture that needs the deposit; a belt claim brings up rare earths. Richness multiplies the yield.</div> }
                @if (sel.Chokepoint) { <div class="muted small">A key system on the lanes: its holder takes tolls (+@Economy.TollCredits credits a turn), and an enemy fleet cannot pass through while a fleet of the holder's sits here.</div> }
                @if (planet != null)
                {
                    var spec = c.Holdings.Spec(planet.Specialization);
                    <div class="kv"><span>Held by</span><b>@(owner?.Name ?? "no one")</b></div>
                    @if (Conquered(w, planet, sel.Ring) is { } taken) { <div class="kv"><span>Conquered</span><b class="warn">@taken.line</b></div> }
                    <div class="kv"><span>Governor</span><b>@(gov?.Name ?? "—")</b></div>
                    @if (gov != null) { <div class="gov-line"><Portrait Id="@gov.Id" Name="@gov.Name" Sex="@gov.Sex" Age="@gov.Age" Accent="@(owner?.AccentColor ?? "#888")" Size="44" /><span class="muted" title="@SkillWords.For("administration")">@(c.Careers.RankName(gov.CareerTrack, gov.CareerRank, G.World!.Era) ?? "") · administration @gov.Skill("administration") of 10 · aged @gov.Age</span></div> }
                    <div class="kv"><span>Industry</span><b>@(spec?.Name ?? planet.Specialization)</b></div>
                    @if (planet.Population > 0) { <div class="kv" data-citizens="@Census.Citizens(w, planet)" title="@CitizensTip(w, planet, spec?.MaxPopulation ?? 0)"><span>Citizens</span><b>@Census.Say(Census.Citizens(w, planet)) <span class="muted small">· scale @planet.Population@(spec?.MaxPopulation > 0 ? $" of {spec.MaxPopulation}" : "")</span></b></div> }
                    <div class="kv"><span>Loyalty</span><b class="@(planet.Unrest >= 50 ? "warn" : "")">@(100 - planet.Unrest)<span class="bar"><i style="width:@(100 - planet.Unrest)%"></i></span></b></div>
                    <div class="kv"><span>Built</span><b>@(planet.Buildings.Count == 0 ? "nothing" : string.Join(", ", planet.Buildings.Select(b => c.Holdings.Building(b)?.Name ?? b)))</b></div>
                    @if (w.Sieges.TryGetValue(planet.Id, out var sg)) { <div class="kv warn"><span>Siege</span><b>@(w.House(sg.BesiegerId)?.Name) · @sg.Turns/@sg.Required</b></div> }
                    @if (planet.Provinces.Any(x => x.City.Length > 0))
                    {
                        <div class="kv" data-cities="@planet.Provinces.Count"><span>Cities</span><b class="cities-line">@for (int ci = 0; ci < planet.Provinces.Count; ci++) { var cp = planet.Provinces[ci]; var ckind = CitySystem.KindOf(c.Holdings, cp); if (ckind == null) { continue; } <span class="@(ckind.Great ? "great" : "")" title="@($"{ckind.What} {CitySystem.Says(ckind)}.")">@cp.City <i class="muted small">@ckind.Name, @Census.Short(CitySystem.Citizens(w, c.Holdings, planet, ci))</i></span> }</b></div>
                    }
                    string take = G.Turn!.Fleets.HowToTake(w, planet, playerHouse);
                    @if (take.Length > 0) { <div class="small" data-how-to-take="@planet.Id">@take</div> }
                    @if (planet.InRebellion) { <div class="kv warn"><span>Rising</span><b>in revolt for @planet.Rebellion year(s) · breaks away after @RegionSystem.SecessionTurns</b></div> }
                    var rstate = RegionSystem.StateOf(w, sys.RegionId);
                    <div class="kv"><span>Region</span><b>allegiance @rstate.Allegiance · <span class="@(rstate.Lawlessness >= 60 ? "warn" : "")">lawlessness @rstate.Lawlessness</span></b></div>
                }
                else { <div class="muted">No one holds this world.</div> }
                @if (stations.Count > 0)
                {
                    <h4>In orbit</h4>
                    @foreach (var st in stations) { <div class="line"><b>@st.Name</b> <span class="muted">@(c.Holdings.Spec(st.Specialization)?.Name ?? st.Specialization) · @(w.House(st.OwnerId)?.Name)</span></div> }
                }
                var here = fleets.Where(f => f.SystemId == sel.SystemId).ToList();
                @if (here.Count > 0)
                {
                    <h4>Fleets here</h4>
                    @foreach (var f in here) { <div class="fleet-line" @onclick="() => ClickFleet(f)"><i class="sw" style="background:@f.AccentColor"></i> <b>@f.Name</b> <span class="muted">@f.OwnerHouseName · @f.Strength hulls@(f.IsPlayer ? $" · readiness {f.Readiness}" : $" · intel {f.Confidence}%")</span></div> }
                }
                <div class="muted small">Lanes to @string.Join(", ", w.Galaxy.Neighbors(sel.SystemId).Select(id => w.Galaxy.System(id)?.Name ?? id))</div>
                @if (owner != null && owner.Id != playerHouse)
                {
                    var dw = new DeclareWarCommand(pid, owner.Id, c.Fleets);
                    <button class="opt" disabled="@(!dw.CanExecute(ctx))" title="@(dw.CanExecute(ctx) ? "" : "already at war, or no influence")" @onclick="() => G.AskWar(owner.Id)">Declare war on @owner.Name (2 influence)</button>
                    @if (planet != null && G.Court().Reclaims?.FirstOrDefault(r => r.HoldingId == planet.Id) is { } rc) { <button class="opt" disabled="@(rc.Refusal != null)" title="@rc.Refusal" @onclick="() => G.Execute(new ReclaimFreeholdCommand(pid, rc.HoldingId))">Buy @rc.HoldingName back from @rc.FreeHouseName (@rc.Price credits)</button> }
                }
                }
            </section>
        }
        else
        {
            <section class="panel"><h2>@w.Galaxy!.Name</h2><div class="muted">@regions.Count(r => r.Ring != "beyond") regions@(regions.Any(r => r.Ring == "beyond") ? $", and {regions.Count(r => r.Ring == "beyond")} beyond the rim" : "") · @nodes.Count worlds · @w.Houses.Keys.Count(h => !Praetoria.Core.State.World.Outsider(h)) houses. Click a world or a fleet. Click one of your fleets, then a ringed world, to set its course.</div></section>
            <section class="panel">
                <h3>Regions</h3>
                @foreach (var ring in new[] { "core", "middle", "rim", "beyond" }.Where(x => regions.Any(r => r.Ring == x)))
                {
                    <div class="ring-head"><span class="ring @ring">@ring</span> <span class="muted small">@(ring == "core" ? (w.IsImperium ? "commerce and the court" : "commerce and the Senate") : ring == "rim" ? "lawless, restless, breaking away" : ring == "beyond" ? "not the Reach: a nation's own space" : "leaning either way")</span></div>
                    @foreach (var r in regions.Where(x => x.Ring == ring)) { <button class="ol-row region-row @(r.FreeMarch || r.StateName != null ? "free" : "")" @onclick="() => Focus(r.CX, r.CY)"><i class="sw" style="background:@r.AccentColor"></i> <b>@r.Name</b> <span class="muted">@(r.DominantHouseName ?? "contested")@(r.FreeMarch ? " · FREE MARCH" : "")@(r.StateName != null ? " · " + r.StateName + (r.StateAtWar ? " (fighting for it)" : "") : "") · loyalty @(100 - r.Unrest)</span>@if (ring != "beyond") { <span class="rstats"><span title="allegiance to the capital">⚜ @r.Allegiance</span> <span class="@(r.Lawlessness >= 60 ? "warn" : "")" title="lawlessness">☠ @r.Lawlessness</span>@(r.Rebellions > 0 ? $" ✦ {r.Rebellions} rising" : "")</span> }</button> }
                }
            </section>
        }
        @if (sel != null)
        {
            var hereFleets = fleets.Where(f => f.SystemId == sel.SystemId && !f.Moving).OrderByDescending(f => f.IsPlayer).ThenByDescending(f => f.Strength).ToList();
            var bound = fleets.Where(f => f.Moving && f.DestinationId == sel.SystemId).ToList();
            <section class="panel" data-fleets-here="@hereFleets.Count">
                <h3>Fleets at @sel.Name</h3>
                @if (hereFleets.Count == 0 && bound.Count == 0) { <div class="muted small">No fleet is known to be here.</div> }
                @foreach (var f in hereFleets) { <div class="fleet-line @(f.FleetId == _fleetId ? "selected" : "")" @onclick="() => ClickFleet(f)"><b>@f.Name</b> <span class="muted">@(f.IsPlayer ? "yours" : f.OwnerHouseName)@(w.AtWar(playerHouse, f.OwnerHouseId) ? " · at war with you" : "") · @f.Strength hulls@(f.IsPlayer ? " · readiness " + f.Readiness : " · by report, " + f.Confidence + "% sure")</span>
                    @if (!f.IsPlayer && w.Fleets.TryGetValue(f.FleetId, out var real) && !real.Moving && real.SystemId == sel.SystemId && Praetoria.Core.Systems.FleetSystem.TerritoryOwner(w, sel.SystemId) == playerHouse)
                    {
                        /* a fleet of another house in the player's own space: what it is there for, and a way to ask it out */
                        var ask = new AskFleetToLeaveCommand(pid, real.Id); var askNo = ask.Refusal(ctx);
                        <div class="small" data-doing="@real.Id">@Praetoria.Core.Systems.FleetSystem.Doing(w, real, playerHouse)</div>
                        @if (!w.AtWar(playerHouse, real.OwnerId) && real.OwnerId != Praetoria.Core.Systems.PirateSystem.HouseId)
                        {
                            <button class="btn sm" data-ask-leave="@real.Id" disabled="@(askNo != null)" title="@(askNo ?? $"1 influence. {f.OwnerHouseName} takes its fleet home, and does not send one to stand over you for {Praetoria.Core.Systems.FleetSystem.AskedOffYears} years.")" @onclick:stopPropagation="true" @onclick="() => G.Execute(ask)">Ask it to leave</button>
                            @if (askNo != null) { <div class="muted small">@askNo</div> }
                        }
                    }
                </div> }
                @foreach (var f in bound) { <div class="fleet-line"><b>@f.Name</b> <span class="muted">@(f.IsPlayer ? "yours" : f.OwnerHouseName) · on its way here, @f.Eta year(s) off · @f.Strength hulls</span></div> }
            </section>
        }
        <section class="panel">
            <h3>All your fleets <span class="muted small">wherever they are · click one to pick it</span></h3>
            @foreach (var f in fleets.Where(f => f.IsPlayer))
            {
                <div class="fleet-line @(f.FleetId == _fleetId ? "selected" : "")" @onclick="() => ClickFleet(f)"><b>@f.Name</b> <span class="muted">@(pos.TryGetValue(f.SystemId, out var at) ? at.Name : f.SystemId)@(f.Moving ? $" → {(pos.TryGetValue(f.DestinationId, out var d2) ? d2.Name : f.DestinationId)} ({f.Eta})" : "") · @f.Strength hulls · readiness @f.Readiness</span></div>
            }
            @if (!fleets.Any(f => f.IsPlayer)) { <div class="muted">No hull flies your colours. Lay one down (House → Holdings → Shipyard).</div> }
        </section>
        </div>
    </aside>
</div>

@code {
    /* what the citizens figure is, and how it stands to the scale the rules reckon by */
    internal static string CitizensTip(Praetoria.Core.State.World w, Praetoria.Core.State.Holding h, int max) =>
        $"The citizens of {h.Name}. The rules reckon a world's people on a scale ({h.Population} here{(max > 0 ? $", of the {max} this kind of world can hold" : "")}): manpower, development and what a siege costs go by it. "
        + $"A world twice as high on the scale holds four times the people; a terran world holds far more than a frozen or barren one, and the core more than the rim.{(max > h.Population && max > 0 ? $" Full, it would hold {Census.Say(Census.At(w, h, max))}." : "")}";
    /// <summary>Raised when a world or a fleet is picked on the map, so the shell can bring the map's own window forward.</summary>
    [Parameter] public EventCallback OnPicked { get; set; }
    private bool _regions;
    private string _sideTab = "system";
    private string? _fleetId, _systemId; private ElementReference _host, _minimap; private readonly string _id = Guid.NewGuid().ToString("N");
    private DotNetObjectReference<GalaxyMap>? _self; private bool _created; private string _pendingModel = "";
    private string _lastSent = "";

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            _self = DotNetObjectReference.Create(this);
            try { if (await JS.InvokeAsync<bool>("praetoria.ready", "praetoriaSpace")) { await JS.InvokeVoidAsync("praetoriaSpace.create", _id, _host, _self); _created = true; await JS.InvokeVoidAsync("praetoriaSpace.minimap", _id, _minimap); } } catch { }
        }
        if (_created && _pendingModel != _lastSent) { _lastSent = _pendingModel; try { await JS.InvokeVoidAsync("praetoriaSpace.setModel", _id, _pendingModel); } catch { } }
        try { await JS.InvokeVoidAsync("praetoriaFx.paint"); await JS.InvokeVoidAsync("praetoriaBust.paint"); } catch { }
    }

    [JSInvokable]
    public void OnPick(string kind, string id)
    {
        var w = G.World!;
        if (kind == "system")
        {
            // looking at a world is only looking (docs/PLAYTHROUGH.md 11): with a fleet picked the route and the odds are shown, and the
            // order is given by the button in the order bar, never by the click
            _systemId = id; _ = OnPicked.InvokeAsync();
        }
        else if (kind == "fleet") { if (w.Fleets.TryGetValue(id, out var f)) { if (f.OwnerId == w.Protagonist!.HouseId) _fleetId = _fleetId == id ? null : id; _systemId = f.SystemId; _ = OnPicked.InvokeAsync(); } }
        else { _fleetId = null; }
        StateHasChanged();
    }

    /// <summary>A world that has changed sides across the rim (docs/BEYOND.md): a world of the Reach's that a nation holds, taken in a war
    /// still being fought ("occupied") or kept at a peace ("ceded"); or a world of a nation's that a house of the Reach holds ("held").</summary>
    private static (string kind, string line)? Conquered(World w, Holding planet, string ring)
    {
        bool beyond = ring == "beyond"; var holder = w.House(planet.OwnerId)?.Name ?? planet.OwnerId;
        if (!beyond && w.Foreign(planet.OwnerId))
            return planet.FormerOwnerId.Length > 0 ? ("occupied", $"taken from {w.House(planet.FormerOwnerId)?.Name ?? planet.FormerOwnerId} by {holder}; whoever frees it gives it back")
                : ("ceded", $"ceded to {holder} at a peace; whoever takes it back keeps it");
        if (beyond && w.OfTheReach(planet.OwnerId)) return ("held", $"a world of {(planet.FormerOwnerId.Length > 0 ? w.House(planet.FormerOwnerId)?.Name ?? "a nation" : "a nation")}'s, held by {holder}");
        return null;
    }

    /* a voyage of three years or more is asked about first: the fleet is gone that long, and calling it back takes as long as it has sailed (docs/PLAYTHROUGH.md, Easy, S62) */
    private void Send(string fleetId, string systemId, int years = 0)
    {
        var w = G.World!; var cmd = new MoveFleetCommand(w.ProtagonistId, fleetId, systemId, G.Content!.Fleets);
        if (years < 3) { G.Execute(cmd); return; }
        string to = w.Galaxy?.System(systemId)?.Name ?? systemId, name = w.Fleets.TryGetValue(fleetId, out var f) ? f.Name : "The fleet";
        G.Ask($"Send {name} to {to}?", $"It is {years} years there. Until it arrives it fights nowhere and guards nothing; it can be called back on the way, and coming back takes as long as it has sailed. Readiness falls a little every year under way.", "Send it", () => G.Execute(cmd));
    }
    private void ClickFleet(MapFleet f) { if (f.IsPlayer) { _fleetId = _fleetId == f.FleetId ? null : f.FleetId; } _systemId = f.SystemId; }
    /// <summary>Bring a system forward: centred, picked, its panel open. For alerts and lists that name a place.</summary>
    public async Task Select(string systemId) { try { await JS.InvokeAsync<object>("praetoriaSpace.select", systemId, _id); } catch { } }
    /// <summary>Pick a fleet of the player's, as a click on its marker does, and bring the map to where it lies: its row in the list at the right does this (docs/PLAYTHROUGH.md, Easy: "a fleet's row in the outliner selects the fleet").</summary>
    public async Task PickFleet(string fleetId)
    {
        if (G.World?.Fleets.TryGetValue(fleetId, out var f) != true || f == null) return;
        if (f.OwnerId == G.World.Protagonist?.HouseId) _fleetId = fleetId;
        if (f.SystemId.Length > 0) await Select(f.SystemId);
        StateHasChanged();
    }
    private async Task Focus(double x, double y) { try { await JS.InvokeVoidAsync("praetoriaSpace.focus", _id, x, y); } catch { } }

    /// <summary>The bodies of a system for the map: everything but the sun (which the map draws itself), each with what it goes round
    /// and whether anything is built on it. The sun is left out, so a moon's world is named by its place among what is left.</summary>
    private static object Bodies(World w, MapNode n)
    {
        var all = (n.Bodies ?? Array.Empty<Body>()).ToList(); var kept = all.Select((b, i) => (b, i)).Where(x => !x.b.IsStar && !x.b.IsSpace).ToList();
        var place = kept.Select((x, k) => (x.i, k)).ToDictionary(x => x.i, x => x.k);
        var built = w.BodyWorks.Count == 0 ? new HashSet<int>() : SystemWorks.In(w, n.SystemId).Select(x => x.Body).ToHashSet();
        return kept.Select(x => new { name = x.b.Name, cls = x.b.Class, size = x.b.Size, primary = x.b.IsPrimary, orbits = x.b.Orbits >= 0 && place.TryGetValue(x.b.Orbits, out var at) ? at : -1, works = built.Contains(x.i) }).ToList();
    }

    /// <summary>The realm the player's house is of: a state that has left the Reach, if its region has; else the Reach.</summary>
    private static string PlayerRealm(World w, IReadOnlyList<MapRegion> regions)
    {
        var house = w.House(w.Protagonist!.HouseId); if (house == null) return "reach";
        if (w.NationOfHouse(house.Id) is { } n) return "nation:" + n.Id;
        var seat = w.HoldingsOf(house.Id).Where(h => h.IsPlanet).OrderBy(h => h.Id, StringComparer.Ordinal).FirstOrDefault();
        var reg = seat != null && w.Galaxy?.System(seat.SystemId) is { } sys ? regions.FirstOrDefault(r => r.Id == sys.RegionId) : null;
        return house.PolityId.Length > 0 && !string.IsNullOrEmpty(reg?.StateName) ? "state:" + reg!.StateName : "reach";
    }

    private string BuildModel(World w, ContentDatabase c, IReadOnlyList<MapNode> nodes, IReadOnlyList<MapFleet> fleets, IReadOnlyList<MapRegion> regions, Fleet? selectedFleet, CommandContext ctx)
    {
        var pid = w.ProtagonistId;
        var systems = nodes.Select(n =>
        {
            var owner = n.OwnerHouseId != null ? w.House(n.OwnerHouseId) : null;
            var siege = w.Sieges.Values.FirstOrDefault(s => w.Holding(s.HoldingId)?.SystemId == n.SystemId);
            int target = selectedFleet != null && new MoveFleetCommand(pid, selectedFleet.Id, n.SystemId, c.Fleets).CanExecute(ctx) ? w.Galaxy!.Hops(selectedFleet.SystemId, n.SystemId) : 0;
            var taken = n.PlanetHoldingId != null ? Conquered(w, w.Holding(n.PlanetHoldingId)!, n.Ring) : null;
            // the realm a held system is of, for the far view: a nation beyond the Reach, a state that has left it, or the Reach itself
            var nation = n.OwnerHouseId != null ? w.NationOfHouse(n.OwnerHouseId) : null; var reg = regions.FirstOrDefault(r => r.Id == n.RegionId);
            string polity = n.OwnerHouseId == null ? "" : nation != null ? "nation:" + nation.Id : !string.IsNullOrEmpty(reg?.StateName) ? "state:" + reg!.StateName : "reach";
            string polityName = nation != null ? (n.OwnerHouseName ?? "") : polity.StartsWith("state:") ? reg!.StateName! : w.Galaxy!.Name;
            string polityColor = nation != null ? n.AccentColor : polity.StartsWith("state:") ? reg!.AccentColor : "#c3cde2";   // the Reach: marble, which no house and no nation wears
            // whose space a system lies in, held or not: a world nobody holds inside the Reach is still inside the Reach's border
            string realm = polity.Length > 0 ? polity : n.Ring == Praetoria.Core.Galaxy.Ring.Beyond ? "" : !string.IsNullOrEmpty(reg?.StateName) ? "state:" + reg!.StateName : "reach";
            string realmColor = polity.Length > 0 ? polityColor : realm.StartsWith("state:") ? reg!.AccentColor : "#c3cde2";
            return new { id = n.SystemId, name = n.Name, x = n.X, y = n.Y, ownerId = n.OwnerHouseId, ownerName = n.OwnerHouseName, accent = n.AccentColor, polity, polityName, polityColor, realm, realmColor, isPlayer = n.IsPlayerTerritory, contested = n.Contested,
                planetClass = n.PlanetClass, great = n.PlanetHoldingId != null && w.Holding(n.PlanetHoldingId) is { } gh ? string.Join(" · ", gh.Provinces.Where(x => CitySystem.KindOf(c.Holdings, x)?.Great == true).Select(x => x.City + ", " + CitySystem.KindOf(c.Holdings, x)!.Name)) : "", pop = n.Population, citizens = n.PlanetHoldingId != null && w.Holding(n.PlanetHoldingId) is { } ph ? Census.Say(Census.Citizens(w, ph)) : "", unrest = n.Unrest, stations = n.Stations, regionId = n.RegionId, governor = n.GovernorName, rebel = n.Rebellion > 0, capital = n.Capital, ring = n.Ring, chokepoint = n.Chokepoint, conquered = taken?.kind, deposits = n.Deposits == null ? "" : string.Join(" ", n.Deposits.Keys.Select(k => k == "helium3" ? "³He" : k == "rare_earths" ? "RE" : "Iso")),
                bodies = Bodies(w, n),
                sunWorks = w.BodyWorks.Count > 0 && w.Galaxy!.System(n.SystemId) is { } sunSys && SystemWorks.In(w, n.SystemId).Any(x => x.Body >= 0 && x.Body < sunSys.Bodies.Count && sunSys.Bodies[x.Body].IsStar),
                deepWorks = SystemWorks.Any(w) && w.Galaxy!.System(n.SystemId) is { } deepSys ? SystemWorks.In(w, n.SystemId).Count(x => x.Body >= 0 && x.Body < deepSys.Bodies.Count && deepSys.Bodies[x.Body].IsSpace) : 0,
                industry = n.PlanetHoldingId != null ? c.Holdings.Spec(w.Holding(n.PlanetHoldingId)!.Specialization)?.Name : null,
                siege = siege != null ? (double?)Math.Clamp(siege.Turns / (double)Math.Max(1, siege.Required), 0, 1) : null,
                bloc = owner != null && owner.Bloc.Length > 0 ? (owner.Bloc == GreatCrisisSystem.HegemonBloc ? "hegemon" : "alliance") : null, target };
        }).ToList();
        var lanes = GalaxyProjection.Lanes(w).Select(l =>
        {
            var a = nodes.First(n => n.SystemId == l.A); var b = nodes.First(n => n.SystemId == l.B);
            bool front = a.OwnerHouseId != null && b.OwnerHouseId != null && w.AtWar(a.OwnerHouseId, b.OwnerHouseId);
            bool reach = selectedFleet != null && (selectedFleet.SystemId == l.A || selectedFleet.SystemId == l.B);
            return new { a = l.A, b = l.B, front, reach };
        }).ToList();
        var fl = fleets.Select(f => new { id = f.FleetId, name = f.Name, ownerId = f.OwnerHouseId, ownerName = f.OwnerHouseName, accent = f.AccentColor, systemId = f.SystemId, strength = f.Strength, readiness = f.Readiness, isPlayer = f.IsPlayer, moving = f.Moving, destId = f.DestinationId, eta = f.Eta, confidence = f.Confidence }).ToList();
        var rg = regions.Select(r => new { id = r.Id, name = r.Name, culture = r.Culture, cx = r.CX, cy = r.CY, top = r.SystemIds.Select(id => nodes.First(n => n.SystemId == id).Y).Min(), bottom = r.SystemIds.Select(id => nodes.First(n => n.SystemId == id).Y).Max(), accent = r.AccentColor, dominant = r.DominantHouseName, loyalty = 100 - r.Unrest, ring = r.Ring, allegiance = r.Allegiance, lawlessness = r.Lawlessness, free = r.FreeMarch, state = r.StateName, stateWar = r.StateAtWar }).ToList();
        var rings = GalaxyProjection.Rings(w);
        var route = selectedFleet != null && _systemId != null && _systemId != selectedFleet.SystemId ? w.Galaxy!.Path(selectedFleet.SystemId, _systemId, MoveFleetCommand.Barred(w, selectedFleet.OwnerId)) : null;
        return System.Text.Json.JsonSerializer.Serialize(new { systems, lanes, fleets = fl, regions = rg, rings = rings == null ? null : new { cx = rings.CX, cy = rings.CY, core = rings.Core, middle = rings.Middle, rim = rings.Rim }, playerHouse = w.Protagonist!.HouseId, playerRealm = PlayerRealm(w, regions), era = w.Era, route, selected = new { systemId = _systemId, fleetId = _fleetId } });
    }

    public async ValueTask DisposeAsync() { try { if (_created) await JS.InvokeVoidAsync("praetoriaSpace.destroy", _id); } catch { } _self?.Dispose(); }
