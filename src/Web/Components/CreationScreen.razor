@inject GameClient G
@using Praetoria.Core.Creation

<div class="title-screen">
    <section class="hero">
        <div class="hero-mark">✦</div>
        <h1>PRAETORIA</h1>
        <p class="tag">You don't play an empire. You play a family trying to survive one.</p>
        <p class="ver">@PraetoriaVersion.Current · @PraetoriaVersion.Codename</p>
        @if (HasAutosave)
        {
            <button class="btn primary big" data-continue="1" @onclick="OnContinue">Continue@(SaveLabel.Length > 0 ? ": " + SaveLabel : " the saved saga")</button>
        }
        @if (HasAutosave || KeptSaves > 0)
        {
            <button class="btn ghost" data-title-saves="1" title="The saved sagas in this browser: the running one and the ones you kept" @onclick="OnSaves">Saved sagas@(KeptSaves > 0 ? " · " + KeptSaves + " kept" : "")</button>
        }
        <label class="btn ghost file">Load a save file <InputFile OnChange="OnFile" accept=".json" /></label>
    </section>

    <section class="creation">
        <div class="col">
            <h2>The scenario</h2>
            <div class="scenario-list">
                <button class="scenario custom @(_custom ? "selected" : "")" @onclick="PickCustom">
                    <div class="sc-name">A Character Of Your Own</div>
                    <div class="sc-meta">any age, either era · every dial · a fair budget, or none</div>
                    <div class="sc-desc">Make the person, the face, the house, what it holds and the family. Standard keeps it fair; Free lets you make anyone at all.</div>
                </button>
                @foreach (var id in G.ScenarioIds)
                {
                    var sc = _scenarios[id];
                    <button class="scenario @(!_custom && id == _scenario ? "selected" : "")" @onclick="() => Pick(id)">
                        <div class="sc-name">@Title(id) @if (Hardness(id) is { } hard) { <span class="pill small @hard.tone" data-hardness="@id" title="@hard.why">@hard.word</span> }</div>
                        <div class="sc-meta">@(sc.Academy ? (sc.Era == "imperium" ? "begins at the Institute · " : "begins at the Academy · the tutorial · ") : "")@(sc.Era == "imperium" ? "the Imperium" : "the Republic") · @sc.Houses.Count houses · @sc.Characters.Count souls@(sc.Galaxy != null ? $" · {sc.Galaxy.Systems.Count} systems" : "")</div>
                        <div class="sc-desc">@Describe(sc)</div>
                    </button>
                }
            </div>

            <h2>The world</h2>
            <div class="grid2">
                <label>Seed <input type="number" @bind="_seed" min="1" /></label>
                <label>Mode
                    <select @bind="_mode">
                        <option value="ironman">Ironman — when the bloodline ends, the run ends</option>
                        <option value="continue">Continue — a sworn house takes up the banner</option>
                    </select>
                </label>
                <label>Difficulty
                    <select @bind="_difficulty">
                        <option value="0.5">Forgiving — rivals slow to act</option>
                        <option value="1">Standard</option>
                        <option value="1.5">Hard</option>
                        <option value="2">Harsh — the galaxy hunts you</option>
                    </select>
                </label>
                <label title="The Reach and every nation beyond it grow together: more systems, more houses, larger neighbours. A larger map makes for longer turns.">The size of the map
                    <select @bind="_size" data-setting="size">
                        @foreach (var sz in GrowthCatalog.Sizes) { <option value="@sz">@GrowthCatalog.SizeName(sz): @SizeNote(sz)</option> }
                    </select>
                </label>
                <label title="The nations that border the Reach: the Khanates, the Free Cities, the Concord, the Compact, the Crown. Each has fleets and worlds of its own on the map's rim, raids when it thinks ill of the Reach, and can be fought, bought off or subdued. This sets how strong their fleets are.">The powers beyond
                    <select @bind="_beyond">
                        <option value="gentle">Gentle: a fifth weaker</option>
                        <option value="default">As written</option>
                        <option value="harsh">Harsh: a quarter stronger</option>
                    </select>
                </label>
                <label title="How readily a nation beyond the Reach goes from raiding to war: how often a great ruler rises among them, and how soon an invasion follows.">How often they attack
                    <select @bind="_aggression">
                        <option value="seldom">Seldom: wars from beyond are rare</option>
                        <option value="default">As written</option>
                        <option value="often">Often: great rulers and invasions come sooner</option>
                    </select>
                </label>
                <label title="The Great Crisis is the war of the Reach with itself: as wars, over-mighty houses and seizures pile up, the houses sort into two blocs and fight for ten years or more. This sets how fast it comes. Off, it never does, and the game is the Republic's ordinary politics for as long as you play.">Crisis intensity
                    <select @bind="_intensity">
                        <option value="off">Off — no Great Crisis</option>
                        <option value="low">Low — a slow-burning century</option>
                        <option value="default">Default</option>
                        <option value="dominant">Dominant — the war comes fast</option>
                    </select>
                </label>
                <label title="How far your relatives go their own way. Deferential: they pursue nothing of their own, never stand for office unasked, never defy you and never elope. Wills of their own: they have ambitions, stand for office, marry for love if forbidden, and one who thinks ill enough of you defies you or goes over to a rival. A nest of schemers: the same, at half the provocation.">Family autonomy
                    <select @bind="_autonomy">
                        <option value="0">Deferential kin</option>
                        <option value="1">Wills of their own</option>
                        <option value="2">A nest of schemers</option>
                    </select>
                </label>
            </div>
        </div>

        @if (_custom)
        {
        <div class="col wide">
            <h2>A character of your own</h2>
            <Workshop Spec="_spec" SpecChanged="s => { _spec = s; _error = null; }" />
            @if (_error != null) { <p class="error">@_error</p> }
            <button class="btn primary big begin" disabled="@(CharacterWorkshop.Problems(_spec, G.Content!, G.BlankWorld(_spec.Imperium)).Count > 0)" @onclick="BeginAsked">Begin the saga ▸</button>
        </div>
        }
        else
        {
        <div class="col">
            <h2>The character</h2>
            <p class="hint">Leave anything blank to play the scenario's protagonist as written.</p>
            <div class="grid2">
                <label>Name <input @bind="_name" placeholder="@_protagonistName" /></label>
                <label>Sex
                    <select @bind="_sex"><option value="">as written</option><option value="male">male</option><option value="female">female</option></select>
                </label>
                <label>Career track
                    <select @bind="_track"><option value="">as written</option>
                        @foreach (var t in G.Content!.Careers.Defs) { <option value="@t.Id">@t.Name</option> }
                    </select>
                </label>
                <label>Ambition
                    <select @bind="_ambition"><option value="">as written</option>
                        @foreach (var a in G.Content!.Traits.Ambitions) { <option value="@a.Id" title="@a.Description">@a.Name</option> }
                    </select>
                </label>
            </div>
            @if (_track != "") { <p class="hint" data-track-says>@TrackSays(_track)</p> }
            @if (_ambition != "" && G.Content!.Traits.Ambitions.FirstOrDefault(a => a.Id == _ambition) is { } amb) { <p class="hint" data-ambition-says><b>@amb.Name.</b> @amb.Description Reports that speak to what you want come to you more often, and the You window shows how near you are.</p> }

            <h3>Background</h3>
            <div class="chips">
                <button class="chip @(_background == "" ? "on" : "")" @onclick='() => _background = ""'>As written</button>
                @foreach (var b in G.Content!.Backgrounds.Defs)
                {
                    <button class="chip @(_background == b.Id ? "on" : "")" @onclick="() => _background = b.Id" title="@b.Description">@b.Name</button>
                }
            </div>
            @if (_background != "" && G.Content!.Backgrounds.ById(_background) is { } bgd)
            {
                <p class="bg-desc">@bgd.Description
                    <span class="muted">@BackgroundEffects(bgd)</span></p>
            }

            <h3>Nature <span class="muted">(up to @CharacterCreation.MaxPickedNature)</span></h3>
            <div class="chips">
                @foreach (var t in G.Content!.Traits.Nature)
                {
                    <button class="chip @(_nature.Contains(t.Id) ? "on" : "")" title="@t.Description" @onclick="() => Toggle(_nature, t.Id, CharacterCreation.MaxPickedNature)">@t.Name</button>
                }
            </div>
            <h3>Aptitude <span class="muted">(up to @CharacterCreation.MaxPickedAptitude)</span></h3>
            <div class="chips">
                @foreach (var t in G.Content!.Traits.Aptitude)
                {
                    <button class="chip @(_aptitude.Contains(t.Id) ? "on" : "")" title="@t.Description" @onclick="() => Toggle(_aptitude, t.Id, CharacterCreation.MaxPickedAptitude)">@t.Name</button>
                }
            </div>

            @if (_error != null) { <p class="error">@_error</p> }
            <button class="btn primary big begin" @onclick="BeginAsked">Begin the saga ▸</button>
        </div>
        }
    </section>

    <footer class="title-foot">
        <span>Each turn: read the briefing → spend Influence, Treasury and Agents answering it → end the turn and the houses move.</span>
    </footer>
</div>

@code {
    /* what a service is, for one who has not played: what you rise by, what it teaches, and which of the three estates it feeds */
    private static string TrackSays(string track) => track switch
    {
        "military" => "The Navy. You rise by rank in the fleet; the service teaches tactics, gunnery, leadership, logistics and discipline, lets you command more hulls, and adds your rank to your house's weight in the Navy.",
        "stewardship" => "The Administration. You rise by rank in the Reach's offices; the service teaches administration, economics and engineering, makes you the better governor and steward, and adds your rank to your house's weight in the Treasury.",
        "law" => "The Courts. You rise by rank at the law; the service teaches law, oratory and diplomacy, opens the bench (a Judge gives a house its voice in the Senate), and adds your rank to your house's weight in the Senate.",
        _ => "",
    };
    /// <summary>How hard a start is, and why, so a first game is not begun on the hardest (docs/PLAYTHROUGH.md, "The front door").</summary>
    private static (string word, string tone, string why)? Hardness(string id) => id switch
    {
        "the_academy" => ("start here", "good", "The tutorial: a year at the Academy that teaches the screens one at a time, then a first posting with a house behind you."),
        "the_institute" => ("the Imperium's tutorial", "good", "A year at the Institute under an Emperor, then a first posting."),
        "the_old_lion" => ("gentle", "good", "A great house, rich and of high rank, with worlds and a fleet. The danger is the head's age: the first succession comes early."),
        "the_circling_heir" => ("moderate", "", "Wealth and a name, and relatives who want both."),
        "the_imperial_court" => ("moderate", "", "A minor house inside a standing empire: there is a ladder to climb and an Emperor watching."),
        "the_fallen_house" => ("hard", "warn", "One poor world, debts, and the contempt of those who rose past you."),
        "the_new_man" => ("hard", "warn", "No land, no rank and no seat: one trading company and a head for figures."),
        "the_risen_officer" => ("hard", "warn", "No name and no land, only talent: almost no house wealth to fall back on."),
        _ => null
    };
    [Parameter] public bool HasAutosave { get; set; }
    /// <summary>What the saved saga is: the house, its head and the year.</summary>
    [Parameter] public string SaveLabel { get; set; } = "";
    /// <summary>How many kept saves this browser holds beside the running one, and the way to their list.</summary>
    [Parameter] public int KeptSaves { get; set; }
    [Parameter] public EventCallback OnSaves { get; set; }
    [Parameter] public EventCallback OnContinue { get; set; }
    [Parameter] public EventCallback<string> OnLoadJson { get; set; }

    private readonly Dictionary<string, Scenario> _scenarios = new();
    private string _scenario = "";
    private string _protagonistName = "";
    private int _seed = 1;
    private string _mode = "ironman", _intensity = "default", _beyond = "default", _aggression = "default", _size = "small";
    private int _written;
    /// <summary>What a size of map holds: the written map's systems, more of them at each size (docs/GALAXY_SIZE.md).</summary>
    private string SizeNote(string size)
    {
        if (_written == 0) _written = G.BlankWorld(false).Galaxy?.Systems.Count ?? 50;
        int n = _written * (G.Content?.Growth.PercentOf(size) ?? 100) / 100;
        return size == GrowthCatalog.Small ? $"the Reach as written, {n} systems" : $"about {n} systems";
    }
    private string _difficulty = "1", _autonomy = "1";
    private string _name = "", _sex = "", _track = "", _ambition = "", _background = "";
    private readonly List<string> _nature = new(), _aptitude = new();
    private string? _error;
    private bool _custom; private CustomCharacter _spec = new();
    private void PickCustom() { _custom = true; _error = null; if (_spec.Name.Length == 0 && _spec.Skills.Count == 0) _spec = CharacterWorkshop.Presets(G.Content!)[0].spec.Clone(); }

    protected override void OnInitialized()
    {
        foreach (var id in G.ScenarioIds) _scenarios[id] = G.Scenario(id);
        Pick(G.ScenarioIds.Contains("the_academy") ? "the_academy" : G.ScenarioIds.FirstOrDefault() ?? "");   // the Academy is the game's opening and its tutorial
    }

    private void Pick(string id)
    {
        _custom = false;
        _scenario = id;
        var sc = _scenarios[id];
        _protagonistName = sc.Characters.FirstOrDefault(c => c.Id == sc.ProtagonistId)?.Name ?? "";
    }

    private static string Title(string id) => string.Join(' ', id.Split('_').Select(w => w.Length == 0 ? w : char.ToUpperInvariant(w[0]) + w[1..]));

    private string Describe(Scenario sc)
    {
        var p = sc.Characters.FirstOrDefault(c => c.Id == sc.ProtagonistId);
        if (p == null) return "";
        var house = sc.Houses.FirstOrDefault(h => h.Id == p.HouseId);
        var title = house != null ? G.Content!.Titles.NameOf(house.Title, sc.Era) : "";
        var rank = G.Content!.Careers.RankName(p.CareerTrack, p.CareerRank, sc.Era) ?? "";
        if (sc.Academy) return $"{p.Name}, sixteen, of {house?.Name ?? p.HouseId} ({title}), enters {G.Content!.Academy.Register(sc.Era == "imperium" ? "imperium" : "republic").Name}. A year of four terms apart from the world, then a commission and the first turn.";
        return $"{p.Name}, {p.Age}, {rank} of {house?.Name ?? p.HouseId} ({title}). {sc.Holdings.Count} holdings, {sc.Fleets.Count} fleets in play.";
    }

    private static string BackgroundEffects(BackgroundDef b)
    {
        var parts = new List<string>();
        if (b.Legitimacy != 0) parts.Add($"legitimacy {b.Legitimacy:+#;-#;0}");
        if (!b.Treasury.IsEmpty()) parts.Add("treasury " + CourtProjection.Bundle(b.Treasury));
        if (b.Nature.Count > 0) parts.Add("nature +" + string.Join(", ", b.Nature));
        if (b.Aptitude.Count > 0) parts.Add("aptitude +" + string.Join(", ", b.Aptitude));
        if (b.Skills.Count > 0) parts.Add(string.Join(", ", b.Skills.Select(s => $"{s.Key} {s.Value:+#;-#;0}")));
        if (b.Stress != 0) parts.Add($"stress {b.Stress:+#;-#;0}");
        return parts.Count == 0 ? "" : " — " + string.Join(" · ", parts);
    }

    private static void Toggle(List<string> set, string id, int max)
    {
        if (set.Contains(id)) set.Remove(id);
        else if (set.Count < max) set.Add(id);
    }

    private async Task OnFile(InputFileChangeEventArgs e)
    {
        try
        {
            using var s = e.File.OpenReadStream(16 * 1024 * 1024);
            using var r = new StreamReader(s);
            await OnLoadJson.InvokeAsync(await r.ReadToEndAsync());
        }
        catch (Exception ex) { _error = "Could not read that save: " + ex.Message; }
    }

    /// <summary>There is one saved saga: a new one replaces it, and the player is told so first (docs/PLAYTHROUGH.md 2).</summary>
    private void BeginAsked()
    {
        if (!HasAutosave) { Begin(); return; }
        G.Ask("Begin a new saga?", "There is a running saga in this browser" + (SaveLabel.Length > 0 ? " (" + SaveLabel + ")" : "") + ", and a new saga takes its place at the end of its first year. To keep the old one, continue it and put it in a kept save (Saves, in the top bar), or use Export.", "Begin the new saga", Begin, "Go back");
    }
    private void Begin()
    {
        _error = null;
        if (_custom)
        {
            try
            {
                G.StartCustom(_spec, (ulong)Math.Max(1, _seed), _mode, double.Parse(_difficulty, System.Globalization.CultureInfo.InvariantCulture), _intensity,
                    double.Parse(_autonomy, System.Globalization.CultureInfo.InvariantCulture), _beyond, _aggression, _size);
            }
            catch (Exception ex) { _error = ex.Message; }
            return;
        }
        var creation = new CreationOptions
        {
            Name = string.IsNullOrWhiteSpace(_name) ? null : _name,
            Sex = _sex == "" ? null : _sex,
            BackgroundId = _background == "" ? null : _background,
            CareerTrack = _track == "" ? null : _track,
            Ambition = _ambition == "" ? null : _ambition,
            Nature = _nature.ToList(), Aptitude = _aptitude.ToList()
        };
        try
        {
            G.Start(_scenario, (ulong)Math.Max(1, _seed), creation, _mode,
                double.Parse(_difficulty, System.Globalization.CultureInfo.InvariantCulture), _intensity,
                double.Parse(_autonomy, System.Globalization.CultureInfo.InvariantCulture), _beyond, _aggression, _size);
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
