@inject GameClient G
@{
    var w = G.World!; var b = Card;
    var roles = b.Item.Fired.Binding.All.Where(kv => kv.Key != "self").Select(kv => (role: kv.Key, ch: w.Char(kv.Value))).Where(x => x.ch != null).ToList();
}
<div class="win-backdrop" @onclick="OnClose">
    <div class="win event @b.Tier.ToLowerInvariant()" @onclick:stopPropagation="true">
        @* The painting an occasion opens on (tools/art/scenes.py), with its title set over the foot of it. *@
        <div class="win-art" style="background-image:url('img/scenes/@(SceneArt.For(b.Item.Fired.Def.Id, b.Title)).webp')">
            <button class="win-close" @onclick="OnClose" title="Set aside (you can return to it from the outliner this turn)">✕</button>
            <div class="win-head">
                <span class="tier"><span class="glyph">@(b.Setpiece ? "✦" : b.Tier == "AMBIENT" ? "·" : "◆")</span> @b.Tier <span class="kicker">· @RoleTheme.Kicker(RoleTheme.Of(w))</span></span>
                <h2>@b.Title</h2>
            </div>
        </div>
        <div class="ev-body">
            @if (roles.Count > 0)
            {
                <div class="win-cast">
                    @foreach (var r in roles)
                    {
                        var h = w.House(r.ch!.HouseId);
                        <div class="cast">
                            <Portrait Id="@r.ch.Id" Name="@r.ch.Name" Sex="@r.ch.Sex" Age="@r.ch.Age" Alive="@r.ch.Alive" Accent="@(h?.AccentColor ?? "#888")" Size="116" />
                            <div class="cast-name">@r.ch.Name</div>
                            <div class="cast-sub">@(h?.Name ?? "") · @RoleWord(r.role, h)</div>
                        </div>
                    }
                </div>
            }
            <p class="prose">@Prose(b.Body)</p>
            @if (b.Facts.Length > 0) { <p class="facts small" data-facts="1">@b.Facts</p> }
        </div>
        <div class="win-choices">
            @if (b.Resolved) { <div class="done" data-answer="1">Answered@(b.Answer.Length > 0 ? ": “" + b.Answer + "”" : ".")</div> }
            else
            {
                @foreach (var ch in b.Choices)
                {
                    <button class="choice" disabled="@(!ch.Available)" @onclick="() => OnChoose.InvokeAsync((b, ch.Id))">
                        <span class="label">@ch.Label</span>
                        @if (ch.Cost.Length > 0) { <span class="cost" title="Taken from this year's pools, which refill each year">@ch.Cost this year</span> }
                        @if (ch.Stakes.Length > 0) { <span class="cost stakes" data-stakes="@ch.Id">@ch.Stakes</span> }
                        @if (ch.Warn != null) { <span class="cost why" data-warn="@ch.Id">@ch.Warn</span> }
                        @if (!ch.Available) { <span class="cost why" data-why="@ch.Id">@ch.Reason</span> }
                    </button>
                }
                <button class="choice aside" title="It waits in the list at the right until you end the year. Left unanswered then, it lapses: nothing is chosen for you, and an offer in it is gone." @onclick="OnClose"><span class="label">Set it aside for now</span><span class="cost">unanswered at the year's end, it lapses</span></button>
            }
        </div>
    </div>
</div>

@code {
    /* the first letter is set large and floated, and a browser drops the space after it: "A market" read "Amarket". A space that does not break is kept. */
    private static string Prose(string s) => s.Length > 2 && s[1] == ' ' ? s[0] + "\u00A0" + s[2..] : s;
    /* the part somebody plays in a report, in the Reach's own words: no "sovereign" where no throne stands */
    private string RoleWord(string role, House? h)
    {
        var w = G.World!;
        if (role == "sovereign" && !w.IsImperium) return h != null && RegionSystem.CapitalHolder(w)?.Id == h.Id ? "holds the chair" : h != null ? Praetoria.Core.Progression.Title.StyleOf(h.Title, w.Era) : "of higher rank";
        return role.Replace('_', ' ');
    }
    [Parameter, EditorRequired] public BriefingCard Card { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(BriefingCard card, string choiceId)> OnChoose { get; set; }
}
