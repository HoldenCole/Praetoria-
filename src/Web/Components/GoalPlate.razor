@using Praetoria.Core.Presentation
@inject IJSRuntime JS
@* The goal under the top bar (docs/GOALS.md): a plate at the top left of the free map, in the windows' brass and leather. A medal
   whose ring fills with the goal's progress; the kicker (the start's aim and its year of ten, or the ambition); the title; the
   steps, ticked as they are done, with where each stands in its tooltip; where the next step stands and Go there. When the
   treasury will run out within three years a red band says how fast, where the money goes and two ways out, each a button to the
   window where it is done. The medal folds the plate to the medal and the title; the fold is kept in this browser. The close at the
   top right turns the guidance to a sandbox (docs/GOALS.md, "Guided or sandbox"): the aim goes, and Guidance in Options brings it back.
   In a sandbox the plate stands only while there is a warning before ruin, and then shows nothing but the warning; it has no close. *@
@if (Goal is { } g)
{
    string kick = g.Kind == "start" ? (Year <= Goals.Years ? $"Your aim · year {Year} of {Goals.Years}" : "Your aim") : g.Kind == "ambition" ? "Your ambition" : "A warning";
    bool aim = g.Kind != "ruin";
    double ring = 2 * Math.PI * 17, fill = ring * Math.Clamp(g.Percent, 0, 100) / 100.0;
    <section class="aim-plate @(_folded ? "folded" : "") @(g.Ruin != null ? "has-ruin" : "") @(g.Reached ? "reached" : "") @(aim ? "" : "ruin-only")" data-aim="@g.Kind" data-aim-percent="@g.Percent" aria-label="@kick">
        @if (aim && OnPutAway.HasDelegate) { <button class="aim-x" data-aim-put-away title="@PutAwayTip" aria-label="Put your aim away" @onclick="() => OnPutAway.InvokeAsync()"><Icon Name="close" Tone="ivory" Size="11" /></button> }
        <button class="aim-medal" data-aim-fold title="@(aim ? (_folded ? "[laurels] Open your aim" : "[laurels] Fold your aim to its medal") : (_folded ? "[threat] Open the warning" : "[threat] Fold the warning to its medal"))" aria-expanded="@(!_folded)" @onclick="Toggle">
            <svg class="aim-ring" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="17" class="track" /><circle cx="20" cy="20" r="17" class="fill" style="stroke-dasharray:@F(fill) @F(ring)" /></svg>
            <Icon Name="@(aim ? "laurels" : "threat")" Tone="@(aim ? "brass" : "ember")" Size="18" />
        </button>
        <div class="aim-body">
            <div class="aim-kick">@kick@if (g.Steps.Count > 1) { <span class="aim-count">@g.Done of @g.Steps.Count</span> }</div>
            <div class="aim-title" title="@g.Why">@g.Title</div>
            @if (!_folded)
            {
                @if (g.Steps.Count > 1)
                {
                    <ol class="aim-steps">
                        @foreach (var s in g.Steps)
                        {
                            bool next = ReferenceEquals(s, g.Next);
                            <li class="@(s.Done ? "done" : next ? "next" : "")" title="@s.Stands" data-aim-step="@(s.Done ? "done" : "open")"><i aria-hidden="true"></i><span>@s.Text</span></li>
                        }
                    </ol>
                }
                @if (g.Next is { } n)
                {
                    <div class="aim-next">
                        <span class="aim-stands">@(g.Steps.Count > 1 ? n.Stands : n.Text)</span>
                        <button class="ui-btn sm" data-aim-go title="Open the window where this is done" @onclick="() => OnGo.InvokeAsync(n.Target)">Go there</button>
                    </div>
                }
                @if (g.Was.Length > 0) { <div class="aim-was">@g.Was</div> }
            }
            @if (g.Ruin is { } r)
            {
                <div class="aim-ruin" data-ruin="@r.Years">
                    <div class="aim-ruin-says"><b>Before ruin.</b> @r.Says</div>
                    @if (!_folded)
                    {
                        <div class="aim-ways">
                            @foreach (var (text, target) in r.WaysOut)
                            {
                                string go = target;
                                <button class="ui-btn sm" data-ruin-go @onclick="() => OnGo.InvokeAsync(go)">@text</button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter] public Goal? Goal { get; set; }
    /// <summary>The year of the saga, for "year 3 of 10".</summary>
    [Parameter] public int Year { get; set; }
    [Parameter] public EventCallback<string> OnGo { get; set; }
    /// <summary>The close: the player turns the guidance to a sandbox.</summary>
    [Parameter] public EventCallback OnPutAway { get; set; }
    private const string PutAwayTip = "[close] Put your aim away\nThe map is left to you: no aim and no steps. A warning still shows when the money will run out within three years. Guidance in Options brings the aim back.";
    private bool _folded, _read;
    private static string F(double d) => d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (_read || Goal == null) return;
        _read = true;
        try { if (await JS.InvokeAsync<string?>("localStorage.getItem", "praetoria.aim.folded") == "1") { _folded = true; StateHasChanged(); } } catch { }
    }
    private async Task Toggle()
    {
        _folded = !_folded;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "praetoria.aim.folded", _folded ? "1" : "0"); } catch { }
    }
}
