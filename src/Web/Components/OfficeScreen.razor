@inject GameClient G
@inject IJSRuntime JS
@implements IAsyncDisposable
@{
    var m = Model; var w = G.World!; var p = w.Protagonist!; var house = w.House(p.HouseId)!; var c = G.Content!;
    var seat = w.HoldingsOf(house.Id).Where(h => h.IsPlanet && h.SystemId.Length > 0).OrderBy(h => h.Id, StringComparer.Ordinal).FirstOrDefault();
    var seatSys = seat != null ? w.Galaxy?.System(seat.SystemId) : null;
    string viewClass = Cos("view", "") is { Length: > 0 } v ? v : seatSys?.PlanetClass ?? "terran";
    _visitors = m.Briefing.Where(b => !b.Resolved).Select(b => (card: b, ch: b.Item.Fired.Binding.All.Where(kv => kv.Key != "self").Select(kv => w.Char(kv.Value)).FirstOrDefault(x => x != null)))
        .GroupBy(x => x.ch?.Id ?? x.card.Title).Select(g => g.First()).Take(4).ToList();
    var honors = m.Standing?.Honors ?? new List<string>();
    var since = w.History.Where(h => h.Turn >= m.Turn - 1 && h.EventId == null).Reverse().Take(7).ToList();
    _pending = BuildOptions(w, p, house, seat, seatSys, viewClass, honors.Count);
}
<div class="office" style="--accent:@house.AccentColor">
    <div class="office-stage">
        <div class="gl-host" @ref="_host"></div>
        <div class="stage-visitors">
            @for (int i = 0; i < _visitors.Count; i++)
            {
                var vis = _visitors[i]; int idx = i;
                <button class="stage-chip @vis.card.Tier.ToLowerInvariant()" @onclick="() => OnOpenReport.InvokeAsync(vis.card)" title="@vis.card.Title">
                    <span class="who">@(vis.ch?.Name ?? "A courier")</span><span class="what">@vis.card.Title</span>
                </button>
            }
            @if (_visitors.Count == 0) { <div class="stage-chip empty">The antechamber is empty.</div> }
        </div>
        <div class="stage-foot">
            <div class="stage-title"><Icon Name="office" Size="16" /> <b>@(seat?.Name ?? "A borrowed room")</b> <span class="muted">@(seatSys != null ? $"{seatSys.Name} · {w.Galaxy!.Region(seatSys.RegionId)?.Name}" : "no seat of your own")</span></div>
            <button class="btn sm" @onclick="() => _customize = !_customize"><Icon Name="furnish" Size="14" /> @(_customize ? "Done" : "Furnish the office")</button>
        </div>
        @if (_customize)
        {
            <div class="customize">
                @Slot("wall", "Walls", new[] { ("stone", "Stone"), ("brass", "Brass panels"), ("marble", "Marble"), ("wood", "Dark wood") })
                @Slot("floor", "Floor", new[] { ("slate", "Brushed slate"), ("carpet", "Crimson carpet"), ("marble", "Marble"), ("wood", "Wood") })
                @Slot("window", "Viewport", new[] { ("arched", "Arched"), ("wide", "Wide"), ("porthole", "Porthole") })
                @Slot("view", "Beyond the glass", new[] { ("", "Your seat's world"), ("terran", "A green world"), ("ocean", "An ocean world"), ("forge", "A forge-world"), ("frozen", "An ice world"), ("arid", "A desert world"), ("gas", "A gas giant"), ("barren", "A dead rock") })
                @Slot("desk", "Desk", new[] { ("oak", "Oak"), ("steel", "Steel"), ("marble", "Marble") })
                @Slot("decor", "The far wall", new[] { ("chart", "Star chart"), ("trophies", "Trophy case"), ("archive", "The archive") })
            </div>
        }
    </div>

    <aside class="office-side">
        <section class="panel who">
            <div class="who-head"><div><h2>@p.Name</h2><div class="sub">@m.Character.RankName of @house.Name · @m.Character.TitleName · age @p.Age</div></div></div>
            <div class="traits">
                @foreach (var t in m.Character.Nature) { <span class="trait nature" title="@TraitDesc(t)">@TraitName(t)</span> }
                @foreach (var t in m.Character.Aptitude) { <span class="trait apt" title="@TraitDesc(t)">@TraitName(t)</span> }
            </div>
            <div class="kv"><span><Icon Name="ambition" Size="13" /> Ambition</span><b>@m.Character.AmbitionName</b></div>
            @if (m.Character.Background != null) { <div class="kv"><span>Background</span><b>@m.Character.Background</b></div> }
            <div class="kv"><span><Icon Name="stress" Size="13" /> Stress</span><b class="@(p.Stress >= 70 ? "warn" : "")">@p.Stress@(m.Character.Broken ? " · broken" : "")</b></div>
            <div class="kv"><span>Skills</span><b>@string.Join(" · ", p.Skills.Where(k => k.Value > 0).OrderByDescending(k => k.Value).Take(4).Select(k => $"{k.Key} {k.Value}"))</b></div>
        </section>
        <section class="panel">
            <h3><Icon Name="turn" Size="13" /> Since your last turn</h3>
            @if (since.Count == 0) { <div class="muted">Nothing of note.</div> }
            @foreach (var h in since) { <div class="line">@h.Text</div> }
        </section>
        @if (m.GreatCrisis is { } gc)
        {
            <section class="panel great @(gc.Resolved ? "resolved" : "")">
                <h3><Icon Name="crisis" Size="13" /> @gc.Name</h3>
                <div class="kv"><span>Stage</span><b>@(gc.Resolved ? "resolved" : gc.Stage ?? "not yet")</b></div>
                <div class="kv"><span>Clock</span><b>@gc.Clock@(gc.NextAt != null ? $" / {gc.NextAt}" : "")</b></div>
                @if (gc.Bloc.Length > 0) { <div class="kv"><span>Your bloc</span><b>@gc.Bloc</b></div> }
                @if (gc.HegemonName != null) { <div class="kv"><span>Hegemon</span><b>@gc.HegemonName</b></div> }
            </section>
        }
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    [Parameter] public EventCallback<BriefingCard> OnOpenReport { get; set; }
    private bool _customize; private ElementReference _host; private readonly string _id = Guid.NewGuid().ToString("N");
    private DotNetObjectReference<OfficeScreen>? _self; private bool _created; private string _pending = "", _sent = "";
    private List<(BriefingCard card, Character? ch)> _visitors = new();

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first) { _self = DotNetObjectReference.Create(this); try { if (await JS.InvokeAsync<bool>("praetoria.ready", "praetoriaOffice")) { await JS.InvokeVoidAsync("praetoriaOffice.create", _id, _host, _self); _created = true; } } catch { } }
        if (_created && _pending != _sent) { _sent = _pending; try { await JS.InvokeVoidAsync("praetoriaOffice.build", _id, _pending); } catch { } }
        try { await JS.InvokeVoidAsync("praetoriaBust.paint"); } catch { }
    }

    [JSInvokable] public async Task OnVisitor(int index) { if (index >= 0 && index < _visitors.Count) await OnOpenReport.InvokeAsync(_visitors[index].card); }

    private string Cos(string slot, string dflt) => G.World!.Cosmetics.TryGetValue(slot, out var v) ? v : dflt;
    private void Set(string slot, string value) { if (value == "") G.World!.Cosmetics.Remove(slot); else G.World!.Cosmetics[slot] = value; }
    private RenderFragment Slot(string slot, string label, (string id, string name)[] options) => __builder =>
    {
        string cur = Cos(slot, options[0].id);
        <div class="slot"><span class="slot-label">@label</span>@foreach (var o in options) { <button class="chip @(cur == o.id ? "on" : "")" @onclick="() => Set(slot, o.id)">@o.name</button> }</div>
    };
    private string TraitName(string id) => G.Content!.Traits.Nature.Concat(G.Content.Traits.Aptitude).FirstOrDefault(t => t.Id == id)?.Name ?? id;
    private string TraitDesc(string id) => G.Content!.Traits.Nature.Concat(G.Content.Traits.Aptitude).FirstOrDefault(t => t.Id == id)?.Description ?? "";

    private string BuildOptions(World w, Character p, House house, Holding? seat, StarSystem? seatSys, string viewClass, int honors)
    {
        var nodes = GalaxyProjection.Nodes(w); double cx = nodes.Average(n => n.X), cy = nodes.Average(n => n.Y);
        var chart = new { nodes = nodes.Select(n => new { id = n.SystemId, x = n.X - cx, y = n.Y - cy, color = n.OwnerHouseId != null ? n.AccentColor : "#55617a", mine = n.IsPlayerTerritory }).ToList(), lanes = GalaxyProjection.Lanes(w).Select(l => new { a = l.A, b = l.B }).ToList() };
        object Plate(Character ch) => new { name = ch.Name, accent = w.House(ch.HouseId)?.AccentColor ?? "#888", bust = new { id = ch.Id, sex = ch.Sex.Length > 0 ? ch.Sex : "male", age = ch.Age, accent = w.House(ch.HouseId)?.AccentColor ?? "#888", alive = ch.Alive } };
        return System.Text.Json.JsonSerializer.Serialize(new
        {
            accent = house.AccentColor, houseId = house.Id, seed = seat?.SystemId ?? house.Id, role = RoleTheme.Of(w), planetClass = viewClass, planetUrl = (string?)null,
            wall = Cos("wall", "stone"), floor = Cos("floor", "slate"), window = Cos("window", "arched"), desk = Cos("desk", "oak"), decor = Cos("decor", "chart"), honors,
            player = Plate(p), visitors = _visitors.Select(v => v.ch != null ? Plate(v.ch) : (object)new { name = "A courier", accent = "#c9a24a" }).ToList(), chart
        });
    }

    public async ValueTask DisposeAsync() { try { if (_created) await JS.InvokeVoidAsync("praetoriaOffice.destroy", _id); } catch { } _self?.Dispose(); }
}
