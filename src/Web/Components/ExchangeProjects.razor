@inject GameClient G
@using Praetoria.Core.Presentation
@* The Exchange's Projects tab (docs/ECONOMY_MARKET.md stage B): what is being built, each a row (docs/VISUAL_SYSTEM.md 4.7) with
   the work's painting, how far built as a meter, what is paid and what is owed, and under it the year's next instalment and what can
   be done (pause, a gang of the house's men, pay a missed instalment, hasten a great work or rush the rest, abandon). How building
   works is the section's "i". *@
@{
    var m = Model; var w = G.World!; var pid = w.ProtagonistId; var projects = m.Assets?.Projects ?? new List<ProjectCard>();
}
<p class="ui-lede ex-lede">@HouseScreen.Bold(projects.Count == 0 ? "Nothing is being built." : $"{Counted.Sites(projects.Count)} {(projects.Count == 1 ? "is" : "are")} being built{(projects.Count(p => p.Stalled) is > 0 and var st ? $", {st} of {(projects.Count == 1 ? "it" : "them")} stalled for want of the instalment" : "")}. Each is paid by the year and done when its last year is up.")</p>
@if (projects.Count == 0)
{
    <EmptyState Icon="build" Text="A site would show here with its years left, what is paid and what is still owed, and could be paused, rushed or abandoned." LinkLabel="Build on a world of yours: the House" OnLink='() => OnGo.InvokeAsync("house:estate")' />
    <div class="hs-line ex-empty-links"><Link Label="Found or enlarge a venture: Ventures" OnClick='() => OnTab.InvokeAsync("ventures")' /></div>
}
<Section Title="Under construction" Count="@projects.Count.ToString()" Info="@HowItWorks" IsEmpty="@(projects.Count == 0)">
    <Right><span>Paid by the year</span></Right>
    <ChildContent>
    @foreach (var p in projects)
    {
        int done = p.TurnsTotal - p.TurnsLeft; string kind = p.Kind == "building" ? "building" : p.Kind == "venture" ? "new venture" : p.Kind == "work" ? (p.Great ? "great work" : "building in a system") : p.Kind == "colony" ? "colony" : p.Kind == "infra" ? "infrastructure" : p.Kind == "upgrade" ? "a building taken a level higher" : p.Kind == "province" ? "building in a province" : "enlargement";
        var raw = w.Projects.FirstOrDefault(x => x.Id == p.Id); string pidr = p.Id;
        <div class="vcard ex-project @(p.Stalled ? "distress" : "")" data-project="@p.Id">
            <Row Name="@Cap(p.Name)" SubText="@($"{kind}{(p.CompanyName != null ? $" · paid by {p.CompanyName}" : "")}")">
                <Picture>@if (raw != null && G.WorkPicture(raw.DefId) is { } art) { <span class="ui-thumb"><img src="@art" alt="" loading="lazy" /></span> } else { <span class="ui-thumb hs-thumb-none"><Icon Name="@(p.Great ? "greek-temple" : "build")" Tone="brass" Size="20" /></span> }</Picture>
                <NameExtra>@if (p.Paused) { <span class="hs-tag">paused</span> } else if (p.Stalled) { <span class="hs-tag bad" title="The instalment was not met">stalled</span> } else { <span class="hs-tag gold">@Counted.Years(p.TurnsLeft) left</span> }</NameExtra>
                <Cells>
                    <span class="ui-cell" title="What is paid so far">@p.Paid<small>&nbsp;paid</small></span>
                    <span class="ui-cell" title="What is still owed">@p.Remaining<small>&nbsp;owed</small></span>
                </Cells>
            </Row>
            <div class="ex-under">
                <Meter Label="Built" Value="@done" Max="@Math.Max(1, p.TurnsTotal)" Text="@($"{done} of {p.TurnsTotal}")" Color="#c9a24a" Tip="Years built of the whole" Class="ex-built" />
                <p class="hs-note">Next year: @(p.Hastened && p.Great && p.TurnsLeft > 1 ? p.HastenYear + " (hastened: " + p.HastenExtra + " of it for the speed)" : p.Next)@if (p.HastenMissed) { <span class="ui-warn-t" data-hasten-missed> · not hastened last year: the treasury could not stand it</span> }</p>
                @if (p.CompanyName == null)
                {
                    <div class="hs-acts ex-row">
                        <Plate Label="@(p.Paused ? "Resume" : "Pause")" Small="true" Tip="@(p.Paused ? "Take the work up again" : "A paused site costs nothing and goes nowhere")" OnClick="() => G.Execute(new PauseProjectCommand(pid, pidr))" />
                        @if (raw is { CompanyId.Length: 0 })
                        {
                            /* a gang of the house's men: two years' work in one, for manpower each year it is on the work */
                            bool gang = raw.Gang; var gc = new WorkGangCommand(pid, p.Id, !gang, G.Content!.Holdings); string? gno = gc.Refusal(G.Ctx); int gm = G.Content.Holdings.Rules.GangManpower;
                            <Plate Label="@(gang ? "Call the gang off" : "Put a gang on it")" Icon="manpower" Small="true" Class="@(gang ? "down" : "")" CostIcon="@(gang ? "" : "manpower")" CostText="@(gang ? "" : $"{gm} a year")" data-gang="@p.Id" Locked="@(gno != null)" Disabled="@(gno != null)" ShowNeed="false" Need="@(gno ?? "")"
                                   Tip="@(gang ? $"A gang is on it: it goes two years in one, for {gm} manpower a year and both years' instalments. A year the house cannot find the men or the instalments, it goes at its own pace. Call them off and it does so from now on." : $"Put men of the house to it: it goes two years in one while they are on it, for {gm} manpower a year and both years' instalments, and no coin beyond those. The men are not lost: the house musters {gm} fewer each year the work lasts.")" OnClick="() => G.Execute(gc)" />
                        }
                        @if (p.Stalled) { var payNo = new PayInstalmentCommand(pid, p.Id).Refusal(G.Ctx); <Plate Label="Pay the instalment now" Small="true" CostText="@p.Next" data-paynow="@p.Id" Locked="@(payNo != null)" Disabled="@(payNo != null)" ShowNeed="false" Need="@(payNo ?? "")" Tip="@("Pay the instalment that was missed (" + p.Next + ") now: the work goes on and the lost year is made up")" OnClick="() => G.Execute(new PayInstalmentCommand(pid, pidr))" /> }
                        @if (p.Great)
                        {
                            bool on = p.Hastened;
                            <Plate Label="@(on ? "Hastened: stop" : "Hasten")" Icon="hourglass" Small="true" Class="@(on ? "down" : "")" CostText="@(on ? "" : p.HastenYear + " a year")" Disabled="@(p.TurnsLeft <= 1)" Tip="@(on ? "It goes two years in one: this year " + p.HastenYear + ", of which " + p.HastenExtra + " buys only the speed. A year the purse cannot stand it, it goes at its own pace." : "Two years' work in one, every year it is hastened: " + p.HastenYear + " a year, of which " + p.HastenExtra + " buys only the speed.")" OnClick="() => G.Execute(new HastenWorkCommand(pid, pidr, !on, G.Content!.Holdings))" />
                        }
                        else
                        {
                            <Plate Label="Rush" Icon="hourglass" Small="true" CostText="@($"{p.Remaining} and {Money.Show(p.RushCredits)} more")" Locked="@(p.RushRefusal != null)" Disabled="@(p.RushRefusal != null)" ShowNeed="false" Need="@(p.RushRefusal ?? "")" Tip="@("Everything still owed is paid now, and " + Money.Show(p.RushCredits) + " credits more for the haste: it is done next year")" OnClick="() => G.Execute(new RushProjectCommand(pid, pidr))" />
                        }
                        <Plate Label="Abandon" Small="true" CostText="@($"get back {p.Refund}")" Tip="Half of what was paid comes back" OnClick='() => G.AskDo("Abandon " + p.Name + "?", "The site is cleared. Of the " + p.Paid + " paid so far, " + p.Refund + " comes back and the rest is lost. It cannot be taken up again where it was left.", "Abandon it", new AbandonProjectCommand(pid, pidr))' />
                    </div>
                }
            </div>
        </div>
    }
    </ChildContent>
</Section>

@code {
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    [Parameter] public EventCallback<string> OnTab { get; set; }
    [Parameter] public EventCallback<string> OnGo { get; set; }
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    private static readonly string HowItWorks = string.Join("\n", new[]
    {
        "[build] How building works",
        "By the year: the cost is split evenly over the build time. The first share is paid on the day; the rest a year at a time.",
        "Stalled: a year the share cannot be met, nothing is built. It resumes when the treasury can pay.",
        "Paused: a paused site costs nothing and goes nowhere.",
        "Great works: a great work is not bought outright. It can be hastened: two years' work in one, for both years' shares and half as much again, every year it is hastened.",
        "Rushed: pay all that is owed and a quarter more in credits, and it is done next year.",
        "Abandoned: half of what was paid comes back.",
        "How long: most buildings a year; works on a deposit and the costly ones two; a megastructure four. Ventures one or two."
    });
}
