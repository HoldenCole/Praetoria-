@inject GameClient G
@inject IJSRuntime JS
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var p = w.Protagonist!; var mine = w.House(p.HouseId)!;
    var ctx = new CommandContext(w, new Praetoria.Core.Rng.SplitMix64Rng(0)); var senate = G.Turn!.Senate;
    var conns = m.Connections.ToDictionary(x => x.Id);
    var housesAll = w.Houses.Values.Where(h => h.Id != mine.Id && h.Id != PirateSystem.HouseId);
    int Disp(House h) { var ms = w.LivingCharacters().Where(x => x.HouseId == h.Id).ToList(); return ms.Count == 0 ? 0 : (int)ms.Average(x => w.GetRelationship(x.Id, pid)?.Disposition ?? 0); }
    var houses = (_sort switch { "wealth" => housesAll.OrderByDescending(h => h.Wealth), "senate" => housesAll.OrderByDescending(h => h.Order(OrderSystem.Senate)), "arms" => housesAll.OrderByDescending(h => h.Order(OrderSystem.Arms)), "commerce" => housesAll.OrderByDescending(h => h.Order(OrderSystem.Commerce)), "disposition" => housesAll.OrderByDescending(Disp), "hulls" => housesAll.OrderByDescending(h => FleetSystem.StrengthOf(w, h.Id)), "seats" => housesAll.OrderByDescending(h => senate.Weight(w, h.Id)), "worlds" => housesAll.OrderByDescending(h => w.HoldingsOf(h.Id).Count(x => x.IsPlanet)), _ => housesAll.OrderByDescending(h => c.Titles.RankOf(h.Title)).ThenByDescending(h => h.Legitimacy) }).ThenBy(h => h.Id, StringComparer.Ordinal).ToList();
    _focus ??= houses.FirstOrDefault()?.Id;
    int great = houses.Count(h => w.HoldingsOf(h.Id).Any(x => x.IsPlanet)), wars = houses.Count(h => w.AtWar(mine.Id, h.Id));
    var fh = _focus != null ? w.House(_focus) : null;
    int maxHulls = Math.Max(1, w.Houses.Values.Where(h => h.Id != PirateSystem.HouseId).Max(h => FleetSystem.StrengthOf(w, h.Id))), maxSeats = Math.Max(1, w.Houses.Values.Where(h => h.Id != PirateSystem.HouseId).Max(h => senate.Weight(w, h.Id))), maxWorlds = Math.Max(1, w.Houses.Values.Max(h => w.HoldingsOf(h.Id).Count(x => x.IsPlanet)));
    string capLine = m.Capital == null ? "" : " · the capital " + m.Capital.SystemName + " is " + (m.Capital.Mine ? "yours" : m.Capital.HolderName != null ? m.Capital.HolderName + "'s" : "masterless");
    int myRank = 1 + housesAll.Count(h => c.Titles.RankOf(h.Title) > c.Titles.RankOf(mine.Title) || (c.Titles.RankOf(h.Title) == c.Titles.RankOf(mine.Title) && h.Legitimacy > mine.Legitimacy));

    // The picture (docs/DASHBOARDS.md): where you stand among the houses, who is with you and against you, and who is strongest.
    var regard = houses.ToDictionary(h => h.Id, Disp);
    var warring = houses.Where(h => w.AtWar(mine.Id, h.Id)).ToList(); var friends = houses.Where(h => regard[h.Id] > 20).ToList(); var enemies = houses.Where(h => regard[h.Id] < -20).ToList();
    var warmest = houses.OrderByDescending(h => regard[h.Id]).ThenBy(h => h.Id, StringComparer.Ordinal).FirstOrDefault(); var coldest = houses.OrderBy(h => regard[h.Id]).ThenBy(h => h.Id, StringComparer.Ordinal).FirstOrDefault();
    var strongest = houses.OrderByDescending(h => FleetSystem.StrengthOf(w, h.Id)).ThenBy(h => h.Id, StringComparer.Ordinal).FirstOrDefault(); int myHulls = FleetSystem.StrengthOf(w, mine.Id), theirHulls = strongest != null ? FleetSystem.StrengthOf(w, strongest.Id) : 0;
    var richest = houses.OrderByDescending(h => h.Wealth).ThenBy(h => h.Id, StringComparer.Ordinal).FirstOrDefault();
    static string Signed(int n) => (n > 0 ? "+" : n < 0 ? "−" : "") + Math.Abs(n);
    string by = w.IsImperium ? "title" : "rank";
    string story, storyTone;
    if (warring.Count > 0) { story = $"You are at war with {string.Join(" and ", warring.Take(2).Select(h => h.Name))}{(warring.Count > 2 ? $" and {warring.Count - 2} more" : "")}. You stand {Ordinal(myRank)} of {houses.Count + 1} houses by {by}, with {Counted.Hulls(myHulls)} to {(strongest != null ? $"{strongest.Name}'s {theirHulls}, the most of any" : "nobody's")}."; storyTone = "bad"; }
    else if (enemies.Count > friends.Count && coldest != null) { story = $"More houses think ill of you than well: {enemies.Count} against {friends.Count}. {coldest.Name} think worst of you ({Signed(regard[coldest.Id])}). You stand {Ordinal(myRank)} of {houses.Count + 1} by {by}."; storyTone = "warn"; }
    else { story = $"You stand {Ordinal(myRank)} of {houses.Count + 1} houses by {by}, at war with none. {(friends.Count == 0 ? "None" : friends.Count.ToString())} think well of you and {(enemies.Count == 0 ? "none" : enemies.Count.ToString())} ill"
            + (strongest != null ? (theirHulls > myHulls ? $"; {strongest.Name} are strongest in arms, with {Counted.Hulls(theirHulls)} to your {myHulls}." : $"; no house has more hulls than your {myHulls}.") : "."); storyTone = ""; }
}
<div class="dash gallery" style="--accent:@mine.AccentColor">
    <header class="dash-head picture">
        <div class="dh-title"><Icon Name="houses" Size="18" /> <b>The Houses of @(w.Era == "imperium" ? "the Imperium" : "the Reach")</b> <span class="muted">@(houses.Count + 1) houses · @great hold worlds · @(houses.Count - great) hold stations or a name@(capLine)</span></div>
        <p class="headline @storyTone">@story</p>
        <div class="tiles">
            <Tile Label="Your standing" Value="@($"{Ordinal(myRank)} of {houses.Count + 1}")" Share="@(100 * (houses.Count + 1 - myRank) / Math.Max(1, houses.Count))" Tone="@(myRank * 3 <= houses.Count + 1 ? "good" : "")" Note="@($"by {by}, then by legitimacy")" Title="The bar is how many houses stand below you." />
            <Tile Label="At war with you" Value="@(warring.Count == 0 ? "none" : warring.Count.ToString())" Tone="@(warring.Count > 0 ? "bad" : "good")" Note="@(warring.Count == 0 ? "no house is in arms against you" : string.Join(", ", warring.Take(2).Select(h => h.Name)) + (warring.Count > 2 ? " and others" : ""))" />
            <Tile Label="Think well of you" Value="@friends.Count.ToString()" Share="@(houses.Count > 0 ? 100 * friends.Count / houses.Count : 0)" Tone="@(friends.Count > enemies.Count ? "good" : "")" Note="@(warmest != null ? $"of {houses.Count} · warmest: {warmest.Name} {Signed(regard[warmest.Id])}" : "")" Title="Houses whose people regard you at more than +20, on average." />
            <Tile Label="Think ill of you" Value="@enemies.Count.ToString()" Share="@(houses.Count > 0 ? 100 * enemies.Count / houses.Count : 0)" Tone="@(enemies.Count > friends.Count ? "warn" : "")" Note="@(coldest != null ? $"of {houses.Count} · coldest: {coldest.Name} {Signed(regard[coldest.Id])}" : "")" Title="Houses whose people regard you at less than −20, on average." />
            @if (strongest != null) { <Tile Label="Strongest in arms" Value="@($"{theirHulls} hulls")" Share="@(theirHulls > 0 ? 100 * myHulls / Math.Max(myHulls, theirHulls) : 0)" Tone="@(myHulls >= theirHulls ? "good" : myHulls * 2 < theirHulls ? "warn" : "")" Note="@($"{strongest.Name} · you have {myHulls}")" Title="The bar is your hulls against theirs." /> }
            @if (richest != null) { <Tile Label="Richest" Value="@Money.Show(richest.Wealth)" Share="@(richest.Wealth > 0 ? Math.Clamp(100 * mine.Wealth / Math.Max(mine.Wealth, richest.Wealth), 0, 100) : 0)" Tone="@(mine.Wealth >= richest.Wealth ? "good" : "")" Note="@($"{richest.Name} · you have {Money.Show(mine.Wealth)}")" Title="The bar is your wealth against theirs." /> }
        </div>
    </header>
    <div class="dash-grid gallery-grid">
        @if (!_open) {
        <section class="panel">
            <h3><Icon Name="houses" Size="13" /> The standings <span class="muted">click a house</span></h3>
            <div class="vols">@foreach (var k in new[] { "title", "worlds", "hulls", "seats", "wealth", "senate", "arms", "commerce", "disposition" }) { <button class="rung @(_sort == k ? "here" : "")" @onclick="() => _sort = k">by @(k == "title" && !w.IsImperium ? "rank" : k)</button> }</div>
            <table class="standings">
                <thead><tr><th>House</th><th>@(w.IsImperium ? "Title" : "Rank")</th><th>Worlds</th><th>Hulls</th><th>Seats</th><th title="What the house would fetch sold up, in credits: its treasury, its stores at two-thirds of the market, its worlds and what is built on them, its ventures and shares, less what it owes.">Wealth</th><th title="The house's standing in the three orders, one letter each: S the Senate, A arms, C commerce. A bright letter is great or dominant in that order, a dim one notable, a missing one of no account.">Orders (S·A·C)</th><th>Toward you</th><th>Bench</th></tr></thead>
                <tbody>
                @foreach (var h in houses.Prepend(mine))
                {
                    int worlds = w.HoldingsOf(h.Id).Count(x => x.IsPlanet), hulls = FleetSystem.StrengthOf(w, h.Id), seats = senate.Weight(w, h.Id); int disp = h.Id == mine.Id ? 0 : Disp(h); bool atWar = w.AtWar(mine.Id, h.Id); var bench = FactionSystem.Of(w, h.Id);
                    <tr class="@(h.Id == mine.Id ? "mine" : "") @(h.Id == _focus ? "here" : "") @(atWar ? "hostile" : "")" @onclick="() => { _focus = h.Id; _open = true; }" title="Open this house">
                        <td class="hn"><Sigil HouseId="@h.Id" Accent="@h.AccentColor" Size="16" /> <b>@h.Name</b>@if (m.Capital?.HolderId == h.Id) { <span class="tier small opulent">capital</span> }@if (h.Bloc == RegionSystem.FreeholdsBloc) { <span class="tier small destitute">free hold</span> }@if (ThroneSystem.Emperor(w)?.Id == h.Id) { <span class="tier small opulent">throne</span> }</td>
                        <td class="muted">@(c.Titles.NameOf(h.Title, G.World!.Era))</td>
                        <td><span class="mbar"><i style="width:@(100 * worlds / maxWorlds)%; background:@h.AccentColor"></i></span>@worlds</td>
                        <td><span class="mbar"><i style="width:@(100 * hulls / maxHulls)%; background:@h.AccentColor"></i></span>@hulls</td>
                        <td><span class="mbar"><i style="width:@(100 * seats / maxSeats)%; background:@h.AccentColor"></i></span>@seats</td>
                        <td>@if (w.Foreign(h.Id)) { <span class="muted small" title="A nation beyond the Reach: its wealth is its own treasury and trade, and is not ranked among the houses.">a nation</span> } else { <span class="tier small @Wealth.TierFor(w, h.Id)" title="wealth @Money.Show(h.Wealth): ranked among the houses of the Reach (the top sixth opulent, the next quarter rich, the bottom quarter poor)">@Wealth.TierFor(w, h.Id)</span> }</td>
                        <td class="ord" title="@OrderSystem.CallingName(h.Calling): the Senate @h.Order(OrderSystem.Senate), Arms @h.Order(OrderSystem.Arms), Commerce @h.Order(OrderSystem.Commerce)">@foreach (var o in OrderSystem.All) { <span class="ordpip t@(OrderSystem.Tier(h, o)) @(h.Calling == o ? "calling" : "")">@(o == OrderSystem.Senate ? "S" : o == OrderSystem.Arms ? "A" : "C")</span> }</td>
                        <td>@if (h.Id != mine.Id) { <span class="pill @(atWar ? "warn" : disp < -20 ? "warn" : disp > 20 ? "good" : "")">@(atWar ? "⚔ " : "")@(disp >= 0 ? "+" : "")@disp</span> } else { <span class="muted">—</span> }</td>
                        <td class="muted small">@(bench?.Name ?? "")</td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
        }

        @if (_open) {
        <button class="rung back" @onclick="() => _open = false">‹ All the houses</button>
        <aside class="dash-side">
        @if (fh != null)
        {
            var members = w.LivingCharacters().Where(x => x.HouseId == fh.Id).OrderByDescending(x => x.CareerRank).ThenBy(x => x.Id, StringComparer.Ordinal).ToList();
            var head = members.FirstOrDefault(); int disp = members.Count == 0 ? 0 : (int)members.Average(x => w.GetRelationship(x.Id, pid)?.Disposition ?? 0);
            var worlds = w.HoldingsOf(fh.Id).Where(x => x.IsPlanet).ToList(); var stations = w.HoldingsOf(fh.Id).Where(x => !x.IsPlanet).ToList(); bool atWar = w.AtWar(mine.Id, fh.Id);
            var offDefault = c.Policies.Laws.Where(l => PolicySystem.HoldsScope(w, fh.Id, l.Scope) && PolicySystem.OptionId(w, c.Policies, fh.Id, l.Id) != l.DefaultOption.Id).Select(l => c.Policies.Law(l.Id)!.Option(PolicySystem.OptionId(w, c.Policies, fh.Id, l.Id))?.Name.ToLowerInvariant()).Where(x => x != null).ToList();
            var moods = c.Policies.Estates.Select(e => (e, a: PolicySystem.Approval(w, fh.Id, e.Id))).Where(x => x.a <= PolicySystem.Hostile || x.a >= PolicySystem.Loyal).ToList();
            <section class="panel focus-house" style="--accent:@fh.AccentColor">
                <div class="who-head"><Sigil HouseId="@fh.Id" Accent="@fh.AccentColor" Size="44" /><div><h2>@fh.Name</h2><div class="sub">@(c.Titles.NameOf(fh.Title, G.World!.Era)) · @fh.Culture culture@(fh.Bloc.Length > 0 ? $" · bloc {fh.Bloc}" : "")</div></div>
                    @if (fh.Id != mine.Id) { <span class="pill @(disp < -20 ? "warn" : disp > 20 ? "good" : "")">@(disp >= 0 ? "+" : "")@disp</span> }@if (atWar) { <span class="pill warn">AT WAR</span> }</div>
                <div class="kv"><span>Known as</span><b>@OrderSystem.CallingName(fh.Calling)@(fh.Origin == "new" ? " · a new name" : " · an old name") · @string.Join(" · ", OrderSystem.All.Select(o => $"{OrderSystem.Name(o)} {fh.Order(o)} ({OrderSystem.TierName(OrderSystem.Tier(fh, o))})"))</b></div>
                @if (fh.PatronId.Length > 0 || OrderSystem.ClientsOf(w, fh.Id).Any() || fh.Corners.Count > 0) { <div class="kv"><span>Ties</span><b>@(fh.PatronId.Length > 0 ? $"client of {w.House(fh.PatronId)?.Name}" : "")@(OrderSystem.ClientsOf(w, fh.Id).Any() ? $"patron of {string.Join(", ", OrderSystem.ClientsOf(w, fh.Id).Select(x => x.Name))}" : "")@(fh.Corners.Count > 0 ? $" · makes a quarter of the Reach's {string.Join(", ", fh.Corners.Select(g => Resource.Label(g)))}" : "")</b></div> }
                @if (CornerSystem.HeldBy(w, fh.Id).Any()) { <div class="kv" data-market-corner="@fh.Id"><span>Corner</span><b title="It holds half or more of all there is in the Reach, the merchants' stock and every house's store together. See the Exchange, Goods.">holds a corner in @string.Join(", ", CornerSystem.HeldBy(w, fh.Id).Select(g => Resource.Label(g)))</b></div> }
                @if (fh.Id != mine.Id && !w.IsImperium)
                {
                    var os = G.Turn!.Orders; var fid = fh.Id; var sw = OrderSystem.Sway(w, fh, mine); var back = OrderSystem.Sway(w, mine, fh);
                    @if (sw.lean > 0) { <div class="kv"><span>Leans your way</span><b class="good">+@sw.lean · @string.Join(", ", sw.why)</b></div> }
                    @if (back.lean > 0) { <div class="kv"><span>You depend on it</span><b>@string.Join(", ", back.why)</b></div> }
                    var take = os.TakeClientRefusal(w, mine, fh); var seek = os.SeekPatronRefusal(w, mine, fh);
                    <div class="row small">
                        @if (fh.PatronId == mine.Id) { <button class="opt inline tiny" @onclick="() => G.Execute(new ClientCommand(pid, ClientCommand.Release, fid, os))">Turn the client away</button> }
                        else { <button class="opt inline tiny" disabled="@(take != null)" title="@(take ?? "pay its debts and a gift: it votes for your house's candidate at an election, unless one of its own stands, and leans the way you vote in the chamber, once you have voted; 100 credits a year to keep")" @onclick="() => G.Execute(new ClientCommand(pid, ClientCommand.Take, fid, os))">Take as a client · @Money.Show(OrderSystem.ClientCost(fh))</button> }
                        @if (mine.PatronId == fh.Id) { <button class="opt inline tiny" @onclick="() => G.Execute(new ClientCommand(pid, ClientCommand.Leave, string.Empty, os))">Leave its protection</button> }
                        else { <button class="opt inline tiny" disabled="@(seek != null)" title="@(seek ?? "100 credits a year from it, its backing and its clients' in the chamber; your vote is expected at the election")" @onclick="() => G.Execute(new ClientCommand(pid, ClientCommand.Seek, fid, os))">Seek it as a patron</button> }
                    </div>
                }
                @if (fh.Id != mine.Id && !World.Outsider(fh.Id))
                {
                    /* dealings between houses (docs/WEALTH.md): a gift, a favour asked and called in, a vote pledged, a threat, a loan, and what lasts */
                    var dl = G.Turn!.Dealings; string did = fh.Id; var theirHead = Economy.HeadOf(w, fh); int headRegard = DealingsSystem.RegardOf(w, fh, mine);
                    var docket = SenateSystem.Docket(w).Take(5).ToList(); bool owesMe = WealthSystem.FavourOwed(w, did, mine.Id); var myLoan = DealingsSystem.LoanBetween(w, mine.Id, did);
                    var lasting = dl.Lasting(w, mine, fh); var noCoin = Deal(DealingsCommand.AskCoin, did).Refusal(G.Ctx); var noThreat = Deal(DealingsCommand.Threat, did).Refusal(G.Ctx);
                    <h4 data-dealings="@did">Dealings <span class="muted small">@(theirHead != null ? theirHead.Name : fh.Name) thinks @Signed(headRegard) of you · your treasury holds @Money.Show(mine.Treasury.Credits)</span></h4>
                    <div class="row small" data-dealing="gift">
                        <span class="muted">Send a gift of</span>
                        @foreach (int sum in DealingsSystem.GiftSizes) { int amt = sum; var noGift = Deal(DealingsCommand.Gift, did, amt.ToString()).Refusal(G.Ctx); <button class="opt inline tiny" data-gift="@amt" disabled="@(noGift != null)" title="@(noGift ?? dl.GiftSays(w, fh, amt))" @onclick="() => G.Execute(Deal(DealingsCommand.Gift, did, amt.ToString()))">@Money.Show(amt)</button> }
                        <span class="muted">from the treasury</span>
                    </div>
                    <div class="row small" data-dealing="favour">
                        <button class="opt inline tiny" data-ask-coin="@did" disabled="@(noCoin != null)" title="@(noCoin ?? dl.AskSays(w, fh, DealingsSystem.Coin))" @onclick="() => G.Execute(Deal(DealingsCommand.AskCoin, did))">Ask a favour: coin · @Money.Show(AskAbove.CoinOf(fh))</button>
                        @if (owesMe)
                        {
                            var noMoney = new WealthCommand(pid, WealthCommand.Favour, did, WealthSystem.ForMoney).Refusal(G.Ctx); var noMatch = new WealthCommand(pid, WealthCommand.Favour, did, WealthSystem.ForMatch).Refusal(G.Ctx);
                            <button class="opt inline tiny" data-call-money="@did" disabled="@(noMoney != null)" title="@(noMoney ?? CallMoneySays)" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Favour, did, WealthSystem.ForMoney))">Call in its favour · @Money.Show(WealthSystem.FavourCredits)</button>
                            <button class="opt inline tiny" data-call-match="@did" disabled="@(noMatch != null)" title="@(noMatch ?? CallMatchSays)" @onclick="() => G.Execute(new WealthCommand(pid, WealthCommand.Favour, did, WealthSystem.ForMatch))">Call it in for consent to the match</button>
                        }
                        @if (DealingsSystem.Called(w, mine.Id, did))
                        {
                            var noPay = Deal(DealingsCommand.Honour, did).Refusal(G.Ctx);
                            <button class="opt inline tiny" data-honour="@did" disabled="@(noPay != null)" title="@(noPay ?? HonourSays)" @onclick="() => G.Execute(Deal(DealingsCommand.Honour, did))">Pay the favour it called in · @Money.Show(WealthSystem.FavourCredits)</button>
                            <button class="opt inline tiny" data-break="@did" title="@BreakSays" @onclick="() => G.Execute(Deal(DealingsCommand.Break, did))">Refuse it</button>
                        }
                    </div>
                    @foreach (var mo in docket)
                    {
                        string mid = mo.Id; var noAsk = Deal(DealingsCommand.AskVote, did, mid).Refusal(G.Ctx); var noCall = Deal(DealingsCommand.CallVote, did, mid).Refusal(G.Ctx); var noPledge = Deal(DealingsCommand.Pledge, did, mid).Refusal(G.Ctx);
                        <div class="line small" data-dealing-motion="@mid">
                            <span title="@senate.Describe(w, mo)"><b>@MotionName(mo)</b> <span class="muted">@StandsOn(mo, fh)</span></span>
                            <button class="opt inline tiny" data-ask-vote="@mid" disabled="@(noAsk != null)" title="@(noAsk ?? dl.AskSays(w, fh, DealingsSystem.Vote))" @onclick="() => G.Execute(Deal(DealingsCommand.AskVote, did, mid))">Ask a favour: its vote</button>
                            @if (owesMe) { <button class="opt inline tiny" data-call-vote="@mid" disabled="@(noCall != null)" title="@(noCall ?? CallVoteSays)" @onclick="() => G.Execute(Deal(DealingsCommand.CallVote, did, mid))">Call in its favour for its vote</button> }
                            <button class="opt inline tiny" data-pledge="@mid" disabled="@(noPledge != null)" title="@(noPledge ?? dl.PledgeSays(w, mo, fh))" @onclick="() => G.Execute(Deal(DealingsCommand.Pledge, did, mid))">Pledge it your vote</button>
                        </div>
                    }
                    <div class="row small" data-dealing="threat">
                        <button class="opt inline tiny" data-threat="@did" disabled="@(noThreat != null)" title="@(noThreat ?? dl.ThreatSays(w, mine, fh))" @onclick="() => G.Execute(Deal(DealingsCommand.Threat, did))">Let it understand what your fleets could do</button>
                    </div>
                    <div class="row small" data-dealing="loan">
                        @if (myLoan == null)
                        {
                            <span class="muted">Lend at</span>
                            @foreach (int rate in DealingsSystem.LoanRates) { int rt = rate; <button class="opt inline tiny @(_rate == rt ? "here" : "")" data-loan-rate="@rt" title="@RateSays(fh)" @onclick="() => _rate = rt">@rt</button> }
                            <span class="muted">in the hundred, the sum of</span>
                            @foreach (int sum in DealingsSystem.LoanSizes) { int amt = sum; var noLend = Deal(DealingsCommand.Lend, did, amt.ToString(), _rate).Refusal(G.Ctx); <button class="opt inline tiny" data-lend="@amt" disabled="@(noLend != null)" title="@(noLend ?? dl.LendSays(w, fh, amt, _rate))" @onclick="() => G.Execute(Deal(DealingsCommand.Lend, did, amt.ToString(), _rate))">@Money.Show(amt)</button> }
                        }
                        else
                        {
                            var noPress = Deal(DealingsCommand.Press, did).Refusal(G.Ctx); var noForgive = Deal(DealingsCommand.Forgive, did).Refusal(G.Ctx);
                            <button class="opt inline tiny" data-forgive="@did" disabled="@(noForgive != null)" title="@(noForgive ?? ForgiveSays(myLoan))" @onclick="() => G.Execute(Deal(DealingsCommand.Forgive, did))">Forgive the @Money.Show(myLoan.Owed) it owes</button>
                            <button class="opt inline tiny" data-press="@did" disabled="@(noPress != null)" title="@(noPress ?? PressSays)" @onclick="() => G.Execute(Deal(DealingsCommand.Press, did))">Press for it</button>
                        }
                    </div>
                    <div data-dealing="lasting">
                        @foreach (var (text, tone) in lasting) { <div class="line small @tone">@text</div> }
                        @if (lasting.Count == 0) { <div class="line small muted">Nothing stands between your houses that is remembered: no favour, loan, gift, threat or pledge.</div> }
                    </div>
                    /* trade between houses (docs/WEALTH.md, "Trade between houses"): a lot out of its store or yours, a standing deal, and the deals in force */
                    var tr = G.Turn!.HouseTrade; var noTrade = HouseTradeSystem.WontTrade(w, mine, fh); var standing = HouseTradeSystem.Between(w, mine.Id, did).ToList();
                    <h4 data-trade="@did">Trade <span class="muted small">out of its store or yours, at the market's price with no caravaneer between you</span></h4>
                    @if (noTrade != null) { <div class="line small warn" data-trade-closed="@did">@Capital(noTrade).</div> }
                    <div class="trade-row" data-trade-terms="@did">
                        <span class="muted small">A lot of</span>
                        @foreach (int size in HouseTradeSystem.Lots) { int n = size; <button class="opt inline tiny @Here(_lot == n)" data-trade-lot="@n" title="How many units a purchase or a sale is for, and how many a year a standing deal sends." @onclick="() => _lot = n">@n</button> }
                        <span class="muted small">· a standing deal for</span>
                        @foreach (int span in HouseTradeSystem.Terms) { int y = span; <button class="opt inline tiny @Here(_term == y)" data-trade-term="@y" title="@HouseTradeSystem.RulesSay" @onclick="() => _term = y">@y</button> }
                        <span class="muted small">years</span>
                    </div>
                    @foreach (var gd in tr.Goods)
                    {
                        string gid = gd.Id; int lot = _lot, term = _term;
                        var buy = Trade(HouseTradeCommand.Buy, did, gid, lot); var sell = Trade(HouseTradeCommand.Sell, did, gid, lot); var bq = buy.Quote(w); var sq = sell.Quote(w);
                        var dealIn = Trade(HouseTradeCommand.DealBuy, did, gid, lot, term); var dealOut = Trade(HouseTradeCommand.DealSell, did, gid, lot, term); var noIn = dealIn.Refusal(G.Ctx); var noOut = dealOut.Refusal(G.Ctx);
                        <div class="trade-good" data-trade-good="@gid">
                            <div class="line small"><b>@gd.Name</b> <span class="muted">@TradeLine(tr, fh, mine, gid)</span></div>
                            <div class="trade-row">
                                <button class="opt inline tiny" data-trade-buy="@gid" disabled="@(bq.Refusal != null)" title="@(bq.Refusal ?? tr.BuySays(w, mine, fh, gid, lot))" @onclick="() => G.Execute(buy)">Buy @lot@(Sum(bq.Credits))</button>
                                <button class="opt inline tiny" data-trade-sell="@gid" disabled="@(sq.Refusal != null)" title="@(sq.Refusal ?? tr.SellSays(w, mine, fh, gid, lot))" @onclick="() => G.Execute(sell)">Sell @lot@(Sum(sq.Credits))</button>
                                <button class="opt inline tiny" data-trade-deal="@gid" disabled="@(noIn != null)" title="@(noIn ?? tr.DealSays(w, mine, fh, gid, lot, term, false))" @onclick="() => G.Execute(dealIn)">It sends @lot a year for @term years@(YearSum(noIn == null ? HouseTradeSystem.YearCost(tr.DealUnitCredits(w, mine, fh, gid, false), lot) : 0))</button>
                                <button class="opt inline tiny" data-trade-deal-sell="@gid" disabled="@(noOut != null)" title="@(noOut ?? tr.DealSays(w, mine, fh, gid, lot, term, true))" @onclick="() => G.Execute(dealOut)">You send @lot a year for @term years@(YearSum(noOut == null ? HouseTradeSystem.YearCost(tr.DealUnitCredits(w, mine, fh, gid, true), lot) : 0))</button>
                            </div>
                        </div>
                    }
                    <div data-trade-standing="@did">
                        @foreach (var td in standing)
                        {
                            string tid = td.Id; var end = Trade(HouseTradeCommand.End, did, string.Empty, 0, 0, tid); var noEnd = end.Refusal(G.Ctx);
                            <div class="line small" data-trade-in-force="@tid">@HouseTradeSystem.Describe(w, td, mine.Id) <button class="opt inline tiny" data-trade-end="@tid" disabled="@(noEnd != null)" title="@(noEnd ?? HouseTradeSystem.EndSays(w, td, mine.Id))" @onclick="() => G.Execute(end)">End it early</button></div>
                        }
                        @if (standing.Count == 0) { <div class="line small muted">No standing deal runs between your houses.</div> }
                    </div>
                }
                <div class="kv"><span>Legitimacy</span><b>@fh.Legitimacy</b></div>
                <details data-legitimacy-of="@fh.Id"><summary>What it is made of</summary><LegitimacyMade Card="@Praetoria.Core.Presentation.LegitimacyProjection.Of(w, fh)" /></details>
                <div class="kv"><span>Domain</span><b>@Counted.Worlds(worlds.Count) · @Counted.Stations(stations.Count)</b></div>
                <div class="kv"><span>Navy</span><b>@Counted.Hulls(FleetSystem.StrengthOf(w, fh.Id))@(FleetSystem.CampaignTarget(w, fh.Id) is { } ct ? $" · campaigning on {w.Galaxy?.System(ct)?.Name ?? ct}" : "")</b></div>
                <div class="kv"><span>Wealth</span><b>@Money.Show(fh.Wealth) · @if (w.Foreign(fh.Id)) { <span class="muted">a nation: not ranked among the houses</span> } else { <span class="tier @Wealth.TierFor(w, fh.Id)">@Wealth.TierFor(w, fh.Id)</span> }@(fh.Debt > 0 ? " · in debt" : "")</b></div>
                <div class="kv"><span>In the Senate</span><b>@Counted.Seats(senate.Weight(w, fh.Id))@(FactionSystem.Of(w, fh.Id) is { } fb ? $" · {fb.Name}{(fb.LeaderHouseId == fh.Id ? " (leads)" : "")}" : "")@(w.Counter("motions_passed:" + fh.Id) > 0 ? $" · {Counted.Motions(w.Counter("motions_passed:" + fh.Id))} carried" : "")@(SenateSystem.Embargoed(w, fh.Id) ? " · under embargo" : "")</b></div>
                @if (offDefault.Count > 0 || moods.Count > 0) { <div class="kv"><span>Law</span><b>@(offDefault.Count > 0 ? string.Join(", ", offDefault) : "the customary law")@(moods.Count > 0 ? " · " + string.Join(", ", moods.Select(x => $"{x.e.Name.Replace("The ", "").ToLowerInvariant()} {(x.a >= PolicySystem.Loyal ? "loyal" : "hostile")}")) : "")</b></div> }
                @if (m.Capital is { } cap && cap.HolderId == fh.Id) { <div class="kv"><span>The capital</span><b>holds @cap.SystemName — @(w.IsImperium ? "the court" : "the capital"), the Senate's chair, and a target</b></div> }
                @if (fh.Bloc == RegionSystem.FreeholdsBloc) { <div class="kv"><span>Standing</span><b class="warn">a free hold — sworn to no one</b></div> }
                @if (m.Reclaims is { Count: > 0 } rcs) { foreach (var rc in rcs.Where(r => w.Holding(r.HoldingId)?.OwnerId == fh.Id)) { <button class="opt" disabled="@(rc.Refusal != null)" title="@rc.Refusal" @onclick="() => G.Execute(new ReclaimFreeholdCommand(pid, rc.HoldingId))">Buy back @rc.HoldingName (@Money.Show(rc.Price) credits)</button> } }
                @if (w.BusinessesOf(fh.Id).Any())
                {
                    <h4>Its ventures <span class="muted small">@(fh.Id == w.Protagonist!.HouseId ? "yours" : "each can be bought at what it asks, or offered for")</span></h4>
                    @foreach (var bz in w.BusinessesOf(fh.Id).OrderBy(b => b.Id, StringComparer.Ordinal))
                    {
                        int toYou = G.Turn!.Ventures is { } vsys && fh.Id != w.Protagonist!.HouseId ? vsys.EarningsFor(w, bz, w.Protagonist!.HouseId) : 0;
                        <div class="line house-venture" data-house-venture="@bz.Id">
                            <b>@bz.Name</b> <span class="muted">@(c.Businesses.Def(bz.Kind)?.Name ?? bz.Kind) · level @bz.Level · @(w.Galaxy?.System(bz.SystemId)?.Name ?? bz.SystemId)@(bz.CompanyId.Length > 0 ? " · held by a company" : "")</span>
                            @if (fh.Id != w.Protagonist!.HouseId && bz.CompanyId.Length == 0)
                            {
                                <span class="muted"> · </span><span class="small @(toYou > 0 ? "good" : "warn")" title="What it would earn in your hands, in goods at today's prices: the charter and the world's holder differ by who owns it.">@(toYou >= 0 ? "+" : "")@Money.Show(toYou) a year to you</span>
                                <VentureBuy BusinessId="@bz.Id" />
                            }
                        </div>
                    }
                }
                @if (fh.SphereInfluence.Any(k => k.Value > 0)) { <div class="kv"><span>Spheres</span><b>@string.Join(" · ", fh.SphereInfluence.Where(k => k.Value > 0).Select(k => $"{k.Key} {k.Value}"))</b></div> }
                <h4>The people</h4>
                @foreach (var ch in members.Take(6))
                {
                    conns.TryGetValue(ch.Id, out var cn); var rel = w.GetRelationship(ch.Id, pid); int d = rel?.Disposition ?? 0;
                    <div class="person">
                        <Portrait Id="@ch.Id" Name="@ch.Name" Sex="@ch.Sex" Age="@ch.Age" Accent="@fh.AccentColor" Size="30" />
                        <span><b>@ch.Name</b> <span class="muted">@(c.Careers.RankName(ch.CareerTrack, ch.CareerRank, G.World!.Era) ?? "") · @ch.Age@(ch == head ? " · head" : "")@(ch.Flags.Contains(FleetSystem.AchillesFlag) ? " · Achilles" : "")</span>
                            @if (ch.Id != pid) { <span class="pill @(d < -20 ? "warn" : d > 20 ? "good" : "")">@(d >= 0 ? "+" : "")@d@(rel?.Bond is { } b && b != BondType.None ? $" · {b.ToString().ToLowerInvariant()}" : "")</span> }
                            @if (cn != null) { foreach (var f in cn.Flags.Take(3)) { <span class="pill small" title="@Marks.Tip(f)">@Marks.Label(f)</span> } }
                        </span>
                        @if (cn != null)
                        {
                            /* a match by treaty: every one of yours the family would take today, or the first with why not */
                            var matches = cn.Actions.Where(o => o.Id.StartsWith("marry:")).ToList(); var willing = matches.Where(o => o.Refusal == null).Take(3).ToList();
                            foreach (var o in willing.Count > 0 ? willing : matches.Take(1)) { <button class="opt inline tiny" data-treaty="@o.Id" disabled="@(o.Refusal != null)" title="@(o.Refusal ?? "The family would agree today, on custom's terms.")" @onclick="() => AskConn(o.Id, o.Label, cn.Id)">@o.Label</button> }
                            foreach (var o in cn.Actions.Where(o => !o.Id.StartsWith("marry:"))) { <button class="opt inline tiny" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => AskConn(o.Id, o.Label, cn.Id)">@o.Label</button> }
                        }
                    </div>
                }
                @if (members.Count == 0) { <div class="muted">No one of the name still lives.</div> }
                @{ var theirChildren = fh.Id == w.Protagonist!.HouseId ? new List<Character>() : members.Where(x => x.Age < DynastySystem.AgeOfMajority && !x.Flags.Contains(DynastySystem.HiddenFlag)).OrderByDescending(x => x.Age).ThenBy(x => x.Id, StringComparer.Ordinal).ToList(); }
                @if (theirChildren.Count > 0)
                {
                    /* a child of another house can be promised to one of yours, or taken in as a ward, from here
                       (docs/PLAYTHROUGH.md, Medium, Family, F70) */
                    var myHead = w.Protagonist!; var mineFree = w.LivingCharacters().Where(x => x.HouseId == myHead.HouseId && DynastySystem.Spouse(w, x) == null && x.Age >= CourtshipSystem.BetrothalAge && !CourtshipSystem.Promised(w, x.Id)).OrderBy(x => x.Age).ThenBy(x => x.Id, StringComparer.Ordinal).ToList();
                    <h4>Its children <span class="muted small">a promise of marriage, or a place in your household</span></h4>
                    @foreach (var kid in theirChildren.Take(6))
                    {
                        string kidId = kid.Id; var ward = new HouseholdCommand(pid, HouseholdCommand.TakeIn, kidId, HouseholdSystem.Ward); string? wardNo = ward.Refusal(G.Ctx); var will = HouseholdSystem.Willing(w, myHead, kid, HouseholdSystem.Ward);
                        var matchFor = mineFree.Where(x => x.Sex != kid.Sex && x.Sex.Length > 0).Select(x => (x, no: new CourtCommand(pid, x.Id, kidId).Refusal(G.Ctx))).ToList(); var open = matchFor.Where(x => x.no == null).Take(2).ToList();
                        <div class="person" data-their-child="@kidId">
                            <Portrait Id="@kid.Id" Name="@kid.Name" Sex="@kid.Sex" Age="@kid.Age" Accent="@fh.AccentColor" Size="30" />
                            <span><b>@kid.Name</b> <span class="muted">@kid.Age</span></span>
                            @foreach (var (mk, _) in open)
                            {
                                string mkId = mk.Id; int consent = CourtshipSystem.StartConsent(w, mk, kid);
                                <button class="opt inline tiny" data-promise="@(mkId + "|" + kidId)" title="@($"Sound the family out about promising {mk.Name} ({mk.Age}) to {kid.Name}. It begins as any match does, under Dynasty, Marriages: their family stands at {consent} of the {CourtshipSystem.AcceptAt} at which it agrees. A promise is kept when both are of age.")" @onclick="() => G.Execute(new CourtCommand(pid, mkId, kidId))">Promise to @mk.Name.Split(' ')[0]</button>
                            }
                            @if (open.Count == 0) { <span class="muted small" title="@(matchFor.Count > 0 ? matchFor[0].no : "")">@(matchFor.Count == 0 ? "nobody of yours to promise" : "no promise: " + matchFor[0].no)</span> }
                            <button class="opt inline tiny" data-ward="@kidId" disabled="@(wardNo != null)" title="@(wardNo ?? "They keep their name and are raised in your house, with you as their mentor. " + string.Join(" · ", will.why))" @onclick="() => G.Execute(ward)">Take as a ward · @HouseholdSystem.TakeInInfluence influence</button>
                        </div>
                    }
                }
                <h4>The domain</h4>
                @foreach (var hd in worlds) { var sys = w.Galaxy?.System(hd.SystemId); <div class="line"><img class="sprite" data-planet="@(sys?.PlanetClass ?? "terran")|@hd.SystemId|24" alt="" /> <b>@hd.Name</b> <span class="muted">@(c.Holdings.Spec(hd.Specialization)?.Name ?? hd.Specialization) · @(sys?.Name) · loyalty @(100 - hd.Unrest)</span></div> }
                @foreach (var hd in stations) { <div class="line muted"><Icon Name="station" Size="12" /> @hd.Name · station at @(w.Galaxy?.System(hd.SystemId)?.Name)</div> }
                @if (worlds.Count == 0 && stations.Count == 0) { <div class="muted">@(w.IsImperium ? "Landless: a name, a few retainers, and ambitions." : "No world to its name: a family, a few clients, and ambitions.")</div> }
                @if (fh.Id != mine.Id)
                {
                    var dw = new DeclareWarCommand(pid, fh.Id, c.Fleets);
                    @if (!atWar) { <button class="opt" disabled="@(!dw.CanExecute(ctx))" title="@(dw.CanExecute(ctx) ? "" : "no influence")" @onclick="() => G.AskWar(fh.Id)">Declare war on @fh.Name (2 influence)</button> }
                    else { var peace = m.Wars.FirstOrDefault(x => x.EnemyHouseId == fh.Id); if (peace != null) { <PeaceTerms War="peace" /> } }
                }
            </section>
        }
        </aside>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    private string? _focus; private string _sort = "title";
    // dealings between houses (docs/WEALTH.md): the rate a loan is offered at, and what each act would do, said before it is done
    private int _rate = DealingsSystem.LoanRates[0];
    private DealingsCommand Deal(string what, string houseId, string value = "", int rate = 0) => new(G.World!.ProtagonistId, what, houseId, G.Turn!.Dealings, value, rate);
    private string MotionName(Motion m) => (G.Content!.Motions.Def(m.Kind)?.Name ?? m.Kind) + (G.World!.House(m.ProposerHouseId) is { } mover ? $", moved by {mover.Name}" : "");
    private string StandsOn(Motion m, House h)
    {
        if (m.ProposerHouseId == h.Id) return "its own motion";
        if (m.Votes.TryGetValue(h.Id, out int cast)) return cast > 0 ? "it has declared for" : cast < 0 ? "it has declared against" : "it has declared that it stays away";
        if (G.Turn!.Senate.Owes(G.World!, m, h.Id)) return "it votes for it: it owes your house a favour";   // as the Senate window's whip count has it (SenateSystem.Owes)
        int lean = G.Turn!.Senate.Lean(G.World!, m, h.Id); return lean > 0 ? $"it leans for (+{lean})" : lean < 0 ? $"it leans against ({lean})" : "it leans neither way";
    }
    private static string RateSays(House h) => $"The rate it bears follows how short it is: {DealingsSystem.BearsShort} in the hundred while it holds under {Money.Show(DealingsSystem.ShortAt)}, {DealingsSystem.BearsPinched} under {Money.Show(DealingsSystem.PinchedAt)}, {DealingsSystem.BearsInTheRed} in the red. It holds {Money.Show(h.Treasury.Credits)}. A low rate is taken as a kindness, a high one as business.";
    private static string ForgiveSays(HouseLoan l) => $"Let the {Money.Credits(l.Owed)} go. Its head thinks +{DealingsSystem.ForgiveRegard} of you, and the house owes you a favour.";
    private static string PressSays => $"Say you want your money. Its head thinks −{DealingsSystem.PressRegard} of you. From now on it pays what it has each year; {Counted.Years(DealingsSystem.DefaultYears)} running short of the instalment and it is a default: the rest is written off, its standing falls by {DealingsSystem.DefaultLegitimacy}, and every lender in the Reach charges it more.";
    private static string CallMoneySays => "They pay it into your treasury, and owe you nothing more.";
    private static string CallMatchSays => "The family looks more kindly on the suit between your house and theirs.";
    private static string CallVoteSays => "It declares its vote as yours is on this motion, and owes you nothing more.";
    private static string HonourSays => $"Pay what it asks. The account is even, and its head thinks +{WealthSystem.FavourKept} of you.";
    private static string BreakSays => $"Refuse. You owe it nothing more, and its head thinks −{WealthSystem.FavourBroken} of you and remembers.";
    // trade between houses (docs/WEALTH.md, "Trade between houses"): the lot bought, sold or sent each year, and the term of a standing deal
    private int _lot = HouseTradeSystem.Lots[1], _term = HouseTradeSystem.Terms[0];
    private HouseTradeCommand Trade(string what, string houseId, string good, int units, int years = 0, string dealId = "") => new(G.World!.ProtagonistId, what, houseId, G.Turn!.HouseTrade, good, units, years, dealId);
    private static string Here(bool on) => on ? "here" : "";
    private static string Sum(int credits) => credits > 0 ? " · " + Money.Show(credits) : "";
    private static string YearSum(int credits) => credits > 0 ? " · " + Money.Show(credits) + " a year" : "";
    private static string Capital(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    /// <summary>What that house holds of a good and would spare, what it asks and pays for a unit, and what you hold.</summary>
    private string TradeLine(HouseTradeSystem tr, House theirs, House mine, string good)
    {
        var w = G.World!; int spare = tr.Spare(w, theirs, good), wants = tr.Wants(w, theirs, good);
        return $"it holds {theirs.Treasury.Get(good)} and would {(spare > 0 ? $"spare {spare}" : wants > 0 ? $"take {wants}" : "spare none")} · it asks {Money.Show(tr.Asks(w, theirs, mine, good))} a unit and pays {Money.Show(tr.Pays(w, theirs, mine, good))}"
            + (tr.Closed(w, good) ? ", dearer than the market's for being kept off the exchanges" : "") + $" · you hold {mine.Treasury.Get(good)}";
    }
    // an alert opens this window on its subject (docs/PLAYTHROUGH.md 15): "window:tab", or "window:tab:person"
    [Parameter] public string Tab { get; set; } = "";
    [Parameter] public int TabStamp { get; set; }
    private static int _seenStamp;
    protected override void OnParametersSet() { if (TabStamp != _seenStamp) { _seenStamp = TabStamp; if (Tab.Length > 0) OpenOn(Tab); } }
    private void OpenOn(string tab) { if (G.World?.House(tab) != null) { _focus = tab; _open = true; } }
    /// <summary>Whether a house's own page is open over the standings (docs/ART_DIRECTION.md, "The windows, one by one").</summary>
    private bool _open;
    protected override async Task OnAfterRenderAsync(bool first) { try { await JS.InvokeVoidAsync("praetoriaFx.paint"); } catch { } }
    private static string Ordinal(int n) => n % 100 is 11 or 12 or 13 ? $"{n}th" : (n % 10) switch { 1 => $"{n}st", 2 => $"{n}nd", 3 => $"{n}rd", _ => $"{n}th" };
    private void AskConn(string optionId, string label, string targetId) { if (optionId.StartsWith("marry:")) G.AskTreatyMarriage(label, Conn(optionId, targetId)); else G.AskAccident(label, Conn(optionId, targetId)); }
    private ICommand Conn(string optionId, string targetId) { var pid = G.World!.ProtagonistId; var c = G.Content!; return optionId.StartsWith("marry:") ? new ProposeMarriageCommand(pid, optionId["marry:".Length..], targetId, c.Titles) : new AssassinateCommand(pid, targetId, c.Friction); }
}
