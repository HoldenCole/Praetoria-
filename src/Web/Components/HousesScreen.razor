@inject GameClient G
@inject IJSRuntime JS
@{
    var m = Model; var w = G.World!; var c = G.Content!; var pid = w.ProtagonistId; var p = w.Protagonist!; var mine = w.House(p.HouseId)!;
    var ctx = new CommandContext(w, new Praetoria.Core.Rng.SplitMix64Rng(0)); var senate = G.Turn!.Senate;
    var conns = m.Connections.ToDictionary(x => x.Id);
    var housesAll = w.Houses.Values.Where(h => h.Id != mine.Id && h.Id != PirateSystem.HouseId);
    int Disp(House h) { var ms = w.LivingCharacters().Where(x => x.HouseId == h.Id).ToList(); return ms.Count == 0 ? 0 : (int)ms.Average(x => w.GetRelationship(x.Id, pid)?.Disposition ?? 0); }
    var houses = (_sort switch { "wealth" => housesAll.OrderByDescending(h => h.Wealth), "disposition" => housesAll.OrderByDescending(Disp), "hulls" => housesAll.OrderByDescending(h => FleetSystem.StrengthOf(w, h.Id)), "seats" => housesAll.OrderByDescending(h => senate.Weight(w, h.Id)), "worlds" => housesAll.OrderByDescending(h => w.HoldingsOf(h.Id).Count(x => x.IsPlanet)), _ => housesAll.OrderByDescending(h => c.Titles.RankOf(h.Title)).ThenByDescending(h => h.Legitimacy) }).ThenBy(h => h.Id, StringComparer.Ordinal).ToList();
    _focus ??= houses.FirstOrDefault()?.Id;
    int great = houses.Count(h => w.HoldingsOf(h.Id).Any(x => x.IsPlanet)), wars = houses.Count(h => w.AtWar(mine.Id, h.Id));
    var fh = _focus != null ? w.House(_focus) : null;
    int maxHulls = Math.Max(1, w.Houses.Values.Where(h => h.Id != PirateSystem.HouseId).Max(h => FleetSystem.StrengthOf(w, h.Id))), maxSeats = Math.Max(1, w.Houses.Values.Where(h => h.Id != PirateSystem.HouseId).Max(h => senate.Weight(w, h.Id))), maxWorlds = Math.Max(1, w.Houses.Values.Max(h => w.HoldingsOf(h.Id).Count(x => x.IsPlanet)));
    string capLine = m.Capital == null ? "" : " · the capital " + m.Capital.SystemName + " is " + (m.Capital.Mine ? "yours" : m.Capital.HolderName != null ? m.Capital.HolderName + "'s" : "masterless");
    int myRank = 1 + housesAll.Count(h => c.Titles.RankOf(h.Title) > c.Titles.RankOf(mine.Title) || (c.Titles.RankOf(h.Title) == c.Titles.RankOf(mine.Title) && h.Legitimacy > mine.Legitimacy));
}
<div class="dash gallery" style="--accent:@mine.AccentColor">
    <header class="dash-head">
        <div class="dh-title"><Icon Name="houses" Size="18" /> <b>The Houses of @(w.Era == "imperium" ? "the Imperium" : "the Reach")</b> <span class="muted">@(houses.Count + 1) houses · @great hold worlds · @(houses.Count - great) hold stations or a name@(capLine)</span></div>
        <div class="dh-stats">
            <div class="stat"><span>Your standing</span><b>@Ordinal(myRank) <i class="muted">of @(houses.Count + 1) by @(w.IsImperium ? "title" : "rank")</i></b></div>
            <div class="stat @(wars > 0 ? "warn" : "")"><span>At war with you</span><b>@wars</b></div>
            <div class="stat"><span>Friends (+20)</span><b>@houses.Count(h => Disp(h) > 20)</b></div>
            <div class="stat @(houses.Count(h => Disp(h) < -20) > 3 ? "warn" : "")"><span>Enemies (−20)</span><b>@houses.Count(h => Disp(h) < -20)</b></div>
            <div class="stat"><span>Free holds</span><b>@houses.Count(h => h.Bloc == RegionSystem.FreeholdsBloc)</b></div>
        </div>
    </header>
    <div class="dash-grid gallery-grid">
        <section class="panel">
            <h3><Icon Name="houses" Size="13" /> The standings <span class="muted">click a house</span></h3>
            <div class="vols">@foreach (var k in new[] { "title", "worlds", "hulls", "seats", "wealth", "disposition" }) { <button class="rung @(_sort == k ? "here" : "")" @onclick="() => _sort = k">by @(k == "title" && !w.IsImperium ? "rank" : k)</button> }</div>
            <table class="standings">
                <thead><tr><th>House</th><th>@(w.IsImperium ? "Title" : "Rank")</th><th>Worlds</th><th>Hulls</th><th>Seats</th><th>Wealth</th><th>Toward you</th><th>Bench</th></tr></thead>
                <tbody>
                @foreach (var h in houses.Prepend(mine))
                {
                    int worlds = w.HoldingsOf(h.Id).Count(x => x.IsPlanet), hulls = FleetSystem.StrengthOf(w, h.Id), seats = senate.Weight(w, h.Id); int disp = h.Id == mine.Id ? 0 : Disp(h); bool atWar = w.AtWar(mine.Id, h.Id); var bench = FactionSystem.Of(w, h.Id);
                    <tr class="@(h.Id == mine.Id ? "mine" : "") @(h.Id == _focus ? "here" : "") @(atWar ? "hostile" : "")" @onclick="() => _focus = h.Id">
                        <td class="hn"><Sigil HouseId="@h.Id" Accent="@h.AccentColor" Size="16" /> <b>@h.Name</b>@if (m.Capital?.HolderId == h.Id) { <span class="tier small opulent">capital</span> }@if (h.Bloc == RegionSystem.FreeholdsBloc) { <span class="tier small destitute">free hold</span> }@if (ThroneSystem.Emperor(w)?.Id == h.Id) { <span class="tier small opulent">throne</span> }</td>
                        <td class="muted">@(c.Titles.NameOf(h.Title, G.World!.Era))</td>
                        <td><span class="mbar"><i style="width:@(100 * worlds / maxWorlds)%; background:@h.AccentColor"></i></span>@worlds</td>
                        <td><span class="mbar"><i style="width:@(100 * hulls / maxHulls)%; background:@h.AccentColor"></i></span>@hulls</td>
                        <td><span class="mbar"><i style="width:@(100 * seats / maxSeats)%; background:@h.AccentColor"></i></span>@seats</td>
                        <td><span class="tier small @Wealth.TierFor(w, h.Id)" title="wealth @h.Wealth">@Wealth.TierFor(w, h.Id)</span></td>
                        <td>@if (h.Id != mine.Id) { <span class="pill @(atWar ? "warn" : disp < -20 ? "warn" : disp > 20 ? "good" : "")">@(atWar ? "⚔ " : "")@(disp >= 0 ? "+" : "")@disp</span> } else { <span class="muted">—</span> }</td>
                        <td class="muted small">@(bench?.Name ?? "")</td>
                    </tr>
                }
                </tbody>
            </table>
        </section>

        <aside class="dash-side">
        @if (fh != null)
        {
            var members = w.LivingCharacters().Where(x => x.HouseId == fh.Id).OrderByDescending(x => x.CareerRank).ThenBy(x => x.Id, StringComparer.Ordinal).ToList();
            var head = members.FirstOrDefault(); int disp = members.Count == 0 ? 0 : (int)members.Average(x => w.GetRelationship(x.Id, pid)?.Disposition ?? 0);
            var worlds = w.HoldingsOf(fh.Id).Where(x => x.IsPlanet).ToList(); var stations = w.HoldingsOf(fh.Id).Where(x => !x.IsPlanet).ToList(); bool atWar = w.AtWar(mine.Id, fh.Id);
            var offDefault = c.Policies.Laws.Where(l => PolicySystem.HoldsScope(w, fh.Id, l.Scope) && PolicySystem.OptionId(w, c.Policies, fh.Id, l.Id) != l.DefaultOption.Id).Select(l => c.Policies.Law(l.Id)!.Option(PolicySystem.OptionId(w, c.Policies, fh.Id, l.Id))?.Name.ToLowerInvariant()).Where(x => x != null).ToList();
            var moods = c.Policies.Estates.Select(e => (e, a: PolicySystem.Approval(w, fh.Id, e.Id))).Where(x => x.a <= PolicySystem.Hostile || x.a >= PolicySystem.Loyal).ToList();
            <section class="panel focus-house" style="--accent:@fh.AccentColor">
                <div class="who-head"><Sigil HouseId="@fh.Id" Accent="@fh.AccentColor" Size="44" /><div><h2>@fh.Name</h2><div class="sub">@(c.Titles.NameOf(fh.Title, G.World!.Era)) · @fh.Culture culture@(fh.Bloc.Length > 0 ? $" · bloc {fh.Bloc}" : "")</div></div>
                    @if (fh.Id != mine.Id) { <span class="pill @(disp < -20 ? "warn" : disp > 20 ? "good" : "")">@(disp >= 0 ? "+" : "")@disp</span> }@if (atWar) { <span class="pill warn">AT WAR</span> }</div>
                <div class="kv"><span>Legitimacy</span><b>@fh.Legitimacy</b></div>
                <div class="kv"><span>Domain</span><b>@worlds.Count world(s) · @stations.Count station(s)</b></div>
                <div class="kv"><span>Navy</span><b>@FleetSystem.StrengthOf(w, fh.Id) hull(s)@(FleetSystem.CampaignTarget(w, fh.Id) is { } ct ? $" · campaigning on {w.Galaxy?.System(ct)?.Name ?? ct}" : "")</b></div>
                <div class="kv"><span>Wealth</span><b>@fh.Wealth · <span class="tier @Wealth.TierFor(w, fh.Id)">@Wealth.TierFor(w, fh.Id)</span>@(fh.Debt > 0 ? " · in debt" : "")</b></div>
                <div class="kv"><span>In the Senate</span><b>@senate.Weight(w, fh.Id) seat(s)@(FactionSystem.Of(w, fh.Id) is { } fb ? $" · {fb.Name}{(fb.LeaderHouseId == fh.Id ? " (leads)" : "")}" : "")@(w.Counter("motions_passed:" + fh.Id) > 0 ? $" · {w.Counter("motions_passed:" + fh.Id)} motion(s) carried" : "")@(SenateSystem.Embargoed(w, fh.Id) ? " · under embargo" : "")</b></div>
                @if (offDefault.Count > 0 || moods.Count > 0) { <div class="kv"><span>Law</span><b>@(offDefault.Count > 0 ? string.Join(", ", offDefault) : "the customary law")@(moods.Count > 0 ? " · " + string.Join(", ", moods.Select(x => $"{x.e.Name.Replace("The ", "").ToLowerInvariant()} {(x.a >= PolicySystem.Loyal ? "loyal" : "hostile")}")) : "")</b></div> }
                @if (m.Capital is { } cap && cap.HolderId == fh.Id) { <div class="kv"><span>The capital</span><b>holds @cap.SystemName — @(w.IsImperium ? "the court" : "the capital"), the Senate's chair, and a target</b></div> }
                @if (fh.Bloc == RegionSystem.FreeholdsBloc) { <div class="kv"><span>Standing</span><b class="warn">a free hold — sworn to no one</b></div> }
                @if (m.Reclaims is { Count: > 0 } rcs) { foreach (var rc in rcs.Where(r => w.Holding(r.HoldingId)?.OwnerId == fh.Id)) { <button class="opt" disabled="@(rc.Refusal != null)" title="@rc.Refusal" @onclick="() => G.Execute(new ReclaimFreeholdCommand(pid, rc.HoldingId))">Buy back @rc.HoldingName (@rc.Price credits)</button> } }
                @if (w.BusinessesOf(fh.Id).Any()) { <div class="kv"><span>Ventures</span><b>@string.Join(", ", w.BusinessesOf(fh.Id).Select(b => $"{c.Businesses.Def(b.Kind)?.Name ?? b.Kind} at {w.Galaxy?.System(b.SystemId)?.Name ?? b.SystemId} ({b.Level})"))</b></div> }
                @if (fh.SphereInfluence.Any(k => k.Value > 0)) { <div class="kv"><span>Spheres</span><b>@string.Join(" · ", fh.SphereInfluence.Where(k => k.Value > 0).Select(k => $"{k.Key} {k.Value}"))</b></div> }
                <h4>The people</h4>
                @foreach (var ch in members.Take(6))
                {
                    conns.TryGetValue(ch.Id, out var cn); var rel = w.GetRelationship(ch.Id, pid); int d = rel?.Disposition ?? 0;
                    <div class="person">
                        <Portrait Id="@ch.Id" Name="@ch.Name" Sex="@ch.Sex" Age="@ch.Age" Accent="@fh.AccentColor" Size="30" />
                        <span><b>@ch.Name</b> <span class="muted">@(c.Careers.RankName(ch.CareerTrack, ch.CareerRank, G.World!.Era) ?? "") · @ch.Age@(ch == head ? " · head" : "")@(ch.Flags.Contains(FleetSystem.AchillesFlag) ? " · Achilles" : "")</span>
                            @if (ch.Id != pid) { <span class="pill @(d < -20 ? "warn" : d > 20 ? "good" : "")">@(d >= 0 ? "+" : "")@d@(rel?.Bond is { } b && b != BondType.None ? $" · {b.ToString().ToLowerInvariant()}" : "")</span> }
                            @if (cn != null) { foreach (var f in cn.Flags.Take(3)) { <span class="pill small">@f.Replace('_', ' ')</span> } }
                        </span>
                        @if (cn != null) { foreach (var o in cn.Actions) { <button class="opt inline tiny" disabled="@(o.Refusal != null)" title="@o.Refusal" @onclick="() => G.Execute(Conn(o.Id, cn.Id))">@o.Label</button> } }
                    </div>
                }
                @if (members.Count == 0) { <div class="muted">No one of the name still lives.</div> }
                <h4>The domain</h4>
                @foreach (var hd in worlds) { var sys = w.Galaxy?.System(hd.SystemId); <div class="line"><img class="sprite" data-planet="@(sys?.PlanetClass ?? "terran")|@hd.SystemId|24" alt="" /> <b>@hd.Name</b> <span class="muted">@(c.Holdings.Spec(hd.Specialization)?.Name ?? hd.Specialization) · @(sys?.Name) · loyalty @(100 - hd.Unrest)</span></div> }
                @foreach (var hd in stations) { <div class="line muted"><Icon Name="station" Size="12" /> @hd.Name · station at @(w.Galaxy?.System(hd.SystemId)?.Name)</div> }
                @if (worlds.Count == 0 && stations.Count == 0) { <div class="muted">@(w.IsImperium ? "Landless: a name, a few retainers, and ambitions." : "No world to its name: a family, a few clients, and ambitions.")</div> }
                @if (fh.Id != mine.Id)
                {
                    var dw = new DeclareWarCommand(pid, fh.Id, c.Fleets);
                    @if (!atWar) { <button class="opt" disabled="@(!dw.CanExecute(ctx))" title="@(dw.CanExecute(ctx) ? "" : "no influence")" @onclick="() => G.Execute(new DeclareWarCommand(pid, fh.Id, c.Fleets))">Declare war on @fh.Name (2 influence)</button> }
                    else { var peace = m.Wars.FirstOrDefault(x => x.EnemyHouseId == fh.Id); if (peace != null) { <button class="opt" disabled="@(!peace.PeaceAvailable)" title="@peace.PeaceTooltip" @onclick="() => G.Execute(new SueForPeaceCommand(pid, fh.Id, c.Fleets))">Sue for peace (1 influence)</button> } }
                }
            </section>
        }
        </aside>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CourtModel Model { get; set; } = default!;
    private string? _focus; private string _sort = "title";
    protected override async Task OnAfterRenderAsync(bool first) { try { await JS.InvokeVoidAsync("praetoriaFx.paint"); } catch { } }
    private static string Ordinal(int n) => n % 100 is 11 or 12 or 13 ? $"{n}th" : (n % 10) switch { 1 => $"{n}st", 2 => $"{n}nd", 3 => $"{n}rd", _ => $"{n}th" };
    private ICommand Conn(string optionId, string targetId) { var pid = G.World!.ProtagonistId; var c = G.Content!; return optionId.StartsWith("marry:") ? new ProposeMarriageCommand(pid, optionId["marry:".Length..], targetId, c.Titles) : new AssassinateCommand(pid, targetId, c.Friction); }
}
