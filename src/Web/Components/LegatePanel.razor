@preservewhitespace true
@using Praetoria.Core.Systems
@inject GameClient G
@implements IDisposable
@* Name a legate (docs/MILITARY.md, "A command by service"): on the Senate window where the offices are, a consul, the Admiral of the Reach or the
   holder of emergency powers gives a fleet under them to somebody of another house. *@
@{
    var w = G.World!; var c = G.Content!; var p = w.Protagonist!; var pid = p.Id;
    var auths = ServiceSystem.Authorities(w, c.Offices, p);
    var fleets = auths.Count == 0 ? new List<Fleet>() : w.Fleets.Values.Where(f => ServiceSystem.AuthorityOver(w, c.Offices, p, f) != null).OrderByDescending(f => f.Office).ThenByDescending(f => f.Strength).ThenBy(f => f.Id, StringComparer.Ordinal).ToList();
    var named = w.Service.Where(s => s.NamedById == pid).OrderBy(s => s.FleetId, StringComparer.Ordinal).ToList();
}
@if (auths.Count > 0)
{
    <section class="panel sn-panel" data-legate>
        <Section Title="Name a legate" Count="@(fleets.Count > 0 ? fleets.Count.ToString() : "")" Info="@($"A fleet under your office may be given to somebody of any house, who commands it for you: an office fleet, the state's fleet, or one of your house's own. The victories and the crews' regard are the legate's; the fleet stays where it was. The commission ends when you no longer hold the office, and you may relieve them on the Military window. It costs {ServiceSystem.AgentCost} agent.")">
            <Right><span>as @string.Join(" and ", auths.Select(ServiceSystem.AuthorityName))</span></Right>
        </Section>
        @if (fleets.Count == 0) { <p class="sn-say sn-pad ui-dim" data-legate-none="1">No fleet in commission is under your office now.</p> }
        @foreach (var f in fleets)
        {
            var cands = ServiceSystem.Candidates(w, f, 8); string fid = f.Id; string pick = _pick.GetValueOrDefault(fid, cands.FirstOrDefault()?.Id ?? string.Empty);
            var name = new NameLegateCommand(pid, fid, pick, c.Offices); string? no = pick.Length == 0 ? "nobody of another house is free to command it" : name.Refusal(G.Ctx);
            var adm = FleetSystem.AdmiralOf(w, f);
            <div class="sn-ent line" data-legate-fleet="@fid">
                <span class="sn-ic @(f.Office ? "mine" : "")"><Icon Name="fleet" Tone="@(f.Office ? "brass" : "ivory")" Size="22" /></span>
                <div class="sn-ent-main">
                    <div class="sn-hd"><b class="sn-nm">@f.Name</b><span class="sn-sub">@Counted.Hulls(f.Strength) · @(f.Office ? "the Reach's own" : "your house's") · @(adm?.Name ?? "no admiral")</span></div>
                    <div class="sn-form">
                        <span class="sn-selwrap"><select class="sel" data-legate-pick="@fid" @onchange="e => _pick[fid] = e.Value?.ToString() ?? string.Empty">
                            @foreach (var k in cands) { <option value="@k.Id" selected="@(k.Id == pick)">@k.Name of @(w.House(k.HouseId)?.Name) · tactics @k.Skill("tactics")</option> }
                        </select><Icon Name="chev" Tone="brass" Size="12" /></span>
                        <Plate Label="Name legate" Small="true" Icon="eagle-emblem" Locked="@(no != null)" Disabled="@(no != null)" Tip="@(no ?? NameHelp(f.Name))" CostIcon="cowled" CostText="@ServiceSystem.AgentCost.ToString()" OnClick="() => G.Execute(new NameLegateCommand(pid, fid, pick, c.Offices))" data-name-legate="@fid" />
                        @if (no != null && pick.Length > 0) { <span class="sn-no">@SenateScreen.Cap(no)</span> }
                    </div>
                </div>
            </div>
        }
        @if (named.Count > 0)
        {
            <div class="sn-sub-h">Your legates</div>
            @foreach (var s in named) { <div class="sn-note sn-pad line" data-legate-named="@s.FleetId"><Icon Name="eagle-emblem" Tone="brass" Size="15" /><span>@ServiceSystem.Says(w, s)</span></div> }
        }
    </section>
}

@code {
    // A panel with no parameters is not redrawn when its parent is, so it listens for the world changing itself.
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;
    private readonly Dictionary<string, string> _pick = new();
    private static string NameHelp(string fleet) => $"Name them legate of {fleet}. They command it for you until you no longer hold the office, you relieve them, or they resign.";
}
