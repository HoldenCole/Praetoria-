@inject GameClient G
@inject IJSRuntime JS
@using Praetoria.Core.Creation
@* A character of the player's own making (docs/CHARACTER.md): every dial, a points budget in Standard, none in Free, and a
   power rating either way. The spec is plain data; this component only edits it and says what the mode objects to. *@
@{
    var c = Spec; var content = G.Content!; var blank = G.BlankWorld(c.Imperium); var lim = WorkshopLimits.For(c.Mode); bool free = c.Mode == CustomCharacter.Free;
    string era = c.Imperium ? World.EraImperium : World.EraRepublic;
    var (total, lines) = CharacterWorkshop.Cost(c, content); var problems = CharacterWorkshop.Problems(c, content, blank);
    var track = content.Careers.ById(c.Track); int maxRank = Math.Min(lim.MaxRank, track?.MaxRank ?? lim.MaxRank);
    var houses = blank.Houses.Values.Where(h => h.Id != CharacterWorkshop.HouseId && h.Id != PirateSystem.HouseId).OrderBy(h => h.Name, StringComparer.Ordinal).ToList();
    var systems = blank.Galaxy!.Systems.Values.OrderBy(s => s.Name, StringComparer.Ordinal).ToList();
    int age = c.Academy ? CharacterWorkshop.AcademyAge : c.Age;
    string previewName = c.Name.Trim().Length > 0 ? c.Name.Trim() : "(a name by the dice)";
}
<div class="workshop">
    <div class="ws-top">
        <Portrait Id="@CharacterWorkshop.SelfId" Name="@previewName" Sex="@c.Sex" Age="@age" Accent="@c.Accent" Size="112" Look="@c.Face.Encode()" Ancestry="@c.Ancestry" />
        <div class="ws-summary">
            <div class="ws-name">@previewName <span class="muted">@age · @(content.Careers.RankName(c.Track, c.Academy ? 0 : c.Rank, era) ?? c.Track) · @content.Titles.NameOf(c.Title, era)</span></div>
            <div class="ws-modes">
                <button class="chip @(free ? "" : "on")" @onclick="() => SetMode(CustomCharacter.Standard)" title="a points budget and sensible caps: a fair start">Standard · @WorkshopLimits.Standard.Budget points</button>
                <button class="chip @(free ? "on" : "")" @onclick="() => SetMode(CustomCharacter.Free)" title="no budget and very high caps; the run is marked as custom">Free · no limits</button>
            </div>
            <div class="ws-power @CharacterWorkshop.Rating(total)">
                <b>@total</b> point@(total == 1 ? "" : "s") · <b title="How strong a start this person is, by the points spent: under 30 modest, to 60 able, to 110 formidable, to 220 overpowered, beyond that absurd.">@CharacterWorkshop.Rating(total)</b>
                @if (!free) { <span class="ws-bar"><i style="width:@(Math.Min(100, 100 * total / Math.Max(1, lim.Budget)))%" class="@(total > lim.Budget ? "over" : "")"></i></span> <span class="muted">of @lim.Budget</span> }
                else { <span class="muted">· made without limits; the saga will say so</span> }
            </div>
            <div class="muted small">@string.Join(" · ", lines.Take(7).Select(l => $"{l.what} {(l.points > 0 ? "+" : "")}{l.points}"))</div>
        </div>
    </div>

    <div class="ws-row">
        <span class="muted small">Start from</span>
        @foreach (var (name, blurb, _) in CharacterWorkshop.Presets(content)) { var n = name; <button class="chip" title="@blurb" @onclick="() => UsePreset(n)">@name</button> }
        <button class="chip" title="a character by the dice, within this mode's rules" @onclick="Randomise">Throw the dice</button>
        <button class="chip" title="save this character as a small file" @onclick="SaveFile">Save to a file</button>
        <label class="chip file" title="load a character file saved earlier">Load a file <InputFile OnChange="LoadFile" accept=".json" /></label>
    </div>
    @if (_fileError != null) { <p class="error">@_fileError</p> }

    <div class="ex-tabs">
        @foreach (var (id, label) in Tabs) { var tid = id; <button class="rung @(_tab == tid ? "here" : "")" @onclick="() => _tab = tid">@label</button> }
    </div>

    @if (_tab == "person")
    {
        <div class="grid2">
            <label>Name <input value="@c.Name" @onchange="e => { string was = Surname(c.Name); c.Name = Text(e); /* the family name follows the person's until it is set by hand */ if (c.HouseName.Length == 0 || c.HouseName == was || !_houseNamed) c.HouseName = Surname(c.Name); Changed(); }" placeholder="given name and family name, or leave to the dice" /></label>
            <label>Sex <select value="@c.Sex" @onchange="e => { c.Sex = Text(e); Changed(); }"><option value="male">male</option><option value="female">female</option></select></label>
            <label>Age <input type="number" min="@CharacterWorkshop.MinAge" max="@CharacterWorkshop.MaxAge" value="@age" disabled="@c.Academy" @onchange="e => { c.Age = Num(e, CharacterWorkshop.MinAge, CharacterWorkshop.MaxAge); Changed(); }" /></label>
            <label>Service <select value="@c.Track" @onchange="e => { c.Track = Text(e); c.Rank = Math.Min(c.Rank, content.Careers.MaxRank(c.Track) ?? 0); Changed(); }">@foreach (var t in content.Careers.Defs) { <option value="@t.Id">@t.NameIn(era)</option> }</select></label>
            <label>Rank in it <select value="@c.Rank" disabled="@c.Academy" @onchange="e => { c.Rank = Num(e, 0, 9); Changed(); }">@for (int r = 0; r <= maxRank; r++) { int rr = r; <option value="@rr">@(content.Careers.RankName(c.Track, rr, era) ?? "rank " + rr)</option> }</select></label>
            <label>Ambition <select value="@c.Ambition" @onchange="e => { c.Ambition = Text(e); Changed(); }"><option value="">none yet</option>@foreach (var a in content.Traits.Ambitions) { <option value="@a.Id">@a.Name</option> }</select></label>
        </div>
        <h3>Where they come from <span class="muted">a background: it moves the house's standing and purse, and gives them a little of what that life teaches</span></h3>
        <div class="chips" data-backgrounds="@content.Backgrounds.Defs.Count">
            <button class="chip @(c.Background.Length == 0 ? "on" : "")" title="No background: only what you set on these pages." @onclick="() => { c.Background = string.Empty; Changed(); }">none</button>
            @foreach (var b in content.Backgrounds.Defs) { var bid = b.Id; <button class="chip @(c.Background == bid ? "on" : "")" data-background="@bid" title="@b.Description" @onclick="() => { c.Background = bid; Changed(); }">@b.Name</button> }
        </div>
        @if (content.Backgrounds.ById(c.Background) is { } bgd)
        {
            <p class="hint" data-background-says>@bgd.Description <b>@BackgroundGives(bgd)</b> @(free ? "" : BackgroundPrice(bgd))</p>
        }
        <h3>Nature <span class="muted">up to @lim.MaxNature · how they are, and what costs them sleep@(c.Nature.Count >= lim.MaxNature ? " · you have " + lim.MaxNature + ": un-pick one to change" : "")</span></h3>
        <div class="chips">@foreach (var t in content.Traits.Nature) { var tid = t.Id; bool nFull = !c.Nature.Contains(tid) && c.Nature.Count >= lim.MaxNature; <button class="chip @(c.Nature.Contains(tid) ? "on" : "") @(nFull ? "full" : "")" disabled="@nFull" title="@(nFull ? $"Up to {lim.MaxNature}: un-pick one first. {t.Description}" : t.Description)" @onclick="() => Toggle(c.Nature, tid, lim.MaxNature)">@t.Name</button> }</div>
        <h3>Aptitude <span class="muted">up to @lim.MaxAptitude · four points each@(c.Aptitude.Count >= lim.MaxAptitude ? " · you have " + lim.MaxAptitude + ": un-pick one to change" : "")</span></h3>
        <div class="chips">@foreach (var t in content.Traits.Aptitude) { var tid = t.Id; bool aFull = !c.Aptitude.Contains(tid) && c.Aptitude.Count >= lim.MaxAptitude; <button class="chip @(c.Aptitude.Contains(tid) ? "on" : "") @(aFull ? "full" : "")" disabled="@aFull" title="@(aFull ? $"Up to {lim.MaxAptitude}: un-pick one first. {t.Description}" : t.Description)" @onclick="() => Toggle(c.Aptitude, tid, lim.MaxAptitude)">@t.Name</button> }</div>
        <h3>Skills <span class="muted">0 to @lim.MaxSkill · each step costs its own number: a 3 is six points</span></h3>
        <div class="ws-skills">
            @foreach (var s in CharacterWorkshop.Skills)
            {
                var sk = s; int v = c.Skills.GetValueOrDefault(sk);
                <div class="ws-skill" title="@SkillWords.For(sk)"><span>@sk</span>
                    <button class="chip tiny" disabled="@(v <= 0)" @onclick="() => Step(sk, -1, lim.MaxSkill)">−</button>
                    <b class="@(v > 0 ? "" : "muted")">@v</b>
                    <button class="chip tiny" disabled="@(v >= lim.MaxSkill)" @onclick="() => Step(sk, 1, lim.MaxSkill)">+</button>
                    @if (free) { <button class="chip tiny" title="to the top" @onclick="() => Step(sk, 99, lim.MaxSkill)">max</button> }
                </div>
            }
        </div>
        @if (free) { <div class="ws-row"><button class="chip" @onclick="() => AllSkills(lim.MaxSkill)">Every skill to @lim.MaxSkill</button><button class="chip" @onclick="() => AllSkills(0)">Clear the skills</button></div> }
    }
    else if (_tab == "face")
    {
        @* Who you are to look at (docs/ART_DIRECTION.md, "Portraits"): the ancestry of your house, which your kin share; a face among
           those painted for it; and that face across a life, because you will wear all five. *@
        <h3>The ancestry of your house</h3>
        <p class="hint">Your kin by blood share it. Whoever marries in keeps their own, and a child takes after one parent.</p>
        <div class="chips">
            <button class="chip @(c.Ancestry.Length == 0 ? "on" : "")" @onclick='() => { c.Ancestry = ""; c.Face.Portrait = -1; Changed(); }'>as the dice fall</button>
            @foreach (var a in G.Content!.Ancestries.OfTheReach) { var id = a.Id; <button class="chip @(c.Ancestry == id ? "on" : "")" title="@a.Note" @onclick="() => { c.Ancestry = id; c.Face.Portrait = -1; Changed(); }">@a.Name</button> }
        </div>
        @if (G.Portraits != null && c.Ancestry.Length > 0 && G.Portraits.Faces(c.Sex, c.Ancestry, age) is { Count: > 0 } faces)
        {
            <h3>Your face</h3>
            <p class="hint">@faces.Count faces are painted for @G.Content.Ancestries.Name(c.Ancestry) @(c.Sex == "female" ? "women" : "men"). Each is painted at five ages and grows old with you.</p>
            <div class="face-pick">
                <button class="chip @(c.Face.Portrait < 0 ? "on" : "")" @onclick="() => { c.Face.Portrait = -1; Changed(); }">dice</button>
                @for (int i = 0; i < faces.Count; i++) { int k = i; <button class="face @(c.Face.Portrait == k ? "on" : "")" @onclick="() => { c.Face.Portrait = k; Changed(); }" title="face @(k + 1)"><img src="@faces[k]" alt="face @(k + 1)" loading="lazy" /></button> }
            </div>
            @if (G.Portraits.Life(c.Sex, c.Ancestry, c.Face.Portrait) is { Count: > 0 } life)
            {
                <h3>Across a life</h3>
                <div class="face-life">@foreach (var (when, url) in life) { <figure><img src="@url" alt="@when" loading="lazy" /><figcaption>@when</figcaption></figure> }</div>
            }
        }
        else if (G.Portraits != null) { <p class="hint">Choose an ancestry to choose a face. Left to the dice, your house's ancestry and your face are thrown for you.</p> }
        <p class="hint">The choices below only shape the drawn stand-in shown where no painted face exists.</p>
        <p class="hint">A face is thrown by the dice of the person unless you choose. Anything left on "dice" stays as thrown.</p>
        <h3>Skin</h3>
        <div class="chips"><button class="chip @(c.Face.Skin < 0 ? "on" : "")" @onclick="() => { c.Face.Skin = -1; Changed(); }">dice</button>@for (int i = 0; i < Skins.Length; i++) { int k = i; <button class="swatch @(c.Face.Skin == k ? "on" : "")" style="background:@Skins[k]" title="skin @(k + 1)" @onclick="() => { c.Face.Skin = k; Changed(); }"></button> }</div>
        <h3>Hair</h3>
        <div class="chips"><button class="chip @(c.Face.Hair < 0 ? "on" : "")" @onclick="() => { c.Face.Hair = -1; Changed(); }">dice</button>@for (int i = 0; i < Hairs.Length; i++) { int k = i; <button class="swatch @(c.Face.Hair == k ? "on" : "")" style="background:@Hairs[k]" title="hair @(k + 1)" @onclick="() => { c.Face.Hair = k; Changed(); }"></button> }</div>
        <h3>Cut</h3>
        <div class="chips"><button class="chip @(c.Face.Style < 0 ? "on" : "")" @onclick="() => { c.Face.Style = -1; Changed(); }">dice</button>@for (int i = 0; i < (c.Sex == "female" ? 2 : 5); i++) { int k = i; <button class="chip @(c.Face.Style == k ? "on" : "")" @onclick="() => { c.Face.Style = k; Changed(); }">cut @(k + 1)</button> }</div>
        @if (c.Sex != "female")
        {
            <h3>Beard</h3>
            <div class="chips"><button class="chip @(c.Face.Beard < 0 ? "on" : "")" @onclick="() => { c.Face.Beard = -1; Changed(); }">dice</button><button class="chip @(c.Face.Beard == 0 ? "on" : "")" @onclick="() => { c.Face.Beard = 0; Changed(); }">clean-shaven</button><button class="chip @(c.Face.Beard == 1 ? "on" : "")" @onclick="() => { c.Face.Beard = 1; Changed(); }">bearded</button></div>
        }
        <h3>Marks</h3>
        <div class="chips"><button class="chip @(c.Face.Scar ? "on" : "")" @onclick="() => { c.Face.Scar = !c.Face.Scar; Changed(); }">a scar across the cheek</button><button class="chip" @onclick="RollFace">Throw the face again</button></div>
        <p class="hint">Age greys the hair and lines the face as the years pass, whatever is chosen here.</p>
    }
    else if (_tab == "house")
    {
        <div class="grid2">
            <label title="The house is named for it. It follows the person's own family name until you write one here.">Family name <input value="@c.HouseName" @onchange="e => { c.HouseName = Text(e); _houseNamed = c.HouseName.Length > 0; Changed(); }" placeholder="from the person's name" /></label>
            <label>The name is <select value="@c.Origin" @onchange="e => { c.Origin = Text(e); Changed(); }"><option value="new">new: nobody's grandfather knew it</option><option value="old">old: it has sat in the chamber for generations</option></select></label>
            <label>Rank of the house <select value="@c.Title" @onchange="e => { c.Title = Text(e); Changed(); }">@foreach (var t in content.Titles.ByRank.Where(t => t.Rank <= lim.MaxTitleRank)) { <option value="@t.Id">@t.NameIn(era)</option> }</select></label>
            <label>Legitimacy <input type="number" min="0" max="@lim.MaxLegitimacy" value="@c.Legitimacy" @onchange="e => { c.Legitimacy = Num(e, 0, lim.MaxLegitimacy); Changed(); }" /></label>
            <label>Culture <select value="@c.Culture" @onchange="e => { c.Culture = Text(e); Changed(); }">@foreach (var k in content.Policies.Cultures.Keys.OrderBy(k => k, StringComparer.Ordinal)) { <option value="@k">@Cap(k)</option> }</select></label>
            <label>Party <select value="@c.Party" @onchange="e => { c.Party = Text(e); Changed(); }"><option value="">wherever its laws fit</option>@foreach (var p in content.Parties.Defs) { <option value="@p.Id">@p.Name</option> }</select></label>
        </div>
        <h3>Colour</h3>
        <div class="chips">@foreach (var a in CharacterWorkshop.Accents) { var col = a; <button class="swatch @(c.Accent == col ? "on" : "")" style="background:@col" @onclick="() => { c.Accent = col; Changed(); }"></button> }</div>
        <h3>The treasury <span class="muted">what the house has in hand on the first day</span></h3>
        <div class="ws-goods">
            @foreach (var good in CharacterWorkshop.Goods)
            {
                var gd = good; int cap = gd == Resource.Credits ? lim.MaxCredits : gd == Resource.Influence ? lim.MaxInfluence : lim.MaxGoods;
                int per = gd == Resource.Credits ? Money.PerUnit : 1;   // credits are typed as credits and kept in the books' hundreds (docs/MONEY.md)
                <label>@Cap(Resource.Label(gd)) <input type="number" min="0" step="@per" max="@(cap * per)" value="@(c.Treasury.GetValueOrDefault(gd) * per)" @onchange="e => { c.Treasury[gd] = Num(e, 0, cap * per) / per; Changed(); }" /></label>
            }
        </div>
        @if (!c.Imperium)
        {
            <h3>In the Republic</h3>
            <div class="chips"><button class="chip @(c.Seat ? "on" : "")" title="enrolled by the census: the house may move motions and stand for office without land or the bench" @onclick="() => { c.Seat = !c.Seat; Changed(); }">A seat in the Senate by the census</button></div>
            <label class="ws-wide">Patron <select value="@c.PatronId" @onchange="e => { c.PatronId = Text(e); Changed(); }"><option value="">none: the house stands alone</option>@foreach (var h in houses) { <option value="@h.Id">@h.Name · @content.Titles.NameOf(h.Title, era)</option> }</select></label>
        }
    }
    else if (_tab == "holdings")
    {
        <h3>Worlds <span class="muted">@c.Worlds.Count of @lim.MaxWorlds · a world another house holds is taken from it@(free ? "" : " · standard: unclaimed worlds, or one from a house that holds another")</span></h3>
            /* the map and the list read the same account of every world (CharacterWorkshop.Sites): what it is, whose, what it brings,
               and why a standard start may not take it (docs/CHARACTER.md, "The creator's map") */
            var sites = CharacterWorkshop.Sites(c, content, blank);
            double minX = sites.Min(s => s.X), maxX = sites.Max(s => s.X), minY = sites.Min(s => s.Y), maxY = sites.Max(s => s.Y);
            double spanX = Math.Max(1, maxX - minX), spanY = Math.Max(1, maxY - minY); const double MapW = 640, MapH = 380, Pad = 22;
            Func<double, string> px = x => (Pad + (x - minX) / spanX * (MapW - 2 * Pad)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
            Func<double, string> py = y => (Pad + (y - minY) / spanY * (MapH - 2 * Pad)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
            var byId = sites.ToDictionary(s => s.SystemId); bool full = c.Worlds.Count >= lim.MaxWorlds;
            // the colours the houses will wear in the game: the new house first (its own accent), the rest in the order of their ids
            var tint = blank.Houses.Values.Where(h => !World.Outsider(h.Id) && h.Id != CharacterWorkshop.HouseId).OrderBy(h => h.Id, StringComparer.Ordinal).Select((h, n) => (h.Id, colour: Palette.House(n + 1))).ToDictionary(t => t.Id, t => t.colour);
            var shown = _site != null && byId.TryGetValue(_site, out var hovered) ? hovered : c.Worlds.Count > 0 && byId.TryGetValue(c.Worlds[^1], out var last) ? last : null;
        <div class="ws-map-wrap">
            <svg class="ws-map" viewBox="0 0 640 380" role="img" aria-label="The map of the Reach: choose the worlds the house starts with" data-start-map="@sites.Count">
                @foreach (var l in blank.Galaxy.Lanes)
                {
                    if (byId.TryGetValue(l.A, out var la) && byId.TryGetValue(l.B, out var lb)) { <line class="ws-lane" x1="@px(la.X)" y1="@py(la.Y)" x2="@px(lb.X)" y2="@py(lb.Y)" /> }
                }
                @foreach (var s in sites)
                {
                    var sid = s.SystemId; bool mine = c.Worlds.Contains(sid); bool can = mine || (s.Refusal == null && !full);
                    string fill = mine ? (c.Accent.Length > 0 ? c.Accent : "#E6C77A") : s.HolderId.Length > 0 ? (tint.TryGetValue(s.HolderId, out var hc) ? hc : "#8a93a6") : "none";
                    <g class="ws-site @(mine ? "mine" : "") @(can ? "" : "no") @(s.Ring == Praetoria.Core.Galaxy.Ring.Beyond ? "beyond" : "")" data-site="@sid" data-site-can="@(can ? 1 : 0)"
                       @onclick="() => { _site = sid; if (can) ToggleWorld(sid, lim.MaxWorlds); Changed(); }" @onmouseover="() => { if (_site != sid) { _site = sid; } }">
                        <circle class="hit" cx="@px(s.X)" cy="@py(s.Y)" r="12" />
                        @if (mine) { <circle class="ring" cx="@px(s.X)" cy="@py(s.Y)" r="9.5" /> }
                        <circle class="dot" cx="@px(s.X)" cy="@py(s.Y)" r="@(blank.Galaxy.Capital == sid ? "7" : "5")" fill="@fill" stroke="@(s.HolderId.Length > 0 ? "#05070c" : "#aeb7c9")" />
                        @if (mine || blank.Galaxy.Capital == sid) { @((MarkupString)$"<text x=\"{px(s.X)}\" y=\"{py(s.Y - spanY * 0.045)}\" text-anchor=\"middle\">{System.Net.WebUtility.HtmlEncode(s.Name)}</text>") }
                        <title>@SiteLine(s)</title>
                    </g>
                }
            </svg>
            <div class="ws-site-card" data-site-card="@(shown?.SystemId ?? "")">
                @if (shown is { } sh)
                {
                    <div class="ws-site-head"><b>@sh.Name</b> <span class="muted small">@sh.Kind · @sh.Region · the @(sh.Ring == Praetoria.Core.Galaxy.Ring.Beyond ? "space beyond the Reach" : sh.Ring)</span></div>
                    <div class="ws-site-facts">
                    <div class="kv"><span>Held by</span><b>@(sh.HolderName.Length > 0 ? sh.HolderName : "no one: unclaimed")</b></div>
                    <div class="kv"><span>Brings a year</span><b>@(CourtProjection.Bundle(sh.Yield).Length > 0 ? CourtProjection.Bundle(sh.Yield) : "nothing as it stands")</b></div>
                    <div class="kv"><span>In the ground</span><b>@(sh.Deposits.Count > 0 ? string.Join(", ", sh.Deposits) : "nothing strategic")@(sh.Belt > 0 ? " · a belt of " + sh.Belt + " claim" + (sh.Belt == 1 ? "" : "s") : "")</b></div>
                    <div class="kv"><span>Lanes out</span><b>@sh.Lanes@(sh.BesideANation ? " · one leads into a nation's space" : "")</b></div>
                    <div class="kv" title="Raiders on the lanes of its region, of 100: it taxes every ledger there and feeds risings"><span>Lawlessness of the region</span><b>@sh.Lawlessness</b></div>
                    </div>
                    @if (sh.Refusal != null && !c.Worlds.Contains(sh.SystemId)) { <div class="warn small" data-site-refusal>Not for this start: @sh.Refusal.</div> }
                    else if (full && !c.Worlds.Contains(sh.SystemId)) { <div class="warn small">The house has its @lim.MaxWorlds world@(lim.MaxWorlds == 1 ? "" : "s"): give one up to take this.</div> }
                    else if (sh.HolderName.Length > 0 && !c.Worlds.Contains(sh.SystemId)) { <div class="muted small">Taking it takes it from @sh.HolderName, who will remember.</div> }
                }
                else { <span class="muted small">Point at a world to see what it is, whose it is and what it brings. Click one to take it or give it up. A filled dot is held, in its house's colour; a ring is unclaimed; a dim one may not be taken in this start.</span> }
            </div>
        </div>
        <details class="ws-fold" data-worlds-list><summary>The same worlds as a list</summary>
        <div class="ws-worlds">
            @foreach (var s in sites)
            {
                var sid = s.SystemId; bool mine = c.Worlds.Contains(sid);
                <button class="chip world @(mine ? "on" : "")" disabled="@(!mine && (s.Refusal != null || full))" title="@SiteLine(s)" @onclick="() => { _site = sid; ToggleWorld(sid, lim.MaxWorlds); }">
                    <b>@s.Name</b> <span class="muted small">@s.Kind · @(s.Ring == Praetoria.Core.Galaxy.Ring.Beyond ? "a nation's" : s.HolderName.Length > 0 ? s.HolderName.Replace("House ", "") : "unclaimed")@(CourtProjection.Bundle(s.Yield).Length > 0 ? " · " + CourtProjection.Bundle(s.Yield) : "")@(!mine && s.Refusal != null ? " · not for this start" : "")</span></button>
            }
        </div>
        </details>
        <div class="grid2">
            <label>Hulls in the house's fleet <input type="number" min="0" max="@lim.MaxHulls" value="@c.Hulls" @onchange="e => { c.Hulls = Num(e, 0, lim.MaxHulls); Changed(); }" /></label>
        </div>
        <h3>Ventures <span class="muted">@c.Ventures.Count of @lim.MaxVentures · open on the first day</span></h3>
        @for (int i = 0; i < c.Ventures.Count; i++)
        {
            int k = i; var v = c.Ventures[k];
            <div class="ws-line">
                <select value="@v.Kind" title="@(content.Businesses.Def(v.Kind)?.Description)" @onchange="e => { v.Kind = Text(e); Changed(); }">@foreach (var d in content.Businesses.Defs) { <option value="@d.Id" title="@d.Description">@d.Name · @CourtProjection.Bundle(d.Yield) a year</option> }</select>
                <span class="muted">at</span>
                <select value="@v.System" @onchange="e => { v.System = Text(e); Changed(); }">@foreach (var s in systems) { <option value="@s.Id">@s.Name</option> }</select>
                <button class="chip tiny" @onclick="() => { c.Ventures.RemoveAt(k); Changed(); }">remove</button>
                @if (content.Businesses.Def(v.Kind) is { } vd) { <div class="muted small" data-venture-says>@vd.Description @(CourtProjection.Bundle(vd.Yield).Length > 0 ? "Brings " + CourtProjection.Bundle(vd.Yield) + " a year at its first level." : "")@(vd.RequiresBelt ? " Needs a belt in the system." : "")@(vd.RequiresDeposit != null ? $" Needs {Resource.A(vd.RequiresDeposit)} deposit there." : "")@(vd.RequiresOwnWorld ? " Needs a world of your own there." : "")</div> }
            </div>
        }
        <button class="chip" disabled="@(c.Ventures.Count >= lim.MaxVentures)" @onclick="AddVenture">Add a venture</button>
    }
    else if (_tab == "family")
    {
        @if (c.Academy) { <p class="hint">A cadet of sixteen has no spouse or children. Brothers and sisters may be set.</p> }
        else
        {
            <h3>Spouse</h3>
            <div class="chips"><button class="chip @(c.Spouse == null ? "on" : "")" @onclick="() => { c.Spouse = null; Changed(); }">unwed</button><button class="chip @(c.Spouse != null ? "on" : "")" @onclick="Wed">wed</button></div>
            @if (c.Spouse is { } sp)
            {
                <div class="ws-line"><input value="@sp.Name" placeholder="a name by the dice" @onchange="e => { sp.Name = Text(e); Changed(); }" /><span class="muted">aged</span><input type="number" min="16" max="80" value="@sp.Age" @onchange="e => { sp.Age = Num(e, 16, 80); Changed(); }" /></div>
                @KinDetail(sp, "spouse")
                <label data-spouse-house>Of the house <select value="@sp.HouseId" @onchange="e => { sp.HouseId = Text(e); Changed(); }"><option value="">your own: they took your name</option>@foreach (var h in houses) { <option value="@h.Id">@h.Name</option> }</select></label>
                <p class="hint">@(sp.HouseId.Length > 0 && blank.House(sp.HouseId) is { } sph
                    ? $"A husband or wife from {sph.Name} keeps that house's name and lives with yours, as one married in play does. The children are your house's. Its head thinks well of you from the first day (regard {CharacterWorkshop.SpouseHouseRegard}), and you of them ({CharacterWorkshop.SpouseHouseRegardBack}). It costs {CharacterWorkshop.SpouseHouseCost} point in a standard start."
                    : "Name a house and the marriage is a tie to it: its head thinks well of you from the first day.")</p>
            }
            <h3>Children <span class="muted">@c.Children.Count of @lim.MaxChildren · none older than @Math.Max(0, age - CharacterWorkshop.MinAge)</span></h3>
            @for (int i = 0; i < c.Children.Count; i++)
            {
                int k = i; var kid = c.Children[k];
                <div class="ws-line"><input value="@kid.Name" placeholder="a name by the dice" @onchange="e => { kid.Name = Text(e); Changed(); }" />
                    <select value="@kid.Sex" @onchange="e => { kid.Sex = Text(e); Changed(); }"><option value="male">son</option><option value="female">daughter</option></select>
                    <span class="muted">aged</span><input type="number" min="0" max="@Math.Max(0, age - CharacterWorkshop.MinAge)" value="@kid.Age" @onchange="e => { kid.Age = Num(e, 0, 64); Changed(); }" />
                    <button class="chip tiny" @onclick="() => { c.Children.RemoveAt(k); Changed(); }">remove</button></div>
                @KinDetail(kid, "child")
            }
            <button class="chip" disabled="@(c.Children.Count >= lim.MaxChildren || age <= CharacterWorkshop.MinAge)" @onclick="AddChild">Add a child</button>
        }
        <h3>Brothers and sisters <span class="muted">@c.Siblings.Count of @lim.MaxSiblings</span></h3>
        @for (int i = 0; i < c.Siblings.Count; i++)
        {
            int k = i; var sib = c.Siblings[k];
            <div class="ws-line"><input value="@sib.Name" placeholder="a name by the dice" @onchange="e => { sib.Name = Text(e); Changed(); }" />
                <select value="@sib.Sex" @onchange="e => { sib.Sex = Text(e); Changed(); }"><option value="male">brother</option><option value="female">sister</option></select>
                <span class="muted">aged</span><input type="number" min="0" max="80" value="@sib.Age" @onchange="e => { sib.Age = Num(e, 0, 80); Changed(); }" />
                <button class="chip tiny" @onclick="() => { c.Siblings.RemoveAt(k); Changed(); }">remove</button></div>
            @KinDetail(sib, "sibling")
        }
        <button class="chip" disabled="@(c.Siblings.Count >= lim.MaxSiblings)" @onclick="AddSibling">Add a brother or sister</button>
        <h3>Father and mother <span class="muted">living and of the house, or names in the chronicle · @CharacterWorkshop.ParentCost points each</span></h3>
        <div data-parents>
        @foreach (var (who, label) in new[] { ("father", "Father"), ("mother", "Mother") })
        {
            string w = who; var par = w == "father" ? c.Father : c.Mother;
            <div class="ws-line"><b class="ws-kin-what">@label</b>
                <span class="chips"><button class="chip tiny @(par == null ? "on" : "")" @onclick="() => { SetParent(w, false); Changed(); }">dead</button><button class="chip tiny @(par != null ? "on" : "")" data-parent-living="@w" @onclick="() => { SetParent(w, true); Changed(); }">living</button></span>
                @if (par != null)
                {
                    <input value="@par.Name" placeholder="a name by the dice" @onchange="e => { par.Name = Text(e); Changed(); }" />
                    <span class="muted">aged</span><input type="number" min="@(age + CharacterWorkshop.ParentGap)" max="@CharacterWorkshop.MaxParentAge" value="@par.Age" @onchange="e => { par.Age = Num(e, 16, CharacterWorkshop.MaxParentAge); Changed(); }" />
                }
            </div>
            @if (par != null) { @KinDetail(par, w) }
        }
        </div>
        <p class="hint">A relative of sixteen or more is somebody: a service of their own, a step in it from twenty (@CharacterWorkshop.KinRankCost points a step), what they are known for, and a gift (@CharacterWorkshop.KinAptitudeCost points). Leave a line alone and the dice decide the nature, and they follow your service from the bottom. You are the head of the house whoever else is living.</p>
    }
    else
    {
        <h3>The age</h3>
        <div class="chips"><button class="chip @(c.Imperium ? "" : "on")" @onclick="() => SetEra(false)">The Republic</button><button class="chip @(c.Imperium ? "on" : "")" @onclick="() => SetEra(true)">The Imperium, under a living Emperor</button></div>
        <h3>Where the story opens</h3>
        <div class="chips"><button class="chip @(c.Academy ? "" : "on")" @onclick="() => { c.Academy = false; Changed(); }">In the world, at the age chosen</button><button class="chip @(c.Academy ? "on" : "")" @onclick="StartAtAcademy">At @(c.Imperium ? "the Institute" : "the Academy"), at sixteen</button></div>
        <div class="grid2">
            <label>A friend among the houses <select value="@c.FriendId" @onchange="e => { c.FriendId = Text(e); Changed(); }"><option value="">none</option>@foreach (var h in houses) { <option value="@h.Id">@h.Name</option> }</select></label>
            <label>A rival among the houses <select value="@c.RivalId" @onchange="e => { c.RivalId = Text(e); Changed(); }"><option value="">none</option>@foreach (var h in houses) { <option value="@h.Id">@h.Name</option> }</select></label>
        </div>
        <p class="hint">A friend's head thinks well of you from the first day; a rival's does not, and that is worth two points back.</p>
    }

    @if (problems.Count > 0)
    {
        <div class="ws-problems"><b>Before this character can begin</b>@foreach (var pr in problems.Take(8)) { <div>@Cap(pr).</div> }</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CustomCharacter Spec { get; set; } = default!;
    [Parameter] public EventCallback<CustomCharacter> SpecChanged { get; set; }
    private string _tab = "person"; private string? _fileError; private int _dice = 1;
    private static readonly (string id, string label)[] Tabs = { ("person", "The person"), ("face", "The face"), ("house", "The house"), ("holdings", "What it holds"), ("family", "The family"), ("world", "The world") };
    // the same lists js/portrait.js draws from, for the swatches
    private static readonly string[] Skins = { "#f1d5bf", "#e6c2a3", "#d4a883", "#c08c67", "#a0694a", "#7a4a32", "#5a3524" };
    private static readonly string[] Hairs = { "#1a1512", "#2e2118", "#4a2f1c", "#6b4a2a", "#8a6a3a", "#b08a4a", "#d2b06a", "#3a3a3f", "#7a2a1e" };

    /// <summary>The world the pointer is on in the creator's map, or the last one clicked.</summary>
    private string? _site;
    /// <summary>One line on a world, for a tooltip: what the card beside the map says at length.</summary>
    private static string SiteLine(StartSite s) =>
        s.Name + ": " + s.Kind + " · " + s.Region + " · " + (s.HolderName.Length > 0 ? "held by " + s.HolderName : "unclaimed")
        + (CourtProjection.Bundle(s.Yield).Length > 0 ? " · brings " + CourtProjection.Bundle(s.Yield) + " a year" : "")
        + (s.Deposits.Count > 0 ? " · " + string.Join(", ", s.Deposits) + " in the ground" : "") + " · " + s.Lanes + " lane" + (s.Lanes == 1 ? "" : "s")
        + (s.BesideANation ? " · beside a nation's space" : "") + (s.Refusal != null ? " · not for this start: " + s.Refusal : "");
    private static string WorldTip(World w, Praetoria.Core.Galaxy.StarSystem s) => s.PlanetClass + " · " + (w.Galaxy!.Regions.FirstOrDefault(r => r.Id == s.RegionId)?.Name ?? "") + (w.Galaxy.Capital == s.Id ? " · the capital" : "");
    private bool _houseNamed; private string _sig = "";
    private static string Surname(string name) { var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length > 1 ? parts[^1] : ""; }
    private void Changed() => StateHasChanged();
    /* the button that begins the saga is the parent's, and a parent is not drawn again because a child was: when the points or the
       problems change, say so upward, so "Begin" and the red line follow the character as it stands (docs/PLAYTHROUGH.md, Easy, N8) */
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (G.Content == null) return;
        string sig = CharacterWorkshop.Cost(Spec, G.Content).Item1 + ":" + string.Join("|", CharacterWorkshop.Problems(Spec, G.Content, G.BlankWorld(Spec.Imperium)));
        if (sig == _sig) return; bool first = _sig.Length == 0; _sig = sig; if (!first) await SpecChanged.InvokeAsync(Spec);
    }
    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? "";
    private static int Num(ChangeEventArgs e, int lo, int hi) => int.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, lo, hi) : lo;
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    private void Toggle(List<string> set, string id, int max) { if (!set.Remove(id) && set.Count < max) set.Add(id); }
    private void Step(string skill, int by, int max) { int v = Math.Clamp(Spec.Skills.GetValueOrDefault(skill) + by, 0, max); if (v == 0) Spec.Skills.Remove(skill); else Spec.Skills[skill] = v; }
    private void AllSkills(int v) { Spec.Skills.Clear(); if (v > 0) foreach (var s in CharacterWorkshop.Skills) Spec.Skills[s] = v; }
    private void ToggleWorld(string sys, int max) { if (!Spec.Worlds.Remove(sys) && Spec.Worlds.Count < max) Spec.Worlds.Add(sys); }
    private void AddVenture() => Spec.Ventures.Add(new VentureSpec { Kind = G.Content!.Businesses.Defs.First().Id, System = Spec.Worlds.FirstOrDefault() ?? G.BlankWorld(Spec.Imperium).Galaxy!.Capital });
    private void Wed() { Spec.Spouse ??= new KinSpec { Age = Math.Max(CharacterWorkshop.MinAge, Spec.Age - 1) }; }
    private void AddChild() => Spec.Children.Add(new KinSpec { Sex = Spec.Children.Count % 2 == 0 ? "female" : "male", Age = Math.Clamp(Spec.Age - 22, 0, Math.Max(0, Spec.Age - CharacterWorkshop.MinAge)) });
    private void AddSibling() => Spec.Siblings.Add(new KinSpec { Sex = Spec.Siblings.Count % 2 == 0 ? "female" : "male", Age = Math.Max(0, (Spec.Academy ? CharacterWorkshop.AcademyAge : Spec.Age) - 3) });
    private void SetParent(string who, bool living)
    {
        int a = Math.Min(CharacterWorkshop.MaxParentAge, (Spec.Academy ? CharacterWorkshop.AcademyAge : Spec.Age) + 26);
        if (who == "father") Spec.Father = living ? Spec.Father ?? new KinSpec { Sex = "male", Age = a + 2 } : null; else Spec.Mother = living ? Spec.Mother ?? new KinSpec { Sex = "female", Age = a } : null;
    }
    private string Era => Spec.Imperium ? World.EraImperium : World.EraRepublic;
    /// <summary>What a background gives, in a line: the same figures the engine applies.</summary>
    private static string BackgroundGives(BackgroundDef b)
    {
        var parts = new List<string>(); if (b.Legitimacy != 0) parts.Add($"legitimacy {b.Legitimacy:+0;-0}");
        string purse = CourtProjection.Bundle(b.Treasury); if (purse.Length > 0) parts.Add(purse);
        foreach (var t in b.Nature.Concat(b.Aptitude)) parts.Add(t); foreach (var kv in b.Skills.OrderBy(kv => kv.Key, StringComparer.Ordinal)) parts.Add($"{kv.Key} {kv.Value:+0;-0}");
        if (b.Stress > 0) parts.Add($"strain {b.Stress:+0}");
        return string.Join(" · ", parts) + ".";
    }
    private static string BackgroundPrice(BackgroundDef b) { int pts = CharacterWorkshop.BackgroundCost(b); return pts > 0 ? $"It costs {pts} point{(pts == 1 ? "" : "s")}." : pts < 0 ? $"It gives {-pts} point{(pts == -1 ? "" : "s")} back." : "It costs nothing."; }
    /// <summary>What one relative is, on the line under their name: a service, a step in it, a nature and a gift.</summary>
    private RenderFragment KinDetail(KinSpec k, string what) => @<div class="ws-line sub" data-kin-detail="@what">
        @if (k.Age < DynastySystem.AgeOfMajority) { <span class="muted small">Under sixteen: what they will be comes with the years.</span> }
        else
        {
            var careers = G.Content!.Careers; string service = k.Track.Length > 0 ? k.Track : Spec.Track; int top = Math.Min(WorkshopLimits.For(Spec.Mode).MaxKinRank, careers.MaxRank(service) ?? 0);
            <select title="The service they are in" value="@k.Track" @onchange="e => { k.Track = Text(e); k.Rank = 0; Changed(); }"><option value="">in your service</option>@foreach (var t in careers.Defs) { <option value="@t.Id">@t.NameIn(Era)</option> }</select>
            <select title="@(k.Age < CharacterWorkshop.KinRankAge ? $"Nobody has a step in a service before {CharacterWorkshop.KinRankAge}" : "How far up it they have got")" value="@k.Rank" disabled="@(k.Age < CharacterWorkshop.KinRankAge)" @onchange="e => { k.Rank = Num(e, 0, 9); Changed(); }">@for (int r = 0; r <= top; r++) { int rr = r; <option value="@rr">@(careers.RankName(service, rr, Era) ?? "step " + rr)</option> }</select>
            <select title="What they are known for" value="@k.Nature" @onchange="e => { k.Nature = Text(e); Changed(); }"><option value="">a nature by the dice</option>@foreach (var t in G.Content.Traits.Nature) { <option value="@t.Id">@t.Name</option> }</select>
            <select title="A gift" value="@k.Aptitude" @onchange="e => { k.Aptitude = Text(e); Changed(); }"><option value="">no particular gift</option>@foreach (var t in G.Content.Traits.Aptitude) { <option value="@t.Id">@t.Name</option> }</select>
        }
    </div>;
    private void StartAtAcademy() { Spec.Academy = true; Spec.Spouse = null; Spec.Children.Clear(); }
    private void RollFace() { _dice++; uint h = 2166136261; foreach (var ch in "face:" + _dice) h = (h ^ ch) * 16777619; Spec.Face.Skin = (int)(h % 7); Spec.Face.Hair = (int)(h / 7 % 9); Spec.Face.Style = (int)(h / 63 % 5); }
    private async Task SetMode(string mode) { Spec.Mode = mode; await SpecChanged.InvokeAsync(Spec); }
    private void SetEra(bool imperium) { Spec.Imperium = imperium; if (imperium) { Spec.Seat = false; Spec.PatronId = ""; } var w = G.BlankWorld(imperium); Spec.Worlds.RemoveAll(s => w.Galaxy!.System(s) == null); }
    private async Task UsePreset(string name) { var spec = CharacterWorkshop.Presets(G.Content!).First(p => p.name == name).spec.Clone(); await SpecChanged.InvokeAsync(spec); }
    private async Task Randomise() { _dice++; var spec = CharacterWorkshop.Random(G.Content!, (ulong)(_dice * 7919 + Spec.Age), Spec.Mode, G.BlankWorld(Spec.Imperium)); spec.Imperium = Spec.Imperium; if (spec.Imperium) { spec.Seat = false; spec.PatronId = ""; } await SpecChanged.InvokeAsync(spec); }
    private async Task SaveFile() { try { await JS.InvokeVoidAsync("praetoria.download", "praetoria-character.json", Spec.ToJson()); } catch { } }
    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        _fileError = null;
        try { using var s = e.File.OpenReadStream(256 * 1024); using var r = new StreamReader(s); await SpecChanged.InvokeAsync(CustomCharacter.FromJson(await r.ReadToEndAsync())); }
        catch (Exception ex) { _fileError = "Could not read that character file: " + ex.Message; }
    }
}
