@preservewhitespace true
@using Praetoria.Core.Systems
@inject GameClient G
@implements IDisposable
@* The ladder of offices on the Senate window (docs/LADDER.md; docs/VISUAL_SYSTEM.md 4.6, 4.7): a section, the next election and the
   magistrates' trust as its first lines, the year's business of the head's own office as an entry with its choices, then each rung as
   an entry: who sits in it (their faces), who of the house stands for it and what is spent on them, and the plate to stand. *@
@{
    var w = G.World!; var c = G.Content!; var p = w.Protagonist!; var pid = p.Id; var house = w.House(p.HouseId)!; var offices = c.Offices;
    bool active = LadderSystem.Active(w, offices); int next = LadderSystem.CountIn(w, offices);
    var mySeat = LadderSystem.Seat(w, pid); var myStand = w.Candidacies.FirstOrDefault(x => x.CharacterId == pid);
    var consul = ElectionSystem.ConsulOffices(offices).FirstOrDefault();
    var consulMan = consul != null ? OfficeSystem.Candidate(w, consul, house.Id) : null;
    var consulAway = consul != null ? TriumphSystem.ConsulAwayOne(w, offices, house.Id) : null;   /* one who would stand for consul but commands away from the capital */
    var work = LadderSystem.BusinessOf(w, pid); int trust = LadderSystem.Trust(w); bool hadWork = w.OfficeWork.Any(b => b.HolderId == pid && b.RungId == mySeat?.OfficeId);
    string trustWord = trust < LadderSystem.TrustLow ? "for sale, and everyone knows it" : trust < 50 ? "not much trusted" : trust < 70 ? "trusted, more or less" : "trusted";
    string trustDoes = LadderSystem.TrustSays(w); int taint = LadderSystem.TaintCost(w, house.Id); int scandal = w.Counter(LadderSystem.ScandalKey(house.Id));
    string taintLine = taint == 0 ? "" : "One of your house was removed from office in year " + scandal + ". Until year " + (scandal + LadderSystem.ScandalYears) + " its candidates lose " + taint + " votes at every count, for consul as well.";
    string trustClass = trust < LadderSystem.TrustLow ? "pill bad" : trust < 50 ? "pill warn" : "pill good";
    string workTitle = work == null ? "" : "The business of your office: " + (work.Kind == LadderSystem.Case ? "a case" : work.Kind == LadderSystem.Works ? "the works" : "the accounts");
    string workSays = work == null ? "" : LadderSystem.Says(w, offices, work);
    int latest = w.OfficeWork.Count == 0 ? -1 : w.OfficeWork.Max(b => b.Turn);   // drawn up at the year's turning, so it carries last year's number
    var done = w.OfficeWork.Where(b => b.Turn == latest && b.Choice.Length > 0 && b.Choice != "left").Select(b => (b, who: w.Char(b.HolderId))).Where(x => x.who != null).ToList();
    string Did(OfficeBusiness b) => b.Choice switch
    {
        LadderSystem.Straight => "closed the accounts as they stood",
        LadderSystem.Relief => b.RegionId.Length > 0 ? "found money for " + (w.Galaxy?.Region(b.RegionId)?.Name ?? "a region") : "closed the accounts as they stood",
        LadderSystem.Favour => "closed the accounts, it is said, to their own house's good",
        LadderSystem.Lanes => "repaired the lanes" + (b.RegionId.Length > 0 ? " of " + (w.Galaxy?.Region(b.RegionId)?.Name ?? "") : ""),
        LadderSystem.Grain => "gave grain to the squares",
        LadderSystem.Nothing => "did nothing with the year",
        LadderSystem.Law => b.HouseA.Length == 0 ? "heard no case of weight" : "ruled on the law for " + (w.House(b.RightId)?.Name ?? ""),
        LadderSystem.Friend => "ruled for a friend",
        LadderSystem.Gift => "ruled, it is said, for whoever paid",
        LadderSystem.Settle => "brought two houses to terms",
        LadderSystem.Both => "gave lanes and grain both",
        _ => "sat"
    };
    string Held(Character x) => x.Cursus.Count == 0 ? "nothing yet" : string.Join(", then ", x.Cursus.Select(id => offices.Rung(id)?.Name.ToLowerInvariant() ?? id));
}
<section class="panel cursus sn-panel">
    @if (active)
    {
        string when = next <= 0 ? "at the end of this year" : next == 1 ? "at the end of next year, year " + (w.Turn + 1) : "in " + next + " years, at the end of year " + (w.Turn + next);
        <p class="ui-lede sn-lede" data-next-election="@next">@SenateScreen.Bold((p.Cursus.Count == 0 ? "You have held no office yet." : $"You have been {Held(p)}.") + $" The next election is {when}, and {Counted.Names(w.Candidacies.Count)} {Counted.Are(w.Candidacies.Count)} down so far.")</p>
    }
    <Section Title="The ladder of offices" Info="Each rung is held by a person, for five years, and filled by election: every rung below the consulship at the same count, and names go down before it. The houses vote with their weight in the chamber; a candidate's own speaking, standing and record count besides.">
        <Right><span>@(active ? $"the next election in {Counted.Years(next)}" : "there are no elections under a throne")</span></Right>
    </Section>
    @if (!active) { <EmptyState Icon="stairs-goal" Text="Under the Imperium offices are the throne's to give. The ladder belongs to the Republic." /> }
    else
    {
        <div class="sn-intro">
            @if (TriumphSystem.HasLeave(w, house.Id)) { <p class="sn-say ui-up" data-absence-leave="1">The Senate has given your house leave to stand in absence: at the next election those of the house who command away from the capital may stand without coming home.</p> }
            @{ string apartSays = LadderSystem.TrustApartSays(w) is { Length: > 0 } apart ? "\n" + apart : ""; }
            <div class="sn-trust" title="@(TrustTip + "\n" + trustDoes + apartSays)"><Meter Label="Trust in office" Value="@trust" Max="100" Color="@(trust < LadderSystem.TrustLow ? "#b8452f" : trust < 50 ? "#e3a64a" : "#8cc47e")" Text="@trust.ToString()" Tip="@TrustTip" /><span class="sn-say">The magistrates are <span class="@trustClass">@trustWord</span> <Icon Name="info" Tone="ivory" Size="12" /></span></div>
            @if (taintLine.Length > 0) { <div class="ui-wstrip bad sn-strip"><Icon Name="alert" Tone="ember" Size="18" /><span class="ui-wstrip-t">@taintLine</span></div> }
        </div>
        @if (work != null)
        {
            <div class="sn-ent rung-row office-work waits">
                <span class="sn-ic mine"><Icon Name="@RungIcon(mySeat?.OfficeId ?? "")" Tone="brass" Size="22" /></span>
                <div class="sn-ent-main">
                    <div class="sn-hd"><b class="sn-nm">@workTitle</b><span class="sn-tag warn">waits on you</span></div>
                    <div class="sn-tx">@workSays</div>
                    <div class="sn-choices">
                    @foreach (var choice in LadderSystem.ChoicesFor(work.Kind))
                    {
                        string ch = choice; var no = new LadderCommand(pid, LadderCommand.Decide, pid, ch, offices).Refusal(G.Ctx); string tip = LadderSystem.ChoiceSays(w, work, ch);
                        <div class="sn-choice suit-acts">
                            <Plate Label="@Label(ch)" Small="true" Locked="@(no != null)" Disabled="@(no != null)" Tip="@(no ?? tip)" OnClick="() => G.Execute(new LadderCommand(pid, LadderCommand.Decide, pid, ch, offices))" />
                            <span class="sn-say">@tip</span>
                        </div>
                    }
                    </div>
                    <div class="sn-say ui-mute">Left undone, the clerks close it at the year's end, and it is noticed.</div>
                </div>
            </div>
        }
        else if (mySeat != null) { <p class="sn-say sn-pad ui-dim">@(hadWork ? WorkDone : WorkNotYet)</p> }
        @if (done.Count > 0)
        {
            <details class="sn-det"><summary><Icon Name="chev" Size="11" Class="flat" />What the magistrates did this year (@done.Count)</summary>
                @foreach (var (b, who) in done)
                {
                    <div class="sn-tx ui-dim">@who!.Name@(who.HouseId == house.Id ? " (yours)" : " of " + w.House(who.HouseId)?.Name), @(offices.Rung(b.RungId)?.Name.ToLowerInvariant() ?? "in office"): @Did(b).</div>
                }
            </details>
        }
        @foreach (var rung in offices.Rungs)
        {
            string rid = rung.Id; var holders = LadderSystem.Holders(w, rung.Id); var ours = w.Candidacies.Where(x => x.RungId == rung.Id).ToList();
            var stand = new LadderCommand(pid, LadderCommand.Stand, pid, rid, offices).Refusal(G.Ctx); bool sitsHere = mySeat?.OfficeId == rung.Id;
            bool heldIt = p.Cursus.Contains(rid);
            <div class="sn-ent rung-row lad @(sitsHere ? "mine now" : heldIt ? "held" : "open")" data-rung-office="@rid">
                <span class="sn-ic lad-node @(sitsHere ? "mine" : "")" title="@(sitsHere ? "You sit in this office" : heldIt ? "You have held this office" : "Not yet held")"><Icon Name="@RungIcon(rid)" Tone="@(sitsHere ? "dark" : heldIt ? "brass" : "ivory")" Size="20" /></span>
                <div class="sn-ent-main">
                    <div class="sn-hd"><b class="sn-nm" title="@rung.Description">@rung.Name</b><span class="sn-sub">@Counted.Seats(rung.Seats) · from @SenateActs.AgeFor(w, rung.MinAge)@(rung.Requires.Length > 0 ? $" · must have been {offices.Rung(rung.Requires)?.Name.ToLowerInvariant()}" : "")@(rung.Stipend > 0 ? $" · pays {Money.Show(rung.Stipend)} a year" : "")</span>
                        @if (sitsHere) { <span class="sn-tag mine">you sit</span> }</div>
                    <div class="sn-sitting"><span class="sn-lbl">Sitting</span>
                        @if (holders.Count == 0) { <i class="ui-mute">nobody</i> }
                        @foreach (var h in holders)
                        {
                            var x = w.Char(h.CharacterId); if (x == null) continue;
                            <span class="sn-who @(x.HouseId == house.Id ? "mine" : "")" title="@(x.HouseId == house.Id ? $"{x.Name}, of your house" : $"{x.Name} of {w.House(x.HouseId)?.Name}")"><Portrait Id="@x.Id" Name="@x.Name" Sex="@x.Sex" Age="@x.Age" Accent="@(w.House(x.HouseId)?.AccentColor ?? "#888")" Size="30" Height="36" />@x.Name</span>
                        }
                    </div>
                    @foreach (var cd in ours)
                    {
                        var x = w.Char(cd.CharacterId); if (x == null) continue; string xid = x.Id; var back = new LadderCommand(pid, LadderCommand.Back, xid, string.Empty, offices).Refusal(G.Ctx);
                        @if (TriumphSystem.AwaySays(w, x) is { } awayNow) { <div class="sn-note warn" data-stand-away="@xid"><Icon Name="eagle-emblem" Tone="brass" Size="15" /><span>@Cap(awayNow). The name is taken down at the year's end unless the fleet is brought to the capital, or the command given up, first.</span></div> }
                        <div class="sn-cand">
                            <Portrait Id="@x.Id" Name="@x.Name" Sex="@x.Sex" Age="@x.Age" Accent="@house.AccentColor" Size="24" Height="28" />
                            <span class="sn-say"><b>@(x.Id == pid ? "You are" : x.Name + " is") standing</b> <span class="ui-mute">(the count is @(next <= 0 ? "at this year's end" : "in " + Counted.Years(next) + "") · @Counted.Names(w.Candidacies.Count(o => o.RungId == cd.RungId)) down for this rung)</span>@(cd.Backing > 0 ? $", with {cd.Backing} votes of your weight behind {(x.Id == pid ? "you" : "them")}" : "")@(x.Id == pid ? "" : ", of their own accord").</span>
                        </div>
                        <div class="sn-acts suit-acts">
                            <Plate Label="@(x.Id == pid ? "Call in what is owed" : "Speak for them")" Small="true" Icon="public-speaker" Locked="@(back != null)" Disabled="@(back != null)" Tip="@(back ?? $"{LadderSystem.BackVotes} more votes at the count")" CostIcon="public-speaker" CostText="@LadderSystem.BackInfluence.ToString()" OnClick="() => G.Execute(new LadderCommand(pid, LadderCommand.Back, xid, string.Empty, offices))" />
                            @foreach (var size in LadderSystem.CampaignSizes)
                            {
                                /* coin behind the canvass, out of the treasury (docs/WEALTH.md, "Things worth a rich house's money") */
                                string sz = size, fk = xid + "|" + sz; var fundNo = new FundCampaignCommand(pid, xid, sz, offices).Refusal(G.Ctx); int due = Math.Max(0, LadderSystem.CampaignCost(sz) - (LadderSystem.CampaignOf(w, xid)?.Spent ?? 0));
                                bool paid = due == 0 && LadderSystem.CampaignOf(w, xid) != null;
                                <Plate Label="@(paid ? Cap(LadderSystem.CampaignName(sz)) + ": paid for" : "Pay for " + LadderSystem.CampaignName(sz))" Small="true" Locked="@(fundNo != null)" Disabled="@(fundNo != null)" Tip="@(fundNo ?? FundTip(sz))" CostIcon="@(paid ? "" : "credits")" CostText="@(paid ? "" : Money.Show(due))" OnClick="() => G.Execute(new FundCampaignCommand(pid, xid, sz, offices))" data-fund-canvass="@fk" />
                            }
                            @if (x.Id == pid) { <Plate Label="Withdraw" Small="true" Tip="Take your name down from the count" OnClick="() => G.Execute(new LadderCommand(pid, LadderCommand.Withdraw, pid, string.Empty, offices))" /> }
                            else
                            {
                                var down = new LadderCommand(pid, LadderCommand.Dissuade, xid, string.Empty, offices).Refusal(G.Ctx);
                                <Plate Label="Ask them to stand down" Small="true" Locked="@(down != null)" Disabled="@(down != null)" Tip="@(down ?? AskDown)" OnClick="() => G.Execute(new LadderCommand(pid, LadderCommand.Dissuade, xid, string.Empty, offices))" />
                            }
                        </div>
                    }
                    @if (ours.Count > 0)
                    {
                        /* what coin is behind whom for this office, and, for one of the house who keeps a house at the capital, how the count stands */
                        var rivals = LadderSystem.RivalCampaigns(w, rid); var mineFunds = ours.Select(o => LadderSystem.CampaignOf(w, o.CharacterId)).Where(f => f != null).ToList();
                        bool hears = G.Turn != null && ours.Any(o => WealthSystem.AtTheCapital(w, o.CharacterId));
                        if (mineFunds.Count > 0) { <div class="sn-note" data-canvass-paid="@rid"><Icon Name="credits" Tone="brass" Size="15" /><span>@string.Join("; ", mineFunds.Select(f => (f!.CharacterId == pid ? "Your canvass" : (w.Char(f.CharacterId)?.Name ?? "One of yours") + "'s canvass") + " has " + Money.Credits(f.Spent) + " of the house's behind it, worth " + f.Votes + " votes")).</span></div> }
                        if (rivals.Count > 0) { <div class="sn-note warn" data-canvass-rivals="@rid"><Icon Name="credits" Tone="ember" Size="15" /><span>@string.Join("; ", rivals.Select(f => (w.House(f.HouseId)?.Name ?? "A house") + " has put " + Money.Credits(f.Spent) + " behind its candidate, worth " + f.Votes + " votes")).</span></div> }
                        if (hears)
                        {
                            var stands = LadderSystem.CountAsItStands(w, offices, rung, id => G.Turn!.Senate.Weight(w, id));
                            <div class="sn-note" data-count-stands="@rid" title="Heard at the capital, where one of yours standing for this office keeps a house. It is how the count would go if it were held today, and it changes as names go down and coin is spent."><Icon Name="vote" Tone="brass" Size="15" /><span>As the count stands, for @Counted.Seats(rung.Seats): @string.Join(", ", stands.Take(8).Select(x => (x.who.HouseId == house.Id ? x.who.Name + " (yours)" : x.who.Name + " of " + (w.House(x.who.HouseId)?.Name ?? "")) + " " + x.votes)).</span></div>
                        }
                        else { <div class="sn-say ui-mute">One of the house with a house at the capital would hear how this count stands before it is held (House, Purses and the will).</div> }
                    }
                    @if (myStand == null)
                    {
                        <div class="sn-acts suit-acts">
                            <Plate Label="@("Stand for " + rung.Name.ToLowerInvariant())" Small="true" Icon="stairs-goal" Locked="@(stand != null)" Disabled="@(stand != null)" Tip="@(stand ?? "Your name goes down for the next election")" CostIcon="public-speaker" CostText="@LadderSystem.StandInfluence.ToString()" OnClick="() => G.Execute(new LadderCommand(pid, LadderCommand.Stand, pid, rid, offices))" />
                            @if (stand != null) { <span class="sn-no">@Cap(You(stand)).</span> }
                        </div>
                    }
                    @if (sitsHere && rung.Games > 0)
                    {
                        var games = new LadderCommand(pid, LadderCommand.Games, pid, string.Empty, offices).Refusal(G.Ctx);
                        <div class="sn-acts suit-acts"><Plate Label="Give games" Small="true" Icon="laurels" Locked="@(games != null)" Disabled="@(games != null)" Tip="@(games ?? $"The house gains standing, and it is written into your life. It costs {Money.Credits(rung.Games)} of your own.")" CostIcon="credits" CostText="@Money.Show(rung.Games)" OnClick="() => G.Execute(new LadderCommand(pid, LadderCommand.Games, pid, string.Empty, offices))" /><span class="sn-say ui-mute">credits of your own</span></div>
                    }
                </div>
            </div>
        }
        @if (consul != null)
        {
            <div class="sn-ent rung-row lad open top" data-rung-office="consul">
                <span class="sn-ic lad-node" title="The top of the ladder"><Icon Name="podium" Tone="ivory" Size="20" /></span>
                <div class="sn-ent-main">
                    <div class="sn-hd"><b class="sn-nm">Consul</b><span class="sn-sub">2 seats · from @SenateActs.AgeFor(w, consul.MinAge) · must have been @(offices.Rung(consul.Requires)?.Name.ToLowerInvariant() ?? "praetor") · elected every tenth year</span></div>
                    <div class="sn-tx">@(consulMan != null ? $"{(consulMan.Id == pid ? "You are" : consulMan.Name + " is")} of an age and a record to stand for the house." : consulAway != null ? "Nobody of the house may stand for consul who is in the capital." : $"Nobody of the house is yet {SenateActs.AgeFor(w, consul.MinAge)} and has been praetor. The house cannot stand for consul.")</div>
                    @if (consulAway != null && TriumphSystem.AwaySays(w, consulAway) is { } consulNo) { <div class="sn-note warn" data-consul-away="@consulAway.Id"><Icon Name="eagle-emblem" Tone="brass" Size="15" /><span>@Cap(consulNo).@(consulMan != null ? " Until then the house would stand in the person of " + consulMan.Name + "." : string.Empty)</span></div> }
                </div>
            </div>
        }
    }
</section>

@code {
    private const string WorkDone = "The business of your office is done for this year.";
    private const string WorkNotYet = "You have only just taken the office. Its first business comes at the turn of the year.";
    private const string TrustTip = "What the Reach thinks of its magistrates. Straight dealing mends it slowly; money taken in office breaks it quickly. Below 35 it is one of the things wrong with the Republic.";
    private static string Label(string choice) => choice switch
    {
        LadderSystem.Straight => "Close them as they stand", LadderSystem.Relief => "Find money for the lawless region", LadderSystem.Favour => "Favour your own house",
        LadderSystem.Lanes => "Repair the lanes", LadderSystem.Grain => "Grain for the squares", LadderSystem.Nothing => "Do nothing",
        LadderSystem.Law => "Rule on the law", LadderSystem.Friend => "Rule for a friend", LadderSystem.Gift => "Take the gift",
        LadderSystem.Settle => "Bring them to terms", LadderSystem.Both => "Lanes and grain both", _ => choice
    };
    /// <summary>The glyph of a rung: the accounts, the works, the courts.</summary>
    private static string RungIcon(string rung) => rung switch { "quaestor" => "abacus", "aedile" => "build", "praetor" => "scales", _ => "stairs-goal" };
    private static string FundTip(string size) => "Out of the treasury: " + LadderSystem.CampaignVotes(size) + " votes at the count in all, besides what speaking for them does." + (size == LadderSystem.Lavish ? " It goes on the record as votes bought: any house may charge them with it before a praetor, and one convicted loses the office and may not stand for " + Counted.Years(LadderSystem.BarYears) + "." : "");
    private const string AskDown = "It is their name. The loyal will take it down; the wilful will not, and either will think less of you.";
    private static string You(string s) => s.Replace("they have", "you have").Replace("they must", "you must").Replace("they command", "you command");
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;
}
