@using Praetoria.Core.Systems
@inject GameClient G
@implements IDisposable
@{
    var w = G.World!; var c = G.Content!; var p = w.Protagonist!; var pid = p.Id; var house = w.House(p.HouseId)!; var offices = c.Offices;
    bool active = LadderSystem.Active(w, offices); int next = LadderSystem.CountIn(w, offices);
    var mySeat = LadderSystem.Seat(w, pid); var myStand = w.Candidacies.FirstOrDefault(x => x.CharacterId == pid);
    var consul = ElectionSystem.ConsulOffices(offices).FirstOrDefault();
    var consulMan = consul != null ? OfficeSystem.Candidate(w, consul, house.Id) : null;
    var work = LadderSystem.BusinessOf(w, pid); int trust = LadderSystem.Trust(w); bool hadWork = w.OfficeWork.Any(b => b.HolderId == pid && b.RungId == mySeat?.OfficeId);
    string trustWord = trust < LadderSystem.TrustLow ? "for sale, and everyone knows it" : trust < 50 ? "not much trusted" : trust < 70 ? "trusted, more or less" : "trusted";
    string trustDoes = LadderSystem.TrustSays(w); int taint = LadderSystem.TaintCost(w, house.Id); int scandal = w.Counter(LadderSystem.ScandalKey(house.Id));
    string taintLine = taint == 0 ? "" : "One of your house was removed from office in year " + scandal + ". Until year " + (scandal + LadderSystem.ScandalYears) + " its candidates lose " + taint + " votes at every count, for consul as well.";
    string trustClass = trust < LadderSystem.TrustLow ? "pill bad" : trust < 50 ? "pill warn" : "pill good";
    string workTitle = work == null ? "" : "The business of your office: " + (work.Kind == LadderSystem.Case ? "a case" : work.Kind == LadderSystem.Works ? "the works" : "the accounts");
    string workSays = work == null ? "" : LadderSystem.Says(w, offices, work);
    int latest = w.OfficeWork.Count == 0 ? -1 : w.OfficeWork.Max(b => b.Turn);   // drawn up at the year's turning, so it carries last year's number
    var done = w.OfficeWork.Where(b => b.Turn == latest && b.Choice.Length > 0 && b.Choice != "left").Select(b => (b, who: w.Char(b.HolderId))).Where(x => x.who != null).ToList();
    string Did(OfficeBusiness b) => b.Choice switch
    {
        LadderSystem.Straight => "closed the accounts as they stood",
        LadderSystem.Relief => b.RegionId.Length > 0 ? "found money for " + (w.Galaxy?.Region(b.RegionId)?.Name ?? "a region") : "closed the accounts as they stood",
        LadderSystem.Favour => "closed the accounts, it is said, to their own house's good",
        LadderSystem.Lanes => "repaired the lanes" + (b.RegionId.Length > 0 ? " of " + (w.Galaxy?.Region(b.RegionId)?.Name ?? "") : ""),
        LadderSystem.Grain => "gave grain to the squares",
        LadderSystem.Nothing => "did nothing with the year",
        LadderSystem.Law => b.HouseA.Length == 0 ? "heard no case of weight" : "ruled on the law for " + (w.House(b.RightId)?.Name ?? ""),
        LadderSystem.Friend => "ruled for a friend",
        LadderSystem.Gift => "ruled, it is said, for whoever paid",
        LadderSystem.Settle => "brought two houses to terms",
        LadderSystem.Both => "gave lanes and grain both",
        _ => "sat"
    };
    string Held(Character x) => x.Cursus.Count == 0 ? "nothing yet" : string.Join(", then ", x.Cursus.Select(id => offices.Rung(id)?.Name.ToLowerInvariant() ?? id));
}
<section class="panel cursus">
    <h3><Icon Name="senate" Size="13" /> The ladder of offices <span class="muted">@(active ? $"the next election in {next} year(s)" : "there are no elections under a throne")</span></h3>
    @if (!active) { <div class="muted small">Under the Imperium offices are the throne's to give. The ladder belongs to the Republic.</div> }
    else
    {
        <div class="muted small">Each rung is held by a person, for five years, and filled by election. The houses vote with their weight in the chamber; a candidate's own speaking, standing and record count besides. You have been: <b>@Held(p)</b>.</div>
        <div class="small" data-next-election="@next"><b>The next election is @(next <= 0 ? "at the end of this year" : next == 1 ? "at the end of next year (year " + (w.Turn + 1) + ")" : "in " + next + " years, at the end of year " + (w.Turn + next))</b>: every rung below the consulship is filled then, and names go down before it. @w.Candidacies.Count name(s) are down so far.</div>
        <div class="small">The magistrates of the Reach are <span class="@trustClass" title="@TrustTip">@trustWord (@trust)</span> <span class="muted small">@trustDoes</span></div>
        @if (LadderSystem.TrustApartSays(w) is { Length: > 0 } apart) { <div class="muted small" title="An office's own name is what a scandal costs at the count for that office. A region that does not believe the magistrates holds a little less closely to the Reach each year.">@apart</div> }
        @if (taintLine.Length > 0) { <div class="small bad">@taintLine</div> }
        @if (work != null)
        {
            <div class="rung-row office-work">
                <div><b>@workTitle</b></div>
                <div class="small">@workSays</div>
                @foreach (var choice in LadderSystem.ChoicesFor(work.Kind))
                {
                    string ch = choice; var no = new LadderCommand(pid, LadderCommand.Decide, pid, ch, offices).Refusal(G.Ctx); string tip = LadderSystem.ChoiceSays(w, work, ch);
                    <div class="suit-acts">
                        <button class="opt inline" disabled="@(no != null)" title="@(no ?? tip)" @onclick="() => G.Execute(new LadderCommand(pid, LadderCommand.Decide, pid, ch, offices))">@Label(ch)</button>
                        <span class="muted small">@tip</span>
                    </div>
                }
                <div class="muted small">Left undone, the clerks close it at the year's end, and it is noticed.</div>
            </div>
        }
        else if (mySeat != null) { <div class="muted small">@(hadWork ? WorkDone : WorkNotYet)</div> }
        @if (done.Count > 0)
        {
            <details class="small"><summary>What the magistrates did this year (@done.Count)</summary>
                @foreach (var (b, who) in done)
                {
                    <div class="muted small">@who!.Name@(who.HouseId == house.Id ? " (yours)" : " of " + w.House(who.HouseId)?.Name), @(offices.Rung(b.RungId)?.Name.ToLowerInvariant() ?? "in office"): @Did(b).</div>
                }
            </details>
        }
        @foreach (var rung in offices.Rungs)
        {
            string rid = rung.Id; var holders = LadderSystem.Holders(w, rung.Id); var ours = w.Candidacies.Where(x => x.RungId == rung.Id).ToList();
            var stand = new LadderCommand(pid, LadderCommand.Stand, pid, rid, offices).Refusal(G.Ctx);
            <div class="rung-row">
                <div><b>@rung.Name</b> <span class="muted small">@rung.Seats seat(s) · from @rung.MinAge@(rung.Requires.Length > 0 ? $" · must have been {offices.Rung(rung.Requires)?.Name.ToLowerInvariant()}" : "")@(rung.Stipend > 0 ? $" · pays {rung.Stipend} a year" : "")</span></div>
                <div class="muted small">@rung.Description</div>
                <div class="small">Sitting: @(holders.Count == 0 ? "nobody" : string.Join("; ", holders.Select(h => { var x = w.Char(h.CharacterId); return x == null ? "" : x.HouseId == house.Id ? $"{x.Name} (yours)" : $"{x.Name} of {w.House(x.HouseId)?.Name}"; })))</div>
                @foreach (var cd in ours)
                {
                    var x = w.Char(cd.CharacterId); if (x == null) continue; string xid = x.Id; var back = new LadderCommand(pid, LadderCommand.Back, xid, string.Empty, offices).Refusal(G.Ctx);
                    <div class="suit-acts">
                        <span class="small"><b>@(x.Id == pid ? "You are" : x.Name + " is") standing</b> <span class="muted">(the count is @(next <= 0 ? "at this year's end" : "in " + next + " year(s)") · @w.Candidacies.Count(o => o.RungId == cd.RungId) name(s) down for this rung)</span>@(cd.Backing > 0 ? $", with {cd.Backing} votes of your weight behind {(x.Id == pid ? "you" : "them")}" : "")@(x.Id == pid ? "" : ", of their own accord").</span>
                        <button class="opt inline tiny" disabled="@(back != null)" title="@(back ?? $"{LadderSystem.BackVotes} more votes at the count")" @onclick="() => G.Execute(new LadderCommand(pid, LadderCommand.Back, xid, string.Empty, offices))">@(x.Id == pid ? "Call in what is owed" : "Speak for them") · @LadderSystem.BackInfluence influence</button>
                        @if (x.Id == pid) { <button class="opt inline tiny" @onclick="() => G.Execute(new LadderCommand(pid, LadderCommand.Withdraw, pid, string.Empty, offices))">Withdraw</button> }
                        else
                        {
                            var down = new LadderCommand(pid, LadderCommand.Dissuade, xid, string.Empty, offices).Refusal(G.Ctx);
                            <button class="opt inline tiny" disabled="@(down != null)" title="@(down ?? AskDown)" @onclick="() => G.Execute(new LadderCommand(pid, LadderCommand.Dissuade, xid, string.Empty, offices))">Ask them to stand down</button>
                        }
                    </div>
                }
                @if (myStand == null)
                {
                    <div class="suit-acts">
                        <button class="opt inline tiny" disabled="@(stand != null)" title="@(stand ?? "your name goes down for the next election")" @onclick="() => G.Execute(new LadderCommand(pid, LadderCommand.Stand, pid, rid, offices))">Stand for @rung.Name.ToLowerInvariant() · @LadderSystem.StandInfluence influence</button>
                        @if (stand != null) { <span class="muted small">@Cap(You(stand)).</span> }
                    </div>
                }
                @if (mySeat?.OfficeId == rung.Id && rung.Games > 0)
                {
                    var games = new LadderCommand(pid, LadderCommand.Games, pid, string.Empty, offices).Refusal(G.Ctx);
                    <div class="suit-acts"><button class="opt inline" disabled="@(games != null)" title="@(games ?? "the house gains standing, and it is written into your life")" @onclick="() => G.Execute(new LadderCommand(pid, LadderCommand.Games, pid, string.Empty, offices))">Give games · @rung.Games credits of your own</button></div>
                }
            </div>
        }
        @if (consul != null)
        {
            <div class="rung-row">
                <div><b>Consul</b> <span class="muted small">2 seats · from @consul.MinAge · must have been @(offices.Rung(consul.Requires)?.Name.ToLowerInvariant() ?? "praetor") · elected every tenth year</span></div>
                <div class="small">@(consulMan != null ? $"{(consulMan.Id == pid ? "You are" : consulMan.Name + " is")} of an age and a record to stand for the house." : "Nobody of the house is yet forty and has been praetor. The house cannot stand for consul.")</div>
            </div>
        }
    }
</section>

@code {
    private const string WorkDone = "The business of your office is done for this year.";
    private const string WorkNotYet = "You have only just taken the office. Its first business comes at the turn of the year.";
    private const string TrustTip = "What the Reach thinks of its magistrates. Straight dealing mends it slowly; money taken in office breaks it quickly. Below 35 it is one of the things wrong with the Republic.";
    private static string Label(string choice) => choice switch
    {
        LadderSystem.Straight => "Close them as they stand", LadderSystem.Relief => "Find money for the lawless region", LadderSystem.Favour => "Favour your own house",
        LadderSystem.Lanes => "Repair the lanes", LadderSystem.Grain => "Grain for the squares", LadderSystem.Nothing => "Do nothing",
        LadderSystem.Law => "Rule on the law", LadderSystem.Friend => "Rule for a friend", LadderSystem.Gift => "Take the gift",
        LadderSystem.Settle => "Bring them to terms", LadderSystem.Both => "Lanes and grain both", _ => choice
    };
    private const string AskDown = "It is their name. The loyal will take it down; the wilful will not, and either will think less of you.";
    private static string You(string s) => s.Replace("they have", "you have").Replace("they must", "you must");
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;
}
