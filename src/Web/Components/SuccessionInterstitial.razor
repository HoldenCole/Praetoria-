@inject GameClient G
@* The seat passes (docs/VISUAL_SYSTEM.md 10, "Succession"): the funeral painting full-bleed (a living head who yields, or a sworn house
   taking up the banner, stands in the audience hall instead); "The seat passes" in Cinzel between laurel sprays; the old head at 140px
   (greyscale with the black ribbon when dead), the heir at 220px in the window frame; what passes with the name as an icon row; what
   does not, what the new head can do in a year, who they are, what changes on the screen, a minority, the friends and enemies handed
   down, as rows; what was written of it as a quote; one gold plate. The scripts know it by .overlay, .epilogue.succession, the gold
   .btn.primary and the data-* attributes on its rows. *@
@{
    var w = G.World!; var c = G.Content!; var r = Record; var heir = w.Char(r.HeirId); var old = r.DeceasedId.Length > 0 ? w.Char(r.DeceasedId) : null;
    var house = heir != null ? w.House(heir.HouseId) : null; string accent = house?.AccentColor ?? "#888";
    int worlds = house != null ? w.HoldingsOf(house.Id).Count(h => h.IsPlanet) : 0, hulls = house != null ? w.Fleets.Values.Where(f => f.OwnerId == house.Id).Sum(f => f.Strength) : 0;
    string heirRank = heir != null ? c.Careers.RankName(heir.CareerTrack, heir.CareerRank, G.World!.Era) ?? "" : "";
    string oldRank = old != null ? c.Careers.RankName(old.CareerTrack, old.CareerRank, G.World!.Era) ?? "" : "";
    var lines = w.History.Where(h => h.Turn >= r.Turn - 1 && h.Turn <= r.Turn && (r.DeceasedName.Length > 0 && h.Text.Contains(r.DeceasedName) || h.Text.Contains("regent") || h.Text.Contains("succeeds"))).Select(h => h.Text).Distinct().Take(4).ToList();
    var regent = heir != null && heir.Age < DynastySystem.AgeOfMajority ? w.LivingCharacters().Where(x => x.HouseId == heir.HouseId && x.Id != heir.Id && x.Age >= DynastySystem.AgeOfMajority).OrderByDescending(x => x.Age).FirstOrDefault() : null;
    /* the old head's friends and enemies, as they came down to the heir (docs/LIFE.md, "Friends and enemies handed down") */
    var ties = heir != null ? w.InheritedTies.Where(t => t.HeirId == heir.Id && t.ToId == heir.Id && t.Turn == r.Turn).ToList() : new List<InheritedTie>();
    var handed = heir != null && old != null && ties.Count > 0 ? InheritedRegard.Summary(w, old, heir, ties) : (FriendsTitle: string.Empty, Friends: string.Empty, EnemiesTitle: string.Empty, Enemies: string.Empty);
    int friendsN = ties.Count(t => t.Kind is InheritedRegard.Friend or InheritedRegard.Unseen), enemiesN = ties.Count(t => t.Kind is InheritedRegard.Enemy or InheritedRegard.Vengeful or InheritedRegard.LetGo);
    string title = r.Cause == "abdication" ? "The seat yields" : r.Cause == "adoption" ? "A sworn house takes up the banner" : "The seat passes";
    string scene = r.Cause == "death" ? "funeral" : "audience";
    string rank = house != null ? c.Titles.NameOf(house.Title, G.World!.Era) : "";
    string credits = house != null ? Money.Held(house.Treasury) : Money.Show(0);
}
<div class="overlay succ-veil" data-succession="@r.Generation">
    <div class="succ-art" style="background-image:url('img/scenes/@(scene).webp')" aria-hidden="true"></div>
    <div class="epilogue succession wide succ-stage" style="--accent:@accent" role="dialog" aria-modal="true" aria-label="@title">
        <div class="succ-kick"><i class="ln"></i>@Laurel(false)<span>Generation @r.Generation@(house != null ? " · " + house.Name : "")</span>@Laurel(true)<i class="ln r"></i></div>
        <h2 class="succ-title @(title.Length > 18 ? "long" : "")">@title</h2>
        <div class="succ-rule"></div>
        <div class="succ-main">
            <div class="succ-left">
            <div class="succ-cast">
                @if (old != null)
                {
                    <div class="succ-who old">
                        <Portrait Id="@old.Id" Name="@old.Name" Sex="@old.Sex" Age="@old.Age" Alive="@old.Alive" Accent="@accent" Size="140" Height="174" />
                        <b>@old.Name</b><span>@(r.Cause == "abdication" ? "yields at" : "dies at") @r.DeceasedAge@(oldRank.Length > 0 ? $" · {oldRank}" : "")</span>
                    </div>
                    <div class="succ-arrow" aria-hidden="true"><Icon Name="chev" Tone="brass" Size="22" /><Icon Name="chev" Tone="brass" Size="22" /></div>
                }
                @if (heir != null)
                {
                    <div class="succ-who heir">
                        <Portrait Id="@heir.Id" Name="@heir.Name" Sex="@heir.Sex" Age="@heir.Age" Accent="@accent" Size="220" Height="274" />
                        <b>@heir.Name</b><span>takes the seat at @heir.Age@(heirRank.Length > 0 ? $" · {heirRank}" : "")</span>
                    </div>
                }
            </div>
            <div class="succ-pass" title="What passes with the name: @rank · @Counted.Worlds(worlds) · @Counted.Hulls(hulls) · @(house != null ? Money.Held(house.Treasury) : Money.Show(0)) credits · legitimacy @(house?.Legitimacy ?? 0)">
                <div class="succ-sub">What passes with the name</div>
                <div class="succ-plinth">
                    <div class="succ-fig"><Icon Name="crown" Tone="brass" Size="24" /><span><b class="txt">@rank</b><small>Rank</small></span></div>
                    <div class="succ-fig"><Icon Name="ringed-planet" Tone="ivory" Size="24" /><span><b>@worlds</b><small>@(worlds == 1 ? "World" : "Worlds")</small></span></div>
                    <div class="succ-fig"><Icon Name="fleet" Tone="steel" Size="24" /><span><b>@hulls</b><small>@(hulls == 1 ? "Hull" : "Hulls")</small></span></div>
                    <div class="succ-fig"><Icon Name="credits" Tone="brass" Size="24" /><span><b>@credits</b><small>Credits</small></span></div>
                    <div class="succ-fig"><Icon Name="legitimacy" Tone="ivory" Size="24" /><span><b>@(house?.Legitimacy ?? 0)</b><small>Legitimacy</small></span></div>
                </div>
            </div>
            </div>
            <div class="succ-side">
                <div class="succ-grid">
                    <div class="succ-row"><span class="pic"><Icon Name="scroll-unfurled" Tone="ivory" Size="20" /></span><span class="tx"><span class="k">Lost</span><span class="v">@(oldRank.Length > 0 ? $"The {oldRank}'s career. " : "")The heir begins again@(heirRank.Length > 0 ? $" as {heirRank}" : "")@(heir?.CareerTrack is { Length: > 0 } t ? $" on the {t} track" : "").</span></span></div>
                    @if (heir != null && G.World!.Pools.TryGetValue(heir.Id, out var hp))
                    {
                        <div class="succ-row" data-pools-after="1" title="The last head's reach was their own, and does not pass with the name."><span class="pic"><Icon Name="hourglass" Tone="brass" Size="20" /></span><span class="tx"><span class="k">Each year</span><span class="v">@hp.InfluenceRegen influence, @Counted.TreasuryActions(hp.TreasuryRegen) and @Counted.Agents(hp.AgentsRegen) @Counted.Come(hp.AgentsRegen) back each year, as for every new head.</span></span></div>
                    }
                    @if (heir != null && (heir.NatureTraits.Count > 0 || heir.Ambition.Length > 0)) { <div class="succ-row"><span class="pic face"><Portrait Id="@heir.Id" Name="@heir.Name" Sex="@heir.Sex" Age="@heir.Age" Accent="@accent" Size="30" Height="36" Opens="false" /></span><span class="tx"><span class="k">The heir</span><span class="v">@string.Join(" · ", heir.NatureTraits.Concat(heir.AptitudeTraits))@(heir.Ambition.Length > 0 ? $" · wants to {heir.Ambition.Replace('_', ' ')}" : "")</span></span></div> }
                    <div class="succ-row"><span class="pic"><Icon Name="spyglass" Tone="ivory" Size="20" /></span><span class="tx"><span class="k">Your screen</span><span class="v">@RoleTheme.Describe(heir?.CareerTrack ?? "")</span></span></div>
                    @if (regent != null) { <div class="succ-row warn"><span class="pic face"><Portrait Id="@regent.Id" Name="@regent.Name" Sex="@regent.Sex" Age="@regent.Age" Accent="@accent" Size="30" Height="36" Opens="false" /></span><span class="tx"><span class="k">A regent</span><span class="v">@regent.Name rules as regent until @heir!.Name comes of age at @DynastySystem.AgeOfMajority.</span></span></div> }
                    @if (handed.Friends.Length > 0) { <div class="succ-row good" data-inherited-friends="@friendsN" title="@handed.FriendsTitle"><span class="pic faces">@Faces(ties.Where(t => t.Kind is InheritedRegard.Friend or InheritedRegard.Unseen))</span><span class="tx"><span class="k">Friends</span><span class="v">@handed.Friends</span></span></div> }
                    @if (handed.Enemies.Length > 0) { <div class="succ-row warn" data-inherited-enemies="@enemiesN" title="@handed.EnemiesTitle"><span class="pic faces">@Faces(ties.Where(t => t.Kind is InheritedRegard.Enemy or InheritedRegard.Vengeful or InheritedRegard.LetGo))</span><span class="tx"><span class="k">Enemies</span><span class="v">@handed.Enemies</span></span></div> }
                </div>
                @if (lines.Count > 0)
                {
                    <div class="succ-lines"><div class="qh">What was written</div>@foreach (var l in lines) { <div class="ln">@l</div> }</div>
                }
            </div>
        </div>
        <div class="row succ-foot"><button class="btn primary ui-btn succ-go" title="The year goes on under the new head" @onclick="OnClose"><Icon Name="laurels" Tone="dark" Size="16" />Take up the name</button></div>
    </div>
</div>
@code {
    [Parameter, EditorRequired] public SuccessionRecord Record { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Up to three faces of those a tie came down from, overlapped as one picture.</summary>
    private RenderFragment Faces(IEnumerable<InheritedTie> ts) => __builder =>
    {
        foreach (var p in ts.Select(t => G.World!.Char(t.FromId)).Where(p => p != null).DistinctBy(p => p!.Id).Take(3))
        {
            <Portrait Id="@p!.Id" Name="@p.Name" Sex="@p.Sex" Age="@p.Age" Alive="@p.Alive" Accent="@(G.World!.House(p.HouseId)?.AccentColor ?? "#888")" Size="30" Height="36" Opens="false" />
        }
    };
    /// <summary>Half of Lorc's laurels, the spray each side of the kicker.</summary>
    private static RenderFragment Laurel(bool flip) => __builder =>
    {
        <svg class="icon ico brass succ-ls @(flip ? "flip" : "")" viewBox="0 0 230 512" aria-hidden="true"><use href="#i-@Icons.Key("laurels")" /></svg>
    };
}
