@inject GameClient G
@* The year in brief (docs/PLAYTHROUGH.md, Medium): what the year before did to your house, in one place, each line opening where it
   can be seen. A box in the window frame (docs/VISUAL_SYSTEM.md 4.1): a section band for each kind of thing, a row for each line
   with a mark by how it reads (a gain, a loss, news), and the way on in the foot. *@
@{
    var w = G.World!; var lines = YearInBrief.For(w, G.Content!);
    var groups = YearInBrief.Order.Select(k => (k, list: lines.Where(l => l.Kind == k).ToList())).Where(g => g.list.Count > 0).ToList();
}
<Box data-year-brief="1" BoxClass="brief" Glyph="sundial" Kicker="@($"Year {w.Turn - 1} in brief")" Title="@($"What the year did to {w.House(w.Protagonist!.HouseId)?.Name}")" Width="min(46rem, calc(100vw - 2rem))">
    <ChildContent>
        @if (groups.Count == 0) { <p class="box-empty">A quiet year. Nothing happened to the house that needs telling.</p> }
        @foreach (var g in groups)
        {
            <div class="brief-group">
                <h4 class="box-sec">@g.k</h4>
                @if (g.k == YearInBrief.Money && YearInBrief.Moves(w) is { Count: > 0 } moves)
                {
                    @* the treasury as the top bar shows it: a stock chip for each that moved, its glyph, where it stands and the year's change *@
                    <button class="brief-stocks" title="@string.Join("\n", moves.Select(m => $"{Cap(m.Label)}: {m.Before} when the year opened, {m.After} now ({m.Change})"))" @onclick='() => OnGo.InvokeAsync("house:ledger")'>
                        @foreach (var m in moves)
                        {
                            <span class="bs-chip"><Icon Name="@m.Resource" Tone="@(m.Resource == "credits" ? "brass" : m.Resource == "manpower" ? "ivory" : "steel")" Size="20" /><b>@m.After</b><small class="@(m.Up ? "up" : "down")">@m.Change</small></span>
                        }
                        <Icon Name="chev" Tone="brass" Size="10" Class="bl-go" />
                    </button>
                }
                @foreach (var l in g.list)
                {
                    if (g.k == YearInBrief.Money && l.Target == "house:ledger" && l.Text.StartsWith("Over the year")) continue;
                    string go = l.Target;
                    <button class="brief-line @l.Tone" title="Open the place this can be seen" @onclick="() => OnGo.InvokeAsync(go)">
                        @if (l.Tone is "good" or "warn") { <Icon Name="@(l.Tone == "good" ? "plus" : "minus")" Tone="@(l.Tone == "good" ? "good" : "ember")" Size="12" Class="bl-mark" /> } else { <i class="bl-mark bl-dot" aria-hidden="true"></i> }
                        <span class="bl-t">@l.Text</span><Icon Name="chev" Tone="brass" Size="10" Class="bl-go" />
                    </button>
                }
            </div>
        }
    </ChildContent>
    <Foot>
        <label class="brief-opt ui-check"><input type="checkbox" checked="@Every" @onchange="e => OnEvery.InvokeAsync(e.Value is true)" /><span class="ui-check-box">@if (Every) { <Icon Name="check" Size="13" Class="flat" /> }</span><span>Show this at the start of every year</span></label>
        <span class="box-note">It can be opened again from the year in the top bar.</span>
        <button class="btn primary ui-btn" data-brief-close @onclick="() => OnClose.InvokeAsync()">To year @w.Turn <Icon Name="chev" Tone="dark" Size="11" /></button>
    </Foot>
</Box>
@code {
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnGo { get; set; }
    [Parameter] public bool Every { get; set; } = true;
    [Parameter] public EventCallback<bool> OnEvery { get; set; }
}
