@using Praetoria.Core.Systems
@inject GameClient G
@implements IDisposable
@{
    var w = G.World!; var p = w.Protagonist!; var pid = p.Id; var house = w.House(p.HouseId)!; var cz = G.Turn!.Caesar;
    var general = CaesarSystem.GeneralOf(w, house); bool mineIsMe = general?.Id == pid;
    int sway = general != null ? CaesarSystem.Sway(w, general) : 0; int laurels = general != null ? CaesarSystem.Laurels(w, general) : 0;
    int hulls = general != null ? CaesarSystem.DevotedHulls(w, general) : 0; int triumphs = general != null ? CaesarSystem.Triumphs(w, general) : 0;
    var recall = w.Recalls.FirstOrDefault(r => r.HouseId == house.Id); var cw = w.CivilWar;
    bool atTheGate = TriumphSystem.HomeFor(w, house.Id).Count > 0;   /* one of the house is home for a triumph (docs/CAESAR.md) */
    var fleets = w.Fleets.Values.Where(f => (f.OwnerId == house.Id && !f.Office || ServiceSystem.CommandedBy(w, f, house.Id)) && f.AdmiralId.Length > 0).OrderByDescending(f => f.Devotion).ThenBy(f => f.Id, StringComparer.Ordinal).ToList();   /* and those one of the house commands by service (docs/MILITARY.md) */
    var watched = w.Houses.Values.Where(h => h.Id != house.Id && h.Id != PirateSystem.HouseId).Select(h => (h, g: CaesarSystem.GeneralOf(w, h))).Where(x => x.g != null && CaesarSystem.Sway(w, x.g) >= 30)
        .OrderByDescending(x => CaesarSystem.Sway(w, x.g!)).ThenBy(x => x.h.Id, StringComparer.Ordinal).Take(3).ToList();
    string? noTriumph = w.IsImperium ? null : new ProposeMotionCommand(pid, "triumph", house.Id, G.Turn.Senate).Refusal(G.Ctx);
    string? noCross = new CaesarCommand(pid, CaesarCommand.Cross, "", cz).Refusal(G.Ctx);
    string Mine(string? t) => t == null || general == null || !mineIsMe ? t ?? "" : t.Replace(general.Name + " has not", "you have not").Replace(general.Name + " has", "you have").Replace(general.Name + " is", "you are").Replace("follow " + general.Name, "follow you");
    string who = general == null ? "" : mineIsMe ? "you" : general.Name; string whose = general == null ? "" : mineIsMe ? "your" : general.Name + "'s";
    string swayWhy = general == null ? "" : string.Join(" · ", CaesarSystem.SwayParts(w, general).Select(x => $"{x.what} {x.points}"));
    string generalLine = general == null ? "" : (mineIsMe ? "You are the house's general. " : general.Name + " is the house's general. It is " + general.Name + "'s name the crews know. ")
        + (swayWhy.Length > 0 ? Cap(swayWhy) + ". " : "No victories yet. ") + "At " + CaesarSystem.RecallSway + " the Senate may order " + (mineIsMe ? "you" : "them") + " home.";
    string crewsLine = Counted.Hulls(hulls) + " would follow " + who + " before the house" + (triumphs > 0 ? " · " + Counted.Triumphs(triumphs) + "" : "") + ". A triumph asks " + CaesarSystem.TriumphLaurels + " victories since the last: " + whose + " count is";
    string watchedLine = string.Join("; ", watched.Select(x => x.g!.Name + " of " + x.h.Name + " (sway " + CaesarSystem.Sway(w, x.g) + (CaesarSystem.Triumphs(w, x.g) > 0 ? ", a triumph" : "") + (w.Recalls.Any(r => r.HouseId == x.h.Id) ? ", under recall" : "") + ")"));
    var troubles = CaesarSystem.Troubles(w); var gates = CaesarSystem.Gates(w, house); var forecast = cz.Forecast(w, house);
    string republic = troubles.Count == 0 ? "sound" : troubles.Count < CaesarSystem.TroubledAt ? "uneasy" : "troubled";
    string republicLine = troubles.Count == 0 ? "Nothing is wrong that the Senate cannot manage. A general who marched now would be marching on a Republic its houses will defend."
        : Cap(string.Join("; ", troubles)) + (troubles.Count < CaesarSystem.TroubledAt ? ". One thing wrong is not enough to make the houses look for a strong hand." : ". These are the times a general waits for.");
    string forecastLine = general == null ? "" : "If the house crossed the line today, " + Counted.Houses(forecast.forGeneral.Count) + " would declare for " + who + " and " + forecast.forSenate.Count + " for the Senate"
        + (forecast.forGeneral.Count > 0 ? " (for: " + string.Join(", ", forecast.forGeneral.Take(4).Select(h => h.Name)) + (forecast.forGeneral.Count > 4 ? ", and others" : "") + ")" : "") + ". The rest would stand aside.";
    string greatNames = string.Join("; ", w.Houses.Values.Where(h => h.Id != house.Id && h.Id != PirateSystem.HouseId).Select(h => (h, g: CaesarSystem.GeneralOf(w, h))).Where(x => x.g != null && x.g.Flags.Contains(CaesarSystem.GreatNameChar)).Select(x => x.g!.Name + " of " + x.h.Name));
    string Names(IEnumerable<string> ids) => string.Join(", ", ids.Select(id => id == house.Id ? "your house" : w.House(id)?.Name ?? id).DefaultIfEmpty("nobody"));
}
@* The general and the Senate (docs/CAESAR.md), the General tab of the Military window: the general as a row with their face, their sway
   as a meter with the recall line ticked, the triumph as a plate; a recall or a civil war as a strip; what a Caesar is made of as three
   rows met or not; the Republic's state; whose the crews are, a fleet to a row with its token, a meter and the donative. *@
<div class="panel caesar mil-caesar">
    @if (w.IsImperium)
    {
        <p class="ui-lede mil-lede">@(w.HasFlag(CaesarSystem.RepublicFallenFlag) ? "The Republic ended when a general marched on the capital and was not stopped. " : "")There is a throne now. Commands are the throne's to give and to take away, and nobody is voted a triumph.</p>
    }
    else
    {
        <p class="ui-lede mil-lede @(cw != null || recall != null ? "bad" : "")">@MilitaryScreen.Bold(cw != null ? (cw.HouseId == house.Id && w.Char(cw.GeneralId)?.Id == pid ? "You have crossed the line." : (w.Char(cw.GeneralId)?.Name ?? "A general") + " has crossed the line, and the Reach is at war with itself.")
            : general == null ? "Nobody of the house commands a fleet, so the house has no general. A name is made in command."
            : $"{(mineIsMe ? "You are" : general.Name + " is")} the house's general, with a sway of {sway}; at {CaesarSystem.RecallSway} the Senate may order {(mineIsMe ? "you" : "them")} home. The Republic is {republic}.")</p>
        @if (cw != null)
        {
            var g = w.Char(cw.GeneralId); bool mineWar = cw.HouseId == house.Id; string? declared = cw.Declared.GetValueOrDefault(house.Id);
            int standing = CaesarSystem.Standing(w, cw); int hg = CaesarSystem.Hulls(w, cw.With.Prepend(cw.HouseId)), hs = CaesarSystem.Hulls(w, cw.Against);
            string gName = g?.Name ?? "A general"; string gHouse = mineWar ? "your house" : w.House(cw.HouseId)?.Name ?? "";
            string headline = mineWar && g?.Id == pid ? "You have crossed the line." : gName + " of " + gHouse + " has crossed the line.";
            string swordName = cw.SwordHouseId == house.Id ? "yours" : (w.House(cw.SwordHouseId)?.Name ?? "nobody") + "'s";
            string swordLine = cw.SwordHouseId.Length > 0 ? " · the war is " + swordName + " to carry" : "";
            bool good = mineWar || declared == CaesarSystem.General ? standing > 0 : standing < 0;
            string standTip = "The lead in the battles fought, and each year nobody met counted to the stronger side. At +" + CaesarSystem.DecisiveLead + " the Senate's fleets are broken; at -" + CaesarSystem.DecisiveLead + " the general is.";
            string declaredFor = declared == CaesarSystem.General ? gName : "the Senate";
            <Section Title="The civil war" Info="@($"The general wins by holding the capital's orbit for {CaesarSystem.HoldYears} years running or by breaking the Senate's fleets. The general loses if the fleet is broken, the field is lost, or the war drags past {CaesarSystem.WarYears} years; then the general dies and the house pays.")">
                <Right><span>year <b>@(w.Turn - cw.Since)</b> of at most @CaesarSystem.WarYears</span></Right>
                <ChildContent>
                <div class="caesar-war mc-war">
                    <div class="mc-head"><Icon Name="crossed-sabres" Tone="ember" Size="20" /><b>@headline</b><span class="ui-dim">since year @cw.Since</span></div>
                    <div class="mc-sides">
                        <span class="k">With the general</span><span><b>@Names(cw.Declared.Where(kv => kv.Value == CaesarSystem.General).Select(kv => kv.Key))</b> · @hg hulls in the field</span>
                        <span class="k">For the Senate</span><span><b>@Names(cw.Declared.Where(kv => kv.Value == CaesarSystem.Senate).Select(kv => kv.Key))</b> · @hs hulls in the field@(swordLine)</span>
                        <span class="k">Held</span><span>the capital's orbit, @cw.Held of @CaesarSystem.HoldYears years running</span>
                    </div>
                    <Meter Kind="diverging" Label="How it stands" Value="@standing" Max="@CaesarSystem.DecisiveLead" Text="@((standing > 0 ? Plus : string.Empty) + standing)" Color="@(good ? "#8cc47e" : "#c4472f")" Tip="@standTip" />
                    @if (!mineWar)
                    {
                        @if (declared != null) { <div class="mc-note">Your house has declared for <b>@declaredFor</b>.</div> }
                        else
                        {
                            <div class="suit-acts mc-acts">
                                <Plate Label="Declare for the Senate" Small="true" Icon="greek-temple" Tip="@("[greek-temple] Declare for the Senate\n" + JoinSenateTip)" OnClick="() => G.Execute(new CaesarCommand(pid, CaesarCommand.Join, CaesarSystem.Senate, cz))" />
                                <Plate Label="@("Declare for " + gName)" Small="true" Icon="eagle-emblem" Tip="@("[eagle-emblem] Declare for the general\n" + JoinGeneralTip)" OnClick="() => G.Execute(new CaesarCommand(pid, CaesarCommand.Join, CaesarSystem.General, cz))" />
                                <span class="ui-dim">Or say nothing, and stand aside.</span>
                            </div>
                        }
                    }
                </div>
                </ChildContent>
            </Section>
        }
        <TriumphGate />
        @if (general == null) { if (!atTheGate) { <EmptyState Icon="laurels" Text="Nobody of the house commands a fleet. A name is made in command: appoint someone, or take a fleet yourself." /> } }   @* home for a triumph, the gate above says who and why *@
        else
        {
            <Section Title="The general" Info="@($"The general is the one of the house the crews know. Sway comes of victories in command, rank in the service, triumphs and renown: {(swayWhy.Length > 0 ? swayWhy : "no victories yet")}. At {CaesarSystem.RecallSway} the Senate may order the general home; at {CaesarSystem.FearedSway} the general is feared. A triumph asks {CaesarSystem.TriumphLaurels} victories since the last.")">
                <div class="mc-general">
                    <Portrait Id="@general.Id" Name="@general.Name" Sex="@general.Sex" Age="@general.Age" Alive="@general.Alive" Accent="@house.AccentColor" Size="46" Height="56" />
                    <div class="mc-gt">
                        <b>@(mineIsMe ? "You, " + general.Name : general.Name)</b>
                        <span class="mc-sub">@generalLine</span>
                    </div>
                    <span class="mc-fig" title="@($"[laurels] Victories toward a triumph\nA triumph asks {CaesarSystem.TriumphLaurels} victories since the last.")"><b>@laurels</b><small>of @CaesarSystem.TriumphLaurels victories</small></span>
                </div>
                <div class="mc-meters">
                    <Meter Label="Sway" Value="@sway" Target="@CaesarSystem.RecallSway" Text="@sway.ToString()" Color="@(sway >= CaesarSystem.FearedSway ? "#8cc47e" : "#c9a24a")" Tip="@($"[eagle-emblem] Sway\n{(swayWhy.Length > 0 ? swayWhy : "No victories yet")}. The tick is {CaesarSystem.RecallSway}, where the Senate may order the general home.")" />
                </div>
                @{ int ofFleet = fleets.Sum(f => f.Strength); }
                <div class="mc-crews-fig" title="@($"{crewsLine} {laurels}.")"><Icon Name="fleet" Tone="steel" Size="18" /><b>@hulls</b><span>of @ofFleet hulls follow @(mineIsMe ? "you" : general?.Name ?? "the general") before the house</span></div>
                <div class="suit-acts mc-acts">
                    <Plate Label="Ask the Senate for a triumph" Small="true" Icon="laurels" Locked="@(noTriumph != null)" Disabled="@(noTriumph != null)" ShowNeed="false" Need="@Cap(Mine(noTriumph))" Tip="@("[laurels] Ask the Senate for a triumph\n" + TriumphTip)" OnClick="() => G.Execute(new ProposeMotionCommand(pid, MotionTriumph, house.Id, G.Turn!.Senate))" />
                    @if (noTriumph != null) { <span class="ui-need">@Cap(Mine(noTriumph)).</span> }
                </div>
            </Section>
            @if (recall != null)
            {
                var rg = w.Char(recall.CharacterId); bool meRecalled = rg?.Id == pid; string rName = rg?.Name ?? "the general";
                string recallHead = "The Senate has ordered " + (meRecalled ? "you" : rName) + " to lay down the command and come home, by year " + recall.Deadline + ".";
                string recallWhat = meRecalled ? "Come home and you may not hold a command for " + CaesarSystem.BarredYears + " years, but the house is seen to keep the law."
                    : rg != null && CourtshipSystem.Wilful(rg) ? rName + " has not come home, and is waiting to hear what you will do."
                    : rName + " keeps the law, and will come home next year unless the house crosses the line first.";
                <div class="caesar-recall mc-recall">
                    <WarnStrip Icon="greek-temple" Bad="true" Lead="@recallHead">
                        <ChildContent>@recallWhat If it is left unanswered the Senate's officers take the command, and the house is thought less of.</ChildContent>
                        <Action><Plate Label="@(meRecalled ? ComeHome : OrderHome)" Small="true" Tip="@("[anticlockwise-rotation] " + (meRecalled ? ComeHome : OrderHome) + "\nThe command is laid down and the general comes home.")" OnClick="() => G.Execute(new CaesarCommand(pid, CaesarCommand.Obey, string.Empty, cz))" /></Action>
                    </WarnStrip>
                </div>
            }
            @if (cw == null)
            {
                <Section Title="What a Caesar is made of" Count="@($"{gates.Count(x => x.met)} of {gates.Count}")" Info="There was one, and for a reason. You may march without all three: the houses weigh them when they choose a side.">
                    @foreach (var gate in gates)
                    {
                        <div class="gate-row mc-gate @(gate.met ? "met" : "")">
                            <span class="mc-mark" title="@(gate.met ? "Met" : "Not yet")"><Icon Name="@(gate.met ? "check" : "hourglass")" Tone="@(gate.met ? "good" : "ivory")" Size="16" /></span>
                            <div class="mc-gt"><b>@gate.name</b><span class="mc-sub">@gate.says</span></div>
                            <span class="mil-st @(gate.met ? "good" : "")">@(gate.met ? Met : NotMet)</span>
                        </div>
                    }
                    <p class="mc-note">@forecastLine</p>
                    <div class="suit-acts mc-acts">
                        @if (_confirm)
                        {
                            <Plate Label="Yes: march on the capital" Small="true" Icon="eagle-emblem" Class="veto" Tip="@("[eagle-emblem] March on the capital\n" + CrossTip)" OnClick="() => { _confirm = false; G.Execute(new CaesarCommand(pid, CaesarCommand.Cross, string.Empty, cz)); }" />
                            <Plate Label="No" Small="true" Tip="[close] Do not march" OnClick="() => _confirm = false" />
                        }
                        else { <Plate Label="Cross the line" Small="true" Icon="eagle-emblem" Locked="@(noCross != null)" Disabled="@(noCross != null)" ShowNeed="false" Need="@Cap(Mine(noCross))" Tip="@("[eagle-emblem] Cross the line\n" + CrossTip)" OnClick="() => _confirm = true" /> }
                        @if (noCross != null) { <span class="ui-need">@Cap(Mine(noCross)).</span> }
                    </div>
                </Section>
            }
        }
        <Section Title="The Republic" Info="@(troubles.Count == 0 ? "Nothing is wrong that the Senate cannot manage." : $"{CaesarSystem.TroubledAt} troubles at once are what make the houses look for a strong hand.")">
            <Right><span class="@(troubles.Count == 0 ? "ui-up" : troubles.Count < CaesarSystem.TroubledAt ? "ui-warn-t" : "ui-down")">@Cap(republic)</span></Right>
            <ChildContent>
            <div class="ac-fact mc-fact"><Icon Name="greek-temple" Tone="@(troubles.Count == 0 ? "ivory" : "ember")" Size="20" /><span class="k">The Republic is @republic</span><p>@republicLine</p></div>
            @if (greatNames.Length > 0) { <div class="caesar-recall mc-fact great"><Icon Name="laurels" Tone="brass" Size="20" /><b>A name on every lip: @greatNames.</b><p>A commander of the first rank, and loved. If the times turn, this is who the Reach would look to. A recall, moved on the Senate screen, is the Senate's answer; so is being the house that stands in the way.</p></div> }
            @if (watched.Count > 0) { <div class="ac-fact mc-fact"><Icon Name="spyglass" Tone="ivory" Size="20" /><span class="k">Names the Senate watches</span><p>@watchedLine. A recall is moved on the Senate screen.</p></div> }
            </ChildContent>
        </Section>
        @if (fleets.Count > 0)
        {
            <Section Title="Whose crews" Count="@fleets.Count.ToString()" Info="@($"At {CaesarSystem.DevotedAt} (the tick) a fleet's crews follow the commander before the house. A donative of {CaesarSystem.DonativePerHull} a hull raises their regard for the commander by {CaesarSystem.DonativeDevotion}, and a little for the house.")">
                @foreach (var f in fleets.Take(5))
                {
                    string fid = f.Id; var adm = w.Char(f.AdmiralId); var no = new CaesarCommand(pid, CaesarCommand.Donative, fid, cz).Refusal(G.Ctx);
                    string admName = adm?.Id == pid ? "you" : adm?.Name ?? ""; string giftTip = no ?? "+" + CaesarSystem.DonativeDevotion + " to their regard for " + admName + ", and a little to the house";
                    <div class="crew-row mc-crew">
                        <span class="mil-tok" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 20 L12 3 L21 20 L12 15 Z" fill="@house.AccentColor" stroke="#000" stroke-width="1.4" stroke-linejoin="round" /><path d="M12 3 L12 15 L3 20 Z" fill="#fff" opacity=".22" /></svg></span>
                        <span class="mc-gt"><b>@f.Name</b><span class="mc-sub">@f.Strength hulls · @admName</span></span>
                        <Meter Value="@f.Devotion" Target="@CaesarSystem.DevotedAt" Text="@f.Devotion.ToString()" Color="@(f.Devotion >= CaesarSystem.DevotedAt ? "#8cc47e" : "#c9a24a")" Tip="@($"[shaking-hands] Devotion to the commander\nAt {CaesarSystem.DevotedAt} (the tick) they follow the commander before the house.")" />
                        <Plate Label="Donative" Small="true" Icon="coins-pile" CostIcon="credits" CostText="@Money.Show(CaesarSystem.DonativeCost(f))" Locked="@(no != null)" Disabled="@(no != null)" ShowNeed="false" Need="@Cap(no ?? "")" Tip="@("[coins-pile] A donative of " + Money.Show(CaesarSystem.DonativeCost(f)) + " credits\n" + Cap(giftTip))" OnClick="() => G.Execute(new CaesarCommand(pid, CaesarCommand.Donative, fid, cz))" />
                    </div>
                }
            </Section>
        }
    }
</div>

@code {
    private bool _confirm;
    private const string GoodPill = "good", Met = "met", NotMet = "not yet";
    private const string MotionTriumph = "triumph", GoodClass = "high", Plus = "+", ComeHome = "Come home", OrderHome = "Order them home";
    private const string TriumphTip = "The Senate votes next session. If it carries, the general must come home and lay the command down for a year to have it (legitimacy, the crews' regard, and the general's name), or may decline it and keep the fleet. If it is refused, that is a cause.";
    private const string JoinSenateTip = "Your fleets go to war with the general's house. It is remembered when it ends.";
    private const string JoinGeneralTip = "Your fleets go to war with the house that carries the Senate's war. If the general falls, so does your standing.";
    private const string CrossTip = "A civil war. The houses declare for you, for the Senate, or stand aside. Hold the capital's orbit for two years or break the Senate's fleets and the Republic ends with your house on the throne. Lose, and the general dies and the house is ruined for a generation.";
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;
}
