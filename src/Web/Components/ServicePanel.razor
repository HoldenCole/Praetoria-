@using Praetoria.Core.Systems
@inject GameClient G
@implements IDisposable
@* A command by service (docs/MILITARY.md, "A command by service"): the commands the house's people hold of fleets their house does not own,
   the player's own fleets under another's commander, what is asked of the head, and offers to seek a command or borrow an officer. *@
@{
    var w = G.World!; var c = G.Content!; var p = w.Protagonist!; var pid = p.Id; var house = w.House(p.HouseId)!;
    var held = ServiceSystem.OfHouse(w, house.Id);
    var underOthers = w.Service.Where(s => s.CommanderHouseId != house.Id && (s.OwnerId == house.Id || s.NamedById == pid)).OrderBy(s => s.FleetId, StringComparer.Ordinal).ToList();
    var asks = w.ServiceAsks.Where(a => a.Turn >= w.Turn - 1).OrderBy(a => a.Id, StringComparer.Ordinal).ToList();
    var seekers = ServiceSystem.Seekers(w, p); var seeker = seekers.FirstOrDefault(x => x.Id == _seeker) ?? seekers.FirstOrDefault();
    var takers = seeker == null ? new List<string>() : ServiceSystem.TakersFor(w, c.Offices, seeker);
    var enemy = ServiceSystem.EnemyOf(w, house.Id);
    var borrowFleets = enemy == null ? new List<Fleet>() : ServiceSystem.HouseFleets(w, house.Id).OrderByDescending(f => f.Strength).ThenBy(f => f.Id, StringComparer.Ordinal).ToList();
    var borrowFleet = borrowFleets.FirstOrDefault(f => f.Id == _borrowFleet) ?? borrowFleets.FirstOrDefault();
    var past = w.PastService.Where(s => s.CommanderHouseId == house.Id || s.OwnerId == house.Id).Reverse().Take(6).ToList();
}
<div class="panel mil-service" data-service>
    <p class="ui-lede mil-lede">@MilitaryScreen.Bold(held.Count + underOthers.Count == 0 ? (asks.Count > 0 ? $"Nobody of your house serves under another's colours, and {Counted.Of(asks.Count, "request")} for a command waits on you." : "Nobody of your house commands a fleet it does not own, and none of your fleets is under another's commander.")
        : $"{Counted.Of(held.Count, "command")} held by your people for others, and {Counted.Fleets(underOthers.Count)} of yours under another's commander.")</p>
    @if (held.Count == 0) { <div data-service-none="held"><EmptyState Icon="rally-the-troops" Text="Nobody of your house commands a fleet by service." /></div> }
    <Section Title="Held by your people" Count="@held.Count.ToString()" Info="@ServiceRules" IsEmpty="@(held.Count == 0)">
        @foreach (var s in held)
        {
            var resign = new ResignServiceCommand(pid, s.CommanderId); string? resignNo = resign.Refusal(G.Ctx); string who = s.CommanderId; var k = w.Char(who);
            <div class="sv-row" data-service-held="@s.FleetId">
                @Face(k, house.AccentColor)
                <span class="sv-t">@ServiceSystem.Says(w, s)</span>
                <Plate Label="@(who == pid ? "Resign it" : "Call them home")" Small="true" Locked="@(resignNo != null)" Disabled="@(resignNo != null)" ShowNeed="false" Need="@Cap(resignNo ?? "")" data-resign="@who" Tip="@("[anticlockwise-rotation] " + (who == pid ? "Resign it" : "Call them home") + "\n" + (resignNo != null ? Cap(resignNo) : ResignHelp(who)))" OnClick="() => G.Execute(new ResignServiceCommand(pid, who))" />
            </div>
        }
    </Section>
    @if (underOthers.Count > 0)
    {
        <Section Title="Under another's command" Count="@underOthers.Count.ToString()">
            @foreach (var s in underOthers)
            {
                var relieve = new RelieveServiceCommand(pid, s.FleetId); string? relieveNo = relieve.Refusal(G.Ctx); string fid = s.FleetId, fname = s.FleetName; var k = w.Char(s.CommanderId);
                <div class="sv-row" data-service-under="@s.FleetId">
                    @Face(k, w.House(s.CommanderHouseId)?.AccentColor ?? "#888")
                    <span class="sv-t">@ServiceSystem.Says(w, s)</span>
                    <Plate Label="Relieve" Small="true" Locked="@(relieveNo != null)" Disabled="@(relieveNo != null)" ShowNeed="false" Need="@Cap(relieveNo ?? "")" data-relieve="@fid" Tip="@("[anticlockwise-rotation] Relieve the commander\n" + (relieveNo != null ? Cap(relieveNo) : RelieveHelp))" OnClick='() => G.AskDo("Relieve the commander of " + fname + "?", RelieveHelp, "Relieve them", new RelieveServiceCommand(pid, fid))' />
                </div>
            }
        </Section>
    }
    @if (asks.Count > 0)
    {
        <Section Title="Asked of you" Count="@asks.Count.ToString()">
            @foreach (var a in asks)
            {
                string aid = a.Id; var yes = new AnswerServiceCommand(pid, aid, true, c.Offices); string? yesNo = yes.Refusal(G.Ctx);
                <div class="sv-row ask" data-service-ask="@a.Id">
                    <span class="sv-med"><Icon Name="wax-seal" Tone="brass" Size="20" /></span>
                    <span class="sv-t">@ServiceSystem.AskSays(w, a)</span>
                    <span class="sv-acts">
                        <Plate Label="@YesWord(a.Kind)" Small="true" Locked="@(yesNo != null)" Disabled="@(yesNo != null)" ShowNeed="false" Need="@Cap(yesNo ?? "")" data-answer-ask="@aid" data-answer="yes" Tip="@("[check] " + YesWord(a.Kind) + "\n" + (yesNo != null ? Cap(yesNo) : YesHelp(a.Kind)))" OnClick="() => G.Execute(new AnswerServiceCommand(pid, aid, true, c.Offices))" />
                        <Plate Label="@NoWord(a.Kind)" Small="true" data-answer-ask="@aid" data-answer="no" Tip="@("[close] " + NoWord(a.Kind) + "\n" + NoHelp)" OnClick="() => G.Execute(new AnswerServiceCommand(pid, aid, false, c.Offices))" />
                    </span>
                </div>
            }
        </Section>
    }
    <Section Title="Seek a command" Info="@($"Offer the service of one of your house to whoever gives commands now. {ServiceSystem.AgentCost} agent, spent only if they are taken on.")">
        <Right>@if (seeker != null) { <span><Icon Name="cowled" Tone="ivory" Size="15" /><b>@ServiceSystem.AgentCost</b> agent if taken on</span> }</Right>
        <ChildContent>
        @if (seeker == null) { <EmptyState Icon="rally-the-troops" Text="Nobody of your house is grown and free to serve." /> }
        else
        {
            <div class="sv-pick" data-seeker>
                <Select Options="@SeekerOptions(seekers, pid, house.AccentColor)" Value="@seeker.Id" OnChange="v => _seeker = v" Tip="Whose service: who of your house would serve" />
            </div>
            @* a refusal that every row would repeat is said once, over the list, and kept in each locked plate's tooltip *@
            var allNo = takers.Select(t => new SeekCommandCommand(pid, seeker.Id, t, c.Offices).Refusal(G.Ctx)).ToList(); string? sameNo = allNo.Count > 1 && allNo.All(x => x != null && x == allNo[0]) ? allNo[0] : null;
            @if (sameNo != null) { <WarnStrip Icon="padlock" Lead="Not now." Class="sv-strip">@Cap(sameNo).</WarnStrip> }
            @if (takers.Count == 0) { <div data-service-none="takers"><EmptyState Icon="greek-temple" Text="Nobody gives commands to others now: no consul, Admiral or holder of emergency powers sits, and no house is at war." /></div> }
            @foreach (var t in takers)
            {
                string tid = t, sid = seeker.Id; var seek = new SeekCommandCommand(pid, sid, tid, c.Offices); string? seekNo = seek.Refusal(G.Ctx);
                ServiceSystem.SeekRefusal(w, c.Offices, seeker, tid, out var plan); string offerLabel = "Offer " + (sid == pid ? "your" : FirstName(seeker.Name) + "'s") + " service";
                var tk = w.Char(tid); var tkh = tk != null ? w.House(tk.HouseId) : null;
                <div class="sv-row" data-taker="@tid">
                    @if (tk != null) { <Portrait Id="@tk.Id" Name="@tk.Name" Sex="@tk.Sex" Age="@tk.Age" Accent="@(tkh?.AccentColor ?? "#888")" Size="46" Height="56" /> }
                    else { <span class="sv-med"><Icon Name="podium" Tone="ivory" Size="20" /></span> }
                    <span class="sv-t"><b>@ServiceSystem.TakerName(w, c.Offices, tid)</b>@if (seekNo != null && sameNo == null) { <span class="ui-need"> · @Cap(seekNo)</span> }</span>
                    <Plate Label="@offerLabel" Small="true" Locked="@(seekNo != null)" Disabled="@(seekNo != null)" ShowNeed="false" Need="@Cap(seekNo ?? "")" data-seek-command="@tid" Tip="@("[rally-the-troops] Offer service\n" + (seekNo != null ? Cap(seekNo) : SeekHelp(plan)))" OnClick="() => G.Execute(new SeekCommandCommand(pid, sid, tid, c.Offices))" />
                </div>
            }
        }
        </ChildContent>
    </Section>
    @if (enemy != null && borrowFleet != null)
    {
        <Section Title="Borrow an officer" Info="@($"For your war with {w.House(enemy)?.Name ?? enemy}. {ServiceSystem.AgentCost} agent; the head of their house gives leave or refuses it. {BorrowHelp}")">
            <div class="sv-pick" data-borrow-fleet>
                <span class="mo-l">For</span>
                <Select Options="@FleetOptions(w, borrowFleets)" Value="@borrowFleet.Id" OnChange="v => _borrowFleet = v" Tip="The fleet the officer would command" />
            </div>
            @foreach (var k in ServiceSystem.Candidates(w, borrowFleet, 6))
            {
                string kid = k.Id, bfid = borrowFleet.Id; var borrow = new BorrowOfficerCommand(pid, bfid, kid); string? borrowNo = borrow.Refusal(G.Ctx);
                <div class="sv-row" data-borrow-who="@kid">
                    @Face(k, w.House(k.HouseId)?.AccentColor ?? "#888")
                    <span class="sv-t"><b>@k.Name</b> of @(w.House(k.HouseId)?.Name) · tactics @k.Skill("tactics")@if (borrowNo != null) { <span class="ui-need"> · @Cap(borrowNo)</span> }</span>
                    <Plate Label="Ask for them" Small="true" Locked="@(borrowNo != null)" Disabled="@(borrowNo != null)" ShowNeed="false" Need="@Cap(borrowNo ?? "")" data-borrow="@kid" Tip="@("[shaking-hands] Ask for them\n" + (borrowNo != null ? Cap(borrowNo) : BorrowHelp))" OnClick="() => G.Execute(new BorrowOfficerCommand(pid, bfid, kid))" />
                </div>
            }
        </Section>
    }
    @if (past.Count > 0)
    {
        <Section Title="Commands ended" Count="@past.Count.ToString()">
            @foreach (var s in past) { <div class="mil-line ui-dim" data-service-past="@s.FleetId"><Icon Name="scroll-unfurled" Tone="ivory" Size="15" /><span>@ServiceSystem.Says(w, s)</span></div> }
        </Section>
    }
</div>

@code {
    // A panel with no parameters is not redrawn when its parent is, so it listens for the world changing itself.
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;
    private string _seeker = "", _borrowFleet = "";
    private static string FirstName(string name) => name.Split(' ')[0];
    private static List<Select.Option> SeekerOptions(IEnumerable<Character> ks, string pid, string accent) => ks.Select(k => new Select.Option(k.Id, k.Id == pid ? "Your own" : k.Name, "tactics " + k.Skill("tactics") + " · renown " + LifeSystem.Renown(k), k.Id, k.Sex, k.Age, accent)).ToList();
    private static List<Select.Option> FleetOptions(World w, IEnumerable<Fleet> fs) => fs.Select(f => new Select.Option(f.Id, f.Name, Counted.Hulls(f.Strength) + " · " + (FleetSystem.AdmiralOf(w, f)?.Name ?? "no admiral"))).ToList();
    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    private const string ServiceRules = "A consul, the Admiral of the Reach or the holder of emergency powers names a legate from any house to a fleet under them; a house at war takes an officer of a friendly house, with its head's leave. The victories, the valour, the renown and the crews' regard are the commander's; the hulls, their keep and the spoils stay with the house that owns the fleet. The owner or the one who named them may relieve them, the Senate by a recall, and they may resign.";
    /// <summary>A person's face for a row (docs/VISUAL_SYSTEM.md 4.15), or an empty post when there is nobody.</summary>
    private static RenderFragment Face(Character? k, string accent) => __builder =>
    {
        if (k != null) { <Portrait Id="@k.Id" Name="@k.Name" Sex="@k.Sex" Age="@k.Age" Alive="@k.Alive" Accent="@accent" Size="46" Height="56" /> }
        else { <Portrait Size="46" Height="56" EmptyGlyph="rally-the-troops" Name="Nobody" /> }
    };
    private const string RelieveHelp = "The command is taken back: the fleet is without an admiral until one is named, and the one relieved thinks the worse of you.";
    private const string NoHelp = "Whoever asked thinks a little the worse of you for it.";
    private const string BorrowHelp = "They command this fleet in your war until the war is over, you relieve them, they resign, or your houses fall out. Their victories and their crews' regard are theirs; the fleet and its spoils stay yours.";
    private string ResignHelp(string who) => who == G.World!.ProtagonistId ? "Give the command up. Whoever named you thinks a little the worse of it." : "Call them home: the command is given up, and whoever named them thinks a little the worse of it.";
    private static string YesWord(string kind) => kind == ServiceSystem.AskLend ? "Give leave" : kind == ServiceSystem.AskOffer ? "Take them on" : "Accept";
    private static string NoWord(string kind) => kind == ServiceSystem.AskLend ? "Refuse" : "Decline";
    private static string YesHelp(string kind) => kind == ServiceSystem.AskLend ? "They are lent for the war: its victories and their crews' regard are theirs, and the house that asked thinks the better of you."
        : kind == ServiceSystem.AskOffer ? "They take the command. The fleet, its keep and its spoils stay yours." : "You take the command as legate: the victories are yours, the fleet stays theirs.";
    private static string SeekHelp(ServiceSystem.Plan? plan) => plan == null ? string.Empty
        : $"They would be given {plan.Fleet.Name}, {Counted.Hulls(plan.Fleet.Strength)}, by {plan.Taker.Name}, as {(plan.Kind == ServiceSystem.Legate ? "legate" : "an officer lent")}.";
}
