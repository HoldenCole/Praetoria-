@preservewhitespace true
@using Praetoria.Core.Systems
@using Praetoria.Core.Commands
@inject GameClient G
@implements IDisposable
@* A charge against the powerful, on the Senate window's courts (docs/CAESAR.md; docs/VISUAL_SYSTEM.md 4.6, 4.7): a section of entries,
   each with the accused's face: the charges that touch the house and how they may be answered, the threats laid against generals, the
   generals who could be threatened, and those in exile with the motion to call them home. *@
@{
    var w = G.World!; var p = w.Protagonist!; var pid = p.Id; var house = w.House(p.HouseId)!; var charges = G.Turn!.Charges; var senate = G.Turn!.Senate; var offices = G.Content!.Offices;
    var touching = ChargeSystem.Touching(w, house.Id);
    var threats = w.ChargeThreats.Where(t => t.Outcome.Length == 0 && (t.AccuserId == house.Id || t.HouseId == house.Id)).OrderBy(t => t.Turn).ThenBy(t => t.Id, StringComparer.Ordinal).ToList();
    var generals = w.Fleets.Values.Where(f => f.AdmiralId.Length > 0).Select(f => w.Char(f.AdmiralId)).Where(c => c is { Alive: true } && c.HouseId != house.Id && !World.Outsider(c.HouseId) && ChargeSystem.ThreatDeed(w, house.Id, c) != null)
        .Select(c => c!).Distinct().OrderByDescending(c => CaesarSystem.Sway(w, c)).ThenBy(c => c.Id, StringComparer.Ordinal).Take(4).ToList();
    var exiles = w.Exiles.OrderBy(x => x.HouseId == house.Id ? 0 : 1).ThenBy(x => x.Since).ThenBy(x => x.CharacterId, StringComparer.Ordinal).ToList();
    var myExile = ChargeSystem.ExileOf(w, pid);
    var homeDef = senate.Motions.Def(ChargeSystem.HomeKind);
    int n = touching.Count + threats.Count + exiles.Count;
}
@if (touching.Count == 0 && threats.Count == 0 && exiles.Count == 0 && generals.Count == 0 && myExile == null)
{
    <div class="ui-empty" data-powerful="1" data-powerful-empty="1"><Icon Name="laurels" Tone="ivory" Size="46" /><div><p>No charge against one of the powerful touches your house, nobody is in exile, and no house has let it be known that a general will be charged.</p></div></div>
}
else
{
<Section Title="Charges against the powerful" Count="@(n > 0 ? n.ToString() : "")" Info="@Intro" Class="sn-sub-sec">
    <span hidden data-powerful="1"></span>
    @if (myExile != null)
    {
        <div class="ui-wstrip bad sn-strip suit court-suit warn" data-in-exile="@pid"><Icon Name="dove" Tone="ember" Size="18" />
            <span class="ui-wstrip-t"><b>You are in exile @ChargeSystem.WhereSays(myExile), since year @myExile.Since.</b> @AbroadWhat</span>
        </div>
    }
    @if (touching.Count == 0 && threats.Count == 0 && exiles.Count == 0 && myExile == null) { <p class="sn-say sn-pad ui-dim">No charge against one of the powerful touches your house, nobody is in exile, and no house has let it be known that a general will be charged.</p> }
    @foreach (var c in touching)
    {
        string cid = c.Id; var who = w.Char(c.AccusedId); var accuser = w.House(c.AccuserId); bool ours = c.HouseId == house.Id; bool me = who?.Id == pid;
        string whoName = who?.Name ?? "the accused"; bool sentenced = c.Sentence == ChargeSystem.LayDown;
        string title = sentenced ? (ours ? (me ? "You are" : whoName + " is") + " convicted while in command" : whoName + " of " + (w.House(c.HouseId)?.Name ?? "another house") + " is convicted on your charge") : ours ? (accuser?.Name ?? "A house") + " charges " + (me ? "you" : whoName) : "Your charge against " + whoName + " of " + (w.House(c.HouseId)?.Name ?? string.Empty);
        string says = sentenced ? (ours ? "The command must be laid down by the end of year " + c.AnswerBy + ", or your house crosses the line. Left alone, the court's officers take it and your house loses " + ChargeSystem.TakenLegitimacy + " legitimacy." : who != null ? ChargeSystem.LayDownSays(w, c, who) : "The command must be laid down by the end of year " + c.AnswerBy + ".")
            : ours ? (who != null ? (me ? "You are " : whoName + " is ") + ChargeSystem.PowerfulWhy(w, who) : "One of your house is charged") + ". Heard at the end of this year. It is a cause to cross the line, as a recall is." + (c.Answer == ChargeSystem.Trial ? " " + (me ? "You" : whoName) + " will stand trial." : string.Empty)
            : whoName + " is " + (who != null ? ChargeSystem.PowerfulWhy(w, who) : "one of the powerful") + ". They may stand trial, go into exile, or cross the line. If they are let go, your house loses " + (1 + ChargeSystem.AcquittalLegitimacy) + " legitimacy.";
        <div class="sn-ent suit court-suit @(ours ? Warn : string.Empty)" data-powerful-charge="@cid">
            <span class="sn-pic">@SenateScreen.Face(w, who, "scales")</span>
            <div class="sn-ent-main">
                <div class="sn-hd"><b class="sn-nm @(ours ? "sn-bad" : "")">@title</b></div>
                <div class="sn-tx">@says</div>
                @if (ours)
                {
                    <div class="sn-acts suit-acts">
                        @foreach (var a in (sentenced ? AfterVerdict : BeforeVerdict))
                        {
                            string answer = a; var no = new AnswerChargeCommand(pid, cid, answer, charges).Refusal(G.Ctx);
                            <Plate Label="@LabelOf(answer, me)" Small="true" Class="@(answer == ChargeSystem.Cross ? "sn-veto" : "")" Locked="@(no != null)" Disabled="@(no != null)" Tip="@(no ?? TipOf(answer, me))" OnClick="() => AskAnswer(cid, answer, whoName, me)" data-charge-answer="@answer" />
                        }
                    </div>
                }
            </div>
        </div>
    }
    @foreach (var t in threats)
    {
        bool byUs = t.AccuserId == house.Id; string line = ChargeSystem.ThreatSays(w, t, house.Id);
        <div class="sn-note sn-pad suit court-quarrel @(byUs ? string.Empty : Warn)" data-charge-threat="@t.Id" data-threat-standing="1"><Icon Name="scales" Tone="@(byUs ? "brass" : "ember")" Size="15" /><span>@line</span></div>
    }
    @if (generals.Count > 0)
    {
        <p class="sn-say sn-pad ui-dim" data-threat-list="1">Generals of other houses with something on the record a court would hear. You may let it be known that they will be charged the day they lay their command down: their house is given a cause, and if you never bring it you pay.</p>
        @foreach (var g in generals)
        {
            string gid = g.Id; var no = new ThreatenChargeCommand(pid, gid, offices).Refusal(G.Ctx); var deed = ChargeSystem.ThreatDeed(w, house.Id, g);
            string what = deed != null ? LadderSystem.DeedSays(w, offices, deed) : string.Empty;
            <div class="ui-row sn-row" data-threat-general="@gid">
                <div>@SenateScreen.Face(w, g, "eagle-emblem")</div>
                <div class="sn-rmain"><div class="ui-row-nm">@g.Name</div><div class="ui-row-sub sn-wrap" title="@what">of @(w.House(g.HouseId)?.Name) · @what</div></div>
                <div class="ui-cols"><span class="ui-cell" title="Sway: what the crews and the squares think of them"><Icon Name="laurels" Tone="brass" Size="16" />@CaesarSystem.Sway(w, g)</span></div>
                <div><Plate Label="Let it be known" Small="true" Locked="@(no != null)" Disabled="@(no != null)" Tip="@(no ?? ThreatTip)" CostIcon="laurels" CostText="@ChargeSystem.ThreatInfluence.ToString()" OnClick="() => AskThreat(gid, g.Name)" data-charge-threat="@gid" /></div>
            </div>
        }
    }
    @foreach (var x in exiles)
    {
        var who = w.Char(x.CharacterId); var xh = w.House(x.HouseId); string hid = x.HouseId; bool first = ChargeSystem.ExileNamed(w, hid)?.Id == x.CharacterId;
        var no = homeDef == null ? NoMotion : new ProposeMotionCommand(pid, ChargeSystem.HomeKind, hid, senate).Refusal(G.Ctx);
        int cost = homeDef == null ? 0 : new ProposeMotionCommand(pid, ChargeSystem.HomeKind, hid, senate).Cost(w, house.Id, homeDef);
        string label = "Move that " + (x.CharacterId == pid ? "you be" : (who?.Name ?? "they") + " be") + " called home";
        <div class="ui-row sn-row suit court-ruling @(x.HouseId == house.Id ? Warn : string.Empty)" data-exile="@x.CharacterId">
            <div>@SenateScreen.Face(w, who, "dove")</div>
            <div class="sn-rmain"><div class="ui-row-nm">@(who?.Name ?? "Someone") of @(xh?.Name ?? string.Empty)</div>
                <div class="ui-row-sub sn-wrap">in exile @ChargeSystem.WhereSays(x) since year @x.Since@(x.WasHead ? ", and heads the house from there" : string.Empty)@(x.AccuserId.Length > 0 ? ", on the charge " + (w.House(x.AccuserId)?.Name ?? "a house") + " brought" : string.Empty)</div></div>
            <div class="ui-cols"></div>
            <div>@if (first) { <Plate Label="@label" Small="true" Locked="@(no != null)" Disabled="@(no != null)" Tip="@(no ?? HomeTip)" CostIcon="public-speaker" CostText="@cost.ToString()" OnClick="() => G.Execute(new ProposeMotionCommand(pid, ChargeSystem.HomeKind, hid, senate))" data-recall-exile="@hid" /> }</div>
        </div>
    }
</Section>
}

@code {
    private static readonly string[] BeforeVerdict = { ChargeSystem.Trial, ChargeSystem.ExileAnswer, ChargeSystem.Cross };
    private static readonly string[] AfterVerdict = { ChargeSystem.LayDown, ChargeSystem.Cross };
    private const string Intro = "A charge against a person of great sway, or against the head of a house of Legate rank or above, waits a year whoever brings it. The accused may stand trial, go into exile beyond the Reach, or cross the line. A charge that fails costs the house that brought it.";
    private const string AbroadWhat = "Your house is still yours: its worlds, its money, its people and its votes in the Senate go on, and you run them by letter, with what is in your own purse. You may hold no office and no command, stand for nothing, bring nothing before the courts, and move nothing in the Senate but your own return. Another house, or your own, must move that the Senate call you home.";
    private const string ThreatTip = "Their house is given a cause to cross the line while it stands. The day they lay their command down you must bring the charge, by the end of the year after, or your house loses standing for threatening what it would not do.";
    private const string HomeTip = "Voted at the end of next year. Carried, they come home and may stand and command again, and their house gains standing.";
    private const string NoMotion = "the Senate hears no such motion", Warn = "warn";
    private static string LabelOf(string answer, bool me) => answer switch
    {
        ChargeSystem.Trial => "Stand trial",
        ChargeSystem.ExileAnswer => me ? "Go into exile" : "Send them abroad",
        ChargeSystem.Cross => "Cross the line",
        _ => "Lay the command down"
    };
    private static string TipOf(string answer, bool me) => answer switch
    {
        ChargeSystem.Trial => "It is heard at the end of the year by the praetor named, as any charge is.",
        ChargeSystem.ExileAnswer => "The charge is not heard. " + (me ? "Your" : "Their") + " offices and commands lapse at once, and " + (me ? "you live" : "they live") + " at a nation's court beyond the Reach, with " + (me ? "your" : "their") + " own purse, until the Senate votes " + (me ? "you" : "them") + " home. The house loses " + ChargeSystem.ExileLegitimacy + " legitimacy, twice that if it is its head.",
        ChargeSystem.Cross => "The house marches on the capital with its general, and the Republic's courts do not hear the charge.",
        _ => "The fleets are left without an admiral, and no command may be held for " + CaesarSystem.BarredYears + " years."
    };
    private void AskAnswer(string chargeId, string answer, string who, bool me)
    {
        if (answer == ChargeSystem.Trial) { G.Execute(new AnswerChargeCommand(G.World!.ProtagonistId, chargeId, answer, G.Turn!.Charges)); return; }
        string title = answer == ChargeSystem.ExileAnswer ? (me ? "Go into exile?" : "Send " + who + " abroad?") : answer == ChargeSystem.Cross ? "Cross the line?" : "Lay the command down?";
        G.Ask(title, TipOf(answer, me), LabelOf(answer, me), () => G.Execute(new AnswerChargeCommand(G.World!.ProtagonistId, chargeId, answer, G.Turn!.Charges)), "Not yet");
    }
    private void AskThreat(string generalId, string name) => G.Ask("Let it be known that " + name + " will be charged?", ThreatTip, "Let it be known",
        () => G.Execute(new ThreatenChargeCommand(G.World!.ProtagonistId, generalId, G.Content!.Offices)), "Say nothing");
    protected override void OnInitialized() => G.Changed += Redraw;
    private void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() => G.Changed -= Redraw;
}
