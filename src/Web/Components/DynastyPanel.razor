@inject GameClient G

@{
    var w = G.World!; var c = G.Content!; var p = w.Protagonist!; var house = w.House(p.HouseId)!;
    var kin = w.Characters.Values.Where(x => x.HouseId == house.Id).ToList();
    var roots = kin.Where(x => !kin.Any(k => k.Id == x.MotherId || k.Id == x.FatherId)).OrderByDescending(x => x.Age).ThenBy(x => x.Id, StringComparer.Ordinal).ToList();
    var heirs = Heirs(w, house, c);
}
<div class="dynasty" style="--accent:@house.AccentColor">
    <section class="card">
        <h2>@house.Name</h2>
        <div class="muted">@(c.Titles.ById(house.Title)?.Name ?? house.Title) · legitimacy @house.Legitimacy · succession by @house.SuccessionLaw · generation @(w.Counter("generation") + 1)</div>
        @if (heirs.Count > 0) { <div class="kv"><span>Line of succession</span><b>@string.Join(" → ", heirs.Take(4).Select(h => $"{h.Name} ({h.Age})"))</b></div> }
        else { <div class="kv warn"><span>Line of succession</span><b>no heir — the line hangs by a thread</b></div> }
    </section>

    <section class="card tree">
        <h3>The family tree</h3>
        @{ _shown.Clear(); }
        @foreach (var r in roots)
        {
            // a spouse already drawn beside their partner is not a second root; a person is drawn once, under the first parent met
            var sp = DynastySystem.Spouse(w, r);
            if (_shown.Contains(r.Id) || (sp != null && _shown.Contains(sp.Id))) continue;
            @Person(r, 0, kin, w, c)
        }
    </section>

    <section class="card">
        <h3>Bonds within the house</h3>
        @foreach (var k in kin.Where(k => k.Alive && k.Id != p.Id).OrderBy(k => k.Id, StringComparer.Ordinal))
        {
            var rel = w.GetRelationship(k.Id, p.Id); int d = rel?.Disposition ?? 0;
            <div class="person"><b>@k.Name</b> <span class="muted">@(c.Careers.RankName(k.CareerTrack, k.CareerRank) ?? "") · @k.Age</span>
                <span class="pill @(d < -20 ? "warn" : d > 20 ? "good" : "")">@(d >= 0 ? "+" : "")@d toward you@(rel?.Bond is { } b && b != BondType.None ? $" · {b.ToString().ToLowerInvariant()}" : "")</span>
                @foreach (var f in k.Flags.Where(f => !f.StartsWith("background:")).OrderBy(f => f, StringComparer.Ordinal)) { <span class="pill small">@f.Replace('_', ' ')</span> }
            </div>
        }
    </section>
</div>

@code {
    private static List<Character> Heirs(World w, House house, ContentDatabase c)
    {
        var p = w.Protagonist!;
        return w.Characters.Values.Where(x => x.Alive && x.HouseId == house.Id && x.Id != p.Id && (x.MotherId == p.Id || x.FatherId == p.Id || SharesParent(x, p)))
            .OrderByDescending(x => x.MotherId == p.Id || x.FatherId == p.Id).ThenByDescending(x => x.Age).ThenBy(x => x.Id, StringComparer.Ordinal).ToList();
    }
    private static bool SharesParent(Character a, Character b) => (a.MotherId.Length > 0 && a.MotherId == b.MotherId) || (a.FatherId.Length > 0 && a.FatherId == b.FatherId);

    private readonly HashSet<string> _shown = new();

    private RenderFragment Person(Character ch, int depth, List<Character> kin, World w, ContentDatabase c) => __builder =>
    {
        _shown.Add(ch.Id);
        var spouse = DynastySystem.Spouse(w, ch);
        if (spouse != null) _shown.Add(spouse.Id);
        var children = kin.Where(k => (k.MotherId == ch.Id || k.FatherId == ch.Id) && !_shown.Contains(k.Id)).OrderByDescending(k => k.Age).ThenBy(k => k.Id, StringComparer.Ordinal).ToList();
        bool me = ch.Id == w.ProtagonistId;
        <div class="node depth-@Math.Min(depth, 4)">
            <div class="node-card @(me ? "me" : "") @(ch.Alive ? "" : "dead")">
                <Portrait Id="@ch.Id" Name="@ch.Name" Sex="@ch.Sex" Age="@ch.Age" Alive="@ch.Alive" Accent="@(w.House(ch.HouseId)?.AccentColor ?? "#888")" Size="40" />
                <div class="name">@ch.Name @(me ? "✦" : "")</div>
                <div class="muted small">@(ch.Alive ? $"{ch.Age}" : "†") · @(ch.Sex.Length > 0 ? ch.Sex : "")@(ch.Alive && c.Careers.RankName(ch.CareerTrack, ch.CareerRank) is { } rn ? $" · {rn}" : "")</div>
                @if (spouse != null) { <div class="muted small">⚭ @spouse.Name@(spouse.HouseId != ch.HouseId ? $" of {w.House(spouse.HouseId)?.Name}" : "")@(spouse.Alive ? "" : " †")</div> }
            </div>
            @if (children.Count > 0)
            {
                <div class="children">
                    @foreach (var k in children) { @Person(k, depth + 1, kin, w, c) }
                </div>
            }
        </div>
    };
}
