{
  "//": "THE REACH — the curated star map every shipped scenario is played on (GDD §19). Nine regions in three rings — the Core (commerce, the capital, order), the Middle (leaning whichever way it is pushed) and the Rim (lawless, restless, where houses break away) — of three or four systems each. Territory is DERIVED from the planet holding in each system; `baseline` names the minor-houses file merged into every scenario here so few worlds are empty — and the ones that are, on the Rim, are where the trouble starts. `capital` is the system whose holder keeps the court. `rings` tunes how each ring behaves. Positions are map units (~1280×780), laid out as rings.",
  "id": "the_reach",
  "name": "The Reach",
  "baseline": "the_reach_houses",
  "capital": "aurelia_prime",
  "rings": {
    "//": "prosperity: added to every holding's prosperity target. unrestDrift: added to populated worlds' unrest each turn. lawlessnessDrift/Start: raiders on the lanes (taxes ledgers, feeds risings). allegiance: where the region's loyalty to the capital settles (offset from 50). tradeBonus: credits per peopled world. charterBonus: extra charter per venture level to the world's holder.",
    "core": {
      "prosperity": 10,
      "unrestDrift": -1,
      "lawlessnessDrift": -2,
      "lawlessnessStart": 5,
      "allegiance": 30,
      "tradeBonus": 1,
      "charterBonus": 1
    },
    "middle": {
      "prosperity": 0,
      "unrestDrift": 0,
      "lawlessnessDrift": 0,
      "lawlessnessStart": 20,
      "allegiance": 0,
      "tradeBonus": 0,
      "charterBonus": 0
    },
    "rim": {
      "prosperity": -10,
      "unrestDrift": 1,
      "lawlessnessDrift": 1,
      "lawlessnessStart": 40,
      "allegiance": -20,
      "tradeBonus": 0,
      "charterBonus": 0
    }
  },
  "regions": [
    {
      "id": "western_marches",
      "name": "The Western Marches",
      "culture": "marcher",
      "description": "Frontier worlds at the edge of the lanes: hard soil, harder people, and houses that remember when no one ruled them.",
      "ring": "rim"
    },
    {
      "id": "drake_lanes",
      "name": "The Drake Lanes",
      "culture": "lanefolk",
      "description": "The trade spine of the Reach. Everything that moves, moves through here, and everyone who moves it wants a cut.",
      "ring": "middle"
    },
    {
      "id": "greywater_reach",
      "name": "The Greywater Reach",
      "culture": "reach",
      "description": "Old blood. The great houses of the Reach proper, their forges, their feuds, their long memories.",
      "ring": "middle"
    },
    {
      "id": "imperial_core",
      "name": "The Imperial Core",
      "culture": "aurelian",
      "description": "Aurelia Prime and the worlds that orbit its favour. Where the Senate sits, and where a throne would stand.",
      "ring": "core"
    },
    {
      "id": "southern_spire",
      "name": "The Southern Spire",
      "culture": "spirean",
      "description": "Scholars, archivists and the belt-miners who feed them. Quiet, clever, and never as neutral as it claims.",
      "ring": "middle"
    },
    {
      "id": "valmont_anvils",
      "name": "The Valmont Anvils",
      "culture": "forgeborn",
      "description": "Industry without apology. Hull-yards, refineries and kilns under a sky the colour of slag.",
      "ring": "rim"
    },
    {
      "id": "golden_concourse",
      "name": "The Golden Concourse",
      "culture": "concourse",
      "ring": "core",
      "description": "The money-worlds of the Core. Banks older than titles, prices set by breakfast, and a bourse that has outlasted three thrones."
    },
    {
      "id": "lantern_shoals",
      "name": "The Lantern Shoals",
      "culture": "shoalfolk",
      "ring": "middle",
      "description": "Lighthouse-worlds on the long lane south. Loyal when the Core is strong, forgetful when it is not."
    },
    {
      "id": "ashen_verge",
      "name": "The Ashen Verge",
      "culture": "vergeborn",
      "ring": "rim",
      "description": "Ash plains, smugglers' harbours and a prison-world turned pirate haven. The law arrives here by fleet or not at all."
    },
    {
      "id": "pale_reaches",
      "name": "The Pale Reaches",
      "culture": "palefolk",
      "ring": "rim",
      "description": "Hard winters at the end of the lanes. Knightly houses that answer to no count, and the richest, loneliest belt in the Reach."
    }
  ],
