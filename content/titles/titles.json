{
  // THE TITLE LADDER (GDD §13; docs/TITLES.md) — the dynasty ladder, persists across character deaths. Each rung's
  // `legitimacyRequirement` is the SOFT-LOCK: you can hold a title above your legitimacy, but it
  // breeds ongoing instability (clients grumble, rivals contest) until your standing catches up.
  //
  // TWO NAMES A RUNG (the owner's direction, 2026-11-11): THE REPUBLIC HAS NO NOBLES. Until a throne stands
  // (era fractured_stars) a rung carries its `republicName`, a civic or military style: a house with no world
  // is a Citizen house, one that keeps a station a Warden, a world a Prefect, several a Legate, a province a
  // Proconsul; the greatest is First Citizen, and the one who takes everything is Dictator for the season before
  // the Imperium is proclaimed. Under the Imperium (era imperium) the same rungs take their noble `name`.
  // Ids never change: content, saves and conditions key on them.
  "titles": [
    { "id": "landless", "name": "Landless",  "republicName": "Citizen",       "rank": 0, "legitimacyRequirement": 0 },
    { "id": "knight",   "name": "Knight",    "republicName": "Warden",        "rank": 1, "legitimacyRequirement": 10 },
    { "id": "baron",    "name": "Baron",     "republicName": "Prefect",       "rank": 2, "legitimacyRequirement": 25 },
    { "id": "count",    "name": "Count",     "republicName": "Legate",        "rank": 3, "legitimacyRequirement": 40 },
    { "id": "duke",     "name": "Duke",      "republicName": "Proconsul",     "rank": 4, "legitimacyRequirement": 60 },
    { "id": "archduke", "name": "Archduke",  "republicName": "First Citizen", "rank": 5, "legitimacyRequirement": 80 },
    { "id": "emperor",  "name": "Emperor",   "republicName": "Dictator",      "rank": 6, "legitimacyRequirement": 95 }
  ]
}
