              "type": "adjustRelationship",
              "from": "regent",
              "to": "self",
              "delta": 5
            },
            {
              "type": "log",
              "text": "{self.name} sat at {regent.name}'s elbow through every audience and every ledger, saying nothing, missing nothing."
            }
          ]
        }
      ]
    },
