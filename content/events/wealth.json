          "requires": [
            {
              "type": "resource",
              "resource": "credits",
              "op": "gte",
              "value": 6
            }
          ],
          "effects": [
            {
              "type": "adjustResource",
              "resource": "credits",
              "delta": -6
            },
            {
              "type": "adjustRelationship",
              "from": "kin",
              "to": "self",
              "delta": 6
            },
            {
              "type": "log",
              "text": "{self.name} sent the sum across from the house's own money, so that nobody of the family would owe anybody of it. It was taken as generous. One of them thought it was also a way of keeping the books in one hand."
            }
          ]
        },
        {
          "id": "say_it_was_well_done",
          "effects": [
            {
              "type": "adjustRelationship",
              "from": "kin",
              "to": "self",
              "delta": 3
            },
            {
              "type": "log",
              "text": "{self.name} said, in passing, that it had been well done and that the house was the better for having people who looked to each other. It cost nothing and was remembered."
            }
          ]
        },
        {
          "id": "stay_out_of_it",
          "effects": [
            {
              "type": "log",
              "text": "{self.name} let it be between the two of them, where they had put it."
            }
          ]
        }
      ]
    },
    {
