          "id": "say_the_house_has_had_it",
          "effects": [
            {
              "type": "adjustRelationship",
              "from": "kin",
              "to": "self",
              "delta": -6
            },
            {
              "type": "log",
              "text": "{self.name} said that the money had gone where all of the house's money goes, and that {kin.name} had eaten at the table it paid for. {kin.name} did not argue. They will not lend again."
            }
          ]
        },
        {
          "id": "let_them_raise_it",
          "effects": [
            {
              "type": "adjustRelationship",
              "from": "kin",
              "to": "self",
              "delta": -2
            },
            {
              "type": "log",
              "text": "{self.name} waited for {kin.name} to raise it. {kin.name} did not, which is not the same as having forgotten."
            }
          ]
        }
      ]
    },
    {
