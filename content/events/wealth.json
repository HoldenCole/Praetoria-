            },
            {
              "type": "adjustStress",
              "role": "self",
              "delta": -1
            },
            {
              "type": "log",
              "text": "{self.name} said that the head of a house binds and unbinds what is the house's, and that there was nothing more to say. Nobody said more. It was noted outside the house that {self.name} is not a person who explains."
            }
          ]
        },
        {
          "id": "promise_to_restore_it",
          "effects": [
            {
              "type": "adjustLegitimacy",
              "delta": 2
            },
            {
              "type": "adjustStress",
              "role": "self",
              "delta": 3
            },
            {
              "type": "log",
              "text": "{self.name} gave their word that the entail would be made again when the house was on its feet. A word of that kind is cheap on the day and is remembered every year after."
            }
          ]
        }
      ]
    },
