          "effects": [
            {
              "type": "adjustRelationship",
              "from": "kin",
              "to": "self",
              "delta": -4
            },
            {
              "type": "adjustStress",
              "role": "kin",
              "delta": 3
            },
            {
              "type": "log",
              "text": "{self.name} said, without heat, that the money was still owed and that {self.name} had not forgotten. {kin.name} said they had not forgotten either."
            }
          ]
        },
        {
          "id": "leave_it_where_it_is",
          "effects": [
            {
              "type": "adjustStress",
              "role": "self",
              "delta": 1
            },
            {
              "type": "log",
              "text": "{self.name} said nothing, as before. The debt went on being there."
            }
          ]
        }
      ]
    },
