              "type": "adjustStress",
              "role": "self",
              "delta": 2
            },
            {
              "type": "log",
              "text": "{self.name} told the family what the money was for, in figures. Some of them were persuaded. All of them now know how matters stand."
            }
          ]
        },
        {
          "id": "say_it_was_yours_to_do",
          "effects": [
            {
              "type": "adjustResource",
