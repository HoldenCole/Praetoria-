            },
            {
              "type": "adjustStress",
              "role": "self",
              "delta": 2
            },
            {
              "type": "log",
              "text": "{self.name} named a day by which it would be paid, in front of {kin.name} and one other. Having said it aloud, {self.name} will have to do it."
            }
          ]
        },
