          "effects": [
            {
              "type": "adjustResource",
              "resource": "influence",
              "delta": 2
            },
            {
              "type": "log",
              "text": "{self.name} announced that the Republic had been restored, kept every office in being, and held all of them. The chamber voted its thanks. Everyone understood."
            }
          ]
        }
      ]
    },
