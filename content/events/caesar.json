            },
            {
              "type": "adjustLegitimacy",
              "role": "self",
              "delta": -1
            },
            {
              "type": "log",
              "text": "{self.name} sold what could be spared to keep the fleets crewed. The buyers knew how badly the money was needed, and paid accordingly."
            }
          ]
        }
      ]
    },
    {
