            },
            {
              "type": "adjustLegitimacy",
              "role": "self",
              "delta": -1
            },
            {
              "type": "log",
              "text": "{self.name} let the Senate know that gratitude can be shown in more ways than a vote of thanks. Something was found. A few thought less of {self.house} for asking."
            }
          ]
        },
        {
          "id": "go_home_quietly",
          "effects": [
            {
              "type": "adjustStress",
              "role": "self",
              "delta": -5
            },
            {
              "type": "log",
              "text": "{self.name} left the capital before the speeches and went home. The war had been against people {self.name} had dined with."
            }
          ]
        }
      ]
    },
