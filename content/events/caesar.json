              "delta": 8
            },
            {
              "type": "adjustStress",
              "role": "self",
              "delta": 2
            },
            {
              "type": "log",
              "text": "{self.name} gave {kin.name} a freer hand with the fleet. {kin.name} was pleased. So, when they heard, were the crews."
