            {
              "type": "adjustRelationship",
              "from": "kin",
              "to": "self",
              "delta": 6
            },
            {
              "type": "log",
              "text": "{self.name} wished {kin.name} luck with it and asked to be shown the place when it was running. {kin.name} had hoped to be asked."
            }
