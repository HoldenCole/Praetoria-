              "to": "self",
              "delta": 12
            },
            {
              "type": "log",
              "text": "{self.name} took {kin.name}'s part at last, and spent some credit doing it. It was late. {kin.name} took it all the same."
            }
          ]
        },
        {
          "id": "tell_them_to_want_something_else",
          "effects": [
            {
              "type": "adjustRelationship",
              "from": "kin",
