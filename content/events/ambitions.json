              "delta": -10
            },
            {
              "type": "log",
              "text": "{self.name} told {kin.name} that it was time to want something that could be had. {kin.name} thanked {self.name} for the advice in a voice with nothing in it."
            }
          ]
        },
        {
          "id": "say_it_will_come",
          "effects": [
            {
              "type": "adjustRelationship",
              "from": "kin",
              "to": "self",
              "delta": -2
            },
            {
              "type": "adjustStress",
              "role": "self",
              "delta": 1
            },
            {
              "type": "log",
              "text": "{self.name} said that these things take time. {kin.name} has been hearing that for ten years."
            }
          ]
        }
      ]
    },
    {
