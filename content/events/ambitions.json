{
  "//": "AMBITIONS (docs/AMBITIONS.md). Reads kin_fulfilled, kin_thwarted, kin_founded_a_venture and heir_named (deeds), and the character flags has_what_they_wanted, thwarted and founded_a_venture.",
  "events": [
    {
      "id": "what_they_wanted",
      "tier": "situation",
      "weight": 40,
      "repeatable": true,
      "roles": [
        {
          "name": "kin",
          "when": [
            {
              "type": "charFlag",
              "role": "kin",
              "flag": "has_what_they_wanted",
              "value": true
            }
          ]
        }
      ],
      "when": [
        {
          "type": "worldFlag",
          "flag": "kin_fulfilled",
          "value": true
        }
      ],
      "choices": [
        {
          "id": "be_glad_for_them",
          "effects": [
            {
              "type": "adjustRelationship",
              "from": "kin",
              "to": "self",
              "delta": 8
            },
            {
              "type": "log",
              "text": "{self.name} told {kin.name} it had been earned, and meant it. It is a rare thing to watch someone get what they set out for."
            }
          ]
        },
        {
          "id": "remind_them_who_helped",
          "effects": [
            {
              "type": "adjustRelationship",
              "from": "kin",
              "to": "self",
              "delta": -4
            },
            {
              "type": "adjustResource",
              "resource": "influence",
              "delta": 1
            },
            {
              "type": "log",
              "text": "{self.name} let {kin.name} understand whose house had stood behind them. {kin.name} understood. The moment was a little smaller for it."
            }
          ]
        },
        {
          "id": "ask_what_they_want_next",
          "effects": [
            {
              "type": "adjustRelationship",
              "from": "kin",
              "to": "self",
              "delta": 3
            },
            {
              "type": "log",
              "text": "{self.name} asked {kin.name} what came next. {kin.name} had not thought. It was plain they would start thinking soon."
            }
          ]
        }
      ]
    },
    {
