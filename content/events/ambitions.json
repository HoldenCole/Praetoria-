              "delta": 1
            },
            {
              "type": "adjustStress",
              "role": "self",
              "delta": 1
            },
            {
              "type": "log",
              "text": "{self.name} said it aloud before the assembled house, so that nobody could later claim not to have heard. Faces were watched while it was said."
            }
          ]
        },
        {
          "id": "let_it_be_known_quietly",
          "effects": [
            {
              "type": "log",
              "text": "{self.name} had it written into the house's book and let people find it there. They found it within the day."
            }
          ]
        },
        {
          "id": "soften_it_for_the_one_passed_over",
          "requires": [
            {
              "type": "resource",
              "resource": "credits",
              "op": "gte",
              "value": 6
            }
          ],
          "effects": [
            {
              "type": "adjustResource",
              "resource": "credits",
              "delta": -6
            },
            {
              "type": "adjustStress",
              "role": "self",
              "delta": -1
            },
            {
              "type": "log",
              "text": "{self.name} saw to it that whoever was passed over had something to show for a lifetime of expecting. It did not buy contentment. It bought civility."
            }
          ]
        }
