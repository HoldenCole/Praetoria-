            {
              "type": "adjustResource",
              "resource": "credits",
              "delta": 2
            },
            {
              "type": "log",
              "text": "{self.name} had the steward go over {kin.name}'s arrangements. The steward found two things to put right. {kin.name} did not enjoy being found right about the rest."
            }
          ]
        },
        {
          "id": "leave_them_to_it",
          "effects": [
            {
              "type": "log",
              "text": "{self.name} left {kin.name} to it. It is {kin.name}'s to make work, or not."
            }
          ]
        }
      ]
    },
    {
      "id": "the_heir_is_named",
      "tier": "situation",
      "weight": 40,
      "repeatable": true,
      "when": [
        {
          "type": "worldFlag",
          "flag": "heir_named",
          "value": true
