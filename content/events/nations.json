              "type": "adjustResource",
              "resource": "credits",
              "delta": -3
            },
            {
              "type": "adjustCounter",
              "key": "estate_offset:frontier",
              "delta": 3
            },
            {
              "type": "log",
              "text": "{self.name} sent arms and a garrison's pay to the raided world. Four materials, three credits, and a town that will fight next time."
            }
          ]
        },
        {
