            {
              "type": "adjustCounter",
              "key": "senate_influence",
              "delta": 1
            },
            {
              "type": "adjustCounter",
              "key": "estate_offset:officers",
              "delta": -2
            },
            {
              "type": "log",
              "text": "{self.name} laid the lost war at the consuls' door in open chamber: too few hulls sent, too late. The chamber murmured assent; the officers heard themselves blamed too."
            }
          ]
        },
        {
          "id": "call_for_the_fleet",
          "effects": [
            {
              "type": "adjustCounter",
              "key": "estate_offset:officers",
              "delta": 4
            },
            {
              "type": "adjustCounter",
              "key": "estate_offset:merchants",
              "delta": -3
            },
            {
              "type": "log",
              "text": "{self.name} called for a real fleet of the Reach, paid for by the chamber, so the next war would not be lost. The officers stood; the exchanges did the sums."
            }
          ]
        },
        {
          "id": "let_it_lie",
          "effects": [
            {
              "type": "adjustStress",
              "role": "self",
              "delta": -2
            },
            {
              "type": "log",
              "text": "{self.name} said nothing of the lost war. Peace is peace, and the chair had paid for it."
            }
          ]
        }
      ]
    },
