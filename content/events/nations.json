              "type": "adjustCounter",
              "key": "estate_offset:officers",
              "delta": 3
            },
            {
              "type": "adjustStress",
              "role": "self",
              "delta": -4
            },
            {
              "type": "log",
              "text": "{self.name} declined the procession and gave the laurel to the fleet. The old families approved of the modesty; the wardrooms approved of the gesture."
            }
          ]
        },
        {
          "id": "a_share_of_the_tribute",
          "effects": [
            {
              "type": "adjustResource",
              "resource": "credits",
              "delta": 8
            },
            {
              "type": "adjustCounter",
              "key": "senate_influence",
              "delta": -2
            },
            {
              "type": "log",
              "text": "{self.name} asked the chamber for a share of the tribute as the price of the triumph, and got eight credits and a reputation for asking."
            }
          ]
        }
      ]
    },
