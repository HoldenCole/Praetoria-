          "effects": [
            {
              "type": "adjustStress",
              "role": "self",
              "delta": 3
            },
            {
              "type": "log",
              "text": "{self.name} counted the raid's cost and bore it. The rim remembers who came and who did not."
            }
          ]
        }
      ]
    },
    {
      "id": "the_war_abroad_is_lost",
      "tier": "situation",
      "weight": 12,
      "repeatable": true,
      "when": [
        {
          "type": "worldFlag",
          "flag": "war_lost_abroad"
        }
      ],
