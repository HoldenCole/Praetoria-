            {
              "type": "resource",
              "resource": "credits",
              "op": "gte",
              "value": 5
            }
          ],
          "effects": [
            {
              "type": "adjustResource",
              "resource": "credits",
              "delta": -5
            },
            {
              "type": "adjustLegitimacy",
              "delta": 2
            },
            {
              "type": "adjustCounter",
              "key": "estate_offset:commons",
              "delta": 3
            },
            {
              "type": "log",
              "text": "{self.name} gave the returning fleet a parade through the harbour town: five credits of bunting and wine, and a house the squares cheered for."
            }
          ]
        },
        {
          "id": "pay_off_the_crews",
          "requires": [
            {
              "type": "resource",
              "resource": "credits",
              "op": "gte",
              "value": 6
            }
          ],
          "effects": [
            {
              "type": "adjustResource",
              "resource": "credits",
              "delta": -6
            },
            {
              "type": "adjustCounter",
              "key": "estate_offset:officers",
              "delta": 4
            },
            {
              "type": "log",
              "text": "{self.name} paid the crews off in full on the quay, six credits, before a single word was said about where they had been."
            }
          ]
        },
        {
          "id": "back_to_stations",
          "effects": [
            {
              "type": "log",
              "text": "{self.name} had the fleet back on station within the week. There would be another season."
            }
          ]
        }
      ]
    },
    {
      "id": "the_triumph",
      "tier": "situation",
      "weight": 12,
      "repeatable": true,
      "when": [
        {
          "type": "worldFlag",
          "flag": "triumph"
        }
      ],
