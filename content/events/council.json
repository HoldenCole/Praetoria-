      "tier": "situation",
      "weight": 10,
      "repeatable": true,
      "roles": [
        {
          "name": "chancellor",
          "when": [
            {
              "type": "charFlag",
              "role": "chancellor",
              "flag": "post:chancellor",
              "value": true
            }
          ]
        }
      ],
      "when": [
        {
          "type": "worldFlag",
          "flag": "chancellor_voted",
          "value": true
        }
      ],
      "choices": [
        {
          "id": "let_it_stand",
          "effects": [
            {
              "type": "setWorldFlag",
              "flag": "chancellor_voted",
              "value": false
            },
            {
              "type": "adjustRelationship",
              "from": "chancellor",
              "to": "self",
              "delta": 3
            },
            {
              "type": "log",
              "text": "{self.name} read the list of what {chancellor.name} had declared in the house's name and changed none of it."
            }
          ]
        },
        {
          "id": "make_it_yours",
          "effects": [
            {
              "type": "setWorldFlag",
              "flag": "chancellor_voted",
              "value": false
            },
            {
              "type": "adjustLegitimacy",
              "role": "self",
              "delta": 1
            },
            {
              "type": "adjustRelationship",
              "from": "chancellor",
              "to": "self",
              "delta": -6
            },
            {
              "type": "log",
              "text": "{self.name} rose in the chamber to say that the house's votes were the house's head's, whoever had spoken them. The benches took the point. So did {chancellor.name}."
            }
          ]
        },
        {
          "id": "ask_to_be_asked",
          "effects": [
            {
              "type": "setWorldFlag",
              "flag": "chancellor_voted",
              "value": false
            },
            {
              "type": "adjustRelationship",
              "from": "chancellor",
              "to": "self",
              "delta": -3
            },
            {
              "type": "adjustResource",
              "resource": "influence",
              "delta": 1
            },
            {
              "type": "log",
              "text": "{self.name} told {chancellor.name} that the next doubtful vote was to come upstairs first. It was a small leash, and both knew it."
            }
          ]
        }
      ]
    }
  ]
}
